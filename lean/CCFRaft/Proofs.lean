theorem protocolHistory_implies_MatchIndexPrefixInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    MatchIndexPrefixInv state := by
  have core :=
    protocolHistory_implies_HistoricalCompleteSafetyCore history
  exact
    currentMatchIndexPrefixHistory_implies_MatchIndexPrefixInv
      history
      (protocolHistory_implies_CurrentMatchIndexPrefixHistoryConsistent
        history)
      (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv history)
      core.electionLogs.counted.logs.logMatching
      (historicalFullElectionLogCore_implies_leaderUniqueness
        history core.electionLogs)

theorem protocolHistory_implies_MonoTermInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    MonoTermInv state :=
  protocolHistory_induction
    (start := start)
    (property := fun _ current => MonoTermInv current)
    (initial_MonoTermInv start)
    (by
      intro _ current currentHistory monoTerm action enabled
      have core :=
        protocolHistory_implies_HistoricalCompleteSafetyCore
          currentHistory
      have monoLog :=
        historicalMonoLog_current
          currentHistory
          core.electionLogs.counted.logs.monoLogs
      exact
        monoTerm_step
          current
          action
          monoTerm
          monoLog
          (protocolHistory_implies_MinimumTermInv currentHistory).logs
          enabled)
    history

theorem protocolHistory_implies_StateSafety
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    StateSafety state := by
  let core :=
    protocolHistory_implies_HistoricalCompleteSafetyCore history
  let electionLogs := core.electionLogs
  let chosen :=
    historicalCompleteSafetyCore_currentChosenCommitCore history core
  have signatures : SignatureInv state :=
    protocolHistory_implies_SignatureInv history
  have monoLog : MonoLogInv state :=
    historicalMonoLog_current
      history electionLogs.counted.logs.monoLogs
  have logMatching : LogMatchingInv state :=
    temporalLogMatching_current
      history electionLogs.counted.logs.logMatching
  have configurationsExact : ConfigurationsExactInv state :=
    reachable_ConfigurationsExactInv
      start (protocolHistory_reachable history)
  have leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state :=
    historicalFullElectionLogCore_implies_leaderUniqueness
      history electionLogs
  have sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state :=
    protocolHistory_implies_HistoricalSameLeaderLogPrefixInv history
  have entryOrigins :
      HistoricalEntryTermLeaderOriginInv start actions state :=
    protocolHistory_implies_HistoricalEntryTermLeaderOriginInv history
  have leaderTerms :
      HistoricalLeaderToCurrentCandidateTermInv start actions state :=
    protocolHistory_implies_HistoricalLeaderToCurrentCandidateTermInv
      history
  let electionVotes :=
    protocolHistory_implies_HistoricalElectionVoteCore history
  have oneLeaderPerTerm : MoreThanOneLeaderInv state := by
    intro first second sameTerm firstLeader secondLeader
    exact
      leaderUniqueness
        state
        state
        (protocolHistory_final_stateAt history)
        (protocolHistory_final_stateAt history)
        first
        second
        firstLeader
        secondLeader
        sameTerm
  have somePositiveCommit :
      Exists fun node => 0 < state.commitIndex node := by
    have initialPositive :
        0 < (initialState start).commitIndex start := by
      simp [initialState, startLog, start.leader_mem]
    have lowerBound :=
      reachable_commitIndex_lowerBound
        start (protocolHistory_reachable history) start
    exact
      ⟨start, Nat.lt_of_lt_of_le initialPositive lowerBound⟩
  exact
    {
      logSafety :=
        historicalChosenCommitCore_implies_LogInv
          history
          chosen
          signatures
          leaderUniqueness
          sameLeaderPrefixes
      oneLeaderPerTerm := oneLeaderPerTerm
      candidateFreshTerm :=
        historicalElectionCores_imply_CandidateTermNotInLogInv
          history
          electionVotes
          electionLogs.potentialOverlap
          entryOrigins
          leaderTerms
      electionSafety :=
        historicalLeaderLogs_imply_ElectionSafetyInv
          history
          entryOrigins
          sameLeaderPrefixes
          leaderUniqueness
      logMatching := logMatching
      quorumLog :=
        historicalChosenCommitCore_implies_QuorumLogInv
          history chosen signatures configurationsExact
      leaderCompleteness :=
        historicalChosenCommitCore_implies_LeaderCompletenessInv
          history chosen signatures
      signatures := signatures
      messageTerms := protocolHistory_implies_MonoTermInv history
      monotonicLogs := monoLog
      configurations :=
        configurationsExact_implies_LogConfigurationConsistentInv
          state configurationsExact
      replication :=
        historicalChosenCommitCore_implies_ReplicationInv
          history chosen signatures somePositiveCommit
      boundedMatchIndex :=
        matchIndexPrefix_implies_MatchIndexBoundedByLogInv
          (protocolHistory_implies_MatchIndexPrefixInv history)
    }

theorem reachable_ConfigurationsWellFormedInv
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    ConfigurationsWellFormedInv state := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := ConfigurationsWellFormedInv)
  · exact initial_ConfigurationsWellFormedInv start
  · intro current action invariant enabled
    exact configurationsWellFormed_step current action invariant enabled
  · exact reachable

theorem reachable_MinimumTermInv
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    MinimumTermInv state := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := MinimumTermInv)
  · exact initial_MinimumTermInv start
  · intro current action invariant enabled
    exact minimumTerm_step current action invariant enabled
  · exact reachable

theorem reachable_NoLeaderBeforeInitialTermInv
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    NoLeaderBeforeInitialTermInv state :=
  noLeaderBeforeInitialTerm_of_activeRole
    state
    (reachable_MinimumTermInv start reachable).activeRoles

theorem reachable_NeverCommitEntryPrevTermsProp
    (start : InitialConfiguration)
    {state : State}
    (_reachable : Reachable start state)
    {action : Action}
    (enabled : Enabled state action) :
    NeverCommitEntryPrevTermsProp state (next state action) :=
  neverCommitEntryPrevTerms_step state action enabled

theorem reachable_StateSafety
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    StateSafety state := by
  rcases reachable_hasProtocolHistory reachable with
    ⟨actions, history⟩
  exact protocolHistory_implies_StateSafety history

theorem historicalSafetyObligation :
    HistoricalSafetyObligation := by
  intro start state historical
  rcases historical with ⟨actions, history⟩
  exact protocolHistory_implies_StateSafety history

theorem transitionSafetyObligation :
    TransitionSafetyObligation := by
  intro state action safety enabled
  exact
    {
      committedAppendOnly := committedLogAppendOnly_step
        state action safety.signatures enabled
      commitIndexMonotonic :=
        monotonicCommitIndex_step state action enabled
      termMonotonic := monotonicTerm_step state action enabled
      matchIndexMonotonic :=
        monotonicMatchIndex_step state action enabled
      commitsCurrentTerm :=
        neverCommitEntryPrevTerms_step state action enabled
    }

theorem fullSafetyCompletionObligation :
    FullSafetyCompletionObligation :=
  ⟨historicalSafetyObligation, transitionSafetyObligation⟩

theorem reachable_CCFRaftSafety
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    And
      (StateSafety state)
      (forall action : Action,
        Enabled state action ->
          TransitionSafety state action (next state action)) := by
  have safety := reachable_StateSafety start reachable
  exact
    ⟨safety,
      by
        intro action enabled
        exact
          transitionSafetyObligation state action safety enabled⟩

