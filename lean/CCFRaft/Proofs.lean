          (originSendState.log leader)
          (requestSendState.sentIndex leader follower + 1) =
        logPrefix
          (requestSendState.log leader)
          (requestSendState.sentIndex leader follower + 1) :=
    logPrefix_eq_of_prefixes
      (originSendState.log leader)
