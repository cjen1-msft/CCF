    simp [Enabled, actionEnabled, appendEntriesMessage] at sendEnabled
    exact sendEnabled.1.1.2
  have acceptFacts := accept
  simp [appendEntriesAcceptBase] at acceptFacts
  have sourceEq :
      source = leader :=
    leaderUniqueness
      sendState
      state
      (occurs_before_stateAt send)
      (protocolHistory_final_stateAt history)
      source
      leader
      sendLeader
      leaderState
      (acceptFacts.1.1.1.trans sameTerm.symm)
  subst source
  have sendPrefix :=
    sameLeaderPrefixes
      sendState
      (occurs_before_stateAt send)
