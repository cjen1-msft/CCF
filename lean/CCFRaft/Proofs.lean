        start actions endState leader follower response index)
    (finalLeader :
      endState.leadershipState leader = .leader)
    (responseTerm :
      response.term = endState.currentTerm leader)
    (followerTerm :
      state.currentTerm follower =
        endState.currentTerm leader)
    (retained :
      isLogPrefix
        (logPrefix
          ((next origin.ack.origin.responseState
            (.receive
              follower
              leader
              origin.ack.origin.kind.receiveKind)).log follower)
          index)
        (state.log follower))
    (head :
      headMessage? state receiveDest receiveSource = some message)
    (body :
      message.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (enabled :
      Enabled state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)) :
    isLogPrefix
      (logPrefix
        ((next origin.ack.origin.responseState
          (.receive
            follower
            leader
            origin.ack.origin.kind.receiveKind)).log follower)
        index)
      ((next state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)).log follower) := by
  by_cases followerIsDest : follower = receiveDest
  · subst receiveDest
    have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    rcases stateAt with ⟨stateAtWitness⟩
    have requests :=
      queueHistory_implies_AppendEntriesRequestHistoryConsistent
        (protocolHistory_implies_QueueHistoryConsistent
          stateAtWitness.stateHistory)
    have requestQueued :
        message ∈ state.messages follower receiveSource :=
      headMessage?_mem state follower receiveSource message head
    rcases
        (by
          simpa [body] using
            requests follower receiveSource message requestQueued) with
      ⟨send⟩
    have fields := body
    rw [send.message_eq] at fields
    simp [appendEntriesMessage] at fields
    rcases fields with
      ⟨previousIndexEq, previousTermEq, entriesEq,
        leaderCommitIndexEq⟩
    subst previousIndex
    subst previousTerm
    subst entries
    subst leaderCommitIndex
    have requestSend :
        Occurs
          start actions endState send.sendState
          (.appendEntries receiveSource follower) :=
      occurs_extend_stateAtWitness stateAtWitness send.occurrence
    have requestLeader :
        send.sendState.leadershipState receiveSource = .leader := by
      rcases send.occurrence with ⟨sendOccurrence⟩
      have sendEnabled := sendOccurrence.enabled
      simp [Enabled, actionEnabled] at sendEnabled
      exact sendEnabled.1.1.2
    have prefixLength :
        (logPrefix
          ((next origin.ack.origin.responseState
            (.receive
              follower
              leader
              origin.ack.origin.kind.receiveKind)).log follower)
          index).length =
            index := by
      simp [logPrefix, Nat.min_eq_left origin.ack.index_bounded]
    have previousAtLeastIndex :=
      appendEntriesConflict_previousIndex_ge_acknowledged
        sameLeaderPrefixes
        leaderUniqueness
        origin.send_occurrence
        requestSend
        origin.send_leader
        requestLeader
        finalLeader
        (origin.send_term.trans responseTerm)
        followerTerm
        origin.prefix_eq
        prefixLength
        retained
        (by
          simpa [send.message_eq, appendEntriesMessage] using
            branchEnabled.2.2.1.1)
        (by
          simpa [send.message_eq, appendEntriesMessage] using
            branchEnabled.2.2.1.2)
    have oldBound : index <= (state.log follower).length := by
      rw [← prefixLength]
      exact retained.length_le
    have prefixAtOld :
        logPrefix
            ((next origin.ack.origin.responseState
              (.receive
                follower
                leader
                origin.ack.origin.kind.receiveKind)).log follower)
            index =
          logPrefix (state.log follower) index :=
      prefix_eq_logPrefix_of_length
        _
        _
        index
        retained
        prefixLength
    have resultPrefixEq :
        logPrefix
            ((next state
              (.receive
                follower receiveSource
                .appendEntriesConflictThenNoConflict)).log follower)
            index =
          logPrefix (state.log follower) index := by
      simp [next, rawNext, nextReceive, head,
        send.message_eq, appendEntriesMessage,
        nextAppendEntriesNoConflict, conflictRollback,
        logPrefix]
      rw [List.take_append_of_le_length
        (by
          simpa [List.length_take] using
            Nat.le_min.mpr
              ⟨previousAtLeastIndex, oldBound⟩)]
      simp [List.take_take,
        Nat.min_eq_left previousAtLeastIndex]
    rw [prefixAtOld, ← resultPrefixEq]
    exact logPrefix_isLogPrefix _ _
  · have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    simpa [next, rawNext, nextReceive, head, body,
      nextAppendEntriesNoConflict, conflictRollback,
      branchEnabled.2.1.1, followerIsDest] using retained

private theorem conflictThenNoConflict_retains_certificatePrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state boundaryState : State}
    {owner follower receiveDest receiveSource : Node}
    {message : Message}
    {previousIndex previousTerm leaderCommitIndex index : Nat}
    {entries : List Entry}
    (stateAt :
      StateAt start actions endState state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (termLower :
      certificate.choiceTerm <= state.currentTerm follower)
    (retained :
      isLogPrefix certificate.chosenPrefix (state.log follower))
    (head :
      headMessage? state receiveDest receiveSource = some message)
    (body :
      message.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (enabled :
      Enabled state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)) :
    isLogPrefix
      certificate.chosenPrefix
      ((next state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)).log follower) := by
  by_cases followerIsDest : follower = receiveDest
  · subst receiveDest
    have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    rcases stateAt with ⟨stateAtWitness⟩
    have requests :=
      queueHistory_implies_AppendEntriesRequestHistoryConsistent
        (protocolHistory_implies_QueueHistoryConsistent
          stateAtWitness.stateHistory)
    have requestQueued :
        message ∈ state.messages follower receiveSource :=
      headMessage?_mem state follower receiveSource message head
    rcases
        (by
          simpa [body] using
            requests follower receiveSource message requestQueued) with
      ⟨send⟩
    have fields := body
    rw [send.message_eq] at fields
    simp [appendEntriesMessage] at fields
    rcases fields with
      ⟨previousIndexEq, previousTermEq, entriesEq,
        leaderCommitIndexEq⟩
    subst previousIndex
    subst previousTerm
    subst entries
    subst leaderCommitIndex
    have requestSend :
        Occurs
          start actions endState send.sendState
          (.appendEntries receiveSource follower) :=
      occurs_extend_stateAtWitness stateAtWitness send.occurrence
    have requestLeader :
        send.sendState.leadershipState receiveSource = .leader := by
      rcases send.occurrence with ⟨sendOccurrence⟩
      have sendEnabled := sendOccurrence.enabled
      simp [Enabled, actionEnabled] at sendEnabled
      exact sendEnabled.1.1.2
    have accept :
        appendEntriesAcceptBase
            state
            follower
            (send.sendState.currentTerm receiveSource)
            (send.sendState.sentIndex receiveSource follower)
            (((entryAt?
                  (send.sendState.log receiveSource)
                  (send.sendState.sentIndex receiveSource follower)).map
                (·.term)).getD 0) =
          true := by
      simpa [send.message_eq, appendEntriesMessage] using
        branchEnabled.2.2.1.1
    have acceptFacts := accept
    simp [appendEntriesAcceptBase] at acceptFacts
    have sendTermLower :
        certificate.choiceTerm <=
          send.sendState.currentTerm receiveSource := by
      exact termLower.trans_eq acceptFacts.1.1.1.symm
    have prefixLength :=
      chosenCommitCertificate_chosenPrefix_length certificate
    have previousAtLeastIndex :
        index <= send.sendState.sentIndex receiveSource follower := by
      by_cases sameChoiceTerm :
          send.sendState.currentTerm receiveSource =
            certificate.choiceTerm
      · have sourceEq :
            receiveSource = certificate.choiceLeader :=
          leaderUniqueness
            send.sendState
            certificate.choiceState
            (occurs_before_stateAt requestSend)
            certificate.choice_at
            receiveSource
            certificate.choiceLeader
            requestLeader
            certificate.choice_leader
            (sameChoiceTerm.trans certificate.choice_term.symm)
        subst receiveSource
        have comparable :=
          historical_sameTerm_leader_logs_comparable
            (occurs_before_stateAt requestSend)
            certificate.choice_at
            certificate.choiceLeader
            requestLeader
            certificate.choice_leader
            (sameChoiceTerm.trans certificate.choice_term.symm)
        have referenceComparable :
            Or
              (isLogPrefix
                (certificate.choiceState.log certificate.choiceLeader)
                (send.sendState.log certificate.choiceLeader))
              (isLogPrefix
                (send.sendState.log certificate.choiceLeader)
                (certificate.choiceState.log certificate.choiceLeader)) := by
          rcases comparable with sendToChoice | choiceToSend
          · exact Or.inr sendToChoice
          · exact Or.inl choiceToSend
        exact
          appendEntriesConflict_previousIndex_ge_referencePrefix
            state
            follower
            (send.sendState.log certificate.choiceLeader)
            (certificate.choiceState.log certificate.choiceLeader)
            certificate.chosenPrefix
            (send.sendState.sentIndex certificate.choiceLeader follower)
            index
            certificate.choice_prefix_eq
            prefixLength
            retained
            referenceComparable
            (by
              simpa [send.message_eq, appendEntriesMessage] using
                branchEnabled.2.2.1.2)
      · have higherChoiceTerm :
            certificate.choiceTerm <
              send.sendState.currentTerm receiveSource := by
          omega
        have sourceCarries :=
          certificate.higher_term_leaders
            send.sendState
            (occurs_before_stateAt requestSend)
            receiveSource
            requestLeader
            higherChoiceTerm
        have selfPrefixEq :
            certificate.chosenPrefix =
              logPrefix certificate.chosenPrefix index := by
          have takeLength :
              certificate.chosenPrefix.take
                  certificate.chosenPrefix.length =
                certificate.chosenPrefix :=
            List.take_length
          exact
            takeLength.symm.trans
              (by
                simpa [logPrefix] using
                  congrArg
                    (fun n => certificate.chosenPrefix.take n)
                    prefixLength)
        exact
          appendEntriesConflict_previousIndex_ge_referencePrefix
            state
            follower
            (send.sendState.log receiveSource)
            certificate.chosenPrefix
            certificate.chosenPrefix
            (send.sendState.sentIndex receiveSource follower)
            index
            selfPrefixEq
            prefixLength
            retained
            (Or.inl sourceCarries)
            (by
              simpa [send.message_eq, appendEntriesMessage] using
                branchEnabled.2.2.1.2)
    have oldBound : index <= (state.log follower).length := by
      rw [← prefixLength]
      exact retained.length_le
    have prefixAtOld :
        certificate.chosenPrefix =
          logPrefix (state.log follower) index :=
      prefix_eq_logPrefix_of_length
        _
        _
        index
        retained
        prefixLength
    have resultPrefixEq :
        logPrefix
            ((next state
              (.receive
                follower receiveSource
                .appendEntriesConflictThenNoConflict)).log follower)
            index =
          logPrefix (state.log follower) index := by
      simp [next, rawNext, nextReceive, head,
        send.message_eq, appendEntriesMessage,
        nextAppendEntriesNoConflict, conflictRollback,
        logPrefix]
      rw [List.take_append_of_le_length
        (by
          simpa [List.length_take] using
            Nat.le_min.mpr
              ⟨previousAtLeastIndex, oldBound⟩)]
      simp [List.take_take,
        Nat.min_eq_left previousAtLeastIndex]
    rw [prefixAtOld, ← resultPrefixEq]
    exact logPrefix_isLogPrefix _ _
  · have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    simpa [next, rawNext, nextReceive, head, body,
      nextAppendEntriesNoConflict, conflictRollback,
      branchEnabled.2.1.1, followerIsDest] using retained

private theorem chosenCommitCertificate_prefix_committable
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState state : State}
    {owner node : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (retained :
      isLogPrefix certificate.chosenPrefix (state.log node)) :
    isLogPrefix certificate.chosenPrefix (committable state node) := by
  cases atBoundary :
      entryAt? (boundaryState.log owner) index with
  | none =>
      have impossible := boundary.2.2
      simp [atBoundary] at impossible
  | some entry =>
      have entrySignature : entry.content = .signature := by
        simpa [atBoundary] using boundary.2.2
      have atChosen :
          entryAt? certificate.chosenPrefix index = some entry := by
        rw [certificate.prefix_eq]
        exact
          entryAt?_take_of_some
            (boundaryState.log owner)
            index
            index
            entry
            atBoundary
            (by omega)
      rcases retained with ⟨suffix, stateLogEq⟩
      have atState :
          entryAt? (state.log node) index = some entry := by
        rw [← stateLogEq]
        exact
          entryAt?_append_of_some
            certificate.chosenPrefix suffix index entry atChosen
      have signatureAtState :
          (entryAt? (state.log node) index).map (·.content) =
            some .signature := by
        simp [atState, entrySignature]
      have withinCommittable :
          index <= maxCommittableIndex (state.log node) :=
        index_le_maxCommittableIndex_of_signature
          (state.log node) index signatureAtState
      have prefixLength :=
        chosenCommitCertificate_chosenPrefix_length certificate
      have prefixAtState :
          certificate.chosenPrefix =
            logPrefix (state.log node) index :=
        prefix_eq_logPrefix_of_length
          certificate.chosenPrefix
          (state.log node)
          index
          ⟨suffix, stateLogEq⟩
          prefixLength
      rw [committable, prefixAtState]
      exact
        logPrefix_mono_isLogPrefix
          (state.log node)
          index
          (maxCommittableIndex (state.log node))
          withinCommittable

private theorem chosenCommitCertificate_prefix_step
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state boundaryState : State}
    {owner member : Node}
    {index : Nat}
    {action : Action}
    (stateAt :
      StateAt start actions endState state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (termLower :
      certificate.choiceTerm <= state.currentTerm member)
    (retained :
      isLogPrefix certificate.chosenPrefix (state.log member))
    (enabled : Enabled state action) :
    isLogPrefix
      certificate.chosenPrefix
      ((next state action).log member) := by
  have retainLog
      (logRetained :
        isLogPrefix
          (state.log member)
          ((next state action).log member)) :
      isLogPrefix
        certificate.chosenPrefix
        ((next state action).log member) :=
    retained.trans logRetained
  cases action with
  | timeout node =>
      exact retainLog (by simp [isLogPrefix, next, rawNext, nextTimeout])
  | requestVote source dest =>
      exact retainLog (by simp [isLogPrefix, next, rawNext, nextRequestVote])
  | appendEntries source dest =>
      exact retainLog (by simp [isLogPrefix, next, rawNext, nextAppendEntries])
  | becomeLeader elected =>
      by_cases memberIsElected : member = elected
      · subst elected
        simpa [next, rawNext, nextBecomeLeader] using
          chosenCommitCertificate_prefix_committable
            certificate boundary retained
      · exact retainLog
          (by
            simp [isLogPrefix, next, rawNext, nextBecomeLeader,
              memberIsElected])
  | clientRequest node =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextClientRequest])
      · exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextClientRequest,
            memberIsNode])
  | signCommittableMessages node =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages])
      · exact retainLog
          (by
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages, memberIsNode])
  | changeConfiguration node configuration =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration])
      · exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration,
            memberIsNode])
  | advanceCommitIndex node =>
      exact retainLog
        (by simp [isLogPrefix, next, rawNext, nextAdvanceCommitIndex])
  | receive receiveDest receiveSource kind =>
      cases head :
          headMessage? state receiveDest receiveSource with
      | none =>
          exact retainLog
            (by simp [isLogPrefix, next, rawNext, nextReceive, head])
      | some message =>
          cases kind with
          | rejectAppendEntriesRequest =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      exact retainLog
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, responseCase])
                  | some producedResponse =>
                      exact retainLog
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, responseCase])
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesNoConflict =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have enabledFacts := enabled
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabledFacts
                  have messageDest : message.dest = receiveDest :=
                    enabledFacts.2.1.1
                  have noConflict := enabledFacts.2.2.2
                  exact retainLog
                    (by
                      by_cases memberIsDest : member = receiveDest
                      · subst member
                        simpa [next, rawNext, nextReceive, head, body,
                          messageDest] using
                          appendEntriesNoConflict_retains_old_log
                            state message previousIndex entries
                            leaderCommitIndex noConflict
                      · simp [isLogPrefix, next, rawNext, nextReceive,
                          head, body, nextAppendEntriesNoConflict,
                          messageDest, memberIsDest])
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesConflictThenAlreadyDone =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, head] at branchEnabled
                  have requestDestEq := branchEnabled.2.1.1
                  have branchEnabled := branchEnabled.2.2
                  simp [receiveBranchEnabled, body,
                    appendEntriesAcceptBase, appendEntriesLogOK,
                    appendEntriesAlreadyDoneGuard,
                    appendEntriesConflictGuard, conflictRollback,
                    updateNode, requestDestEq] at branchEnabled
                  rcases branchEnabled with
                    ⟨⟨_, conflict⟩, alreadyDone⟩
                  have entriesNonempty : entries ≠ [] :=
                    conflict.1.1
                  rcases alreadyDone with entriesEmpty | bounded
                  · exact False.elim (entriesNonempty entriesEmpty)
                  · exact False.elim (entriesNonempty bounded.2)
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesConflictThenNoConflict =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  exact
                    conflictThenNoConflict_retains_certificatePrefix
                      stateAt
                      leaderUniqueness
                      certificate
                      termLower
                      retained
                      head
                      body
                      enabled
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | _ =>
              cases body : message.body <;>
                exact retainLog
                  (by
                    simp [isLogPrefix, next, rawNext, nextReceive,
                      head, body, nextAppendEntriesAlreadyDone])

private theorem chosenCommitCertificate_prefix_retained_to_higher_term_vote
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState ackState grantState : State}
    {owner choiceLeader member candidate : Node}
    {index choiceTerm candidateTerm : Nat}
    {kind : AEResponseKind}
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (ack :
      OccurrenceWitness
        start actions endState ackState
        (.receive member choiceLeader kind.receiveKind))
    (grant :
      OccurrenceWitness
        start actions endState grantState
        (.receive member candidate .handleRequestVoteRequest))
    (ackAfterTerm :
      (next ackState
        (.receive member choiceLeader kind.receiveKind)).currentTerm member =
        choiceTerm)
    (certificateTermLe :
      certificate.choiceTerm <= choiceTerm)
    (grantTerm :
      grantState.currentTerm member = candidateTerm)
    (higherTerm : choiceTerm < candidateTerm)
    (acknowledged :
      isLogPrefix
        certificate.chosenPrefix
        ((next ackState
          (.receive member choiceLeader kind.receiveKind)).log member)) :
    isLogPrefix certificate.chosenPrefix (grantState.log member) := by
  have ackBeforeGrant :=
    higherTerm_vote_ackActions_prefix
      ack grant ackAfterTerm grantTerm higherTerm
  rcases ackBeforeGrant with ⟨betweenActions, grantPastEq⟩
  have ackAfterHistory :
      ProtocolHistory
        start
        (ack.pastActions ++
          [.receive member choiceLeader kind.receiveKind])
        (next ackState
          (.receive member choiceLeader kind.receiveKind)) :=
    replays_append_singleton ack.before_history ack.enabled
  have grantHistory :
      ProtocolHistory
        start
        ((ack.pastActions ++
            [.receive member choiceLeader kind.receiveKind]) ++
          betweenActions)
        grantState := by
    rw [grantPastEq]
    exact grant.before_history
  rcases replays_append_split grantHistory with
    ⟨middleState, ackReplay, betweenReplay⟩
  have middleStateEq :
      middleState =
        next ackState
          (.receive member choiceLeader kind.receiveKind) :=
    replays_deterministic ackReplay ackAfterHistory
  have actualBetween :
      Replays
        (next ackState
          (.receive member choiceLeader kind.receiveKind))
        betweenActions
        grantState := by
    simpa only [middleStateEq] using betweenReplay
  have retain :
      forall
        (past suffix : List Action)
        (before : State),
        grant.pastActions = past ++ suffix ->
          ProtocolHistory start past before ->
            Replays before suffix grantState ->
              certificate.choiceTerm <= before.currentTerm member ->
                isLogPrefix
                    certificate.chosenPrefix
                    (before.log member) ->
                  isLogPrefix
                    certificate.chosenPrefix
                    (grantState.log member) := by
    intro past suffix
    induction suffix generalizing past with
    | nil =>
        intro before _pastEq _pastHistory replay _termLower retained
        simp [Replays] at replay
        subst before
        exact retained
    | cons nextAction tail inductionHypothesis =>
        intro before pastEq pastHistory replay termLower retained
        rcases replay with ⟨enabled, tailReplay⟩
        have nextHistory :=
          replays_append_singleton pastHistory enabled
        have beforeAt :
            StateAt start actions endState before :=
          ⟨{
            pastActions := past
            futureActions :=
              (nextAction :: tail) ++
                [.receive
                  member candidate .handleRequestVoteRequest] ++
                grant.futureActions
            actions_eq := by
              calc
                actions =
                    grant.pastActions ++
                      [.receive
                        member candidate
                        .handleRequestVoteRequest] ++
                      grant.futureActions :=
                  grant.actions_eq
                _ =
                    past ++
                      ((nextAction :: tail) ++
                        [.receive
                          member candidate
                          .handleRequestVoteRequest] ++
                        grant.futureActions) := by
                  rw [pastEq]
                  simp only [List.append_assoc]
            stateHistory := pastHistory
            remainingHistory := by
              have toGrant :
                  Replays before (nextAction :: tail) grantState :=
                ⟨enabled, tailReplay⟩
              have fromGrant :
                  Replays
                    grantState
                    (.receive
                        member candidate
                        .handleRequestVoteRequest ::
                      grant.futureActions)
                    endState :=
                ⟨grant.enabled, grant.after_history⟩
              simpa only [List.singleton_append, List.append_assoc] using
                replays_append toGrant fromGrant
          }⟩
        have nextRetained :=
          chosenCommitCertificate_prefix_step
            beforeAt
            leaderUniqueness
            certificate
            boundary
            termLower
            retained
            enabled
        have nextTermLower :
            certificate.choiceTerm <=
              (next before nextAction).currentTerm member :=
          Nat.le_trans
            termLower
            (monotonicTerm_step before nextAction enabled member)
        exact
          inductionHypothesis
            (past ++ [nextAction])
            (next before nextAction)
            (by
              simpa only [List.append_assoc, List.singleton_append] using
                pastEq)
            nextHistory
            tailReplay
            nextTermLower
            nextRetained
  exact
    retain
      (ack.pastActions ++
        [.receive member choiceLeader kind.receiveKind])
      betweenActions
      (next ackState
        (.receive member choiceLeader kind.receiveKind))
      grantPastEq.symm
      ackAfterHistory
      actualBetween
      (by
        rw [ackAfterTerm]
        exact certificateTermLe)
      acknowledged

private theorem chosenCommitCertificate_prefix_retained_to_endpoint
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState historicalState : State}
    {owner member : Node}
    {index : Nat}
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (historicalAt :
      StateAt start actions endState historicalState)
    (termLower :
      certificate.choiceTerm <= historicalState.currentTerm member)
    (retained :
      isLogPrefix
        certificate.chosenPrefix
        (historicalState.log member)) :
    isLogPrefix certificate.chosenPrefix (endState.log member) := by
  rcases historicalAt with ⟨endpoint⟩
  have extend :
      forall
        (past suffix : List Action)
        (before : State),
        actions = past ++ suffix ->
          ProtocolHistory start past before ->
            Replays before suffix endState ->
              certificate.choiceTerm <= before.currentTerm member ->
                isLogPrefix certificate.chosenPrefix (before.log member) ->
                  isLogPrefix
                    certificate.chosenPrefix
                    (endState.log member) := by
    intro past suffix
    induction suffix generalizing past with
    | nil =>
        intro before _actionsEq _pastHistory replay _termLower retained
        simp [Replays] at replay
        subst before
        exact retained
    | cons nextAction tail inductionHypothesis =>
        intro before actionsEq pastHistory replay termLower retained
        rcases replay with ⟨enabled, tailReplay⟩
        have nextHistory :=
          replays_append_singleton pastHistory enabled
        have beforeAt :
            StateAt start actions endState before :=
          ⟨{
            pastActions := past
            futureActions := nextAction :: tail
            actions_eq := actionsEq
            stateHistory := pastHistory
            remainingHistory := ⟨enabled, tailReplay⟩
          }⟩
        have nextRetained :=
          chosenCommitCertificate_prefix_step
            beforeAt
            leaderUniqueness
            certificate
            boundary
            termLower
            retained
            enabled
        have nextTermLower :
            certificate.choiceTerm <=
              (next before nextAction).currentTerm member :=
          Nat.le_trans
            termLower
            (monotonicTerm_step before nextAction enabled member)
        exact
          inductionHypothesis
            (past ++ [nextAction])
            (next before nextAction)
            (by
              simpa only [List.append_assoc, List.singleton_append] using
                actionsEq)
            nextHistory
            tailReplay
            nextTermLower
            nextRetained
  exact
    extend
      endpoint.pastActions
      endpoint.futureActions
      historicalState
      endpoint.actions_eq
      endpoint.stateHistory
      endpoint.remainingHistory
      termLower
      retained

