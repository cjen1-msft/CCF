        candidate
        candidateRole
        previousEarlier
        candidateQuorum
  rcases
      advanceCommitIndex_candidate_commonConfiguration_or_carries
        history
        core
        enabled
        commitBefore
        indexWithin
        candidateEndpoint
        higherTermLeaders
        higherTerm
        candidateWitness
        previousCarries with
    carries | ⟨configuration, candidateConfiguration,
      choiceConfiguration, configurationWithin⟩
  · exact carries
  · have candidateQuorumAtConfiguration :
        isQuorum
            (candidateState.votesGranted candidate ∩ configuration.nodes)
