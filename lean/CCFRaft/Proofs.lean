theorem advanceCommitIndex_hasChosenCommitCertificate_of_candidateBarriers
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    {index : Nat}
    {configuration : ConfigurationAt}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (currentMatchPrefixes :
      CurrentMatchIndexPrefixHistoryConsistent start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (commitBefore : state.commitIndex leader < index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (configurationAt :
      committedConfigurationAt?
          (state.log leader)
          index =
        some configuration)
    (countedCandidateBarrier :
      forall candidateState,
        StateAt
            start
            (actions ++ [.advanceCommitIndex leader])
            (next state (.advanceCommitIndex leader))
            candidateState ->
          forall candidate : Node,
            candidateState.leadershipState candidate = .candidate ->
              state.currentTerm leader <
                  candidateState.currentTerm candidate ->
                allConfigurationsHaveQuorum
                    (candidateState.votesGranted candidate)
                    (candidateState.configurations candidate) =
                  true ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (candidateState.log candidate))
    (potentialCandidateBarrier :
      forall candidateState,
        StateAt
            start
            (actions ++ [.advanceCommitIndex leader])
            (next state (.advanceCommitIndex leader))
            candidateState ->
          forall candidate : Node,
            candidateState.leadershipState candidate = .candidate ->
              state.currentTerm leader <
                  candidateState.currentTerm candidate ->
                PotentialCandidateQuorum candidateState candidate ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (candidateState.log candidate)) :
    HasChosenCommitCertificate
      start
      (actions ++ [.advanceCommitIndex leader])
      (next state (.advanceCommitIndex leader))
      (next state (.advanceCommitIndex leader))
      leader
      index := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have leaderState : state.leadershipState leader = .leader :=
    enabledFacts.1.2
  have highestPositive :
      0 < highestCommittableIndex state leader := by
    omega
  have nextHistory :=
    replays_append_singleton history enabled
  have endpointAt :
      StateAt
        start
        (actions ++ [.advanceCommitIndex leader])
        (next state (.advanceCommitIndex leader))
        (next state (.advanceCommitIndex leader)) :=
    protocolHistory_final_stateAt nextHistory
  have stateOccurrence :
      Occurs
        start
        (actions ++ [.advanceCommitIndex leader])
        (next state (.advanceCommitIndex leader))
        state
        (.advanceCommitIndex leader) :=
    protocolHistory_append_occurs history enabled
  have stateAt :
      StateAt
        start
        (actions ++ [.advanceCommitIndex leader])
        (next state (.advanceCommitIndex leader))
        state :=
    occurs_before_stateAt stateOccurrence
  have boundaryContentAtState :
      (entryAt? (state.log leader) index).map (·.content) =
        some .signature := by
    simpa [next, rawNext, nextAdvanceCommitIndex] using boundary.2.2
  cases boundaryEntryAt :
      entryAt? (state.log leader) index with
  | none =>
      simp [boundaryEntryAt] at boundaryContentAtState
  | some boundaryEntry =>
    have boundaryEntrySignature :
        boundaryEntry.content = .signature := by
      simpa [boundaryEntryAt] using boundaryContentAtState
    have choiceEntryExists :
        Exists fun choiceEntry =>
          And
            (entryAt?
                (state.log leader)
                (highestCommittableIndex state leader) =
              some choiceEntry)
            (And
              (choiceEntry.term = state.currentTerm leader)
              (choiceEntry.content = .signature)) := by
      rcases
          highestCommittableIndex_signature_or_zero state leader with
        highestZero |
          ⟨choiceEntry, choiceEntryAt, choiceEntryTerm,
            choiceEntrySignature⟩
      · omega
      · exact
          ⟨choiceEntry, choiceEntryAt, choiceEntryTerm,
            choiceEntrySignature⟩
    rcases choiceEntryExists with
      ⟨choiceEntry, choiceEntryAt, choiceEntryTerm,
        choiceEntrySignature⟩
    have choiceEntryEq :
        choiceEntry =
          ({ term := state.currentTerm leader, content := .signature } :
            Entry) := by
      cases choiceEntry with
      | mk term content =>
          simp_all
    have choiceIndexEntry :
        entryAt?
            (state.log leader)
            (highestCommittableIndex state leader) =
          some
          ({ term := state.currentTerm leader, content := .signature } :
            Entry) := by
      simpa [choiceEntryEq] using choiceEntryAt
    have configurationsExact :
          ConfigurationsExactInv state :=
        reachable_ConfigurationsExactInv
          start
          (protocolHistory_reachable history)
    have configurationActive :
          configuration ∈ state.configurations leader :=
        configurationsExact_committedConfigurationAt?_mem_of_commit_le
          state
          leader
          index
          configurationsExact
          (Nat.le_of_lt commitBefore)
          configuration
          configurationAt
    have configurationFacts :=
        committedConfigurationAt?_some_properties
          (state.log leader)
          index
          configuration
          configurationAt
    have leaderUniqueness :=
        completeSafetyCore_implies_leaderUniqueness history core
    have matchPrefixes :
          MatchIndexPrefixInv state :=
        currentMatchIndexPrefixHistory_implies_MatchIndexPrefixInv
          history
          currentMatchPrefixes
          (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
            history)
          core.electionLogs.counted.logs.logMatching
          leaderUniqueness
    have watermarkSupport :
          forall activeConfiguration,
            activeConfiguration ∈ state.configurations leader ->
              activeConfiguration.index <=
                  highestCommittableIndex state leader ->
                Exists fun activeQuorum : Configuration =>
                  And
                    (isQuorum
                        activeQuorum activeConfiguration.nodes =
                      true)
                    (forall member : Node,
                      member ∈ activeQuorum ->
                        isLogPrefix
                          (logPrefix (state.log leader) index)
                          ((next state
                            (.advanceCommitIndex leader)).log member)) := by
        intro activeConfiguration activeConfigurationMember
          activeConfigurationWithin
        have consensus :=
          highestCommittableIndex_hasConsensusWatermark_of_pos
            state leader highestPositive
        simp [hasConsensusWatermark] at consensus
        have activeConsensus :=
          consensus activeConfiguration activeConfigurationMember
        let agreeing :=
          activeConfiguration.nodes.filter fun member =>
            highestCommittableIndex state leader <=
              state.matchIndex leader member
        let activeQuorum :=
          if leader ∈ activeConfiguration.nodes then
            insert leader agreeing
          else
            agreeing
        have activeQuorumOk :
            isQuorum activeQuorum activeConfiguration.nodes = true := by
          rcases activeConsensus with configurationAfter | quorumOk
          · omega
          · simpa [activeQuorum, agreeing] using quorumOk
        refine ⟨activeQuorum, activeQuorumOk, ?_⟩
        intro member memberInQuorum
        have leaderOrAgreeing :
            Or (member = leader) (member ∈ agreeing) := by
          dsimp [activeQuorum] at memberInQuorum
          by_cases leaderMember : leader ∈ activeConfiguration.nodes
          · simpa [leaderMember] using memberInQuorum
          · exact Or.inr
              (by simpa [leaderMember] using memberInQuorum)
        rcases leaderOrAgreeing with memberIsLeader | memberAgreeing
        · subst member
          simpa [next, rawNext, nextAdvanceCommitIndex] using
            (logPrefix_isLogPrefix (state.log leader) index)
        · have agreeingFacts :
              member ∈ activeConfiguration.nodes ∧
                highestCommittableIndex state leader <=
                  state.matchIndex leader member := by
            simpa [agreeing] using memberAgreeing
          have matchPositive :
              0 < state.matchIndex leader member :=
            highestPositive.trans_le agreeingFacts.2
          have termLe :
              state.currentTerm leader <=
                state.currentTerm member :=
            positiveMatchIndex_leaderTerm_le_followerTerm
              history leader member leaderState matchPositive
          rcases Nat.lt_or_eq_of_le termLe with
            termStrict | termEq
          · exact
              advanceCommitIndex_staleWatermarkMember_retained
                history
                core
                enabled
                indexWithin
                boundary
                countedCandidateBarrier
                agreeingFacts.2
                (by
                  simpa [next, rawNext, nextAdvanceCommitIndex] using
                    termStrict)
          · have prefixFacts :=
              matchPrefixes
                leader
                member
                leaderState
                termEq
            have chosenToLeaderMatch :
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (logPrefix
                    (state.log leader)
                    (state.matchIndex leader member)) :=
              logPrefix_mono_isLogPrefix
                (state.log leader)
                index
                (state.matchIndex leader member)
                (indexWithin.trans agreeingFacts.2)
            rw [prefixFacts.2.2] at chosenToLeaderMatch
            have retained :=
              chosenToLeaderMatch.trans
                (logPrefix_isLogPrefix
                  (state.log member)
                  (state.matchIndex leader member))
            simpa [next, rawNext, nextAdvanceCommitIndex] using retained
    have selectedSupport :=
      watermarkSupport
        configuration
        configurationActive
        (configurationFacts.2.trans indexWithin)
    let quorum := selectedSupport.choose
    have quorumFacts := selectedSupport.choose_spec
    have quorumOk := quorumFacts.1
    have quorumSupport := quorumFacts.2
    exact ⟨{
        boundary_at := endpointAt
        boundaryTerm := boundaryEntry.term
        boundary_term := by
          simp [next, rawNext, nextAdvanceCommitIndex, boundaryEntryAt]
        choiceTerm := state.currentTerm leader
        choiceState := state
        choiceLeader := leader
        choice_at := stateAt
        choice_leader := leaderState
        choice_term := rfl
        choice_term_le_boundary_owner := by
          simp [next, rawNext, nextAdvanceCommitIndex]
        choiceIndex := highestCommittableIndex state leader
        choice_origin := .advance stateOccurrence rfl
        choice_commit_le_boundary := Nat.le_of_lt commitBefore
        choice_progress := Or.inr commitBefore
        boundary_le_choice := indexWithin
        boundary_term_le_choice := by
          have monoAtState : MonoLogInv state :=
            core.electionLogs.counted.logs.monoLogs
              state
              (protocolHistory_final_stateAt history)
          exact
            logEntryTerm_le_currentTerm
              state
              monoAtState
              leader
              index
              boundaryEntry
              boundaryEntryAt
        chosenPrefix := logPrefix (state.log leader) index
        prefix_eq := by
          simp [next, rawNext, nextAdvanceCommitIndex]
        choice_prefix_eq := rfl
        choiceIndexPrefix :=
          logPrefix
            (state.log leader)
            (highestCommittableIndex state leader)
        choice_index_prefix_eq := rfl
        choice_index_entry := choiceIndexEntry
        boundary_prefix_le_choice_prefix :=
          logPrefix_mono_isLogPrefix
            (state.log leader)
            index
            (highestCommittableIndex state leader)
            indexWithin
        configuration
        configuration_at := by
          simpa [next, rawNext, nextAdvanceCommitIndex] using
            configurationAt
        configuration_le_choice :=
          configurationFacts.2.trans indexWithin
        quorum
        quorum_ok := quorumOk
        support_retained := quorumSupport
        watermark_support := watermarkSupport
        watermark_causal_support := by
          intro activeConfiguration activeConfigurationMember
            activeConfigurationWithin
          rcases
            advanceCommitIndex_watermark_causal_support
              history
              enabled
              activeConfiguration
              activeConfigurationMember
              activeConfigurationWithin with
            ⟨activeQuorum, activeQuorumOk, support⟩
          refine ⟨activeQuorum, activeQuorumOk, ?_⟩
          intro member memberInQuorum
          rcases support member memberInQuorum with
            memberIsLeader | supportWitness
          · exact Or.inl memberIsLeader
          · exact Or.inr (Or.inr supportWitness)
        counted_candidate_barrier := by
          intro candidateState candidateStateAt candidate
            candidateRole higherTerm candidateQuorum
          exact
            countedCandidateBarrier
              candidateState
              candidateStateAt
              candidate
              candidateRole
              higherTerm
              candidateQuorum
        potential_candidate_barrier := by
          intro candidateState candidateStateAt candidate
            candidateRole higherTerm candidateQuorum
          exact
            potentialCandidateBarrier
              candidateState
              candidateStateAt
              candidate
              candidateRole
              higherTerm
              candidateQuorum
        higher_term_leaders := by
          exact
            advanceCommitIndex_higherTermLeaders_of_countedCandidateBarrier
              history
              enabled
              boundary
              countedCandidateBarrier
      }⟩

theorem advanceCommitIndex_hasChosenCommitCertificate
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (currentMatchPrefixes :
      CurrentMatchIndexPrefixHistoryConsistent start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (commitBefore : state.commitIndex leader < index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index) :
    HasChosenCommitCertificate
      start
      (actions ++ [.advanceCommitIndex leader])
      (next state (.advanceCommitIndex leader))
      (next state (.advanceCommitIndex leader))
      leader
      index := by
  rcases
      advanceCommitIndex_configurationAt_exists
        history core enabled commitBefore with
    ⟨configuration, configurationAt, _configurationWithin⟩
  have temporal :=
    advanceCommitIndex_pendingChoice_temporalCore
      history core enabled
  have countedBarrier :
      forall candidateState,
        StateAt
            start
            (actions ++ [.advanceCommitIndex leader])
            (next state (.advanceCommitIndex leader))
            candidateState ->
          forall candidate : Node,
            candidateState.leadershipState candidate = .candidate ->
              state.currentTerm leader <
                  candidateState.currentTerm candidate ->
                allConfigurationsHaveQuorum
                    (candidateState.votesGranted candidate)
                    (candidateState.configurations candidate) =
                  true ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (candidateState.log candidate) := by
    intro candidateState candidateAt candidate
      candidateRole higherTerm candidateQuorum
    rcases
        stateAt_append_singleton_cases history enabled candidateAt with
      candidateOld | candidateFinal
    · exact
        (logPrefix_mono_isLogPrefix
          (state.log leader)
          index
          (highestCommittableIndex state leader)
          indexWithin).trans
          (temporal.counted_candidate_barrier
            candidateState
            candidateOld
            candidate
            candidateRole
            higherTerm
            candidateQuorum)
    · subst candidateState
      have enabledFacts := enabled
      simp [Enabled, actionEnabled] at enabledFacts
      have candidateNeLeader : candidate ≠ leader := by
        intro candidateEq
        subst candidate
        simp [next, rawNext, nextAdvanceCommitIndex,
          enabledFacts.1] at candidateRole
        split at candidateRole <;> contradiction
      have oldCandidate :
          state.leadershipState candidate = .candidate := by
        simpa [next, rawNext, nextAdvanceCommitIndex,
          candidateNeLeader] using candidateRole
      have oldHigher :
          state.currentTerm leader <
            state.currentTerm candidate := by
        simpa [next, rawNext, nextAdvanceCommitIndex] using higherTerm
      have oldQuorum :
          allConfigurationsHaveQuorum
              (state.votesGranted candidate)
              (state.configurations candidate) =
            true := by
        simpa [next, rawNext, nextAdvanceCommitIndex,
          candidateNeLeader] using candidateQuorum
      have carries :=
        temporal.counted_candidate_barrier
          state
          (protocolHistory_final_stateAt history)
          candidate
          oldCandidate
          oldHigher
          oldQuorum
      simpa [next, rawNext, nextAdvanceCommitIndex] using
        (logPrefix_mono_isLogPrefix
          (state.log leader)
          index
          (highestCommittableIndex state leader)
          indexWithin).trans carries
  have potentialBarrier :
      forall candidateState,
        StateAt
            start
            (actions ++ [.advanceCommitIndex leader])
            (next state (.advanceCommitIndex leader))
            candidateState ->
          forall candidate : Node,
            candidateState.leadershipState candidate = .candidate ->
              state.currentTerm leader <
                  candidateState.currentTerm candidate ->
                PotentialCandidateQuorum candidateState candidate ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (candidateState.log candidate) := by
    intro candidateState candidateAt candidate
      candidateRole higherTerm candidateQuorum
    rcases
        stateAt_append_singleton_cases history enabled candidateAt with
      candidateOld | candidateFinal
    · exact
        (logPrefix_mono_isLogPrefix
          (state.log leader)
          index
          (highestCommittableIndex state leader)
          indexWithin).trans
          (temporal.potential_candidate_barrier
            candidateState
            candidateOld
            candidate
            candidateRole
            higherTerm
            candidateQuorum)
    · subst candidateState
      have enabledFacts := enabled
      simp [Enabled, actionEnabled] at enabledFacts
      have candidateNeLeader : candidate ≠ leader := by
        intro candidateEq
        subst candidate
        simp [next, rawNext, nextAdvanceCommitIndex,
          enabledFacts.1] at candidateRole
        split at candidateRole <;> contradiction
      have carries :=
        temporal.potential_candidate_barrier
          state
          (protocolHistory_final_stateAt history)
          candidate
          (by
            simpa [next, rawNext, nextAdvanceCommitIndex,
              candidateNeLeader] using
              candidateRole)
          (by
            simpa [next, rawNext, nextAdvanceCommitIndex] using
              higherTerm)
          (by
            simpa [PotentialCandidateQuorum, next, rawNext,
              nextAdvanceCommitIndex, candidateNeLeader] using
              candidateQuorum)
      simpa [next, rawNext, nextAdvanceCommitIndex] using
        (logPrefix_mono_isLogPrefix
          (state.log leader)
          index
          (highestCommittableIndex state leader)
          indexWithin).trans carries
  exact
    advanceCommitIndex_hasChosenCommitCertificate_of_candidateBarriers
      history
      core
      currentMatchPrefixes
      enabled
      commitBefore
      indexWithin
      boundary
      configurationAt
      countedBarrier
      potentialBarrier

private theorem protocolHistory_implies_SignatureInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    SignatureInv state :=
  protocolHistory_induction
    (start := start)
    (property := fun _ current => SignatureInv current)
    (initial_SignatureInv start)
    (by
      intro _ current _ signatures action enabled
      exact signature_step current action signatures enabled)
    history

private theorem committedPrefix_eq_of_index_le_oldCommit
    (state : State)
    (action : Action)
    (owner : Node)
    (index : Nat)
    (signatures : SignatureInv state)
    (enabled : Enabled state action)
    (indexWithinOldCommit : index ≤ state.commitIndex owner) :
    logPrefix (state.log owner) index =
      logPrefix ((next state action).log owner) index := by
  have commitWithinLog :
      state.commitIndex owner ≤ (state.log owner).length :=
    commitIndex_le_log_length state signatures owner
  have committedLength :
      (committed state owner).length = state.commitIndex owner := by
    simp [committed, logPrefix, Nat.min_eq_left commitWithinLog]
  have appendOnly :
      isLogPrefix
        (committed state owner)
        (committed (next state action) owner) :=
    committedLogAppendOnly_step state action signatures enabled owner
  have committedEq :
      committed state owner =
        logPrefix
          (committed (next state action) owner)
          (state.commitIndex owner) :=
    prefix_eq_logPrefix_of_length
      (committed state owner)
      (committed (next state action) owner)
      (state.commitIndex owner)
      appendOnly
      committedLength
  have commitMono :
      state.commitIndex owner ≤ (next state action).commitIndex owner :=
    monotonicCommitIndex_step state action enabled owner
  have lowered :=
    congrArg (fun entries => logPrefix entries index) committedEq
  simpa only [committed, logPrefix, List.take_take,
    Nat.min_eq_left indexWithinOldCommit,
    Nat.min_eq_left commitMono] using lowered

private theorem finalPreviouslyCommittedBoundary_hasChosenCommitCertificate
    (start : InitialConfiguration)
    (actions : List Action)
    (state : State)
    (action : Action)
    (owner : Node)
    (index : Nat)
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (prefixCores :
      ∀ (prefixActions : List Action) (prefixState : State),
        prefixActions <+: actions →
        ProtocolHistory start prefixActions prefixState →
        HistoricalCompleteSafetyCore start prefixActions prefixState)
    (enabled : Enabled state action)
    (indexWithinOldCommit : index ≤ state.commitIndex owner)
    (finalBoundary :
      SignatureCommitBoundary (next state action) owner index) :
    HasChosenCommitCertificate
      start
      (actions ++ [action])
      (next state action)
      (next state action)
      owner
      index := by
  have _prefixCoreSelf :=
    prefixCores actions state List.prefix_rfl history
  have signatures : SignatureInv state :=
    protocolHistory_implies_SignatureInv history
  have prefixEq :
      logPrefix (state.log owner) index =
        logPrefix ((next state action).log owner) index :=
    committedPrefix_eq_of_index_le_oldCommit
      state action owner index signatures enabled indexWithinOldCommit
  have oldBoundary :
      SignatureCommitBoundary state owner index := by
    refine ⟨finalBoundary.1, indexWithinOldCommit, ?_⟩
    cases finalAt :
        entryAt? ((next state action).log owner) index with
    | none =>
        simp [SignatureCommitBoundary, finalAt] at finalBoundary
    | some entry =>
        have oldAt :
            entryAt? (state.log owner) index = some entry :=
          entryAt?_eq_of_logPrefix_eq finalAt prefixEq.symm
        simpa [oldAt, finalAt] using finalBoundary.2.2
  let oldCurrentCore :=
    historicalCompleteSafetyCore_currentChosenCommitCore
      history _prefixCoreSelf
  rcases oldCurrentCore
      state (protocolHistory_final_stateAt history)
      owner index oldBoundary with
    ⟨certificate⟩
  rcases
    chosenCommitCertificate_append_step_coherent
      history core certificate oldBoundary action enabled with
    ⟨extended, extension⟩
  have choiceTermLeOwner :
      extended.choiceTerm ≤ (next state action).currentTerm owner := by
    rw [extension.choiceTerm_eq]
    exact le_trans
      certificate.choice_term_le_boundary_owner
      (monotonicTerm_step state action enabled owner)
  have finalAt :
      StateAt
        start
        (actions ++ [action])
        (next state action)
        (next state action) :=
    protocolHistory_final_stateAt
      (replays_append_singleton history enabled)
  rcases
      chosenCommitCertificate_rebase_boundary
        extended
        finalAt
        finalBoundary
        prefixEq.symm
        choiceTermLeOwner with
    ⟨rebased, _identity⟩
  exact ⟨rebased⟩

private theorem historicalCompleteSafetyCore_implies_currentMatchHistory
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state) :
    CurrentMatchIndexPrefixHistoryConsistent start actions state := by
  have prefixCores :
      forall {prefixActions prefixState},
        prefixActions <+: actions ->
          ProtocolHistory start prefixActions prefixState ->
            HistoricalCompleteSafetyCore
              start prefixActions prefixState :=
    historicalCompleteSafetyCore_prefixes history core
  have hereditary :
      forall
        (pastActions : List Action)
        (pastState : State),
        ProtocolHistory start pastActions pastState ->
          pastActions <+: actions ->
            CurrentMatchIndexPrefixHistoryConsistent
              start pastActions pastState := by
    intro pastActions pastState pastHistory
    apply
      protocolHistory_induction
        (start := start)
        (property := fun currentActions currentState =>
          currentActions <+: actions ->
            CurrentMatchIndexPrefixHistoryConsistent
              start currentActions currentState)
    · intro _initialLe
      exact initial_CurrentMatchIndexPrefixHistoryConsistent start
    · intro currentActions currentState currentHistory currentMatch
        action enabled nextLe
      have currentLe : currentActions <+: actions :=
        (List.prefix_append currentActions [action]).trans nextLe
      have currentCore :=
        prefixCores currentLe currentHistory
      have nextHistory :=
        replays_append_singleton currentHistory enabled
      have nextCore :=
        prefixCores nextLe nextHistory
      exact
        currentMatchIndexPrefixHistory_append_step
          currentHistory
          (currentMatch currentLe)
          currentCore.electionLogs.counted
          (historicalFullElectionLogCore_implies_leaderUniqueness
            currentHistory currentCore.electionLogs)
          (historicalFullElectionLogCore_implies_leaderUniqueness
            nextHistory nextCore.electionLogs)
          (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
            currentHistory)
          enabled
    · exact pastHistory
  exact hereditary actions state history List.prefix_rfl

private theorem receive_commitIndex_eq_of_ne
    (state : State)
    (dest source owner : Node)
    (kind : ReceiveKind)
    (wellFormed : MessagesWellFormedInv state)
    (ownerNeDest : owner ≠ dest) :
    (next state (.receive dest source kind)).commitIndex owner =
      state.commitIndex owner := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [next, rawNext, nextReceive, hmessage]
  | some message =>
      have coordinates :=
        wellFormed dest source message
          (headMessage?_mem state dest source message hmessage)
      cases kind <;>
        cases hbody : message.body <;>
          simp_all [next, rawNext, nextReceive,
            nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
            conflictRollback]
      all_goals split <;> simp_all

private theorem receive_commitIndex_increase_implies_acceptKind
    (state : State)
    (dest source : Node)
    (kind : ReceiveKind)
    (increased :
      state.commitIndex dest <
        (next state (.receive dest source kind)).commitIndex dest) :
    Or
      (kind = .appendEntriesAlreadyDone)
      (Or
        (kind = .appendEntriesNoConflict)
        (Or
          (kind = .appendEntriesConflictThenAlreadyDone)
          (kind = .appendEntriesConflictThenNoConflict))) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [next, rawNext, nextReceive, hmessage] at increased
  | some message =>
      cases kind <;>
        cases hbody : message.body <;>
          simp_all [next, rawNext, nextReceive,
            nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
            conflictRollback]
      all_goals split at increased <;> simp_all

theorem historicalChosenCommitCore_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (_nextElectionLogs :
      HistoricalFullElectionLogCore
        start (actions ++ [action]) (next state action)) :
    HistoricalChosenCommitCore
      start (actions ++ [action]) (next state action) := by
  intro boundaryState boundaryAt owner index boundary
  rcases
      stateAt_append_singleton_cases history enabled boundaryAt with
    boundaryOld | boundaryFinal
  · let oldCurrentCore :=
      historicalCompleteSafetyCore_currentChosenCommitCore history core
    rcases
        oldCurrentCore boundaryState boundaryOld owner index boundary with
      ⟨certificate⟩
    rcases
        chosenCommitCertificate_append_step_coherent
          history core certificate boundary action enabled with
      ⟨extended, _extension⟩
    exact ⟨extended⟩
  · subst boundaryState
    by_cases indexWithinOldCommit :
        index ≤ state.commitIndex owner
    · exact
        finalPreviouslyCommittedBoundary_hasChosenCommitCertificate
          start actions state action owner index history core
          (fun prefixActions prefixState prefixLe prefixHistory =>
            historicalCompleteSafetyCore_prefixes history core
              prefixLe prefixHistory)
          enabled indexWithinOldCommit boundary
    · have increased :
          state.commitIndex owner <
            (next state action).commitIndex owner := by
        exact
          (Nat.lt_of_not_ge indexWithinOldCommit).trans_le
            boundary.2.1
      have currentMatchPrefixes :
          CurrentMatchIndexPrefixHistoryConsistent
            start actions state :=
        historicalCompleteSafetyCore_implies_currentMatchHistory
          history core
      cases action with
      | timeout candidate =>
          simp [next, rawNext, nextTimeout] at increased
      | requestVote source dest =>
          simp [next, rawNext, nextRequestVote] at increased
      | appendEntries source dest =>
          simp [next, rawNext, nextAppendEntries] at increased
      | becomeLeader leader =>
          simp [next, rawNext, nextBecomeLeader] at increased
      | clientRequest leader =>
          simp [next, rawNext, nextClientRequest] at increased
      | signCommittableMessages leader =>
          simp [next, rawNext, nextSignCommittableMessages] at increased
      | changeConfiguration leader configuration =>
          simp [next, rawNext, nextChangeConfiguration] at increased
      | advanceCommitIndex leader =>
          by_cases ownerIsLeader : owner = leader
          · subst owner
            have indexWithin :
                index ≤ highestCommittableIndex state leader := by
              simpa [next, rawNext, nextAdvanceCommitIndex] using
                boundary.2.1
            exact
              advanceCommitIndex_hasChosenCommitCertificate
                history
                core
                currentMatchPrefixes
                enabled
                (by omega)
                indexWithin
                boundary
          · simp [next, rawNext, nextAdvanceCommitIndex,
              ownerIsLeader] at increased
      | receive dest source kind =>
          by_cases ownerIsDest : owner = dest
          · subst owner
            have acceptKind :=
              receive_commitIndex_increase_implies_acceptKind
                state dest source kind increased
            exact
              appendEntriesAccept_chosenCommitCertificate_transport
                history core acceptKind enabled increased boundary
          · exfalso
            have wellFormed :=
              reachable_MessagesWellFormedInv
                start (protocolHistory_reachable history)
            have unchanged :=
              receive_commitIndex_eq_of_ne
                state dest source owner kind wellFormed ownerIsDest
            omega

theorem hereditaryHistoricalChosenCommitCore_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (nextElectionLogs :
      HistoricalFullElectionLogCore
        start (actions ++ [action]) (next state action)) :
    HereditaryHistoricalChosenCommitCore
      start (actions ++ [action]) (next state action) := by
  intro prefixActions prefixState prefixLe prefixHistory
  rcases prefix_append_singleton_cases prefixLe with
    prefixOld | prefixFinal
  · exact core.chosenCommits prefixOld prefixHistory
  · subst prefixActions
    have nextHistory :=
      replays_append_singleton history enabled
    have prefixStateEq :
        prefixState = next state action :=
      replays_deterministic prefixHistory nextHistory
    subst prefixState
    exact
      historicalChosenCommitCore_append_step
        history core action enabled nextElectionLogs

theorem historicalCompleteSafetyCore_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalCompleteSafetyCore
      start (actions ++ [action]) (next state action) := by
  have prefixCores :
      forall {prefixActions prefixState},
        prefixActions <+: actions ->
          ProtocolHistory start prefixActions prefixState ->
            HistoricalCompleteSafetyCore
              start prefixActions prefixState :=
    historicalCompleteSafetyCore_prefixes history core
  let nextElectionLogs :=
    historicalFullElectionLogCore_append_step_local
      history core prefixCores action enabled
  exact
    {
      electionLogs := nextElectionLogs
      chosenCommits :=
        hereditaryHistoricalChosenCommitCore_append_step
          history core action enabled nextElectionLogs
    }

theorem protocolHistory_implies_HistoricalCompleteSafetyCore
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    HistoricalCompleteSafetyCore start actions state :=
  protocolHistory_induction
    (start := start)
    (property := fun actions state =>
      HistoricalCompleteSafetyCore start actions state)
    (initial_HistoricalCompleteSafetyCore start)
    (by
      intro _ current currentHistory currentCore action enabled
      exact
        historicalCompleteSafetyCore_append_step
          currentHistory currentCore action enabled)
    history

theorem reachable_hasHistoricalCompleteSafetyCore
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (HistoricalCompleteSafetyCore start actions state) := by
  rcases reachable_hasProtocolHistory reachable with
    ⟨actions, history⟩
  exact
    ⟨actions, history,
      protocolHistory_implies_HistoricalCompleteSafetyCore history⟩

theorem protocolHistory_implies_localFormationOverlaps
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    And
      (QuorumCandidateFormationOverlap
        start actions state action)
      (And
        (CountedCandidateFormationToPotentialOverlap
          start actions state action)
        (CountedToPotentialCandidateFormationOverlap
          start actions state action)) := by
  have core :=
    protocolHistory_implies_HistoricalCompleteSafetyCore history
  exact
    historicalCompleteSafetyCore_implies_localFormationOverlaps
      history
      core
      (historicalCompleteSafetyCore_prefixes history core)
      action
      enabled

