        ({candidate} ∩ activeConfiguration.nodes)
        activeConfiguration.nodes
        supportQuorumOk
        candidateQuorum with
    ⟨voter, voterSupport, voterCandidate⟩
  have voterEq : voter = candidate := by
    exact Finset.mem_singleton.mp (Finset.mem_inter.mp voterCandidate).1
  subst voter
  rcases support candidate voterSupport with
    candidateIsChoiceLeader | causalWitness
  · subst candidate
    exact
      choiceLeader_endpoint_carries_chosenPrefix
        leaderUniqueness certificate certificateBoundary
  · rcases causalWitness with initialSupport | causalWitness
    · exact
        initial_choice_member_stateAt_carries_chosenPrefix
