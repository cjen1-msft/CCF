theorem initial_QuorumLogInv (start : InitialConfiguration) :
    QuorumLogInv (initialState start) := by
  intro node configurationsNonempty quorum quorumIsMajority
  have nodeMember : node ∈ start.nodes := by
    by_contra notMem
    have emptyConfigurations :
        (initialState start).configurations node = [] := by
      simp [initialState, notMem]
    rw [emptyConfigurations] at configurationsNonempty
    change false = true at configurationsNonempty
    contradiction
  have quorumFacts :
      And
        (quorum ⊆ start.nodes)
        (start.nodes.card < quorum.card * 2) := by
    simpa [initialState, nodeMember, currentConfiguration, isQuorum] using
      quorumIsMajority
  have quorumNonempty : quorum.Nonempty :=
    Finset.card_pos.mp (by omega)
  rcases quorumNonempty with ⟨member, memberInQuorum⟩
  refine ⟨member, memberInQuorum, ?_⟩
  have memberInitial := quorumFacts.1 memberInQuorum
  simp [committed, initialState, nodeMember, memberInitial, isLogPrefix,
    logPrefix, startLog]

