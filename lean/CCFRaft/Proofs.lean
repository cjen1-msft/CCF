        (.appendEntries source follower))
    (originLeader :
      originSendState.leadershipState leader = .leader)
    (requestLeader :
      requestSendState.leadershipState source = .leader)
    (finalLeader :
      endState.leadershipState leader = .leader)
    (originTerm :
      originSendState.currentTerm leader =
        endState.currentTerm leader)
    (followerTerm :
      state.currentTerm follower =
