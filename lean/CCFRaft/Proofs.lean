private theorem initial_VoteHistoryConsistent (start : InitialConfiguration) :
    VoteHistoryConsistent
      (initialState start)
      (fun _ _ => none) :=
  {
    currentChoice := by
      intro voter
      simp [initialState]
    futureEmpty := by
      intro voter term future
      rfl
    countedChoices := by
      intro candidate voter active counted
      simp [initialState] at counted
    grantedResponses := by
      intro dest source message queued isPreVote bodyEq
      simp [initialState] at queued
  }

theorem initial_HasVoteHistory (start : InitialConfiguration) :
    HasVoteHistory (initialState start) :=
  ⟨fun _ _ => none, initial_VoteHistoryConsistent start⟩

theorem initial_HistoricalVoteCore (start : InitialConfiguration) :
    HistoricalVoteCore start [] (initialState start) := by
  refine
    ⟨fun _ _ => none,
      initial_VoteHistoryConsistent start,
      ?_⟩
  intro electionState leader occurrence
  rcases occurrence with ⟨witness⟩
  have actionsEq := witness.actions_eq
  simp at actionsEq

theorem initial_LeaderHistoryConsistent (start : InitialConfiguration) :
    LeaderHistoryConsistent start [] (initialState start) := by
  intro leader leaderState
  have leaderIsStart : leader = start := by
