  choiceTerm_eq :
    second.choiceTerm = first.choiceTerm
  choiceState_eq :
    second.choiceState = first.choiceState
  choiceLeader_eq :
    second.choiceLeader = first.choiceLeader
  choiceIndex_eq :
    second.choiceIndex = first.choiceIndex
