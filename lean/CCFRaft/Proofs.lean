              (state.log message.dest).length < previousIndex then
            0
          else
            (state.log message.dest).getLast?.map (·.term) |>.getD 0
        change
          (if comparisonTerm = previousTerm then
            none
          else if comparisonTerm = 0 then
            some
              {
                term := state.currentTerm message.dest
                source := message.dest
                dest := message.source
                body :=
                  .appendEntriesResponse false
                    (state.log message.dest).length
              }
          else
            let lastIndex :=
              findHighestPossibleMatch
                (state.log message.dest)
                previousIndex
                previousTerm
            let responseTerm :=
              if lastIndex = 0 then
                startTerm
              else
                (entryAt? (state.log message.dest) lastIndex).map
                    (·.term) |>.getD startTerm
            some
              {
                term := responseTerm
                source := message.dest
                dest := message.source
                body := .appendEntriesResponse false lastIndex
              }) =
            some response at responseEq
        by_cases sameTerm : comparisonTerm = previousTerm
        · simp [sameTerm] at responseEq
        · simp [sameTerm] at responseEq
          by_cases zeroComparison : comparisonTerm = 0
          · simp [zeroComparison] at responseEq
            subst response
            exact ⟨(state.log message.dest).length, rfl⟩
          · simp [zeroComparison] at responseEq
            subst response
            exact
              ⟨findHighestPossibleMatch
                  (state.log message.dest)
                  previousIndex
                  previousTerm,
                rfl⟩

private theorem appendEntriesRejectResponse_endpoints_eq
    (state : State)
    (message response : Message)
    (previousIndex previousTerm : Nat)
    (responseEq :
      appendEntriesRejectResponse?
        state message previousIndex previousTerm = some response) :
    And
      (response.source = message.dest)
      (response.dest = message.source) := by
  unfold appendEntriesRejectResponse? at responseEq
  dsimp only at responseEq
  split at responseEq
  · contradiction
  · split at responseEq
    · have responseShape := Option.some.inj responseEq
      subst response
      simp
    · split at responseEq
      · contradiction
      · let comparisonTerm :=
          if previousIndex = 0 ||
              (state.log message.dest).length < previousIndex then
            0
          else
            (state.log message.dest).getLast?.map (·.term) |>.getD 0
        change
          (if comparisonTerm = previousTerm then
            none
          else if comparisonTerm = 0 then
            some
              {
                term := state.currentTerm message.dest
                source := message.dest
                dest := message.source
                body :=
                  .appendEntriesResponse false
                    (state.log message.dest).length
              }
          else
            let lastIndex :=
              findHighestPossibleMatch
                (state.log message.dest)
                previousIndex
                previousTerm
            let responseTerm :=
              if lastIndex = 0 then
                startTerm
              else
                (entryAt? (state.log message.dest) lastIndex).map
                    (·.term) |>.getD startTerm
            some
              {
                term := responseTerm
                source := message.dest
                dest := message.source
                body := .appendEntriesResponse false lastIndex
              }) =
            some response at responseEq
        by_cases sameTerm : comparisonTerm = previousTerm
        · simp [sameTerm] at responseEq
        · simp [sameTerm] at responseEq
          by_cases zeroComparison : comparisonTerm = 0
          · simp [zeroComparison] at responseEq
            subst response
            simp
          · simp [zeroComparison] at responseEq
            subst response
            simp

private theorem firstInserted_appendEntriesResponse_of_reply
    {start : InitialConfiguration}
    {actions : List Action}
    {endState : State}
    {dest source : Node}
    {response : Message}
    (witness :
      MessageEnqueueWitness
        start actions endState dest source response)
    (receiveDest receiveSource : Node)
    (kind : AEResponseKind)
    (request producedResponse : Message)
    (previousIndex previousTerm : Nat)
    (entries : List Entry)
    (leaderCommitIndex : Nat)
    (actionEq :
      witness.action =
        .receive receiveDest receiveSource kind.receiveKind)
    (requestHead :
      headMessage? witness.before receiveDest receiveSource =
        some request)
    (requestBody :
      request.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (messagesAfter :
      (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).messages =
        reply witness.before.messages producedResponse request)
    (producedSource :
      producedResponse.source = receiveDest)
    (producedDest :
      producedResponse.dest = receiveSource) :
    MessageHasAEResponseWitness
      start actions endState dest source response := by
  have presentAfter :
      response ∈
        (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).messages
          dest source := by
    simpa [actionEq] using witness.presentAfter
  have presentReply :
      response ∈
        (reply witness.before.messages producedResponse request)
          dest source := by
    rw [← messagesAfter]
    exact presentAfter
  rcases firstInsertion_reply_eq
      witness.before.messages
      producedResponse
      request
      response
      dest
      source
      witness.absentBefore
      presentReply with
    ⟨destMatches, sourceMatches, _⟩
  have destIsReceiveSource : dest = receiveSource :=
    destMatches.trans producedDest
  have sourceIsReceiveDest : source = receiveDest :=
    sourceMatches.trans producedSource
  have actionMatches :
      witness.action = .receive source dest kind.receiveKind := by
    simpa [sourceIsReceiveDest, destIsReceiveSource] using actionEq
  exact ⟨{
    responseState := witness.before
    request
    previousIndex
    previousTerm
    entries
    leaderCommitIndex
    kind
    occurrence := by
      simpa [actionMatches] using witness.occurrence
    request_head := by
      simpa [sourceIsReceiveDest, destIsReceiveSource] using requestHead
    request_body := requestBody
    response_present := by
      simpa [sourceIsReceiveDest, destIsReceiveSource] using presentAfter
  }⟩

private theorem firstInserted_successfulAck_of_reply
    {start : InitialConfiguration}
    {actions : List Action}
    {endState : State}
    {dest source : Node}
    {response : Message}
    {lastLogIndex : Nat}
    (witness :
      MessageEnqueueWitness
        start actions endState dest source response)
    (receiveDest receiveSource : Node)
    (kind : AEResponseKind)
    (request producedResponse : Message)
    (previousIndex previousTerm : Nat)
    (entries : List Entry)
    (leaderCommitIndex producedLastLogIndex : Nat)
    (actionEq :
      witness.action =
        .receive receiveDest receiveSource kind.receiveKind)
    (requestHead :
      headMessage? witness.before receiveDest receiveSource =
        some request)
    (requestBody :
      request.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (messagesAfter :
      (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).messages =
        reply witness.before.messages producedResponse request)
    (producedSource :
      producedResponse.source = receiveDest)
    (producedDest :
      producedResponse.dest = receiveSource)
    (responseBody :
      response.body =
        .appendEntriesResponse true lastLogIndex)
    (producedBody :
      producedResponse.body =
        .appendEntriesResponse true producedLastLogIndex)
    (producedTerm :
      producedResponse.term =
        (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).currentTerm
            receiveDest)
    (producedIndexBound :
      producedLastLogIndex <=
        ((next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).log
            receiveDest).length) :
    MessageHasAckWitness
      start actions endState dest source response lastLogIndex := by
  have presentAfter :
      response ∈
        (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).messages
          dest source := by
    simpa [actionEq] using witness.presentAfter
  have presentReply :
      response ∈
        (reply witness.before.messages producedResponse request)
          dest source := by
    rw [← messagesAfter]
    exact presentAfter
  rcases firstInsertion_reply_eq
      witness.before.messages
      producedResponse
      request
      response
      dest
      source
      witness.absentBefore
      presentReply with
    ⟨destMatches, sourceMatches, responseEq⟩
  have destIsReceiveSource : dest = receiveSource :=
    destMatches.trans producedDest
  have sourceIsReceiveDest : source = receiveDest :=
    sourceMatches.trans producedSource
  have actionMatches :
      witness.action = .receive source dest kind.receiveKind := by
    simpa [sourceIsReceiveDest, destIsReceiveSource] using actionEq
  have producedLastLogIndexEq :
      producedLastLogIndex = lastLogIndex := by
    rw [responseEq, producedBody] at responseBody
    simpa using responseBody
  have responseTermAtReceive :
      response.term =
        (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).currentTerm
            receiveDest :=
    (congrArg Message.term responseEq).trans producedTerm
  have responseIndexBoundAtReceive :
      lastLogIndex <=
        ((next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).log
            receiveDest).length := by
    rw [← producedLastLogIndexEq]
    exact producedIndexBound
  let origin :
      AEResponseWitness
        start actions endState dest source response :=
    {
      responseState := witness.before
      request
      previousIndex
      previousTerm
      entries
      leaderCommitIndex
      kind
      occurrence := by
        simpa [actionMatches] using witness.occurrence
      request_head := by
        simpa [sourceIsReceiveDest, destIsReceiveSource] using requestHead
      request_body := requestBody
      response_present := by
        simpa [sourceIsReceiveDest, destIsReceiveSource] using presentAfter
    }
  exact ⟨{
    origin
    response_body := responseBody
    response_term := by
      simpa [origin, sourceIsReceiveDest, destIsReceiveSource] using
        responseTermAtReceive
    index_bounded := by
      simpa [origin, sourceIsReceiveDest, destIsReceiveSource] using
        responseIndexBoundAtReceive
  }⟩

private theorem appendEntriesAlreadyDone_response_index_bounded
    (state : State)
    (dest source : Node)
    (request : Message)
    (previousIndex previousTerm : Nat)
    (entries : List Entry)
    (leaderCommitIndex : Nat)
    (head :
      headMessage? state dest source = some request)
    (body :
      request.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (enabled :
      Enabled state
        (.receive dest source .appendEntriesAlreadyDone)) :
    previousIndex + entries.length <=
      ((next state
        (.receive dest source .appendEntriesAlreadyDone)).log dest).length := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled, head] at enabledFacts
  have requestDest := enabledFacts.2.1.1
  have branchEnabled := enabledFacts.2.2
  simp [receiveBranchEnabled, body, appendEntriesAcceptBase,
    appendEntriesLogOK, appendEntriesAlreadyDoneGuard, requestDest] at branchEnabled
  simp [next, rawNext, nextReceive, head, body,
    nextAppendEntriesAlreadyDone, requestDest]
  rcases branchEnabled with ⟨accept, alreadyDone⟩
  rcases alreadyDone with entriesEmpty | bounded
  · subst entries
    simp
    rcases accept.1.2 with previousIndexZero | previousIndexBounded
    · omega
    · exact previousIndexBounded.1
  · exact bounded.1

private theorem appendEntriesConflictThenAlreadyDone_response_index_bounded
    (state : State)
    (dest source : Node)
    (request : Message)
    (previousIndex previousTerm : Nat)
    (entries : List Entry)
    (leaderCommitIndex : Nat)
    (head :
      headMessage? state dest source = some request)
    (body :
      request.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (enabled :
      Enabled state
        (.receive dest source
          .appendEntriesConflictThenAlreadyDone)) :
    previousIndex + entries.length <=
      ((next state
        (.receive dest source
          .appendEntriesConflictThenAlreadyDone)).log dest).length := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled, head] at enabledFacts
  have requestDest := enabledFacts.2.1.1
  have branchEnabled := enabledFacts.2.2
  simp [receiveBranchEnabled, body, appendEntriesAcceptBase,
    appendEntriesLogOK, appendEntriesAlreadyDoneGuard,
    appendEntriesConflictGuard, conflictRollback, updateNode,
    requestDest] at branchEnabled
  rcases branchEnabled with ⟨⟨_, conflict⟩, alreadyDone⟩
  have entriesNonempty : entries ≠ [] := conflict.1.1
  rcases alreadyDone with entriesEmpty | bounded
  · exact False.elim (entriesNonempty entriesEmpty)
  · exact False.elim (entriesNonempty bounded.2)

theorem queueHistory_implies_AppendEntriesRequestHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (queues : QueueHistoryConsistent start actions state) :
    AppendEntriesRequestHistoryConsistent start actions state := by
  intro dest source message queued
  cases bodyEq : message.body with
  | requestVoteRequest lastTerm lastIndex isPreVote =>
      trivial
  | requestVoteResponse voteGranted isPreVote =>
      trivial
  | appendEntriesResponse success lastLogIndex =>
      trivial
  | appendEntriesRequest previousIndex previousTerm entries commitIndex =>
      rcases queues dest source message queued with ⟨witness⟩
      cases actionEq : witness.action with
      | timeout candidate =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextTimeout] using
            witness.presentAfter
      | requestVote sendSource sendDest =>
          have inserted :=
            firstInsertion_enqueue_eq
              witness.before.messages
              (requestVoteMessage witness.before sendSource sendDest)
              message
              dest
              source
              witness.absentBefore
              (by
                simpa [actionEq, next, rawNext, nextRequestVote] using
                  witness.presentAfter)
          rw [inserted.2.2] at bodyEq
          simp [requestVoteMessage] at bodyEq
      | appendEntries sendSource sendDest =>
          have inserted :=
            firstInsertion_enqueue_eq
              witness.before.messages
              (appendEntriesMessage witness.before sendSource sendDest)
              message
              dest
              source
              witness.absentBefore
              (by
                simpa [actionEq, next, rawNext, nextAppendEntries] using
                  witness.presentAfter)
          have destMatches : dest = sendDest := by
            simpa [appendEntriesMessage] using inserted.1
          have sourceMatches : source = sendSource := by
            simpa [appendEntriesMessage] using inserted.2.1
          have actionMatches :
              witness.action = .appendEntries source dest := by
            simpa [sourceMatches, destMatches] using actionEq
          exact ⟨{
            sendState := witness.before
            occurrence := by
              simpa [actionMatches] using witness.occurrence
            message_eq := by
              simpa [sourceMatches, destMatches] using inserted.2.2
          }⟩
      | becomeLeader leader =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextBecomeLeader] using
            witness.presentAfter
      | clientRequest leader =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextClientRequest] using
            witness.presentAfter
      | signCommittableMessages leader =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext,
            nextSignCommittableMessages] using witness.presentAfter
      | changeConfiguration leader configuration =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextChangeConfiguration] using
            witness.presentAfter
      | advanceCommitIndex leader =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextAdvanceCommitIndex] using
            witness.presentAfter
      | receive receiveDest receiveSource kind =>
          have presentAfter :
              message ∈
                (next witness.before
                  (.receive receiveDest receiveSource kind)).messages
                  dest source := by
            simpa [actionEq] using witness.presentAfter
          have impossibleUnchanged
              (messagesAfter :
                (next witness.before
                    (.receive receiveDest receiveSource kind)).messages =
                  witness.before.messages) :
              False := by
            apply witness.absentBefore
            rw [← messagesAfter]
            exact presentAfter
          have impossibleDiscard
              (discarded : Message)
              (messagesAfter :
                (next witness.before
                    (.receive receiveDest receiveSource kind)).messages =
                  Model.discard witness.before.messages discarded) :
              False := by
            apply witness.absentBefore
            exact mem_before_of_mem_discard
              witness.before.messages
              discarded
              message
              dest
              source
              (by
                rw [← messagesAfter]
                exact presentAfter)
          have impossibleReply
              (response request : Message)
              (messagesAfter :
                (next witness.before
                    (.receive receiveDest receiveSource kind)).messages =
                  reply witness.before.messages response request)
              (responseIsNotRequest :
                match response.body with
                | .appendEntriesRequest _ _ _ _ => False
                | _ => True) :
              False := by
            have presentReply :
                message ∈
                  (reply witness.before.messages response request)
                    dest source := by
              rw [← messagesAfter]
              exact presentAfter
            rcases firstInsertion_reply_eq
                witness.before.messages
                response
                request
                message
                dest
                source
                witness.absentBefore
                presentReply with
              ⟨_, _, messageEq⟩
            rw [messageEq] at bodyEq
            rw [bodyEq] at responseIsNotRequest
            exact responseIsNotRequest
          cases hmessage :
              headMessage? witness.before receiveDest receiveSource with
          | none =>
              exact False.elim
                (impossibleUnchanged
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | some request =>
              cases kind with
              | dropIgnored =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | updateTerm =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | handleRequestVoteRequest =>
                  cases hbody : request.body with
                  | requestVoteRequest lastTerm lastIndex isPreVote =>
                      let grant :=
                        requestVoteGranted
                          witness.before
                          receiveDest
                          receiveSource
                          request.term
                          lastTerm
                          lastIndex
                      let response : Message :=
                        {
                          term := witness.before.currentTerm receiveDest
                          source := receiveDest
                          dest := receiveSource
                          body := .requestVoteResponse grant isPreVote
                        }
                      exact False.elim
                        (impossibleReply response request
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody, grant, response])
                          (by simp [response]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | handleRequestVoteResponse =>
                  cases hbody : request.body with
                  | requestVoteResponse voteGranted isPreVote =>
                      exact False.elim
                        (impossibleDiscard request
                          (by
                            cases voteGranted <;>
                              simp [next, rawNext, nextReceive, hmessage,
                                hbody]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | dropRequestVoteResponseOutOfState =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | dropRequestVoteResponseStale =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | rejectAppendEntriesRequest =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      cases responseCase :
                          appendEntriesRejectResponse?
                            witness.before
                            request
                            requestPreviousIndex
                            requestPreviousTerm with
                      | none =>
                          exact False.elim
                            (impossibleUnchanged
                              (by simp [next, rawNext, nextReceive, hmessage,
                                hbody, responseCase]))
                      | some response =>
                          exact False.elim
                            (impossibleReply response request
                              (by
                                simp [next, rawNext, nextReceive, hmessage,
                                  hbody, responseCase])
                              (appendEntriesRejectResponse_is_not_request
                                witness.before
                                request
                                response
                                requestPreviousIndex
                                requestPreviousTerm
                                responseCase))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | returnToFollower =>
                  cases hbody : request.body <;>
                    exact False.elim
                      (impossibleUnchanged
                        (by simp [next, rawNext, nextReceive, hmessage,
                          hbody]))
              | appendEntriesAlreadyDone =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      let response : Message :=
                        {
                          term :=
                            witness.before.currentTerm request.dest
                          source := request.dest
                          dest := request.source
                          body :=
                            .appendEntriesResponse true
                              (requestPreviousIndex + requestEntries.length)
                        }
                      exact False.elim
                        (impossibleReply response request
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody, nextAppendEntriesAlreadyDone, response])
                          (by simp [response]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | appendEntriesNoConflict =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      let nextLog :=
                        (witness.before.log request.dest).take
                            requestPreviousIndex ++
                          requestEntries
                      let response : Message :=
                        {
                          term :=
                            witness.before.currentTerm request.dest
                          source := request.dest
                          dest := request.source
                          body :=
                            .appendEntriesResponse true nextLog.length
                        }
                      exact False.elim
                        (impossibleReply response request
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody, nextAppendEntriesNoConflict, nextLog,
                              response])
                          (by simp [response]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | appendEntriesConflictThenAlreadyDone =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      let response : Message :=
                        {
                          term :=
                            witness.before.currentTerm request.dest
                          source := request.dest
                          dest := request.source
                          body :=
                            .appendEntriesResponse true
                              (requestPreviousIndex + requestEntries.length)
                        }
                      exact False.elim
                        (impossibleReply response request
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody, nextAppendEntriesAlreadyDone,
                              conflictRollback, response])
                          (by simp [response]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | appendEntriesConflictThenNoConflict =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      let rolled :=
                        conflictRollback
                          witness.before receiveDest requestPreviousIndex
                      let nextLog :=
                        (rolled.log request.dest).take requestPreviousIndex ++
                          requestEntries
                      let response : Message :=
                        {
                          term :=
                            witness.before.currentTerm request.dest
                          source := request.dest
                          dest := request.source
                          body :=
                            .appendEntriesResponse true nextLog.length
                        }
                      exact False.elim
                        (impossibleReply response request
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody, nextAppendEntriesNoConflict,
                              conflictRollback, rolled, nextLog, response])
                          (by simp [response]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | handleAppendEntriesResponseSuccess =>
                  cases hbody : request.body with
                  | appendEntriesResponse success lastLogIndex =>
                      exact False.elim
                        (impossibleDiscard request
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | handleAppendEntriesResponseFailure =>
                  cases hbody : request.body with
                  | appendEntriesResponse success lastLogIndex =>
                      exact False.elim
                        (impossibleDiscard request
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | dropAppendEntriesResponseOutOfState =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | dropAppendEntriesResponseStale =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))

theorem queueHistory_implies_RequestVoteMessageHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (queues : QueueHistoryConsistent start actions state) :
    RequestVoteMessageHistoryConsistent start actions state := by
  intro dest source message queued
  rcases queues dest source message queued with ⟨witness⟩
  cases actionEq : witness.action with
  | timeout candidate =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextTimeout] using
        witness.presentAfter
  | requestVote sendSource sendDest =>
      have inserted :=
        firstInsertion_enqueue_eq
          witness.before.messages
          (requestVoteMessage witness.before sendSource sendDest)
          message
          dest
          source
          witness.absentBefore
          (by
            simpa [actionEq, next, rawNext, nextRequestVote] using
              witness.presentAfter)
      cases bodyEq : message.body with
      | requestVoteRequest lastTerm lastIndex isPreVote =>
          have destMatches : dest = sendDest := by
            simpa [requestVoteMessage] using inserted.1
          have sourceMatches : source = sendSource := by
            simpa [requestVoteMessage] using inserted.2.1
          have actionMatches :
              witness.action = .requestVote source dest := by
            simpa [sourceMatches, destMatches] using actionEq
          exact ⟨{
            sendState := witness.before
            occurrence := by
              simpa [actionMatches] using witness.occurrence
            message_eq := by
              simpa [sourceMatches, destMatches] using inserted.2.2
          }⟩
      | requestVoteResponse voteGranted isPreVote =>
          rw [inserted.2.2] at bodyEq
          simp [requestVoteMessage] at bodyEq
      | appendEntriesRequest previousIndex previousTerm entries commitIndex =>
          trivial
      | appendEntriesResponse success lastLogIndex =>
          trivial
  | appendEntries sendSource sendDest =>
      have inserted :=
        firstInsertion_enqueue_eq
          witness.before.messages
          (appendEntriesMessage witness.before sendSource sendDest)
          message
          dest
          source
          witness.absentBefore
          (by
            simpa [actionEq, next, rawNext, nextAppendEntries] using
              witness.presentAfter)
      cases bodyEq : message.body with
      | requestVoteRequest lastTerm lastIndex isPreVote =>
          rw [inserted.2.2] at bodyEq
          simp [appendEntriesMessage] at bodyEq
      | requestVoteResponse voteGranted isPreVote =>
          rw [inserted.2.2] at bodyEq
          simp [appendEntriesMessage] at bodyEq
      | appendEntriesRequest previousIndex previousTerm entries commitIndex =>
          trivial
      | appendEntriesResponse success lastLogIndex =>
          trivial
  | becomeLeader leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextBecomeLeader] using
        witness.presentAfter
  | clientRequest leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextClientRequest] using
        witness.presentAfter
  | signCommittableMessages leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext,
        nextSignCommittableMessages] using witness.presentAfter
  | changeConfiguration leader configuration =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextChangeConfiguration] using
        witness.presentAfter
  | advanceCommitIndex leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextAdvanceCommitIndex] using
        witness.presentAfter
  | receive receiveDest receiveSource kind =>
      have presentAfter :
          message ∈
            (next witness.before
              (.receive receiveDest receiveSource kind)).messages
              dest source := by
        simpa [actionEq] using witness.presentAfter
      have impossibleUnchanged
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              witness.before.messages) :
          False := by
        apply witness.absentBefore
        rw [← messagesAfter]
        exact presentAfter
      have impossibleDiscard
          (discarded : Message)
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              Model.discard witness.before.messages discarded) :
          False := by
        apply witness.absentBefore
        exact mem_before_of_mem_discard
          witness.before.messages
          discarded
          message
          dest
          source
          (by
            rw [← messagesAfter]
            exact presentAfter)
      have impossibleReply
          (response request : Message)
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              reply witness.before.messages response request)
          (responseIsNotRequestVote :
            match response.body with
            | .requestVoteRequest _ _ _ => False
            | .requestVoteResponse _ _ => False
            | _ => True) :
          match message.body with
          | .requestVoteRequest _ _ _ =>
              MessageHasRVSendWitness
                start actions state dest source message
          | .requestVoteResponse _ _ =>
              MessageHasRVResponseWitness
                start actions state dest source message
          | _ => True := by
        have presentReply :
            message ∈
              (reply witness.before.messages response request)
                dest source := by
          rw [← messagesAfter]
          exact presentAfter
        rcases firstInsertion_reply_eq
            witness.before.messages
            response
            request
            message
            dest
            source
            witness.absentBefore
            presentReply with
          ⟨_, _, messageEq⟩
        cases bodyEq : message.body with
        | requestVoteRequest lastTerm lastIndex isPreVote =>
            rw [messageEq] at bodyEq
            rw [bodyEq] at responseIsNotRequestVote
            exact False.elim responseIsNotRequestVote
        | requestVoteResponse voteGranted isPreVote =>
            rw [messageEq] at bodyEq
            rw [bodyEq] at responseIsNotRequestVote
            exact False.elim responseIsNotRequestVote
        | appendEntriesRequest previousIndex previousTerm entries
            commitIndex =>
            trivial
        | appendEntriesResponse success lastLogIndex =>
            trivial
      cases hmessage :
          headMessage? witness.before receiveDest receiveSource with
      | none =>
          exact False.elim
            (impossibleUnchanged
              (by simp [next, rawNext, nextReceive, hmessage]))
      | some request =>
          cases kind with
          | dropIgnored =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | updateTerm =>
              exact False.elim
                (impossibleUnchanged
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | handleRequestVoteRequest =>
              cases hbody : request.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  let grant :=
                    requestVoteGranted
                      witness.before
                      receiveDest
                      receiveSource
                      request.term
                      lastTerm
                      lastIndex
                  let response : Message :=
                    {
                      term := witness.before.currentTerm receiveDest
                      source := receiveDest
                      dest := receiveSource
                      body := .requestVoteResponse grant isPreVote
                    }
                  have presentReply :
                      message ∈
                        (reply
                            witness.before.messages
                            response
                            request)
                          dest source := by
                    have messagesAfter :
                        (next witness.before
                            (.receive
                              receiveDest
                              receiveSource
                              .handleRequestVoteRequest)).messages =
                          reply
                            witness.before.messages
                            response
                            request := by
                      simp [next, rawNext, nextReceive, hmessage,
                        hbody, grant, response]
                    rw [← messagesAfter]
                    simpa using presentAfter
                  rcases firstInsertion_reply_eq
                      witness.before.messages
                      response
                      request
                      message
                      dest
                      source
                      witness.absentBefore
                      presentReply with
                    ⟨destMatches, sourceMatches, messageEq⟩
                  cases bodyEq : message.body with
                  | requestVoteRequest queuedLastTerm queuedLastIndex
                      queuedIsPreVote =>
                      rw [messageEq] at bodyEq
                      simp [response] at bodyEq
                  | requestVoteResponse voteGranted queuedIsPreVote =>
                      have destIsReceiveSource :
                          dest = receiveSource := by
                        simpa [response] using destMatches
                      have sourceIsReceiveDest :
                          source = receiveDest := by
                        simpa [response] using sourceMatches
                      have actionMatches :
                          witness.action =
                            .receive
                              source
                              dest
                              .handleRequestVoteRequest := by
                        simpa [sourceIsReceiveDest, destIsReceiveSource] using
                          actionEq
                      exact ⟨{
                        responseState := witness.before
                        request
                        lastTerm
                        lastIndex
                        isPreVote
                        occurrence := by
                          simpa [actionMatches] using witness.occurrence
                        request_head := by
                          simpa [sourceIsReceiveDest,
                            destIsReceiveSource] using hmessage
                        request_body := hbody
                        response_eq := by
                          simpa [sourceIsReceiveDest,
                            destIsReceiveSource, response, grant] using
                              messageEq
                      }⟩
                  | appendEntriesRequest previousIndex previousTerm entries
                      commitIndex =>
                      trivial
                  | appendEntriesResponse success lastLogIndex =>
                      trivial
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | handleRequestVoteResponse =>
              cases hbody : request.body with
              | requestVoteResponse voteGranted isPreVote =>
                  exact False.elim
                    (impossibleDiscard request
                      (by
                        cases voteGranted <;>
                          simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | dropRequestVoteResponseOutOfState =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | dropRequestVoteResponseStale =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | rejectAppendEntriesRequest =>
              cases hbody : request.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        witness.before
                        request
                        previousIndex
                        previousTerm with
                  | none =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody, responseCase]))
                  | some response =>
                      apply impossibleReply response request
                      · simp [next, rawNext, nextReceive, hmessage,
                          hbody, responseCase]
                      · rcases appendEntriesRejectResponse_body_eq
                            witness.before
                            request
                            response
                            previousIndex
                            previousTerm
                            responseCase with
                          ⟨lastIndex, responseBody⟩
                        simp [responseBody]
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | returnToFollower =>
              cases hbody : request.body <;>
                exact False.elim
                  (impossibleUnchanged
                    (by simp [next, rawNext, nextReceive, hmessage,
                      hbody]))
          | appendEntriesAlreadyDone =>
              cases hbody : request.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let response : Message :=
                    {
                      term := witness.before.currentTerm request.dest
                      source := request.dest
                      dest := request.source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply impossibleReply response request
                  · simp [next, rawNext, nextReceive, hmessage,
                      hbody, nextAppendEntriesAlreadyDone, response]
                  · simp [response]
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | appendEntriesNoConflict =>
              cases hbody : request.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let nextLog :=
                    (witness.before.log request.dest).take previousIndex ++
                      entries
                  let response : Message :=
                    {
                      term := witness.before.currentTerm request.dest
                      source := request.dest
                      dest := request.source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply impossibleReply response request
                  · simp [next, rawNext, nextReceive, hmessage,
                      hbody, nextAppendEntriesNoConflict, nextLog, response]
                  · simp [response]
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : request.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let response : Message :=
                    {
                      term := witness.before.currentTerm request.dest
                      source := request.dest
                      dest := request.source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply impossibleReply response request
                  · simp [next, rawNext, nextReceive, hmessage,
                      hbody, nextAppendEntriesAlreadyDone,
                      conflictRollback, response]
                  · simp [response]
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | appendEntriesConflictThenNoConflict =>
              cases hbody : request.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let rolled :=
                    conflictRollback
                      witness.before receiveDest previousIndex
                  let nextLog :=
                    (rolled.log request.dest).take previousIndex ++ entries
                  let response : Message :=
                    {
                      term := witness.before.currentTerm request.dest
                      source := request.dest
                      dest := request.source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply impossibleReply response request
                  · simp [next, rawNext, nextReceive, hmessage,
                      hbody, nextAppendEntriesNoConflict,
                      conflictRollback, rolled, nextLog, response]
                  · simp [response]
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | handleAppendEntriesResponseSuccess =>
              cases hbody : request.body with
              | appendEntriesResponse success lastLogIndex =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | handleAppendEntriesResponseFailure =>
              cases hbody : request.body with
              | appendEntriesResponse success lastLogIndex =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | dropAppendEntriesResponseOutOfState =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | dropAppendEntriesResponseStale =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))

theorem reachable_hasAppendEntriesRequestHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (AppendEntriesRequestHistoryConsistent start actions state) := by
  rcases reachable_hasCausalHistory reachable with
    ⟨actions, history, queues⟩
  exact
    ⟨actions,
      history,
      queueHistory_implies_AppendEntriesRequestHistoryConsistent queues⟩

private theorem historicalEntryTermLeaderOrigin_retain
    {start : InitialConfiguration}
    {actions : List Action}
    {state historicalState : State}
    {action : Action}
    {node : Node}
    {entry : Entry}
    (origins :
      HistoricalEntryTermLeaderOriginInv start actions state)
    (enabled : Enabled state action)
    (stateAt :
      StateAt start actions state historicalState)
    (member : entry ∈ historicalState.log node)
    (afterStart : startTerm < entry.term) :
    HasEntryTermLeaderWitness
      start
      (actions ++ [action])
      (next state action)
      entry.term := by
  rcases origins historicalState stateAt node entry member afterStart with
    ⟨witness⟩
  exact ⟨entryTermLeaderWitness_extend witness enabled⟩

theorem historicalEntryTermLeaderOrigin_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (origins :
      HistoricalEntryTermLeaderOriginInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalEntryTermLeaderOriginInv
      start
      (actions ++ [action])
      (next state action) := by
  intro historicalState stateAt node entry member afterStart
  rcases stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · exact historicalEntryTermLeaderOrigin_retain
      origins enabled oldState member afterStart
  · subst historicalState
    cases action with
    | timeout candidate =>
        exact historicalEntryTermLeaderOrigin_retain
          origins enabled
          (protocolHistory_final_stateAt history)
          (by
            simpa [next, rawNext, nextTimeout] using member)
          afterStart
    | requestVote source dest =>
        exact historicalEntryTermLeaderOrigin_retain
          origins enabled
          (protocolHistory_final_stateAt history)
          (by
            simpa [next, rawNext, nextRequestVote] using member)
          afterStart
    | appendEntries source dest =>
        exact historicalEntryTermLeaderOrigin_retain
          origins enabled
          (protocolHistory_final_stateAt history)
          (by
            simpa [next, rawNext, nextAppendEntries] using member)
          afterStart
    | becomeLeader leader =>
        by_cases nodeIsLeader : node = leader
        · subst node
          simp [next, rawNext, nextBecomeLeader] at member
          exact historicalEntryTermLeaderOrigin_retain
            origins enabled
            (protocolHistory_final_stateAt history)
            (List.mem_of_mem_take member)
            afterStart
        · exact historicalEntryTermLeaderOrigin_retain
            origins enabled
            (protocolHistory_final_stateAt history)
            (by
              simpa [next, rawNext, nextBecomeLeader,
                nodeIsLeader] using member)
            afterStart
    | clientRequest leader =>
        have clientEnabled := enabled
        simp [Enabled, actionEnabled] at clientEnabled
        by_cases nodeIsLeader : node = leader
        · subst node
          simp [next, rawNext, nextClientRequest] at member
          rcases member with oldEntry | newEntry
          · exact historicalEntryTermLeaderOrigin_retain
              origins enabled
              (protocolHistory_final_stateAt history)
              oldEntry afterStart
          · subst entry
            exact ⟨{
              appendState := state
              leader
              kind := .clientRequest
              occurrence := by
                simpa [LeaderAppendKind.action] using
                  protocolHistory_append_occurs history enabled
              leader_state := clientEnabled.1.2
              term_eq := rfl
            }⟩
        · exact historicalEntryTermLeaderOrigin_retain
            origins enabled
            (protocolHistory_final_stateAt history)
            (by
              simpa [next, rawNext, nextClientRequest,
                nodeIsLeader] using member)
            afterStart
    | signCommittableMessages leader =>
        have signEnabled := enabled
        simp [Enabled, actionEnabled] at signEnabled
        by_cases nodeIsLeader : node = leader
        · subst node
          simp [next, rawNext, nextSignCommittableMessages] at member
          rcases member with oldEntry | newEntry
          · exact historicalEntryTermLeaderOrigin_retain
              origins enabled
              (protocolHistory_final_stateAt history)
              oldEntry afterStart
          · subst entry
            exact ⟨{
              appendState := state
              leader
              kind := .signature
              occurrence := by
                simpa [LeaderAppendKind.action] using
                  protocolHistory_append_occurs history enabled
              leader_state := signEnabled.1.1.2
              term_eq := rfl
            }⟩
        · exact historicalEntryTermLeaderOrigin_retain
            origins enabled
            (protocolHistory_final_stateAt history)
            (by
              simpa [next, rawNext, nextSignCommittableMessages,
                nodeIsLeader] using member)
            afterStart
    | changeConfiguration leader configuration =>
        have changeEnabled := enabled
        simp [Enabled, actionEnabled] at changeEnabled
        by_cases nodeIsLeader : node = leader
        · subst node
          simp [next, rawNext, nextChangeConfiguration] at member
          rcases member with oldEntry | newEntry
          · exact historicalEntryTermLeaderOrigin_retain
              origins enabled
              (protocolHistory_final_stateAt history)
              oldEntry afterStart
          · subst entry
            exact ⟨{
              appendState := state
              leader
              kind := .reconfiguration configuration
              occurrence := by
                simpa [LeaderAppendKind.action] using
                  protocolHistory_append_occurs history enabled
              leader_state := changeEnabled.1.1.1.2
              term_eq := rfl
            }⟩
        · exact historicalEntryTermLeaderOrigin_retain
            origins enabled
            (protocolHistory_final_stateAt history)
            (by
              simpa [next, rawNext, nextChangeConfiguration,
                nodeIsLeader] using member)
            afterStart
    | advanceCommitIndex leader =>
        exact historicalEntryTermLeaderOrigin_retain
          origins enabled
          (protocolHistory_final_stateAt history)
          (by
            simpa [next, rawNext, nextAdvanceCommitIndex] using member)
          afterStart
    | receive dest source kind =>
        cases hmessage : headMessage? state dest source with
        | none =>
            exact historicalEntryTermLeaderOrigin_retain
              origins enabled
              (protocolHistory_final_stateAt history)
              (by
                simpa [next, rawNext, nextReceive, hmessage] using member)
              afterStart
        | some message =>
            cases kind with
            | appendEntriesNoConflict =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    leaderCommitIndex =>
                    have queued :=
                      headMessage?_mem state dest source message hmessage
                    have provenance :
                        MessageHasAESendWitness
                          start actions state dest source message := by
                      simpa [hbody] using
                        requests dest source message queued
                    rcases provenance with ⟨witness⟩
                    rcases witness with
                      ⟨sendState, occurrence, messageEq⟩
                    subst message
                    simp [appendEntriesMessage] at hbody
                    rcases hbody with
                      ⟨previousIndexEq, previousTermEq,
                        entriesEq, leaderCommitIndexEq⟩
                    subst previousIndex
                    subst previousTerm
                    subst entries
                    subst leaderCommitIndex
                    by_cases nodeIsDest : node = dest
                    · subst node
                      simp [next, rawNext, nextReceive, hmessage,
                        appendEntriesMessage,
                        nextAppendEntriesNoConflict] at member
                      rcases member with oldEntry | copiedEntry
                      · exact historicalEntryTermLeaderOrigin_retain
                          origins enabled
                          (protocolHistory_final_stateAt history)
                          (List.mem_of_mem_take oldEntry)
                          afterStart
                      · exact historicalEntryTermLeaderOrigin_retain
                          origins enabled
                          (occurs_before_stateAt occurrence)
                          (subsequence_mem
                            (sendState.log source)
                            (sendState.sentIndex source dest + 1)
                            (min
                              (sendState.log source).length
                              (sendState.sentIndex source dest + 1))
                            entry
                            copiedEntry)
                          afterStart
                    · exact historicalEntryTermLeaderOrigin_retain
                        origins enabled
                        (protocolHistory_final_stateAt history)
                        (by
                          simpa [next, rawNext, nextReceive, hmessage,
                            appendEntriesMessage,
                            nextAppendEntriesNoConflict,
                            nodeIsDest] using member)
                        afterStart
                | _ =>
                    exact historicalEntryTermLeaderOrigin_retain
                      origins enabled
                      (protocolHistory_final_stateAt history)
                      (by
                        simpa [next, rawNext, nextReceive, hmessage,
                          hbody] using member)
                      afterStart
            | appendEntriesConflictThenAlreadyDone =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    leaderCommitIndex =>
                    have branchEnabled := enabled
                    simp [Enabled, actionEnabled, hmessage,
                      receiveBranchEnabled, hbody] at branchEnabled
                    have destMatches : message.dest = dest :=
                      branchEnabled.2.1.1
                    subst dest
                    by_cases nodeIsDest : node = message.dest
                    · subst node
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone,
                        conflictRollback] at member
                      exact historicalEntryTermLeaderOrigin_retain
                        origins enabled
                        (protocolHistory_final_stateAt history)
                        (List.mem_of_mem_take member)
                        afterStart
                    · exact historicalEntryTermLeaderOrigin_retain
                        origins enabled
                        (protocolHistory_final_stateAt history)
                        (by
                          simpa [next, rawNext, nextReceive, hmessage,
                            hbody, nextAppendEntriesAlreadyDone,
                            conflictRollback, nodeIsDest] using member)
                        afterStart
                | _ =>
                    exact historicalEntryTermLeaderOrigin_retain
                      origins enabled
                      (protocolHistory_final_stateAt history)
                      (by
                        simpa [next, rawNext, nextReceive, hmessage,
                          hbody] using member)
                      afterStart
            | appendEntriesConflictThenNoConflict =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    leaderCommitIndex =>
                    have queued :=
                      headMessage?_mem state dest source message hmessage
                    have provenance :
                        MessageHasAESendWitness
                          start actions state dest source message := by
                      simpa [hbody] using
                        requests dest source message queued
                    rcases provenance with ⟨witness⟩
                    rcases witness with
                      ⟨sendState, occurrence, messageEq⟩
                    subst message
                    simp [appendEntriesMessage] at hbody
                    rcases hbody with
                      ⟨previousIndexEq, previousTermEq,
                        entriesEq, leaderCommitIndexEq⟩
                    subst previousIndex
                    subst previousTerm
                    subst entries
                    subst leaderCommitIndex
                    by_cases nodeIsDest : node = dest
                    · subst node
                      simp [next, rawNext, nextReceive, hmessage,
                        appendEntriesMessage,
                        nextAppendEntriesNoConflict,
                        conflictRollback] at member
                      rcases member with oldEntry | copiedEntry
                      · exact historicalEntryTermLeaderOrigin_retain
                          origins enabled
                          (protocolHistory_final_stateAt history)
                          (List.mem_of_mem_take
                            (List.mem_of_mem_take oldEntry))
                          afterStart
                      · exact historicalEntryTermLeaderOrigin_retain
                          origins enabled
                          (occurs_before_stateAt occurrence)
                          (subsequence_mem
                            (sendState.log source)
                            (sendState.sentIndex source dest + 1)
                            (min
                              (sendState.log source).length
                              (sendState.sentIndex source dest + 1))
                            entry
                            copiedEntry)
                          afterStart
                    · exact historicalEntryTermLeaderOrigin_retain
                        origins enabled
                        (protocolHistory_final_stateAt history)
                        (by
                          simpa [next, rawNext, nextReceive, hmessage,
                            appendEntriesMessage,
                            nextAppendEntriesNoConflict,
                            conflictRollback, nodeIsDest] using member)
                        afterStart
                | _ =>
                    exact historicalEntryTermLeaderOrigin_retain
                      origins enabled
                      (protocolHistory_final_stateAt history)
                      (by
                        simpa [next, rawNext, nextReceive, hmessage,
                          hbody] using member)
                      afterStart
            | rejectAppendEntriesRequest =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    leaderCommitIndex =>
                    cases responseCase :
                        appendEntriesRejectResponse?
                          state message previousIndex previousTerm with
                    | none =>
                        exact historicalEntryTermLeaderOrigin_retain
                          origins enabled
                          (protocolHistory_final_stateAt history)
                          (by
                            simpa [next, rawNext, nextReceive, hmessage,
                              hbody, responseCase] using member)
                          afterStart
                    | some response =>
                        exact historicalEntryTermLeaderOrigin_retain
                          origins enabled
                          (protocolHistory_final_stateAt history)
                          (by
                            simpa [next, rawNext, nextReceive, hmessage,
                              hbody, responseCase] using member)
                          afterStart
                | _ =>
                    exact historicalEntryTermLeaderOrigin_retain
                      origins enabled
                      (protocolHistory_final_stateAt history)
                      (by
                        simpa [next, rawNext, nextReceive, hmessage,
                          hbody] using member)
                      afterStart
            | _ =>
                cases hbody : message.body <;>
                  exact historicalEntryTermLeaderOrigin_retain
                    origins enabled
                    (protocolHistory_final_stateAt history)
                    (by
                      simpa [next, rawNext, nextReceive, hmessage,
                        hbody] using member)
                    afterStart

theorem protocolHistory_implies_HistoricalEntryTermLeaderOriginInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    HistoricalEntryTermLeaderOriginInv start actions state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun actions state =>
        HistoricalEntryTermLeaderOriginInv start actions state)
      (initial_HistoricalEntryTermLeaderOriginInv start)
      (by
        intro past current pastHistory origins action enabled
        have requests :=
          queueHistory_implies_AppendEntriesRequestHistoryConsistent
            (protocolHistory_implies_QueueHistoryConsistent
              pastHistory)
        exact historicalEntryTermLeaderOrigin_append_step
          pastHistory origins requests action enabled)
      history

theorem reachable_hasRequestVoteMessageHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (RequestVoteMessageHistoryConsistent start actions state) := by
  rcases reachable_hasCausalHistory reachable with
    ⟨actions, history, queues⟩
  exact
    ⟨actions,
      history,
      queueHistory_implies_RequestVoteMessageHistoryConsistent queues⟩

private def rvResponseWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {dest source : Node}
    {response : Message}
    (witness :
      RVResponseWitness
        start actions state dest source response)
    (enabled : Enabled state action) :
    RVResponseWitness
      start
      (actions ++ [action])
      (next state action)
      dest
      source
      response :=
  {
    responseState := witness.responseState
    request := witness.request
    lastTerm := witness.lastTerm
    lastIndex := witness.lastIndex
    isPreVote := witness.isPreVote
    occurrence := occurs_extend witness.occurrence enabled
    request_head := witness.request_head
    request_body := witness.request_body
    response_eq := witness.response_eq
  }

private def countedGrantedVoteWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {candidate voter : Node}
    (witness :
      CountedGrantedVoteWitness
        start actions state candidate voter)
    (enabled : Enabled state action)
    (candidateTermEq :
      (next state action).currentTerm candidate =
        state.currentTerm candidate) :
    CountedGrantedVoteWitness
      start
      (actions ++ [action])
      (next state action)
      candidate
      voter :=
  {
    countState := witness.countState
    response := witness.response
    responseOrigin :=
      rvResponseWitness_extend witness.responseOrigin enabled
    count_occurrence :=
      occurs_extend witness.count_occurrence enabled
    response_head := witness.response_head
    response_body := witness.response_body
    candidate_term_eq :=
      candidateTermEq.trans witness.candidate_term_eq
  }

private theorem countedVoteGrantHistory_retain
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {candidate voter : Node}
    (history :
      CountedVoteGrantHistoryConsistent start actions state)
    (enabled : Enabled state action)
    (activeBefore :
      Or
        (state.leadershipState candidate = .candidate)
        (state.leadershipState candidate = .leader))
    (countedBefore :
      voter ∈ state.votesGranted candidate)
    (notSelf : voter ≠ candidate)
    (candidateTermEq :
      (next state action).currentTerm candidate =
        state.currentTerm candidate) :
    HasCountedGrantedVoteWitness
      start
      (actions ++ [action])
      (next state action)
      candidate
      voter := by
  rcases
      history candidate voter activeBefore countedBefore notSelf with
    ⟨witness⟩
  exact
    ⟨countedGrantedVoteWitness_extend
      witness enabled candidateTermEq⟩

private theorem countedVoteGrantHistory_of_preserved
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    (history :
      CountedVoteGrantHistoryConsistent start actions state)
    (enabled : Enabled state action)
    (activeBefore :
      forall candidate,
        Or
            ((next state action).leadershipState candidate = .candidate)
            ((next state action).leadershipState candidate = .leader) ->
          Or
            (state.leadershipState candidate = .candidate)
            (state.leadershipState candidate = .leader))
    (countedBefore :
      forall candidate voter,
        voter ∈ (next state action).votesGranted candidate ->
          voter ∈ state.votesGranted candidate)
    (candidateTermEq :
      forall candidate,
        (next state action).currentTerm candidate =
          state.currentTerm candidate) :
    CountedVoteGrantHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  intro candidate voter active counted notSelf
  exact
    countedVoteGrantHistory_retain
      history
      enabled
      (activeBefore candidate active)
      (countedBefore candidate voter counted)
      notSelf
      (candidateTermEq candidate)

theorem initial_CountedVoteGrantHistoryConsistent
    (start : InitialConfiguration) :
    CountedVoteGrantHistoryConsistent
      start [] (initialState start) := by
  intro candidate voter _ counted _
  simp [initialState] at counted

private theorem countedVoteGrantHistory_receive_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (protocol : ProtocolHistory start actions state)
    (history :
      CountedVoteGrantHistoryConsistent start actions state)
    (requestVotes :
      RequestVoteMessageHistoryConsistent start actions state)
    (dest source : Node)
    (kind : ReceiveKind)
    (enabled : Enabled state (.receive dest source kind)) :
    CountedVoteGrantHistoryConsistent
      start
      (actions ++ [.receive dest source kind])
      (next state (.receive dest source kind)) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [Enabled, actionEnabled, hmessage] at enabled
  | some message =>
      cases kind with
      | dropIgnored =>
          apply countedVoteGrantHistory_of_preserved history enabled
          · intro candidate active
            simpa [next, rawNext, nextReceive, hmessage] using active
          · intro candidate voter counted
            simpa [next, rawNext, nextReceive, hmessage] using counted
          · intro candidate
            simp [next, rawNext, nextReceive, hmessage]
      | updateTerm =>
          intro candidate voter activeAfter countedAfter notSelf
          by_cases candidateIsDest : candidate = dest
          · subst candidate
            cases roleEq : state.leadershipState dest <;>
              simp [next, rawNext, nextReceive, hmessage, updateNode,
                roleEq] at activeAfter
          · exact countedVoteGrantHistory_retain
              history
              enabled
              (by
                simpa [next, rawNext, nextReceive, hmessage, updateNode,
                  candidateIsDest] using activeAfter)
              (by
                simpa [next, rawNext, nextReceive, hmessage] using
                  countedAfter)
              notSelf
              (by
                simp [next, rawNext, nextReceive, hmessage, updateNode,
                  candidateIsDest])
      | handleRequestVoteRequest =>
          cases hbody : message.body with
          | requestVoteRequest lastTerm lastIndex isPreVote =>
              apply countedVoteGrantHistory_of_preserved history enabled
              · intro candidate active
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  active
              · intro candidate voter counted
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  counted
              · intro candidate
                simp [next, rawNext, nextReceive, hmessage, hbody]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | handleRequestVoteResponse =>
          cases hbody : message.body with
          | requestVoteResponse voteGranted isPreVote =>
              cases voteGranted with
              | false =>
                  apply countedVoteGrantHistory_of_preserved history enabled
                  · intro candidate active
                    simpa [next, rawNext, nextReceive, hmessage, hbody] using
                      active
                  · intro candidate voter counted
                    simpa [next, rawNext, nextReceive, hmessage, hbody] using
                      counted
                  · intro candidate
                    simp [next, rawNext, nextReceive, hmessage, hbody]
              | true =>
                  have enabledFacts := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabledFacts
                  have messageDest : message.dest = dest :=
                    enabledFacts.2.1.1
                  have responseTerm :
                      message.term = state.currentTerm dest := by
                    simpa [messageDest] using enabledFacts.2.2.1.1
                  have candidateRole :
                      state.leadershipState dest = .candidate := by
                    simpa [messageDest] using enabledFacts.2.2.2
                  have preVoteFalse : isPreVote = false := by
                    simpa using enabledFacts.2.2.1.2
                  subst isPreVote
                  intro candidate voter activeAfter countedAfter notSelf
                  by_cases candidateIsDest : candidate = dest
                  · subst candidate
                    have countedCases :
                        Or
                          (voter = source)
                          (voter ∈ state.votesGranted dest) := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        updateNode] using countedAfter
                    rcases countedCases with voterIsSource | countedBefore
                    · subst voter
                      have queued :
                          message ∈ state.messages dest source :=
                        headMessage?_mem
                          state dest source message hmessage
                      have responseWitness :
                          MessageHasRVResponseWitness
                            start actions state dest source message := by
                        simpa [hbody] using
                          requestVotes dest source message queued
                      rcases responseWitness with ⟨origin⟩
                      exact ⟨{
                        countState := state
                        response := message
                        responseOrigin :=
                          rvResponseWitness_extend origin enabled
                        count_occurrence :=
                          protocolHistory_append_occurs protocol enabled
                        response_head := hmessage
                        response_body := hbody
                        candidate_term_eq := by
                          simpa [next, rawNext, nextReceive, hmessage,
                            hbody] using responseTerm.symm
                      }⟩
                    · exact countedVoteGrantHistory_retain
                        history
                        enabled
                        (Or.inl candidateRole)
                        countedBefore
                        notSelf
                        (by
                          simp [next, rawNext, nextReceive, hmessage,
                            hbody])
                  · exact countedVoteGrantHistory_retain
                      history
                      enabled
                      (by
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          candidateIsDest] using activeAfter)
                      (by
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          updateNode, candidateIsDest] using countedAfter)
                      notSelf
                      (by
                        simp [next, rawNext, nextReceive, hmessage, hbody])
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | dropRequestVoteResponseOutOfState =>
          apply countedVoteGrantHistory_of_preserved history enabled
          · intro candidate active
            simpa [next, rawNext, nextReceive, hmessage] using active
          · intro candidate voter counted
            simpa [next, rawNext, nextReceive, hmessage] using counted
          · intro candidate
            simp [next, rawNext, nextReceive, hmessage]
      | dropRequestVoteResponseStale =>
          apply countedVoteGrantHistory_of_preserved history enabled
          · intro candidate active
            simpa [next, rawNext, nextReceive, hmessage] using active
          · intro candidate voter counted
            simpa [next, rawNext, nextReceive, hmessage] using counted
          · intro candidate
            simp [next, rawNext, nextReceive, hmessage]
      | returnToFollower =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              intro candidate voter activeAfter countedAfter notSelf
              by_cases candidateIsDest : candidate = dest
              · subst candidate
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  updateNode] at activeAfter
              · exact countedVoteGrantHistory_retain
                  history
                  enabled
                  (by
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      updateNode, candidateIsDest] using activeAfter)
                  (by
                    simpa [next, rawNext, nextReceive, hmessage, hbody] using
                      countedAfter)
                  notSelf
                  (by
                    simp [next, rawNext, nextReceive, hmessage, hbody])
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | appendEntriesNoConflict =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              apply countedVoteGrantHistory_of_preserved history enabled
              · intro candidate active
                by_cases candidateIsDest : candidate = message.dest
                · subst candidate
                  cases roleEq :
                      state.leadershipState message.dest <;>
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, updateNode,
                      roleEq] at active ⊢
                  all_goals
                    split at active <;> simp_all
                · simpa [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesNoConflict, updateNode,
                    candidateIsDest] using active
              · intro candidate voter counted
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesNoConflict] using counted
              · intro candidate
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesNoConflict]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | appendEntriesConflictThenNoConflict =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              apply countedVoteGrantHistory_of_preserved history enabled
              · intro candidate active
                by_cases candidateIsDest : candidate = message.dest
                · subst candidate
                  cases roleEq :
                      state.leadershipState message.dest <;>
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      updateNode, roleEq] at active ⊢
                  all_goals
                    split at active <;> simp_all
                · simpa [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesNoConflict, conflictRollback,
                    updateNode, candidateIsDest] using active
              · intro candidate voter counted
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesNoConflict, conflictRollback] using
                    counted
              · intro candidate
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesNoConflict, conflictRollback]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | rejectAppendEntriesRequest =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              cases responseCase :
                  appendEntriesRejectResponse?
                    state message previousIndex previousTerm with
              | none =>
                  apply countedVoteGrantHistory_of_preserved history enabled
                  · intro candidate active
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase] using active
                  · intro candidate voter counted
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase] using counted
                  · intro candidate
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase]
              | some response =>
                  apply countedVoteGrantHistory_of_preserved history enabled
                  · intro candidate active
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase] using active
                  · intro candidate voter counted
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase] using counted
                  · intro candidate
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | appendEntriesAlreadyDone =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              apply countedVoteGrantHistory_of_preserved history enabled
              · intro candidate active
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone] using active
              · intro candidate voter counted
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone] using counted
              · intro candidate
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | appendEntriesConflictThenAlreadyDone =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              apply countedVoteGrantHistory_of_preserved history enabled
              · intro candidate active
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone, conflictRollback] using
                    active
              · intro candidate voter counted
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone, conflictRollback] using
                    counted
              · intro candidate
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone, conflictRollback]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | handleAppendEntriesResponseSuccess =>
          cases hbody : message.body with
          | appendEntriesResponse success lastLogIndex =>
              apply countedVoteGrantHistory_of_preserved history enabled
              · intro candidate active
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  active
              · intro candidate voter counted
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  counted
              · intro candidate
                simp [next, rawNext, nextReceive, hmessage, hbody]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | handleAppendEntriesResponseFailure =>
          cases hbody : message.body with
          | appendEntriesResponse success lastLogIndex =>
              apply countedVoteGrantHistory_of_preserved history enabled
              · intro candidate active
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  active
              · intro candidate voter counted
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  counted
              · intro candidate
                simp [next, rawNext, nextReceive, hmessage, hbody]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | dropAppendEntriesResponseOutOfState =>
          apply countedVoteGrantHistory_of_preserved history enabled
          · intro candidate active
            simpa [next, rawNext, nextReceive, hmessage] using active
          · intro candidate voter counted
            simpa [next, rawNext, nextReceive, hmessage] using counted
          · intro candidate
            simp [next, rawNext, nextReceive, hmessage]
      | dropAppendEntriesResponseStale =>
          apply countedVoteGrantHistory_of_preserved history enabled
          · intro candidate active
            simpa [next, rawNext, nextReceive, hmessage] using active
          · intro candidate voter counted
            simpa [next, rawNext, nextReceive, hmessage] using counted
          · intro candidate
            simp [next, rawNext, nextReceive, hmessage]

theorem countedVoteGrantHistory_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (protocol : ProtocolHistory start actions state)
    (history :
      CountedVoteGrantHistoryConsistent start actions state)
    (requestVotes :
      RequestVoteMessageHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    CountedVoteGrantHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  cases action with
  | timeout timedOut =>
      intro candidate voter activeAfter countedAfter notSelf
      by_cases candidateIsTimedOut : candidate = timedOut
      · subst candidate
        have voterIsTimedOut : voter = timedOut := by
          simpa [next, rawNext, nextTimeout, updateNode] using countedAfter
        exact False.elim (notSelf voterIsTimedOut)
      · exact countedVoteGrantHistory_retain
          history
          enabled
          (by
            simpa [next, rawNext, nextTimeout, updateNode,
              candidateIsTimedOut] using activeAfter)
          (by
            simpa [next, rawNext, nextTimeout, updateNode,
              candidateIsTimedOut] using countedAfter)
          notSelf
          (by
            simp [next, rawNext, nextTimeout, updateNode,
              candidateIsTimedOut])
  | requestVote source dest =>
      apply countedVoteGrantHistory_of_preserved history enabled
      · intro candidate active
        simpa [next, rawNext, nextRequestVote] using active
      · intro candidate voter counted
        simpa [next, rawNext, nextRequestVote] using counted
      · intro candidate
        simp [next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      apply countedVoteGrantHistory_of_preserved history enabled
      · intro candidate active
        simpa [next, rawNext, nextAppendEntries] using active
      · intro candidate voter counted
        simpa [next, rawNext, nextAppendEntries] using counted
      · intro candidate
        simp [next, rawNext, nextAppendEntries]
  | becomeLeader elected =>
      intro candidate voter activeAfter countedAfter notSelf
      have becomeEnabled := enabled
      simp [Enabled, actionEnabled] at becomeEnabled
      by_cases candidateIsElected : candidate = elected
      · subst candidate
        exact countedVoteGrantHistory_retain
          history
          enabled
          (Or.inl becomeEnabled.1.2)
          (by
            simpa [next, rawNext, nextBecomeLeader, updateNode] using
              countedAfter)
          notSelf
          (by simp [next, rawNext, nextBecomeLeader, updateNode])
      · exact countedVoteGrantHistory_retain
          history
          enabled
          (by
            simpa [next, rawNext, nextBecomeLeader, updateNode,
              candidateIsElected] using activeAfter)
          (by
            simpa [next, rawNext, nextBecomeLeader, updateNode,
              candidateIsElected] using countedAfter)
          notSelf
          (by simp [next, rawNext, nextBecomeLeader, updateNode])
  | clientRequest leader =>
      apply countedVoteGrantHistory_of_preserved history enabled
      · intro candidate active
        simpa [next, rawNext, nextClientRequest] using active
      · intro candidate voter counted
        simpa [next, rawNext, nextClientRequest] using counted
      · intro candidate
        simp [next, rawNext, nextClientRequest]
  | signCommittableMessages leader =>
      apply countedVoteGrantHistory_of_preserved history enabled
      · intro candidate active
        simpa [next, rawNext, nextSignCommittableMessages] using active
      · intro candidate voter counted
        simpa [next, rawNext, nextSignCommittableMessages] using counted
      · intro candidate
        simp [next, rawNext, nextSignCommittableMessages]
  | changeConfiguration leader configuration =>
      apply countedVoteGrantHistory_of_preserved history enabled
      · intro candidate active
        simpa [next, rawNext, nextChangeConfiguration] using active
      · intro candidate voter counted
        simpa [next, rawNext, nextChangeConfiguration] using counted
      · intro candidate
        simp [next, rawNext, nextChangeConfiguration]
  | advanceCommitIndex leader =>
      intro candidate voter activeAfter countedAfter notSelf
      have advanceEnabled := enabled
      simp [Enabled, actionEnabled] at advanceEnabled
      by_cases candidateIsLeader : candidate = leader
      · subst candidate
        exact countedVoteGrantHistory_retain
          history
          enabled
          (Or.inr advanceEnabled.1.2)
          (by
            simpa [next, rawNext, nextAdvanceCommitIndex] using
              countedAfter)
          notSelf
          (by simp [next, rawNext, nextAdvanceCommitIndex])
      · exact countedVoteGrantHistory_retain
          history
          enabled
          (by
            simpa [next, rawNext, nextAdvanceCommitIndex,
              candidateIsLeader] using activeAfter)
          (by
            simpa [next, rawNext, nextAdvanceCommitIndex] using
              countedAfter)
          notSelf
          (by simp [next, rawNext, nextAdvanceCommitIndex])
  | receive dest source kind =>
      exact countedVoteGrantHistory_receive_step
        protocol history requestVotes dest source kind enabled

theorem reachable_hasCountedVoteGrantHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (CountedVoteGrantHistoryConsistent
          start actions state) := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := fun current =>
        Exists fun actions =>
          And
            (ProtocolHistory start actions current)
            (CountedVoteGrantHistoryConsistent
              start actions current))
  · exact
      ⟨[],
        rfl,
        initial_CountedVoteGrantHistoryConsistent start⟩
  · intro current action historical enabled
    change Action at action
    rcases historical with ⟨actions, protocol, voteGrants⟩
    have requestVotes :=
      queueHistory_implies_RequestVoteMessageHistoryConsistent
        (protocolHistory_implies_QueueHistoryConsistent protocol)
    exact
      ⟨actions ++ [action],
        replays_append_singleton protocol enabled,
        countedVoteGrantHistory_append_step
          protocol voteGrants requestVotes action enabled⟩
  · exact reachable

theorem countedVoteGrantHistory_implies_CountedVoteLogHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (_protocol : ProtocolHistory start actions state)
    (voteGrants :
      CountedVoteGrantHistoryConsistent start actions state) :
    CountedVoteLogHistoryConsistent start actions state := by
  intro candidate voter active counted notSelf
  rcases voteGrants candidate voter active counted notSelf with
    ⟨countedWitness⟩
  rcases
      occurs_before_stateAt
        countedWitness.responseOrigin.occurrence with
    ⟨responseTrace⟩
  have requestQueued :
      countedWitness.responseOrigin.request ∈
        countedWitness.responseOrigin.responseState.messages
          voter candidate :=
    headMessage?_mem
      countedWitness.responseOrigin.responseState
      voter
      candidate
      countedWitness.responseOrigin.request
      countedWitness.responseOrigin.request_head
  have requestVotes :=
    queueHistory_implies_RequestVoteMessageHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent
        responseTrace.stateHistory)
  have hasPrefixSend :
      MessageHasRVSendWitness
        start
        responseTrace.pastActions
        countedWitness.responseOrigin.responseState
        voter
        candidate
        countedWitness.responseOrigin.request := by
    simpa [countedWitness.responseOrigin.request_body] using
      requestVotes
        voter
        candidate
        countedWitness.responseOrigin.request
        requestQueued
  rcases hasPrefixSend with ⟨prefixSend⟩
  have responseBody := countedWitness.response_body
  rw [countedWitness.responseOrigin.response_eq] at responseBody
  have grantTrue :
      requestVoteGranted
          countedWitness.responseOrigin.responseState
          voter
          candidate
          countedWitness.responseOrigin.request.term
          countedWitness.responseOrigin.lastTerm
          countedWitness.responseOrigin.lastIndex =
        true :=
    (MessageBody.requestVoteResponse.inj responseBody).1
  have grantFacts := grantTrue
  simp [requestVoteGranted] at grantFacts
  exact ⟨{
    counted := countedWitness
    send := {
      sendState := prefixSend.sendState
      occurrence :=
        occurs_extend_stateAtWitness
          responseTrace prefixSend.occurrence
      message_eq := prefixSend.message_eq
    }
    log_ok := grantFacts.1.2
  }⟩

private def rvSendWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {dest source : Node}
    {message : Message}
    (witness :
      RVSendWitness
        start actions state dest source message)
    (enabled : Enabled state action) :
    RVSendWitness
      start
      (actions ++ [action])
      (next state action)
      dest
      source
      message :=
  {
    sendState := witness.sendState
    occurrence := occurs_extend witness.occurrence enabled
    message_eq := witness.message_eq
  }

private def votedForLogWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {voter candidate : Node}
    (witness :
      VotedForLogWitness
        start actions state voter candidate)
    (enabled : Enabled state action)
    (voterTermEq :
      (next state action).currentTerm voter =
        state.currentTerm voter) :
    VotedForLogWitness
      start
      (actions ++ [action])
      (next state action)
      voter
      candidate :=
  {
    request := witness.request
    response := witness.response
    responseOrigin :=
      rvResponseWitness_extend witness.responseOrigin enabled
    send := rvSendWitness_extend witness.send enabled
    request_eq := witness.request_eq
    log_ok := witness.log_ok
    voter_term_eq := voterTermEq.trans witness.voter_term_eq
  }

private theorem votedForLogHistory_of_preserved
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history :
      VotedForLogHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (votes :
      forall voter,
        (next state action).votedFor voter =
          state.votedFor voter)
    (terms :
      forall voter,
        (next state action).currentTerm voter =
          state.currentTerm voter) :
    VotedForLogHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  intro voter candidate votedFor notSelf
  have oldVote :
      state.votedFor voter = some candidate := by
    rw [← votes voter]
    exact votedFor
  rcases history voter candidate oldVote notSelf with
    ⟨witness⟩
  exact
    ⟨votedForLogWitness_extend
      witness enabled (terms voter)⟩

theorem initial_VotedForLogHistoryConsistent
    (start : InitialConfiguration) :
    VotedForLogHistoryConsistent
      start [] (initialState start) := by
  intro voter candidate votedFor notSelf
  by_cases voterIsStart : voter = start
  · subst voter
    simp [initialState] at votedFor
  · simp [initialState] at votedFor

theorem votedForLogHistory_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (voteLogs :
      VotedForLogHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    VotedForLogHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  have requestVotes :=
    queueHistory_implies_RequestVoteMessageHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent history)
  cases action with
  | timeout timedOut =>
      intro voter candidate votedFor notSelf
      by_cases voterIsTimedOut : voter = timedOut
      · subst voter
        have timedOutIsCandidate : timedOut = candidate := by
          simpa [next, rawNext, nextTimeout, updateNode] using votedFor
        exact False.elim (notSelf timedOutIsCandidate)
      · have oldVote :
            state.votedFor voter = some candidate := by
          simpa [next, rawNext, nextTimeout, updateNode,
            voterIsTimedOut] using votedFor
        rcases voteLogs voter candidate oldVote notSelf with
          ⟨witness⟩
        exact
          ⟨votedForLogWitness_extend
            witness enabled
            (by
              simp [next, rawNext, nextTimeout, updateNode,
                voterIsTimedOut])⟩
  | requestVote source dest =>
      exact votedForLogHistory_of_preserved
        voteLogs (.requestVote source dest) enabled
        (by intro voter; simp [next, rawNext, nextRequestVote])
        (by intro voter; simp [next, rawNext, nextRequestVote])
  | appendEntries source dest =>
      exact votedForLogHistory_of_preserved
        voteLogs (.appendEntries source dest) enabled
        (by intro voter; simp [next, rawNext, nextAppendEntries])
        (by intro voter; simp [next, rawNext, nextAppendEntries])
  | becomeLeader leader =>
      exact votedForLogHistory_of_preserved
        voteLogs (.becomeLeader leader) enabled
        (by intro voter; simp [next, rawNext, nextBecomeLeader])
        (by intro voter; simp [next, rawNext, nextBecomeLeader])
  | clientRequest leader =>
      exact votedForLogHistory_of_preserved
        voteLogs (.clientRequest leader) enabled
        (by intro voter; simp [next, rawNext, nextClientRequest])
        (by intro voter; simp [next, rawNext, nextClientRequest])
  | signCommittableMessages leader =>
      exact votedForLogHistory_of_preserved
        voteLogs (.signCommittableMessages leader) enabled
        (by
          intro voter
          simp [next, rawNext, nextSignCommittableMessages])
        (by
          intro voter
          simp [next, rawNext, nextSignCommittableMessages])
  | changeConfiguration leader configuration =>
      exact votedForLogHistory_of_preserved
        voteLogs (.changeConfiguration leader configuration) enabled
        (by
          intro voter
          simp [next, rawNext, nextChangeConfiguration])
        (by
          intro voter
          simp [next, rawNext, nextChangeConfiguration])
  | advanceCommitIndex leader =>
      exact votedForLogHistory_of_preserved
        voteLogs (.advanceCommitIndex leader) enabled
        (by
          intro voter
          simp [next, rawNext, nextAdvanceCommitIndex])
        (by
          intro voter
          simp [next, rawNext, nextAdvanceCommitIndex])
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [Enabled, actionEnabled, hmessage] at enabled
      | some message =>
          cases kind with
          | dropIgnored =>
              exact votedForLogHistory_of_preserved
                voteLogs (.receive dest source .dropIgnored) enabled
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
          | updateTerm =>
              intro voter candidate votedFor notSelf
              by_cases voterIsDest : voter = dest
              · subst voter
                simp [next, rawNext, nextReceive, hmessage,
                  updateNode] at votedFor
              · have oldVote :
                    state.votedFor voter = some candidate := by
                  simpa [next, rawNext, nextReceive, hmessage,
                    updateNode, voterIsDest] using votedFor
                rcases voteLogs voter candidate oldVote notSelf with
                  ⟨witness⟩
                exact
                  ⟨votedForLogWitness_extend
                    witness enabled
                    (by
                      simp [next, rawNext, nextReceive, hmessage,
                        updateNode, voterIsDest])⟩
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  let grant :=
                    requestVoteGranted
                      state dest source message.term lastTerm lastIndex
                  intro voter candidate votedFor notSelf
                  by_cases voterIsDest : voter = dest
                  · subst voter
                    by_cases granted : grant = true
                    · have sourceIsCandidate : source = candidate := by
                        simpa [next, rawNext, nextReceive, hmessage,
                          hbody, grant, granted, updateNode] using votedFor
                      subst candidate
                      have queued :
                          message ∈ state.messages dest source :=
                        headMessage?_mem
                          state dest source message hmessage
                      have hasSend :
                          MessageHasRVSendWitness
                            start actions state dest source message := by
                        simpa [hbody] using
                          requestVotes dest source message queued
                      rcases hasSend with ⟨send⟩
                      have requestIsNotPreVote :
                          isPreVote = false := by
                        have sentBody :=
                          congrArg Message.body send.message_eq
                        have sentFacts := sentBody.symm
                        simp [requestVoteMessage, hbody] at sentFacts
                        exact sentFacts.2.2
                      subst isPreVote
                      have grantFacts := granted
                      simp [grant, requestVoteGranted] at grantFacts
                      let response : Message :=
                        {
                          term := state.currentTerm dest
                          source := dest
                          dest := source
                          body := .requestVoteResponse true false
                        }
                      let responseOrigin :
                          RVResponseWitness
                            start
                            (actions ++
                              [(.receive dest source
                                .handleRequestVoteRequest : Action)])
                            (next state
                              (.receive dest source
                                .handleRequestVoteRequest))
                            source
                            dest
                            response :=
                        {
                          responseState := state
                          request := message
                          lastTerm
                          lastIndex
                          isPreVote := false
                          occurrence :=
                            protocolHistory_append_occurs history enabled
                          request_head := hmessage
                          request_body := hbody
                          response_eq := by
                            simp [response, granted, grant]
                        }
                      exact ⟨{
                        request := message
                        response
                        responseOrigin
                        send := rvSendWitness_extend send enabled
                        request_eq := rfl
                        log_ok := grantFacts.1.2
                        voter_term_eq := by
                          simp [response, next, rawNext, nextReceive,
                            hmessage, hbody]
                      }⟩
                    · have oldVote :
                          state.votedFor dest = some candidate := by
                        simpa [next, rawNext, nextReceive, hmessage,
                          hbody, grant, granted, updateNode] using votedFor
                      rcases voteLogs dest candidate oldVote notSelf with
                        ⟨witness⟩
                      exact
                        ⟨votedForLogWitness_extend
                          witness enabled
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody])⟩
                  · have oldVote :
                        state.votedFor voter = some candidate := by
                      by_cases granted : grant = true <;>
                        simpa [next, rawNext, nextReceive, hmessage,
                          hbody, grant, granted, updateNode,
                          voterIsDest] using votedFor
                    rcases voteLogs voter candidate oldVote notSelf with
                      ⟨witness⟩
                    exact
                      ⟨votedForLogWitness_extend
                        witness enabled
                        (by
                          simp [next, rawNext, nextReceive, hmessage,
                            hbody])⟩
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | handleRequestVoteResponse =>
              cases hbody : message.body <;>
                exact votedForLogHistory_of_preserved
                  voteLogs
                  (.receive dest source .handleRequestVoteResponse)
                  enabled
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody])
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody])
          | dropRequestVoteResponseOutOfState =>
              exact votedForLogHistory_of_preserved
                voteLogs
                (.receive dest source
                  .dropRequestVoteResponseOutOfState)
                enabled
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
          | dropRequestVoteResponseStale =>
              exact votedForLogHistory_of_preserved
                voteLogs
                (.receive dest source .dropRequestVoteResponseStale)
                enabled
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm <;>
                    exact votedForLogHistory_of_preserved
                      voteLogs
                      (.receive dest source
                        .rejectAppendEntriesRequest)
                      enabled
                      (by
                        intro voter
                        simp [next, rawNext, nextReceive, hmessage,
                          hbody, responseCase])
                      (by
                        intro voter
                        simp [next, rawNext, nextReceive, hmessage,
                          hbody, responseCase])
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | returnToFollower =>
              cases hbody : message.body <;>
                exact votedForLogHistory_of_preserved
                  voteLogs
                  (.receive dest source .returnToFollower)
                  enabled
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody])
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody])
          | appendEntriesAlreadyDone =>
              cases hbody : message.body <;>
                exact votedForLogHistory_of_preserved
                  voteLogs
                  (.receive dest source .appendEntriesAlreadyDone)
                  enabled
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone])
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone])
          | appendEntriesNoConflict =>
              cases hbody : message.body <;>
                exact votedForLogHistory_of_preserved
                  voteLogs
                  (.receive dest source .appendEntriesNoConflict)
                  enabled
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict])
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict])
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body <;>
                exact votedForLogHistory_of_preserved
                  voteLogs
                  (.receive dest source
                    .appendEntriesConflictThenAlreadyDone)
                  enabled
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback])
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback])
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body <;>
                exact votedForLogHistory_of_preserved
                  voteLogs
                  (.receive dest source
                    .appendEntriesConflictThenNoConflict)
                  enabled
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback])
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback])
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body <;>
                exact votedForLogHistory_of_preserved
                  voteLogs
                  (.receive dest source
                    .handleAppendEntriesResponseSuccess)
                  enabled
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody])
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody])
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body <;>
                exact votedForLogHistory_of_preserved
                  voteLogs
                  (.receive dest source
                    .handleAppendEntriesResponseFailure)
                  enabled
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody])
                  (by
                    intro voter
                    simp [next, rawNext, nextReceive, hmessage, hbody])
          | dropAppendEntriesResponseOutOfState =>
              exact votedForLogHistory_of_preserved
                voteLogs
                (.receive dest source
                  .dropAppendEntriesResponseOutOfState)
                enabled
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
          | dropAppendEntriesResponseStale =>
              exact votedForLogHistory_of_preserved
                voteLogs
                (.receive dest source .dropAppendEntriesResponseStale)
                enabled
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])
                (by
                  intro voter
                  simp [next, rawNext, nextReceive, hmessage])

theorem protocolHistory_implies_VotedForLogHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    VotedForLogHistoryConsistent start actions state :=
  protocolHistory_induction
    (start := start)
    (property := fun actions state =>
      VotedForLogHistoryConsistent start actions state)
    (initial_VotedForLogHistoryConsistent start)
    (by
      intro past current pastHistory voteLogs action enabled
      exact votedForLogHistory_append_step
        pastHistory voteLogs action enabled)
    history

theorem reachable_hasVotedForLogHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (VotedForLogHistoryConsistent
          start actions state) := by
  rcases reachable_hasProtocolHistory reachable with
    ⟨actions, history⟩
  exact
    ⟨actions,
      history,
      protocolHistory_implies_VotedForLogHistoryConsistent history⟩

theorem reachable_hasCountedVoteLogHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (CountedVoteLogHistoryConsistent
          start actions state) := by
  rcases reachable_hasCountedVoteGrantHistory reachable with
    ⟨actions, protocol, voteGrants⟩
  exact
    ⟨actions,
      protocol,
      countedVoteGrantHistory_implies_CountedVoteLogHistoryConsistent
        protocol voteGrants⟩

theorem reachable_hasLeaderHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (LeaderHistoryConsistent start actions state) := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := fun current =>
        Exists fun actions =>
          And
            (ProtocolHistory start actions current)
            (LeaderHistoryConsistent start actions current))
  · exact ⟨[], rfl, initial_LeaderHistoryConsistent start⟩
  · intro current action invariant enabled
    change Action at action
    rcases invariant with ⟨actions, protocol, leaders⟩
    exact
      ⟨actions ++ [action],
        replays_append_singleton protocol enabled,
        leaderHistory_append_step protocol leaders action enabled⟩
  · exact reachable

private theorem leaderHistory_extend_replay
    {start : InitialConfiguration}
    {prefixActions suffixActions : List Action}
    {prefixState state : State}
    (prefixHistory :
      ProtocolHistory start prefixActions prefixState)
    (prefixLeaders :
      LeaderHistoryConsistent start prefixActions prefixState)
    (replay :
      Replays prefixState suffixActions state) :
    LeaderHistoryConsistent
      start
      (prefixActions ++ suffixActions)
      state := by
  induction suffixActions generalizing prefixActions prefixState with
  | nil =>
      simp [Replays] at replay
      subst state
      simpa using prefixLeaders
  | cons action tail inductionHypothesis =>
      rcases replay with ⟨enabled, tailReplay⟩
      have nextHistory :=
        replays_append_singleton prefixHistory enabled
      have nextLeaders :=
        leaderHistory_append_step
          prefixHistory prefixLeaders action enabled
      have extended :=
        inductionHypothesis
          nextHistory nextLeaders tailReplay
      simpa only [List.append_assoc, List.singleton_append] using extended

theorem protocolHistory_implies_LeaderHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    LeaderHistoryConsistent start actions state := by
  simpa using
    leaderHistory_extend_replay
      (start := start)
      (prefixActions := [])
      (suffixActions := actions)
      (prefixState := initialState start)
      (state := state)
      (by rfl)
      (initial_LeaderHistoryConsistent start)
      history

private def recordVote
    (owner : VoteOwner)
    (voter : Node)
    (term : Nat)
    (candidate : Node) :
    VoteOwner :=
  fun queriedVoter queriedTerm =>
    if queriedVoter = voter ∧ queriedTerm = term then
      some candidate
    else
      owner queriedVoter queriedTerm

private def VoteOwnerExtends
    (before after : VoteOwner) :
    Prop :=
  forall voter term candidate,
    before voter term = some candidate ->
      after voter term = some candidate

private structure VoteHistoryUpdate
    (before after : State)
    (owner : VoteOwner) where
  nextOwner : VoteOwner
  consistent :
    VoteHistoryConsistent after nextOwner
  preserves :
    VoteOwnerExtends owner nextOwner

private def VoteHistoryUpdate.same
    {before after : State}
    {owner : VoteOwner}
    (consistent : VoteHistoryConsistent after owner) :
    VoteHistoryUpdate before after owner :=
  {
    nextOwner := owner
    consistent
    preserves := by
      intro voter term candidate recorded
      exact recorded
  }

private theorem voteHistoryConsistent_of_preserved
    (before after : State)
    (owner : VoteOwner)
    (history : VoteHistoryConsistent before owner)
    (terms :
      forall node,
        after.currentTerm node = before.currentTerm node)
    (choices :
      forall node,
        after.votedFor node = before.votedFor node)
    (countedPreserved :
      forall candidate voter,
        Or
            (after.leadershipState candidate = .candidate)
            (after.leadershipState candidate = .leader) ->
          voter ∈ after.votesGranted candidate ->
            And
              (Or
                (before.leadershipState candidate = .candidate)
                (before.leadershipState candidate = .leader))
              (voter ∈ before.votesGranted candidate))
    (responsesPreserved :
      forall dest source message,
        message ∈ after.messages dest source ->
          forall isPreVote,
            message.body = .requestVoteResponse true isPreVote ->
              message ∈ before.messages dest source) :
    VoteHistoryConsistent after owner := {
  currentChoice := by
    intro voter
    simpa [terms voter, choices voter] using history.currentChoice voter
  futureEmpty := by
    intro voter term future
    apply history.futureEmpty
    simpa [terms voter] using future
  countedChoices := by
    intro candidate voter active counted
    have preserved := countedPreserved candidate voter active counted
    simpa [terms candidate] using
      history.countedChoices candidate voter preserved.1 preserved.2
  grantedResponses := by
    intro dest source message queued isPreVote bodyEq
    exact history.grantedResponses
      dest
      source
      message
      (responsesPreserved dest source message queued isPreVote bodyEq)
      isPreVote
      bodyEq
}

private theorem mem_before_of_granted_response_enqueue
    (messages : NodeMatrix (List Message))
    (inserted queued : Message)
    (dest source : Node)
    (queuedAfter :
      queued ∈ (enqueue messages inserted) dest source)
    (isPreVote : Bool)
    (queuedGranted :
      queued.body = .requestVoteResponse true isPreVote)
    (insertedNotGranted :
      forall responseIsPreVote,
        inserted.body =
            .requestVoteResponse true responseIsPreVote ->
          False) :
    queued ∈ messages dest source := by
  by_contra absentBefore
  have insertedEq :=
    firstInsertion_enqueue_eq
      messages
      inserted
      queued
      dest
      source
      absentBefore
      queuedAfter
  apply insertedNotGranted isPreVote
  simpa [insertedEq.2.2] using queuedGranted

private theorem mem_before_of_granted_response_reply
    (messages : NodeMatrix (List Message))
    (response request queued : Message)
    (dest source : Node)
    (queuedAfter :
      queued ∈ (reply messages response request) dest source)
    (isPreVote : Bool)
    (queuedGranted :
      queued.body = .requestVoteResponse true isPreVote)
    (responseNotGranted :
      forall responseIsPreVote,
        response.body =
            .requestVoteResponse true responseIsPreVote ->
          False) :
    queued ∈ messages dest source := by
  by_contra absentBefore
  have insertedEq :=
    firstInsertion_reply_eq
      messages
      response
      request
      queued
      dest
      source
      absentBefore
      queuedAfter
  apply responseNotGranted isPreVote
  simpa [insertedEq.2.2] using queuedGranted

private def timeout_voteHistoryUpdate
    (state : State)
    (candidate : Node)
    (owner : VoteOwner)
    (history : VoteHistoryConsistent state owner) :
    VoteHistoryUpdate
      state
      (next state (.timeout candidate))
      owner := by
  let nextTerm := state.currentTerm candidate + 1
  let nextOwner := recordVote owner candidate nextTerm candidate
  refine {
    nextOwner
    consistent := ?_
    preserves := ?_
  }
  · exact {
    currentChoice := by
      intro voter
      by_cases voterIsCandidate : voter = candidate
      · subst voter
        simp [nextOwner, nextTerm, recordVote, next, rawNext,
          nextTimeout, updateNode]
      · simpa [nextOwner, recordVote, next, rawNext, nextTimeout,
          updateNode, voterIsCandidate] using history.currentChoice voter
    futureEmpty := by
      intro voter term future
      by_cases voterIsCandidate : voter = candidate
      · subst voter
        have afterNext : nextTerm < term := by
          simpa [next, rawNext, nextTimeout, updateNode, nextTerm] using
            future
        have notNext : term ≠ nextTerm := by
          omega
        simpa [nextOwner, recordVote, notNext] using
          history.futureEmpty candidate term (by
            dsimp [nextTerm] at afterNext ⊢
            omega)
      · have oldFuture := history.futureEmpty voter term (by
          simpa [next, rawNext, nextTimeout, updateNode,
            voterIsCandidate] using future)
        simpa [nextOwner, recordVote, voterIsCandidate] using oldFuture
    countedChoices := by
      intro countedCandidate voter active counted
      by_cases isTimedOut : countedCandidate = candidate
      · subst countedCandidate
        have voterIsCandidate : voter = candidate := by
          simpa [next, rawNext, nextTimeout, updateNode] using counted
        subst voter
        simp [nextOwner, nextTerm, recordVote, next, rawNext,
          nextTimeout, updateNode]
      · have activeBefore :
            Or
              (state.leadershipState countedCandidate = .candidate)
              (state.leadershipState countedCandidate = .leader) := by
          simpa [next, rawNext, nextTimeout, updateNode,
            isTimedOut] using active
        have countedBefore :
            voter ∈ state.votesGranted countedCandidate := by
          simpa [next, rawNext, nextTimeout, updateNode,
            isTimedOut] using counted
        have oldChoice :=
          history.countedChoices
            countedCandidate voter activeBefore countedBefore
        by_cases voterIsCandidate : voter = candidate
        · subst voter
          by_cases termIsNext :
              state.currentTerm countedCandidate = nextTerm
          · have futureNone :
                owner candidate (state.currentTerm countedCandidate) =
                  none := by
              apply history.futureEmpty
              dsimp [nextTerm] at termIsNext ⊢
              omega
            rw [futureNone] at oldChoice
            contradiction
          · simpa [nextOwner, recordVote, next, rawNext, nextTimeout,
              updateNode, isTimedOut, termIsNext] using oldChoice
        · simpa [nextOwner, recordVote, next, rawNext, nextTimeout,
            updateNode, isTimedOut, voterIsCandidate] using oldChoice
    grantedResponses := by
      intro dest source message queued isPreVote bodyEq
      have oldChoice :=
        history.grantedResponses
          dest source message
          (by
            simpa [next, rawNext, nextTimeout] using queued)
          isPreVote bodyEq
      by_cases sourceIsCandidate : source = candidate
      · subst source
        by_cases termIsNext : message.term = nextTerm
        · have futureNone : owner candidate message.term = none := by
            apply history.futureEmpty
            dsimp [nextTerm] at termIsNext ⊢
            omega
          rw [futureNone] at oldChoice
          contradiction
        · simpa [nextOwner, recordVote, termIsNext] using oldChoice
      · simpa [nextOwner, recordVote, sourceIsCandidate] using oldChoice
    }
  · intro voter term recordedCandidate recorded
    by_cases recordedCell :
        voter = candidate ∧ term = nextTerm
    · rcases recordedCell with ⟨voterEq, termEq⟩
      subst voter
      subst term
      have previouslyEmpty :
          owner candidate nextTerm = none := by
        apply history.futureEmpty
        simp [nextTerm]
      rw [previouslyEmpty] at recorded
      contradiction
    · simpa [nextOwner, recordVote, recordedCell] using recorded

private def grantedRequestVote_voteHistoryUpdate
    (state : State)
    (dest source : Node)
    (message : Message)
    (lastTerm lastIndex : Nat)
    (isPreVote : Bool)
    (owner : VoteOwner)
    (history : VoteHistoryConsistent state owner)
    (head :
      headMessage? state dest source = some message)
    (body :
      message.body =
        .requestVoteRequest lastTerm lastIndex isPreVote)
    (granted :
      requestVoteGranted
          state dest source message.term lastTerm lastIndex =
        true) :
    VoteHistoryUpdate
      state
      (next state (.receive dest source .handleRequestVoteRequest))
      owner := by
  let voteTerm := state.currentTerm dest
  let nextOwner := recordVote owner dest voteTerm source
  let response : Message :=
    {
      term := state.currentTerm dest
      source := dest
      dest := source
      body := .requestVoteResponse true isPreVote
    }
  have grantFacts := granted
  simp [requestVoteGranted] at grantFacts
  have priorChoice :
      Or
        (state.votedFor dest = none)
        (state.votedFor dest = some source) :=
    grantFacts.2
  refine {
    nextOwner
    consistent := ?_
    preserves := ?_
  }
  · exact {
    currentChoice := by
      intro voter
      by_cases voterIsDest : voter = dest
      · subst voter
        simp [nextOwner, voteTerm, recordVote, next, rawNext,
          nextReceive, head, body, granted, updateNode]
      · simpa [nextOwner, recordVote, next, rawNext, nextReceive,
          head, body, granted, updateNode, voterIsDest] using
            history.currentChoice voter
    futureEmpty := by
      intro voter term future
      by_cases voterIsDest : voter = dest
      · subst voter
        have futureOld : state.currentTerm dest < term := by
          simpa [next, rawNext, nextReceive, head, body, granted] using
            future
        have oldFuture :=
          history.futureEmpty dest term futureOld
        have notCurrent : term ≠ voteTerm := by
          dsimp [voteTerm]
          exact Nat.ne_of_gt futureOld
        simpa [nextOwner, recordVote, notCurrent] using oldFuture
      · have oldFuture :=
          history.futureEmpty voter term (by
            simpa [next, rawNext, nextReceive, head, body, granted] using
              future)
        simpa [nextOwner, recordVote, voterIsDest] using oldFuture
    countedChoices := by
      intro candidate voter active counted
      have oldChoice :=
        history.countedChoices
          candidate
          voter
          (by
            simpa [next, rawNext, nextReceive, head, body, granted] using
              active)
          (by
            simpa [next, rawNext, nextReceive, head, body, granted] using
              counted)
      by_cases voterIsDest : voter = dest
      · subst voter
        by_cases termIsVoteTerm :
            state.currentTerm candidate = voteTerm
        · have votedForCandidate :
              state.votedFor dest = some candidate := by
            calc
              state.votedFor dest =
                  owner dest (state.currentTerm dest) :=
                (history.currentChoice dest).symm
              _ = owner dest (state.currentTerm candidate) := by
                rw [termIsVoteTerm]
              _ = some candidate := oldChoice
          have candidateIsSource : candidate = source := by
            rcases priorChoice with noVote | sameVote
            · rw [noVote] at votedForCandidate
              cases votedForCandidate
            · exact Option.some.inj (votedForCandidate.symm.trans sameVote)
          subst candidate
          simp [nextOwner, voteTerm, recordVote, next, rawNext,
            nextReceive, head, body, granted, termIsVoteTerm]
        · simpa [nextOwner, recordVote, next, rawNext, nextReceive,
            head, body, granted, termIsVoteTerm] using oldChoice
      · simpa [nextOwner, recordVote, next, rawNext, nextReceive,
          head, body, granted, voterIsDest] using oldChoice
    grantedResponses := by
      intro queuedDest queuedSource queued queuedMem responseIsPreVote
        responseBody
      by_cases queuedBefore :
          queued ∈ state.messages queuedDest queuedSource
      · have oldChoice :=
          history.grantedResponses
            queuedDest
            queuedSource
            queued
            queuedBefore
            responseIsPreVote
            responseBody
        by_cases sourceIsDest : queuedSource = dest
        · subst queuedSource
          by_cases termIsVoteTerm : queued.term = voteTerm
          · have votedForQueuedDest :
                state.votedFor dest = some queuedDest := by
              calc
                state.votedFor dest =
                    owner dest (state.currentTerm dest) :=
                  (history.currentChoice dest).symm
                _ = owner dest queued.term := by
                  rw [termIsVoteTerm]
                _ = some queuedDest := oldChoice
            have queuedDestIsSource : queuedDest = source := by
              rcases priorChoice with noVote | sameVote
              · rw [noVote] at votedForQueuedDest
                cases votedForQueuedDest
              · exact
                  Option.some.inj
                    (votedForQueuedDest.symm.trans sameVote)
            subst queuedDest
            simp [nextOwner, voteTerm, recordVote, termIsVoteTerm]
          · simpa [nextOwner, recordVote, termIsVoteTerm] using oldChoice
        · simpa [nextOwner, recordVote, sourceIsDest] using oldChoice
      · have queuedAfter :
            queued ∈
              (reply state.messages response message)
                queuedDest queuedSource := by
          simpa [next, rawNext, nextReceive, head, body, granted,
            response] using queuedMem
        rcases firstInsertion_reply_eq
            state.messages
            response
            message
            queued
            queuedDest
            queuedSource
            queuedBefore
            queuedAfter with
          ⟨destMatches, sourceMatches, queuedEq⟩
        have queuedDestIsSource : queuedDest = source := by
          simpa [response] using destMatches
        have queuedSourceIsDest : queuedSource = dest := by
          simpa [response] using sourceMatches
        subst queued
        simp [nextOwner, voteTerm, recordVote, response,
          queuedDestIsSource, queuedSourceIsDest]
    }
  · intro voter term recordedCandidate recorded
    by_cases recordedCell :
        voter = dest ∧ term = voteTerm
    · rcases recordedCell with ⟨voterEq, termEq⟩
      subst voter
      subst term
      have oldChoice :
          owner dest voteTerm = state.votedFor dest := by
        simpa [voteTerm] using history.currentChoice dest
      have recordedVote :
          state.votedFor dest = some recordedCandidate :=
        oldChoice.symm.trans recorded
      have recordedCandidateIsSource :
          recordedCandidate = source := by
        rcases priorChoice with noVote | sameVote
        · rw [noVote] at recordedVote
          contradiction
        · exact Option.some.inj (recordedVote.symm.trans sameVote)
      subst recordedCandidate
      simp [nextOwner, recordVote]
    · simpa [nextOwner, recordVote, recordedCell] using recorded

private def handleRequestVoteResponse_voteHistoryUpdate
    (state : State)
    (dest source : Node)
    (message : Message)
    (voteGranted isPreVote : Bool)
    (owner : VoteOwner)
    (history : VoteHistoryConsistent state owner)
    (head :
      headMessage? state dest source = some message)
    (body :
      message.body =
        .requestVoteResponse voteGranted isPreVote)
    (enabled :
      Enabled state
        (.receive dest source .handleRequestVoteResponse)) :
    VoteHistoryUpdate
      state
      (next state (.receive dest source .handleRequestVoteResponse))
      owner := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled, head, receiveBranchEnabled,
    body] at enabledFacts
  have messageDest : message.dest = dest :=
    enabledFacts.2.1.1
  have responseTerm : message.term = state.currentTerm dest := by
    simpa [messageDest] using enabledFacts.2.2.1.1
  have candidateRole :
      state.leadershipState dest = .candidate := by
    simpa [messageDest] using enabledFacts.2.2.2
  apply VoteHistoryUpdate.same
  cases voteGranted with
  | false =>
      apply voteHistoryConsistent_of_preserved state _ owner history
      · intro node
        simp [next, rawNext, nextReceive, head, body]
      · intro node
        simp [next, rawNext, nextReceive, head, body]
      · intro candidate voter active counted
        exact
          ⟨by
            simpa [next, rawNext, nextReceive, head, body] using active,
            by
              simpa [next, rawNext, nextReceive, head, body] using
                counted⟩
      · intro queuedDest queuedSource queued queuedMem responseIsPreVote
          responseBody
        exact mem_before_of_mem_discard
          state.messages
          message
          queued
          queuedDest
          queuedSource
          (by
            simpa [next, rawNext, nextReceive, head, body] using queuedMem)
  | true =>
      exact {
        currentChoice := by
          intro voter
          simpa [next, rawNext, nextReceive, head, body] using
            history.currentChoice voter
        futureEmpty := by
          intro voter term future
          apply history.futureEmpty
          simpa [next, rawNext, nextReceive, head, body] using future
        countedChoices := by
          intro candidate voter active counted
          by_cases candidateIsDest : candidate = dest
          · subst candidate
            have countedCases :
                Or
                  (voter = source)
                  (voter ∈ state.votesGranted dest) := by
              simpa [next, rawNext, nextReceive, head, body,
                updateNode] using counted
            rcases countedCases with voterIsSource | countedBefore
            · subst voter
              have queuedRequest :
                  message ∈ state.messages dest source :=
                headMessage?_mem state dest source message head
              have responseChoice :=
                history.grantedResponses
                  dest
                  source
                  message
                  queuedRequest
                  isPreVote
                  body
              simpa [next, rawNext, nextReceive, head, body,
                responseTerm] using responseChoice
            · simpa [next, rawNext, nextReceive, head, body] using
                history.countedChoices
                  dest
                  voter
                  (Or.inl candidateRole)
                  countedBefore
          · have activeBefore :
                Or
                  (state.leadershipState candidate = .candidate)
                  (state.leadershipState candidate = .leader) := by
              simpa [next, rawNext, nextReceive, head, body] using active
            have countedBefore :
                voter ∈ state.votesGranted candidate := by
              simpa [next, rawNext, nextReceive, head, body,
                updateNode, candidateIsDest] using counted
            simpa [next, rawNext, nextReceive, head, body] using
              history.countedChoices
                candidate voter activeBefore countedBefore
        grantedResponses := by
          intro queuedDest queuedSource queued queuedMem responseIsPreVote
            responseBody
          exact history.grantedResponses
            queuedDest
            queuedSource
            queued
            (mem_before_of_mem_discard
              state.messages
              message
              queued
              queuedDest
              queuedSource
              (by
                simpa [next, rawNext, nextReceive, head, body] using
                  queuedMem))
            responseIsPreVote
            responseBody
      }

private def updateTerm_voteHistoryUpdate
    (state : State)
    (dest source : Node)
    (message : Message)
    (owner : VoteOwner)
    (history : VoteHistoryConsistent state owner)
    (head :
      headMessage? state dest source = some message)
    (enabled :
      Enabled state (.receive dest source .updateTerm)) :
    VoteHistoryUpdate
      state
      (next state (.receive dest source .updateTerm))
      owner := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled, head, receiveBranchEnabled,
    updateTermEnabled] at enabledFacts
  have messageDest : message.dest = dest :=
    enabledFacts.2.1.1
  have termIncreases :
      state.currentTerm dest < message.term := by
    simpa [messageDest] using enabledFacts.2.2
  apply VoteHistoryUpdate.same
  exact {
    currentChoice := by
      intro voter
      by_cases voterIsDest : voter = dest
      · subst voter
        have futureChoice :=
          history.futureEmpty dest message.term termIncreases
        simpa [next, rawNext, nextReceive, head, updateNode] using
          futureChoice
      · simpa [next, rawNext, nextReceive, head, updateNode,
          voterIsDest] using history.currentChoice voter
    futureEmpty := by
      intro voter term future
      by_cases voterIsDest : voter = dest
      · subst voter
        apply history.futureEmpty
        have afterMessage : message.term < term := by
          simpa [next, rawNext, nextReceive, head, updateNode] using future
        exact Nat.lt_trans termIncreases afterMessage
      · apply history.futureEmpty
        simpa [next, rawNext, nextReceive, head, updateNode,
          voterIsDest] using future
    countedChoices := by
      intro candidate voter active counted
      by_cases candidateIsDest : candidate = dest
      · subst candidate
        cases roleEq : state.leadershipState dest <;>
          simp [next, rawNext, nextReceive, head, updateNode,
            roleEq] at active
      · have activeBefore :
            Or
              (state.leadershipState candidate = .candidate)
              (state.leadershipState candidate = .leader) := by
          simpa [next, rawNext, nextReceive, head, updateNode,
            candidateIsDest] using active
        have countedBefore :
            voter ∈ state.votesGranted candidate := by
          simpa [next, rawNext, nextReceive, head] using counted
        have oldChoice :=
          history.countedChoices
            candidate voter activeBefore countedBefore
        simpa [next, rawNext, nextReceive, head, updateNode,
          candidateIsDest] using oldChoice
    grantedResponses := by
      intro queuedDest queuedSource queued queuedMem isPreVote bodyEq
      exact history.grantedResponses
        queuedDest
        queuedSource
        queued
        (by simpa [next, rawNext, nextReceive, head] using queuedMem)
        isPreVote
        bodyEq
  }

private def discard_voteHistoryUpdate
    (state : State)
    (message : Message)
    (owner : VoteOwner)
    (history : VoteHistoryConsistent state owner) :
    VoteHistoryUpdate
      state
      { state with
        messages := Model.discard state.messages message }
      owner := by
  apply VoteHistoryUpdate.same
  apply voteHistoryConsistent_of_preserved state _ owner history
  · intro node
    rfl
  · intro node
    rfl
  · intro candidate voter active counted
    exact ⟨active, counted⟩
  · intro dest source queued queuedMem isPreVote bodyEq
    exact mem_before_of_mem_discard
      state.messages
      message
      queued
      dest
      source
      queuedMem

private def nonGrantedReply_voteHistoryUpdate
    (state : State)
    (response request : Message)
    (owner : VoteOwner)
    (history : VoteHistoryConsistent state owner)
    (responseNotGranted :
      forall isPreVote,
        response.body = .requestVoteResponse true isPreVote ->
          False) :
    VoteHistoryUpdate
      state
      { state with
        messages := reply state.messages response request }
      owner := by
  apply VoteHistoryUpdate.same
  apply voteHistoryConsistent_of_preserved state _ owner history
  · intro node
    rfl
  · intro node
    rfl
  · intro candidate voter active counted
    exact ⟨active, counted⟩
  · intro dest source queued queuedMem isPreVote bodyEq
    exact mem_before_of_granted_response_reply
      state.messages
      response
      request
      queued
      dest
      source
      queuedMem
      isPreVote
      bodyEq
      responseNotGranted

private def voteHistoryUpdate_step
    (state : State)
    (action : Action)
    (owner : VoteOwner)
    (history : VoteHistoryConsistent state owner)
    (enabled : Enabled state action) :
    VoteHistoryUpdate state (next state action) owner := by
  cases action with
  | timeout candidate =>
      exact timeout_voteHistoryUpdate
        state candidate owner history
  | requestVote source dest =>
      apply VoteHistoryUpdate.same
      apply voteHistoryConsistent_of_preserved state _ owner history
      · intro node
        rfl
      · intro node
        rfl
      · intro candidate voter active counted
        exact ⟨active, counted⟩
      · intro queuedDest queuedSource queued queuedMem isPreVote bodyEq
        exact mem_before_of_granted_response_enqueue
          state.messages
          (requestVoteMessage state source dest)
          queued
          queuedDest
          queuedSource
          (by
            simpa [next, rawNext, nextRequestVote] using queuedMem)
          isPreVote
          bodyEq
          (by simp [requestVoteMessage])
  | appendEntries source dest =>
      apply VoteHistoryUpdate.same
      apply voteHistoryConsistent_of_preserved state _ owner history
      · intro node
        rfl
      · intro node
        rfl
      · intro candidate voter active counted
        exact ⟨active, counted⟩
      · intro queuedDest queuedSource queued queuedMem isPreVote bodyEq
        exact mem_before_of_granted_response_enqueue
          state.messages
          (appendEntriesMessage state source dest)
          queued
          queuedDest
          queuedSource
          (by
            simpa [next, rawNext, nextAppendEntries] using queuedMem)
          isPreVote
          bodyEq
          (by simp [appendEntriesMessage])
  | becomeLeader leader =>
      apply VoteHistoryUpdate.same
      have enabledDetails := enabled
      simp [Enabled, actionEnabled] at enabledDetails
      apply voteHistoryConsistent_of_preserved state _ owner history
      · intro node
        rfl
      · intro node
        rfl
      · intro candidate voter active counted
        by_cases candidateIsLeader : candidate = leader
        · subst candidate
          exact
            ⟨Or.inl enabledDetails.1.2,
              by simpa [next, rawNext, nextBecomeLeader] using counted⟩
        · exact
            ⟨by
              simpa [next, rawNext, nextBecomeLeader,
                candidateIsLeader] using active,
              by simpa [next, rawNext, nextBecomeLeader] using counted⟩
      · intro queuedDest queuedSource queued queuedMem isPreVote bodyEq
        simpa [next, rawNext, nextBecomeLeader] using queuedMem
  | clientRequest leader =>
      apply VoteHistoryUpdate.same
      apply voteHistoryConsistent_of_preserved state _ owner history
      · intro node
        rfl
      · intro node
        rfl
      · intro candidate voter active counted
        exact ⟨active, counted⟩
      · intro queuedDest queuedSource queued queuedMem isPreVote bodyEq
        simpa [next, rawNext, nextClientRequest] using queuedMem
  | signCommittableMessages leader =>
      apply VoteHistoryUpdate.same
      apply voteHistoryConsistent_of_preserved state _ owner history
      · intro node
        rfl
      · intro node
        rfl
      · intro candidate voter active counted
        exact ⟨active, counted⟩
      · intro queuedDest queuedSource queued queuedMem isPreVote bodyEq
        simpa [next, rawNext, nextSignCommittableMessages] using queuedMem
  | changeConfiguration leader configuration =>
      apply VoteHistoryUpdate.same
      apply voteHistoryConsistent_of_preserved state _ owner history
      · intro node
        rfl
      · intro node
        rfl
      · intro candidate voter active counted
        exact ⟨active, counted⟩
      · intro queuedDest queuedSource queued queuedMem isPreVote bodyEq
        simpa [next, rawNext, nextChangeConfiguration] using queuedMem
  | advanceCommitIndex leader =>
      apply VoteHistoryUpdate.same
      have enabledDetails := enabled
      simp [Enabled, actionEnabled] at enabledDetails
      apply voteHistoryConsistent_of_preserved state _ owner history
      · intro node
        rfl
      · intro node
        rfl
      · intro candidate voter active counted
        by_cases candidateIsLeader : candidate = leader
        · subst candidate
          exact ⟨Or.inr enabledDetails.1.2, counted⟩
        · exact
            ⟨by
              simpa [next, rawNext, nextAdvanceCommitIndex,
                candidateIsLeader] using active,
              counted⟩
      · intro queuedDest queuedSource queued queuedMem isPreVote bodyEq
        simpa [next, rawNext, nextAdvanceCommitIndex] using queuedMem
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [Enabled, actionEnabled, hmessage] at enabled
      | some message =>
          cases kind with
          | dropIgnored =>
              apply VoteHistoryUpdate.same
              apply voteHistoryConsistent_of_preserved state _ owner history
              · intro node
                simp [next, rawNext, nextReceive, hmessage]
              · intro node
                simp [next, rawNext, nextReceive, hmessage]
              · intro candidate voter active counted
                exact
                  ⟨by
                    simpa [next, rawNext, nextReceive, hmessage] using
                      active,
                    by
                      simpa [next, rawNext, nextReceive, hmessage] using
                        counted⟩
              · intro queuedDest queuedSource queued queuedMem isPreVote
                  bodyEq
                exact mem_before_of_mem_discard
                  state.messages
                  message
                  queued
                  queuedDest
                  queuedSource
                  (by
                    simpa [next, rawNext, nextReceive, hmessage] using
                      queuedMem)
          | updateTerm =>
              exact updateTerm_voteHistoryUpdate
                state dest source message owner history hmessage enabled
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  cases grantEq :
                      requestVoteGranted
                        state
                        dest
                        source
                        message.term
                        lastTerm
                        lastIndex with
                  | true =>
                      exact grantedRequestVote_voteHistoryUpdate
                        state
                        dest
                        source
                        message
                        lastTerm
                        lastIndex
                        isPreVote
                        owner
                        history
                        hmessage
                        hbody
                        grantEq
                  | false =>
                      let response : Message :=
                        {
                          term := state.currentTerm dest
                          source := dest
                          dest := source
                          body := .requestVoteResponse false isPreVote
                        }
                      apply VoteHistoryUpdate.same
                      apply voteHistoryConsistent_of_preserved
                        state _ owner history
                      · intro node
                        simp [next, rawNext, nextReceive, hmessage,
                          hbody, grantEq]
                      · intro node
                        simp [next, rawNext, nextReceive, hmessage,
                          hbody, grantEq]
                      · intro candidate voter active counted
                        exact
                          ⟨by
                            simpa [next, rawNext, nextReceive, hmessage,
                              hbody, grantEq] using active,
                            by
                              simpa [next, rawNext, nextReceive, hmessage,
                                hbody, grantEq] using counted⟩
                      · intro queuedDest queuedSource queued queuedMem
                          responseIsPreVote responseBody
                        exact mem_before_of_granted_response_reply
                          state.messages
                          response
                          message
                          queued
                          queuedDest
                          queuedSource
                          (by
                            simpa [next, rawNext, nextReceive, hmessage,
                              hbody, grantEq, response] using queuedMem)
                          responseIsPreVote
                          responseBody
                          (by simp [response])
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | handleRequestVoteResponse =>
              cases hbody : message.body with
              | requestVoteResponse voteGranted isPreVote =>
                  exact
                    handleRequestVoteResponse_voteHistoryUpdate
                      state
                      dest
                      source
                      message
                      voteGranted
                      isPreVote
                      owner
                      history
                      hmessage
                      hbody
                      enabled
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | dropRequestVoteResponseOutOfState =>
              simpa [next, rawNext, nextReceive, hmessage] using
                discard_voteHistoryUpdate
                  state message owner history
          | dropRequestVoteResponseStale =>
              simpa [next, rawNext, nextReceive, hmessage] using
                discard_voteHistoryUpdate
                  state message owner history
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      apply VoteHistoryUpdate.same
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        responseCase] using history
                  | some response =>
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        responseCase] using
                          nonGrantedReply_voteHistoryUpdate
                            state
                            response
                            message
                            owner
                            history
                            (by
                              intro isPreVote responseGranted
                              rcases appendEntriesRejectResponse_body_eq
                                  state
                                  message
                                  response
                                  previousIndex
                                  previousTerm
                                  responseCase with
                                ⟨lastIndex, responseBody⟩
