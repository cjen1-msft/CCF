private theorem acknowledgedPrefixRetained_extend_old
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader follower : Node}
    (acknowledged :
      AcknowledgedPrefixRetainedInv start actions state)
    (witness :
      MatchIndexWitness
        start
        (actions ++ [action])
        (next state action)
        leader follower)
    (oldAckOccurrence :
      Occurs
        start actions state
        witness.ack.origin.responseState
        (.receive
          follower leader
          witness.ack.origin.kind.receiveKind))
    (oldHandle :
      Occurs
        start actions state witness.handledState
        (.receive
          leader follower
          .handleAppendEntriesResponseSuccess))
    (oldLeader : state.leadershipState leader = .leader)
    (oldSameTerm :
      state.currentTerm leader = state.currentTerm follower)
    (oldIndex :
      state.matchIndex leader follower =
        witness.lastLogIndex)
    (oldResponseTerm :
      witness.response.term = state.currentTerm leader)
    (followerLogRetained :
      isLogPrefix
        (state.log follower)
        ((next state action).log follower)) :
    isLogPrefix
      (logPrefix
        ((next
          witness.ack.origin.responseState
          (.receive
            follower
            leader
            witness.ack.origin.kind.receiveKind)).log follower)
        witness.lastLogIndex)
      ((next state action).log follower) := by
  have oldPrefix :=
    acknowledged
      leader
      follower
      oldLeader
      oldSameTerm
      (matchIndexWitness_restrict
        witness
        (ackWitness_restrict witness.ack oldAckOccurrence)
        oldHandle
        oldIndex)
