        basis

theorem chosenCommitCertificate_configuration_mem_chosenPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index) :
    certificate.configuration ∈
      logConfigurations certificate.chosenPrefix := by
  have selectedFacts :=
    committedConfigurationAt?_some_properties
      (boundaryState.log owner)
      index
      certificate.configuration
      certificate.configuration_at
  rw [certificate.prefix_eq]
  have inBoundaryPrefix :
      certificate.configuration ∈
        logConfigurations ((boundaryState.log owner).take index) := by
    rw [logConfigurations_take]
    simpa [configurationsToIndex] using selectedFacts
  simpa [logPrefix] using inBoundaryPrefix

private theorem configuration_mem_logConfigurations_of_prefix
    (configuration : ConfigurationAt)
    (prefixEntries entries : List Entry)
    (configurationMember :
      configuration ∈ logConfigurations prefixEntries)
    (prefixProof : isLogPrefix prefixEntries entries) :
    configuration ∈ logConfigurations entries := by
  rcases prefixProof with ⟨suffix, entriesEq⟩
  rw [← entriesEq]
  rw [logConfigurations, configurationsInEntries,
    configurationsInEntriesAux_append]
  apply List.mem_append.mpr
  exact Or.inl
    (by
      simpa [logConfigurations, configurationsInEntries] using
        configurationMember)

theorem candidateChosenConfigurations_overlap_of_mutual_carry
    {firstStart secondStart : InitialConfiguration}
    {firstActions secondActions : List Action}
    {firstState secondState : State}
    {firstCandidate secondCandidate : Node}
    (first :
      CandidateChosenConfigurationWitness
        firstStart firstActions firstState firstCandidate)
    (second :
      CandidateChosenConfigurationWitness
        secondStart secondActions secondState secondCandidate)
    (firstExact : ConfigurationsExactInv firstState)
    (secondExact : ConfigurationsExactInv secondState)
    (firstCarriesSecond :
      isLogPrefix
        second.certificate.chosenPrefix
        (firstState.log firstCandidate))
    (secondCarriesFirst :
      isLogPrefix
        first.certificate.chosenPrefix
        (secondState.log secondCandidate)) :
    Exists fun firstConfiguration : ConfigurationAt =>
      Exists fun secondConfiguration : ConfigurationAt =>
        And
          (firstConfiguration ∈
            firstState.configurations firstCandidate)
          (And
            (secondConfiguration ∈
              secondState.configurations secondCandidate)
            (firstConfiguration.nodes =
              secondConfiguration.nodes)) := by
  have firstThreshold :
      lastConfigurationToIndex
          (logConfigurations (firstState.log firstCandidate))
          (firstState.commitIndex firstCandidate) <=
        first.certificate.configuration.index := by
    have member := first.configuration_mem
    rw [firstExact firstCandidate] at member
    have details :
        first.certificate.configuration ∈
            logConfigurations (firstState.log firstCandidate) ∧
          lastConfigurationToIndex
              (logConfigurations (firstState.log firstCandidate))
              (firstState.commitIndex firstCandidate) <=
            first.certificate.configuration.index := by
      simpa [activeLogConfigurations, configurationsFromIndex] using
        member
    exact details.2
  have secondThreshold :
      lastConfigurationToIndex
          (logConfigurations (secondState.log secondCandidate))
          (secondState.commitIndex secondCandidate) <=
        second.certificate.configuration.index := by
    have member := second.configuration_mem
    rw [secondExact secondCandidate] at member
    have details :
        second.certificate.configuration ∈
            logConfigurations (secondState.log secondCandidate) ∧
          lastConfigurationToIndex
              (logConfigurations (secondState.log secondCandidate))
              (secondState.commitIndex secondCandidate) <=
            second.certificate.configuration.index := by
      simpa [activeLogConfigurations, configurationsFromIndex] using
        member
    exact details.2
  by_cases firstBeforeSecond :
      first.certificate.configuration.index <=
        second.certificate.configuration.index
  · have secondInFirstLog :
        second.certificate.configuration ∈
          logConfigurations (firstState.log firstCandidate) :=
      configuration_mem_logConfigurations_of_prefix
        second.certificate.configuration
        second.certificate.chosenPrefix
        (firstState.log firstCandidate)
        (chosenCommitCertificate_configuration_mem_chosenPrefix
          second.certificate)
        firstCarriesSecond
    have secondInFirst :
        second.certificate.configuration ∈
          firstState.configurations firstCandidate := by
      rw [firstExact firstCandidate]
      simp [activeLogConfigurations, configurationsFromIndex,
        secondInFirstLog]
      exact firstThreshold.trans firstBeforeSecond
    exact
      ⟨second.certificate.configuration,
        second.certificate.configuration,
        secondInFirst,
        second.configuration_mem,
        rfl⟩
  · have secondBeforeFirst :
        second.certificate.configuration.index <=
          first.certificate.configuration.index := by
      omega
    have firstInSecondLog :
        first.certificate.configuration ∈
          logConfigurations (secondState.log secondCandidate) :=
      configuration_mem_logConfigurations_of_prefix
        first.certificate.configuration
        first.certificate.chosenPrefix
        (secondState.log secondCandidate)
        (chosenCommitCertificate_configuration_mem_chosenPrefix
          first.certificate)
        secondCarriesFirst
    have firstInSecond :
        first.certificate.configuration ∈
          secondState.configurations secondCandidate := by
      rw [secondExact secondCandidate]
      simp [activeLogConfigurations, configurationsFromIndex,
        firstInSecondLog]
      exact secondThreshold.trans secondBeforeFirst
    exact
      ⟨first.certificate.configuration,
        first.certificate.configuration,
        first.configuration_mem,
        firstInSecond,
        rfl⟩

theorem chosenCommitCertificate_chosenPrefix_boundary_entry
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index) :
    entryAt? certificate.chosenPrefix index =
      some
        ({ term := certificate.boundaryTerm, content := .signature } :
          Entry) := by
  cases atIndex :
      entryAt? (boundaryState.log owner) index with
  | none =>
      have boundaryTerm := certificate.boundary_term
      simp [atIndex] at boundaryTerm
  | some entry =>
      have entryTerm :
          entry.term = certificate.boundaryTerm := by
        simpa [atIndex] using certificate.boundary_term
      have entryContent : entry.content = .signature := by
        simpa [atIndex] using boundary.2.2
      have entryEq :
          entry =
            ({ term := certificate.boundaryTerm, content := .signature } :
              Entry) := by
        cases entry
        simp_all
      rw [certificate.prefix_eq, logPrefix]
      simpa [entryEq] using
        entryAt?_take_of_some
          (boundaryState.log owner)
          index index entry atIndex (Nat.le_refl _)

private theorem lastCommittableIndex_signature_or_zero
    (state : State)
    (node : Node)
    (signatures : SignatureInv state) :
    Or
      (lastCommittableIndex state node = 0)
      (Exists fun entry =>
        And
          (entryAt?
              (state.log node)
              (lastCommittableIndex state node) =
            some entry)
          (entry.content = .signature)) := by
  unfold lastCommittableIndex
  by_cases commitLe :
      state.commitIndex node <=
        maxCommittableIndex (state.log node)
  · rw [max_eq_right commitLe]
    exact maxCommittableIndex_signature_or_zero (state.log node)
  · rw [max_eq_left (Nat.le_of_not_ge commitLe)]
    by_cases commitZero : state.commitIndex node = 0
    · exact Or.inl commitZero
    · cases atCommit :
          entryAt?
            (state.log node)
            (state.commitIndex node) with
      | none =>
          have signature := signatures node (by omega)
          simp [atCommit] at signature
      | some entry =>
          exact Or.inr
            ⟨entry, rfl,
              by
                have signature := signatures node (by omega)
                simpa [atCommit] using signature⟩

private structure ChoiceIndexCertificateWitness
    (start : InitialConfiguration)
    (actions : List Action)
    (state boundaryState : State)
    (owner : Node)
    (index : Nat)
    (target :
      ChosenCommitCertificate
        start actions state boundaryState owner index) where
  boundaryState : State
  boundary :
    SignatureCommitBoundary
      boundaryState target.choiceLeader target.choiceIndex
  certificate :
    ChosenCommitCertificate
      start actions state boundaryState
      target.choiceLeader target.choiceIndex
  prefix_eq :
    certificate.chosenPrefix = target.choiceIndexPrefix
  choice_term_le :
    certificate.choiceTerm <= target.choiceTerm

private theorem chosenCommitCertificate_choiceIndex_certificate
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState : State}
    {owner : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (target :
      ChosenCommitCertificate
        start actions state boundaryState owner index) :
    Nonempty
      (ChoiceIndexCertificateWitness
        start actions state boundaryState owner index target) := by
  have currentChosen :
      HistoricalChosenCommitCore start actions state :=
    core.chosenCommits List.prefix_rfl history
  cases origin : target.choice_origin with
  | initial choiceStateEq choiceLeaderEq choiceIndexEq =>
      have boundary :
          SignatureCommitBoundary
            (initialState start) start 2 := by
        refine
          ⟨by simp [initialState, start.leader_mem],
            by simp [initialState, startLog, start.leader_mem], ?_⟩
        simp [initialState, startLog, entryAt?, start.leader_mem]
      rcases
          currentChosen
            (initialState start)
            (protocolHistory_initial_stateAt history)
            start
            2
            boundary with
        ⟨certificate⟩
      have targetChoiceTerm : target.choiceTerm = startTerm := by
        rw [← target.choice_term, choiceStateEq, choiceLeaderEq]
        simp [initialState, start.leader_mem]
      let projectedCertificate :
          ChosenCommitCertificate
            start actions state
            (initialState start)
            target.choiceLeader
            target.choiceIndex := by
        simpa [choiceLeaderEq, choiceIndexEq] using certificate
      exact
        ⟨{
          boundaryState := initialState start
          boundary := by
            simpa [choiceLeaderEq, choiceIndexEq] using boundary
          certificate := projectedCertificate
          prefix_eq := by
            rw [projectedCertificate.prefix_eq,
              target.choice_index_prefix_eq,
              choiceStateEq, choiceLeaderEq, choiceIndexEq]
          choice_term_le := by
            rw [targetChoiceTerm]
            simpa [initialState, choiceLeaderEq, start.leader_mem] using
              projectedCertificate.choice_term_le_boundary_owner
        }⟩
  | advance occurrence choiceIndexEq =>
      let choiceAfter :=
        next target.choiceState
          (.advanceCommitIndex target.choiceLeader)
      have choiceAfterAt :
          StateAt start actions state choiceAfter := by
        simpa [choiceAfter] using occurs_after_stateAt occurrence
      have choiceIndexPositive : 0 < target.choiceIndex := by
        have choiceEntry := target.choice_index_entry
        unfold entryAt? at choiceEntry
        split at choiceEntry
        · contradiction
        · omega
      have boundary :
          SignatureCommitBoundary
            choiceAfter target.choiceLeader target.choiceIndex := by
        refine ⟨choiceIndexPositive, ?_, ?_⟩
        · simpa [choiceAfter, next, rawNext, nextAdvanceCommitIndex,
            choiceIndexEq]
        · simpa [choiceAfter, next, rawNext, nextAdvanceCommitIndex] using
            congrArg (Option.map (·.content))
              target.choice_index_entry
      rcases
          currentChosen
            choiceAfter
            choiceAfterAt
            target.choiceLeader
            target.choiceIndex
            boundary with
        ⟨certificate⟩
      exact
        ⟨{
          boundaryState := choiceAfter
          boundary
          certificate
          prefix_eq := by
            rw [certificate.prefix_eq,
              target.choice_index_prefix_eq]
            simp [choiceAfter, next, rawNext, nextAdvanceCommitIndex]
          choice_term_le := by
            exact
              certificate.choice_term_le_boundary_owner.trans_eq
                (by
                  simp [choiceAfter, next, rawNext,
                    nextAdvanceCommitIndex, target.choice_term])
        }⟩

private theorem requestVoteLogOK_carries_chosenPrefix_with_term
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState voterState : State}
    {owner voter candidate : Node}
    {index lastTerm lastIndex : Nat}
    {request : Message}
    (history : ProtocolHistory start actions endState)
    (historicalMono :
      HistoricalMonoLogInv start actions endState)
    (matching :
      TemporalLogMatchingInv start actions endState)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (voterAt :
      StateAt start actions endState voterState)
    (send :
      RVSendWitness
        start actions endState voter candidate request)
    (requestBody :
      request.body =
        .requestVoteRequest lastTerm lastIndex false)
    (logOK :
      requestVoteLogOK
          voterState voter lastTerm lastIndex =
        true)
    (voterChoiceSupport :
      isLogPrefix
        certificate.choiceIndexPrefix
        (voterState.log voter)) :
    And
      (isLogPrefix
        certificate.chosenPrefix
        (send.sendState.log candidate))
      (certificate.choiceTerm <=
        send.sendState.currentTerm candidate) := by
  have sendAt := occurs_before_stateAt send.occurrence
  have sentBody := congrArg Message.body send.message_eq
  have requestFacts :
      lastTerm =
          lastCommittableTerm send.sendState candidate ∧
        lastIndex =
          lastCommittableIndex send.sendState candidate := by
    simpa [requestVoteMessage, requestBody] using sentBody
  have chosenEntry :=
    chosenCommitCertificate_chosenPrefix_boundary_entry
      certificate boundary
  have chosenLength :=
    chosenCommitCertificate_chosenPrefix_length certificate
  have voterSupport :
      isLogPrefix
        certificate.chosenPrefix
        (voterState.log voter) :=
    certificate.boundary_prefix_le_choice_prefix.trans
      voterChoiceSupport
  have indexPositive : 0 < index := boundary.1
  have voterChosenEntry :
      entryAt? (voterState.log voter) index =
        some
          ({ term := certificate.boundaryTerm, content := .signature } :
            Entry) := by
    rcases voterSupport with ⟨suffix, voterLogEq⟩
    rw [← voterLogEq]
    exact entryAt?_append_of_some
      certificate.chosenPrefix suffix index _ chosenEntry
  have choicePrefixEntry :
      entryAt? certificate.choiceIndexPrefix certificate.choiceIndex =
        some
          ({ term := certificate.choiceTerm, content := .signature } :
            Entry) := by
    rw [certificate.choice_index_prefix_eq, logPrefix]
    exact
      entryAt?_take_of_some
        (certificate.choiceState.log certificate.choiceLeader)
        certificate.choiceIndex
        certificate.choiceIndex
        _
        certificate.choice_index_entry
        (Nat.le_refl _)
  have voterChoiceEntry :
      entryAt? (voterState.log voter) certificate.choiceIndex =
        some
          ({ term := certificate.choiceTerm, content := .signature } :
            Entry) := by
    rcases voterChoiceSupport with ⟨suffix, voterLogEq⟩
    rw [← voterLogEq]
    exact
      entryAt?_append_of_some
        certificate.choiceIndexPrefix
        suffix
        certificate.choiceIndex
        _
        choicePrefixEntry
  have indexLeVoterMax :
      index <= maxCommittableIndex (voterState.log voter) :=
    certificate.boundary_le_choice.trans
      (index_le_maxCommittableIndex_of_signature
        (voterState.log voter)
        certificate.choiceIndex
        (by simp [voterChoiceEntry]))
  have voterMaxPositive :
      0 < maxCommittableIndex (voterState.log voter) := by
    omega
  rcases
      maxCommittableIndex_signature_or_zero
        (voterState.log voter) with
    voterMaxZero | ⟨voterMaxEntry, voterMaxAt, voterMaxSignature⟩
  · omega
  have voterMaxTermEq :
      maxCommittableTerm (voterState.log voter) =
        voterMaxEntry.term := by
    simp [maxCommittableTerm, voterMaxAt]
  have voterLogNonempty : voterState.log voter != [] := by
    cases empty : voterState.log voter with
    | nil =>
        rw [empty] at voterChosenEntry
        simp [entryAt?] at voterChosenEntry
    | cons head tail =>
        rfl
  have choiceLeVoterMaxTerm :
      certificate.choiceTerm <=
        maxCommittableTerm (voterState.log voter) := by
    rw [voterMaxTermEq]
    have voterMono :=
      (historicalMono voterState voterAt voter voterLogNonempty).2
    have bound :=
      monoLogEntries_entryAt_term_le
        (voterState.log voter)
        certificate.choiceIndex
        (maxCommittableIndex (voterState.log voter))
        ({ term := certificate.choiceTerm, content := .signature } :
          Entry)
        voterMaxEntry
        voterMono voterChoiceEntry voterMaxAt
        (index_le_maxCommittableIndex_of_signature
          (voterState.log voter)
          certificate.choiceIndex
          (by simp [voterChoiceEntry]))
    simpa using bound
  have choiceLeVoterMaxEntry :
      certificate.choiceTerm <= voterMaxEntry.term := by
    simpa [← voterMaxTermEq] using choiceLeVoterMaxTerm
  have choiceAfterStart :
      startTerm <= certificate.choiceTerm := by
    rcases certificate.choice_at with ⟨choiceAtWitness⟩
    have minimum :=
      protocolHistory_implies_MinimumTermInv
        choiceAtWitness.stateHistory
    rw [← certificate.choice_term]
    exact minimum.activeRoles certificate.choiceLeader
      (by simp [certificate.choice_leader])
  have logOKFacts := logOK
  simp [requestVoteLogOK] at logOKFacts
  rw [voterMaxTermEq] at logOKFacts
  have choiceLeLastTerm :
      certificate.choiceTerm <= lastTerm := by
    rcases logOKFacts with termGreater | ⟨termEqual, _indexBound⟩
    · exact Nat.le_of_lt
        (lt_of_le_of_lt choiceLeVoterMaxEntry termGreater)
    · exact choiceLeVoterMaxEntry.trans_eq termEqual
  have signaturesAtSend :
      SignatureInv send.sendState :=
    reachable_SignatureInv
      start
      (stateAt_reachable sendAt)
  rcases
      lastCommittableIndex_signature_or_zero
        send.sendState candidate signaturesAtSend with
    candidateIndexZero |
      ⟨candidateEntry, candidateAt, candidateSignature⟩
  · have lastIndexZero : lastIndex = 0 := by
      exact requestFacts.2.trans candidateIndexZero
    have lastTermZero : lastTerm = 0 := by
      rw [requestFacts.1, lastCommittableTerm,
        candidateIndexZero]
      simp [entryAt?]
    rw [lastTermZero] at choiceLeLastTerm
    simp [startTerm] at choiceAfterStart
    omega
  have candidateIndexEq :
      lastIndex =
        lastCommittableIndex send.sendState candidate :=
    requestFacts.2
  have candidateAtLast :
      entryAt? (send.sendState.log candidate) lastIndex =
        some candidateEntry := by
    rw [candidateIndexEq]
    exact candidateAt
  have candidateEntryTerm :
      candidateEntry.term = lastTerm := by
    have termEq := requestFacts.1
    rw [lastCommittableTerm, ← candidateIndexEq,
      candidateAtLast] at termEq
    exact termEq.symm
  have candidateEntryEq :
      candidateEntry =
        ({ term := lastTerm, content := .signature } : Entry) := by
    cases candidateEntry
    simp_all
  have candidateSignatureAt :
      entryAt? (send.sendState.log candidate) lastIndex =
        some ({ term := lastTerm, content := .signature } : Entry) := by
    simpa [candidateEntryEq] using candidateAtLast
  have lastIndexPositive : 0 < lastIndex := by
    unfold entryAt? at candidateSignatureAt
    split at candidateSignatureAt
    · contradiction
    · omega
  have signatureOrigins :=
    protocolHistory_implies_HistoricalSignatureLeaderAtIndexInv
      history matching
  rcases
      signatureOrigins
        send.sendState sendAt candidate lastIndex lastTerm
        candidateSignatureAt
        (Nat.le_trans choiceAfterStart choiceLeLastTerm) with
    ⟨leaderState, originLeader, leaderAt, originLeaderRole,
      originLeaderTerm, originLeaderEntry⟩
  have leaderLogNonempty :
      leaderState.log originLeader != [] := by
    cases empty : leaderState.log originLeader with
    | nil =>
        rw [empty] at originLeaderEntry
        simp [entryAt?] at originLeaderEntry
    | cons head tail =>
        rfl
  have originLeaderMono :=
    (historicalMono
      leaderState leaderAt originLeader leaderLogNonempty).2
  have chosenPrefixAtLeader :
      forall prefixProof :
          isLogPrefix
            certificate.chosenPrefix
            (leaderState.log originLeader),
        entryAt? (leaderState.log originLeader) index =
          some
            ({ term := certificate.boundaryTerm, content := .signature } :
              Entry) := by
    intro prefixProof
    rcases prefixProof with ⟨suffix, leaderLogEq⟩
    rw [← leaderLogEq]
    exact entryAt?_append_of_some
      certificate.chosenPrefix suffix index _ chosenEntry
  have chosenInOriginLeader :
      isLogPrefix
        certificate.chosenPrefix
        (leaderState.log originLeader) := by
    rcases Nat.lt_or_eq_of_le choiceLeLastTerm with
      choiceEarlier | sameChoiceTerm
    · exact certificate.higher_term_leaders
        leaderState leaderAt originLeader originLeaderRole
        (by simpa [originLeaderTerm] using choiceEarlier)
    · have sameLeader :
          certificate.choiceLeader = originLeader :=
        leaderUniqueness
          certificate.choiceState leaderState
          certificate.choice_at leaderAt
          certificate.choiceLeader originLeader
          certificate.choice_leader originLeaderRole
          (by
            rw [certificate.choice_term, originLeaderTerm,
              sameChoiceTerm])
      subst originLeader
      have indexLeLast : index <= lastIndex := by
        rcases logOKFacts with termGreater | ⟨termEqual, indexBound⟩
        · have voterTermLtLast :
              maxCommittableTerm (voterState.log voter) <
                lastTerm := by
            simpa [voterMaxTermEq] using termGreater
          omega
        · exact Nat.le_trans indexLeVoterMax
            (by simpa [requestFacts.2] using indexBound)
      have leaderLength :
          lastIndex <=
            (leaderState.log certificate.choiceLeader).length := by
        unfold entryAt? at originLeaderEntry
        split at originLeaderEntry
        · contradiction
        · have bound :=
            (List.getElem?_eq_some_iff.mp originLeaderEntry).choose
          omega
      have logsComparable :=
        historical_sameTerm_leader_logs_comparable
          certificate.choice_at leaderAt
          certificate.choiceLeader
          certificate.choice_leader originLeaderRole
          (by
            rw [certificate.choice_term, originLeaderTerm,
              sameChoiceTerm])
      rcases logsComparable with choiceToOrigin | originToChoice
      · exact
          (chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
            certificate).trans choiceToOrigin
      · rcases
            List.prefix_or_prefix_of_prefix
              (chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
                certificate)
              originToChoice with
          chosenToOrigin | originToChosen
        · exact chosenToOrigin
        · have sameLogs :
              leaderState.log certificate.choiceLeader =
                certificate.chosenPrefix :=
            originToChosen.eq_of_length_le
              (by rw [chosenLength]; omega)
          rw [sameLogs]
          exact List.prefix_rfl
  have indexLeLast : index <= lastIndex := by
    by_contra notLe
    have lastLeIndex : lastIndex <= index := by omega
    have termBound :=
      monoLogEntries_entryAt_term_le
        (leaderState.log originLeader)
        lastIndex index
        ({ term := lastTerm, content := .signature } : Entry)
        ({ term := certificate.boundaryTerm, content := .signature } :
          Entry)
        originLeaderMono originLeaderEntry
        (chosenPrefixAtLeader chosenInOriginLeader)
        lastLeIndex
    have choiceStrict : certificate.choiceTerm < lastTerm := by
      rcases Nat.lt_or_eq_of_le choiceLeLastTerm with
        strict | equal
      · exact strict
      · have indexBound :
            index <= lastIndex := by
          rcases logOKFacts with termGreater | ⟨termEqual, bound⟩
          · have voterTermLtLast :
                maxCommittableTerm (voterState.log voter) <
                  lastTerm := by
              simpa [voterMaxTermEq] using termGreater
            omega
          · exact Nat.le_trans indexLeVoterMax
              (by simpa [requestFacts.2] using bound)
        contradiction
    simp at termBound
    have boundaryLeChoice := certificate.boundary_term_le_choice
    omega
  have leaderWithin :
      lastIndex <= (leaderState.log originLeader).length := by
    unfold entryAt? at originLeaderEntry
    split at originLeaderEntry
    · contradiction
    · have bound :=
        (List.getElem?_eq_some_iff.mp originLeaderEntry).choose
      omega
  have candidateWithin :
      lastIndex <= (send.sendState.log candidate).length := by
    unfold entryAt? at candidateSignatureAt
    split at candidateSignatureAt
    · contradiction
    · have bound :=
        (List.getElem?_eq_some_iff.mp candidateSignatureAt).choose
      omega
  have prefixesAtLast :
      logPrefix (leaderState.log originLeader) lastIndex =
        logPrefix (send.sendState.log candidate) lastIndex :=
    matching
      leaderState send.sendState leaderAt sendAt
      originLeader candidate lastIndex
      (by omega)
      (Nat.le_min.mpr ⟨leaderWithin, candidateWithin⟩)
      (by simp [originLeaderEntry, candidateSignatureAt])
  have chosenToLeaderPrefix :
      isLogPrefix
        certificate.chosenPrefix
        (logPrefix (leaderState.log originLeader) lastIndex) := by
    rw [prefix_eq_logPrefix_of_length
      certificate.chosenPrefix
      (leaderState.log originLeader)
      index chosenInOriginLeader chosenLength]
    exact logPrefix_mono_isLogPrefix
      (leaderState.log originLeader) index lastIndex indexLeLast
  rw [prefixesAtLast] at chosenToLeaderPrefix
  have carries :=
    chosenToLeaderPrefix.trans
      (logPrefix_isLogPrefix
        (send.sendState.log candidate) lastIndex)
  have lastTermLeCurrent :
      lastTerm <= send.sendState.currentTerm candidate := by
    rw [← candidateEntryTerm]
    exact
      logEntryTerm_le_currentTerm
        send.sendState
        (historicalMono send.sendState sendAt)
        candidate
        lastIndex
        candidateEntry
        candidateAtLast
  exact
