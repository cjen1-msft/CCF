private theorem replays_commitIndex_mono
    {before after : State}
    {actions : List Action}
    (replay : Replays before actions after) :
    forall node : Node,
      before.commitIndex node <= after.commitIndex node := by
  induction actions generalizing before with
  | nil =>
      simp [Replays] at replay
      subst after
      intro node
      exact Nat.le_refl _
  | cons action tail inductionHypothesis =>
      rcases replay with ⟨enabled, tailReplay⟩
      intro node
      exact
        (monotonicCommitIndex_step before action enabled node).trans
          (inductionHypothesis tailReplay node)

private theorem historicalCompleteSafetyCore_candidateWitness_evidence
    {start : InitialConfiguration}
    {actions : List Action}
    {state historicalState : State}
    (history : ProtocolHistory start actions state)
