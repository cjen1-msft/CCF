    exact sameSendTerm.symm.trans originTerm
  have requestPrefix :=
    sameLeaderPrefixes
      requestSendState
      (occurs_before_stateAt requestSend)
      leader
      requestLeader
      finalLeader
      requestTerm
  have acknowledgedBound :
