                  simp [next, rawNext, nextTimeout]
                log_eq := by
                  simp [next, rawNext, nextTimeout]
                commit_eq := by
                  simp [next, rawNext, nextTimeout]
                configurations_eq := by
                  simp [next, rawNext, nextTimeout]
