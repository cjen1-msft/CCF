private theorem quorumCandidateFormationAction_candidate_unique
    {state : State}
    {action : Action}
    {first second : Node}
    (firstFormation :
      QuorumCandidateFormationAction state action first)
    (secondFormation :
      QuorumCandidateFormationAction state action second) :
    first = second := by
  rcases firstFormation with
    ⟨timedOut, actionEq, candidateEq⟩ |
      ⟨source, response, actionEq, responseHead, responseBody⟩
  <;> rcases secondFormation with
    ⟨otherTimedOut, otherActionEq, otherCandidateEq⟩ |
      ⟨otherSource, otherResponse, otherActionEq,
        otherResponseHead, otherResponseBody⟩
  <;> simp_all

private theorem quorumPotentialFormationAction_candidate_unique
    {state : State}
    {action : Action}
    {counted potential : Node}
    (countedFormation :
      QuorumCandidateFormationAction state action counted)
    (potentialFormation :
      PotentialCandidateFormationAction state action potential) :
    counted = potential := by
  rcases countedFormation with
    ⟨timedOut, actionEq, candidateEq⟩ |
      ⟨source, response, actionEq, responseHead, responseBody⟩
  <;> rcases potentialFormation with
    ⟨otherTimedOut, otherActionEq, otherCandidateEq⟩ |
      ⟨voter, request, lastTerm, lastIndex,
        otherActionEq, requestHead, requestBody, granted⟩
  <;> simp_all

private def commitChoiceOrigin_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state choiceState : State}
    {choiceLeader : Node}
    {choiceIndex : Nat}
    {action : Action}
    (origin :
      CommitChoiceOrigin
        start actions state choiceState choiceLeader choiceIndex)
    (enabled : Enabled state action) :
    CommitChoiceOrigin
      start
      (actions ++ [action])
      (next state action)
      choiceState
      choiceLeader
      choiceIndex :=
  match origin with
  | .initial choiceStateEq choiceLeaderEq choiceIndexEq =>
      .initial choiceStateEq choiceLeaderEq choiceIndexEq
  | .advance occurrence choiceIndexEq =>
      .advance (occurs_extend occurrence enabled) choiceIndexEq

private theorem commitChoiceOrigin_append_step_progress
    {start : InitialConfiguration}
