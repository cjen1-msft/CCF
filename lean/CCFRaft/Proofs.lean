theorem countedQuorumReadyCandidate_carries_chosenPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state targetBoundaryState : State}
    {candidate targetOwner : Node}
    {targetIndex : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (candidateWitness :
      CandidateChosenConfigurationWitness
        start actions state candidate)
    (target :
      ChosenCommitCertificate
        start actions state
        targetBoundaryState targetOwner targetIndex)
    (targetBoundary :
      SignatureCommitBoundary
        targetBoundaryState targetOwner targetIndex)
    (targetEarlier :
      target.choiceTerm < state.currentTerm candidate)
    (candidateState :
      state.leadershipState candidate = .candidate)
    (candidateQuorum :
      allConfigurationsHaveQuorum
          (state.votesGranted candidate)
          (state.configurations candidate) =
        true)
    (activeConfiguration : ConfigurationAt)
    (candidateConfigurationActive :
      activeConfiguration ∈ state.configurations candidate)
    (configurationActiveAtChoice :
      activeConfiguration ∈
        target.choiceState.configurations target.choiceLeader)
    (configurationWithinChoice :
      activeConfiguration.index <= target.choiceIndex)
    (supportReflectedToGrant :
      forall voter : Node,
        voter ∈ state.votesGranted candidate ->
          voter ≠ candidate ->
            forall vote :
                CountedVoteLogWitness
                  start actions state candidate voter,
              isLogPrefix
                  target.chosenPrefix
                  (state.log voter) ->
                isLogPrefix
                  target.choiceIndexPrefix
                  (vote.counted.responseOrigin.responseState.log voter))
    (candidateLogRetained :
      forall voter : Node,
        voter ∈ state.votesGranted candidate ->
          voter ≠ candidate ->
            forall vote :
                CountedVoteLogWitness
                  start actions state candidate voter,
              isLogPrefix
                (vote.send.sendState.log candidate)
                (state.log candidate)) :
    isLogPrefix
      target.chosenPrefix
      (state.log candidate) := by
  have quorumAtConfiguration :
      isQuorum
          (state.votesGranted candidate ∩
            activeConfiguration.nodes)
          activeConfiguration.nodes =
        true := by
    have allQuorums := candidateQuorum
    simp [allConfigurationsHaveQuorum] at allQuorums
    exact
      allQuorums
        activeConfiguration
        candidateConfigurationActive
  apply
    quorumReadyCandidate_carries_chosenPrefix
      candidateWitness
      target
      targetEarlier
      activeConfiguration
      candidateConfigurationActive
      (state.votesGranted candidate)
      quorumAtConfiguration
      configurationActiveAtChoice
      configurationWithinChoice
  intro voter voterMember voterIsNotCandidate voterSupport
  have countedVotes :=
    protocolHistory_implies_CountedVoteLogHistoryConsistent history
  rcases
      countedVotes
        candidate
        voter
        (Or.inl candidateState)
        voterMember
        voterIsNotCandidate with
    ⟨vote⟩
  have requestBody :
      vote.counted.responseOrigin.request.body =
        .requestVoteRequest
          vote.counted.responseOrigin.lastTerm
          vote.counted.responseOrigin.lastIndex
          false := by
    have sentBody := congrArg Message.body vote.send.message_eq
    have sentFacts := sentBody.symm
    simp [requestVoteMessage,
      vote.counted.responseOrigin.request_body] at sentFacts
    simpa [sentFacts.2.2] using
      vote.counted.responseOrigin.request_body
  have carriesAtSend :=
    requestVoteLogOK_carries_chosenPrefix_with_term
      history
      core.electionLogs.counted.logs.monoLogs
      core.electionLogs.counted.logs.logMatching
      (completeSafetyCore_implies_leaderUniqueness history core)
      target
      targetBoundary
      (occurs_before_stateAt
        vote.counted.responseOrigin.occurrence)
      vote.send
      requestBody
      vote.log_ok
      (supportReflectedToGrant
        voter voterMember voterIsNotCandidate vote voterSupport)
  exact carriesAtSend.1.trans
    (candidateLogRetained
      voter voterMember voterIsNotCandidate vote)

theorem potentialQuorumReadyCandidate_carries_chosenPrefix
    {start : InitialConfiguration}
