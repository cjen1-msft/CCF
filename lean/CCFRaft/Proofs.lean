    (candidate : Node)
    (candidateState :
      state.leadershipState candidate = .candidate) :
    Nonempty
      (CurrentCandidateTimeoutOrigin
        start actions state candidate) := by
  have origins :
      forall candidate : Node,
        state.leadershipState candidate = .candidate ->
          Nonempty
            (CurrentCandidateTimeoutOrigin
              start actions state candidate) := by
    apply
      protocolHistory_induction
        (start := start)
        (property := fun currentActions currentState =>
          forall currentCandidate : Node,
            currentState.leadershipState currentCandidate =
                .candidate ->
              Nonempty
                (CurrentCandidateTimeoutOrigin
                  start currentActions currentState
                  currentCandidate))
    · intro currentCandidate currentCandidateState
      by_cases member : currentCandidate ∈ start.nodes
      · by_cases leader : currentCandidate = start.leader <;>
          simp [initialState, member, leader, start.leader_mem] at currentCandidateState
      · simp [initialState, member] at currentCandidateState
    · intro pastActions current pastHistory oldOrigins action enabled
        currentCandidate afterCandidate
      cases action with
      | timeout timedOut =>
          by_cases candidateIsTimedOut :
              currentCandidate = timedOut
          · subst currentCandidate
            exact
              ⟨{
                timeoutState := current
                occurrence :=
                  protocolHistory_append_occurs
                    pastHistory enabled
                candidate_state := afterCandidate
