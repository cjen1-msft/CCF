theorem advanceCommitIndex_pendingChoice_higherTermLeaders
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader)) :
    forall leaderState,
      StateAt start actions state leaderState ->
        forall historicalLeader : Node,
          leaderState.leadershipState historicalLeader = .leader ->
            state.currentTerm leader <
                leaderState.currentTerm historicalLeader ->
              isLogPrefix
                (logPrefix
                  (state.log leader)
                  (highestCommittableIndex state leader))
                (leaderState.log historicalLeader) := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have choiceAfterStart :
      startTerm <= state.currentTerm leader :=
    (protocolHistory_implies_MinimumTermInv history).activeRoles
      leader
      (by simp [enabledFacts.1])
  have boundary := advanceCommitIndex_highest_boundary enabled
  have commitBefore :
      state.commitIndex leader <
        highestCommittableIndex state leader := by
    omega
  let weight := actions.length + 1
  have carryByMeasure :
      forall measure : Nat,
        forall leaderState,
          forall leaderEndpoint :
              StateAtWitness start actions state leaderState,
            forall historicalLeader : Node,
              leaderState.leadershipState historicalLeader = .leader ->
                state.currentTerm leader <
                    leaderState.currentTerm historicalLeader ->
                  leaderState.currentTerm historicalLeader * weight +
                      leaderEndpoint.pastActions.length =
                    measure ->
                    isLogPrefix
                      (logPrefix
                        (state.log leader)
                        (highestCommittableIndex state leader))
                      (leaderState.log historicalLeader) := by
    intro measure
    induction measure using Nat.strong_induction_on with
    | h measure inductionHypothesis =>
        intro leaderState leaderEndpoint historicalLeader
          historicalLeaderRole higherTerm measureEq
        rcases
            protocolHistory_implies_LeaderHistoryConsistent
              leaderEndpoint.stateHistory
              historicalLeader
              historicalLeaderRole with
          ⟨origin⟩
        cases origin with
        | initial leaderEq termEq =>
            rw [termEq] at higherTerm
            omega
        | elected election =>
            rcases election.occurrence with ⟨electionOccurrence⟩
            have electionEnabled := electionOccurrence.enabled
            have electionEnabledFacts := electionEnabled
            simp [Enabled, actionEnabled] at electionEnabledFacts
            let electionEndpoint :
                StateAtWitness
                  start actions state election.electionState :=
              {
                pastActions := electionOccurrence.pastActions
                futureActions :=
                  (.becomeLeader historicalLeader ::
                    electionOccurrence.futureActions) ++
                    leaderEndpoint.futureActions
                actions_eq := by
                  calc
                    actions =
                        leaderEndpoint.pastActions ++
                          leaderEndpoint.futureActions :=
                      leaderEndpoint.actions_eq
                    _ =
                        (electionOccurrence.pastActions ++
                          (.becomeLeader historicalLeader ::
                            electionOccurrence.futureActions)) ++
                              leaderEndpoint.futureActions := by
                      simpa [List.append_assoc] using
                        congrArg
                          (fun xs => xs ++ leaderEndpoint.futureActions)
                          electionOccurrence.actions_eq
                    _ =
                        electionOccurrence.pastActions ++
                          ((.becomeLeader historicalLeader ::
                            electionOccurrence.futureActions) ++
                              leaderEndpoint.futureActions) := by
                      simp only [List.append_assoc]
                stateHistory := electionOccurrence.before_history
                remainingHistory :=
                  replays_append
                    ⟨electionOccurrence.enabled,
                      electionOccurrence.after_history⟩
                    leaderEndpoint.remainingHistory
              }
            have electionBeforeLeader :
                electionEndpoint.pastActions.length <
                  leaderEndpoint.pastActions.length := by
              have actionsLength :=
                congrArg List.length electionOccurrence.actions_eq
              dsimp [electionEndpoint]
              simp at actionsLength
              omega
            have lowerTermLeaders :
                forall lowerState,
                  StateAt start actions state lowerState ->
                    forall lowerLeader : Node,
                      lowerState.leadershipState lowerLeader = .leader ->
                        state.currentTerm leader <
                            lowerState.currentTerm lowerLeader ->
                          lowerState.currentTerm lowerLeader <
                              election.electionState.currentTerm
                                historicalLeader ->
                            isLogPrefix
                              (logPrefix
                                (state.log leader)
                                (highestCommittableIndex state leader))
                              (lowerState.log lowerLeader) := by
              intro lowerState lowerAt lowerLeader lowerRole
                lowerHigher lowerThanCandidate
              rcases lowerAt with ⟨lowerEndpoint⟩
              have lowerPastBound :
                  lowerEndpoint.pastActions.length <= actions.length := by
                have actionsLength :=
                  congrArg List.length lowerEndpoint.actions_eq
                simp at actionsLength
                omega
              have lowerMeasure :
                  lowerState.currentTerm lowerLeader * weight +
                      lowerEndpoint.pastActions.length <
                    measure := by
                have targetTerm :
                    election.electionState.currentTerm historicalLeader =
                      leaderState.currentTerm historicalLeader :=
                  election.term_eq.symm
                have lowerThanTarget :
                    lowerState.currentTerm lowerLeader <
                      leaderState.currentTerm historicalLeader :=
                  lowerThanCandidate.trans_eq targetTerm
                have lowerPastLtWeight :
                    lowerEndpoint.pastActions.length < weight := by
                  dsimp [weight]
                  exact Nat.lt_succ_of_le lowerPastBound
                calc
                  lowerState.currentTerm lowerLeader * weight +
                        lowerEndpoint.pastActions.length <
                      lowerState.currentTerm lowerLeader * weight +
                        weight :=
                    Nat.add_lt_add_left lowerPastLtWeight _
                  _ =
                      (lowerState.currentTerm lowerLeader + 1) *
                        weight := by
                    simp [Nat.add_mul]
                  _ <=
                      leaderState.currentTerm historicalLeader * weight :=
                    Nat.mul_le_mul_right
                      weight
                      (Nat.succ_le_iff.mpr lowerThanTarget)
                  _ <=
                      leaderState.currentTerm historicalLeader * weight +
                        leaderEndpoint.pastActions.length :=
                    Nat.le_add_right _ _
                  _ = measure := measureEq
              exact
                inductionHypothesis
                  (lowerState.currentTerm lowerLeader * weight +
                    lowerEndpoint.pastActions.length)
                  lowerMeasure
                  lowerState
                  lowerEndpoint
                  lowerLeader
                  lowerRole
                  lowerHigher
                  rfl
            have earlierTermLeaders :
                forall earlierState,
                  StateAt
                      start
                      electionEndpoint.pastActions
                      election.electionState
                      earlierState ->
                    forall earlierLeader : Node,
                      earlierState.leadershipState earlierLeader = .leader ->
                        state.currentTerm leader <
                            earlierState.currentTerm earlierLeader ->
                          earlierState.currentTerm earlierLeader <=
                              election.electionState.currentTerm
                                historicalLeader ->
                            isLogPrefix
                              (logPrefix
                                (state.log leader)
                                (highestCommittableIndex state leader))
                              (earlierState.log earlierLeader) := by
              intro earlierState earlierAt earlierLeader earlierRole
                earlierHigher earlierAtMostCandidate
              rcases earlierAt with ⟨earlierLocal⟩
              let earlierEndpoint :
                  StateAtWitness start actions state earlierState :=
                {
                  pastActions := earlierLocal.pastActions
                  futureActions :=
                    earlierLocal.futureActions ++
                      electionEndpoint.futureActions
                  actions_eq := by
                    calc
                      actions =
                          electionEndpoint.pastActions ++
                            electionEndpoint.futureActions :=
                        electionEndpoint.actions_eq
                      _ =
                          (earlierLocal.pastActions ++
                            earlierLocal.futureActions) ++
                              electionEndpoint.futureActions := by
                        exact
                          congrArg
                            (fun xs => xs ++ electionEndpoint.futureActions)
                            earlierLocal.actions_eq
                      _ =
                          earlierLocal.pastActions ++
                            (earlierLocal.futureActions ++
                              electionEndpoint.futureActions) := by
                        simp only [List.append_assoc]
                  stateHistory := earlierLocal.stateHistory
                  remainingHistory :=
                    replays_append
                      earlierLocal.remainingHistory
                      electionEndpoint.remainingHistory
                }
              have earlierBeforeLeader :
                  earlierEndpoint.pastActions.length <
                    leaderEndpoint.pastActions.length := by
                have earlierBeforeElection :
                    earlierEndpoint.pastActions.length <=
                      electionEndpoint.pastActions.length := by
                  have actionsLength :=
                    congrArg List.length earlierLocal.actions_eq
                  dsimp [earlierEndpoint]
                  simp at actionsLength
                  omega
                exact earlierBeforeElection.trans_lt electionBeforeLeader
              have earlierMeasure :
                  earlierState.currentTerm earlierLeader * weight +
                      earlierEndpoint.pastActions.length <
                    measure := by
                have targetTerm :
                    election.electionState.currentTerm historicalLeader =
                      leaderState.currentTerm historicalLeader :=
                  election.term_eq.symm
                rw [targetTerm] at earlierAtMostCandidate
                dsimp [weight]
                by_cases termStrict :
                    earlierState.currentTerm earlierLeader <
                      leaderState.currentTerm historicalLeader
                · have earlierPastBound :
                      earlierEndpoint.pastActions.length <= actions.length := by
                    have actionsLength :=
                      congrArg List.length earlierEndpoint.actions_eq
                    simp at actionsLength
                    omega
                  have earlierPastLtWeight :
                      earlierEndpoint.pastActions.length < weight := by
                    dsimp [weight]
                    exact Nat.lt_succ_of_le earlierPastBound
                  calc
                    earlierState.currentTerm earlierLeader * weight +
                          earlierEndpoint.pastActions.length <
                        earlierState.currentTerm earlierLeader * weight +
                          weight :=
                      Nat.add_lt_add_left earlierPastLtWeight _
                    _ =
                        (earlierState.currentTerm earlierLeader + 1) *
                          weight := by
                      simp [Nat.add_mul]
                    _ <=
                        leaderState.currentTerm historicalLeader * weight :=
                      Nat.mul_le_mul_right
                        weight
                        (Nat.succ_le_iff.mpr termStrict)
                    _ <=
                        leaderState.currentTerm historicalLeader * weight +
                          leaderEndpoint.pastActions.length :=
                      Nat.le_add_right _ _
                    _ = measure := measureEq
                · have termEq :
                      earlierState.currentTerm earlierLeader =
                        leaderState.currentTerm historicalLeader := by
                    omega
                  rw [termEq]
                  exact
                    (Nat.add_lt_add_left
                      earlierBeforeLeader
                      (leaderState.currentTerm historicalLeader * weight)).trans_eq
                        measureEq
              exact
                inductionHypothesis
                  (earlierState.currentTerm earlierLeader * weight +
                    earlierEndpoint.pastActions.length)
                  earlierMeasure
                  earlierState
                  earlierEndpoint
                  earlierLeader
                  earlierRole
                  earlierHigher
                  rfl
            have candidateCarries :=
              advanceCommitIndex_countedCandidate_carries_boundary
                history
                core
                enabled
                boundary
                commitBefore
                (Nat.le_refl _)
                electionEndpoint
                lowerTermLeaders
                earlierTermLeaders
                electionEnabledFacts.1.2
                (higherTerm.trans_eq election.term_eq)
                electionEnabledFacts.2
            have afterElectionCarries :
                isLogPrefix
                  (logPrefix
                    (state.log leader)
                    (highestCommittableIndex state leader))
                  ((next election.electionState
                    (.becomeLeader historicalLeader)).log
                      historicalLeader) := by
              simpa [next, rawNext, nextBecomeLeader] using
                signatureLogPrefix_committable
                  (by
                    simpa [next, rawNext, nextAdvanceCommitIndex] using
                      boundary.2.2)
                  candidateCarries
            exact
              afterElectionCarries.trans
                ((protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
                  leaderEndpoint.stateHistory)
                  (next election.electionState
                    (.becomeLeader historicalLeader))
                  (occurs_after_stateAt ⟨electionOccurrence⟩)
                  historicalLeader
                  (by simp [next, rawNext, nextBecomeLeader])
                  historicalLeaderRole
                  (by
                    simpa [next, rawNext, nextBecomeLeader] using
                      election.term_eq.symm))
  intro leaderState leaderAt historicalLeader historicalLeaderRole higherTerm
  rcases leaderAt with ⟨leaderEndpoint⟩
  exact
    carryByMeasure
      (leaderState.currentTerm historicalLeader * weight +
        leaderEndpoint.pastActions.length)
      leaderState
      leaderEndpoint
      historicalLeader
      historicalLeaderRole
      higherTerm
      rfl

private structure AdvanceCommitPendingChoiceTemporalCore
    (start : InitialConfiguration)
    (actions : List Action)
    (state : State)
    (leader : Node) : Prop where
  higher_term_leaders :
    forall leaderState,
      StateAt start actions state leaderState ->
        forall historicalLeader : Node,
          leaderState.leadershipState historicalLeader = .leader ->
            state.currentTerm leader <
                leaderState.currentTerm historicalLeader ->
              isLogPrefix
                (logPrefix
                  (state.log leader)
                  (highestCommittableIndex state leader))
                (leaderState.log historicalLeader)
  counted_candidate_barrier :
    forall candidateState,
      StateAt start actions state candidateState ->
        forall candidate : Node,
          candidateState.leadershipState candidate = .candidate ->
            state.currentTerm leader <
                candidateState.currentTerm candidate ->
              allConfigurationsHaveQuorum
                  (candidateState.votesGranted candidate)
                  (candidateState.configurations candidate) =
                true ->
                isLogPrefix
                  (logPrefix
                    (state.log leader)
                    (highestCommittableIndex state leader))
                  (candidateState.log candidate)
  potential_candidate_barrier :
    forall candidateState,
      StateAt start actions state candidateState ->
        forall candidate : Node,
          candidateState.leadershipState candidate = .candidate ->
            state.currentTerm leader <
                candidateState.currentTerm candidate ->
              PotentialCandidateQuorum candidateState candidate ->
                isLogPrefix
                  (logPrefix
                    (state.log leader)
                    (highestCommittableIndex state leader))
                  (candidateState.log candidate)

private theorem advanceCommitIndex_pendingChoice_temporalCore
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader)) :
    AdvanceCommitPendingChoiceTemporalCore
      start actions state leader := by
  have leaders :=
    advanceCommitIndex_pendingChoice_higherTermLeaders
      history core enabled
  have boundary := advanceCommitIndex_highest_boundary enabled
  have commitBefore :
      state.commitIndex leader <
        highestCommittableIndex state leader := by
    have enabledFacts := enabled
    simp [Enabled, actionEnabled] at enabledFacts
    omega
  refine
    {
      higher_term_leaders := leaders
      counted_candidate_barrier := ?_
      potential_candidate_barrier := ?_
    }
  · intro candidateState candidateAt candidate
      candidateRole higherTerm candidateQuorum
    rcases candidateAt with ⟨candidateEndpoint⟩
    exact
      advanceCommitIndex_countedCandidate_carries_boundary
        history
        core
        enabled
        boundary
        commitBefore
        (Nat.le_refl _)
        candidateEndpoint
        (by
          intro leaderState leaderAt historicalLeader
            leaderRole term _upper
          exact
            leaders
              leaderState leaderAt historicalLeader leaderRole term)
        (by
          intro leaderState leaderAt historicalLeader
            leaderRole term _upper
          exact
            leaders
              leaderState
              (stateAt_extend_stateAtWitness
                candidateEndpoint leaderAt)
              historicalLeader
              leaderRole
              term)
        candidateRole
        higherTerm
        candidateQuorum
  · intro candidateState candidateAt candidate
      candidateRole higherTerm candidateQuorum
    rcases candidateAt with ⟨candidateEndpoint⟩
    exact
      advanceCommitIndex_potentialCandidate_carries_boundary
        history
        core
        enabled
        boundary
        commitBefore
        (Nat.le_refl _)
        candidateEndpoint
        (by
          intro leaderState leaderAt historicalLeader
            leaderRole term _upper
          exact
            leaders
              leaderState leaderAt historicalLeader leaderRole term)
        (by
          intro leaderState leaderAt historicalLeader
            leaderRole term _upper
          exact
            leaders
              leaderState
              (stateAt_extend_stateAtWitness
                candidateEndpoint leaderAt)
              historicalLeader
              leaderRole
              term)
        candidateRole
        higherTerm
        candidateQuorum

theorem advanceCommitIndex_higherTermLeaders_of_countedCandidateBarrier
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (countedCandidateBarrier :
      forall candidateState,
        StateAt
            start
            (actions ++ [.advanceCommitIndex leader])
            (next state (.advanceCommitIndex leader))
            candidateState ->
          forall candidate : Node,
            candidateState.leadershipState candidate = .candidate ->
              state.currentTerm leader <
                  candidateState.currentTerm candidate ->
                allConfigurationsHaveQuorum
                    (candidateState.votesGranted candidate)
                    (candidateState.configurations candidate) =
                  true ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (candidateState.log candidate)) :
    forall leaderState,
      StateAt
          start
          (actions ++ [.advanceCommitIndex leader])
          (next state (.advanceCommitIndex leader))
          leaderState ->
        forall historicalLeader : Node,
          leaderState.leadershipState historicalLeader = .leader ->
            state.currentTerm leader <
                leaderState.currentTerm historicalLeader ->
              isLogPrefix
                (logPrefix (state.log leader) index)
                (leaderState.log historicalLeader) := by
  intro leaderState leaderStateAt historicalLeader historicalLeaderRole
    higherTerm
  rcases leaderStateAt with ⟨leaderStateWitness⟩
  have leaderOrigins :=
    protocolHistory_implies_LeaderHistoryConsistent
      leaderStateWitness.stateHistory
  rcases
      leaderOrigins historicalLeader historicalLeaderRole with
    ⟨origin⟩
  cases origin with
  | initial leaderEq termEq =>
      have enabledFacts := enabled
      simp [Enabled, actionEnabled] at enabledFacts
      have minimum :=
        protocolHistory_implies_MinimumTermInv history
      have choiceAfterStart :
          startTerm <= state.currentTerm leader :=
        minimum.activeRoles leader (by simp [enabledFacts.1])
      rw [termEq] at higherTerm
      omega
  | elected election =>
      rcases election.occurrence with ⟨electionOccurrence⟩
      have electionEnabled := electionOccurrence.enabled
      have electionEnabledFacts := electionEnabled
      simp [Enabled, actionEnabled] at electionEnabledFacts
      have electionAtLeader :
          StateAt
            start
            leaderStateWitness.pastActions
            leaderState
            election.electionState :=
        occurs_before_stateAt ⟨electionOccurrence⟩
      have electionAt :
          StateAt
            start
            (actions ++ [.advanceCommitIndex leader])
            (next state (.advanceCommitIndex leader))
            election.electionState :=
        stateAt_extend_stateAtWitness
          leaderStateWitness electionAtLeader
      have electionHigher :
          state.currentTerm leader <
            election.electionState.currentTerm historicalLeader := by
        exact higherTerm.trans_eq election.term_eq
      have candidateCarries :=
        countedCandidateBarrier
          election.electionState
          electionAt
          historicalLeader
          electionEnabledFacts.1.2
          electionHigher
          electionEnabledFacts.2
      have boundaryAtState :
          (entryAt? (state.log leader) index).map (·.content) =
            some .signature := by
        simpa [next, rawNext, nextAdvanceCommitIndex] using
          boundary.2.2
      have afterElectionCarries :
          isLogPrefix
            (logPrefix (state.log leader) index)
            ((next election.electionState
              (.becomeLeader historicalLeader)).log
                historicalLeader) := by
        simpa [next, rawNext, nextBecomeLeader] using
          signatureLogPrefix_committable
            boundaryAtState candidateCarries
      have afterElectionAtLeader :
          StateAt
            start
            leaderStateWitness.pastActions
            leaderState
            (next election.electionState
              (.becomeLeader historicalLeader)) :=
        occurs_after_stateAt ⟨electionOccurrence⟩
      have afterElectionRole :
          (next election.electionState
              (.becomeLeader historicalLeader)).leadershipState
                historicalLeader =
            .leader := by
        simp [next, rawNext, nextBecomeLeader]
      have afterElectionTerm :
          (next election.electionState
              (.becomeLeader historicalLeader)).currentTerm
                historicalLeader =
            leaderState.currentTerm historicalLeader := by
        simpa [next, rawNext, nextBecomeLeader] using
          election.term_eq.symm
      have electionLogRetained :=
        (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
          leaderStateWitness.stateHistory)
          (next election.electionState
            (.becomeLeader historicalLeader))
          afterElectionAtLeader
          historicalLeader
          afterElectionRole
          historicalLeaderRole
          afterElectionTerm
      exact afterElectionCarries.trans electionLogRetained

private theorem advanceCommitIndex_staleMatch_support_retained
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader member : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (countedCandidateBarrier :
      forall candidateState,
        StateAt
            start
            (actions ++ [.advanceCommitIndex leader])
            (next state (.advanceCommitIndex leader))
            candidateState ->
          forall candidate : Node,
            candidateState.leadershipState candidate = .candidate ->
              state.currentTerm leader <
                  candidateState.currentTerm candidate ->
                allConfigurationsHaveQuorum
                    (candidateState.votesGranted candidate)
                    (candidateState.configurations candidate) =
                  true ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (candidateState.log candidate))
    (current :
      CurrentTermMatchIndexWitness
        start actions state leader member)
    (indexLeMatch :
      highestCommittableIndex state leader <=
        state.matchIndex leader member)
    (stale :
      state.currentTerm leader <
        (next state
          (.advanceCommitIndex leader)).currentTerm member) :
    isLogPrefix
      (logPrefix (state.log leader) index)
      ((next state (.advanceCommitIndex leader)).log member) := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have leaderState : state.leadershipState leader = .leader :=
    enabledFacts.1.2
  let support :
      ChoiceSupportWitness
        start
        (actions ++ [.advanceCommitIndex leader])
        (next state (.advanceCommitIndex leader))
        state
        leader
        member
        (highestCommittableIndex state leader)
        (state.currentTerm leader) :=
    {
      choiceActions := actions
      choice_history := history
      choice_actions_prefix := ⟨[.advanceCommitIndex leader], rfl⟩
      matchWitness := current.witness
      index_le_ack := indexLeMatch.trans_eq current.witness.index_eq
      response_term := current.response_term
    }
  rcases
      advanceCommitIndex_choiceSupport_acknowledges_choiceIndexPrefix
        leaderState
        support
        core.electionLogs.counted.logs.logMatching with
    ⟨strongAck, choiceIndexAcknowledged⟩
  have boundaryAtState :
      (entryAt? (state.log leader) index).map (·.content) =
        some .signature := by
    simpa [next, rawNext, nextAdvanceCommitIndex] using boundary.2.2
  have nextHistory :=
    replays_append_singleton history enabled
  let stateAt :
      StateAtWitness
        start
        (actions ++ [.advanceCommitIndex leader])
        (next state (.advanceCommitIndex leader))
        state :=
    {
      pastActions := actions
      futureActions := [.advanceCommitIndex leader]
      actions_eq := rfl
      stateHistory := history
      remainingHistory := ⟨enabled, rfl⟩
    }
  have fullHigherTermLeaders :=
    advanceCommitIndex_higherTermLeaders_of_countedCandidateBarrier
      history enabled boundary countedCandidateBarrier
  have higherTermLeadersAtChoice :
      forall leaderState,
        StateAt start actions state leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (leaderState.log historicalLeader) := by
    intro leaderState leaderStateAt historicalLeader
      historicalLeaderRole higherTerm
    exact
      fullHigherTermLeaders
        leaderState
        (stateAt_extend_stateAtWitness stateAt leaderStateAt)
        historicalLeader
        historicalLeaderRole
        higherTerm
  have leaderUniqueness :=
    completeSafetyCore_implies_leaderUniqueness history core
  have sameLeaderPrefixes :=
    protocolHistory_implies_HistoricalSameLeaderLogPrefixInv history
  have leaderNeMember : leader ≠ member := by
    rcases strongAck.send_occurrence with ⟨sendOccurrence⟩
    have sendEnabled := sendOccurrence.enabled
    simp [Enabled, actionEnabled] at sendEnabled
    exact sendEnabled.1.1.1.2
  let acknowledgedPrefix :=
    logPrefix
      ((next strongAck.ack.origin.responseState
        (.receive
          member
          leader
          strongAck.ack.origin.kind.receiveKind)).log member)
      current.witness.lastLogIndex
  have chosenToAcknowledged :
      isLogPrefix
        (logPrefix (state.log leader) index)
        acknowledgedPrefix := by
    exact
      (logPrefix_mono_isLogPrefix
        (state.log leader)
        index
        (highestCommittableIndex state leader)
        indexWithin).trans
        (by
          simpa [support, acknowledgedPrefix] using
            choiceIndexAcknowledged)
  rcases occurs_after_stateAt strongAck.ack.origin.occurrence with
    ⟨responseAfterAt⟩
  have extend :
      forall
        (past suffix : List Action)
        (before : State),
        actions = past ++ suffix ->
          ProtocolHistory start past before ->
            Replays before suffix state ->
              (Or
                (And
                  (before.currentTerm member =
                    state.currentTerm leader)
                  (isLogPrefix
                    acknowledgedPrefix
                    (before.log member)))
                (And
                  (state.currentTerm leader <
                    before.currentTerm member)
                  (isLogPrefix
                    (logPrefix (state.log leader) index)
                    (before.log member)))) ->
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (state.log member) := by
    intro past suffix
    induction suffix generalizing past with
    | nil =>
        intro before _actionsEq _pastHistory replay retained
        simp [Replays] at replay
        subst before
        rcases retained with equalMode | higherMode
        · have finalStale :
              state.currentTerm leader <
                state.currentTerm member := by
            simpa [next, rawNext, nextAdvanceCommitIndex] using stale
          omega
        · exact higherMode.2
    | cons nextAction tail inductionHypothesis =>
        intro before actionsEq pastHistory replay retained
        rcases replay with ⟨nextEnabled, tailReplay⟩
        have nextHistory :=
          replays_append_singleton pastHistory nextEnabled
        have beforeAt :
            StateAt start actions state before :=
          ⟨{
            pastActions := past
            futureActions := nextAction :: tail
            actions_eq := actionsEq
            stateHistory := pastHistory
            remainingHistory := ⟨nextEnabled, tailReplay⟩
          }⟩
        have nextAt :
            StateAt start actions state (next before nextAction) :=
          ⟨{
            pastActions := past ++ [nextAction]
            futureActions := tail
            actions_eq := by
              simpa only [List.append_assoc, List.singleton_append] using
                actionsEq
            stateHistory := nextHistory
            remainingHistory := tailReplay
          }⟩
        have nextRetained :
            Or
              (And
                ((next before nextAction).currentTerm member =
                  state.currentTerm leader)
                (isLogPrefix
                  acknowledgedPrefix
                  ((next before nextAction).log member)))
              (And
                (state.currentTerm leader <
                  (next before nextAction).currentTerm member)
                (isLogPrefix
                  (logPrefix (state.log leader) index)
                  ((next before nextAction).log member))) := by
          rcases retained with equalMode | higherMode
          · have termStep :=
              monotonicTerm_step before nextAction nextEnabled member
            by_cases nextEqual :
                (next before nextAction).currentTerm member =
                  state.currentTerm leader
            · exact Or.inl
                ⟨nextEqual,
                  by
                    have retainedAck :=
                      successfulAckPrefix_step
                        history
                        beforeAt
                        nextAt
                        sameLeaderPrefixes
                        leaderUniqueness
                        strongAck
                        leaderState
                        (by simpa [support] using support.response_term)
                        leaderNeMember
                        equalMode.1
                        nextEqual
                        (by
                          simpa [acknowledgedPrefix] using equalMode.2)
                        nextEnabled
                    simpa [acknowledgedPrefix] using retainedAck⟩
            · have nextHigher :
                  state.currentTerm leader <
                    (next before nextAction).currentTerm member := by
                omega
              have termIncreased :
                  before.currentTerm member <
                    (next before nextAction).currentTerm member := by
                omega
              have logUnchanged :=
                currentTermIncrease_log_unchanged
                  before nextAction member termIncreased
              exact Or.inr
                ⟨nextHigher,
                  (chosenToAcknowledged.trans equalMode.2).trans
                    (by rw [logUnchanged])⟩
          · have retainedHigher :=
              higherTermSignaturePrefix_step
                beforeAt
                higherTermLeadersAtChoice
                boundaryAtState
                higherMode.1
                higherMode.2
                nextEnabled
            have nextHigher :
                state.currentTerm leader <
                  (next before nextAction).currentTerm member :=
              higherMode.1.trans_le
                (monotonicTerm_step
                  before nextAction nextEnabled member)
            exact Or.inr ⟨nextHigher, retainedHigher⟩
        exact
          inductionHypothesis
            (past ++ [nextAction])
            (next before nextAction)
            (by
              simpa only [List.append_assoc, List.singleton_append] using
                actionsEq)
            nextHistory
            tailReplay
            nextRetained
  have initialMode :
      Or
        (And
          ((next strongAck.ack.origin.responseState
              (.receive
                member
                leader
                strongAck.ack.origin.kind.receiveKind)).currentTerm
              member =
            state.currentTerm leader)
          (isLogPrefix
            acknowledgedPrefix
            ((next strongAck.ack.origin.responseState
              (.receive
                member
                leader
                strongAck.ack.origin.kind.receiveKind)).log member)))
        (And
          (state.currentTerm leader <
            (next strongAck.ack.origin.responseState
              (.receive
                member
                leader
                strongAck.ack.origin.kind.receiveKind)).currentTerm member)
          (isLogPrefix
            (logPrefix (state.log leader) index)
            ((next strongAck.ack.origin.responseState
              (.receive
                member
                leader
                strongAck.ack.origin.kind.receiveKind)).log member))) :=
    Or.inl
      ⟨strongAck.ack.response_term.symm.trans current.response_term,
        logPrefix_isLogPrefix _ _⟩
  have retainedAtChoice :=
    extend
      responseAfterAt.pastActions
      responseAfterAt.futureActions
      (next strongAck.ack.origin.responseState
        (.receive
          member
          leader
          strongAck.ack.origin.kind.receiveKind))
      responseAfterAt.actions_eq
      responseAfterAt.stateHistory
      responseAfterAt.remainingHistory
      initialMode
  simpa [next, rawNext, nextAdvanceCommitIndex] using retainedAtChoice

theorem advanceCommitIndex_staleWatermarkMember_retained
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader member : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (countedCandidateBarrier :
      forall candidateState,
        StateAt
            start
            (actions ++ [.advanceCommitIndex leader])
            (next state (.advanceCommitIndex leader))
            candidateState ->
          forall candidate : Node,
            candidateState.leadershipState candidate = .candidate ->
              state.currentTerm leader <
                  candidateState.currentTerm candidate ->
                allConfigurationsHaveQuorum
                    (candidateState.votesGranted candidate)
                    (candidateState.configurations candidate) =
                  true ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (candidateState.log candidate))
    (indexLeMatch :
      highestCommittableIndex state leader <=
        state.matchIndex leader member)
    (stale :
      state.currentTerm leader <
        (next state
          (.advanceCommitIndex leader)).currentTerm member) :
    isLogPrefix
      (logPrefix (state.log leader) index)
      ((next state (.advanceCommitIndex leader)).log member) := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have highestPositive :
      0 < highestCommittableIndex state leader := by
    omega
  have matchPositive :
      0 < state.matchIndex leader member :=
    highestPositive.trans_le indexLeMatch
  rcases
      protocolHistory_implies_CurrentTermMatchIndexHistoryConsistent
        history
        leader
        member
        enabledFacts.1.2
        matchPositive with
    ⟨current⟩
  exact
    advanceCommitIndex_staleMatch_support_retained
      history
      core
      enabled
      indexWithin
      boundary
