private theorem chosenCommitCertificate_rebase_boundary
    {start : InitialConfiguration}
    {actions : List Action}
    {endState firstBoundaryState secondBoundaryState : State}
    {firstOwner secondOwner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState firstBoundaryState firstOwner index)
    (secondBoundaryAt :
      StateAt
        start actions endState secondBoundaryState)
    (_secondBoundary :
      SignatureCommitBoundary
        secondBoundaryState secondOwner index)
    (prefixEq :
      logPrefix (secondBoundaryState.log secondOwner) index =
        logPrefix (firstBoundaryState.log firstOwner) index)
    (choiceTermLe :
      certificate.choiceTerm <=
        secondBoundaryState.currentTerm secondOwner) :
    Exists fun rebased :
        ChosenCommitCertificate
          start actions endState
          secondBoundaryState secondOwner index =>
      ChosenCommitCertificateChoiceIdentity certificate rebased := by
  cases firstAt :
      entryAt? (firstBoundaryState.log firstOwner) index with
  | none =>
      have impossible := certificate.boundary_term
      simp [firstAt] at impossible
  | some firstEntry =>
      have firstEntryTerm :
          firstEntry.term = certificate.boundaryTerm := by
        simpa [firstAt] using certificate.boundary_term
      have secondAt :
          entryAt? (secondBoundaryState.log secondOwner) index =
            some firstEntry :=
        entryAt?_eq_of_logPrefix_eq firstAt prefixEq.symm
      let rebased :
          ChosenCommitCertificate
            start actions endState
            secondBoundaryState secondOwner index :=
        {
          boundary_at := secondBoundaryAt
          boundaryTerm := certificate.boundaryTerm
          boundary_term := by
            simp [secondAt, firstEntryTerm]
          choiceTerm := certificate.choiceTerm
          choiceState := certificate.choiceState
          choiceLeader := certificate.choiceLeader
          choice_at := certificate.choice_at
          choice_leader := certificate.choice_leader
          choice_term := certificate.choice_term
          choice_term_le_boundary_owner := choiceTermLe
          choiceIndex := certificate.choiceIndex
          choice_origin := certificate.choice_origin
          choice_commit_le_boundary :=
            certificate.choice_commit_le_boundary
          choice_progress := certificate.choice_progress
          boundary_le_choice := certificate.boundary_le_choice
          boundary_term_le_choice :=
            certificate.boundary_term_le_choice
          chosenPrefix := certificate.chosenPrefix
          prefix_eq := certificate.prefix_eq.trans prefixEq.symm
          choice_prefix_eq := certificate.choice_prefix_eq
          choiceIndexPrefix := certificate.choiceIndexPrefix
          choice_index_prefix_eq :=
            certificate.choice_index_prefix_eq
          choice_index_entry := certificate.choice_index_entry
          boundary_prefix_le_choice_prefix :=
            certificate.boundary_prefix_le_choice_prefix
          configuration := certificate.configuration
          configuration_at := by
            rw [committedConfigurationAt?_eq_of_logPrefix_eq
              (secondBoundaryState.log secondOwner)
              (firstBoundaryState.log firstOwner)
              index
              prefixEq]
            exact certificate.configuration_at
          configuration_le_choice :=
            certificate.configuration_le_choice
          quorum := certificate.quorum
          quorum_ok := certificate.quorum_ok
          support_retained := certificate.support_retained
          watermark_support := certificate.watermark_support
          watermark_causal_support :=
            certificate.watermark_causal_support
          counted_candidate_barrier :=
            certificate.counted_candidate_barrier
          potential_candidate_barrier :=
            certificate.potential_candidate_barrier
          higher_term_leaders := certificate.higher_term_leaders
        }
      exact
        ⟨rebased,
          {
            boundaryTerm_eq := rfl
            choiceTerm_eq := rfl
            choiceState_eq := rfl
            choiceLeader_eq := rfl
            choiceIndex_eq := rfl
            chosenPrefix_eq := rfl
            choiceIndexPrefix_eq := rfl
            configuration_eq := rfl
          }⟩

private theorem appendEntriesAccept_sendTerm_eq_destTerm
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {dest source : Node}
    {kind : ReceiveKind}
    {message : Message}
    (head :
      headMessage? state dest source = some message)
