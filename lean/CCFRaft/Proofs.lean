private def initialChosenCommitCertificate
    (start : InitialConfiguration) :
    forall owner,
      owner ∈ start.nodes ->
    ChosenCommitCertificate
      start
      []
      (initialState start)
      (initialState start)
      owner
      2 := by
  intro owner ownerMember
  have initialAt :
      StateAt
        start [] (initialState start) (initialState start) :=
    protocolHistory_final_stateAt (by rfl)
  exact {
    boundary_at := initialAt
    boundaryTerm := startTerm
    boundary_term := by
      simp [initialState, startLog, entryAt?, ownerMember]
    choiceTerm := startTerm
    choiceState := initialState start
    choiceLeader := start
    choice_at := initialAt
    choice_leader := by simp [initialState, start.leader_mem]
    choice_term := by simp [initialState, start.leader_mem]
    choice_term_le_boundary_owner := by
      simp [initialState, ownerMember]
    choiceIndex := 2
    choice_origin := .initial rfl rfl rfl
    choice_commit_le_boundary := by
      simp [initialState, startLog, start.leader_mem]
    choice_progress := Or.inl trivial
    boundary_le_choice := by
      simp [initialState, ownerMember]
    boundary_term_le_choice := Nat.le_refl _
    chosenPrefix := startLog start
    prefix_eq := by
      simp [initialState, startLog, logPrefix, ownerMember]
    choice_prefix_eq := by
      simp [initialState, startLog, logPrefix, start.leader_mem]
    choiceIndexPrefix := startLog start
    choice_index_prefix_eq := by
      simp [initialState, startLog, logPrefix, start.leader_mem]
    choice_index_entry := by
      simp [initialState, startLog, entryAt?, start.leader_mem]
    boundary_prefix_le_choice_prefix := List.prefix_rfl
    configuration := { index := 1, nodes := start.nodes }
    configuration_at := by
      simpa [initialState, ownerMember] using
        committedConfigurationAt?_startLog start
    configuration_le_choice := by
      change (1 : Nat) <= 2
      omega
    quorum := start.nodes
    quorum_ok := by
      simp [isQuorum]
      have positive : 0 < start.nodes.card :=
        Finset.card_pos.mpr ⟨start.leader, start.leader_mem⟩
      omega
    support_retained := by
      intro member memberInQuorum
      simp [initialState, memberInQuorum, isLogPrefix]
    watermark_support := by
      intro activeConfiguration activeMember _indexBound
      simp [initialState, start.leader_mem] at activeMember
      subst activeConfiguration
      refine ⟨start.nodes, ?_, ?_⟩
      · simp [isQuorum]
        have positive : 0 < start.nodes.card :=
          Finset.card_pos.mpr ⟨start.leader, start.leader_mem⟩
        omega
      intro member memberInQuorum
      simp [initialState, memberInQuorum, isLogPrefix]
    watermark_causal_support := by
      intro activeConfiguration activeMember _indexBound
      simp [initialState, start.leader_mem] at activeMember
      subst activeConfiguration
      refine ⟨start.nodes, ?_, ?_⟩
      · simp [isQuorum]
        have positive : 0 < start.nodes.card :=
          Finset.card_pos.mpr ⟨start.leader, start.leader_mem⟩
        omega
      intro member memberInQuorum
      right
      left
      exact ⟨trivial, memberInQuorum⟩
    counted_candidate_barrier := by
      intro candidateState candidateAt candidate candidateStateCandidate
        _higherTerm _quorum
      rw [stateAt_initial_eq candidateAt] at candidateStateCandidate
      by_cases member : candidate ∈ start.nodes
      · by_cases same : candidate = start.leader <;>
          simp [initialState, member, same, start.leader_mem] at candidateStateCandidate
      · simp [initialState, member] at candidateStateCandidate
    potential_candidate_barrier := by
      intro candidateState candidateAt candidate candidateStateCandidate
        _higherTerm _quorum
      rw [stateAt_initial_eq candidateAt] at candidateStateCandidate
      by_cases member : candidate ∈ start.nodes
      · by_cases same : candidate = start.leader <;>
          simp [initialState, member, same, start.leader_mem] at candidateStateCandidate
      · simp [initialState, member] at candidateStateCandidate
    higher_term_leaders := by
      intro leaderState leaderAt leader leaderStateLeader higherTerm
      rw [stateAt_initial_eq leaderAt] at leaderStateLeader higherTerm
      have leaderMember : leader ∈ start.nodes := by
        by_contra notMem
        simp [initialState, notMem] at leaderStateLeader
      have leaderIsStart : leader = start := by
        simpa [initialState, leaderMember] using leaderStateLeader
      subst leader
      simp [initialState, start.leader_mem] at higherTerm
  }

theorem initial_HistoricalChosenCommitCore
    (start : InitialConfiguration) :
    HistoricalChosenCommitCore
      start [] (initialState start) := by
  intro boundaryState boundaryAt owner index boundary
  have boundaryStateEq := stateAt_initial_eq boundaryAt
  subst boundaryState
  rcases boundary with ⟨positive, withinCommit, signature⟩
  by_cases ownerMember : owner ∈ start.nodes
  ·
    have withinTwo : index <= 2 := by
      simpa [initialState, startLog, ownerMember] using withinCommit
    have indexCases : index = 1 ∨ index = 2 := by
      omega
    rcases indexCases with indexOne | indexTwo
    · subst index
      simp [initialState, startLog, entryAt?, ownerMember] at signature
    · subst index
      exact ⟨initialChosenCommitCertificate start owner ownerMember⟩
  · have zeroCommit :
        (initialState start).commitIndex owner = 0 := by
      simp [initialState, ownerMember]
    rw [zeroCommit] at withinCommit
    omega

