    (acceptKind :
      Or
        (kind = .appendEntriesAlreadyDone)
        (Or
          (kind = .appendEntriesNoConflict)
          (Or
            (kind = .appendEntriesConflictThenAlreadyDone)
            (kind = .appendEntriesConflictThenNoConflict))))
    (enabled : Enabled state (.receive dest source kind)) :
    send.sendState.currentTerm source =
      (next state (.receive dest source kind)).currentTerm dest := by
  have sendTermAtReceiver :
      send.sendState.currentTerm source =
        state.currentTerm dest := by
    rcases acceptKind with
      alreadyDone | noConflict | conflictAlreadyDone | conflictNoConflict
    · subst kind
      have enabledFacts := enabled
      simp [Enabled, actionEnabled, head,
        receiveBranchEnabled, send.message_eq,
        appendEntriesMessage] at enabledFacts
      have accept := enabledFacts.2.1
      simp [appendEntriesAcceptBase] at accept
      exact accept.1.1.1
    · subst kind
      have enabledFacts := enabled
      simp [Enabled, actionEnabled, head,
        receiveBranchEnabled, send.message_eq,
        appendEntriesMessage] at enabledFacts
      have accept := enabledFacts.2.1
      simp [appendEntriesAcceptBase] at accept
      exact accept.1.1.1
    · subst kind
      have enabledFacts := enabled
      simp [Enabled, actionEnabled, head,
        receiveBranchEnabled, send.message_eq,
        appendEntriesMessage] at enabledFacts
      have accept := enabledFacts.2.1.1
      simp [appendEntriesAcceptBase] at accept
      exact accept.1.1.1
    · subst kind
      have enabledFacts := enabled
      simp [Enabled, actionEnabled, head,
        receiveBranchEnabled, send.message_eq,
        appendEntriesMessage] at enabledFacts
      have accept := enabledFacts.2.1.1
      simp [appendEntriesAcceptBase] at accept
      exact accept.1.1.1
  rcases acceptKind with
    alreadyDone | noConflict | conflictAlreadyDone | conflictNoConflict
  · subst kind
    simpa [next, rawNext, nextReceive, head,
      send.message_eq, appendEntriesMessage] using sendTermAtReceiver
  · subst kind
    simpa [next, rawNext, nextReceive, head,
      send.message_eq, appendEntriesMessage] using sendTermAtReceiver
  · subst kind
    simpa [next, rawNext, nextReceive, head,
      send.message_eq, appendEntriesMessage] using sendTermAtReceiver
  · subst kind
    simpa [next, rawNext, nextReceive, head,
      send.message_eq, appendEntriesMessage] using sendTermAtReceiver

theorem appendEntriesAccept_chosenCommitCertificate_transport
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {dest source : Node}
    {kind : ReceiveKind}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (acceptKind :
      Or
        (kind = .appendEntriesAlreadyDone)
        (Or
          (kind = .appendEntriesNoConflict)
          (Or
            (kind = .appendEntriesConflictThenAlreadyDone)
            (kind = .appendEntriesConflictThenNoConflict))))
    (enabled : Enabled state (.receive dest source kind))
    (increased :
      (next state (.receive dest source kind)).commitIndex dest >
        state.commitIndex dest)
    (boundary :
      SignatureCommitBoundary
        (next state (.receive dest source kind))
        dest
        index) :
    HasChosenCommitCertificate
      start
      (actions ++ [.receive dest source kind])
      (next state (.receive dest source kind))
      (next state (.receive dest source kind))
      dest
      index := by
  have matching :=
    core.electionLogs.counted.logs.logMatching
  have requests :=
    queueHistory_implies_AppendEntriesRequestHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent history)
  rcases
      appendEntriesAccept_commit_transport
        history
        matching
        requests
        dest
        source
        kind
        acceptKind
        enabled
        increased with
    ⟨message, head, send, commitWithinSend, committedPrefixEq⟩
  let after := next state (.receive dest source kind)
  have prefixEq :
      logPrefix (after.log dest) index =
        logPrefix (send.sendState.log source) index := by
    exact
      prefix_eq_at_smaller_index
        (after.log dest)
        (send.sendState.log source)
        (after.commitIndex dest)
        index
        boundary.2.1
        (by
          simpa [after, committed] using committedPrefixEq)
  cases finalAt :
      entryAt? (after.log dest) index with
  | none =>
      have impossible := boundary.2.2
      simp [after, finalAt] at impossible
  | some finalEntry =>
      have finalEntrySignature :
          finalEntry.content = .signature := by
        simpa [after, finalAt] using boundary.2.2
      have sendAt :
          entryAt? (send.sendState.log source) index =
            some finalEntry :=
        entryAt?_eq_of_logPrefix_eq finalAt prefixEq
      have sendBoundary :
          SignatureCommitBoundary
            send.sendState source index :=
        ⟨boundary.1,
          boundary.2.1.trans commitWithinSend,
          by simp [sendAt, finalEntrySignature]⟩
      rcases
          occurs_before_stateAt send.occurrence with
        ⟨sendEndpoint⟩
      have localChosenCore :
          HistoricalChosenCommitCore
            start
            sendEndpoint.pastActions
            send.sendState :=
        core.chosenCommits
          ⟨sendEndpoint.futureActions,
            sendEndpoint.actions_eq.symm⟩
          sendEndpoint.stateHistory
      rcases
          localChosenCore
            send.sendState
            (protocolHistory_final_stateAt
              sendEndpoint.stateHistory)
            source
            index
            sendBoundary with
        ⟨localCertificate⟩
      rcases
          chosenCommitCertificate_stateAtWitness_coherent
            sendEndpoint
            (historicalCompleteSafetyCore_prefixes history core)
            localCertificate
            sendBoundary with
        ⟨stateCertificate, _stateCoherence⟩
      rcases
          chosenCommitCertificate_append_step_coherent
            history
            core
            stateCertificate
            sendBoundary
            (.receive dest source kind)
            enabled with
        ⟨finalSenderCertificate, _stepCoherence⟩
      have sendTermEq :
          send.sendState.currentTerm source =
            after.currentTerm dest := by
        simpa [after] using
          appendEntriesAccept_sendTerm_eq_destTerm
            head send acceptKind enabled
      have choiceTermLe :
          finalSenderCertificate.choiceTerm <=
            after.currentTerm dest :=
        finalSenderCertificate.choice_term_le_boundary_owner.trans_eq
          sendTermEq
      have finalHistory :=
        replays_append_singleton history enabled
      rcases
          chosenCommitCertificate_rebase_boundary
            finalSenderCertificate
            (protocolHistory_final_stateAt finalHistory)
            boundary
            prefixEq
            choiceTermLe with
        ⟨rebased, _identity⟩
      exact ⟨rebased⟩

