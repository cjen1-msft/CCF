theorem chosenCommitCertificate_replay_suffix_coherent
    {start : InitialConfiguration}
    {beforeActions suffix : List Action}
    {beforeState afterState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (beforeHistory :
      ProtocolHistory start beforeActions beforeState)
    (replay : Replays beforeState suffix afterState)
    (prefixCores :
      forall {prefixActions prefixState},
        prefixActions <+: beforeActions ++ suffix ->
          ProtocolHistory start prefixActions prefixState ->
            HistoricalCompleteSafetyCore
              start prefixActions prefixState)
    (certificate :
      ChosenCommitCertificate
        start beforeActions beforeState boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index) :
    Exists fun extended :
      ChosenCommitCertificate
        start
        (beforeActions ++ suffix)
        afterState
        boundaryState
        owner
        index =>
      ChosenCommitCertificateExtension certificate extended := by
  induction suffix generalizing beforeActions beforeState with
  | nil =>
      simp [Replays] at replay
      subst afterState
      rw [List.append_nil]
      exact
        ⟨certificate,
          chosenCommitCertificateExtension_refl certificate⟩
  | cons action tail inductionHypothesis =>
      rcases replay with ⟨enabled, tailReplay⟩
      have beforePrefix :
          beforeActions <+: beforeActions ++ action :: tail :=
        ⟨action :: tail, rfl⟩
      have core :=
        prefixCores beforePrefix beforeHistory
      rcases
          chosenCommitCertificate_append_step_coherent
            beforeHistory
            core
            certificate
            boundary
            action
            enabled with
        ⟨nextCertificate, nextExtension⟩
      have nextHistory :
          ProtocolHistory
            start
            (beforeActions ++ [action])
            (next beforeState action) :=
        replays_append_singleton beforeHistory enabled
      have nextPrefixCores :
          forall {prefixActions prefixState},
            prefixActions <+:
                (beforeActions ++ [action]) ++ tail ->
              ProtocolHistory start prefixActions prefixState ->
                HistoricalCompleteSafetyCore
                  start prefixActions prefixState := by
        intro prefixActions prefixState isPrefix prefixHistory
        apply prefixCores
        · simpa [List.append_assoc] using isPrefix
        · exact prefixHistory
      rcases
          inductionHypothesis
            nextHistory
            tailReplay
            nextPrefixCores
            nextCertificate with
        ⟨extended, extension⟩
      rw [show
        beforeActions ++ action :: tail =
          (beforeActions ++ [action]) ++ tail by
            simp [List.append_assoc]]
      exact
        ⟨extended,
          chosenCommitCertificateExtension_trans
            nextExtension extension⟩

