private theorem historicalCompleteSafetyCore_candidateWitness
    {start : InitialConfiguration}
    {actions : List Action}
    {state candidateState : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (candidateEndpoint :
      StateAtWitness start actions state candidateState)
    (candidate : Node)
    (candidateRole :
      candidateState.leadershipState candidate = .candidate) :
    HasCurrentCandidateChosenConfigurationWitness
      start candidateEndpoint.pastActions candidateState candidate := by
  have actionsPrefix :
      candidateEndpoint.pastActions <+: actions :=
    ⟨candidateEndpoint.futureActions,
      candidateEndpoint.actions_eq.symm⟩
  have chosen :
      HereditaryHistoricalChosenCommitCore
        start candidateEndpoint.pastActions candidateState := by
    intro prefixActions prefixState prefixLe prefixHistory
    exact
      core.chosenCommits
        (prefixLe.trans actionsPrefix)
        prefixHistory
  have mono :
      HistoricalMonoLogInv
        start candidateEndpoint.pastActions candidateState := by
    intro logState logAt node nonempty
    exact
      core.electionLogs.counted.logs.monoLogs
        logState
        (stateAt_extend_stateAtWitness candidateEndpoint logAt)
        node
        nonempty
  have matching :
      TemporalLogMatchingInv
        start candidateEndpoint.pastActions candidateState := by
    intro first second firstAt secondAt
    exact
      core.electionLogs.counted.logs.logMatching
        first
        second
        (stateAt_extend_stateAtWitness candidateEndpoint firstAt)
        (stateAt_extend_stateAtWitness candidateEndpoint secondAt)
  have overlap :
      TemporalQuorumCandidateConfigurationOverlapInv
        start candidateEndpoint.pastActions candidateState := by
    intro first second firstAt secondAt
    exact
      core.electionLogs.counted.candidateOverlap
        first
        second
        (stateAt_extend_stateAtWitness candidateEndpoint firstAt)
        (stateAt_extend_stateAtWitness candidateEndpoint secondAt)
  rcases
      protocolHistory_currentCandidateTimeoutOrigin
        candidateEndpoint.stateHistory candidate candidateRole with
    ⟨origin⟩
  by_cases positive : 0 < candidateState.commitIndex candidate
  · have timeoutPositive :
        0 < origin.timeoutState.commitIndex candidate := by
      rw [← origin.commit_eq]
      exact positive
    have timeoutAt :
        StateAt
          start
          candidateEndpoint.pastActions
          candidateState
          origin.timeoutState :=
      occurs_before_stateAt origin.occurrence
    have configurationsExact :=
      reachable_ConfigurationsExactInv start (stateAt_reachable timeoutAt)
    have boundary :
        SignatureCommitBoundary
          origin.timeoutState
          candidate
          (origin.timeoutState.commitIndex candidate) :=
      ⟨timeoutPositive, Nat.le_refl _,
        (reachable_SignatureInv start (stateAt_reachable timeoutAt))
          candidate timeoutPositive⟩
    rcases
        chosen List.prefix_rfl candidateEndpoint.stateHistory
          origin.timeoutState timeoutAt candidate
          (origin.timeoutState.commitIndex candidate) boundary with
      ⟨certificate⟩
    have strict :
        certificate.choiceTerm <
          candidateState.currentTerm candidate := by
      rw [origin.term_eq]
      exact
        Nat.lt_succ_of_le
          certificate.choice_term_le_boundary_owner
    exact
      ⟨{
        basis := {
          boundaryState := origin.timeoutState
          owner := candidate
          index := origin.timeoutState.commitIndex candidate
          boundary
          certificate
          configuration_mem := by
            rw [origin.configurations_eq]
            exact
              configurationsExact_committedConfigurationAt?_mem
                origin.timeoutState candidate configurationsExact
                certificate.configuration certificate.configuration_at
          candidate_carries := by
            rw [certificate.prefix_eq, origin.log_eq]
            exact List.take_prefix _ _
          choice_term_le_candidate := Nat.le_of_lt strict
        }
        choice_term_lt_candidate := strict
      }⟩
  · have commitZero : candidateState.commitIndex candidate = 0 := by
      omega
    rcases
        candidateChosenConfigurationWitness_of_zero_commit_evidence_with_choice_term
          candidateEndpoint.stateHistory
          chosen
          mono
          matching
          overlap
          candidate
          commitZero
          (protocolHistory_implies_current_CandidateElectionBasis
            candidateEndpoint.stateHistory candidate candidateRole) with
      ⟨basis, choiceTerm, _configurationIndex,
        _configurationWithinMax⟩
    have strict :
        basis.certificate.choiceTerm <
          candidateState.currentTerm candidate := by
      rw [choiceTerm]
      exact
        reachable_CandidateTermStrictAfterStart
          start
          (protocolHistory_reachable candidateEndpoint.stateHistory)
          candidate
          candidateRole
    exact
      ⟨{
        basis
        choice_term_lt_candidate := strict
      }⟩

theorem protocolHistory_leader_has_configuration_before
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (leaderState : state.leadershipState leader = .leader)
    (indexPositive : 0 < index)
    (commitBefore : state.commitIndex leader < index) :
    Exists fun configuration : ConfigurationAt =>
      And
        (configuration ∈ logConfigurations (state.log leader))
        (configuration.index <= index) := by
  have leaderOrigins :=
    protocolHistory_implies_LeaderHistoryConsistent history
  rcases leaderOrigins leader leaderState with ⟨origin⟩
  cases origin with
  | initial leaderEq termEq =>
      subst leader
      let initialConfiguration : ConfigurationAt :=
        { index := 1, nodes := start.nodes }
      have initialMember :
          initialConfiguration ∈
            logConfigurations ((initialState start).log start) := by
        simp [initialConfiguration, initialState, startLog,
          logConfigurations, configurationsInEntries,
          configurationsInEntriesAux, start.leader_mem]
      have initialToCurrent :
          isLogPrefix
            ((initialState start).log start)
            (state.log start) :=
        (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv history)
          (initialState start)
          (protocolHistory_initial_stateAt history)
          start
          (by simp [initialState, start.leader_mem])
          leaderState
          (by simpa [initialState, start.leader_mem] using termEq.symm)
      exact
        ⟨initialConfiguration,
          configuration_mem_logConfigurations_of_prefix
            initialConfiguration
            ((initialState start).log start)
            (state.log start)
            initialMember
            initialToCurrent,
          by simp [initialConfiguration]; omega⟩
  | elected election =>
      have electionAt :
          StateAt
            start actions state election.electionState :=
        occurs_before_stateAt election.occurrence
      rcases election.occurrence with ⟨electionOccurrence⟩
      have electionEnabled := electionOccurrence.enabled
      have electionEnabledFacts := electionEnabled
      simp [Enabled, actionEnabled] at electionEnabledFacts
      rcases
          historicalCompleteSafetyCore_candidateWitness_evidence
            history
            core
            electionAt
            leader
            electionEnabledFacts.1.2 with
        ⟨electionActions, electionHistory, electionChosen,
          electionMono, electionMatching, electionCandidateOverlap⟩
      have electionBasis :=
        protocolHistory_implies_current_CandidateElectionBasis
          electionHistory leader electionEnabledFacts.1.2
      have configurationsExact :
          ConfigurationsExactInv election.electionState :=
        reachable_ConfigurationsExactInv
          start
          (protocolHistory_reachable electionHistory)
      have electionConfiguration :
          Exists fun configuration : ConfigurationAt =>
            And
              (configuration ∈
                logConfigurations
                  (election.electionState.log leader))
              (And
                (configuration.index <=
                  maxCommittableIndex
                    (election.electionState.log leader))
                (Or
                  (configuration.index <=
                    election.electionState.commitIndex leader)
                  (configuration.index = 1))) := by
        by_cases commitPositive :
            0 < election.electionState.commitIndex leader
        · have signatures :
              SignatureInv election.electionState :=
            reachable_SignatureInv
              start
              (protocolHistory_reachable electionHistory)
          have boundary :
              SignatureCommitBoundary
                election.electionState
                leader
                (election.electionState.commitIndex leader) :=
            ⟨commitPositive,
              Nat.le_refl _,
              signatures leader commitPositive⟩
          have currentChosen :
              HistoricalChosenCommitCore
                start electionActions election.electionState :=
            electionChosen List.prefix_rfl electionHistory
          rcases
              currentChosen
                election.electionState
                (protocolHistory_final_stateAt electionHistory)
                leader
                (election.electionState.commitIndex leader)
                boundary with
            ⟨certificate⟩
          have configurationFacts :=
            committedConfigurationAt?_some_properties
              (election.electionState.log leader)
              (election.electionState.commitIndex leader)
              certificate.configuration
              certificate.configuration_at
          have commitWithinMax :
              election.electionState.commitIndex leader <=
                maxCommittableIndex
                  (election.electionState.log leader) :=
            index_le_maxCommittableIndex_of_signature
              (election.electionState.log leader)
              (election.electionState.commitIndex leader)
              (by
                simpa using signatures leader commitPositive)
          exact
            ⟨certificate.configuration,
              configurationFacts.1,
              configurationFacts.2.trans commitWithinMax,
              Or.inl configurationFacts.2⟩
        · have commitZero :
              election.electionState.commitIndex leader = 0 := by
            omega
          rcases
              candidateChosenConfigurationWitness_of_zero_commit_evidence_with_choice_term
                electionHistory
                electionChosen
                electionMono
                electionMatching
                electionCandidateOverlap
                leader
                commitZero
                electionBasis with
            ⟨witness, _choiceTerm, configurationIndex,
              configurationWithinMax⟩
          have activeMember := witness.configuration_mem
          rw [configurationsExact leader, commitZero] at activeMember
          have configurationInLog :
              witness.certificate.configuration ∈
                logConfigurations
                  (election.electionState.log leader) := by
            have filtered := activeMember
            simp [activeLogConfigurations, configurationsFromIndex]
              at filtered
            exact filtered.1
          exact
            ⟨witness.certificate.configuration,
              configurationInLog,
              configurationWithinMax,
              Or.inr configurationIndex⟩
      rcases electionConfiguration with
        ⟨configuration, configurationInElectionLog,
          configurationWithinMax, configurationBeforeCommitOrInitial⟩
      have configurationAfterElection :
          configuration ∈
            logConfigurations
              ((next election.electionState
                (.becomeLeader leader)).log leader) := by
        simpa [next, rawNext, nextBecomeLeader] using
          configuration_mem_logConfigurations_committable
            election.electionState
            leader
            configuration
            configurationInElectionLog
            configurationWithinMax
      have afterElectionAt :
          StateAt
            start actions state
            (next election.electionState
              (.becomeLeader leader)) :=
        occurs_after_stateAt ⟨electionOccurrence⟩
      have afterElectionToCurrent :
          isLogPrefix
            ((next election.electionState
              (.becomeLeader leader)).log leader)
            (state.log leader) :=
        (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv history)
          (next election.electionState (.becomeLeader leader))
          afterElectionAt
          leader
          (by simp [next, rawNext, nextBecomeLeader])
          leaderState
          (by
            simpa [next, rawNext, nextBecomeLeader] using
              election.term_eq.symm)
      have configurationInCurrentLog :
          configuration ∈ logConfigurations (state.log leader) :=
        configuration_mem_logConfigurations_of_prefix
          configuration
          ((next election.electionState
            (.becomeLeader leader)).log leader)
          (state.log leader)
          configurationAfterElection
          afterElectionToCurrent
      have electionCommitLeCurrent :
          election.electionState.commitIndex leader <=
            state.commitIndex leader := by
        rcases electionAt with ⟨electionAtWitness⟩
        exact
          replays_commitIndex_mono
            electionAtWitness.remainingHistory
            leader
      have configurationBeforeIndex :
          configuration.index <= index := by
        rcases configurationBeforeCommitOrInitial with
          configurationBeforeCommit | configurationInitial
        · exact
            configurationBeforeCommit.trans
              (electionCommitLeCurrent.trans
                (Nat.le_of_lt commitBefore))
        · rw [configurationInitial]
          omega
      exact
        ⟨configuration,
          configurationInCurrentLog,
          configurationBeforeIndex⟩

theorem protocolHistory_leader_configurations_nonempty
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (leaderState : state.leadershipState leader = .leader) :
    state.configurations leader ≠ [] := by
  let index := state.commitIndex leader + 1
  rcases
      protocolHistory_leader_has_configuration_before
        (index := index)
        history
        core
        leaderState
        (by omega)
        (by omega) with
    ⟨configuration, configurationMember, _configurationWithin⟩
  have configurationsExact :
      ConfigurationsExactInv state :=
    reachable_ConfigurationsExactInv
      start
      (protocolHistory_reachable history)
  rw [configurationsExact leader]
  exact
    activeLogConfigurations_nonempty_of_logConfiguration
      (state.log leader)
      (state.commitIndex leader)
      configuration
      configurationMember

theorem advanceCommitIndex_configurationAt_exists
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (commitBefore : state.commitIndex leader < index) :
    Exists fun configuration : ConfigurationAt =>
      And
        (committedConfigurationAt?
            (state.log leader)
            index =
          some configuration)
        (configuration.index <= index) := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  rcases
      protocolHistory_leader_has_configuration_before
        history
        core
        enabledFacts.1.2
        (by omega)
        commitBefore with
    ⟨configuration, configurationMember, configurationWithin⟩
  rcases
      committedConfigurationAt?_exists_of_configuration
        (state.log leader)
        index
        configuration
        configurationMember
        configurationWithin with
    ⟨selected, selectedAt⟩
  have selectedFacts :=
    committedConfigurationAt?_some_properties
      (state.log leader)
      index
      selected
      selectedAt
  exact ⟨selected, selectedAt, selectedFacts.2⟩

private theorem advanceCommitIndex_highest_boundary
    {state : State}
    {leader : Node}
    (enabled : Enabled state (.advanceCommitIndex leader)) :
    SignatureCommitBoundary
      (next state (.advanceCommitIndex leader))
      leader
      (highestCommittableIndex state leader) := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have highestPositive :
      0 < highestCommittableIndex state leader := by
    omega
  refine ⟨highestPositive, ?_, ?_⟩
  · simp [next, rawNext, nextAdvanceCommitIndex]
  · rcases
        highestCommittableIndex_signature_or_zero state leader with
      highestZero | ⟨entry, entryAt, entryTerm, entrySignature⟩
    · omega
    · simpa [next, rawNext, nextAdvanceCommitIndex, entryAt,
        entrySignature]

theorem advanceCommitIndex_choiceSupportWitness
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader member : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (leaderState : state.leadershipState leader = .leader)
    (indexPositive : 0 < index)
    (indexLeMatch : index <= state.matchIndex leader member) :
    Nonempty
      (ChoiceSupportWitness
        start
        (actions ++ [.advanceCommitIndex leader])
        (next state (.advanceCommitIndex leader))
        state
        leader
        member
        index
        (state.currentTerm leader)) := by
  have matchPositive :
      0 < state.matchIndex leader member :=
    indexPositive.trans_le indexLeMatch
  rcases
      protocolHistory_implies_CurrentTermMatchIndexHistoryConsistent
        history
        leader
        member
        leaderState
        matchPositive with
    ⟨current⟩
  exact
    ⟨{
      choiceActions := actions
      choice_history := history
      choice_actions_prefix := ⟨[.advanceCommitIndex leader], rfl⟩
      matchWitness := current.witness
      index_le_ack := indexLeMatch.trans_eq current.witness.index_eq
      response_term := current.response_term
    }⟩

structure AdvanceCommitPendingChoiceSupport
    (start : InitialConfiguration)
    (actions : List Action)
    (state : State)
    (leader member : Node) where
  matchWitness :
    MatchIndexWitness start actions state leader member
  index_le_ack :
    highestCommittableIndex state leader <=
      matchWitness.lastLogIndex
  response_term :
    matchWitness.response.term = state.currentTerm leader

private structure SuccessfulVotedForLogWitness
    (start : InitialConfiguration)
    (actions : List Action)
    (state : State)
    (voter candidate : Node) where
  vote :
    VotedForLogWitness start actions state voter candidate
  granted :
    requestVoteGranted
        vote.responseOrigin.responseState
        voter
        candidate
        vote.responseOrigin.request.term
        vote.responseOrigin.lastTerm
        vote.responseOrigin.lastIndex =
      true

private def successfulVotedForLogWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {voter candidate : Node}
    (witness :
      SuccessfulVotedForLogWitness
        start actions state voter candidate)
    (enabled : Enabled state action)
    (voterTermEq :
      (next state action).currentTerm voter =
        state.currentTerm voter) :
    SuccessfulVotedForLogWitness
      start
      (actions ++ [action])
      (next state action)
      voter
      candidate :=
  {
    vote :=
      votedForLogWitness_extend witness.vote enabled voterTermEq
    granted := witness.granted
  }

private def SuccessfulVotedForLogHistoryConsistent
    (start : InitialConfiguration)
    (actions : List Action)
    (state : State) :
    Prop :=
  forall voter candidate : Node,
    state.votedFor voter = some candidate ->
      voter ≠ candidate ->
        Nonempty
          (SuccessfulVotedForLogWitness
            start actions state voter candidate)

private theorem successfulVotedForLogHistory_of_preserved
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (voteLogs :
      SuccessfulVotedForLogHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (votes :
      forall voter,
        (next state action).votedFor voter =
          state.votedFor voter)
    (terms :
      forall voter,
        (next state action).currentTerm voter =
          state.currentTerm voter) :
    SuccessfulVotedForLogHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  intro voter candidate votedFor notSelf
  have oldVote :
      state.votedFor voter = some candidate := by
    rw [← votes voter]
    exact votedFor
  rcases voteLogs voter candidate oldVote notSelf with
    ⟨witness⟩
  exact
    ⟨successfulVotedForLogWitness_extend
      witness enabled (terms voter)⟩

private theorem successfulVotedForLogHistory_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (voteLogs :
      SuccessfulVotedForLogHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    SuccessfulVotedForLogHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  have requestVotes :=
    queueHistory_implies_RequestVoteMessageHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent history)
  cases action with
  | timeout timedOut =>
      intro voter candidate votedFor notSelf
      by_cases voterIsTimedOut : voter = timedOut
      · subst voter
        have timedOutIsCandidate : timedOut = candidate := by
          simpa [next, rawNext, nextTimeout, updateNode] using votedFor
        exact False.elim (notSelf timedOutIsCandidate)
      · have oldVote :
            state.votedFor voter = some candidate := by
          simpa [next, rawNext, nextTimeout, updateNode,
            voterIsTimedOut] using votedFor
        rcases voteLogs voter candidate oldVote notSelf with
          ⟨witness⟩
        exact
          ⟨successfulVotedForLogWitness_extend
            witness enabled
            (by
              simp [next, rawNext, nextTimeout, updateNode,
                voterIsTimedOut])⟩
  | requestVote source dest =>
      exact
        successfulVotedForLogHistory_of_preserved
          voteLogs (.requestVote source dest) enabled
          (by intro voter; simp [next, rawNext, nextRequestVote])
          (by intro voter; simp [next, rawNext, nextRequestVote])
  | appendEntries source dest =>
      exact
        successfulVotedForLogHistory_of_preserved
          voteLogs (.appendEntries source dest) enabled
          (by intro voter; simp [next, rawNext, nextAppendEntries])
          (by intro voter; simp [next, rawNext, nextAppendEntries])
  | becomeLeader leader =>
      exact
        successfulVotedForLogHistory_of_preserved
          voteLogs (.becomeLeader leader) enabled
          (by intro voter; simp [next, rawNext, nextBecomeLeader])
          (by intro voter; simp [next, rawNext, nextBecomeLeader])
  | clientRequest leader =>
      exact
        successfulVotedForLogHistory_of_preserved
          voteLogs (.clientRequest leader) enabled
          (by intro voter; simp [next, rawNext, nextClientRequest])
          (by intro voter; simp [next, rawNext, nextClientRequest])
  | signCommittableMessages leader =>
      exact
        successfulVotedForLogHistory_of_preserved
          voteLogs (.signCommittableMessages leader) enabled
          (by
            intro voter
            simp [next, rawNext, nextSignCommittableMessages])
          (by
            intro voter
            simp [next, rawNext, nextSignCommittableMessages])
  | changeConfiguration leader configuration =>
      exact
        successfulVotedForLogHistory_of_preserved
          voteLogs (.changeConfiguration leader configuration) enabled
          (by
            intro voter
            simp [next, rawNext, nextChangeConfiguration])
          (by
            intro voter
            simp [next, rawNext, nextChangeConfiguration])
  | advanceCommitIndex leader =>
      exact
        successfulVotedForLogHistory_of_preserved
          voteLogs (.advanceCommitIndex leader) enabled
          (by
            intro voter
            simp [next, rawNext, nextAdvanceCommitIndex])
          (by
            intro voter
            simp [next, rawNext, nextAdvanceCommitIndex])
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [Enabled, actionEnabled, hmessage] at enabled
      | some message =>
          cases kind with
          | updateTerm =>
              intro voter candidate votedFor notSelf
              by_cases voterIsDest : voter = dest
              · subst voter
                simp [next, rawNext, nextReceive, hmessage,
                  updateNode] at votedFor
              · have oldVote :
                    state.votedFor voter = some candidate := by
                  simpa [next, rawNext, nextReceive, hmessage,
                    updateNode, voterIsDest] using votedFor
                rcases voteLogs voter candidate oldVote notSelf with
                  ⟨witness⟩
                exact
                  ⟨successfulVotedForLogWitness_extend
                    witness enabled
                    (by
                      simp [next, rawNext, nextReceive, hmessage,
                        updateNode, voterIsDest])⟩
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  let grant :=
                    requestVoteGranted
                      state dest source message.term lastTerm lastIndex
                  intro voter candidate votedFor notSelf
                  by_cases voterIsDest : voter = dest
                  · subst voter
                    by_cases granted : grant = true
                    · have sourceIsCandidate : source = candidate := by
                        simpa [next, rawNext, nextReceive, hmessage,
                          hbody, grant, granted, updateNode] using votedFor
                      subst candidate
                      have queued :
                          message ∈ state.messages dest source :=
                        headMessage?_mem
                          state dest source message hmessage
                      rcases
                          (by
                            simpa [hbody] using
                              requestVotes dest source message queued) with
                        ⟨send⟩
