  simp [lastConfigurationToIndex, List.foldl_append, afterCommit]

theorem foldl_lastConfigurationToIndex_le
    (configurations : List ConfigurationAt)
    (commitIndex initial : Nat)
    (initialWithin : initial <= commitIndex) :
    configurations.foldl
        (fun result configuration =>
          if configuration.index <= commitIndex then
            max result configuration.index
          else
            result)
        initial <=
      commitIndex := by
  induction configurations generalizing initial with
  | nil =>
      simpa using initialWithin
  | cons configuration rest inductionHypothesis =>
      by_cases withinCommit : configuration.index <= commitIndex
      · simp [withinCommit]
        exact inductionHypothesis _ (max_le initialWithin withinCommit)
      · simp [withinCommit]
        exact inductionHypothesis initial initialWithin

theorem lastConfigurationToIndex_le
    (configurations : List ConfigurationAt)
    (commitIndex : Nat) :
    lastConfigurationToIndex configurations commitIndex <= commitIndex := by
  exact foldl_lastConfigurationToIndex_le configurations commitIndex 0
    (Nat.zero_le commitIndex)

theorem activeLogConfigurations_take
    (entries : List Entry)
    (commitIndex count : Nat)
    (commitWithin : commitIndex <= count) :
    activeLogConfigurations (entries.take count) commitIndex =
      configurationsToIndex
        (activeLogConfigurations entries commitIndex)
        count := by
  simp only [activeLogConfigurations]
  rw [logConfigurations_take]
  rw [lastConfigurationToIndex_configurationsToIndex
    (logConfigurations entries) count commitIndex commitWithin]
  simp only [configurationsFromIndex, configurationsToIndex,
    List.filter_filter]
  apply List.filter_congr
  intro configuration _
  apply Bool.and_comm

theorem activeLogConfigurations_append_entry
    (entries : List Entry)
    (commitIndex term : Nat) :
    activeLogConfigurations
        (entries ++ [{ term := term, content := .entry }])
        commitIndex =
      activeLogConfigurations entries commitIndex := by
  simp [activeLogConfigurations, logConfigurations_append,
    configurationsInEntries, configurationsInEntriesAux]

theorem activeLogConfigurations_append_signature
    (entries : List Entry)
    (commitIndex term : Nat) :
    activeLogConfigurations
        (entries ++ [{ term := term, content := .signature }])
        commitIndex =
      activeLogConfigurations entries commitIndex := by
