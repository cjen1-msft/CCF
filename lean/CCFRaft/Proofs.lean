theorem chosenCommitCertificate_configuration_active_at_later_choice_of_threshold
    {start : InitialConfiguration}
    {actions : List Action}
    {state firstBoundaryState targetBoundaryState : State}
    {firstOwner targetOwner : Node}
    {firstIndex targetIndex : Nat}
    (first :
      ChosenCommitCertificate
        start actions state
        firstBoundaryState firstOwner firstIndex)
    (target :
      ChosenCommitCertificate
        start actions state
        targetBoundaryState targetOwner targetIndex)
    (configurationsExact :
      ConfigurationsExactInv target.choiceState)
    (prefixOrder :
      isLogPrefix first.chosenPrefix target.chosenPrefix)
    (targetChoiceThresholdWithinFirstConfiguration :
      lastConfigurationToIndex
          (logConfigurations
            (target.choiceState.log target.choiceLeader))
          (target.choiceState.commitIndex target.choiceLeader) <=
        first.configuration.index) :
    And
      (first.configuration ∈
        target.choiceState.configurations target.choiceLeader)
      (first.configuration.index <= target.choiceIndex) := by
  have firstConfigurationFacts :=
    committedConfigurationAt?_some_properties
      (firstBoundaryState.log firstOwner)
      firstIndex
      first.configuration
      first.configuration_at
  have firstToTargetChoiceLog :
      isLogPrefix
        first.chosenPrefix
        (target.choiceState.log target.choiceLeader) :=
    prefixOrder.trans
      (chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
        target)
  have firstLength :=
    chosenCommitCertificate_chosenPrefix_length first
  have configurationInTargetChoiceLog :
      first.configuration ∈
        logConfigurations
          (target.choiceState.log target.choiceLeader) :=
    configuration_mem_logConfigurations_of_prefix
      first.configuration
      first.chosenPrefix
      (target.choiceState.log target.choiceLeader)
      (chosenCommitCertificate_configuration_mem_chosenPrefix first)
      firstToTargetChoiceLog
  have configurationActive :
      first.configuration ∈
        target.choiceState.configurations target.choiceLeader := by
    rw [configurationsExact target.choiceLeader]
    simp [activeLogConfigurations, configurationsFromIndex,
      configurationInTargetChoiceLog,
      targetChoiceThresholdWithinFirstConfiguration]
  have firstIndexWithinTarget :
      firstIndex <= targetIndex := by
    have targetLength :=
      chosenCommitCertificate_chosenPrefix_length target
    have lengthBound := prefixOrder.length_le
    simpa [firstLength, targetLength] using lengthBound
  exact
    ⟨configurationActive,
      firstConfigurationFacts.2.trans
        (firstIndexWithinTarget.trans target.boundary_le_choice)⟩

theorem chosenCommitCertificate_configuration_active_at_later_choice
    {start : InitialConfiguration}
    {actions : List Action}
    {state firstBoundaryState targetBoundaryState : State}
    {firstOwner targetOwner : Node}
    {firstIndex targetIndex : Nat}
    (first :
      ChosenCommitCertificate
        start actions state
        firstBoundaryState firstOwner firstIndex)
    (target :
      ChosenCommitCertificate
        start actions state
        targetBoundaryState targetOwner targetIndex)
    (configurationsExact :
      ConfigurationsExactInv target.choiceState)
    (prefixOrder :
      isLogPrefix first.chosenPrefix target.chosenPrefix)
    (targetChoiceCommitWithinFirst :
      target.choiceState.commitIndex target.choiceLeader <=
        firstIndex) :
    And
      (first.configuration ∈
        target.choiceState.configurations target.choiceLeader)
      (first.configuration.index <= target.choiceIndex) := by
  have firstSelectedIndex :=
    committedConfigurationAt?_index_eq_lastConfigurationToIndex
      (firstBoundaryState.log firstOwner)
      firstIndex
      first.configuration
      first.configuration_at
  have firstToTargetChoiceLog :
      isLogPrefix
        first.chosenPrefix
        (target.choiceState.log target.choiceLeader) :=
    prefixOrder.trans
      (chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
        target)
  have firstLength :=
    chosenCommitCertificate_chosenPrefix_length first
  have firstPrefixAtTargetChoice :
      first.chosenPrefix =
        logPrefix
          (target.choiceState.log target.choiceLeader)
          firstIndex :=
    prefix_eq_logPrefix_of_length
      first.chosenPrefix
      (target.choiceState.log target.choiceLeader)
      firstIndex
      firstToTargetChoiceLog
      firstLength
  have prefixesEq :
      (firstBoundaryState.log firstOwner).take firstIndex =
        (target.choiceState.log target.choiceLeader).take
          firstIndex := by
    calc
      (firstBoundaryState.log firstOwner).take firstIndex =
          first.chosenPrefix := by
        simpa [logPrefix] using first.prefix_eq.symm
      _ =
          (target.choiceState.log target.choiceLeader).take
            firstIndex := by
        simpa [logPrefix] using firstPrefixAtTargetChoice
  have filteredEq := congrArg logConfigurations prefixesEq
  rw [logConfigurations_take, logConfigurations_take] at filteredEq
  have lastEq :=
    congrArg
      (fun configurations =>
        lastConfigurationToIndex configurations firstIndex)
      filteredEq
  change
    lastConfigurationToIndex
          (configurationsToIndex
            (logConfigurations (firstBoundaryState.log firstOwner))
            firstIndex)
          firstIndex =
      lastConfigurationToIndex
        (configurationsToIndex
          (logConfigurations
            (target.choiceState.log target.choiceLeader))
          firstIndex)
        firstIndex at lastEq
  rw [lastConfigurationToIndex_configurationsToIndex
        _ firstIndex firstIndex (Nat.le_refl _),
      lastConfigurationToIndex_configurationsToIndex
        _ firstIndex firstIndex (Nat.le_refl _)] at lastEq
  have configurationIndexAtTargetChoice :
      first.configuration.index =
        lastConfigurationToIndex
          (logConfigurations
            (target.choiceState.log target.choiceLeader))
          firstIndex :=
    firstSelectedIndex.trans lastEq
  apply
    chosenCommitCertificate_configuration_active_at_later_choice_of_threshold
      first target configurationsExact prefixOrder
  rw [configurationIndexAtTargetChoice]
  exact
    lastConfigurationToIndex_mono
      _
      _
      _
      targetChoiceCommitWithinFirst

