  certificate.boundary_prefix_le_choice_prefix.trans
    (initial_choice_member_stateAt_carries_choiceIndexPrefix
      certificate initial member memberInitial endpointAt)

private theorem choiceLeader_voteGrant_carries_chosenPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState grantState : State}
    {owner candidate : Node}
    {index candidateTerm : Nat}
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (grant :
      Occurs
        start actions state grantState
        (.receive
          certificate.choiceLeader
          candidate
          .handleRequestVoteRequest))
    (grantTerm :
      grantState.currentTerm certificate.choiceLeader = candidateTerm)
    (higherTerm :
      certificate.choiceTerm < candidateTerm) :
    isLogPrefix
      certificate.chosenPrefix
      (grantState.log certificate.choiceLeader) := by
  rcases grant with ⟨grantOccurrence⟩
  let grantAt : StateAtWitness start actions state grantState :=
    {
      pastActions := grantOccurrence.pastActions
      futureActions :=
        .receive
            certificate.choiceLeader
            candidate
            .handleRequestVoteRequest ::
          grantOccurrence.futureActions
      actions_eq := by
        simpa only [List.append_assoc, List.singleton_append] using
          grantOccurrence.actions_eq
      stateHistory := grantOccurrence.before_history
      remainingHistory :=
        ⟨grantOccurrence.enabled, grantOccurrence.after_history⟩
    }
  rcases certificate.choice_at with ⟨choiceAt⟩
  rcases stateAtWitness_history_order choiceAt grantAt with
    choiceToGrant | grantToChoice
  · apply
      chosenCommitCertificate_prefix_retained_between
        leaderUniqueness
        certificate
        boundary
        grantAt
        choiceToGrant
        (Nat.le_of_eq certificate.choice_term.symm)
    rw [certificate.choice_prefix_eq]
    exact
      logPrefix_isLogPrefix
        (certificate.choiceState.log certificate.choiceLeader)
        index
  · rcases grantToChoice with ⟨grantToChoiceWitness⟩
    have termMonotonic :=
      replays_currentTerm_mono
        grantToChoiceWitness.remainingHistory
        certificate.choiceLeader
    have impossible :
        candidateTerm <= certificate.choiceTerm := by
      rw [← grantTerm, ← certificate.choice_term]
      exact termMonotonic
    omega

theorem choiceSupport_potentialVote_grant_carries_choiceIndexPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState : State}
    {owner member candidate : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (support :
      ChoiceSupportWitness
        start actions state certificate.choiceState
        certificate.choiceLeader member certificate.choiceIndex
        certificate.choiceTerm)
    (vote :
      VotedForLogWitness
        start actions state member candidate)
    (potentialVote :
      member ∈ votersForCandidateTerm state candidate)
    (higherTerm :
      certificate.choiceTerm < state.currentTerm candidate) :
    isLogPrefix
      certificate.choiceIndexPrefix
      (vote.responseOrigin.responseState.log member) := by
  have voterFacts :
      state.currentTerm member = state.currentTerm candidate ∧
        state.votedFor member = some candidate := by
    have facts := potentialVote
    simp [votersForCandidateTerm] at facts
    exact facts.2
  have responseTerm :
      vote.response.term =
        vote.responseOrigin.responseState.currentTerm member := by
    simpa using congrArg Message.term vote.responseOrigin.response_eq
  have grantTerm :
      vote.responseOrigin.responseState.currentTerm member =
        state.currentTerm candidate :=
    responseTerm.symm.trans
      (vote.voter_term_eq.symm.trans voterFacts.1)
  exact
    choiceSupport_voteGrant_carries_choiceIndexPrefix_at_term
      history
      core
      matching
      leaderUniqueness
      certificate
      support
      vote.responseOrigin.occurrence
      grantTerm
      higherTerm

theorem choiceSupport_potentialVote_grant_carries_chosenPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState : State}
    {owner member candidate : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (support :
      ChoiceSupportWitness
        start actions state certificate.choiceState
        certificate.choiceLeader member certificate.choiceIndex
        certificate.choiceTerm)
    (vote :
      VotedForLogWitness
        start actions state member candidate)
    (potentialVote :
      member ∈ votersForCandidateTerm state candidate)
    (higherTerm :
      certificate.choiceTerm < state.currentTerm candidate) :
    isLogPrefix
      certificate.chosenPrefix
      (vote.responseOrigin.responseState.log member) := by
  rcases
      choiceSupport_acknowledges_choiceIndexPrefix
        history
        matching
        certificate
        support
        rfl
        rfl with
    ⟨strongAck, acknowledged⟩
  let choiceAt :=
    choiceSupport_choiceState_stateAt history support
  rcases
      occurs_extend_stateAtWitness
        choiceAt strongAck.ack.origin.occurrence with
    ⟨ack⟩
  rcases vote.responseOrigin.occurrence with
    ⟨grant⟩
  have voterFacts :
      state.currentTerm member = state.currentTerm candidate ∧
        state.votedFor member = some candidate := by
    have facts := potentialVote
    simp [votersForCandidateTerm] at facts
    exact facts.2
  have responseTerm :
      vote.response.term =
        vote.responseOrigin.responseState.currentTerm member := by
    simpa using
      congrArg Message.term vote.responseOrigin.response_eq
  have grantTerm :
      vote.responseOrigin.responseState.currentTerm member =
        state.currentTerm candidate :=
    responseTerm.symm.trans
      (vote.voter_term_eq.symm.trans voterFacts.1)
  exact
    chosenCommitCertificate_prefix_retained_to_higher_term_vote
      leaderUniqueness
      certificate
      boundary
      ack
      grant
      (strongAck.ack.response_term.symm.trans support.response_term)
      (Nat.le_refl _)
      grantTerm
      higherTerm
      (certificate.boundary_prefix_le_choice_prefix.trans acknowledged)

theorem countedQuorumReadyCandidate_carries_chosenPrefix_causal
    {start : InitialConfiguration}
    {actions : List Action}
    {state targetBoundaryState : State}
    {candidate targetOwner : Node}
    {targetIndex : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (_candidateWitness :
      CandidateChosenConfigurationWitness
        start actions state candidate)
    (target :
      ChosenCommitCertificate
        start actions state
        targetBoundaryState targetOwner targetIndex)
    (targetBoundary :
      SignatureCommitBoundary
        targetBoundaryState targetOwner targetIndex)
    (targetEarlier :
      target.choiceTerm < state.currentTerm candidate)
    (candidateState :
      state.leadershipState candidate = .candidate)
    (candidateQuorum :
      allConfigurationsHaveQuorum
          (state.votesGranted candidate)
          (state.configurations candidate) =
        true)
    (activeConfiguration : ConfigurationAt)
    (candidateConfigurationActive :
      activeConfiguration ∈ state.configurations candidate)
    (configurationActiveAtChoice :
      activeConfiguration ∈
        target.choiceState.configurations target.choiceLeader)
    (configurationWithinChoice :
      activeConfiguration.index <= target.choiceIndex) :
    isLogPrefix
      target.chosenPrefix
      (state.log candidate) := by
  have candidateQuorumAtConfiguration :
      isQuorum
          (state.votesGranted candidate ∩
            activeConfiguration.nodes)
          activeConfiguration.nodes =
        true := by
    have allQuorums := candidateQuorum
    simp [allConfigurationsHaveQuorum] at allQuorums
    exact
      allQuorums activeConfiguration candidateConfigurationActive
  rcases
      target.watermark_causal_support
        activeConfiguration
        configurationActiveAtChoice
        configurationWithinChoice with
    ⟨supportQuorum, supportQuorumOk, causalSupport⟩
  rcases
      isQuorum_intersects
        supportQuorum
        (state.votesGranted candidate ∩ activeConfiguration.nodes)
        activeConfiguration.nodes
        supportQuorumOk
        candidateQuorumAtConfiguration with
    ⟨voter, supportMember, candidateMember⟩
  have voterMember : voter ∈ state.votesGranted candidate :=
    (Finset.mem_inter.mp candidateMember).1
  have leaderUniqueness :=
    completeSafetyCore_implies_leaderUniqueness history core
  rcases causalSupport voter supportMember with
    voterIsChoiceLeader | causalWitness
  · by_cases voterIsCandidate : voter = candidate
    · subst voter
      subst candidate
      exact
        choiceLeader_endpoint_carries_chosenPrefix
          leaderUniqueness target targetBoundary
    · have countedVotes :=
        protocolHistory_implies_CountedVoteLogHistoryConsistent history
      rcases
          countedVotes
            candidate
            voter
            (Or.inl candidateState)
            voterMember
            voterIsCandidate with
        ⟨vote⟩
      subst voter
      have responseTerm :
          vote.counted.response.term =
            vote.counted.responseOrigin.responseState.currentTerm
              target.choiceLeader := by
        simpa using
          congrArg Message.term
            vote.counted.responseOrigin.response_eq
      have grantTerm :
          vote.counted.responseOrigin.responseState.currentTerm
              target.choiceLeader =
            state.currentTerm candidate :=
        responseTerm.symm.trans
          vote.counted.candidate_term_eq.symm
      have grantCarries :=
        choiceLeader_voteGrant_carries_choiceIndexPrefix
          history
          core
          leaderUniqueness
          target
          vote.counted.responseOrigin.occurrence
          grantTerm
          targetEarlier
      have requestBody :
          vote.counted.responseOrigin.request.body =
            .requestVoteRequest
              vote.counted.responseOrigin.lastTerm
              vote.counted.responseOrigin.lastIndex
              false := by
        have sentBody := congrArg Message.body vote.send.message_eq
        have sentFacts := sentBody.symm
        simp [requestVoteMessage,
          vote.counted.responseOrigin.request_body] at sentFacts
        simpa [sentFacts.2.2] using
          vote.counted.responseOrigin.request_body
      have carriesAtSend :=
        requestVoteLogOK_carries_chosenPrefix_with_term
          history
          core.electionLogs.counted.logs.monoLogs
          core.electionLogs.counted.logs.logMatching
          leaderUniqueness
          target
          targetBoundary
          (occurs_before_stateAt
            vote.counted.responseOrigin.occurrence)
          vote.send
          requestBody
          vote.log_ok
          grantCarries
      have sendAt := occurs_before_stateAt vote.send.occurrence
      have monoAtSend : MonoLogInv vote.send.sendState := by
        intro node nonempty
        exact
          core.electionLogs.counted.logs.monoLogs
            vote.send.sendState sendAt node nonempty
      exact
        chosenCommitCertificate_prefix_retained_to_endpoint
          leaderUniqueness
          target
          targetBoundary
          sendAt
          carriesAtSend.2
          carriesAtSend.1
  · rcases causalWitness with initialSupport | causalWitness
    · by_cases voterIsCandidate : voter = candidate
      · subst voter
        exact
          initial_choice_member_stateAt_carries_chosenPrefix
            target
            initialSupport.1
            candidate
            initialSupport.2
            (protocolHistory_final_stateAt history)
      · have countedVotes :=
          protocolHistory_implies_CountedVoteLogHistoryConsistent history
        rcases
            countedVotes
              candidate
              voter
              (Or.inl candidateState)
              voterMember
              voterIsCandidate with
          ⟨vote⟩
        have grantCarries :=
          initial_choice_member_stateAt_carries_choiceIndexPrefix
            target
            initialSupport.1
            voter
            initialSupport.2
            (occurs_before_stateAt
              vote.counted.responseOrigin.occurrence)
        have requestBody :
            vote.counted.responseOrigin.request.body =
              .requestVoteRequest
                vote.counted.responseOrigin.lastTerm
                vote.counted.responseOrigin.lastIndex
                false := by
          have sentBody := congrArg Message.body vote.send.message_eq
          have sentFacts := sentBody.symm
          simp [requestVoteMessage,
            vote.counted.responseOrigin.request_body] at sentFacts
          simpa [sentFacts.2.2] using
            vote.counted.responseOrigin.request_body
        have carriesAtSend :=
          requestVoteLogOK_carries_chosenPrefix_with_term
            history
            core.electionLogs.counted.logs.monoLogs
            core.electionLogs.counted.logs.logMatching
            leaderUniqueness
            target
            targetBoundary
            (occurs_before_stateAt
              vote.counted.responseOrigin.occurrence)
            vote.send
            requestBody
            vote.log_ok
            grantCarries
        have sendAt := occurs_before_stateAt vote.send.occurrence
        exact
          chosenCommitCertificate_prefix_retained_to_endpoint
            leaderUniqueness
            target
            targetBoundary
            sendAt
            carriesAtSend.2
            carriesAtSend.1
    · rcases causalWitness with ⟨support⟩
      by_cases voterIsCandidate : voter = candidate
      · subst voter
        exact
          choiceSupport_endpoint_carries_chosenPrefix
            history
            core.electionLogs.counted.logs.logMatching
            leaderUniqueness
            target
            targetBoundary
            support
      · have countedVotes :=
          protocolHistory_implies_CountedVoteLogHistoryConsistent history
        rcases
            countedVotes
              candidate
              voter
              (Or.inl candidateState)
              voterMember
              voterIsCandidate with
          ⟨vote⟩
        have grantCarries :=
          choiceSupport_countedVote_grant_carries_choiceIndexPrefix
            history
            core
            core.electionLogs.counted.logs.logMatching
            leaderUniqueness
            target
            support
            vote
            targetEarlier
        have requestBody :
            vote.counted.responseOrigin.request.body =
              .requestVoteRequest
                vote.counted.responseOrigin.lastTerm
                vote.counted.responseOrigin.lastIndex
                false := by
          have sentBody := congrArg Message.body vote.send.message_eq
          have sentFacts := sentBody.symm
          simp [requestVoteMessage,
            vote.counted.responseOrigin.request_body] at sentFacts
          simpa [sentFacts.2.2] using
            vote.counted.responseOrigin.request_body
        have carriesAtSend :=
          requestVoteLogOK_carries_chosenPrefix_with_term
            history
            core.electionLogs.counted.logs.monoLogs
            core.electionLogs.counted.logs.logMatching
            leaderUniqueness
            target
            targetBoundary
            (occurs_before_stateAt
              vote.counted.responseOrigin.occurrence)
            vote.send
            requestBody
            vote.log_ok
            grantCarries
        have sendAt := occurs_before_stateAt vote.send.occurrence
        have monoAtSend : MonoLogInv vote.send.sendState := by
          intro node nonempty
          exact
            core.electionLogs.counted.logs.monoLogs
              vote.send.sendState sendAt node nonempty
        exact
          chosenCommitCertificate_prefix_retained_to_endpoint
            leaderUniqueness
            target
            targetBoundary
            sendAt
            carriesAtSend.2
            carriesAtSend.1

