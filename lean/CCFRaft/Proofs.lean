theorem historicalCompleteSafetyCore_implies_CountedCandidateFormationToPotentialOverlap
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (prefixCores :
      forall {prefixActions prefixState},
        prefixActions <+: actions ->
          ProtocolHistory start prefixActions prefixState ->
            HistoricalCompleteSafetyCore
              start prefixActions prefixState)
    (action : Action)
    (enabled : Enabled state action) :
    CountedCandidateFormationToPotentialOverlap
      start actions state action := by
  have requestVotes :=
    queueHistory_implies_RequestVoteMessageHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent history)
  intro formedCandidate formation formedState formedQuorum
    otherState otherAt otherCandidate otherCandidateState
    otherQuorum sameTerm
  have formedConfigurations :=
    quorumFormation_configurations_eq formation
  rcases
      stateAt_append_singleton_cases history enabled otherAt with
    otherOld | otherFinal
  · rcases
        quorumFormation_overlaps_historical_potential
          history core prefixCores formation enabled formedState formedQuorum
          otherOld otherCandidateState otherQuorum sameTerm with
      ⟨formedConfiguration, otherConfiguration,
        formedMember, otherMember, sameNodes⟩
    exact
      ⟨formedConfiguration, otherConfiguration,
        by
          simpa [formedConfigurations] using formedMember,
        otherMember,
        sameNodes⟩
  · subst otherState
    rcases
        endpoint_potential_candidate_snapshot_or_formation
          history requestVotes action otherCandidate enabled
          otherCandidateState with
      otherSnapshot | otherFormation
    · have oldOtherQuorum :=
        potentialCandidateQuorum_before_of_snapshot
          otherSnapshot otherQuorum
      have oldSameTerm :
          (next state action).currentTerm formedCandidate =
            state.currentTerm otherCandidate := by
        simpa [otherSnapshot.current_term] using sameTerm
      rcases
          quorumFormation_overlaps_historical_potential
            history core prefixCores formation enabled formedState formedQuorum
            (protocolHistory_final_stateAt history)
            otherSnapshot.candidate_state oldOtherQuorum oldSameTerm with
        ⟨formedConfiguration, otherConfiguration,
          formedMember, otherMember, sameNodes⟩
      exact
        ⟨formedConfiguration, otherConfiguration,
          by
            simpa [formedConfigurations] using formedMember,
          by
            simpa [otherSnapshot.configurations] using otherMember,
          sameNodes⟩
    · have candidatesEq :=
        quorumPotentialFormationAction_candidate_unique
          formation otherFormation
      subst otherCandidate
      rcases
          quorumFormation_candidateWitness_before
            history core formation enabled formedState with
        ⟨formedWitness⟩
      have memberAfter :
          formedWitness.basis.certificate.configuration ∈
            (next state action).configurations formedCandidate := by
        simpa [formedConfigurations] using
          formedWitness.basis.configuration_mem
      exact
        ⟨formedWitness.basis.certificate.configuration,
          formedWitness.basis.certificate.configuration,
          memberAfter, memberAfter, rfl⟩

