    (enabled : Enabled state action)
    (candidateAt :
      StateAt
        start
        (actions ++ [action])
        (next state action)
        candidateState)
    (candidateRole :
      candidateState.leadershipState candidate = .candidate)
    (higherTerm :
      certificate.choiceTerm <
        candidateState.currentTerm candidate)
    (candidateQuorum :
      PotentialCandidateQuorum candidateState candidate) :
    isLogPrefix
      certificate.chosenPrefix
      (candidateState.log candidate) := by
  rcases
      stateAt_append_singleton_cases history enabled candidateAt with
    candidateOld | candidateFinal
  · exact
      certificate.potential_candidate_barrier
        candidateState
        candidateOld
        candidate
        candidateRole
        higherTerm
        candidateQuorum
  · subst candidateState
    have requestVotes :=
      queueHistory_implies_RequestVoteMessageHistoryConsistent
        (protocolHistory_implies_QueueHistoryConsistent history)
    rcases
        endpoint_potential_candidate_snapshot_or_formation
          history requestVotes action candidate enabled candidateRole with
      snapshot | formation
    · have oldQuorum :=
        potentialCandidateQuorum_before_of_snapshot
          snapshot candidateQuorum
      have oldRetained :=
        certificate.potential_candidate_barrier
          state
          (protocolHistory_final_stateAt history)
          candidate
          snapshot.candidate_state
          (by
            simpa [snapshot.current_term] using higherTerm)
          oldQuorum
      exact
        chosenCommitCertificate_retained_append_step
          history core certificate boundary oldRetained
          (Nat.le_of_lt
            (by simpa [snapshot.current_term] using higherTerm))
          enabled
    · rcases
          potentialFormation_candidateWitness_before
            history core formation enabled candidateRole with
        ⟨candidateWitness⟩
      have oldRetained :=
        potentialFormation_candidate_carries_chosenPrefix
          history
          core
          candidateWitness.basis
          certificate
          boundary
          higherTerm
          formation
          candidateQuorum
          enabled
      rw [potentialFormation_log_eq formation]
