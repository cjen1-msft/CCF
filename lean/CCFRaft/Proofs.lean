private def currentMatchIndexPrefixWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader follower : Node}
    (current :
      CurrentMatchIndexPrefixWitness
        start actions state leader follower)
    (enabled : Enabled state action)
    (nextLeader :
      (next state action).leadershipState leader = .leader)
    (indexEq :
      (next state action).matchIndex leader follower =
        state.matchIndex leader follower)
    (matchPrefixRetained :
      isLogPrefix
        (logPrefix
          (state.log follower)
          (state.matchIndex leader follower))
        ((next state action).log follower)) :
    CurrentMatchIndexPrefixWitness
      start
      (actions ++ [action])
      (next state action)
      leader
      follower := by
  let nextWitness :=
    matchIndexWitness_extend current.matchWitness enabled indexEq
  have acknowledgedPrefixLength :
      (logPrefix
        ((next current.matchWitness.ack.origin.responseState
          (.receive
            follower
            leader
            current.matchWitness.ack.origin.kind.receiveKind)).log follower)
        current.matchWitness.lastLogIndex).length =
          current.matchWitness.lastLogIndex := by
    simp [logPrefix,
      Nat.min_eq_left current.matchWitness.ack.index_bounded]
  have prefixAtOld :
      logPrefix
          ((next current.matchWitness.ack.origin.responseState
            (.receive
              follower
              leader
              current.matchWitness.ack.origin.kind.receiveKind)).log follower)
          current.matchWitness.lastLogIndex =
        logPrefix
          (state.log follower)
          (state.matchIndex leader follower) := by
    have prefixEq :=
      prefix_eq_logPrefix_of_length
        _
        (state.log follower)
        current.matchWitness.lastLogIndex
        current.retained_prefix
        acknowledgedPrefixLength
    simpa [current.matchWitness.index_eq] using prefixEq
  exact {
    matchWitness := nextWitness
    response_term := by
      simpa [nextWitness] using
        current.response_term.trans
          (persistentLeader_currentTerm_step
            state action leader nextLeader).symm
    retained_prefix := by
      simpa [nextWitness, matchIndexWitness_extend, ackWitness_extend] using
        (by
          rw [prefixAtOld]
          exact matchPrefixRetained)
  }

private theorem aeResponse_receiveKind_ne_handleSuccess
