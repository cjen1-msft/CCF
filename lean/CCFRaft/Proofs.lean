theorem logConfigurations_append_reconfiguration
    (entries : List Entry)
    (term : Nat)
    (configuration : Configuration) :
    logConfigurations
        (entries ++
          [{ term := term, content := .reconfiguration configuration }]) =
      logConfigurations entries ++
        [{ index := entries.length + 1, nodes := configuration }] := by
  rw [logConfigurations_append]
  simp [configurationsInEntries, configurationsInEntriesAux,
    Nat.add_comm]

theorem activeLogConfigurations_append_reconfiguration
    (entries : List Entry)
    (commitIndex term : Nat)
    (configuration : Configuration)
    (commitWithin : commitIndex <= entries.length) :
    activeLogConfigurations
        (entries ++
          [{ term := term, content := .reconfiguration configuration }])
        commitIndex =
      activeLogConfigurations entries commitIndex ++
        [{ index := entries.length + 1, nodes := configuration }] := by
  let nextConfiguration : ConfigurationAt :=
    { index := entries.length + 1, nodes := configuration }
  have afterCommit : commitIndex < nextConfiguration.index := by
    dsimp [nextConfiguration]
    omega
  have thresholdWithin :
      lastConfigurationToIndex
          (logConfigurations entries)
          commitIndex <=
        nextConfiguration.index := by
    exact Nat.le_trans
      (lastConfigurationToIndex_le
        (logConfigurations entries)
        commitIndex)
      (Nat.le_of_lt afterCommit)
  simp only [activeLogConfigurations]
  rw [logConfigurations_append_reconfiguration]
  change
    configurationsFromIndex
        (logConfigurations entries ++ [nextConfiguration])
        (lastConfigurationToIndex
          (logConfigurations entries ++ [nextConfiguration])
          commitIndex) =
      configurationsFromIndex
          (logConfigurations entries)
          (lastConfigurationToIndex
            (logConfigurations entries)
            commitIndex) ++
        [nextConfiguration]
  rw [lastConfigurationToIndex_append_after
    (logConfigurations entries) nextConfiguration commitIndex afterCommit]
  simp [configurationsFromIndex, List.filter_append, thresholdWithin]

theorem foldl_lastConfigurationToIndex_ge_initial
    (configurations : List ConfigurationAt)
    (commitIndex initial : Nat) :
    initial <=
      configurations.foldl
        (fun result configuration =>
          if configuration.index <= commitIndex then
            max result configuration.index
          else
            result)
        initial := by
  induction configurations generalizing initial with
  | nil =>
      simp
  | cons configuration rest inductionHypothesis =>
      by_cases withinCommit : configuration.index <= commitIndex
      · simp [withinCommit]
        exact Nat.le_trans
          (Nat.le_max_left initial configuration.index)
          (inductionHypothesis (max initial configuration.index))
      · simp [withinCommit]
        exact inductionHypothesis initial

theorem configuration_index_le_foldl_lastConfigurationToIndex
    (configurations : List ConfigurationAt)
    (configuration : ConfigurationAt)
    (commitIndex initial : Nat)
    (member : configuration ∈ configurations)
    (withinCommit : configuration.index <= commitIndex) :
    configuration.index <=
      configurations.foldl
        (fun result current =>
          if current.index <= commitIndex then
            max result current.index
          else
            result)
        initial := by
  induction configurations generalizing initial with
  | nil =>
      simp at member
  | cons head rest inductionHypothesis =>
      simp only [List.mem_cons] at member
      by_cases headWithin : head.index <= commitIndex
      · simp [headWithin]
        rcases member with isHead | inRest
        · subst head
          exact Nat.le_trans
            (Nat.le_max_right initial configuration.index)
            (foldl_lastConfigurationToIndex_ge_initial
              rest commitIndex (max initial configuration.index))
        · exact inductionHypothesis
            (max initial head.index) inRest
      · simp [headWithin]
        rcases member with isHead | inRest
        · subst head
          contradiction
        · exact inductionHypothesis initial inRest

theorem configuration_index_le_lastConfigurationToIndex
    (configurations : List ConfigurationAt)
    (configuration : ConfigurationAt)
    (commitIndex : Nat)
    (member : configuration ∈ configurations)
    (withinCommit : configuration.index <= commitIndex) :
    configuration.index <=
      lastConfigurationToIndex configurations commitIndex := by
  exact
    configuration_index_le_foldl_lastConfigurationToIndex
      configurations configuration commitIndex 0 member withinCommit

theorem foldl_lastConfigurationToIndex_eq_initial_or_mem
    (configurations : List ConfigurationAt)
    (commitIndex initial : Nat) :
    Or
      (configurations.foldl
          (fun result configuration =>
            if configuration.index <= commitIndex then
              max result configuration.index
            else
              result)
          initial =
        initial)
      (Exists fun configuration =>
        And
          (configuration ∈ configurations)
          (configuration.index =
            configurations.foldl
              (fun result current =>
                if current.index <= commitIndex then
                  max result current.index
                else
                  result)
              initial)) := by
  induction configurations generalizing initial with
  | nil =>
      simp
  | cons configuration rest inductionHypothesis =>
      let nextInitial :=
        if configuration.index <= commitIndex then
          max initial configuration.index
        else
          initial
      rcases inductionHypothesis nextInitial with unchanged | ⟨selected,
          selectedMember, selectedIndex⟩
      · by_cases withinCommit : configuration.index <= commitIndex
        · by_cases withinInitial : configuration.index <= initial
          · left
            simpa [nextInitial, withinCommit,
              max_eq_left withinInitial] using unchanged
          · right
            refine ⟨configuration, by simp, ?_⟩
            simpa [nextInitial, withinCommit,
              max_eq_right (Nat.le_of_not_ge withinInitial)] using
                unchanged.symm
        · left
          simpa [nextInitial, withinCommit] using unchanged
      · right
        refine ⟨selected, by simp [selectedMember], ?_⟩
        simpa [nextInitial] using selectedIndex

theorem lastConfigurationToIndex_eq_zero_or_mem
    (configurations : List ConfigurationAt)
    (commitIndex : Nat) :
    Or
      (lastConfigurationToIndex configurations commitIndex = 0)
      (Exists fun configuration =>
        And
          (configuration ∈ configurations)
          (configuration.index =
            lastConfigurationToIndex configurations commitIndex)) := by
  exact
    foldl_lastConfigurationToIndex_eq_initial_or_mem
      configurations commitIndex 0

theorem foldl_lastConfigurationToIndex_max_initial
    (configurations : List ConfigurationAt)
    (commitIndex initial : Nat) :
    configurations.foldl
        (fun result configuration =>
          if configuration.index <= commitIndex then
            max result configuration.index
          else
            result)
        initial =
      max initial
        (configurations.foldl
          (fun result configuration =>
            if configuration.index <= commitIndex then
              max result configuration.index
            else
              result)
          0) := by
  induction configurations generalizing initial with
  | nil =>
      simp
  | cons configuration rest inductionHypothesis =>
      change
        rest.foldl
            (fun result current =>
              if current.index <= commitIndex then
                max result current.index
              else
                result)
            (if configuration.index <= commitIndex then
              max initial configuration.index
            else
              initial) =
          max initial
            (rest.foldl
              (fun result current =>
                if current.index <= commitIndex then
                  max result current.index
                else
                  result)
              (if configuration.index <= commitIndex then
                max 0 configuration.index
              else
                0))
      rw [inductionHypothesis, inductionHypothesis]
      by_cases withinCommit : configuration.index <= commitIndex
      · simp only [withinCommit, if_pos]
        have zeroConfiguration :
            max 0 configuration.index = configuration.index :=
          max_eq_right (Nat.zero_le configuration.index)
        have zeroTail :
            max 0
                (rest.foldl
                  (fun result current =>
                    if current.index <= commitIndex then
                      max result current.index
                    else
                      result)
                  0) =
              rest.foldl
                (fun result current =>
                  if current.index <= commitIndex then
                    max result current.index
                  else
                    result)
                0 :=
          max_eq_right (Nat.zero_le _)
        rw [zeroConfiguration, zeroTail]
        rw [inductionHypothesis configuration.index]
        simp [max_assoc]
      · simp [withinCommit]

theorem foldl_lastConfiguration_filter_lower
    (configurations : List ConfigurationAt)
    (lowerBound commitIndex initial : Nat)
    (lowerWithinInitial : lowerBound <= initial) :
    (configurations.filter
      (fun configuration => lowerBound <= configuration.index)).foldl
        (fun result configuration =>
          if configuration.index <= commitIndex then
            max result configuration.index
          else
            result)
        initial =
      configurations.foldl
        (fun result configuration =>
          if configuration.index <= commitIndex then
            max result configuration.index
          else
            result)
        initial := by
  induction configurations generalizing initial with
  | nil =>
      simp
  | cons configuration rest inductionHypothesis =>
      by_cases afterLower : lowerBound <= configuration.index
      · by_cases withinCommit : configuration.index <= commitIndex
        · simpa [afterLower, withinCommit] using
            inductionHypothesis
            (max initial configuration.index)
            (Nat.le_trans lowerWithinInitial
              (Nat.le_max_left initial configuration.index))
        · simpa [afterLower, withinCommit] using
            inductionHypothesis initial lowerWithinInitial
      · have beforeInitial : configuration.index <= initial := by
          omega
        by_cases withinCommit : configuration.index <= commitIndex
        · simpa [afterLower, withinCommit,
            max_eq_left beforeInitial] using
              inductionHypothesis initial lowerWithinInitial
        · simpa [afterLower, withinCommit] using
            inductionHypothesis initial lowerWithinInitial

theorem lastConfigurationToIndex_configurationsFromIndex
    (configurations : List ConfigurationAt)
    (oldCommitIndex newCommitIndex : Nat)
    (commitMonotonic : oldCommitIndex <= newCommitIndex) :
    lastConfigurationToIndex
        (configurationsFromIndex
          configurations
          (lastConfigurationToIndex configurations oldCommitIndex))
        newCommitIndex =
      lastConfigurationToIndex configurations newCommitIndex := by
  let lowerBound :=
    lastConfigurationToIndex configurations oldCommitIndex
  have lowerWithinNew : lowerBound <= newCommitIndex := by
    exact Nat.le_trans
      (lastConfigurationToIndex_le configurations oldCommitIndex)
      commitMonotonic
  have filteredFold :=
    foldl_lastConfiguration_filter_lower
      configurations lowerBound newCommitIndex lowerBound
      (Nat.le_refl lowerBound)
  have lowerWithinFull :
      lowerBound <=
        lastConfigurationToIndex configurations newCommitIndex := by
    rcases lastConfigurationToIndex_eq_zero_or_mem
        configurations oldCommitIndex with lowerZero | ⟨configuration,
          member, configurationIndex⟩
    · simp [lowerBound, lowerZero]
    · change
        lastConfigurationToIndex configurations oldCommitIndex <=
          lastConfigurationToIndex configurations newCommitIndex
      rw [← configurationIndex]
      exact configuration_index_le_lastConfigurationToIndex
        configurations configuration newCommitIndex member
        (Nat.le_trans
          (by
            rw [configurationIndex]
            exact lastConfigurationToIndex_le
              configurations oldCommitIndex)
          commitMonotonic)
  have lowerWithinFiltered :
      lowerBound <=
        lastConfigurationToIndex
          (configurationsFromIndex configurations lowerBound)
          newCommitIndex := by
    rcases lastConfigurationToIndex_eq_zero_or_mem
        configurations oldCommitIndex with lowerZero | ⟨configuration,
          member, configurationIndex⟩
    · simp [lowerBound, lowerZero]
    · change
        lastConfigurationToIndex configurations oldCommitIndex <=
          lastConfigurationToIndex
            (configurationsFromIndex
              configurations
              (lastConfigurationToIndex configurations oldCommitIndex))
            newCommitIndex
      rw [← configurationIndex]
      apply configuration_index_le_lastConfigurationToIndex
        (configurationsFromIndex configurations configuration.index)
        configuration
        newCommitIndex
      · simp [configurationsFromIndex, member]
      · rw [configurationIndex]
        exact Nat.le_trans
          (lastConfigurationToIndex_le
            configurations oldCommitIndex)
          commitMonotonic
  unfold lastConfigurationToIndex
  change
    (configurations.filter
      (fun configuration => lowerBound <= configuration.index)).foldl
        (fun result configuration =>
          if configuration.index <= newCommitIndex then
            max result configuration.index
          else
            result)
        0 =
      configurations.foldl
        (fun result configuration =>
          if configuration.index <= newCommitIndex then
            max result configuration.index
          else
            result)
        0
  change
    lowerBound <=
      (configurations.filter
        (fun configuration => lowerBound <= configuration.index)).foldl
          (fun result configuration =>
            if configuration.index <= newCommitIndex then
              max result configuration.index
            else
              result)
          0 at lowerWithinFiltered
  change
    lowerBound <=
      configurations.foldl
        (fun result configuration =>
          if configuration.index <= newCommitIndex then
            max result configuration.index
          else
            result)
        0 at lowerWithinFull
  rw [foldl_lastConfigurationToIndex_max_initial
    (configurations.filter
      (fun configuration => lowerBound <= configuration.index))
    newCommitIndex
    lowerBound] at filteredFold
  rw [max_eq_right lowerWithinFiltered] at filteredFold
  rw [foldl_lastConfigurationToIndex_max_initial
    configurations newCommitIndex lowerBound] at filteredFold
  rw [max_eq_right lowerWithinFull] at filteredFold
  exact filteredFold

theorem lastConfigurationToIndex_mono
    (configurations : List ConfigurationAt)
    (oldCommitIndex newCommitIndex : Nat)
    (commitMonotonic : oldCommitIndex <= newCommitIndex) :
    lastConfigurationToIndex configurations oldCommitIndex <=
      lastConfigurationToIndex configurations newCommitIndex := by
  rcases lastConfigurationToIndex_eq_zero_or_mem
      configurations oldCommitIndex with oldZero | ⟨configuration,
        member, configurationIndex⟩
  · simp [oldZero]
  · rw [← configurationIndex]
    exact configuration_index_le_lastConfigurationToIndex
      configurations configuration newCommitIndex member
      (Nat.le_trans
        (by
          rw [configurationIndex]
          exact lastConfigurationToIndex_le
            configurations oldCommitIndex)
        commitMonotonic)

theorem activeLogConfigurations_advanceCommit
    (entries : List Entry)
    (oldCommitIndex newCommitIndex : Nat)
    (commitMonotonic : oldCommitIndex <= newCommitIndex) :
    configurationsFromIndex
        (activeLogConfigurations entries oldCommitIndex)
        (lastConfigurationToIndex
          (activeLogConfigurations entries oldCommitIndex)
          newCommitIndex) =
      activeLogConfigurations entries newCommitIndex := by
  simp only [activeLogConfigurations]
  rw [lastConfigurationToIndex_configurationsFromIndex
    (logConfigurations entries)
    oldCommitIndex
    newCommitIndex
    commitMonotonic]
  simp only [configurationsFromIndex, List.filter_filter]
  apply List.filter_congr
  intro configuration _
  have thresholdsMonotonic :=
    lastConfigurationToIndex_mono
      (logConfigurations entries)
      oldCommitIndex
      newCommitIndex
      commitMonotonic
  by_cases afterOld :
      lastConfigurationToIndex
          (logConfigurations entries)
          oldCommitIndex <=
        configuration.index
  all_goals
    by_cases afterNew :
      lastConfigurationToIndex
          (logConfigurations entries)
          newCommitIndex <=
        configuration.index
    all_goals
      simp [afterOld, afterNew] <;>
      omega

theorem foldl_lastConfigurationToIndex_of_after_commit
    (configurations : List ConfigurationAt)
    (commitIndex initial : Nat)
    (afterCommit :
      forall configuration,
        configuration ∈ configurations ->
          commitIndex < configuration.index) :
    configurations.foldl
        (fun result configuration =>
          if configuration.index <= commitIndex then
            max result configuration.index
          else
            result)
        initial =
      initial := by
  induction configurations generalizing initial with
  | nil =>
      simp
  | cons configuration rest inductionHypothesis =>
      have headAfter : commitIndex < configuration.index :=
        afterCommit configuration (by simp)
      have headNotWithin : ¬ configuration.index <= commitIndex := by
        omega
      simp only [List.foldl_cons, if_neg headNotWithin]
      exact inductionHypothesis initial fun current member =>
        afterCommit current (by simp [member])

theorem lastConfigurationToIndex_le_head_of_tail_after
    (head : ConfigurationAt)
    (tail : List ConfigurationAt)
    (commitIndex : Nat)
    (tailAfter :
      forall configuration,
        configuration ∈ tail ->
          commitIndex < configuration.index) :
    lastConfigurationToIndex (head :: tail) commitIndex <= head.index := by
  unfold lastConfigurationToIndex
  simp only [List.foldl_cons]
  rw [foldl_lastConfigurationToIndex_of_after_commit
    tail
    commitIndex
    (if head.index <= commitIndex then max 0 head.index else 0)
    tailAfter]
  by_cases headWithin : head.index <= commitIndex
  · simp [headWithin]
  · simp [headWithin]

theorem advanceConfigurations_eq_fromIndex
    (configurations : List ConfigurationAt)
    (commitIndex : Nat)
    (increasing : increasingConfigurationIndices configurations) :
    (match nextConfigurationIndex? configurations with
    | some nextIndex =>
        if nextIndex <= commitIndex then
          configurationsFromIndex
            configurations
            (lastConfigurationToIndex configurations commitIndex)
        else
          configurations
    | none => configurations) =
      configurationsFromIndex
        configurations
        (lastConfigurationToIndex configurations commitIndex) := by
  cases configurations with
  | nil =>
      simp [nextConfigurationIndex?, configurationsFromIndex,
        lastConfigurationToIndex]
  | cons first rest =>
      cases rest with
      | nil =>
          by_cases firstWithin : first.index <= commitIndex <;>
            simp [nextConfigurationIndex?, configurationsFromIndex,
              lastConfigurationToIndex, firstWithin]
      | cons second tail =>
          have pairwise :
              (first :: second :: tail).Pairwise
                fun earlier later => earlier.index < later.index :=
            increasing
          have firstBeforeRest :
              forall configuration,
                configuration ∈ second :: tail ->
                  first.index < configuration.index :=
            (List.pairwise_cons.mp pairwise).1
          have secondBeforeTail :
              forall configuration,
                configuration ∈ tail ->
                  second.index < configuration.index :=
            (List.pairwise_cons.mp
              (List.pairwise_cons.mp pairwise).2).1
          by_cases nextCommitted : second.index <= commitIndex
          · simp [nextConfigurationIndex?, nextCommitted]
          · have tailAfter :
                forall configuration,
                  configuration ∈ second :: tail ->
                    commitIndex < configuration.index := by
              intro configuration member
              simp only [List.mem_cons] at member
              rcases member with isSecond | inTail
              · subst configuration
                omega
              · have := secondBeforeTail configuration inTail
                omega
            have thresholdWithinFirst :
                lastConfigurationToIndex
                    (first :: second :: tail)
                    commitIndex <=
                  first.index :=
              lastConfigurationToIndex_le_head_of_tail_after
                first
                (second :: tail)
                commitIndex
                tailAfter
            change
              (if second.index <= commitIndex then
                configurationsFromIndex
                  (first :: second :: tail)
                  (lastConfigurationToIndex
                    (first :: second :: tail)
                    commitIndex)
              else
                first :: second :: tail) =
              configurationsFromIndex
                (first :: second :: tail)
                (lastConfigurationToIndex
                  (first :: second :: tail)
                  commitIndex)
            rw [if_neg nextCommitted]
            symm
            apply List.filter_eq_self.2
            intro configuration member
            simp only [decide_eq_true_eq]
            simp only [List.mem_cons] at member
            rcases member with isFirst | inRest
            · subst configuration
              exact thresholdWithinFirst
            · exact Nat.le_trans
                thresholdWithinFirst
                (Nat.le_of_lt
                  (firstBeforeRest configuration
                    (by simpa only [List.mem_cons] using inRest)))

theorem configurationsInEntriesAux_filter_ge_start
    (firstIndex : Nat)
    (entries : List Entry) :
    (configurationsInEntriesAux firstIndex entries).filter
        (fun configuration => firstIndex <= configuration.index) =
      configurationsInEntriesAux firstIndex entries := by
  apply List.filter_eq_self.2
  intro configuration member
  simp only [decide_eq_true_eq]
  exact
    (mem_configurationsInEntriesAux
      firstIndex entries configuration member).1

theorem configurationsInEntriesAux_drop
    (firstIndex : Nat)
    (entries : List Entry)
    (count : Nat) :
    configurationsInEntriesAux
        (firstIndex + count)
        (entries.drop count) =
      (configurationsInEntriesAux firstIndex entries).filter
        (fun configuration =>
          firstIndex + count <= configuration.index) := by
  induction entries generalizing firstIndex count with
  | nil =>
      simp [configurationsInEntriesAux]
  | cons entry rest inductionHypothesis =>
      cases count with
      | zero =>
          exact
            (configurationsInEntriesAux_filter_ge_start
              firstIndex
              (entry :: rest)).symm
      | succ count =>
          cases content : entry.content <;>
            simpa [configurationsInEntriesAux, content,
              Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
                inductionHypothesis (firstIndex + 1) count

theorem logConfigurations_drop
    (entries : List Entry)
    (count : Nat) :
    configurationsInEntries (count + 1) (entries.drop count) =
      (logConfigurations entries).filter
        (fun configuration => count < configuration.index) := by
  simpa [logConfigurations, configurationsInEntries,
    Nat.add_comm, Nat.lt_iff_add_one_le] using
      configurationsInEntriesAux_drop 1 entries count

theorem upsertConfiguration_eq_self_of_mem
    (configurations : List ConfigurationAt)
    (configuration : ConfigurationAt)
    (increasing : increasingConfigurationIndices configurations)
    (member : configuration ∈ configurations) :
    upsertConfiguration configurations configuration =
      configurations := by
  induction configurations with
  | nil =>
      simp at member
  | cons head rest inductionHypothesis =>
      rw [increasingConfigurationIndices] at increasing
      rw [List.pairwise_cons] at increasing
      simp only [List.mem_cons] at member
      rcases member with isHead | inRest
      · subst configuration
        simp [upsertConfiguration]
      · have headBefore : head.index < configuration.index :=
          increasing.1 configuration inRest
        have notBefore : ¬ configuration.index < head.index := by
          omega
        have notSame : ¬ configuration.index = head.index := by
          omega
        simp [upsertConfiguration, notBefore, notSame,
          inductionHypothesis increasing.2 inRest]

theorem overrideConfigurations_eq_self_of_mem
    (configurations updates : List ConfigurationAt)
    (increasing : increasingConfigurationIndices configurations)
    (updatesPresent :
      forall update,
        update ∈ updates ->
          update ∈ configurations) :
    overrideConfigurations configurations updates =
      configurations := by
  induction updates with
  | nil =>
      simp [overrideConfigurations]
  | cons update rest inductionHypothesis =>
      have updatePresent : update ∈ configurations :=
        updatesPresent update (by simp)
      have restPresent :
          forall current,
            current ∈ rest ->
              current ∈ configurations := by
        intro current member
        exact updatesPresent current (by simp [member])
      rw [overrideConfigurations, List.foldl_cons]
      rw [upsertConfiguration_eq_self_of_mem
        configurations update increasing updatePresent]
      change overrideConfigurations configurations rest = configurations
      exact inductionHypothesis restPresent

theorem upsertConfiguration_eq_append_of_after
    (configurations : List ConfigurationAt)
    (configuration : ConfigurationAt)
    (afterAll :
      forall existing,
        existing ∈ configurations ->
          existing.index < configuration.index) :
    upsertConfiguration configurations configuration =
      configurations ++ [configuration] := by
  induction configurations with
  | nil =>
      simp [upsertConfiguration]
  | cons head rest inductionHypothesis =>
      have headBefore : head.index < configuration.index :=
        afterAll head (by simp)
      have notBefore : ¬ configuration.index < head.index := by
        omega
      have notSame : ¬ configuration.index = head.index := by
        omega
      simp [upsertConfiguration, notBefore, notSame,
        inductionHypothesis (fun existing member =>
          afterAll existing (by simp [member]))]

theorem overrideConfigurations_eq_append_of_after
    (configurations updates : List ConfigurationAt)
    (updatesIncreasing : increasingConfigurationIndices updates)
    (afterAll :
      forall existing update,
        existing ∈ configurations ->
          update ∈ updates ->
            existing.index < update.index) :
    overrideConfigurations configurations updates =
      configurations ++ updates := by
  induction updates generalizing configurations with
  | nil =>
      simp [overrideConfigurations]
  | cons update rest inductionHypothesis =>
      rw [increasingConfigurationIndices] at updatesIncreasing
      rw [List.pairwise_cons] at updatesIncreasing
      have updateAfter :
          forall existing,
            existing ∈ configurations ->
              existing.index < update.index := by
        intro existing member
        exact afterAll existing update member (by simp)
      rw [overrideConfigurations, List.foldl_cons]
      rw [upsertConfiguration_eq_append_of_after
        configurations update updateAfter]
      change
        overrideConfigurations (configurations ++ [update]) rest =
          configurations ++ update :: rest
      rw [inductionHypothesis
        (configurations ++ [update])
        updatesIncreasing.2
        (by
          intro existing current existingMember currentMember
          simp only [List.mem_append, List.mem_singleton] at existingMember
          rcases existingMember with oldMember | isUpdate
          · exact afterAll existing current oldMember
              (by simp [currentMember])
          · subst existing
            exact updatesIncreasing.1 current currentMember)]
      simp [List.append_assoc]

theorem lastConfigurationToIndex_append_after_all
    (configurations updates : List ConfigurationAt)
    (commitIndex : Nat)
    (updatesAfter :
      forall update,
        update ∈ updates ->
          commitIndex < update.index) :
    lastConfigurationToIndex
        (configurations ++ updates)
        commitIndex =
      lastConfigurationToIndex configurations commitIndex := by
  unfold lastConfigurationToIndex
  rw [List.foldl_append]
  exact foldl_lastConfigurationToIndex_of_after_commit
    updates
    commitIndex
    (configurations.foldl
      (fun result configuration =>
        if configuration.index <= commitIndex then
          max result configuration.index
        else
          result)
      0)
    updatesAfter

theorem activeLogConfigurations_append
    (entries suffix : List Entry)
    (commitIndex : Nat)
    (commitWithin : commitIndex <= entries.length) :
    activeLogConfigurations (entries ++ suffix) commitIndex =
      activeLogConfigurations entries commitIndex ++
        configurationsInEntries (1 + entries.length) suffix := by
  let updates :=
    configurationsInEntries (1 + entries.length) suffix
  have updatesAfter :
      forall update,
        update ∈ updates ->
          commitIndex < update.index := by
    intro update member
    have lower :=
      (mem_configurationsInEntriesAux
        (1 + entries.length)
        suffix
        update
        member).1
    omega
  have thresholdBeforeUpdates :
      forall update,
        update ∈ updates ->
          lastConfigurationToIndex
              (logConfigurations entries)
              commitIndex <=
            update.index := by
    intro update member
    exact Nat.le_trans
      (lastConfigurationToIndex_le
        (logConfigurations entries)
        commitIndex)
      (Nat.le_of_lt (updatesAfter update member))
  simp only [activeLogConfigurations]
  rw [logConfigurations_append]
  change
    configurationsFromIndex
        (logConfigurations entries ++ updates)
        (lastConfigurationToIndex
          (logConfigurations entries ++ updates)
          commitIndex) =
      configurationsFromIndex
          (logConfigurations entries)
          (lastConfigurationToIndex
            (logConfigurations entries)
            commitIndex) ++
        updates
  rw [lastConfigurationToIndex_append_after_all
    (logConfigurations entries) updates commitIndex updatesAfter]
  simp only [configurationsFromIndex, List.filter_append]
  have updatesKept :
      updates.filter
          (fun configuration =>
            lastConfigurationToIndex
                (logConfigurations entries)
                commitIndex <=
              configuration.index) =
        updates := by
    apply List.filter_eq_self.2
    intro update member
    simp only [decide_eq_true_eq]
    exact thresholdBeforeUpdates update member
  rw [updatesKept]

theorem configurationsBoundedBy_mono
    (configurations : List ConfigurationAt)
    (oldLength newLength : Nat)
    (bounded : configurationsBoundedBy configurations oldLength)
    (lengthMonotonic : oldLength <= newLength) :
    configurationsBoundedBy configurations newLength := by
  intro configuration member
  exact
    ⟨(bounded configuration member).1,
      Nat.le_trans (bounded configuration member).2 lengthMonotonic⟩

theorem configurationsWellFormed_of_unchangedConfigurations
    (before after : State)
    (wellFormed : ConfigurationsWellFormedInv before)
    (configurationsUnchanged :
      forall node,
        after.configurations node = before.configurations node)
    (logLengthMonotonic :
      forall node,
        (before.log node).length <= (after.log node).length) :
    ConfigurationsWellFormedInv after := by
  intro node
  rw [configurationsUnchanged node]
  exact
    ⟨(wellFormed node).1,
      configurationsBoundedBy_mono
        (before.configurations node)
        (before.log node).length
        (after.log node).length
        (wellFormed node).2
        (logLengthMonotonic node)⟩

