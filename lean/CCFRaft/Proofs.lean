      simp [leaderIndexCounterexampleState, initialState, startLog,
        leaderIndexCounterexampleStart, followerMember] <;>
      split <;> omega
  · constructor
    · decide
    · intro after
      have bounds := after 0 1 (by decide)
      have impossible := bounds.1
      have afterMatch :
          (next
              leaderIndexCounterexampleState
              leaderIndexCounterexampleAction).matchIndex 0 1 =
            3 := by
        decide
      have afterSent :
          (next
              leaderIndexCounterexampleState
              leaderIndexCounterexampleAction).sentIndex 0 1 =
            2 := by
        decide
      rw [afterMatch, afterSent] at impossible
      omega

theorem historicalMatchIndex_implies_MatchIndexBoundedByLogInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (_history : ProtocolHistory start actions state)
    (_leaderIndices : LeaderIndexInv state)
    (matchHistory :
      MatchIndexHistoryConsistent start actions state)
    (_matching :
      TemporalLogMatchingInv start actions state)
    (_leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (acknowledgedLogRetained :
      forall leader follower,
        state.leadershipState leader = .leader ->
          state.currentTerm leader = state.currentTerm follower ->
            forall witness :
                MatchIndexWitness
                  start actions state leader follower,
              ((next
                    witness.ack.origin.responseState
                    (.receive
                      follower
                      leader
                      witness.ack.origin.kind.receiveKind)).log
                  follower).length <=
                (state.log follower).length) :
    MatchIndexBoundedByLogInv state := by
  intro leader follower leaderState sameTerm
  by_cases matchIsZero :
      state.matchIndex leader follower = 0
  · omega
  · have matchPositive :
        0 < state.matchIndex leader follower := by
      omega
    rcases
        matchHistory
          leader follower leaderState matchPositive with
      ⟨witness⟩
    rw [witness.index_eq]
    exact Nat.le_trans
      witness.ack.index_bounded
      (acknowledgedLogRetained
        leader follower leaderState sameTerm witness)

