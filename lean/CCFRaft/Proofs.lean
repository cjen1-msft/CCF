private theorem chosenCommitCertificate_counted_barrier_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState candidateState : State}
    {owner candidate : Node}
    {index : Nat}
    {action : Action}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (enabled : Enabled state action)
    (candidateAt :
      StateAt
        start
        (actions ++ [action])
        (next state action)
        candidateState)
    (candidateRole :
      candidateState.leadershipState candidate = .candidate)
    (higherTerm :
      certificate.choiceTerm <
        candidateState.currentTerm candidate)
    (candidateQuorum :
      allConfigurationsHaveQuorum
          (candidateState.votesGranted candidate)
          (candidateState.configurations candidate) =
        true) :
    isLogPrefix
      certificate.chosenPrefix
      (candidateState.log candidate) := by
  rcases
      stateAt_append_singleton_cases history enabled candidateAt with
    candidateOld | candidateFinal
  · exact
      certificate.counted_candidate_barrier
        candidateState
        candidateOld
        candidate
        candidateRole
        higherTerm
        candidateQuorum
  · subst candidateState
    rcases
        endpoint_candidate_snapshot_or_formation
          state action candidate enabled candidateRole with
      snapshot | formation
    · have oldQuorum :
          allConfigurationsHaveQuorum
              (state.votesGranted candidate)
              (state.configurations candidate) =
            true := by
        simpa [snapshot.votes_granted,
          snapshot.configurations] using candidateQuorum
      have oldRetained :=
        certificate.counted_candidate_barrier
          state
          (protocolHistory_final_stateAt history)
          candidate
          snapshot.candidate_state
          (by
            simpa [snapshot.current_term] using higherTerm)
          oldQuorum
      exact
        chosenCommitCertificate_retained_append_step
          history core certificate boundary oldRetained
          (Nat.le_of_lt
            (by simpa [snapshot.current_term] using higherTerm))
          enabled
    · rcases
          quorumFormation_candidateWitness_before
            history core formation enabled candidateRole with
        ⟨candidateWitness⟩
      have oldRetained :=
        quorumFormation_candidate_carries_chosenPrefix
          history
          core
          candidateWitness.basis
          certificate
          boundary
          higherTerm
          formation
          candidateQuorum
          enabled
      rw [quorumFormation_log_eq formation]
      exact oldRetained

private theorem chosenCommitCertificate_potential_barrier_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState candidateState : State}
    {owner candidate : Node}
    {index : Nat}
    {action : Action}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (boundary :
