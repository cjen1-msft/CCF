import CCFRaft.Properties
import Mathlib.Data.Finset.Max

/-!
# CCFRaft proofs

The final theorem is derived from exact enabled-action histories and a
hereditary chosen-commit core. The proof introduces no safety assumptions.
-/

set_option autoImplicit false

namespace CCFRaft.Proofs

open Model
open Properties

theorem replays_append_singleton
    {before middle : State}
    {actions : List Action}
    {action : Action}
    (replay : Replays before actions middle)
    (enabled : Enabled middle action) :
    Replays before (actions ++ [action]) (next middle action) := by
  induction actions generalizing before with
  | nil =>
      simp [Replays] at replay
      subst middle
      exact ⟨enabled, rfl⟩
  | cons head tail inductionHypothesis =>
      rcases replay with ⟨headEnabled, tailReplay⟩
      exact
        ⟨headEnabled,
          inductionHypothesis tailReplay⟩

theorem replays_deterministic
    {before firstAfter secondAfter : State}
    {actions : List Action}
    (firstReplay : Replays before actions firstAfter)
    (secondReplay : Replays before actions secondAfter) :
    firstAfter = secondAfter := by
  induction actions generalizing before with
  | nil =>
      simp [Replays] at firstReplay secondReplay
      exact firstReplay.trans secondReplay.symm
  | cons action tail inductionHypothesis =>
      rcases firstReplay with ⟨_firstEnabled, firstTail⟩
      rcases secondReplay with ⟨_secondEnabled, secondTail⟩
      exact inductionHypothesis firstTail secondTail

theorem replays_append_split
    {before after : State}
    {first second : List Action}
    (replay : Replays before (first ++ second) after) :
    Exists fun middle =>
      And
        (Replays before first middle)
        (Replays middle second after) := by
  induction first generalizing before with
  | nil =>
      exact ⟨before, rfl, replay⟩
  | cons action tail inductionHypothesis =>
      rcases replay with ⟨enabled, tailReplay⟩
      rcases inductionHypothesis tailReplay with
        ⟨middle, firstReplay, secondReplay⟩
      exact
        ⟨middle,
          ⟨enabled, firstReplay⟩,
          secondReplay⟩

private theorem prefix_append_singleton_cases
    {α : Type}
    {prefixActions actions : List α}
    {last : α}
    (isPrefix : prefixActions <+: actions ++ [last]) :
    Or
      (prefixActions <+: actions)
      (prefixActions = actions ++ [last]) := by
  by_cases withinOld : prefixActions.length <= actions.length
  · exact Or.inl
      ((List.isPrefix_append_of_length withinOld).mp isPrefix)
  · right
    apply isPrefix.eq_of_length
    have withinExtended := isPrefix.length_le
    simp only [List.length_append, List.length_singleton] at withinExtended ⊢
    omega

theorem replays_reachable
    {start : InitialConfiguration}
    {before after : State}
    {actions : List Action}
    (beforeReachable : Reachable start before)
    (replay : Replays before actions after) :
    Reachable start after := by
  induction actions generalizing before with
  | nil =>
      simp [Replays] at replay
      subst after
      exact beforeReachable
  | cons action tail inductionHypothesis =>
      rcases replay with ⟨enabled, tailReplay⟩
      exact inductionHypothesis
        (ExecutableTransitionSystem.Reachable.step
          beforeReachable enabled)
        tailReplay

theorem historicallyReachable_step
    {start : InitialConfiguration}
    (state : State)
    (action : Action)
    (historical : HistoricallyReachable start state)
    (enabled : Enabled state action) :
    HistoricallyReachable start (next state action) := by
  rcases historical with ⟨actions, replay⟩
  exact
    ⟨actions ++ [action],
      replays_append_singleton replay enabled⟩

theorem reachable_hasProtocolHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    HistoricallyReachable start state := by
  exact
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := HistoricallyReachable start)
      ⟨[], rfl⟩
      (historicallyReachable_step (start := start))
      reachable

theorem historicallyReachable_iff_reachable
    (start : InitialConfiguration)
    (state : State) :
    HistoricallyReachable start state ↔ Reachable start state := by
  constructor
  · intro historical
    rcases historical with ⟨actions, replay⟩
    exact replays_reachable
      ExecutableTransitionSystem.Reachable.initial replay
  · exact reachable_hasProtocolHistory

theorem protocolHistory_reachable
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    Reachable start state :=
  replays_reachable
    ExecutableTransitionSystem.Reachable.initial
    history

theorem stateAt_reachable
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state : State}
    (stateAt : StateAt start actions endState state) :
    Reachable start state := by
  rcases stateAt with ⟨witness⟩
  exact protocolHistory_reachable witness.stateHistory

theorem stateAt_append_singleton_cases
    {start : InitialConfiguration}
    {actions : List Action}
    {state historicalState : State}
    {action : Action}
    (history : ProtocolHistory start actions state)
    (enabled : Enabled state action)
    (stateAt :
      StateAt
        start
        (actions ++ [action])
        (next state action)
        historicalState) :
    Or
      (StateAt start actions state historicalState)
      (historicalState = next state action) := by
  rcases stateAt with ⟨witness⟩
  have pastIsPrefix :
      witness.pastActions <+: actions ++ [action] :=
    ⟨witness.futureActions, witness.actions_eq.symm⟩
  rcases prefix_append_singleton_cases pastIsPrefix with
    oldPrefix | allActions
  · rcases oldPrefix with ⟨oldFuture, oldActionsEq⟩
    have oldReplay :
        ProtocolHistory
          start
          (witness.pastActions ++ oldFuture)
          state := by
      rw [oldActionsEq]
      exact history
    rcases replays_append_split oldReplay with
      ⟨middle, pastReplay, futureReplay⟩
    have historicalEq : historicalState = middle :=
      replays_deterministic witness.stateHistory pastReplay
    left
    exact ⟨{
      pastActions := witness.pastActions
      futureActions := oldFuture
      actions_eq := oldActionsEq.symm
      stateHistory := witness.stateHistory
      remainingHistory := by
        simpa only [historicalEq] using futureReplay
    }⟩
  · have historicalReplay :
        ProtocolHistory
          start
          (actions ++ [action])
          historicalState := by
      simpa only [allActions] using witness.stateHistory
    right
    exact replays_deterministic
      historicalReplay
      (replays_append_singleton history enabled)

theorem protocolHistory_final_stateAt
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    StateAt start actions state state := by
  exact ⟨{
    pastActions := actions
    futureActions := []
    actions_eq := by simp
    stateHistory := history
    remainingHistory := rfl
  }⟩

theorem protocolHistory_initial_stateAt
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    StateAt start actions state (initialState start) := by
  exact ⟨{
    pastActions := []
    futureActions := actions
    actions_eq := by simp
    stateHistory := rfl
    remainingHistory := history
  }⟩

private theorem stateAt_initial_eq
    {start : InitialConfiguration}
    {historicalState : State}
    (stateAt :
      StateAt start [] (initialState start) historicalState) :
    historicalState = initialState start := by
  rcases stateAt with ⟨witness⟩
  have emptyParts :
      witness.pastActions = [] ∧ witness.futureActions = [] := by
    simpa using witness.actions_eq.symm
  have history := witness.stateHistory
  rw [emptyParts.1] at history
  simpa [ProtocolHistory, Replays] using history

theorem entryAt?_eq_none_of_length_lt
    (entries : List Entry)
    (index : Nat)
    (beyond : entries.length < index) :
    entryAt? entries index = none := by
  unfold entryAt?
  split
  · rfl
  · rw [List.getElem?_eq_none]
    omega

theorem protocolHistory_append_occurs
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    (history : ProtocolHistory start actions state)
    (enabled : Enabled state action) :
    Occurs
      start
      (actions ++ [action])
      (next state action)
      state
      action := by
  exact ⟨{
    pastActions := actions
    futureActions := []
    actions_eq := by simp
    before_history := history
    enabled
    after_history := rfl
  }⟩

theorem occurs_before_reachable
    {start : InitialConfiguration}
    {actions : List Action}
    {endState before : State}
    {action : Action}
    (occurs : Occurs start actions endState before action) :
    Reachable start before := by
  rcases occurs with ⟨witness⟩
  exact protocolHistory_reachable witness.before_history

theorem occurs_before_stateAt
    {start : InitialConfiguration}
    {actions : List Action}
    {endState before : State}
    {action : Action}
    (occurs : Occurs start actions endState before action) :
    StateAt start actions endState before := by
  rcases occurs with ⟨witness⟩
  exact ⟨{
    pastActions := witness.pastActions
    futureActions := action :: witness.futureActions
    actions_eq := by
      simpa only [List.singleton_append, List.append_assoc] using
        witness.actions_eq
    stateHistory := witness.before_history
    remainingHistory :=
      ⟨witness.enabled, witness.after_history⟩
  }⟩

theorem occurs_after_stateAt
    {start : InitialConfiguration}
    {actions : List Action}
    {endState before : State}
    {action : Action}
    (occurs : Occurs start actions endState before action) :
    StateAt start actions endState (next before action) := by
  rcases occurs with ⟨witness⟩
  exact ⟨{
    pastActions := witness.pastActions ++ [action]
    futureActions := witness.futureActions
    actions_eq := by
      simpa only [List.append_assoc] using witness.actions_eq
    stateHistory :=
      replays_append_singleton witness.before_history witness.enabled
    remainingHistory := witness.after_history
  }⟩

theorem historicalMonoLog_current
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (historicalMono :
      HistoricalMonoLogInv start actions state) :
    MonoLogInv state :=
  historicalMono state (protocolHistory_final_stateAt history)

theorem temporalLogMatching_current
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state) :
    LogMatchingInv state := by
  intro firstNode secondNode _ index positive bounded sameTerm
  exact matching
    state state
    (protocolHistory_final_stateAt history)
    (protocolHistory_final_stateAt history)
    firstNode secondNode index positive bounded sameTerm

theorem extendedStateAt_hasHistoricalLogPrefixOrigin
    {start : InitialConfiguration}
    {actions : List Action}
    {state examinedState : State}
    {action : Action}
    (history : ProtocolHistory start actions state)
    (enabled : Enabled state action)
    (origins :
      forall node : Node,
        HistoricalLogPrefixOrigin
          start actions state ((next state action).log node))
    (stateAt :
      StateAt
        start
        (actions ++ [action])
        (next state action)
        examinedState)
    (node : Node) :
    HistoricalLogPrefixOrigin
      start actions state (examinedState.log node) := by
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · exact ⟨examinedState, node, oldState, by simp⟩
  · subst examinedState
    exact origins node

theorem hasVoteHistory_implies_CountedVoteUniquenessInv
    {state : State}
    (history : HasVoteHistory state) :
    CountedVoteUniquenessInv state := by
  rcases history with ⟨owner, consistent⟩
  intro first second voter firstActive secondActive sameTerm
    firstCounted secondCounted
  have firstOwner :=
    consistent.countedChoices first voter firstActive firstCounted
  have secondOwner :=
    consistent.countedChoices second voter secondActive secondCounted
  rw [sameTerm] at firstOwner
  rw [firstOwner] at secondOwner
  exact Option.some.inj secondOwner

theorem isQuorum_intersects
    (first second configuration : Configuration)
    (firstQuorum : isQuorum first configuration = true)
    (secondQuorum : isQuorum second configuration = true) :
    Exists fun voter =>
      And
        (voter ∈ first)
        (voter ∈ second) := by
  simp [isQuorum] at firstQuorum secondQuorum
  by_contra noCommon
  have disjoint : Disjoint first second := by
    rw [Finset.disjoint_left]
    intro voter firstMember secondMember
    exact noCommon ⟨voter, firstMember, secondMember⟩
  have unionSubset : first ∪ second ⊆ configuration :=
    Finset.union_subset firstQuorum.1 secondQuorum.1
  have unionCardBound :=
    Finset.card_le_card unionSubset
  have unionCard :=
    Finset.card_union_of_disjoint disjoint
  omega

theorem isQuorum_nonempty
    (quorum configuration : Configuration)
    (quorumOk : isQuorum quorum configuration = true) :
    quorum.Nonempty := by
  simp [isQuorum] at quorumOk
  exact Finset.card_pos.mp (by omega)

theorem exists_node_with_max_commitIndex
    (state : State)
    (nodesNonempty : state.nodes.Nonempty)
    (outsideNodes :
      forall node,
        node ∉ state.nodes ->
          state.commitIndex node = 0) :
    Exists fun node =>
      forall other,
        state.commitIndex other <= state.commitIndex node := by
  let values := state.nodes.image state.commitIndex
  have nonempty : values.Nonempty :=
    nodesNonempty.image _
  have maximumMember := Finset.max'_mem values nonempty
  rcases Finset.mem_image.mp maximumMember with
    ⟨node, nodeMember, nodeValue⟩
  refine ⟨node, fun other => ?_⟩
  rw [nodeValue]
  by_cases otherMember : other ∈ state.nodes
  · exact Finset.le_max' values (state.commitIndex other)
      (by
        simp only [values, Finset.mem_image]
        exact ⟨other, otherMember, rfl⟩)
  · rw [outsideNodes other otherMember]
    exact Nat.zero_le _

private theorem becomeLeader_enabled_configuration_quorum
    (state : State)
    (leader : Node)
    (configuration : ConfigurationAt)
    (enabled : Enabled state (.becomeLeader leader))
    (member : configuration ∈ state.configurations leader) :
    isQuorum
        (state.votesGranted leader ∩ configuration.nodes)
        configuration.nodes =
      true := by
  have enabledDetails := enabled
  simp [Enabled, actionEnabled, allConfigurationsHaveQuorum] at enabledDetails
  exact enabledDetails.2 configuration member

theorem electedLeaders_sameTerm_eq
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {firstLeader secondLeader : Node}
    (voteHistory : HasVoteHistory state)
    (firstIsLeader :
      state.leadershipState firstLeader = .leader)
    (secondIsLeader :
      state.leadershipState secondLeader = .leader)
    (sameTerm :
      state.currentTerm firstLeader =
        state.currentTerm secondLeader)
    (firstElection :
      ElectionWitness start actions state firstLeader)
    (secondElection :
      ElectionWitness start actions state secondLeader)
    (firstConfiguration secondConfiguration :
      ConfigurationAt)
    (firstConfigurationMember :
      firstConfiguration ∈
        firstElection.electionState.configurations firstLeader)
    (secondConfigurationMember :
      secondConfiguration ∈
        secondElection.electionState.configurations secondLeader)
    (sameConfigurationNodes :
      firstConfiguration.nodes = secondConfiguration.nodes) :
    firstLeader = secondLeader := by
  rcases firstElection.occurrence with ⟨firstOccurrence⟩
  rcases secondElection.occurrence with ⟨secondOccurrence⟩
  have firstQuorum :=
    becomeLeader_enabled_configuration_quorum
      firstElection.electionState
      firstLeader
      firstConfiguration
      firstOccurrence.enabled
      firstConfigurationMember
  have secondQuorum :=
    becomeLeader_enabled_configuration_quorum
      secondElection.electionState
      secondLeader
      secondConfiguration
      secondOccurrence.enabled
      secondConfigurationMember
  have secondQuorumOnFirstConfiguration :
      isQuorum
          (secondElection.electionState.votesGranted secondLeader ∩
            firstConfiguration.nodes)
          firstConfiguration.nodes =
        true := by
    rw [sameConfigurationNodes]
    exact secondQuorum
  rcases isQuorum_intersects
      (firstElection.electionState.votesGranted firstLeader ∩
        firstConfiguration.nodes)
      (secondElection.electionState.votesGranted secondLeader ∩
        firstConfiguration.nodes)
      firstConfiguration.nodes
      firstQuorum
      secondQuorumOnFirstConfiguration with
    ⟨voter, firstMembership, secondMembership⟩
  simp only [Finset.mem_inter] at firstMembership secondMembership
  have firstCounted :
      voter ∈ state.votesGranted firstLeader := by
    rw [firstElection.votes_eq]
    exact firstMembership.1
  have secondCounted :
      voter ∈ state.votesGranted secondLeader := by
    rw [secondElection.votes_eq]
    exact secondMembership.1
  exact
    hasVoteHistory_implies_CountedVoteUniquenessInv voteHistory
      firstLeader
      secondLeader
      voter
      (Or.inr firstIsLeader)
      (Or.inr secondIsLeader)
      sameTerm
      firstCounted
      secondCounted

theorem occurs_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state before : State}
    {previousAction action : Action}
    (occurs :
      Occurs start actions state before previousAction)
    (enabled : Enabled state action) :
    Occurs
      start
      (actions ++ [action])
      (next state action)
      before
      previousAction := by
  rcases occurs with ⟨witness⟩
  exact ⟨{
    pastActions := witness.pastActions
    futureActions := witness.futureActions ++ [action]
    actions_eq := by
      calc
        actions ++ [action] =
            (witness.pastActions ++
              [previousAction] ++
              witness.futureActions) ++ [action] :=
          congrArg (fun prior => prior ++ [action])
            witness.actions_eq
        _ = witness.pastActions ++
              [previousAction] ++
              (witness.futureActions ++ [action]) := by
          simp only [List.append_assoc]
    before_history := witness.before_history
    enabled := witness.enabled
    after_history :=
      replays_append_singleton witness.after_history enabled
  }⟩

private theorem append_singleton_eq
    {α : Type}
    {first second : List α}
    {firstLast secondLast : α}
    (equal : first ++ [firstLast] = second ++ [secondLast]) :
    And
      (first = second)
      (firstLast = secondLast) := by
  have reversed := congrArg List.reverse equal
  simp only [List.reverse_append, List.reverse_singleton] at reversed
  have parts := List.cons.inj reversed
  exact
    ⟨List.reverse_injective parts.2,
      parts.1⟩

theorem occurs_append_singleton_cases
    {start : InitialConfiguration}
    {actions : List Action}
    {state before : State}
    {action previousAction : Action}
    (history : ProtocolHistory start actions state)
    (_enabled : Enabled state action)
    (occurs :
      Occurs
        start
        (actions ++ [action])
        (next state action)
        before
        previousAction) :
    Or
      (Occurs start actions state before previousAction)
      (And
        (before = state)
        (previousAction = action)) := by
  rcases occurs with ⟨witness⟩
  let occurrenceActions :=
    witness.pastActions ++ [previousAction]
  have occurrencePrefix :
      occurrenceActions <+: actions ++ [action] := by
    exact
      ⟨witness.futureActions,
        by
          simpa only [occurrenceActions, List.append_assoc] using
            witness.actions_eq.symm⟩
  rcases prefix_append_singleton_cases occurrencePrefix with
    oldPrefix | allActions
  · rcases oldPrefix with ⟨oldFuture, oldActionsEq⟩
    have oldReplay :
        ProtocolHistory
          start
          (occurrenceActions ++ oldFuture)
          state := by
      rw [oldActionsEq]
      exact history
    rcases replays_append_split oldReplay with
      ⟨middle, occurrenceReplay, remainingReplay⟩
    have expectedOccurrenceReplay :
        Replays
          (initialState start)
          occurrenceActions
          (next before previousAction) := by
      exact replays_append_singleton
        witness.before_history witness.enabled
    have middleEq : middle = next before previousAction :=
      replays_deterministic
        occurrenceReplay expectedOccurrenceReplay
    left
    exact ⟨{
      pastActions := witness.pastActions
      futureActions := oldFuture
      actions_eq := by
        simpa only [occurrenceActions, List.append_assoc] using
          oldActionsEq.symm
      before_history := witness.before_history
      enabled := witness.enabled
      after_history := by
        simpa only [middleEq] using remainingReplay
    }⟩
  · have actionParts :=
      append_singleton_eq
        (show
          witness.pastActions ++ [previousAction] =
            actions ++ [action] by
          simpa only [occurrenceActions] using allActions)
    have beforeReplay :
        ProtocolHistory start actions before := by
      simpa only [actionParts.1] using witness.before_history
    right
    exact
      ⟨replays_deterministic beforeReplay history,
        actionParts.2⟩

private def ackWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {dest source : Node}
    {response : Message}
    {lastLogIndex : Nat}
    (ack :
      AckWitness
        start actions state dest source response lastLogIndex)
    (enabled : Enabled state action) :
    AckWitness
      start
      (actions ++ [action])
      (next state action)
      dest
      source
      response
      lastLogIndex := by
  let origin :
      AEResponseWitness
        start
        (actions ++ [action])
        (next state action)
        dest
        source
        response :=
    {
      responseState := ack.origin.responseState
      request := ack.origin.request
      previousIndex := ack.origin.previousIndex
      previousTerm := ack.origin.previousTerm
      entries := ack.origin.entries
      leaderCommitIndex := ack.origin.leaderCommitIndex
      kind := ack.origin.kind
      occurrence := occurs_extend ack.origin.occurrence enabled
      request_head := ack.origin.request_head
      request_body := ack.origin.request_body
      response_present := ack.origin.response_present
    }
  exact {
    origin
    response_body := ack.response_body
    response_term := by
      simpa [origin] using ack.response_term
    index_bounded := by
      simpa [origin] using ack.index_bounded
  }

private def matchIndexWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader follower : Node}
    (witness :
      MatchIndexWitness
        start actions state leader follower)
    (enabled : Enabled state action)
    (indexEq :
      (next state action).matchIndex leader follower =
        state.matchIndex leader follower) :
    MatchIndexWitness
      start
      (actions ++ [action])
      (next state action)
      leader
      follower :=
  {
    handledState := witness.handledState
    response := witness.response
    lastLogIndex := witness.lastLogIndex
    ack := ackWitness_extend witness.ack enabled
    handle_occurrence :=
      occurs_extend witness.handle_occurrence enabled
    response_head := witness.response_head
    index_eq := indexEq.trans witness.index_eq
  }

private theorem leader_before_of_leader_after
    (state : State)
    (action : Action)
    (leader : Node)
    (afterLeader :
      (next state action).leadershipState leader = .leader)
    (notBecomeLeader :
      forall elected : Node,
        action ≠ .becomeLeader elected) :
    state.leadershipState leader = .leader := by
  cases action with
  | timeout candidate =>
      by_cases leaderIsCandidate : leader = candidate
      · subst leader
        simp [next, rawNext, nextTimeout, updateNode] at afterLeader
      · simpa [next, rawNext, nextTimeout, updateNode,
          leaderIsCandidate] using afterLeader
  | requestVote source dest =>
      simpa [next, rawNext, nextRequestVote] using afterLeader
  | appendEntries source dest =>
      simpa [next, rawNext, nextAppendEntries] using afterLeader
  | becomeLeader elected =>
      exact False.elim (notBecomeLeader elected rfl)
  | clientRequest node =>
      simpa [next, rawNext, nextClientRequest] using afterLeader
  | signCommittableMessages node =>
      simpa [next, rawNext, nextSignCommittableMessages] using afterLeader
  | changeConfiguration node configuration =>
      simpa [next, rawNext, nextChangeConfiguration] using afterLeader
  | advanceCommitIndex node =>
      by_cases leaderIsNode : leader = node
      · subst leader
        simp [next, rawNext, nextAdvanceCommitIndex, updateNode] at afterLeader ⊢
        split at afterLeader <;> simp_all
      · simpa [next, rawNext, nextAdvanceCommitIndex, updateNode,
          leaderIsNode] using afterLeader
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [next, rawNext, nextReceive, hmessage] using afterLeader
      | some message =>
          cases kind with
          | dropIgnored =>
              simpa [next, rawNext, nextReceive, hmessage] using afterLeader
          | updateTerm =>
              by_cases leaderIsDest : leader = dest
              · subst leader
                cases hrole : state.leadershipState dest <;>
                  simp [next, rawNext, nextReceive, hmessage, updateNode,
                    hrole] at afterLeader
              · simpa [next, rawNext, nextReceive, hmessage, updateNode,
                  leaderIsDest] using afterLeader
          | handleRequestVoteRequest =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  afterLeader
          | handleRequestVoteResponse =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  afterLeader
          | dropRequestVoteResponseOutOfState =>
              simpa [next, rawNext, nextReceive, hmessage] using afterLeader
          | dropRequestVoteResponseStale =>
              simpa [next, rawNext, nextReceive, hmessage] using afterLeader
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm <;>
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase] using afterLeader
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    afterLeader
          | returnToFollower =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  by_cases leaderIsDest : leader = dest
                  · subst leader
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      updateNode] at afterLeader
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      updateNode, leaderIsDest] using afterLeader
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    afterLeader
          | appendEntriesAlreadyDone =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone] using afterLeader
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  by_cases leaderIsDest : leader = message.dest
                  · subst leader
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, updateNode] at afterLeader ⊢
                    split at afterLeader <;> simp_all
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, updateNode,
                      leaderIsDest] using afterLeader
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    afterLeader
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone, conflictRollback] using
                    afterLeader
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  by_cases leaderIsDest : leader = message.dest
                  · subst leader
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      updateNode] at afterLeader ⊢
                    split at afterLeader <;> simp_all
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      updateNode, leaderIsDest] using afterLeader
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    afterLeader
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  afterLeader
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  afterLeader
          | dropAppendEntriesResponseOutOfState =>
              simpa [next, rawNext, nextReceive, hmessage] using afterLeader
          | dropAppendEntriesResponseStale =>
              simpa [next, rawNext, nextReceive, hmessage] using afterLeader

private theorem matchIndexHistory_retain
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader follower : Node}
    (history :
      MatchIndexHistoryConsistent start actions state)
    (enabled : Enabled state action)
    (oldLeader :
      state.leadershipState leader = .leader)
    (indexEq :
      (next state action).matchIndex leader follower =
        state.matchIndex leader follower)
    (afterPositive :
      0 < (next state action).matchIndex leader follower) :
    HasMatchIndexWitness
      start
      (actions ++ [action])
      (next state action)
      leader
      follower := by
  have oldPositive : 0 < state.matchIndex leader follower := by
    rw [← indexEq]
    exact afterPositive
  rcases history leader follower oldLeader oldPositive with ⟨witness⟩
  exact ⟨matchIndexWitness_extend witness enabled indexEq⟩

private theorem headMessage_mem
    (state : State)
    (dest source : Node)
    (message : Message)
    (head : headMessage? state dest source = some message) :
    message ∈ state.messages dest source := by
  unfold headMessage? at head
  cases channel : state.messages dest source with
  | nil =>
      simp [channel] at head
  | cons first rest =>
      simp [channel] at head
      subst first
      simp

theorem initial_MatchIndexHistoryConsistent
    (start : InitialConfiguration) :
    MatchIndexHistoryConsistent start [] (initialState start) := by
  intro leader follower _ positive
  simp [initialState] at positive

theorem matchIndexHistory_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (protocol : ProtocolHistory start actions state)
    (history :
      MatchIndexHistoryConsistent start actions state)
    (acks :
      SuccessfulAckHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    MatchIndexHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  intro leader follower afterLeader afterPositive
  cases action with
  | timeout candidate =>
      exact matchIndexHistory_retain
        history
        enabled
        (leader_before_of_leader_after
          state
          (.timeout candidate)
          leader
          afterLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextTimeout])
        afterPositive
  | requestVote source dest =>
      exact matchIndexHistory_retain
        history
        enabled
        (leader_before_of_leader_after
          state
          (.requestVote source dest)
          leader
          afterLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextRequestVote])
        afterPositive
  | appendEntries source dest =>
      exact matchIndexHistory_retain
        history
        enabled
        (leader_before_of_leader_after
          state
          (.appendEntries source dest)
          leader
          afterLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextAppendEntries])
        afterPositive
  | becomeLeader elected =>
      by_cases leaderIsElected : leader = elected
      · subst leader
        simp [next, rawNext, nextBecomeLeader, updateNode] at afterPositive
      · exact matchIndexHistory_retain
          history
          enabled
          (by
            simpa [next, rawNext, nextBecomeLeader, updateNode,
              leaderIsElected] using afterLeader)
          (by
            simp [next, rawNext, nextBecomeLeader, updateNode,
              leaderIsElected])
          afterPositive
  | clientRequest node =>
      exact matchIndexHistory_retain
        history
        enabled
        (leader_before_of_leader_after
          state
          (.clientRequest node)
          leader
          afterLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextClientRequest])
        afterPositive
  | signCommittableMessages node =>
      exact matchIndexHistory_retain
        history
        enabled
        (leader_before_of_leader_after
          state
          (.signCommittableMessages node)
          leader
          afterLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextSignCommittableMessages])
        afterPositive
  | changeConfiguration node configuration =>
      exact matchIndexHistory_retain
        history
        enabled
        (leader_before_of_leader_after
          state
          (.changeConfiguration node configuration)
          leader
          afterLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextChangeConfiguration])
        afterPositive
  | advanceCommitIndex node =>
      exact matchIndexHistory_retain
        history
        enabled
        (leader_before_of_leader_after
          state
          (.advanceCommitIndex node)
          leader
          afterLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextAdvanceCommitIndex])
        afterPositive
  | receive receiveDest receiveSource kind =>
      have oldLeader :
          state.leadershipState leader = .leader :=
        leader_before_of_leader_after
          state
          (.receive receiveDest receiveSource kind)
          leader
          afterLeader
          (by intro elected equality; cases equality)
      cases hmessage :
          headMessage? state receiveDest receiveSource with
      | none =>
          exact matchIndexHistory_retain
            history
            enabled
            oldLeader
            (by simp [next, rawNext, nextReceive, hmessage])
            afterPositive
      | some message =>
          cases kind with
          | dropIgnored =>
              exact matchIndexHistory_retain
                history enabled oldLeader
                (by simp [next, rawNext, nextReceive, hmessage])
                afterPositive
          | updateTerm =>
              exact matchIndexHistory_retain
                history enabled oldLeader
                (by simp [next, rawNext, nextReceive, hmessage])
                afterPositive
          | handleRequestVoteRequest =>
              cases hbody : message.body <;>
                exact matchIndexHistory_retain
                  history enabled oldLeader
                  (by simp [next, rawNext, nextReceive, hmessage, hbody])
                  afterPositive
          | handleRequestVoteResponse =>
              cases hbody : message.body <;>
                exact matchIndexHistory_retain
                  history enabled oldLeader
                  (by simp [next, rawNext, nextReceive, hmessage, hbody])
                  afterPositive
          | dropRequestVoteResponseOutOfState =>
              exact matchIndexHistory_retain
                history enabled oldLeader
                (by simp [next, rawNext, nextReceive, hmessage])
                afterPositive
          | dropRequestVoteResponseStale =>
              exact matchIndexHistory_retain
                history enabled oldLeader
                (by simp [next, rawNext, nextReceive, hmessage])
                afterPositive
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm <;>
                    exact matchIndexHistory_retain
                      history enabled oldLeader
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody, responseCase])
                      afterPositive
              | _ =>
                  exact matchIndexHistory_retain
                    history enabled oldLeader
                    (by simp [next, rawNext, nextReceive, hmessage, hbody])
                    afterPositive
          | returnToFollower =>
              cases hbody : message.body <;>
                exact matchIndexHistory_retain
                  history enabled oldLeader
                  (by simp [next, rawNext, nextReceive, hmessage, hbody])
                  afterPositive
          | appendEntriesAlreadyDone =>
              cases hbody : message.body <;>
                exact matchIndexHistory_retain
                  history enabled oldLeader
                  (by simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone])
                  afterPositive
          | appendEntriesNoConflict =>
              cases hbody : message.body <;>
                exact matchIndexHistory_retain
                  history enabled oldLeader
                  (by simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesNoConflict])
                  afterPositive
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body <;>
                exact matchIndexHistory_retain
                  history enabled oldLeader
                  (by simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone, conflictRollback])
                  afterPositive
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body <;>
                exact matchIndexHistory_retain
                  history enabled oldLeader
                  (by simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesNoConflict, conflictRollback])
                  afterPositive
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  cases success with
                  | false =>
                      simp [Enabled, actionEnabled, hmessage,
                        receiveBranchEnabled, hbody] at enabled
                  | true =>
                      by_cases leaderIsDest : leader = receiveDest
                      · subst leader
                        by_cases followerIsSource :
                            follower = receiveSource
                        · subst follower
                          by_cases ackIsNotNew :
                              lastLogIndex <=
                                state.matchIndex
                                  receiveDest receiveSource
                          · exact matchIndexHistory_retain
                              history
                              enabled
                              oldLeader
                              (by
                                simp [next, rawNext, nextReceive, hmessage,
                                  hbody, update₂, Nat.max_eq_left
                                    ackIsNotNew])
                              afterPositive
                          · have oldIndexBound :
                                state.matchIndex
                                    receiveDest receiveSource <=
                                  lastLogIndex :=
                              Nat.le_of_lt (Nat.lt_of_not_ge ackIsNotNew)
                            have queued :
                                message ∈
                                  state.messages
                                    receiveDest receiveSource :=
                              headMessage_mem
                                state
                                receiveDest
                                receiveSource
                                message
                                hmessage
                            rcases acks
                                receiveDest
                                receiveSource
                                message
                                lastLogIndex
                                queued
                                hbody with
                              ⟨ack⟩
                            exact ⟨{
                              handledState := state
                              response := message
                              lastLogIndex
                              ack := ackWitness_extend ack enabled
                              handle_occurrence :=
                                protocolHistory_append_occurs
                                  protocol enabled
                              response_head := hmessage
                              index_eq := by
                                simp [next, rawNext, nextReceive, hmessage,
                                  hbody, update₂,
                                  Nat.max_eq_right oldIndexBound]
                            }⟩
                        · exact matchIndexHistory_retain
                            history
                            enabled
                            oldLeader
                            (by
                              simp [next, rawNext, nextReceive, hmessage,
                                hbody, update₂, followerIsSource])
                            afterPositive
                      · exact matchIndexHistory_retain
                          history
                          enabled
                          oldLeader
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody, update₂, leaderIsDest])
                          afterPositive
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body <;>
                exact matchIndexHistory_retain
                  history enabled oldLeader
                  (by simp [next, rawNext, nextReceive, hmessage, hbody])
                  afterPositive
          | dropAppendEntriesResponseOutOfState =>
              exact matchIndexHistory_retain
                history enabled oldLeader
                (by simp [next, rawNext, nextReceive, hmessage])
                afterPositive
          | dropAppendEntriesResponseStale =>
              exact matchIndexHistory_retain
                history enabled oldLeader
                (by simp [next, rawNext, nextReceive, hmessage])
                afterPositive

private theorem leaderOriginWitness_extend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader : Node}
    (origin :
      LeaderHasOriginWitness start actions state leader)
    (enabled : Enabled state action)
    (termEq :
      (next state action).currentTerm leader =
        state.currentTerm leader)
    (votesEq :
      (next state action).votesGranted leader =
        state.votesGranted leader) :
    LeaderHasOriginWitness
      start
      (actions ++ [action])
      (next state action)
      leader := by
  rcases origin with ⟨origin⟩
  cases origin with
  | initial leaderEq initialTerm =>
      exact ⟨.initial leaderEq (termEq.trans initialTerm)⟩
  | elected witness =>
      exact ⟨.elected {
        electionState := witness.electionState
        occurrence := occurs_extend witness.occurrence enabled
        term_eq := termEq.trans witness.term_eq
        votes_eq := votesEq.trans witness.votes_eq
      }⟩

theorem leaderHistory_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (protocol : ProtocolHistory start actions state)
    (leaders : LeaderHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    LeaderHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  intro leader afterLeader
  cases action with
  | timeout candidate =>
      have leaderIsNotCandidate : leader ≠ candidate := by
        intro same
        subst leader
        simp [next, rawNext, nextTimeout, updateNode] at afterLeader
      apply leaderOriginWitness_extend
        (leaders leader (by
          simpa [next, rawNext, nextTimeout, updateNode,
            leaderIsNotCandidate] using afterLeader))
        enabled
      · simp [next, rawNext, nextTimeout, updateNode,
          leaderIsNotCandidate]
      · simp [next, rawNext, nextTimeout, updateNode,
          leaderIsNotCandidate]
  | requestVote source dest =>
      apply leaderOriginWitness_extend
        (leaders leader (by
          simpa [next, rawNext, nextRequestVote] using afterLeader))
        enabled
      · rfl
      · rfl
  | appendEntries source dest =>
      apply leaderOriginWitness_extend
        (leaders leader (by
          simpa [next, rawNext, nextAppendEntries] using afterLeader))
        enabled
      · rfl
      · rfl
  | becomeLeader elected =>
      by_cases leaderIsElected : leader = elected
      · subst leader
        exact ⟨.elected {
          electionState := state
          occurrence :=
            protocolHistory_append_occurs protocol enabled
          term_eq := by
            simp [next, rawNext, nextBecomeLeader]
          votes_eq := by
            simp [next, rawNext, nextBecomeLeader]
        }⟩
      · apply leaderOriginWitness_extend
          (leaders leader (by
            simpa [next, rawNext, nextBecomeLeader, updateNode,
              leaderIsElected] using afterLeader))
          enabled
        · rfl
        · rfl
  | clientRequest node =>
      apply leaderOriginWitness_extend
        (leaders leader (by
          simpa [next, rawNext, nextClientRequest] using afterLeader))
        enabled
      · rfl
      · rfl
  | signCommittableMessages node =>
      apply leaderOriginWitness_extend
        (leaders leader (by
          simpa [next, rawNext, nextSignCommittableMessages] using
            afterLeader))
        enabled
      · rfl
      · rfl
  | changeConfiguration node configuration =>
      apply leaderOriginWitness_extend
        (leaders leader (by
          simpa [next, rawNext, nextChangeConfiguration] using afterLeader))
        enabled
      · rfl
      · rfl
  | advanceCommitIndex node =>
      have enabledDetails := enabled
      simp [Enabled, actionEnabled] at enabledDetails
      have beforeLeader :
          state.leadershipState leader = .leader := by
        by_cases leaderIsNode : leader = node
        · subst leader
          exact enabledDetails.1.2
        · simpa [next, rawNext, nextAdvanceCommitIndex, updateNode,
            leaderIsNode] using afterLeader
      apply leaderOriginWitness_extend
        (leaders leader beforeLeader)
        enabled
      · simp [next, rawNext, nextAdvanceCommitIndex]
      · simp [next, rawNext, nextAdvanceCommitIndex]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [Enabled, actionEnabled, hmessage] at enabled
      | some message =>
          cases kind with
          | dropIgnored =>
              apply leaderOriginWitness_extend
                (leaders leader (by
                  simpa [next, rawNext, nextReceive, hmessage] using
                    afterLeader))
                enabled
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]
          | updateTerm =>
              have leaderIsNotDest : leader ≠ dest := by
                intro same
                subst leader
                cases roleEq : state.leadershipState dest <;>
                  simp [next, rawNext, nextReceive, hmessage, updateNode,
                    roleEq] at afterLeader
              apply leaderOriginWitness_extend
                (leaders leader (by
                  simpa [next, rawNext, nextReceive, hmessage, updateNode,
                    leaderIsNotDest] using afterLeader))
                enabled
              · simp [next, rawNext, nextReceive, hmessage, updateNode,
                  leaderIsNotDest]
              · simp [next, rawNext, nextReceive, hmessage]
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  apply leaderOriginWitness_extend
                    (leaders leader (by
                      simpa [next, rawNext, nextReceive, hmessage,
                        hbody] using afterLeader))
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | handleRequestVoteResponse =>
              cases hbody : message.body with
              | requestVoteResponse voteGranted isPreVote =>
                  have enabledDetails := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabledDetails
                  have messageDest : message.dest = dest :=
                    enabledDetails.2.1.1
                  have destIsCandidate :
                      state.leadershipState dest = .candidate := by
                    simpa [messageDest] using enabledDetails.2.2.2
                  have leaderIsNotDest : leader ≠ dest := by
                    intro same
                    subst leader
                    have stillLeader :
                        state.leadershipState dest = .leader := by
                      simpa [next, rawNext, nextReceive, hmessage,
                        hbody] using afterLeader
                    rw [destIsCandidate] at stillLeader
                    contradiction
                  apply leaderOriginWitness_extend
                    (leaders leader (by
                      simpa [next, rawNext, nextReceive, hmessage,
                        hbody] using afterLeader))
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
                  · cases voteGranted <;>
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        updateNode, leaderIsNotDest]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | dropRequestVoteResponseOutOfState =>
              apply leaderOriginWitness_extend
                (leaders leader (by
                  simpa [next, rawNext, nextReceive, hmessage] using
                    afterLeader))
                enabled
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]
          | dropRequestVoteResponseStale =>
              apply leaderOriginWitness_extend
                (leaders leader (by
                  simpa [next, rawNext, nextReceive, hmessage] using
                    afterLeader))
                enabled
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm <;>
                    apply leaderOriginWitness_extend
                      (leaders leader (by
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase] using afterLeader))
                      enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | returnToFollower =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have leaderIsNotDest : leader ≠ dest := by
                    intro same
                    subst leader
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      updateNode] at afterLeader
                  apply leaderOriginWitness_extend
                    (leaders leader (by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        updateNode, leaderIsNotDest] using afterLeader))
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  apply leaderOriginWitness_extend
                    (leaders leader (by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone] using afterLeader))
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have beforeLeader :
                      state.leadershipState leader = .leader := by
                    by_cases leaderIsDest : leader = message.dest
                    · subst leader
                      cases roleEq :
                          state.leadershipState message.dest <;>
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, updateNode,
                          roleEq] at afterLeader ⊢
                      all_goals
                        split at afterLeader <;> simp_all
                    · simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, updateNode,
                        leaderIsDest] using afterLeader
                  apply leaderOriginWitness_extend
                    (leaders leader beforeLeader)
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  apply leaderOriginWitness_extend
                    (leaders leader (by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone,
                        conflictRollback] using afterLeader))
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have beforeLeader :
                      state.leadershipState leader = .leader := by
                    by_cases leaderIsDest : leader = message.dest
                    · subst leader
                      cases roleEq :
                          state.leadershipState message.dest <;>
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, conflictRollback,
                          updateNode, roleEq] at afterLeader ⊢
                      all_goals
                        split at afterLeader <;> simp_all
                    · simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        updateNode, leaderIsDest] using afterLeader
                  apply leaderOriginWitness_extend
                    (leaders leader beforeLeader)
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply leaderOriginWitness_extend
                    (leaders leader (by
                      simpa [next, rawNext, nextReceive, hmessage,
                        hbody] using afterLeader))
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply leaderOriginWitness_extend
                    (leaders leader (by
                      simpa [next, rawNext, nextReceive, hmessage,
                        hbody] using afterLeader))
                    enabled
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | dropAppendEntriesResponseOutOfState =>
              apply leaderOriginWitness_extend
                (leaders leader (by
                  simpa [next, rawNext, nextReceive, hmessage] using
                    afterLeader))
                enabled
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]
          | dropAppendEntriesResponseStale =>
              apply leaderOriginWitness_extend
                (leaders leader (by
                  simpa [next, rawNext, nextReceive, hmessage] using
                    afterLeader))
                enabled
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]

private theorem mem_before_of_mem_discard
    (messages : NodeMatrix (List Message))
    (discarded queued : Message)
    (dest source : Node)
    (queuedAfter :
      queued ∈ (Model.discard messages discarded) dest source) :
    queued ∈ messages dest source := by
  by_cases destMatches : dest = discarded.dest
  · subst dest
    by_cases sourceMatches : source = discarded.source
    · subst source
      simp [Model.discard, update₂] at queuedAfter
      exact List.mem_of_mem_erase queuedAfter
    · simpa [Model.discard, update₂, sourceMatches] using queuedAfter
  · simpa [Model.discard, update₂, destMatches] using queuedAfter

private theorem firstInsertion_enqueue_eq
    (messages : NodeMatrix (List Message))
    (inserted queued : Message)
    (dest source : Node)
    (absentBefore : queued ∉ messages dest source)
    (presentAfter :
      queued ∈ (enqueue messages inserted) dest source) :
    And
      (dest = inserted.dest)
      (And
        (source = inserted.source)
        (queued = inserted)) := by
  by_cases destMatches : dest = inserted.dest
  · subst dest
    by_cases sourceMatches : source = inserted.source
    · subst source
      by_cases duplicate :
          (messages inserted.dest inserted.source).any
            (fun existing => existing == inserted)
      · simp [enqueue, update₂, duplicate] at presentAfter
        exact False.elim (absentBefore presentAfter)
      · simp [enqueue, update₂, duplicate] at presentAfter
        rcases presentAfter with queuedBefore | queuedIsInserted
        · exact False.elim (absentBefore queuedBefore)
        · exact ⟨rfl, rfl, queuedIsInserted⟩
    · have queuedBefore :
          queued ∈ messages inserted.dest source := by
        simpa [enqueue, update₂, sourceMatches] using presentAfter
      exact False.elim (absentBefore queuedBefore)
  · have queuedBefore : queued ∈ messages dest source := by
      simpa [enqueue, update₂, destMatches] using presentAfter
    exact False.elim (absentBefore queuedBefore)

private theorem firstInsertion_reply_eq
    (messages : NodeMatrix (List Message))
    (response request queued : Message)
    (dest source : Node)
    (absentBefore : queued ∉ messages dest source)
    (presentAfter :
      queued ∈ (reply messages response request) dest source) :
    And
      (dest = response.dest)
      (And
        (source = response.source)
        (queued = response)) := by
  apply firstInsertion_enqueue_eq
    messages response queued dest source absentBefore
  exact mem_before_of_mem_discard
    (enqueue messages response)
    request
    queued
    dest
    source
    presentAfter

theorem initial_QueueHistoryConsistent
    (start : InitialConfiguration) :
    QueueHistoryConsistent start [] (initialState start) := by
  intro dest source message queued
  simp [initialState] at queued

theorem queueHistory_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (consistent : QueueHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    QueueHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  intro dest source message queuedAfter
  by_cases queuedBefore : message ∈ state.messages dest source
  · rcases consistent dest source message queuedBefore with
      ⟨witness⟩
    exact ⟨{
      before := witness.before
      action := witness.action
      occurrence := occurs_extend witness.occurrence enabled
      absentBefore := witness.absentBefore
      presentAfter := witness.presentAfter
    }⟩
  · exact ⟨{
      before := state
      action
      occurrence := protocolHistory_append_occurs history enabled
      absentBefore := queuedBefore
      presentAfter := queuedAfter
    }⟩

theorem causallyReachable_step
    {start : InitialConfiguration}
    (state : State)
    (action : Action)
    (causal : CausallyReachable start state)
    (enabled : Enabled state action) :
    CausallyReachable start (next state action) := by
  rcases causal with ⟨actions, history, queues⟩
  exact
    ⟨actions ++ [action],
      replays_append_singleton history enabled,
      queueHistory_step history queues action enabled⟩

theorem reachable_hasCausalHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    CausallyReachable start state := by
  exact
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := CausallyReachable start)
      ⟨[], rfl, initial_QueueHistoryConsistent start⟩
      (causallyReachable_step (start := start))
      reachable

private theorem replays_append
    {before middle after : State}
    {first second : List Action}
    (firstReplay : Replays before first middle)
    (secondReplay : Replays middle second after) :
    Replays before (first ++ second) after := by
  induction first generalizing before with
  | nil =>
      simp [Replays] at firstReplay
      subst middle
      exact secondReplay
  | cons action tail inductionHypothesis =>
      rcases firstReplay with ⟨enabled, tailReplay⟩
      exact
        ⟨enabled,
          inductionHypothesis tailReplay⟩

private theorem protocolHistory_induction
    {start : InitialConfiguration}
    (property : List Action -> State -> Prop)
    (initial : property [] (initialState start))
    (step :
      forall (actions : List Action) (state : State),
        ProtocolHistory start actions state ->
          property actions state ->
            forall action : Action,
              Enabled state action ->
                property
                  (actions ++ [action])
                  (next state action))
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    property actions state := by
  let extend :
      forall
        (past suffix : List Action)
        (before after : State),
        ProtocolHistory start past before ->
          property past before ->
            Replays before suffix after ->
              property (past ++ suffix) after := by
    intro past suffix before after pastHistory established replay
    induction suffix generalizing past before with
    | nil =>
        simp [Replays] at replay
        subst after
        simpa using established
    | cons action tail inductionHypothesis =>
        rcases replay with ⟨enabled, tailReplay⟩
        have nextHistory :=
          replays_append_singleton pastHistory enabled
        have nextEstablished :=
          step past before pastHistory established action enabled
        have result :=
          inductionHypothesis
            (past ++ [action])
            (next before action)
            nextHistory nextEstablished tailReplay
        simpa only [List.append_assoc, List.singleton_append] using result
  simpa using
    extend
      []
      actions
      (initialState start)
      state
      rfl
      initial
      history

theorem protocolHistory_nodes_nonempty
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    state.nodes.Nonempty := by
  apply protocolHistory_induction
    (start := start)
    (property := fun _ current => current.nodes.Nonempty)
  · exact ⟨start.leader, by simp [initialState, start.leader_mem]⟩
  · intro past current _ currentNonempty action enabled
    cases action with
    | changeConfiguration leader configuration =>
        exact currentNonempty.mono Finset.subset_union_left
    | receive dest source kind =>
        have nodesEq :
            (next current (.receive dest source kind)).nodes =
              current.nodes := by
          cases hmessage : headMessage? current dest source with
          | none =>
              simp [next, rawNext, nextReceive, hmessage]
          | some message =>
              cases kind <;>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
                    conflictRollback]
              all_goals
                split <;> rfl
        simpa [nodesEq] using currentNonempty
    | _ =>
        simpa [next, rawNext, nextTimeout, nextRequestVote,
          nextAppendEntries, nextBecomeLeader, nextClientRequest,
          nextSignCommittableMessages, nextAdvanceCommitIndex] using
          currentNonempty
  · exact history

theorem protocolHistory_commitIndex_zero_outside_nodes
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    forall node,
      node ∉ state.nodes ->
        state.commitIndex node = 0 := by
  apply protocolHistory_induction
    (start := start)
    (property := fun _ current =>
      forall node,
        node ∉ current.nodes ->
          current.commitIndex node = 0)
  · intro node notMember
    change node ∉ start.nodes at notMember
    simp [initialState, notMember]
  · intro past current _ outsideZero action enabled node notMember
    cases action with
    | timeout candidate =>
        simpa [next, rawNext, nextTimeout] using outsideZero node notMember
    | requestVote source dest =>
        simpa [next, rawNext, nextRequestVote] using outsideZero node notMember
    | appendEntries source dest =>
        simpa [next, rawNext, nextAppendEntries] using outsideZero node notMember
    | becomeLeader leader =>
        simpa [next, rawNext, nextBecomeLeader] using outsideZero node notMember
    | clientRequest leader =>
        simpa [next, rawNext, nextClientRequest] using outsideZero node notMember
    | signCommittableMessages leader =>
        simpa [next, rawNext, nextSignCommittableMessages] using
          outsideZero node notMember
    | changeConfiguration leader configuration =>
        have oldNotMember : node ∉ current.nodes := by
          intro oldMember
          exact notMember (by
            simp [next, rawNext, nextChangeConfiguration, oldMember])
        simpa [next, rawNext, nextChangeConfiguration] using
          outsideZero node oldNotMember
    | advanceCommitIndex leader =>
        have leaderMember : leader ∈ current.nodes := by
          have enabledFacts := enabled
          simp [Enabled, actionEnabled] at enabledFacts
          exact enabledFacts.1.1
        have nodeNe : node ≠ leader := by
          intro same
          subst node
          exact notMember leaderMember
        simpa [next, rawNext, nextAdvanceCommitIndex, updateNode, nodeNe] using
          outsideZero node notMember
    | receive dest source kind =>
        have destMember : dest ∈ current.nodes := by
          have enabledFacts := enabled
          simp [Enabled, actionEnabled] at enabledFacts
          exact enabledFacts.1.1
        have nodesEq :
            (next current (.receive dest source kind)).nodes =
              current.nodes := by
          cases hmessage : headMessage? current dest source with
          | none =>
              simp [next, rawNext, nextReceive, hmessage]
          | some message =>
              cases kind <;>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
                    conflictRollback]
              all_goals
                split <;> rfl
        rw [nodesEq] at notMember
        have nodeNe : node ≠ dest := by
          intro same
          subst node
          exact notMember destMember
        have commitEq :
            (next current (.receive dest source kind)).commitIndex node =
              current.commitIndex node := by
          cases hmessage : headMessage? current dest source with
          | none =>
              simp [next, rawNext, nextReceive, hmessage]
          | some message =>
              have messageDest : message.dest = dest := by
                have enabledFacts := enabled
                simp [Enabled, actionEnabled, hmessage] at enabledFacts
                exact enabledFacts.2.1.1
              cases kind <;>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
                    conflictRollback, updateNode, nodeNe, messageDest]
              all_goals
                (try split) <;> simp [nodeNe, messageDest]
        rw [commitEq]
        exact outsideZero node notMember
  · exact history

theorem protocolHistory_votedFor_none_outside_nodes
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    forall node,
      node ∉ state.nodes ->
        state.votedFor node = none := by
  apply protocolHistory_induction
    (start := start)
    (property := fun _ current =>
      forall node,
        node ∉ current.nodes ->
          current.votedFor node = none)
  · intro node notMember
    simp [initialState]
  · intro past current _ outsideNone action enabled node notMember
    cases action with
    | timeout candidate =>
        have candidateMember : candidate ∈ current.nodes := by
          have enabledFacts := enabled
          simp [Enabled, actionEnabled] at enabledFacts
          exact enabledFacts.1.1
        have nodeNe : node ≠ candidate := by
          intro same
          subst node
          exact notMember candidateMember
        simpa [next, rawNext, nextTimeout, updateNode, nodeNe] using
          outsideNone node notMember
    | changeConfiguration leader configuration =>
        have oldNotMember : node ∉ current.nodes := by
          intro oldMember
          exact notMember (by
            simp [next, rawNext, nextChangeConfiguration, oldMember])
        simpa [next, rawNext, nextChangeConfiguration] using
          outsideNone node oldNotMember
    | receive dest source kind =>
        have enabledFacts := enabled
        simp [Enabled, actionEnabled] at enabledFacts
        have destMember : dest ∈ current.nodes := enabledFacts.1.1
        have nodesEq :
            (next current (.receive dest source kind)).nodes =
              current.nodes := by
          cases hmessage : headMessage? current dest source with
          | none =>
              simp [next, rawNext, nextReceive, hmessage]
          | some message =>
              cases kind <;>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
                    conflictRollback]
              all_goals
                split <;> rfl
        rw [nodesEq] at notMember
        have nodeNe : node ≠ dest := by
          intro same
          subst node
          exact notMember destMember
        have votedForEq :
            (next current (.receive dest source kind)).votedFor node =
              current.votedFor node := by
          cases hmessage : headMessage? current dest source with
          | none =>
              simp [next, rawNext, nextReceive, hmessage]
          | some message =>
              cases kind <;>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
                    conflictRollback, updateNode, nodeNe]
              all_goals
                split <;> simp [nodeNe]
        rw [votedForEq]
        exact outsideNone node notMember
    | _ =>
        simpa [next, rawNext, nextRequestVote, nextAppendEntries,
          nextBecomeLeader, nextClientRequest, nextSignCommittableMessages,
          nextAdvanceCommitIndex] using outsideNone node notMember
  · exact history

private theorem occurs_extend_stateAtWitness
    {start : InitialConfiguration}
    {actions : List Action}
    {endState historicalState before : State}
    {action : Action}
    (stateAt :
      StateAtWitness
        start actions endState historicalState)
    (occurs :
      Occurs
        start stateAt.pastActions historicalState before action) :
    Occurs start actions endState before action := by
  rcases occurs with ⟨witness⟩
  exact ⟨{
    pastActions := witness.pastActions
    futureActions :=
      witness.futureActions ++ stateAt.futureActions
    actions_eq := by
      calc
        actions =
            stateAt.pastActions ++ stateAt.futureActions :=
          stateAt.actions_eq
        _ =
            (witness.pastActions ++
              [action] ++
              witness.futureActions) ++
                stateAt.futureActions := by
          exact congrArg
            (fun prior => prior ++ stateAt.futureActions)
            witness.actions_eq
        _ =
            witness.pastActions ++
              [action] ++
              (witness.futureActions ++
                stateAt.futureActions) := by
          simp only [List.append_assoc]
    before_history := witness.before_history
    enabled := witness.enabled
    after_history :=
      replays_append
        witness.after_history
        stateAt.remainingHistory
  }⟩

private theorem occurs_protocolHistory
    {start : InitialConfiguration}
    {actions : List Action}
    {endState before : State}
    {action : Action}
    (occurs : Occurs start actions endState before action) :
    ProtocolHistory start actions endState := by
  rcases occurs with ⟨witness⟩
  rw [witness.actions_eq]
  exact replays_append
    (replays_append_singleton
      witness.before_history
      witness.enabled)
    witness.after_history

private theorem protocolHistory_implies_QueueHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    QueueHistoryConsistent start actions state := by
  let extend :
      forall
        (past suffix : List Action)
        (before after : State),
        ProtocolHistory start past before ->
          QueueHistoryConsistent start past before ->
            Replays before suffix after ->
              QueueHistoryConsistent
                start (past ++ suffix) after := by
    intro past suffix
    induction suffix generalizing past with
    | nil =>
        intro before after pastHistory pastQueues replay
        simp [Replays] at replay
        subst after
        simpa using pastQueues
    | cons nextAction tail inductionHypothesis =>
        intro before after pastHistory pastQueues replay
        rcases replay with ⟨enabled, tailReplay⟩
        have nextHistory :=
          replays_append_singleton pastHistory enabled
        have nextQueues :=
          queueHistory_step
            pastHistory pastQueues nextAction enabled
        have result :=
          inductionHypothesis
            (past ++ [nextAction])
            (next before nextAction)
            after
            nextHistory
            nextQueues
            tailReplay
        simpa only [List.append_assoc, List.singleton_append] using result
  simpa using
    extend
      []
      actions
      (initialState start)
      state
      rfl
      (initial_QueueHistoryConsistent start)
      history

@[simp]
theorem initial_LogInv (start : InitialConfiguration) :
    LogInv (initialState start) := by
  intro i j
  by_cases hi : i ∈ start.nodes <;>
    by_cases hj : j ∈ start.nodes <;>
      simp [committed, initialState, hi, hj, isLogPrefix, logPrefix,
        startLog]

@[simp]
theorem initial_MoreThanOneLeaderInv (start : InitialConfiguration) :
    MoreThanOneLeaderInv (initialState start) := by
  intro i j _ hi hj
  have hiMem : i ∈ start.nodes := by
    by_contra notMem
    simp [initialState, notMem] at hi
  have hjMem : j ∈ start.nodes := by
    by_contra notMem
    simp [initialState, notMem] at hj
  have hiEq : i = start.leader := by
    simpa [initialState, hiMem] using hi
  have hjEq : j = start.leader := by
    simpa [initialState, hjMem] using hj
  exact hiEq.trans hjEq.symm

@[simp]
theorem initial_SignatureInv (start : InitialConfiguration) :
    SignatureInv (initialState start) := by
  intro node positive
  by_cases h : node ∈ start.nodes
  · simp [initialState, startLog, entryAt?, h]
  · simp [initialState, h] at positive

