theorem quorumReadyCandidate_carries_chosenPrefix
    {candidateStart targetStart : InitialConfiguration}
    {candidateActions targetActions : List Action}
    {state targetBoundaryState : State}
    {candidate targetOwner : Node}
    {targetIndex : Nat}
    (_candidateWitness :
      CandidateChosenConfigurationWitness
        candidateStart candidateActions state candidate)
    (target :
      ChosenCommitCertificate
        targetStart targetActions state
        targetBoundaryState targetOwner targetIndex)
    (_targetEarlier :
      target.choiceTerm < state.currentTerm candidate)
    (activeConfiguration : ConfigurationAt)
    (_candidateConfigurationActive :
      activeConfiguration ∈ state.configurations candidate)
    (votes : Configuration)
    (candidateQuorum :
      isQuorum
          (votes ∩ activeConfiguration.nodes)
          activeConfiguration.nodes =
        true)
    (configurationActiveAtChoice :
      activeConfiguration ∈
        target.choiceState.configurations target.choiceLeader)
    (configurationWithinChoice :
      activeConfiguration.index <= target.choiceIndex)
    (nonSelfTransfer :
      forall voter : Node,
        voter ∈ votes ->
          voter ≠ candidate ->
            isLogPrefix
                target.chosenPrefix
                (state.log voter) ->
              isLogPrefix
                target.chosenPrefix
                (state.log candidate)) :
    isLogPrefix
      target.chosenPrefix
      (state.log candidate) := by
  rcases
      target.watermark_support
        activeConfiguration
        configurationActiveAtChoice
        configurationWithinChoice with
    ⟨supportQuorum, supportQuorumOk, support⟩
  rcases
      isQuorum_intersects
        supportQuorum
        (votes ∩ activeConfiguration.nodes)
        activeConfiguration.nodes
        supportQuorumOk
        candidateQuorum with
    ⟨voter, supportMember, candidateMember⟩
  have voteMember : voter ∈ votes :=
    (Finset.mem_inter.mp candidateMember).1
  have voterSupport := support voter supportMember
  by_cases voterIsCandidate : voter = candidate
  · simpa [voterIsCandidate] using voterSupport
  · exact
      nonSelfTransfer
        voter voteMember voterIsCandidate voterSupport

