    overlap
    (protocolHistory_implies_HistoricalElectedTermsNotStartInv history)

theorem quorumCandidateOverlap_implies_ElectionConfigurationsOverlapInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (candidateOverlap :
      TemporalQuorumCandidateConfigurationOverlapInv
        start actions state) :
    ElectionConfigurationsOverlapInv start actions state := by
  intro firstState secondState firstLeader secondLeader
    firstOccurrence secondOccurrence sameTerm
  rcases firstOccurrence with ⟨firstWitness⟩
  rcases secondOccurrence with ⟨secondWitness⟩
  have firstEnabled := firstWitness.enabled
  have secondEnabled := secondWitness.enabled
  simp [Enabled, actionEnabled] at firstEnabled secondEnabled
  exact candidateOverlap
    firstState secondState
    (occurs_before_stateAt ⟨firstWitness⟩)
    (occurs_before_stateAt ⟨secondWitness⟩)
    firstLeader secondLeader
    firstEnabled.1.2 firstEnabled.2
    secondEnabled.1.2 secondEnabled.2
    sameTerm

theorem historicalElectionCores_imply_HistoricalCandidateQuorumFreshInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (votes : HistoricalElectionVoteCore start actions state)
    (overlap :
      TemporalQuorumCandidateConfigurationOverlapInv
        start actions state)
    (entryOrigins :
      HistoricalEntryTermLeaderOriginInv start actions state)
    (leaderTerms :
      HistoricalLeaderToCurrentCandidateTermInv
        start actions state) :
    HistoricalCandidateQuorumFreshInv start actions state := by
  intro candidate candidateState candidateQuorum
    historicalState stateAt node entry member
  by_cases sameTerm : entry.term = state.currentTerm candidate
  · have candidateAfterStart :=
      reachable_CandidateTermStrictAfterStart
        start
        (protocolHistory_reachable history)
        candidate
        candidateState
    have entryAfterStart : startTerm < entry.term := by
      simpa [sameTerm] using candidateAfterStart
    rcases
        entryOrigins
          historicalState stateAt node entry member entryAfterStart with
      ⟨entryOrigin⟩
    rcases occurs_before_stateAt entryOrigin.occurrence with
      ⟨appendTrace⟩
    have leaderHistory :=
      protocolHistory_implies_LeaderHistoryConsistent
        appendTrace.stateHistory
    rcases
        leaderHistory
          entryOrigin.leader entryOrigin.leader_state with
      ⟨leaderOrigin⟩
    cases leaderOrigin with
    | initial _leaderEq initialTerm =>
        have entryIsStart : entry.term = startTerm :=
          entryOrigin.term_eq.symm.trans initialTerm
        exact False.elim
          ((Nat.ne_of_lt candidateAfterStart)
            (entryIsStart.symm.trans sameTerm))
    | elected election =>
        have extendedElection :=
          occurs_extend_stateAtWitness
            appendTrace election.occurrence
        have electionEnabled :
            Enabled
              election.electionState
              (.becomeLeader entryOrigin.leader) := by
          rcases election.occurrence with ⟨occurrence⟩
          exact occurrence.enabled
        have electionEnabledFacts := electionEnabled
        simp [Enabled, actionEnabled] at electionEnabledFacts
        have electionTermEq :
            election.electionState.currentTerm entryOrigin.leader =
              state.currentTerm candidate :=
          election.term_eq.symm.trans
            (entryOrigin.term_eq.trans sameTerm)
        rcases overlap
            election.electionState
            state
            (occurs_before_stateAt extendedElection)
            (protocolHistory_final_stateAt history)
            entryOrigin.leader
            candidate
            electionEnabledFacts.1.2
            electionEnabledFacts.2
            candidateState
            candidateQuorum
            electionTermEq with
          ⟨electionConfiguration, candidateConfiguration,
            electionConfigurationMember,
            candidateConfigurationMember,
            sameConfigurationNodes⟩
        have electionQuorum :=
          becomeLeader_enabled_configuration_quorum
            election.electionState
            entryOrigin.leader
            electionConfiguration
            electionEnabled
            electionConfigurationMember
        have candidateQuorumForConfiguration :
            isQuorum
                (state.votesGranted candidate ∩
                  candidateConfiguration.nodes)
                candidateConfiguration.nodes =
              true := by
          have allQuorums := candidateQuorum
          simp [allConfigurationsHaveQuorum] at allQuorums
          exact allQuorums
            candidateConfiguration candidateConfigurationMember
        have candidateQuorumOnElectionConfiguration :
            isQuorum
                (state.votesGranted candidate ∩
                  electionConfiguration.nodes)
                electionConfiguration.nodes =
              true := by
          rw [sameConfigurationNodes]
          exact candidateQuorumForConfiguration
        rcases isQuorum_intersects
            (election.electionState.votesGranted
              entryOrigin.leader ∩ electionConfiguration.nodes)
            (state.votesGranted candidate ∩
              electionConfiguration.nodes)
            electionConfiguration.nodes
            electionQuorum
            candidateQuorumOnElectionConfiguration with
          ⟨voter, electionMembership, candidateMembership⟩
        simp only [Finset.mem_inter] at electionMembership candidateMembership
        have electionOwner :=
          votes.electionVotes
            election.electionState
            entryOrigin.leader
            extendedElection
            voter
            electionMembership.1
        have candidateOwner :=
          votes.ownerConsistent.countedChoices
            candidate
            voter
            (Or.inl candidateState)
            candidateMembership.1
        rw [electionTermEq] at electionOwner
        have leaderEq : entryOrigin.leader = candidate :=
          Option.some.inj
            (electionOwner.symm.trans candidateOwner)
        subst candidate
        have strictGrowth :=
          leaderTerms
            entryOrigin.appendState
            (occurs_before_stateAt entryOrigin.occurrence)
            entryOrigin.leader
            entryOrigin.leader_state
            candidateState
        exact False.elim
          ((Nat.ne_of_lt strictGrowth)
            (entryOrigin.term_eq.trans sameTerm))
  · exact bne_iff_ne.mpr sameTerm

theorem candidateTermNotInLog_antecedent_implies_PotentialCandidateQuorum
    (state : State)
    (candidate : Node)
    (quorum :
      forall configuration,
        configuration ∈ state.configurations candidate ->
          isQuorum
              (votersForCandidateTerm state candidate)
              configuration.nodes =
            true) :
    PotentialCandidateQuorum state candidate := by
  simp [PotentialCandidateQuorum, allConfigurationsHaveQuorum]
  intro configuration member
  have configurationQuorum := quorum configuration member
  have votersSubset : votersForCandidateTerm state candidate ⊆
      configuration.nodes := by
    have quorumFacts := configurationQuorum
    simp [isQuorum] at quorumFacts
    exact quorumFacts.1
  rw [Finset.inter_eq_left.mpr votersSubset]
  exact configurationQuorum

theorem historicalElectionCores_imply_CandidateTermNotInLogInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (votes : HistoricalElectionVoteCore start actions state)
    (overlap :
      TemporalCountedToPotentialCandidateConfigurationOverlapInv
        start actions state)
    (entryOrigins :
      HistoricalEntryTermLeaderOriginInv start actions state)
    (leaderTerms :
      HistoricalLeaderToCurrentCandidateTermInv
        start actions state) :
    CandidateTermNotInLogInv state := by
  intro candidate candidateState candidateQuorum node entry member
  have potentialQuorum :=
    candidateTermNotInLog_antecedent_implies_PotentialCandidateQuorum
      state candidate candidateQuorum
  by_cases sameTerm : entry.term = state.currentTerm candidate
  · have candidateAfterStart :=
      reachable_CandidateTermStrictAfterStart
        start
        (protocolHistory_reachable history)
        candidate
        candidateState
    have entryAfterStart : startTerm < entry.term := by
      simpa [sameTerm] using candidateAfterStart
    rcases
        entryOrigins
          state
          (protocolHistory_final_stateAt history)
          node entry member entryAfterStart with
      ⟨entryOrigin⟩
    rcases occurs_before_stateAt entryOrigin.occurrence with
      ⟨appendTrace⟩
    have leaderHistory :=
      protocolHistory_implies_LeaderHistoryConsistent
        appendTrace.stateHistory
    rcases
        leaderHistory
          entryOrigin.leader entryOrigin.leader_state with
      ⟨leaderOrigin⟩
    cases leaderOrigin with
    | initial _leaderEq initialTerm =>
        have entryIsStart : entry.term = startTerm :=
          entryOrigin.term_eq.symm.trans initialTerm
        exact False.elim
          ((Nat.ne_of_lt candidateAfterStart)
            (entryIsStart.symm.trans sameTerm))
    | elected election =>
        have extendedElection :=
          occurs_extend_stateAtWitness
            appendTrace election.occurrence
        have electionEnabled :
            Enabled
              election.electionState
              (.becomeLeader entryOrigin.leader) := by
          rcases election.occurrence with ⟨occurrence⟩
          exact occurrence.enabled
        have electionEnabledFacts := electionEnabled
        simp [Enabled, actionEnabled] at electionEnabledFacts
        have electionTermEq :
            election.electionState.currentTerm entryOrigin.leader =
              state.currentTerm candidate :=
          election.term_eq.symm.trans
            (entryOrigin.term_eq.trans sameTerm)
        rcases overlap
            election.electionState
            state
            (occurs_before_stateAt extendedElection)
            (protocolHistory_final_stateAt history)
            entryOrigin.leader
            candidate
            electionEnabledFacts.1.2
            electionEnabledFacts.2
            candidateState
            potentialQuorum
            electionTermEq with
          ⟨electionConfiguration, potentialConfiguration,
            electionConfigurationMember,
            potentialConfigurationMember,
            sameConfigurationNodes⟩
        have electionQuorum :=
          becomeLeader_enabled_configuration_quorum
            election.electionState
            entryOrigin.leader
            electionConfiguration
            electionEnabled
            electionConfigurationMember
        have potentialQuorumForConfiguration :
            isQuorum
                (votersForCandidateTerm state candidate ∩
                  potentialConfiguration.nodes)
                potentialConfiguration.nodes =
              true := by
          have allQuorums := potentialQuorum
          simp [PotentialCandidateQuorum, allConfigurationsHaveQuorum]
            at allQuorums
          exact allQuorums
            potentialConfiguration potentialConfigurationMember
        have potentialQuorumOnElectionConfiguration :
            isQuorum
                (votersForCandidateTerm state candidate ∩
                  electionConfiguration.nodes)
                electionConfiguration.nodes =
              true := by
          rw [sameConfigurationNodes]
          exact potentialQuorumForConfiguration
        rcases isQuorum_intersects
            (election.electionState.votesGranted
              entryOrigin.leader ∩ electionConfiguration.nodes)
            (votersForCandidateTerm state candidate ∩
              electionConfiguration.nodes)
            electionConfiguration.nodes
            electionQuorum
            potentialQuorumOnElectionConfiguration with
          ⟨voter, electionMembership, potentialMembership⟩
        simp only [Finset.mem_inter] at electionMembership potentialMembership
        have electionOwner :=
          votes.electionVotes
            election.electionState
            entryOrigin.leader
            extendedElection
            voter
            electionMembership.1
        have potentialVote := potentialMembership.1
        simp [votersForCandidateTerm] at potentialVote
        have potentialOwner :
            votes.owner voter (state.currentTerm candidate) =
              some candidate := by
          calc
            votes.owner voter (state.currentTerm candidate) =
                votes.owner voter (state.currentTerm voter) := by
              rw [potentialVote.2.1]
            _ = state.votedFor voter :=
              votes.ownerConsistent.currentChoice voter
            _ = some candidate := potentialVote.2.2
        rw [electionTermEq] at electionOwner
        have leaderEq : entryOrigin.leader = candidate :=
          Option.some.inj
            (electionOwner.symm.trans potentialOwner)
        subst candidate
        have strictGrowth :=
          leaderTerms
            entryOrigin.appendState
            (occurs_before_stateAt entryOrigin.occurrence)
            entryOrigin.leader
            entryOrigin.leader_state
            candidateState
        exact False.elim
          ((Nat.ne_of_lt strictGrowth)
            (entryOrigin.term_eq.trans sameTerm))
  · exact bne_iff_ne.mpr sameTerm

private structure CandidateElectionSnapshotEq
    (before after : State)
    (candidate : Node) : Prop where
  candidate_state :
    before.leadershipState candidate = .candidate
  current_term :
    after.currentTerm candidate =
      before.currentTerm candidate
  votes_granted :
    after.votesGranted candidate =
      before.votesGranted candidate
  configurations :
    after.configurations candidate =
      before.configurations candidate

private structure PotentialCandidateSnapshot
    (before after : State)
    (candidate : Node) : Prop where
  candidate_state :
    before.leadershipState candidate = .candidate
  current_term :
    after.currentTerm candidate =
      before.currentTerm candidate
  voters_subset :
    votersForCandidateTerm after candidate ⊆
      votersForCandidateTerm before candidate
  configurations :
    after.configurations candidate =
      before.configurations candidate

private theorem isQuorum_mono_votes
    {smaller larger configuration : Configuration}
    (subset : smaller ⊆ larger)
    (largerSubset : larger ⊆ configuration)
    (quorum : isQuorum smaller configuration = true) :
    isQuorum larger configuration = true := by
  simp [isQuorum] at quorum ⊢
  exact
    ⟨largerSubset,
      lt_of_lt_of_le quorum.2
        (Nat.mul_le_mul_right 2 (Finset.card_le_card subset))⟩

private theorem potentialCandidateQuorum_before_of_snapshot
    {before after : State}
    {candidate : Node}
    (snapshot : PotentialCandidateSnapshot before after candidate)
    (afterQuorum : PotentialCandidateQuorum after candidate) :
    PotentialCandidateQuorum before candidate := by
  simp [PotentialCandidateQuorum, allConfigurationsHaveQuorum] at afterQuorum ⊢
  intro configuration member
  have afterConfigurationMember :
      configuration ∈ after.configurations candidate := by
    simpa [snapshot.configurations] using member
  apply
    isQuorum_mono_votes
      (by
        intro voter voterMember
        rcases Finset.mem_inter.mp voterMember with
          ⟨voterMember, configurationMember⟩
        exact
          Finset.mem_inter.mpr
            ⟨snapshot.voters_subset voterMember, configurationMember⟩)
      Finset.inter_subset_right
  exact afterQuorum configuration afterConfigurationMember

private theorem endpoint_potential_voters_subset_or_formation
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (requestVotes :
      RequestVoteMessageHistoryConsistent start actions state)
    (action : Action)
    (candidate : Node)
    (afterCandidate :
      (next state action).leadershipState candidate = .candidate) :
    Or
      (votersForCandidateTerm (next state action) candidate ⊆
        votersForCandidateTerm state candidate)
      (PotentialCandidateFormationAction state action candidate) := by
  cases action with
  | timeout timedOut =>
      by_cases candidateIsTimedOut : candidate = timedOut
      · exact
          Or.inr
            (Or.inl ⟨timedOut, rfl, candidateIsTimedOut⟩)
      · apply Or.inl
        intro voter voterMember
        simp only [votersForCandidateTerm, Finset.mem_filter] at voterMember ⊢
        by_cases voterIsTimedOut : voter = timedOut
        · subst voter
          simp [next, rawNext, nextTimeout, updateNode,
            candidateIsTimedOut] at voterMember
          exact False.elim (candidateIsTimedOut voterMember.2.2.symm)
        · simpa [next, rawNext, nextTimeout, updateNode,
            candidateIsTimedOut, voterIsTimedOut] using voterMember
  | requestVote source dest =>
      exact Or.inl (by
        simp [next, rawNext, nextRequestVote, votersForCandidateTerm])
  | appendEntries source dest =>
      exact Or.inl (by
        simp [next, rawNext, nextAppendEntries, votersForCandidateTerm])
  | becomeLeader elected =>
      exact Or.inl (by
        simp [next, rawNext, nextBecomeLeader, votersForCandidateTerm])
  | clientRequest leader =>
      exact Or.inl (by
        simp [next, rawNext, nextClientRequest, votersForCandidateTerm])
  | signCommittableMessages leader =>
      exact Or.inl (by
        simp [next, rawNext, nextSignCommittableMessages,
          votersForCandidateTerm])
  | changeConfiguration leader configuration =>
      apply Or.inl
      intro voter voterMember
      simp only [votersForCandidateTerm, Finset.mem_filter] at voterMember ⊢
      simp [next, rawNext, nextChangeConfiguration] at voterMember
      refine ⟨?_, voterMember.2⟩
      rcases voterMember.1 with oldMember | newMember
      · exact oldMember
      · by_cases oldMember : voter ∈ state.nodes
        · exact oldMember
        · have noVote :=
            protocolHistory_votedFor_none_outside_nodes
              history voter oldMember
          rw [noVote] at voterMember
          exact False.elim (by simpa using voterMember.2.2)
  | advanceCommitIndex leader =>
      exact Or.inl (by
        simp [next, rawNext, nextAdvanceCommitIndex,
          votersForCandidateTerm])
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          exact Or.inl (by
            simp [next, rawNext, nextReceive, hmessage,
              votersForCandidateTerm])
      | some message =>
          cases kind with
          | updateTerm =>
              by_cases candidateIsDest : candidate = dest
              · subst candidate
                cases hrole : state.leadershipState dest <;>
                  simp [next, rawNext, nextReceive, hmessage,
                    updateNode, hrole] at afterCandidate
              · apply Or.inl
                intro voter voterMember
                simp only [votersForCandidateTerm, Finset.mem_filter]
                  at voterMember ⊢
                by_cases voterIsDest : voter = dest
                · subst voter
                  simp [next, rawNext, nextReceive, hmessage,
                    updateNode, candidateIsDest] at voterMember
                · simpa [next, rawNext, nextReceive, hmessage,
                    updateNode, candidateIsDest, voterIsDest] using
                    voterMember
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  let grant :=
                    requestVoteGranted
                      state dest source message.term lastTerm lastIndex
                  by_cases granted : grant = true
                  · by_cases candidateIsSource : candidate = source
                    · subst candidate
                      have queued :
                          message ∈ state.messages dest source :=
                        headMessage?_mem
                          state dest source message hmessage
                      have hasSend :
                          MessageHasRVSendWitness
                            start actions state dest source message := by
                        simpa [hbody] using
                          requestVotes dest source message queued
                      rcases hasSend with ⟨send⟩
                      have preVoteFalse : isPreVote = false := by
                        have sentBody :=
                          congrArg Message.body send.message_eq
                        have sentFacts := sentBody.symm
                        simp [requestVoteMessage, hbody] at sentFacts
                        exact sentFacts.2.2
                      subst isPreVote
                      exact
                        Or.inr
                          (Or.inr
                            ⟨dest, message, lastTerm, lastIndex,
                              rfl, hmessage, hbody,
                              by simpa [grant] using granted⟩)
                    · apply Or.inl
                      intro voter voterMember
                      simp only [votersForCandidateTerm,
                        Finset.mem_filter]
                        at voterMember ⊢
                      by_cases voterIsDest : voter = dest
                      · subst voter
                        simp [next, rawNext, nextReceive, hmessage,
                          hbody, grant, granted, updateNode] at voterMember
                        exact False.elim
                          (candidateIsSource voterMember.2.2.symm)
                      · simpa [next, rawNext, nextReceive, hmessage,
                          hbody, grant, granted, updateNode,
                          voterIsDest] using voterMember
                  · exact Or.inl (by
                      simp [next, rawNext, nextReceive, hmessage,
                        hbody, grant, granted, votersForCandidateTerm])
              | _ =>
                  exact Or.inl (by
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      votersForCandidateTerm])
          | dropIgnored =>
              exact Or.inl (by
                simp [next, rawNext, nextReceive, hmessage,
                  votersForCandidateTerm])
          | handleRequestVoteResponse =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    votersForCandidateTerm])
          | dropRequestVoteResponseOutOfState =>
              exact Or.inl (by
                simp [next, rawNext, nextReceive, hmessage,
                  votersForCandidateTerm])
          | dropRequestVoteResponseStale =>
              exact Or.inl (by
                simp [next, rawNext, nextReceive, hmessage,
                  votersForCandidateTerm])
          | rejectAppendEntriesRequest =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    votersForCandidateTerm]
                all_goals
                  split <;> simp)
          | returnToFollower =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    votersForCandidateTerm])
          | appendEntriesAlreadyDone =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone,
                    votersForCandidateTerm])
          | appendEntriesNoConflict =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesNoConflict,
                    votersForCandidateTerm])
          | appendEntriesConflictThenAlreadyDone =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone, conflictRollback,
                    votersForCandidateTerm])
          | appendEntriesConflictThenNoConflict =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesNoConflict, conflictRollback,
                    votersForCandidateTerm])
          | handleAppendEntriesResponseSuccess =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    votersForCandidateTerm])
          | handleAppendEntriesResponseFailure =>
              exact Or.inl (by
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    votersForCandidateTerm])
          | dropAppendEntriesResponseOutOfState =>
              exact Or.inl (by
                simp [next, rawNext, nextReceive, hmessage,
                  votersForCandidateTerm])
          | dropAppendEntriesResponseStale =>
              exact Or.inl (by
                simp [next, rawNext, nextReceive, hmessage,
                  votersForCandidateTerm])

private theorem singleton_votes_quorum_configuration_eq
    (candidate : Node)
    (configuration : ConfigurationAt)
    (quorum :
      isQuorum
          ({candidate} ∩ configuration.nodes)
          configuration.nodes =
        true) :
    configuration.nodes = {candidate} := by
  have candidateMember :
      candidate ∈ configuration.nodes := by
    by_contra notMember
    simp [isQuorum, notMember] at quorum
  have singletonSubset :
      {candidate} ⊆ configuration.nodes := by
    simpa using candidateMember
  have intersectionEq :
      {candidate} ∩ configuration.nodes = {candidate} :=
    Finset.inter_eq_left.mpr singletonSubset
  have cardLt : configuration.nodes.card < 2 := by
    have quorumFacts := quorum
    simp [isQuorum, intersectionEq] at quorumFacts
    exact quorumFacts.2
  apply Finset.Subset.antisymm
  · intro node nodeMember
    by_contra different
    have nodeNe : node ≠ candidate := by
      simpa using different
    have pairSubset :
        {candidate, node} ⊆ configuration.nodes := by
      intro selected selectedMember
      simp only [Finset.mem_insert, Finset.mem_singleton] at selectedMember
      rcases selectedMember with selectedIsCandidate | selectedIsNode
      · simpa [selectedIsCandidate] using candidateMember
      · simpa [selectedIsNode] using nodeMember
    have pairCardLe :=
      Finset.card_le_card pairSubset
    have pairCard : ({candidate, node} : Finset Node).card = 2 := by
      simp [Ne.symm nodeNe]
    omega
  · exact singletonSubset

private theorem endpoint_candidate_snapshot_or_formation
    (state : State)
    (action : Action)
    (candidate : Node)
    (enabled : Enabled state action)
    (afterCandidate :
      (next state action).leadershipState candidate = .candidate) :
    Or
      (CandidateElectionSnapshotEq
        state (next state action) candidate)
      (QuorumCandidateFormationAction state action candidate) := by
  cases action with
  | timeout timedOut =>
      by_cases candidateIsTimedOut : candidate = timedOut
      · exact Or.inr (Or.inl ⟨timedOut, rfl, candidateIsTimedOut⟩)
      · exact Or.inl {
          candidate_state := by
            simpa [next, rawNext, nextTimeout, updateNode,
              candidateIsTimedOut] using afterCandidate
          current_term := by
            simp [next, rawNext, nextTimeout, updateNode,
              candidateIsTimedOut]
          votes_granted := by
            simp [next, rawNext, nextTimeout, updateNode,
              candidateIsTimedOut]
          configurations := by
            simp [next, rawNext, nextTimeout]
        }
  | requestVote source dest =>
      exact Or.inl {
        candidate_state := by
          simpa [next, rawNext, nextRequestVote] using afterCandidate
        current_term := by simp [next, rawNext, nextRequestVote]
        votes_granted := by simp [next, rawNext, nextRequestVote]
        configurations := by simp [next, rawNext, nextRequestVote]
      }
  | appendEntries source dest =>
      exact Or.inl {
        candidate_state := by
          simpa [next, rawNext, nextAppendEntries] using afterCandidate
        current_term := by simp [next, rawNext, nextAppendEntries]
        votes_granted := by simp [next, rawNext, nextAppendEntries]
        configurations := by simp [next, rawNext, nextAppendEntries]
      }
  | becomeLeader elected =>
      by_cases candidateIsElected : candidate = elected
      · subst candidate
        simp [next, rawNext, nextBecomeLeader, updateNode] at afterCandidate
      · exact Or.inl {
          candidate_state := by
            simpa [next, rawNext, nextBecomeLeader, updateNode,
              candidateIsElected] using afterCandidate
          current_term := by
            simp [next, rawNext, nextBecomeLeader, updateNode]
          votes_granted := by
            simp [next, rawNext, nextBecomeLeader, updateNode]
          configurations := by
            simp [next, rawNext, nextBecomeLeader, updateNode,
              candidateIsElected]
        }
  | clientRequest leader =>
      exact Or.inl {
        candidate_state := by
          simpa [next, rawNext, nextClientRequest] using afterCandidate
        current_term := by simp [next, rawNext, nextClientRequest]
        votes_granted := by simp [next, rawNext, nextClientRequest]
        configurations := by simp [next, rawNext, nextClientRequest]
      }
  | signCommittableMessages leader =>
      exact Or.inl {
        candidate_state := by
          simpa [next, rawNext, nextSignCommittableMessages] using
            afterCandidate
        current_term := by
          simp [next, rawNext, nextSignCommittableMessages]
        votes_granted := by
          simp [next, rawNext, nextSignCommittableMessages]
        configurations := by
          simp [next, rawNext, nextSignCommittableMessages]
      }
  | changeConfiguration leader configuration =>
      by_cases candidateIsLeader : candidate = leader
      · subst candidate
        simp [next, rawNext, nextChangeConfiguration] at afterCandidate
        simp [Enabled, actionEnabled] at enabled
        simp_all
      · exact Or.inl {
          candidate_state := by
            simpa [next, rawNext, nextChangeConfiguration] using
              afterCandidate
          current_term := by
            simp [next, rawNext, nextChangeConfiguration]
          votes_granted := by
            simp [next, rawNext, nextChangeConfiguration]
          configurations := by
            simp [next, rawNext, nextChangeConfiguration, updateNode,
              candidateIsLeader]
        }
  | advanceCommitIndex leader =>
      by_cases candidateIsLeader : candidate = leader
      · subst candidate
        simp [Enabled, actionEnabled] at enabled
        simp [next, rawNext, nextAdvanceCommitIndex, updateNode] at afterCandidate
        split at afterCandidate
        · contradiction
        · rw [enabled.1.2] at afterCandidate
          contradiction
      · exact Or.inl {
          candidate_state := by
            simpa [next, rawNext, nextAdvanceCommitIndex, updateNode,
              candidateIsLeader] using afterCandidate
          current_term := by
            simp [next, rawNext, nextAdvanceCommitIndex, updateNode]
          votes_granted := by
            simp [next, rawNext, nextAdvanceCommitIndex, updateNode]
          configurations := by
            simp [next, rawNext, nextAdvanceCommitIndex, updateNode,
              candidateIsLeader]
        }
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          exact Or.inl {
            candidate_state := by
              simpa [next, rawNext, nextReceive, hmessage] using
                afterCandidate
            current_term := by
              simp [next, rawNext, nextReceive, hmessage]
            votes_granted := by
              simp [next, rawNext, nextReceive, hmessage]
            configurations := by
              simp [next, rawNext, nextReceive, hmessage]
          }
      | some message =>
          have oldCandidate :
              state.leadershipState candidate = .candidate :=
            candidate_before_of_candidate_after
              state
              (.receive dest source kind)
              candidate
              afterCandidate
              (by intro timedOut; simp)
          cases kind with
          | dropIgnored =>
              exact Or.inl {
                candidate_state := oldCandidate
                current_term := by
                  simp [next, rawNext, nextReceive, hmessage]
                votes_granted := by
                  simp [next, rawNext, nextReceive, hmessage]
                configurations := by
                  simp [next, rawNext, nextReceive, hmessage]
              }
          | updateTerm =>
              by_cases candidateIsDest : candidate = dest
              · subst candidate
                simp [next, rawNext, nextReceive, hmessage,
                  updateNode, oldCandidate] at afterCandidate
              · exact Or.inl {
                  candidate_state := oldCandidate
                  current_term := by
                    simp [next, rawNext, nextReceive, hmessage,
                      updateNode, candidateIsDest]
                  votes_granted := by
                    simp [next, rawNext, nextReceive, hmessage]
                  configurations := by
                    simp [next, rawNext, nextReceive, hmessage]
                }
          | handleRequestVoteRequest =>
              cases hbody : message.body <;>
                exact Or.inl {
                  candidate_state := oldCandidate
                  current_term := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                  votes_granted := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                  configurations := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                }
          | handleRequestVoteResponse =>
              cases hbody : message.body with
              | requestVoteResponse voteGranted isPreVote =>
                  have enabledFacts := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabledFacts
                  by_cases candidateIsDest : candidate = dest
                  · subst candidate
                    cases voteGranted with
                    | false =>
                      exact Or.inl {
                        candidate_state := by
                          simpa [next, rawNext, nextReceive, hmessage,
                            hbody] using afterCandidate
                        current_term := by
                          simp [next, rawNext, nextReceive, hmessage, hbody]
                        votes_granted := by
                          simp [next, rawNext, nextReceive, hmessage, hbody]
                        configurations := by
                          simp [next, rawNext, nextReceive, hmessage, hbody]
                      }
                    | true =>
                      have preVoteFalse : isPreVote = false := by
                        simpa using enabledFacts.2.2.1.2
                      subst isPreVote
                      exact Or.inr (Or.inr
                        ⟨source, message, rfl, hmessage, hbody⟩)
                  · exact Or.inl {
                      candidate_state := oldCandidate
                      current_term := by
                        simp [next, rawNext, nextReceive, hmessage, hbody]
                      votes_granted := by
                        simp only [next, rawNext, nextReceive, hmessage, hbody]
                        by_cases granted : voteGranted = true <;>
                          simp [granted, updateNode, candidateIsDest]
                      configurations := by
                        simp [next, rawNext, nextReceive, hmessage, hbody]
                    }
              | _ =>
                  exact Or.inl {
                    candidate_state := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody] using
                        afterCandidate
                    current_term := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                    votes_granted := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                    configurations := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                  }
          | dropRequestVoteResponseOutOfState =>
              exact Or.inl {
                candidate_state := oldCandidate
                current_term := by
                  simp [next, rawNext, nextReceive, hmessage]
                votes_granted := by
                  simp [next, rawNext, nextReceive, hmessage]
                configurations := by
                  simp [next, rawNext, nextReceive, hmessage]
              }
          | dropRequestVoteResponseStale =>
              exact Or.inl {
                candidate_state := oldCandidate
                current_term := by
                  simp [next, rawNext, nextReceive, hmessage]
                votes_granted := by
                  simp [next, rawNext, nextReceive, hmessage]
                configurations := by
                  simp [next, rawNext, nextReceive, hmessage]
              }
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm <;>
                    exact Or.inl {
                      candidate_state := oldCandidate
                      current_term := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
                      votes_granted := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
                      configurations := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
                    }
              | _ =>
                  exact Or.inl {
                    candidate_state := oldCandidate
                    current_term := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                    votes_granted := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                    configurations := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                  }
          | returnToFollower =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  by_cases candidateIsDest : candidate = dest
                  · subst candidate
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      updateNode] at afterCandidate
                  · exact Or.inl {
                      candidate_state := oldCandidate
                      current_term := by
                        simp [next, rawNext, nextReceive, hmessage, hbody]
                      votes_granted := by
                        simp [next, rawNext, nextReceive, hmessage, hbody]
                      configurations := by
                        simp [next, rawNext, nextReceive, hmessage, hbody]
                    }
              | _ =>
                  exact Or.inl {
                    candidate_state := oldCandidate
                    current_term := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                    votes_granted := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                    configurations := by
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                  }
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody,
                    appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  by_cases candidateIsDest : candidate = dest
                  · subst candidate
                    simp [destMatches, oldCandidate] at branchEnabled
                  · exact Or.inl {
                      candidate_state := oldCandidate
                      current_term := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone]
                      votes_granted := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone]
                      configurations := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone, updateNode,
                          destMatches, candidateIsDest]
                    }
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody,
                    appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  by_cases candidateIsDest : candidate = dest
                  · subst candidate
                    simp [destMatches, oldCandidate] at branchEnabled
                  · exact Or.inl {
                      candidate_state := oldCandidate
                      current_term := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict]
                      votes_granted := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict]
                      configurations := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, updateNode,
                          destMatches, candidateIsDest]
                    }
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody,
                    appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  by_cases candidateIsDest : candidate = dest
                  · subst candidate
                    simp [destMatches, oldCandidate] at branchEnabled
                  · exact Or.inl {
                      candidate_state := oldCandidate
                      current_term := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone, conflictRollback]
                      votes_granted := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone, conflictRollback]
                      configurations := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone, conflictRollback,
                          updateNode, destMatches, candidateIsDest]
                    }
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody,
                    appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  by_cases candidateIsDest : candidate = dest
                  · subst candidate
                    simp [destMatches, oldCandidate] at branchEnabled
                  · exact Or.inl {
                      candidate_state := oldCandidate
                      current_term := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, conflictRollback]
                      votes_granted := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, conflictRollback]
                      configurations := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, conflictRollback,
                          updateNode, destMatches, candidateIsDest]
                    }
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body <;>
                exact Or.inl {
                  candidate_state := oldCandidate
                  current_term := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                  votes_granted := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                  configurations := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                }
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body <;>
                exact Or.inl {
                  candidate_state := oldCandidate
                  current_term := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                  votes_granted := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                  configurations := by
                    simp [next, rawNext, nextReceive, hmessage, hbody]
                }
          | dropAppendEntriesResponseOutOfState =>
              exact Or.inl {
                candidate_state := oldCandidate
                current_term := by
                  simp [next, rawNext, nextReceive, hmessage]
                votes_granted := by
                  simp [next, rawNext, nextReceive, hmessage]
                configurations := by
                  simp [next, rawNext, nextReceive, hmessage]
              }
          | dropAppendEntriesResponseStale =>
              exact Or.inl {
                candidate_state := oldCandidate
                current_term := by
                  simp [next, rawNext, nextReceive, hmessage]
                votes_granted := by
                  simp [next, rawNext, nextReceive, hmessage]
                configurations := by
                  simp [next, rawNext, nextReceive, hmessage]
              }

private theorem endpoint_potential_candidate_snapshot_or_formation
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (requestVotes :
      RequestVoteMessageHistoryConsistent start actions state)
    (action : Action)
    (candidate : Node)
    (enabled : Enabled state action)
    (afterCandidate :
      (next state action).leadershipState candidate = .candidate) :
    Or
      (PotentialCandidateSnapshot
        state (next state action) candidate)
      (PotentialCandidateFormationAction state action candidate) := by
  rcases
      endpoint_potential_voters_subset_or_formation
        history requestVotes action candidate afterCandidate with
    votersSubset | formation
  · rcases
        endpoint_candidate_snapshot_or_formation
          state action candidate enabled afterCandidate with
      snapshot | countedFormation
    · exact
        Or.inl
          {
            candidate_state := snapshot.candidate_state
            current_term := snapshot.current_term
            voters_subset := votersSubset
            configurations := snapshot.configurations
          }
    · rcases countedFormation with
        ⟨timedOut, actionEq, candidateEq⟩ |
        ⟨source, response, actionEq, responseHead, responseBody⟩
      · exact
          Or.inr
            (Or.inl ⟨timedOut, actionEq, candidateEq⟩)
      · subst action
        exact
          Or.inl
            {
              candidate_state :=
                candidate_before_of_candidate_after
                  state
                  (.receive
                    candidate source .handleRequestVoteResponse)
                  candidate
                  afterCandidate
                  (by intro timedOut; simp)
              current_term := by
                simp [next, rawNext, nextReceive, responseHead,
                  responseBody]
              voters_subset := votersSubset
              configurations := by
                simp [next, rawNext, nextReceive, responseHead,
                  responseBody]
            }
  · exact Or.inr formation

theorem temporalCountedToPotentialCandidateConfigurationOverlap_append_step_of_formation
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (overlap :
      TemporalCountedToPotentialCandidateConfigurationOverlapInv
        start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (_countedFormation :
      QuorumCandidateFormationOverlap start actions state action)
    (countedToPotentialFormation :
      CountedCandidateFormationToPotentialOverlap
        start actions state action)
    (potentialFormation :
      CountedToPotentialCandidateFormationOverlap
        start actions state action) :
    TemporalCountedToPotentialCandidateConfigurationOverlapInv
      start
      (actions ++ [action])
      (next state action) := by
  have requestVotes :=
    queueHistory_implies_RequestVoteMessageHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent history)
  intro countedState potentialState countedAt potentialAt
    countedCandidate potentialCandidate countedCandidateState
    countedQuorum potentialCandidateState potentialQuorum sameTerm
  rcases
      stateAt_append_singleton_cases history enabled countedAt with
    countedOld | countedFinal
  · rcases
        stateAt_append_singleton_cases history enabled potentialAt with
      potentialOld | potentialFinal
    · exact overlap
        countedState potentialState countedOld potentialOld
        countedCandidate potentialCandidate countedCandidateState
        countedQuorum potentialCandidateState potentialQuorum sameTerm
    · subst potentialState
      rcases
          endpoint_potential_candidate_snapshot_or_formation
            history requestVotes action potentialCandidate enabled
            potentialCandidateState with
        potentialSnapshot | potentialCreated
      · have oldPotentialQuorum :=
          potentialCandidateQuorum_before_of_snapshot
            potentialSnapshot potentialQuorum
        rcases overlap
            countedState state countedOld
            (protocolHistory_final_stateAt history)
            countedCandidate potentialCandidate countedCandidateState
            countedQuorum potentialSnapshot.candidate_state
            oldPotentialQuorum
            (by
              simpa [potentialSnapshot.current_term] using sameTerm) with
          ⟨countedConfiguration, potentialConfiguration,
            countedMember, potentialMember, sameNodes⟩
        exact
          ⟨countedConfiguration, potentialConfiguration,
            countedMember,
            by
              simpa [potentialSnapshot.configurations] using
                potentialMember,
            sameNodes⟩
      · exact
          potentialFormation
            potentialCandidate potentialCreated potentialCandidateState
            potentialQuorum countedState countedAt countedCandidate
            countedCandidateState countedQuorum sameTerm
  · subst countedState
    rcases
        endpoint_candidate_snapshot_or_formation
          state action countedCandidate enabled countedCandidateState with
      countedSnapshot | countedCreated
    · have oldCountedQuorum :
          allConfigurationsHaveQuorum
              (state.votesGranted countedCandidate)
              (state.configurations countedCandidate) =
            true := by
        simpa [countedSnapshot.votes_granted,
          countedSnapshot.configurations] using countedQuorum
      rcases
          stateAt_append_singleton_cases history enabled potentialAt with
        potentialOld | potentialFinal
      · rcases overlap
            state potentialState
            (protocolHistory_final_stateAt history) potentialOld
            countedCandidate potentialCandidate
            countedSnapshot.candidate_state oldCountedQuorum
            potentialCandidateState potentialQuorum
            (by
              simpa [countedSnapshot.current_term] using sameTerm) with
          ⟨countedConfiguration, potentialConfiguration,
            countedMember, potentialMember, sameNodes⟩
        exact
          ⟨countedConfiguration, potentialConfiguration,
            by
              simpa [countedSnapshot.configurations] using countedMember,
            potentialMember, sameNodes⟩
      · subst potentialState
        rcases
            endpoint_potential_candidate_snapshot_or_formation
              history requestVotes action potentialCandidate enabled
              potentialCandidateState with
          potentialSnapshot | potentialCreated
        · have oldPotentialQuorum :=
            potentialCandidateQuorum_before_of_snapshot
              potentialSnapshot potentialQuorum
          rcases overlap
              state state
              (protocolHistory_final_stateAt history)
              (protocolHistory_final_stateAt history)
              countedCandidate potentialCandidate
              countedSnapshot.candidate_state oldCountedQuorum
              potentialSnapshot.candidate_state oldPotentialQuorum
              (by
                simpa [countedSnapshot.current_term,
                  potentialSnapshot.current_term] using sameTerm) with
            ⟨countedConfiguration, potentialConfiguration,
              countedMember, potentialMember, sameNodes⟩
          exact
            ⟨countedConfiguration, potentialConfiguration,
              by
                simpa [countedSnapshot.configurations] using countedMember,
              by
                simpa [potentialSnapshot.configurations] using
                  potentialMember,
              sameNodes⟩
        · exact
            potentialFormation
              potentialCandidate potentialCreated potentialCandidateState
              potentialQuorum
              (next state action)
              (protocolHistory_final_stateAt
                (replays_append_singleton history enabled))
              countedCandidate countedCandidateState countedQuorum sameTerm
    · exact
        countedToPotentialFormation
          countedCandidate countedCreated countedCandidateState
          countedQuorum potentialState potentialAt potentialCandidate
          potentialCandidateState potentialQuorum sameTerm

theorem temporalQuorumCandidateConfigurationOverlap_append_step_of_formation
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalElectionLogCore start actions state)
    (votes : HistoricalElectionVoteCore start actions state)
    (countedVotes :
      CountedVoteLogHistoryConsistent start actions state)
    (entryOrigins :
      HistoricalEntryTermLeaderOriginInv start actions state)
    (leaderTerms :
      HistoricalLeaderToCurrentCandidateTermInv
        start actions state)
    (configurationsExact : ConfigurationsExactInv state)
    (action : Action)
    (enabled : Enabled state action)
    (formationOverlap :
      HistoricalLogCore start actions state ->
        HistoricalCandidateQuorumFreshInv start actions state ->
          TemporalLeaderUniquenessInv start actions state ->
            CountedVoteLogHistoryConsistent start actions state ->
              ConfigurationsExactInv state ->
                Enabled state action ->
                  QuorumCandidateFormationOverlap
                    start actions state action) :
    TemporalQuorumCandidateConfigurationOverlapInv
      start
      (actions ++ [action])
      (next state action) := by
  have fresh :=
    historicalElectionCores_imply_HistoricalCandidateQuorumFreshInv
      history votes core.candidateOverlap entryOrigins leaderTerms
  have oldVoteCore : HistoricalVoteCore start actions state :=
    ⟨votes.owner, votes.ownerConsistent, votes.electionVotes⟩
  have leaderUniqueness :=
    historicalElectionCores_imply_TemporalLeaderUniquenessInv
      history
      oldVoteCore
      (protocolHistory_implies_LeaderHistoryConsistent history)
      (quorumCandidateOverlap_implies_ElectionConfigurationsOverlapInv
        core.candidateOverlap)
  have formationOverlap :=
    formationOverlap
      core.logs fresh leaderUniqueness countedVotes
      configurationsExact enabled
  intro firstState secondState firstAt secondAt
    first second firstCandidate firstQuorum
    secondCandidate secondQuorum sameTerm
  rcases
      stateAt_append_singleton_cases history enabled firstAt with
    firstOld | firstFinal
  · rcases
        stateAt_append_singleton_cases history enabled secondAt with
      secondOld | secondFinal
    · exact core.candidateOverlap
        firstState secondState firstOld secondOld
        first second firstCandidate firstQuorum
        secondCandidate secondQuorum sameTerm
    · subst secondState
      rcases
          endpoint_candidate_snapshot_or_formation
            state action second enabled secondCandidate with
        secondSnapshot | secondFormation
      · have oldSecondQuorum :
            allConfigurationsHaveQuorum
                (state.votesGranted second)
                (state.configurations second) =
              true := by
          simpa [secondSnapshot.votes_granted,
            secondSnapshot.configurations] using secondQuorum
        rcases core.candidateOverlap
            firstState state firstOld
            (protocolHistory_final_stateAt history)
            first second firstCandidate firstQuorum
            secondSnapshot.candidate_state oldSecondQuorum
            (by simpa [secondSnapshot.current_term] using sameTerm) with
          ⟨firstConfiguration, secondConfiguration,
            firstMember, secondMember, sameNodes⟩
        exact
          ⟨firstConfiguration, secondConfiguration,
            firstMember,
            by simpa [secondSnapshot.configurations] using secondMember,
            sameNodes⟩
      · rcases formationOverlap
            second secondFormation secondCandidate secondQuorum
            firstState firstAt first firstCandidate firstQuorum
            sameTerm.symm with
          ⟨secondConfiguration, firstConfiguration,
            secondMember, firstMember, sameNodes⟩
        exact
          ⟨firstConfiguration, secondConfiguration,
            firstMember, secondMember, sameNodes.symm⟩
  · subst firstState
    rcases
        endpoint_candidate_snapshot_or_formation
          state action first enabled firstCandidate with
      firstSnapshot | firstFormation
    · rcases
          stateAt_append_singleton_cases history enabled secondAt with
        secondOld | secondFinal
      · have oldFirstQuorum :
            allConfigurationsHaveQuorum
                (state.votesGranted first)
                (state.configurations first) =
              true := by
          simpa [firstSnapshot.votes_granted,
            firstSnapshot.configurations] using firstQuorum
        rcases core.candidateOverlap
            state secondState
            (protocolHistory_final_stateAt history) secondOld
            first second firstSnapshot.candidate_state oldFirstQuorum
            secondCandidate secondQuorum
            (by simpa [firstSnapshot.current_term] using sameTerm) with
          ⟨firstConfiguration, secondConfiguration,
            firstMember, secondMember, sameNodes⟩
        exact
          ⟨firstConfiguration, secondConfiguration,
            by simpa [firstSnapshot.configurations] using firstMember,
            secondMember, sameNodes⟩
      · subst secondState
        rcases
            endpoint_candidate_snapshot_or_formation
              state action second enabled secondCandidate with
          secondSnapshot | secondFormation
        · have oldFirstQuorum :
              allConfigurationsHaveQuorum
                  (state.votesGranted first)
                  (state.configurations first) =
                true := by
            simpa [firstSnapshot.votes_granted,
              firstSnapshot.configurations] using firstQuorum
          have oldSecondQuorum :
              allConfigurationsHaveQuorum
                  (state.votesGranted second)
                  (state.configurations second) =
                true := by
            simpa [secondSnapshot.votes_granted,
              secondSnapshot.configurations] using secondQuorum
          rcases core.candidateOverlap
              state state
              (protocolHistory_final_stateAt history)
              (protocolHistory_final_stateAt history)
              first second
              firstSnapshot.candidate_state oldFirstQuorum
              secondSnapshot.candidate_state oldSecondQuorum
              (by
                simpa [firstSnapshot.current_term,
                  secondSnapshot.current_term] using sameTerm) with
            ⟨firstConfiguration, secondConfiguration,
              firstMember, secondMember, sameNodes⟩
          exact
            ⟨firstConfiguration, secondConfiguration,
              by simpa [firstSnapshot.configurations] using firstMember,
              by simpa [secondSnapshot.configurations] using secondMember,
              sameNodes⟩
        · rcases formationOverlap
              second secondFormation secondCandidate secondQuorum
              (next state action)
              (protocolHistory_final_stateAt
                (replays_append_singleton history enabled))
              first firstCandidate firstQuorum sameTerm.symm with
            ⟨secondConfiguration, firstConfiguration,
              secondMember, firstMember, sameNodes⟩
          exact
            ⟨firstConfiguration, secondConfiguration,
              firstMember, secondMember, sameNodes.symm⟩
    · exact formationOverlap
        first firstFormation firstCandidate firstQuorum
        secondState secondAt second secondCandidate secondQuorum sameTerm

theorem quorumCandidateFormationOverlap_timeout_of_configurationCompleteness
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalElectionLogCore start actions state)
    (votes : HistoricalElectionVoteCore start actions state)
    (countedVotes :
      CountedVoteLogHistoryConsistent start actions state)
    (entryOrigins :
      HistoricalEntryTermLeaderOriginInv start actions state)
    (leaderTerms :
      HistoricalLeaderToCurrentCandidateTermInv
        start actions state)
    (configurationsExact : ConfigurationsExactInv state)
    (candidate : Node)
    (enabled : Enabled state (.timeout candidate))
    (configurationCompleteness :
      HistoricalLogCore start actions state ->
        HistoricalCandidateQuorumFreshInv start actions state ->
          TemporalLeaderUniquenessInv start actions state ->
            CountedVoteLogHistoryConsistent start actions state ->
              ConfigurationsExactInv state ->
                Enabled state (.timeout candidate) ->
                  TimeoutConfigurationCompleteness
                    start actions state candidate) :
    QuorumCandidateFormationOverlap
      start actions state (.timeout candidate) := by
  have fresh :=
    historicalElectionCores_imply_HistoricalCandidateQuorumFreshInv
      history votes core.candidateOverlap entryOrigins leaderTerms
  have oldVoteCore : HistoricalVoteCore start actions state :=
    ⟨votes.owner, votes.ownerConsistent, votes.electionVotes⟩
  have leaderUniqueness :=
    historicalElectionCores_imply_TemporalLeaderUniquenessInv
      history
      oldVoteCore
      (protocolHistory_implies_LeaderHistoryConsistent history)
      (quorumCandidateOverlap_implies_ElectionConfigurationsOverlapInv
        core.candidateOverlap)
  have completeness :=
    configurationCompleteness
      core.logs fresh leaderUniqueness countedVotes
      configurationsExact enabled
  intro formedCandidate formation _formedState formedQuorum
    otherState otherAt otherCandidate otherCandidateState
    otherQuorum sameTerm
  simp [QuorumCandidateFormationAction] at formation
  subst formedCandidate
  have singletonQuorum :
      allConfigurationsHaveQuorum
          {candidate}
          (state.configurations candidate) =
        true := by
    simpa [next, rawNext, nextTimeout, updateNode] using formedQuorum
  cases configurationsEq :
      state.configurations candidate with
  | nil =>
      exact False.elim (completeness.1 configurationsEq)
  | cons candidateConfiguration remainingConfigurations =>
      have candidateConfigurationMember :
          candidateConfiguration ∈ state.configurations candidate := by
        simp [configurationsEq]
      have candidateConfigurationQuorum :
          isQuorum
              ({candidate} ∩ candidateConfiguration.nodes)
              candidateConfiguration.nodes =
            true := by
        have allQuorums := singletonQuorum
        simp [allConfigurationsHaveQuorum] at allQuorums
        exact
          allQuorums
            candidateConfiguration candidateConfigurationMember
      have candidateConfigurationNodes :
          candidateConfiguration.nodes = {candidate} :=
        singleton_votes_quorum_configuration_eq
          candidate candidateConfiguration candidateConfigurationQuorum
      have candidateConfigurationMemberAfter :
          candidateConfiguration ∈
            (next state (.timeout candidate)).configurations candidate := by
        simpa [next, rawNext, nextTimeout] using
          candidateConfigurationMember
      rcases
          stateAt_append_singleton_cases history enabled otherAt with
        otherOld | otherFinal
      · have oldSameTerm :
            state.currentTerm candidate + 1 =
              otherState.currentTerm otherCandidate := by
          simpa [next, rawNext, nextTimeout, updateNode] using sameTerm
        rcases completeness.2
            otherState otherOld otherCandidate
            otherCandidateState otherQuorum oldSameTerm with
          ⟨otherConfiguration, otherConfigurationMember,
            otherConfigurationNodes⟩
        exact
          ⟨candidateConfiguration, otherConfiguration,
            candidateConfigurationMemberAfter,
            otherConfigurationMember,
            candidateConfigurationNodes.trans
              otherConfigurationNodes.symm⟩
      · subst otherState
        by_cases otherIsCandidate : otherCandidate = candidate
        · subst otherCandidate
          exact
            ⟨candidateConfiguration, candidateConfiguration,
              candidateConfigurationMemberAfter,
              candidateConfigurationMemberAfter, rfl⟩
        · have oldOtherCandidate :
              state.leadershipState otherCandidate = .candidate := by
            simpa [next, rawNext, nextTimeout, updateNode,
              otherIsCandidate] using otherCandidateState
          have oldOtherQuorum :
              allConfigurationsHaveQuorum
                  (state.votesGranted otherCandidate)
                  (state.configurations otherCandidate) =
                true := by
            simpa [next, rawNext, nextTimeout, updateNode,
              otherIsCandidate] using otherQuorum
          have oldSameTerm :
              state.currentTerm candidate + 1 =
                state.currentTerm otherCandidate := by
            simpa [next, rawNext, nextTimeout, updateNode,
              otherIsCandidate] using sameTerm
          rcases completeness.2
              state
              (protocolHistory_final_stateAt history)
              otherCandidate oldOtherCandidate oldOtherQuorum
              oldSameTerm with
            ⟨otherConfiguration, otherConfigurationMember,
              otherConfigurationNodes⟩
          have otherConfigurationMemberAfter :
              otherConfiguration ∈
                (next state (.timeout candidate)).configurations
                  otherCandidate := by
            simpa [next, rawNext, nextTimeout] using
              otherConfigurationMember
          exact
            ⟨candidateConfiguration, otherConfiguration,
              candidateConfigurationMemberAfter,
              otherConfigurationMemberAfter,
              candidateConfigurationNodes.trans
                otherConfigurationNodes.symm⟩

theorem reachable_currentTerm_lowerBound
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    forall node,
      (initialState start).currentTerm node <= state.currentTerm node := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := fun current =>
        forall node,
          (initialState start).currentTerm node <=
            current.currentTerm node)
  · intro node
    exact Nat.le_refl _
  · intro current action inductionHypothesis enabled node
    exact
      Nat.le_trans
        (inductionHypothesis node)
        (monotonicTerm_step current action enabled node)
  · exact reachable

/--
Kernel-checked reachable-step theorem for `MonotonicTermProp` over every
enabled selected action.
-/
theorem reachable_MonotonicTermProp
    (start : InitialConfiguration)
    {state : State}
    (_reachable : Reachable start state)
    {action : Action}
    (enabled : Enabled state action) :
    MonotonicTermProp state (next state action) :=
  monotonicTerm_step state action enabled

theorem commitIndexDelta
    (state : State)
    (action : Action)
    (_enabled : Enabled state action) :
    CommitIndexDelta state (next state action) := by
  constructor
  intro node
  cases action with
  | timeout candidate =>
      simp [next, rawNext, nextTimeout]
  | requestVote source dest =>
      simp [next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      simp [next, rawNext, nextAppendEntries]
  | becomeLeader leader =>
      simp [next, rawNext, nextBecomeLeader]
  | clientRequest leader =>
      simp [next, rawNext, nextClientRequest]
  | signCommittableMessages leader =>
      simp [next, rawNext, nextSignCommittableMessages]
  | changeConfiguration leader configuration =>
      simp [next, rawNext, nextChangeConfiguration]
  | advanceCommitIndex leader =>
      simp [Enabled, actionEnabled] at _enabled
      by_cases h : node = leader
      · subst node
        simp [next, rawNext, nextAdvanceCommitIndex]
        exact Nat.le_of_lt _enabled.2
      · simp [next, rawNext, nextAdvanceCommitIndex, h]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [next, rawNext, nextReceive, hmessage]
      | some message =>
          cases kind <;>
            cases hbody : message.body <;>
              simp_all [next, rawNext, nextReceive,
                nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
                conflictRollback]
          all_goals
            split <;> simp_all

theorem monotonicCommitIndex_step
    (state : State)
    (action : Action)
    (enabled : Enabled state action) :
    MonotonicCommitIndexProp state (next state action) :=
  (commitIndexDelta state action enabled).monotonic

theorem nextRetirementCompleted_new_member_commit_positive
    (current : Configuration)
    (configurations : List ConfigurationAt)
    (nextCommitIndex : Nat)
    (member : Node)
    (newMember :
      member ∈
        nextRetirementCompleted
          current configurations nextCommitIndex)
    (notCurrent : member ∉ current) :
    0 < nextCommitIndex := by
  let currentIndex :=
    lastConfigurationToIndex configurations nextCommitIndex
  by_cases currentIndexZero : currentIndex = 0
  · have retained : nextRetirementCompleted
        current configurations nextCommitIndex = current := by
      simp [nextRetirementCompleted, currentIndex, currentIndexZero]
    rw [retained] at newMember
    exact False.elim (notCurrent newMember)
  · have currentIndexLe :
        currentIndex <= nextCommitIndex := by
      exact lastConfigurationToIndex_le _ _
    omega

theorem initial_RetirementCompletedCommitPositiveInv
    (start : InitialConfiguration) :
    RetirementCompletedCommitPositiveInv (initialState start) := by
  intro owner member memberRetired
  simp [initialState] at memberRetired

private theorem retirementCompletedCommitPositive_update
    (before after : State)
    (updated : Node)
    (configurations : List ConfigurationAt)
    (nextCommitIndex : Nat)
    (invariant : RetirementCompletedCommitPositiveInv before)
    (commitMonotonic :
      MonotonicCommitIndexProp before after)
    (retirementAfter :
      after.retirementCompleted =
        updateNode before.retirementCompleted updated
          (nextRetirementCompleted
            (before.retirementCompleted updated)
            configurations
            nextCommitIndex))
    (updatedCommit :
      after.commitIndex updated = nextCommitIndex) :
    RetirementCompletedCommitPositiveInv after := by
  intro owner member memberRetired
  by_cases ownerIsUpdated : owner = updated
  · subst owner
    have memberAfter :
        member ∈
          nextRetirementCompleted
            (before.retirementCompleted updated)
            configurations
            nextCommitIndex := by
      simpa [retirementAfter] using memberRetired
    by_cases memberWasRetired :
        member ∈ before.retirementCompleted updated
    · exact Nat.lt_of_lt_of_le
        (invariant updated member memberWasRetired)
        (commitMonotonic updated)
    · rw [updatedCommit]
      exact
        nextRetirementCompleted_new_member_commit_positive
          (before.retirementCompleted updated)
          configurations
          nextCommitIndex
          member
          memberAfter
          memberWasRetired
  · have memberBefore :
        member ∈ before.retirementCompleted owner := by
      simpa [retirementAfter, ownerIsUpdated] using memberRetired
    exact Nat.lt_of_lt_of_le
      (invariant owner member memberBefore)
      (commitMonotonic owner)

private theorem retirementCompletedCommitPositive_nextAlreadyDone
    (state : State)
    (message : Message)
    (previousIndex : Nat)
    (entries : List Entry)
    (leaderCommitIndex : Nat)
    (invariant : RetirementCompletedCommitPositiveInv state) :
    RetirementCompletedCommitPositiveInv
      (nextAppendEntriesAlreadyDone
        state message previousIndex entries leaderCommitIndex) := by
  let requestEndIndex := previousIndex + entries.length
  let nextCommitIndex :=
    max
      (maxCommittableIndexAt
        (state.log message.dest)
        (min leaderCommitIndex requestEndIndex))
      (state.commitIndex message.dest)
  apply retirementCompletedCommitPositive_update
    state
    (nextAppendEntriesAlreadyDone
      state message previousIndex entries leaderCommitIndex)
    message.dest
    (state.configurations message.dest)
    nextCommitIndex
    invariant
  · intro node
    by_cases nodeIsDest : node = message.dest
    · subst node
      simp [nextAppendEntriesAlreadyDone]
    · simp [nextAppendEntriesAlreadyDone, nodeIsDest]
  · rfl
  · simp [nextAppendEntriesAlreadyDone, nextCommitIndex,
      requestEndIndex]

private theorem retirementCompletedCommitPositive_nextNoConflict
    (state : State)
    (message : Message)
    (previousIndex : Nat)
    (entries : List Entry)
    (leaderCommitIndex : Nat)
    (invariant : RetirementCompletedCommitPositiveInv state) :
    RetirementCompletedCommitPositiveInv
      (nextAppendEntriesNoConflict
        state message previousIndex entries leaderCommitIndex) := by
  let nextLog := (state.log message.dest).take previousIndex ++ entries
  let requestEndIndex := previousIndex + entries.length
  let nextCommitIndex :=
    max
      (maxCommittableIndexAt
        nextLog
        (min leaderCommitIndex requestEndIndex))
      (state.commitIndex message.dest)
  apply retirementCompletedCommitPositive_update
    state
    (nextAppendEntriesNoConflict
      state message previousIndex entries leaderCommitIndex)
    message.dest
    (state.configurations message.dest)
    nextCommitIndex
    invariant
  · intro node
    by_cases nodeIsDest : node = message.dest
    · subst node
      simp [nextAppendEntriesNoConflict]
    · simp [nextAppendEntriesNoConflict, nodeIsDest]
  · rfl
  · simp [nextAppendEntriesNoConflict, nextCommitIndex,
      requestEndIndex, nextLog]

theorem retirementCompletedCommitPositive_step
    (state : State)
    (action : Action)
    (invariant : RetirementCompletedCommitPositiveInv state)
    (enabled : Enabled state action) :
    RetirementCompletedCommitPositiveInv (next state action) := by
  cases action with
  | timeout candidate =>
      simpa [RetirementCompletedCommitPositiveInv, next, rawNext,
        nextTimeout] using invariant
  | requestVote source dest =>
      simpa [RetirementCompletedCommitPositiveInv, next, rawNext,
        nextRequestVote] using invariant
  | appendEntries source dest =>
      simpa [RetirementCompletedCommitPositiveInv, next, rawNext,
        nextAppendEntries] using invariant
  | becomeLeader leader =>
      simpa [RetirementCompletedCommitPositiveInv, next, rawNext,
        nextBecomeLeader] using invariant
  | clientRequest leader =>
      simpa [RetirementCompletedCommitPositiveInv, next, rawNext,
        nextClientRequest] using invariant
  | signCommittableMessages leader =>
      simpa [RetirementCompletedCommitPositiveInv, next, rawNext,
        nextSignCommittableMessages] using invariant
  | changeConfiguration leader configuration =>
      simpa [RetirementCompletedCommitPositiveInv, next, rawNext,
        nextChangeConfiguration] using invariant
  | advanceCommitIndex leader =>
      have enabledFacts := enabled
      simp [Enabled, actionEnabled] at enabledFacts
      let nextCommitIndex := highestCommittableIndex state leader
      apply retirementCompletedCommitPositive_update
        state
        (next state (.advanceCommitIndex leader))
        leader
        (state.configurations leader)
        nextCommitIndex
        invariant
      · exact monotonicCommitIndex_step
          state (.advanceCommitIndex leader) enabled
      · simp [next, rawNext, nextAdvanceCommitIndex, nextCommitIndex]
      · simp [next, rawNext, nextAdvanceCommitIndex, nextCommitIndex]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [next, rawNext, nextReceive, hmessage] using invariant
      | some message =>
          cases kind with
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    retirementCompletedCommitPositive_nextAlreadyDone
                      state message previousIndex entries leaderCommitIndex
                      invariant
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    invariant
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    retirementCompletedCommitPositive_nextNoConflict
                      state message previousIndex entries leaderCommitIndex
                      invariant
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    invariant
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have rollbackInvariant :
                      RetirementCompletedCommitPositiveInv
                        (conflictRollback state dest previousIndex) := by
                    simpa [RetirementCompletedCommitPositiveInv,
                      conflictRollback] using invariant
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    retirementCompletedCommitPositive_nextAlreadyDone
                      (conflictRollback state dest previousIndex)
                      message previousIndex entries leaderCommitIndex
                      rollbackInvariant
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    invariant
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have rollbackInvariant :
                      RetirementCompletedCommitPositiveInv
                        (conflictRollback state dest previousIndex) := by
                    simpa [RetirementCompletedCommitPositiveInv,
                      conflictRollback] using invariant
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    retirementCompletedCommitPositive_nextNoConflict
                      (conflictRollback state dest previousIndex)
                      message previousIndex entries leaderCommitIndex
                      rollbackInvariant
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    invariant
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  cases response :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm <;>
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      response] using invariant
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    invariant
          | _ =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  invariant

theorem protocolHistory_implies_RetirementCompletedCommitPositiveInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    RetirementCompletedCommitPositiveInv state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun _ current =>
        RetirementCompletedCommitPositiveInv current)
      (initial_RetirementCompletedCommitPositiveInv start)
      (by
        intro _ current _ currentInvariant action enabled
        exact retirementCompletedCommitPositive_step
          current action currentInvariant enabled)
      history

theorem reachable_RetirementCompletedCommitPositiveInv
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    RetirementCompletedCommitPositiveInv state := by
  rcases reachable_hasCausalHistory reachable with
    ⟨actions, history, _queues⟩
  exact
    protocolHistory_implies_RetirementCompletedCommitPositiveInv history

theorem initial_CandidateElectionBasis
    (start : InitialConfiguration) :
    forall candidate : Node,
      (initialState start).leadershipState candidate = .candidate ->
        CandidateElectionBasis (initialState start) candidate := by
  intro candidate candidateState
  by_cases member : candidate ∈ start.nodes
  · by_cases same : candidate = start.leader <;>
      simp [initialState, member, same, start.leader_mem] at candidateState
  · simp [initialState, member] at candidateState

private theorem candidateElectionBasis_of_unchanged
    (before after : State)
    (candidate : Node)
    (basis : CandidateElectionBasis before candidate)
    (commitMonotonic :
      before.commitIndex candidate <= after.commitIndex candidate)
    (configurationsUnchanged :
      after.configurations candidate =
        before.configurations candidate)
    (logUnchanged :
      after.log candidate = before.log candidate) :
    CandidateElectionBasis after candidate := by
  rcases basis with commitPositive | ⟨configuration, member, owner, bound⟩
  · left
    exact Nat.lt_of_lt_of_le commitPositive commitMonotonic
  · right
    exact
      ⟨configuration,
        by simpa [configurationsUnchanged] using member,
        owner,
        by simpa [logUnchanged] using bound⟩

theorem candidateElectionBasis_step
    (state : State)
    (action : Action)
    (retirementPositive :
      RetirementCompletedCommitPositiveInv state)
    (oldBasis :
      forall candidate : Node,
        state.leadershipState candidate = .candidate ->
          CandidateElectionBasis state candidate)
    (enabled : Enabled state action) :
    forall candidate : Node,
      (next state action).leadershipState candidate = .candidate ->
        CandidateElectionBasis (next state action) candidate := by
  intro candidate afterCandidate
  have commitMonotonic :=
    monotonicCommitIndex_step state action enabled candidate
  cases action with
  | timeout timedOut =>
      by_cases candidateIsTimedOut : candidate = timedOut
      · subst candidate
        have enabledFacts := enabled
        simp [Enabled, actionEnabled, candidateEligible] at enabledFacts
        rcases enabledFacts.1.2.2 with
          normalConfiguration | retirementCompleted
        · right
          rcases normalConfiguration with
            ⟨configuration, configurationMember,
              candidateMember, configurationBound⟩
          exact
            ⟨configuration,
              by
                simpa [next, rawNext, nextTimeout] using
                  configurationMember,
              candidateMember,
              by
                simpa [next, rawNext, nextTimeout] using
                  configurationBound⟩
        · left
          simpa [next, rawNext, nextTimeout] using
            retirementPositive
              timedOut timedOut retirementCompleted
      · have oldCandidate :
            state.leadershipState candidate = .candidate := by
          simpa [next, rawNext, nextTimeout, candidateIsTimedOut] using
            afterCandidate
        exact candidateElectionBasis_of_unchanged
          state (next state (.timeout timedOut)) candidate
          (oldBasis candidate oldCandidate) commitMonotonic
          (by
            simp [next, rawNext, nextTimeout])
          (by
            simp [next, rawNext, nextTimeout])
  | requestVote source dest =>
      have oldCandidate :=
        candidate_before_of_candidate_after
          state (.requestVote source dest) candidate afterCandidate
          (by simp)
      exact candidateElectionBasis_of_unchanged
        state (next state (.requestVote source dest)) candidate
        (oldBasis candidate oldCandidate) commitMonotonic
        (by simp [next, rawNext, nextRequestVote])
        (by simp [next, rawNext, nextRequestVote])
  | appendEntries source dest =>
      have oldCandidate :=
        candidate_before_of_candidate_after
          state (.appendEntries source dest) candidate afterCandidate
          (by simp)
      exact candidateElectionBasis_of_unchanged
        state (next state (.appendEntries source dest)) candidate
        (oldBasis candidate oldCandidate) commitMonotonic
        (by simp [next, rawNext, nextAppendEntries])
        (by simp [next, rawNext, nextAppendEntries])
  | becomeLeader leader =>
      have oldCandidate :=
        candidate_before_of_candidate_after
          state (.becomeLeader leader) candidate afterCandidate
          (by simp)
      have candidateIsNotLeader : candidate ≠ leader := by
        intro candidateIsLeader
        subst candidate
        simp [next, rawNext, nextBecomeLeader, updateNode] at afterCandidate
      exact candidateElectionBasis_of_unchanged
        state (next state (.becomeLeader leader)) candidate
        (oldBasis candidate oldCandidate) commitMonotonic
        (by
          simp [next, rawNext, nextBecomeLeader, updateNode,
            candidateIsNotLeader])
        (by
          simp [next, rawNext, nextBecomeLeader, updateNode,
            candidateIsNotLeader])
  | clientRequest leader =>
      have oldCandidate :=
        candidate_before_of_candidate_after
          state (.clientRequest leader) candidate afterCandidate
          (by simp)
      have leaderState :
          state.leadershipState leader = .leader := by
        have enabledFacts := enabled
        simp [Enabled, actionEnabled] at enabledFacts
        exact enabledFacts.1.2
      have candidateIsNotLeader : candidate ≠ leader := by
        intro candidateIsLeader
        subst candidate
        rw [leaderState] at oldCandidate
        contradiction
      exact candidateElectionBasis_of_unchanged
        state (next state (.clientRequest leader)) candidate
        (oldBasis candidate oldCandidate) commitMonotonic
        (by simp [next, rawNext, nextClientRequest])
        (by
          simp [next, rawNext, nextClientRequest, candidateIsNotLeader])
  | signCommittableMessages leader =>
      have oldCandidate :=
        candidate_before_of_candidate_after
          state (.signCommittableMessages leader) candidate afterCandidate
          (by simp)
      have leaderState :
          state.leadershipState leader = .leader := by
        have enabledFacts := enabled
        simp [Enabled, actionEnabled] at enabledFacts
        exact enabledFacts.1.1.2
      have candidateIsNotLeader : candidate ≠ leader := by
        intro candidateIsLeader
        subst candidate
        rw [leaderState] at oldCandidate
        contradiction
      exact candidateElectionBasis_of_unchanged
        state (next state (.signCommittableMessages leader)) candidate
        (oldBasis candidate oldCandidate) commitMonotonic
        (by simp [next, rawNext, nextSignCommittableMessages])
        (by
          simp [next, rawNext, nextSignCommittableMessages,
            candidateIsNotLeader])
  | changeConfiguration leader configuration =>
      have oldCandidate :=
        candidate_before_of_candidate_after
          state (.changeConfiguration leader configuration)
          candidate afterCandidate (by simp)
      have leaderState :
          state.leadershipState leader = .leader := by
        have enabledFacts := enabled
        simp [Enabled, actionEnabled] at enabledFacts
        exact enabledFacts.1.1.1.2
      have candidateIsNotLeader : candidate ≠ leader := by
        intro candidateIsLeader
        subst candidate
        rw [leaderState] at oldCandidate
        contradiction
      exact candidateElectionBasis_of_unchanged
        state
        (next state (.changeConfiguration leader configuration))
        candidate
        (oldBasis candidate oldCandidate)
        commitMonotonic
        (by
          simp [next, rawNext, nextChangeConfiguration,
            candidateIsNotLeader])
        (by
          simp [next, rawNext, nextChangeConfiguration,
            candidateIsNotLeader])
  | advanceCommitIndex leader =>
      have oldCandidate :=
        candidate_before_of_candidate_after
          state (.advanceCommitIndex leader) candidate afterCandidate
          (by simp)
      have leaderState :
          state.leadershipState leader = .leader := by
        have enabledFacts := enabled
        simp [Enabled, actionEnabled] at enabledFacts
        exact enabledFacts.1.2
      have candidateIsNotLeader : candidate ≠ leader := by
        intro candidateIsLeader
        subst candidate
        rw [leaderState] at oldCandidate
        contradiction
      exact candidateElectionBasis_of_unchanged
        state (next state (.advanceCommitIndex leader)) candidate
        (oldBasis candidate oldCandidate) commitMonotonic
        (by
          simp [next, rawNext, nextAdvanceCommitIndex,
            candidateIsNotLeader])
        (by
          simp [next, rawNext, nextAdvanceCommitIndex])
  | receive dest source kind =>
      have oldCandidate :=
        candidate_before_of_candidate_after
          state (.receive dest source kind) candidate afterCandidate
          (by simp)
      cases hmessage : headMessage? state dest source with
      | none =>
          exact False.elim (by
            have enabledFacts := enabled
            simp [Enabled, actionEnabled, hmessage] at enabledFacts)
      | some message =>
          have messageDest : message.dest = dest := by
            have enabledFacts := enabled
            simp [Enabled, actionEnabled, hmessage] at enabledFacts
            exact enabledFacts.2.1.1
          cases kind with
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have candidateIsNotDest : candidate ≠ dest := by
                    intro candidateIsDest
                    subst candidate
                    have enabledFacts := enabled
                    simp [Enabled, actionEnabled, hmessage, hbody,
                      receiveBranchEnabled,
                      appendEntriesAcceptBase, messageDest] at enabledFacts
                    simp_all
                  exact candidateElectionBasis_of_unchanged
                    state
                    (next state
                      (.receive dest source
                        .appendEntriesAlreadyDone))
                    candidate
                    (oldBasis candidate oldCandidate)
                    commitMonotonic
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone, messageDest,
                        candidateIsNotDest])
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone])
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    oldBasis candidate oldCandidate
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have candidateIsNotDest : candidate ≠ dest := by
                    intro candidateIsDest
                    subst candidate
                    have enabledFacts := enabled
                    simp [Enabled, actionEnabled, hmessage, hbody,
                      receiveBranchEnabled,
                      appendEntriesAcceptBase, messageDest] at enabledFacts
                    simp_all
                  exact candidateElectionBasis_of_unchanged
                    state
                    (next state
                      (.receive dest source
                        .appendEntriesNoConflict))
                    candidate
                    (oldBasis candidate oldCandidate)
                    commitMonotonic
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, messageDest,
                        candidateIsNotDest])
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, messageDest,
                        candidateIsNotDest])
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    oldBasis candidate oldCandidate
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have candidateIsNotDest : candidate ≠ dest := by
                    intro candidateIsDest
                    subst candidate
                    have enabledFacts := enabled
                    simp [Enabled, actionEnabled, hmessage, hbody,
                      receiveBranchEnabled,
                      appendEntriesAcceptBase, messageDest] at enabledFacts
                    simp_all
                  exact candidateElectionBasis_of_unchanged
                    state
                    (next state
                      (.receive dest source
                        .appendEntriesConflictThenAlreadyDone))
                    candidate
                    (oldBasis candidate oldCandidate)
                    commitMonotonic
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone, conflictRollback,
                        messageDest, candidateIsNotDest])
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone, conflictRollback,
                        messageDest, candidateIsNotDest])
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    oldBasis candidate oldCandidate
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have candidateIsNotDest : candidate ≠ dest := by
                    intro candidateIsDest
                    subst candidate
                    have enabledFacts := enabled
                    simp [Enabled, actionEnabled, hmessage, hbody,
                      receiveBranchEnabled,
                      appendEntriesAcceptBase, messageDest] at enabledFacts
                    simp_all
                  exact candidateElectionBasis_of_unchanged
                    state
                    (next state
                      (.receive dest source
                        .appendEntriesConflictThenNoConflict))
                    candidate
                    (oldBasis candidate oldCandidate)
                    commitMonotonic
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        messageDest, candidateIsNotDest])
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        messageDest, candidateIsNotDest])
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    oldBasis candidate oldCandidate
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  cases response :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm <;>
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      response] using oldBasis candidate oldCandidate
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    oldBasis candidate oldCandidate
          | _ =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  oldBasis candidate oldCandidate

theorem protocolHistory_implies_current_CandidateElectionBasis
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    forall candidate : Node,
      state.leadershipState candidate = .candidate ->
        CandidateElectionBasis state candidate := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun _ current =>
        forall candidate : Node,
          current.leadershipState candidate = .candidate ->
            CandidateElectionBasis current candidate)
      (initial_CandidateElectionBasis start)
      (by
        intro pastActions current pastHistory currentBasis action enabled
        exact
          candidateElectionBasis_step
            current
            action
            (protocolHistory_implies_RetirementCompletedCommitPositiveInv
              pastHistory)
            currentBasis
            enabled)
      history

theorem protocolHistory_implies_CandidateElectionBasis
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    forall current : State,
      StateAt start actions state current ->
        forall candidate : Node,
          current.leadershipState candidate = .candidate ->
            CandidateElectionBasis current candidate := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun pastActions endState =>
        forall current : State,
          StateAt start pastActions endState current ->
            forall candidate : Node,
              current.leadershipState candidate = .candidate ->
                CandidateElectionBasis current candidate)
      (by
        intro current currentAt candidate candidateState
        rcases currentAt with ⟨witness⟩
        exact
          protocolHistory_implies_current_CandidateElectionBasis
            witness.stateHistory candidate candidateState)
      (by
        intro pastActions endState pastHistory historicalBasis
          action enabled current currentAt candidate candidateState
        rcases
            stateAt_append_singleton_cases
              pastHistory enabled currentAt with
          oldState | finalState
        · exact historicalBasis
            current oldState candidate candidateState
        · subst current
          exact
            protocolHistory_implies_current_CandidateElectionBasis
              (replays_append_singleton pastHistory enabled)
              candidate
              candidateState)
      history

theorem committedLogAppendOnly_step
