        certificate.choiceTerm :=
    {
      support with
      matchWitness := strongMatch
    }
  have precedes :=
    choice_ack_precedes_higher_term_counted_vote
      history strongSupport vote higherTerm
  exact
    ⟨next
        strongAck.ack.origin.responseState
        (.receive
          member
          certificate.choiceLeader
          strongAck.ack.origin.kind.receiveKind),
      certificate.boundary_prefix_le_choice_prefix.trans acknowledged,
