    (termsAfter : after.currentTerm = before.currentTerm) :
    MonoTermInv after := by
  intro dest source queued queuedMem
  rw [messagesAfter] at queuedMem
  rw [termsAfter]
  exact
    reply_preserves_MonoTermInv
      before response request monoTerm responseBound
      dest source queued queuedMem

theorem entryAt?_mem
    (entries : List Entry)
    (index : Nat)
    (entry : Entry)
    (atIndex : entryAt? entries index = some entry) :
    entry ∈ entries := by
  unfold entryAt? at atIndex
  split at atIndex
  · contradiction
  · exact List.mem_of_getElem? atIndex

theorem monoLogEntries_member_le_lastTerm
    (entries : List Entry)
    (entry : Entry)
    (mono : monoLogEntries entries)
    (member : entry ∈ entries) :
    entry.term <=
      (entries.getLast?.map fun current => current.term).getD 0 := by
  induction entries generalizing entry with
  | nil =>
      simp at member
  | cons first rest inductionHypothesis =>
      cases rest with
      | nil =>
          simp at member
          subst entry
          simp
      | cons second tail =>
          simp [monoLogEntries] at mono
          simp at member
          rcases member with isFirst | inTail
          · subst entry
            have firstLeSecond : first.term <= second.term := by
              rcases mono.1 with sameTerm | laterTerm
              · exact Nat.le_of_eq sameTerm
              · exact Nat.le_of_lt laterTerm.1
            have secondLeLast :=
              inductionHypothesis
                second
                mono.2
                (by simp)
            exact Nat.le_trans firstLeSecond (by simpa using secondLeLast)
          · exact inductionHypothesis entry mono.2 (by simpa using inTail)

theorem monoLogEntries_entryAt_term_le
    (entries : List Entry)
    (firstIndex secondIndex : Nat)
    (first second : Entry)
    (mono : monoLogEntries entries)
    (firstAt : entryAt? entries firstIndex = some first)
    (secondAt : entryAt? entries secondIndex = some second)
    (indexLe : firstIndex <= secondIndex) :
    first.term <= second.term := by
  have firstPositive : 1 <= firstIndex := by
    by_contra notPositive
    have firstZero : firstIndex = 0 := by omega
    subst firstIndex
    simp [entryAt?] at firstAt
  have secondPositive : 1 <= secondIndex := by
    by_contra notPositive
    have secondZero : secondIndex = 0 := by omega
    subst secondIndex
    simp [entryAt?] at secondAt
  have firstAtTake :
      entryAt? (entries.take secondIndex) firstIndex =
        some first := by
    have firstNonzero : firstIndex ≠ 0 := by omega
    unfold entryAt? at firstAt ⊢
    simp only [firstNonzero, ↓reduceIte] at firstAt ⊢
    rw [List.getElem?_take]
    simp [show firstIndex - 1 < secondIndex by omega, firstAt]
  have firstMember :=
    entryAt?_mem
      (entries.take secondIndex)
      firstIndex
      first
      firstAtTake
  have takeMono :
      forall xs count,
        monoLogEntries xs ->
          monoLogEntries (xs.take count) := by
    intro xs count monoXs
    induction xs generalizing count with
    | nil =>
        simp [monoLogEntries]
    | cons head rest inductionHypothesis =>
        cases rest with
        | nil =>
            cases count <;> simp [monoLogEntries]
        | cons second tail =>
            cases count with
            | zero =>
                simp [monoLogEntries]
            | succ count =>
                cases count with
                | zero =>
                    simp [monoLogEntries]
                | succ count =>
                    simp [monoLogEntries] at monoXs ⊢
                    exact
                      ⟨monoXs.1,
                        inductionHypothesis (count + 1) monoXs.2⟩
  have prefixMono :=
    takeMono entries secondIndex mono
  have bound :=
    monoLogEntries_member_le_lastTerm
      (entries.take secondIndex)
      first
      prefixMono
      firstMember
  have secondNonzero : secondIndex ≠ 0 := by
    omega
  have getElemAt :
      entries[secondIndex - 1]? = some second := by
    simpa [entryAt?, secondNonzero] using secondAt
  have lastAt :
      (entries.take secondIndex).getLast? = some second := by
    simp [List.getLast?_take, secondNonzero, getElemAt]
  simpa [lastAt] using bound

theorem appendEntriesMessage_entries_at_most_message_term
    (state : State)
    (source dest : Node)
    (monoLog : MonoLogInv state) :
    MessageEntriesAtMostMessageTerm
      (appendEntriesMessage state source dest) := by
  simp [MessageEntriesAtMostMessageTerm, appendEntriesMessage]
  intro entry member
  have inLog :=
    subsequence_mem
      (state.log source)
      (state.sentIndex source dest + 1)
      (min (state.log source).length (state.sentIndex source dest + 1))
      entry
      member
  have logNonempty : state.log source != [] := by
    cases logCase : state.log source with
    | nil =>
        simp [logCase] at inLog
    | cons head tail =>
        rfl
  exact Nat.le_trans
    (monoLogEntries_member_le_lastTerm
      (state.log source)
      entry
      (monoLog source logNonempty).2
      inLog)
    (monoLog source logNonempty).1

theorem monoLogEntries_take
    (entries : List Entry)
    (count : Nat)
    (mono : monoLogEntries entries) :
    monoLogEntries (entries.take count) := by
  induction entries generalizing count with
  | nil =>
      simp [monoLogEntries]
  | cons first rest inductionHypothesis =>
      cases rest with
      | nil =>
          cases count <;> simp [monoLogEntries]
      | cons second tail =>
          cases count with
          | zero =>
              simp [monoLogEntries]
          | succ count =>
              cases count with
              | zero =>
                  simp [monoLogEntries]
              | succ count =>
                  simp [monoLogEntries] at mono ⊢
                  exact
                    ⟨mono.1,
                      inductionHypothesis (count + 1) mono.2⟩

theorem monoLogEntries_append_currentTerm
    (entries : List Entry)
    (currentTerm : Nat)
    (newContent : EntryContent)
    (mono : monoLogEntries entries)
    (lastBoundary :
      forall lastEntry,
        entries.getLast? = some lastEntry ->
          Or
            (lastEntry.term = currentTerm)
            (lastEntry.content = .signature))
    (lastTermBound :
      (entries.getLast?.map (·.term)).getD 0 <= currentTerm) :
    monoLogEntries
      (entries ++ [{ term := currentTerm, content := newContent }]) := by
  induction entries with
  | nil =>
      simp [monoLogEntries]
  | cons first rest inductionHypothesis =>
      cases rest with
      | nil =>
          simp [monoLogEntries]
          by_cases sameTerm : first.term = currentTerm
          · exact Or.inl sameTerm
          · right
            constructor
            · have firstLe : first.term <= currentTerm := by
                simpa using lastTermBound
              omega
            · exact (lastBoundary first (by simp)).resolve_left sameTerm
      | cons second tail =>
          simp [monoLogEntries] at mono ⊢
          constructor
          · exact mono.1
          · apply inductionHypothesis
            · exact mono.2
            · intro lastEntry lastAt
              exact lastBoundary lastEntry (by simpa using lastAt)
            · simpa using lastTermBound

theorem monoLog_take_list
    (entries : List Entry)
    (currentTerm bound : Nat)
    (lastTermBound :
      (entries.getLast?.map (·.term)).getD 0 <= currentTerm)
    (mono : monoLogEntries entries) :
    (entries.take bound != []) ->
      And
        (((entries.take bound).getLast?.map (·.term)).getD 0 <=
          currentTerm)
        (monoLogEntries (entries.take bound)) := by
  intro nonempty
  constructor
  · cases lastAt : (entries.take bound).getLast? with
    | none =>
        simp
    | some lastEntry =>
        have decomposition :=
          List.getLast?_eq_some_iff.mp lastAt
        rcases decomposition with ⟨prefixEntries, takeShape⟩
        have memberTake :
            lastEntry ∈ entries.take bound := by
          rw [takeShape]
          simp
        have memberEntries := List.mem_of_mem_take memberTake
        have entryBound :=
          monoLogEntries_member_le_lastTerm
            entries lastEntry mono memberEntries
        simpa [lastAt] using Nat.le_trans entryBound lastTermBound
  · exact monoLogEntries_take entries bound mono

theorem monoLog_append_currentTerm_list
    (entries : List Entry)
    (currentTerm : Nat)
    (content : EntryContent)
    (nodeMono :
      entries != [] ->
        And
          ((entries.getLast?.map (·.term)).getD 0 <= currentTerm)
          (monoLogEntries entries))
    (lastBoundary :
      forall lastEntry,
        entries.getLast? = some lastEntry ->
          Or
            (lastEntry.term = currentTerm)
            (lastEntry.content = .signature)) :
    And
      ((((entries ++
        [({ term := currentTerm, content := content } : Entry)]).getLast?).map
        (·.term)).getD 0 <= currentTerm)
      (monoLogEntries
        (entries ++
          [({ term := currentTerm, content := content } : Entry)])) := by
  constructor
  · simp
  · by_cases empty : entries = []
    · subst entries
      simp [monoLogEntries]
    · have oldNonempty : (entries != []) = true := by
        cases entries with
        | nil => contradiction
        | cons first rest => rfl
      have oldMono := nodeMono oldNonempty
      exact monoLogEntries_append_currentTerm
        entries currentTerm content oldMono.2 lastBoundary oldMono.1

theorem monoLog_of_unchanged_logs
    (before after : State)
    (monoLog : MonoLogInv before)
    (logsUnchanged :
      forall node,
        after.log node = before.log node)
    (termsMonotonic :
      forall node,
        before.currentTerm node <= after.currentTerm node) :
    MonoLogInv after := by
  intro node nonempty
  have oldNonempty : before.log node != [] := by
    simpa [logsUnchanged node] using nonempty
  have oldMono := monoLog node oldNonempty
  constructor
  · rw [logsUnchanged node]
    exact Nat.le_trans oldMono.1 (termsMonotonic node)
  · rw [logsUnchanged node]
    exact oldMono.2

theorem logEntryTerm_le_currentTerm
    (state : State)
    (monoLog : MonoLogInv state)
    (node : Node)
    (index : Nat)
    (entry : Entry)
    (atIndex : entryAt? (state.log node) index = some entry) :
    entry.term <= state.currentTerm node := by
  have member := entryAt?_mem (state.log node) index entry atIndex
  cases logShape : state.log node with
  | nil =>
      rw [logShape] at member
      simp at member
  | cons first rest =>
      have nodeMono := monoLog node (by
        rw [logShape]
        rfl)
      exact Nat.le_trans
        (monoLogEntries_member_le_lastTerm
          (state.log node)
          entry
          nodeMono.2
          member)
        nodeMono.1

theorem historicalChosenCommitCore_implies_LeaderCompletenessInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (chosen : HistoricalChosenCommitCore start actions state)
    (signatures : SignatureInv state) :
    LeaderCompletenessInv state := by
  intro leader leaderState node _different lowerTerm
  by_cases commitZero : state.commitIndex node = 0
  · simp [committed, commitZero, logPrefix, isLogPrefix]
  · have commitPositive : 0 < state.commitIndex node := by
      omega
    have boundary :
        SignatureCommitBoundary
          state node (state.commitIndex node) :=
      ⟨commitPositive, Nat.le_refl _,
        signatures node commitPositive⟩
    rcases
        chosen
          state
          (protocolHistory_final_stateAt history)
          node
          (state.commitIndex node)
          boundary with
      ⟨certificate⟩
    have choiceBeforeLeader :
        certificate.choiceTerm < state.currentTerm leader :=
      lt_of_le_of_lt
        certificate.choice_term_le_boundary_owner
        lowerTerm
    have leaderPrefix :=
      certificate.higher_term_leaders
        state
        (protocolHistory_final_stateAt history)
        leader
        leaderState
        choiceBeforeLeader
    simpa [committed, certificate.prefix_eq] using leaderPrefix

theorem appendEntriesRejectResponse_term_le_current
    (state : State)
    (message response : Message)
    (previousIndex previousTerm : Nat)
    (monoLog : MonoLogInv state)
    (logTerms : LogTermsAtLeastStartInv state)
    (responseEq :
      appendEntriesRejectResponse?
        state message previousIndex previousTerm = some response) :
    response.term <= state.currentTerm response.source := by
  unfold appendEntriesRejectResponse? at responseEq
  dsimp only at responseEq
  split at responseEq
  · contradiction
  · split at responseEq
    · have responseIsCurrent := Option.some.inj responseEq
      subst response
      simp
    · split at responseEq
      · contradiction
      · let comparisonTerm :=
          if previousIndex = 0 ||
              (state.log message.dest).length < previousIndex then
            0
          else
            (state.log message.dest).getLast?.map (·.term) |>.getD 0
        change
          (if comparisonTerm = previousTerm then
            none
          else if comparisonTerm = 0 then
            some
              {
                term := state.currentTerm message.dest
                source := message.dest
                dest := message.source
                body :=
                  .appendEntriesResponse false
                    (state.log message.dest).length
              }
          else
            let lastIndex :=
              findHighestPossibleMatch
                (state.log message.dest)
                previousIndex
                previousTerm
            let responseTerm :=
              if lastIndex = 0 then
                startTerm
              else
                (entryAt? (state.log message.dest) lastIndex).map
                    (·.term) |>.getD startTerm
            some
              {
                term := responseTerm
                source := message.dest
                dest := message.source
                body := .appendEntriesResponse false lastIndex
              }) =
            some response at responseEq
        by_cases sameTerm : comparisonTerm = previousTerm
        · simp [sameTerm] at responseEq
        · simp [sameTerm] at responseEq
          by_cases zeroComparison : comparisonTerm = 0
          · simp [zeroComparison] at responseEq
            subst response
            simp
          · simp [zeroComparison] at responseEq
            subst response
            let lastIndex :=
              findHighestPossibleMatch
                (state.log message.dest)
                previousIndex
                previousTerm
            have startLeCurrent :
                startTerm <= state.currentTerm message.dest := by
              by_cases invalidPrevious :
                  previousIndex = 0 ||
                    (state.log message.dest).length < previousIndex
              · simp [comparisonTerm, invalidPrevious] at zeroComparison
              · simp [comparisonTerm, invalidPrevious] at zeroComparison
                cases lastEntry : (state.log message.dest).getLast? with
                | none =>
                    simp [lastEntry] at zeroComparison
                | some entry =>
                    have decomposition :=
                      List.getLast?_eq_some_iff.mp lastEntry
                    rcases decomposition with ⟨logEntries, logShape⟩
                    have entryMember :
                        entry ∈ state.log message.dest := by
                      rw [logShape]
                      simp
                    have startLeEntry :=
                      logTerms message.dest entry entryMember
                    have nodeMono :=
                      monoLog message.dest (by
                        rw [logShape]
                        cases logEntries <;> rfl)
                    have entryLeCurrent :
                        entry.term <= state.currentTerm message.dest := by
                      simpa [lastEntry] using nodeMono.1
                    exact Nat.le_trans startLeEntry entryLeCurrent
            change
              (if lastIndex = 0 then
                startTerm
              else
                (entryAt? (state.log message.dest) lastIndex).map
                    (·.term) |>.getD startTerm) <=
                state.currentTerm message.dest
            split
            · exact startLeCurrent
            · cases responseEntry :
                  entryAt? (state.log message.dest) lastIndex with
              | none =>
                  simp
                  exact startLeCurrent
              | some entry =>
                  simp
                  exact logEntryTerm_le_currentTerm
                    state
                    monoLog
                    message.dest
                    lastIndex
                    entry
                    responseEntry

