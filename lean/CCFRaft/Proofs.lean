                commitConfigurations.2.trans
                  origin.configurations_eq
            }⟩
      | advanceCommitIndex node =>
          have termLog :=
            nonTimeout_candidate_term_log_unchanged
              current
              (.advanceCommitIndex node)
              currentCandidate
              enabled
              (by intro timedOut; simp)
              afterCandidate
          have commitConfigurations :=
            nonTimeout_candidate_commit_configurations_unchanged
              current
              (.advanceCommitIndex node)
              currentCandidate
              enabled
              (by intro timedOut; simp)
              afterCandidate
          rcases oldOrigins currentCandidate termLog.1 with ⟨origin⟩
          exact
            ⟨{
              timeoutState := origin.timeoutState
              occurrence := occurs_extend origin.occurrence enabled
              candidate_state := afterCandidate
              term_eq := termLog.2.1.trans origin.term_eq
              log_eq := termLog.2.2.trans origin.log_eq
              commit_eq :=
                commitConfigurations.1.trans origin.commit_eq
              configurations_eq :=
                commitConfigurations.2.trans
                  origin.configurations_eq
            }⟩
      | receive dest source kind =>
          have termLog :=
            nonTimeout_candidate_term_log_unchanged
              current
              (.receive dest source kind)
              currentCandidate
              enabled
              (by intro timedOut; simp)
              afterCandidate
          have commitConfigurations :=
            nonTimeout_candidate_commit_configurations_unchanged
              current
              (.receive dest source kind)
              currentCandidate
              enabled
              (by intro timedOut; simp)
              afterCandidate
          rcases oldOrigins currentCandidate termLog.1 with ⟨origin⟩
          exact
            ⟨{
              timeoutState := origin.timeoutState
              occurrence := occurs_extend origin.occurrence enabled
              candidate_state := afterCandidate
              term_eq := termLog.2.1.trans origin.term_eq
              log_eq := termLog.2.2.trans origin.log_eq
              commit_eq :=
                commitConfigurations.1.trans origin.commit_eq
              configurations_eq :=
                commitConfigurations.2.trans
                  origin.configurations_eq
            }⟩
    · exact history
  exact origins candidate candidateState

private theorem protocolHistory_implies_currentCandidateChosenConfigurationWitness_preappend
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {candidate : Node}
    (history : ProtocolHistory start actions state)
    (core :
      HistoricalCompleteSafetyCore start actions state)
    (candidateState :
      state.leadershipState candidate = .candidate) :
    HasCurrentCandidateChosenConfigurationWitness
      start actions state candidate := by
  rcases
      protocolHistory_currentCandidateTimeoutOrigin
        history candidate candidateState with
    ⟨origin⟩
  by_cases commitPositive : 0 < state.commitIndex candidate
  · have timeoutPositive :
        0 < origin.timeoutState.commitIndex candidate := by
      rw [← origin.commit_eq]
      exact commitPositive
    have timeoutAt :
        StateAt start actions state origin.timeoutState :=
      occurs_before_stateAt origin.occurrence
    have timeoutReachable :=
      stateAt_reachable timeoutAt
    have signatures :=
      reachable_SignatureInv start timeoutReachable
    have configurationsExact :=
      reachable_ConfigurationsExactInv start timeoutReachable
    have boundary :
        SignatureCommitBoundary
          origin.timeoutState
          candidate
          (origin.timeoutState.commitIndex candidate) :=
      ⟨timeoutPositive, Nat.le_refl _,
        signatures candidate timeoutPositive⟩
    have currentChosen :=
      historicalCompleteSafetyCore_currentChosenCommitCore
        history core
    rcases
        currentChosen
          origin.timeoutState
          timeoutAt
          candidate
          (origin.timeoutState.commitIndex candidate)
          boundary with
      ⟨certificate⟩
    have configurationAtTimeout :
        certificate.configuration ∈
          origin.timeoutState.configurations candidate :=
      configurationsExact_committedConfigurationAt?_mem
        origin.timeoutState
        candidate
        configurationsExact
        certificate.configuration
        certificate.configuration_at
    have strict :
        certificate.choiceTerm <
          state.currentTerm candidate := by
      rw [origin.term_eq]
      exact
        Nat.lt_succ_of_le
          certificate.choice_term_le_boundary_owner
    exact
      ⟨{
        basis := {
          boundaryState := origin.timeoutState
          owner := candidate
          index := origin.timeoutState.commitIndex candidate
          boundary
          certificate
          configuration_mem := by
            rw [origin.configurations_eq]
            exact configurationAtTimeout
          candidate_carries := by
            rw [certificate.prefix_eq, origin.log_eq]
            exact
              List.take_prefix
                (origin.timeoutState.commitIndex candidate)
                (origin.timeoutState.log candidate)
          choice_term_le_candidate := Nat.le_of_lt strict
        }
        choice_term_lt_candidate := strict
      }⟩
  · have commitZero : state.commitIndex candidate = 0 := by
      omega
    rcases
        candidateChosenConfigurationWitness_of_zero_commit_evidence_with_choice_term
          history
          core.chosenCommits
          core.electionLogs.counted.logs.monoLogs
          core.electionLogs.counted.logs.logMatching
          core.electionLogs.counted.candidateOverlap
          candidate
          commitZero
          (protocolHistory_implies_current_CandidateElectionBasis
            history candidate candidateState) with
      ⟨basis, choiceTerm, _configurationIndex,
        _configurationWithinMax⟩
    have strict :
        basis.certificate.choiceTerm <
          state.currentTerm candidate := by
      rw [choiceTerm]
      exact
        reachable_CandidateTermStrictAfterStart
          start
          (protocolHistory_reachable history)
          candidate
          candidateState
    exact
      ⟨{
        basis
        choice_term_lt_candidate := strict
      }⟩

private structure CandidateFormationChosenConfigurationWitness
