theorem electionTermFold_le_term
    (term : Nat)
    (entries : List Entry) :
    electionTermFold term entries <= term := by
  induction entries using List.reverseRecOn with
  | nil =>
      simp [electionTermFold]
  | append_singleton entries entry inductionHypothesis =>
      rw [electionTermFold, List.foldl_append]
      simp only [List.foldl_cons, List.foldl_nil]
      change
        (if entry.term = term then
          max entry.term (electionTermFold term entries)
        else
          electionTermFold term entries) <=
        term
      by_cases sameTerm : entry.term = term
      · simp [sameTerm, inductionHypothesis]
      · simp [sameTerm, inductionHypothesis]

theorem electionTermFold_eq_term_of_mem
    (term : Nat)
    (entries : List Entry)
    (entry : Entry)
    (member : entry ∈ entries)
    (sameTerm : entry.term = term) :
    electionTermFold term entries = term := by
  induction entries using List.reverseRecOn with
  | nil =>
      simp at member
  | append_singleton entries last inductionHypothesis =>
      rw [electionTermFold, List.foldl_append]
      simp only [List.foldl_cons, List.foldl_nil]
      change
        (if last.term = term then
          max last.term (electionTermFold term entries)
        else
          electionTermFold term entries) =
        term
      simp only [List.mem_append, List.mem_singleton] at member
      rcases member with member | entryIsLast
      · have prefixFold :=
          inductionHypothesis member
        by_cases lastSameTerm : last.term = term
        · simp [lastSameTerm, prefixFold]
        · simp [lastSameTerm, prefixFold]
      · subst last
        simp [sameTerm, electionTermFold_le_term]

theorem electionTermFold_eq_zero_or_has_term_entry
    (term : Nat)
    (entries : List Entry) :
    Or
      (electionTermFold term entries = 0)
      (Exists fun entry =>
        And
          (entry ∈ entries)
          (entry.term = term)) := by
  induction entries using List.reverseRecOn with
  | nil =>
      exact Or.inl (by simp [electionTermFold])
  | append_singleton entries last inductionHypothesis =>
      by_cases lastSameTerm : last.term = term
      · exact
          Or.inr
            ⟨last,
              by simp,
              lastSameTerm⟩
      · rcases inductionHypothesis with zero | ⟨entry, member, sameTerm⟩
        · left
          rw [electionTermFold, List.foldl_append]
          simp [lastSameTerm]
          exact zero
        · exact
            Or.inr
              ⟨entry,
                by simp [member],
                sameTerm⟩

