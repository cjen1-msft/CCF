private theorem entryTermLeaderWitness_has_appended_term
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {term : Nat}
    (witness :
      EntryTermLeaderWitness start actions state term) :
    Exists fun entry : Entry =>
      And
        (entry ∈
          (next
            witness.appendState
            (witness.kind.action witness.leader)).log witness.leader)
        (entry.term = term) := by
  cases witness.kind with
  | clientRequest =>
      exact
        ⟨{
            term := witness.appendState.currentTerm witness.leader
            content := .entry
          },
          by
            simp [LeaderAppendKind.action, next, rawNext,
              nextClientRequest],
          witness.term_eq⟩
  | signature =>
      exact
        ⟨{
            term := witness.appendState.currentTerm witness.leader
            content := .signature
          },
          by
            simp [LeaderAppendKind.action, next, rawNext,
              nextSignCommittableMessages],
          witness.term_eq⟩
  | reconfiguration configuration =>
      exact
        ⟨{
            term := witness.appendState.currentTerm witness.leader
            content := .reconfiguration configuration
          },
          by
            simp [LeaderAppendKind.action, next, rawNext,
              nextChangeConfiguration],
          witness.term_eq⟩

