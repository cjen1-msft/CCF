private theorem replays_candidate_sameTerm_log_eq
    {before after : State}
    {replayActions : List Action}
    (replay : Replays before replayActions after)
    (candidate : Node)
    (beforeCandidate :
      before.leadershipState candidate = .candidate)
    (afterCandidate :
      after.leadershipState candidate = .candidate)
    (sameTerm :
      after.currentTerm candidate =
        before.currentTerm candidate) :
    after.log candidate = before.log candidate := by
  induction replayActions using List.reverseRecOn generalizing before after with
  | nil =>
      simp [Replays] at replay
      subst after
      rfl
  | append_singleton init last inductionHypothesis =>
      rcases replays_append_split replay with
        ⟨middle, beforeToMiddle, middleToAfter⟩
      rcases middleToAfter with ⟨lastEnabled, afterEq⟩
      subst after
      have beforeTermLeMiddle :=
        replays_currentTerm_mono beforeToMiddle candidate
      have middleTermLeAfter :=
        monotonicTerm_step middle last lastEnabled candidate
      have middleSameTerm :
          (next middle last).currentTerm candidate =
            middle.currentTerm candidate := by
        omega
      have backwards :=
        candidate_sameTerm_step_backwards
          middle
          last
          candidate
          lastEnabled
          afterCandidate
          middleSameTerm
      have beforeMiddleSameTerm :
          middle.currentTerm candidate =
            before.currentTerm candidate := by
        omega
      exact
        backwards.2.trans
          (inductionHypothesis
            beforeToMiddle
            beforeCandidate
            backwards.1
            beforeMiddleSameTerm)

private theorem higherTermConflictThenNoConflict_retains_signaturePrefix_before
    {start : InitialConfiguration}
    {actions targetActions : List Action}
    {endState targetState state : State}
    {choiceLeader follower receiveDest receiveSource : Node}
    {message : Message}
    {previousIndex previousTerm leaderCommitIndex index choiceTerm : Nat}
    {entries : List Entry}
    (stateAt :
      StateAt start actions endState state)
    (stateAtTarget :
      StateAt start targetActions targetState state)
    (higherTermLeaders :
      forall leaderState,
        StateAt start targetActions targetState leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              choiceTerm <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <=
                    targetState.currentTerm follower ->
                isLogPrefix
                  (logPrefix (endState.log choiceLeader) index)
                  (leaderState.log historicalLeader))
    (signature :
      (entryAt? (endState.log choiceLeader) index).map (·.content) =
        some .signature)
    (higherTerm : choiceTerm < state.currentTerm follower)
    (retained :
      isLogPrefix
        (logPrefix (endState.log choiceLeader) index)
        (state.log follower))
    (head :
      headMessage? state receiveDest receiveSource = some message)
    (body :
      message.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (enabled :
      Enabled state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)) :
    isLogPrefix
      (logPrefix (endState.log choiceLeader) index)
      ((next state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)).log follower) := by
  by_cases followerIsDest : follower = receiveDest
  · subst receiveDest
    have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    rcases stateAtTarget with ⟨stateAtWitness⟩
    have requests :=
      queueHistory_implies_AppendEntriesRequestHistoryConsistent
        (protocolHistory_implies_QueueHistoryConsistent
          stateAtWitness.stateHistory)
    have requestQueued :
        message ∈ state.messages follower receiveSource :=
      headMessage?_mem state follower receiveSource message head
    rcases
        (by
          simpa [body] using
            requests follower receiveSource message requestQueued) with
      ⟨send⟩
    have fields := body
    rw [send.message_eq] at fields
    simp [appendEntriesMessage] at fields
    rcases fields with
      ⟨previousIndexEq, previousTermEq, entriesEq,
        leaderCommitIndexEq⟩
    subst previousIndex
    subst previousTerm
    subst entries
    subst leaderCommitIndex
    have requestSend :
        Occurs
          start targetActions targetState send.sendState
          (.appendEntries receiveSource follower) :=
      occurs_extend_stateAtWitness stateAtWitness send.occurrence
    have requestLeader :
        send.sendState.leadershipState receiveSource = .leader := by
      rcases send.occurrence with ⟨sendOccurrence⟩
      have sendEnabled := sendOccurrence.enabled
      simp [Enabled, actionEnabled] at sendEnabled
      exact sendEnabled.1.1.2
    have accept :
        appendEntriesAcceptBase
            state
            follower
            (send.sendState.currentTerm receiveSource)
            (send.sendState.sentIndex receiveSource follower)
            (((entryAt?
                  (send.sendState.log receiveSource)
                  (send.sendState.sentIndex receiveSource follower)).map
                (·.term)).getD 0) =
          true := by
      simpa [send.message_eq, appendEntriesMessage] using
        branchEnabled.2.2.1.1
    have acceptFacts := accept
    simp [appendEntriesAcceptBase] at acceptFacts
    have sourceHigher :
        choiceTerm <
          send.sendState.currentTerm receiveSource :=
      higherTerm.trans_eq acceptFacts.1.1.1.symm
    have sourceUpper :
        send.sendState.currentTerm receiveSource <=
          targetState.currentTerm follower := by
      rw [acceptFacts.1.1.1]
      exact
        replays_currentTerm_mono
          stateAtWitness.remainingHistory follower
    have sourceCarries :=
      higherTermLeaders
        send.sendState
        (occurs_before_stateAt requestSend)
        receiveSource
        requestLeader
        sourceHigher
        sourceUpper
    have prefixLength :=
      signatureLogPrefix_length signature
    have selfPrefixEq :
        logPrefix (endState.log choiceLeader) index =
          logPrefix
            (logPrefix (endState.log choiceLeader) index)
            index := by
      have takeLength :
          (logPrefix (endState.log choiceLeader) index).take
              (logPrefix (endState.log choiceLeader) index).length =
            logPrefix (endState.log choiceLeader) index :=
        List.take_length
      exact
        takeLength.symm.trans
          (by
            simpa [logPrefix] using
              congrArg
                (fun n =>
                  (logPrefix
                    (endState.log choiceLeader) index).take n)
                prefixLength)
    have previousAtLeastIndex :
        index <= send.sendState.sentIndex receiveSource follower :=
      appendEntriesConflict_previousIndex_ge_referencePrefix
        state
        follower
        (send.sendState.log receiveSource)
        (logPrefix (endState.log choiceLeader) index)
        (logPrefix (endState.log choiceLeader) index)
        (send.sendState.sentIndex receiveSource follower)
        index
        selfPrefixEq
        prefixLength
        retained
        (Or.inl sourceCarries)
        (by
          simpa [send.message_eq, appendEntriesMessage] using
            branchEnabled.2.2.1.2)
    have oldBound : index <= (state.log follower).length := by
      rw [← prefixLength]
      exact retained.length_le
    have prefixAtOld :
        logPrefix (endState.log choiceLeader) index =
          logPrefix (state.log follower) index :=
      prefix_eq_logPrefix_of_length
        _
        _
        index
        retained
        prefixLength
    have resultPrefixEq :
        logPrefix
            ((next state
              (.receive
                follower receiveSource
                .appendEntriesConflictThenNoConflict)).log follower)
            index =
          logPrefix (state.log follower) index := by
      simp [next, rawNext, nextReceive, head,
        send.message_eq, appendEntriesMessage,
        nextAppendEntriesNoConflict, conflictRollback,
        logPrefix]
      rw [List.take_append_of_le_length
        (by
          simpa [List.length_take] using
            Nat.le_min.mpr
              ⟨previousAtLeastIndex, oldBound⟩)]
      simp [List.take_take,
        Nat.min_eq_left previousAtLeastIndex]
    rw [prefixAtOld, ← resultPrefixEq]
    exact logPrefix_isLogPrefix _ _
  · have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    simpa [next, rawNext, nextReceive, head, body,
      nextAppendEntriesNoConflict, conflictRollback,
      branchEnabled.2.1.1, followerIsDest] using retained

private theorem higherTermSignaturePrefix_step_before
    {start : InitialConfiguration}
    {actions targetActions : List Action}
    {endState targetState state : State}
    {choiceLeader member : Node}
    {index choiceTerm : Nat}
    {action : Action}
    (stateAt :
      StateAt start actions endState state)
    (stateAtTarget :
      StateAt start targetActions targetState state)
    (higherTermLeaders :
      forall leaderState,
        StateAt start targetActions targetState leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              choiceTerm <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <=
                    targetState.currentTerm member ->
                isLogPrefix
                  (logPrefix (endState.log choiceLeader) index)
                  (leaderState.log historicalLeader))
    (signature :
      (entryAt? (endState.log choiceLeader) index).map (·.content) =
        some .signature)
    (higherTerm : choiceTerm < state.currentTerm member)
    (retained :
      isLogPrefix
        (logPrefix (endState.log choiceLeader) index)
        (state.log member))
    (enabled : Enabled state action) :
    isLogPrefix
      (logPrefix (endState.log choiceLeader) index)
      ((next state action).log member) := by
  have retainLog
      (logRetained :
        isLogPrefix
          (state.log member)
          ((next state action).log member)) :
      isLogPrefix
        (logPrefix (endState.log choiceLeader) index)
        ((next state action).log member) :=
    retained.trans logRetained
  cases action with
  | timeout node =>
      exact retainLog (by simp [isLogPrefix, next, rawNext, nextTimeout])
  | requestVote source dest =>
      exact retainLog
        (by simp [isLogPrefix, next, rawNext, nextRequestVote])
  | appendEntries source dest =>
      exact retainLog
        (by simp [isLogPrefix, next, rawNext, nextAppendEntries])
  | becomeLeader elected =>
      by_cases memberIsElected : member = elected
      · subst elected
        simpa [next, rawNext, nextBecomeLeader] using
          signatureLogPrefix_committable signature retained
      · exact retainLog
          (by
            simp [isLogPrefix, next, rawNext, nextBecomeLeader,
              memberIsElected])
  | clientRequest node =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextClientRequest])
      · exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextClientRequest,
            memberIsNode])
  | signCommittableMessages node =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages])
      · exact retainLog
          (by
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages, memberIsNode])
  | changeConfiguration node configuration =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration])
      · exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration,
            memberIsNode])
  | advanceCommitIndex node =>
      exact retainLog
        (by simp [isLogPrefix, next, rawNext, nextAdvanceCommitIndex])
  | receive receiveDest receiveSource kind =>
      cases head :
          headMessage? state receiveDest receiveSource with
      | none =>
          exact retainLog
            (by simp [isLogPrefix, next, rawNext, nextReceive, head])
      | some message =>
          cases kind with
          | rejectAppendEntriesRequest =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      exact retainLog
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, responseCase])
                  | some producedResponse =>
                      exact retainLog
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, responseCase])
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesNoConflict =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have enabledFacts := enabled
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabledFacts
                  have messageDest : message.dest = receiveDest :=
                    enabledFacts.2.1.1
                  have noConflict := enabledFacts.2.2.2
                  exact retainLog
                    (by
                      by_cases memberIsDest : member = receiveDest
                      · subst member
                        simpa [next, rawNext, nextReceive, head, body,
                          messageDest] using
                          appendEntriesNoConflict_retains_old_log
                            state message previousIndex entries
                            leaderCommitIndex noConflict
                      · simp [isLogPrefix, next, rawNext, nextReceive,
                          head, body, nextAppendEntriesNoConflict,
                          messageDest, memberIsDest])
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesConflictThenAlreadyDone =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, head] at branchEnabled
                  have requestDestEq := branchEnabled.2.1.1
                  have branchEnabled := branchEnabled.2.2
                  simp [receiveBranchEnabled, body,
                    appendEntriesAcceptBase, appendEntriesLogOK,
                    appendEntriesAlreadyDoneGuard,
                    appendEntriesConflictGuard, conflictRollback,
                    updateNode, requestDestEq] at branchEnabled
                  rcases branchEnabled with
                    ⟨⟨_, conflict⟩, alreadyDone⟩
                  have entriesNonempty : entries ≠ [] :=
                    conflict.1.1
                  rcases alreadyDone with entriesEmpty | bounded
                  · exact False.elim (entriesNonempty entriesEmpty)
                  · exact False.elim (entriesNonempty bounded.2)
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesConflictThenNoConflict =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  exact
                    higherTermConflictThenNoConflict_retains_signaturePrefix_before
                      stateAt
                      stateAtTarget
                      higherTermLeaders
                      signature
                      higherTerm
                      retained
                      head
                      body
                      enabled
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | _ =>
              cases body : message.body <;>
                exact retainLog
                  (by
                    simp [isLogPrefix, next, rawNext, nextReceive,
                      head, body, nextAppendEntriesAlreadyDone])

theorem advanceCommitIndex_choiceSupport_retained_at_higherTerm_state
    {start : InitialConfiguration}
    {actions : List Action}
    {state historicalState : State}
    {leader member : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (support :
      AdvanceCommitPendingChoiceSupport
        start actions state leader member)
    (historicalEndpoint :
      StateAtWitness start actions state historicalState)
    (higherTerm :
      state.currentTerm leader <
        historicalState.currentTerm member)
    (higherTermLeaders :
      forall leaderState,
        StateAt
            start
            historicalEndpoint.pastActions
            historicalState
            leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <=
                    historicalState.currentTerm member ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (leaderState.log historicalLeader)) :
    isLogPrefix
      (logPrefix (state.log leader) index)
      (historicalState.log member) := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have leaderState : state.leadershipState leader = .leader :=
    enabledFacts.1.2
  let extendedSupport :
      ChoiceSupportWitness
        start
        (actions ++ [.advanceCommitIndex leader])
        (next state (.advanceCommitIndex leader))
        state
        leader
        member
        (highestCommittableIndex state leader)
        (state.currentTerm leader) :=
    {
      choiceActions := actions
      choice_history := history
      choice_actions_prefix := ⟨[.advanceCommitIndex leader], rfl⟩
      matchWitness := support.matchWitness
      index_le_ack := support.index_le_ack
      response_term := support.response_term
    }
  have matchingAtChoice :
      TemporalLogMatchingInv start actions state :=
    core.electionLogs.counted.logs.logMatching
  rcases
      advanceCommitIndex_choiceSupport_acknowledges_choiceIndexPrefix
        leaderState
        extendedSupport
        matchingAtChoice with
    ⟨strongAck, choiceIndexAcknowledged⟩
  have boundaryAtState :
      (entryAt? (state.log leader) index).map (·.content) =
        some .signature := by
    simpa [next, rawNext, nextAdvanceCommitIndex] using boundary.2.2
  let acknowledgedPrefix :=
    logPrefix
      ((next strongAck.ack.origin.responseState
        (.receive
          member
          leader
          strongAck.ack.origin.kind.receiveKind)).log member)
      extendedSupport.matchWitness.lastLogIndex
  have chosenToAcknowledged :
      isLogPrefix
        (logPrefix (state.log leader) index)
        acknowledgedPrefix :=
    (logPrefix_mono_isLogPrefix
      (state.log leader)
      index
      (highestCommittableIndex state leader)
      indexWithin).trans
      (by
        simpa [extendedSupport, acknowledgedPrefix] using
          choiceIndexAcknowledged)
  have ackOccurrence :
      Occurs
        start
        actions
        state
        strongAck.ack.origin.responseState
        (.receive
          member
          leader
          strongAck.ack.origin.kind.receiveKind) :=
    strongAck.ack.origin.occurrence
  rcases ackOccurrence with ⟨ackWitness⟩
  let ackAction : Action :=
    .receive
      member
      leader
      strongAck.ack.origin.kind.receiveKind
  have ackCompletePrefix :
      ackWitness.pastActions ++ [ackAction] <+: actions :=
    ⟨ackWitness.futureActions,
      by
        simpa [ackAction, List.append_assoc] using
          ackWitness.actions_eq.symm⟩
  have historicalPrefix :
      historicalEndpoint.pastActions <+: actions :=
    ⟨historicalEndpoint.futureActions,
      historicalEndpoint.actions_eq.symm⟩
  have ackBeforeHistorical :
      ackWitness.pastActions ++ [ackAction] <+:
        historicalEndpoint.pastActions := by
    rcases
        List.prefix_or_prefix_of_prefix
          ackCompletePrefix historicalPrefix with
      ackBefore | historicalBefore
    · exact ackBefore
    · rcases historicalBefore with ⟨betweenActions, actionsEq⟩
      have ackAfterHistory :
          ProtocolHistory
            start
            (ackWitness.pastActions ++ [ackAction])
            (next strongAck.ack.origin.responseState
              ackAction) := by
        simpa [ackAction] using
          replays_append_singleton
            ackWitness.before_history ackWitness.enabled
      rw [← actionsEq] at ackAfterHistory
      rcases replays_append_split ackAfterHistory with
        ⟨middleState, historicalReplay, betweenReplay⟩
      have middleEq : middleState = historicalState :=
        replays_deterministic
          historicalReplay historicalEndpoint.stateHistory
      have termMono :
          historicalState.currentTerm member <=
            (next strongAck.ack.origin.responseState
              ackAction).currentTerm member := by
        simpa [middleEq] using
          replays_currentTerm_mono betweenReplay member
      have ackTerm :
          (next strongAck.ack.origin.responseState
            ackAction).currentTerm member =
            state.currentTerm leader := by
        simpa [ackAction] using
          strongAck.ack.response_term.symm.trans
            extendedSupport.response_term
      rw [ackTerm] at termMono
      omega
  rcases ackBeforeHistorical with ⟨betweenActions, historicalPastEq⟩
  have historicalHistory := historicalEndpoint.stateHistory
  rw [← historicalPastEq] at historicalHistory
  rcases replays_append_split historicalHistory with
    ⟨ackAfterState, ackReplay, betweenReplay⟩
  have expectedAckReplay :
      Replays
        (initialState start)
        (ackWitness.pastActions ++ [ackAction])
        (next strongAck.ack.origin.responseState ackAction) := by
    simpa [ackAction] using
      replays_append_singleton
        ackWitness.before_history ackWitness.enabled
  have ackAfterEq :
      ackAfterState =
        next strongAck.ack.origin.responseState ackAction :=
    replays_deterministic ackReplay expectedAckReplay
  have actualBetween :
      Replays
        (next strongAck.ack.origin.responseState ackAction)
        betweenActions
        historicalState := by
    simpa only [ackAfterEq] using betweenReplay
  have leaderUniqueness :=
    completeSafetyCore_implies_leaderUniqueness history core
  have sameLeaderPrefixes :=
    protocolHistory_implies_HistoricalSameLeaderLogPrefixInv history
  have leaderNeMember : leader ≠ member := by
    rcases strongAck.send_occurrence with ⟨sendOccurrence⟩
    have sendEnabled := sendOccurrence.enabled
    simp [Enabled, actionEnabled] at sendEnabled
    exact sendEnabled.1.1.1.2
  have extend :
      forall
        (past suffix : List Action)
        (before : State),
        historicalEndpoint.pastActions = past ++ suffix ->
          ProtocolHistory start past before ->
            Replays before suffix historicalState ->
              (Or
                (And
                  (before.currentTerm member =
                    state.currentTerm leader)
                  (isLogPrefix
                    acknowledgedPrefix
                    (before.log member)))
                (And
                  (state.currentTerm leader <
                    before.currentTerm member)
                  (isLogPrefix
                    (logPrefix (state.log leader) index)
                    (before.log member)))) ->
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (historicalState.log member) := by
    intro past suffix
    induction suffix generalizing past with
    | nil =>
        intro before _actionsEq _pastHistory replay retained
        simp [Replays] at replay
        subst before
        rcases retained with equalMode | higherMode
        · omega
        · exact higherMode.2
    | cons nextAction tail inductionHypothesis =>
        intro before actionsEq pastHistory replay retained
        rcases replay with ⟨nextEnabled, tailReplay⟩
        have nextHistory :=
          replays_append_singleton pastHistory nextEnabled
        have beforeAt :
            StateAt start actions state before :=
          ⟨{
            pastActions := past
            futureActions :=
              nextAction ::
                (tail ++ historicalEndpoint.futureActions)
            actions_eq := by
              calc
                actions =
                    historicalEndpoint.pastActions ++
                      historicalEndpoint.futureActions :=
                  historicalEndpoint.actions_eq
                _ =
                    past ++
                      (nextAction ::
                        (tail ++ historicalEndpoint.futureActions)) := by
                  rw [actionsEq]
                  simp only [List.append_assoc, List.cons_append]
            stateHistory := pastHistory
            remainingHistory := by
              have toHistorical :
                  Replays
                    before
                    (nextAction :: tail)
                    historicalState :=
                ⟨nextEnabled, tailReplay⟩
              simpa only [List.cons_append] using
                replays_append
                  toHistorical
                  historicalEndpoint.remainingHistory
          }⟩
        have beforeAtTarget :
            StateAt
              start
              historicalEndpoint.pastActions
              historicalState
              before :=
          ⟨{
            pastActions := past
            futureActions := nextAction :: tail
            actions_eq := actionsEq
            stateHistory := pastHistory
            remainingHistory := ⟨nextEnabled, tailReplay⟩
          }⟩
        have nextAt :
            StateAt
              start
              actions
              state
              (next before nextAction) :=
          ⟨{
            pastActions := past ++ [nextAction]
            futureActions :=
              tail ++ historicalEndpoint.futureActions
            actions_eq := by
              calc
                actions =
                    historicalEndpoint.pastActions ++
                      historicalEndpoint.futureActions :=
                  historicalEndpoint.actions_eq
                _ =
                    (past ++ [nextAction]) ++
                      (tail ++ historicalEndpoint.futureActions) := by
                  rw [actionsEq]
                  calc
                    (past ++ nextAction :: tail) ++
                        historicalEndpoint.futureActions =
                      past ++
                        ((nextAction :: tail) ++
                          historicalEndpoint.futureActions) :=
                      List.append_assoc _ _ _
                    _ =
                        (past ++ [nextAction]) ++
                          (tail ++ historicalEndpoint.futureActions) := by
                      calc
                        past ++
                            ((nextAction :: tail) ++
                              historicalEndpoint.futureActions) =
                          past ++
                            (nextAction ::
                              (tail ++
                                historicalEndpoint.futureActions)) := by
                          rw [List.cons_append]
                        _ =
                            past ++
                              ([nextAction] ++
                                (tail ++
                                  historicalEndpoint.futureActions)) :=
                          rfl
                        _ =
                            (past ++ [nextAction]) ++
                              (tail ++
                                historicalEndpoint.futureActions) :=
                          (List.append_assoc _ _ _).symm
            stateHistory := nextHistory
            remainingHistory :=
              replays_append
                tailReplay
                historicalEndpoint.remainingHistory
          }⟩
        have nextAtTarget :
            StateAt
              start
              historicalEndpoint.pastActions
              historicalState
              (next before nextAction) :=
          ⟨{
            pastActions := past ++ [nextAction]
            futureActions := tail
            actions_eq := by
              simpa only [List.append_assoc, List.singleton_append] using
                actionsEq
            stateHistory := nextHistory
            remainingHistory := tailReplay
          }⟩
        have nextRetained :
            Or
              (And
                ((next before nextAction).currentTerm member =
                  state.currentTerm leader)
                (isLogPrefix
                  acknowledgedPrefix
                  ((next before nextAction).log member)))
              (And
                (state.currentTerm leader <
                  (next before nextAction).currentTerm member)
                (isLogPrefix
                  (logPrefix (state.log leader) index)
                  ((next before nextAction).log member))) := by
          rcases retained with equalMode | higherMode
          · have termStep :=
              monotonicTerm_step before nextAction nextEnabled member
            by_cases nextEqual :
                (next before nextAction).currentTerm member =
                  state.currentTerm leader
            · exact Or.inl
                ⟨nextEqual,
                  by
                    have retainedAck :=
                      successfulAckPrefix_step
                        history
                        beforeAt
                        nextAt
                        sameLeaderPrefixes
                        leaderUniqueness
                        strongAck
                        leaderState
                        extendedSupport.response_term
                        leaderNeMember
                        equalMode.1
                        nextEqual
                        (by
                          simpa [acknowledgedPrefix] using equalMode.2)
                        nextEnabled
                    simpa [acknowledgedPrefix] using retainedAck⟩
            · have nextHigher :
                  state.currentTerm leader <
                    (next before nextAction).currentTerm member := by
                omega
              have termIncreased :
                  before.currentTerm member <
                    (next before nextAction).currentTerm member := by
                omega
              have logUnchanged :=
                currentTermIncrease_log_unchanged
                  before nextAction member termIncreased
              exact Or.inr
                ⟨nextHigher,
                  (chosenToAcknowledged.trans equalMode.2).trans
                    (by rw [logUnchanged])⟩
          ·
            have retainedHigher :=
              higherTermSignaturePrefix_step_before
                beforeAt
                beforeAtTarget
                higherTermLeaders
                boundaryAtState
                higherMode.1
                higherMode.2
                nextEnabled
            exact Or.inr
              ⟨higherMode.1.trans_le
                  (monotonicTerm_step
                    before nextAction nextEnabled member),
                retainedHigher⟩
        exact
          inductionHypothesis
            (past ++ [nextAction])
            (next before nextAction)
            (by
              simpa only [List.append_assoc, List.singleton_append] using
                actionsEq)
            nextHistory
            tailReplay
            nextRetained
  have initialMode :
      Or
        (And
          ((next strongAck.ack.origin.responseState
              (.receive
                member
                leader
                  strongAck.ack.origin.kind.receiveKind)).currentTerm
              member =
            state.currentTerm leader)
          (isLogPrefix
            acknowledgedPrefix
            ((next strongAck.ack.origin.responseState
              (.receive
                member
                leader
                strongAck.ack.origin.kind.receiveKind)).log member)))
        (And
          (state.currentTerm leader <
            (next strongAck.ack.origin.responseState
              (.receive
                member
                leader
                strongAck.ack.origin.kind.receiveKind)).currentTerm
              member)
          (isLogPrefix
            (logPrefix (state.log leader) index)
            ((next strongAck.ack.origin.responseState
              (.receive
                member
                leader
                strongAck.ack.origin.kind.receiveKind)).log member))) :=
    Or.inl
      ⟨strongAck.ack.response_term.symm.trans
          extendedSupport.response_term,
        logPrefix_isLogPrefix _ _⟩
  exact
    extend
      (ackWitness.pastActions ++ [ackAction])
      betweenActions
      (next strongAck.ack.origin.responseState ackAction)
      historicalPastEq.symm
      (by
        simpa [ackAction] using
          replays_append_singleton
            ackWitness.before_history ackWitness.enabled)
      actualBetween
      initialMode

theorem advanceCommitIndex_requestVoteLogOK_carries_boundary_with_term
    {start : InitialConfiguration}
    {actions : List Action}
    {state localState voterState : State}
    {leader voter candidate : Node}
    {index lastTerm lastIndex : Nat}
    {request : Message}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (endpointAt :
      StateAtWitness start actions state localState)
    (lowerTermLeaders :
      forall leaderState,
        StateAt start actions state leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <
                    localState.currentTerm candidate ->
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (leaderState.log historicalLeader))
    (localAt :
      StateAtWitness start actions state localState)
    (voterAt :
      StateAt start localAt.pastActions localState voterState)
    (send :
      RVSendWitness
        start localAt.pastActions localState voter candidate request)
    (requestBody :
      request.body =
        .requestVoteRequest lastTerm lastIndex false)
    (lastTermBeforeCandidate :
      lastTerm < localState.currentTerm candidate)
    (logOK :
      requestVoteLogOK
          voterState voter lastTerm lastIndex =
        true)
    (voterChoiceSupport :
      isLogPrefix
        (logPrefix
          (state.log leader)
          (highestCommittableIndex state leader))
        (voterState.log voter)) :
    And
      (isLogPrefix
        (logPrefix (state.log leader) index)
        (send.sendState.log candidate))
      (state.currentTerm leader <=
        send.sendState.currentTerm candidate) := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have choiceLeaderState :
      state.leadershipState leader = .leader :=
    enabledFacts.1.2
  have highestPositive :
      0 < highestCommittableIndex state leader := by
    omega
  have voterAtFull :
      StateAt start actions state voterState :=
    stateAt_extend_stateAtWitness localAt voterAt
  have sendAt :
      StateAt start actions state send.sendState :=
    occurs_before_stateAt
      (occurs_extend_stateAtWitness localAt send.occurrence)
  have sentBody := congrArg Message.body send.message_eq
  have requestFacts :
      lastTerm =
          lastCommittableTerm send.sendState candidate ∧
        lastIndex =
          lastCommittableIndex send.sendState candidate := by
    simpa [requestVoteMessage, requestBody] using sentBody
  have boundaryAtState :
      (entryAt? (state.log leader) index).map (·.content) =
        some .signature := by
    simpa [next, rawNext, nextAdvanceCommitIndex] using boundary.2.2
  cases boundaryEntryAt :
      entryAt? (state.log leader) index with
  | none =>
      simp [boundaryEntryAt] at boundaryAtState
  | some boundaryEntry =>
    have boundaryEntrySignature :
        boundaryEntry.content = .signature := by
      simpa [boundaryEntryAt] using boundaryAtState
    have chosenEntry :
        entryAt?
            (logPrefix (state.log leader) index)
            index =
          some
            ({ term := boundaryEntry.term, content := .signature } :
              Entry) := by
      have boundaryEntryEq :
          boundaryEntry =
            ({ term := boundaryEntry.term, content := .signature } :
              Entry) := by
        cases boundaryEntry with
        | mk term content =>
            simp only at boundaryEntrySignature
            subst content
            rfl
      have signatureAt :
          entryAt? (state.log leader) index =
            some
              ({ term := boundaryEntry.term, content := .signature } :
                Entry) :=
        boundaryEntryAt.trans (congrArg some boundaryEntryEq)
      exact
        entryAt?_take_of_some
          (state.log leader)
          index
          index
          _
          signatureAt
          (Nat.le_refl _)
    have chosenLength :
        (logPrefix (state.log leader) index).length = index :=
      signatureLogPrefix_length boundaryAtState
    have voterSupport :
        isLogPrefix
          (logPrefix (state.log leader) index)
          (voterState.log voter) :=
      (logPrefix_mono_isLogPrefix
        (state.log leader)
        index
        (highestCommittableIndex state leader)
        indexWithin).trans voterChoiceSupport
    have voterChosenEntry :
        entryAt? (voterState.log voter) index =
          some
            ({ term := boundaryEntry.term, content := .signature } :
              Entry) := by
      rcases voterSupport with ⟨suffix, voterLogEq⟩
      rw [← voterLogEq]
      exact
        entryAt?_append_of_some
          (logPrefix (state.log leader) index)
          suffix
          index
          _
          chosenEntry
    have choiceEntryExists :
        Exists fun choiceEntry =>
          And
            (entryAt?
                (state.log leader)
                (highestCommittableIndex state leader) =
              some choiceEntry)
            (And
              (choiceEntry.term = state.currentTerm leader)
              (choiceEntry.content = .signature)) := by
      rcases
          highestCommittableIndex_signature_or_zero state leader with
        highestZero |
          ⟨choiceEntry, choiceEntryAt, choiceEntryTerm,
            choiceEntrySignature⟩
      · omega
      · exact
          ⟨choiceEntry, choiceEntryAt, choiceEntryTerm,
            choiceEntrySignature⟩
    rcases choiceEntryExists with
      ⟨choiceEntry, choiceEntryAt, choiceEntryTerm,
        choiceEntrySignature⟩
    have choiceEntryEq :
        choiceEntry =
          ({ term := state.currentTerm leader, content := .signature } :
            Entry) := by
      cases choiceEntry
      simp_all
    have choiceIndexEntry :
        entryAt?
            (state.log leader)
            (highestCommittableIndex state leader) =
          some
            ({ term := state.currentTerm leader,
                content := .signature } :
              Entry) := by
      simpa [choiceEntryEq] using choiceEntryAt
    have choicePrefixEntry :
        entryAt?
            (logPrefix
              (state.log leader)
              (highestCommittableIndex state leader))
            (highestCommittableIndex state leader) =
          some
            ({ term := state.currentTerm leader,
                content := .signature } :
              Entry) := by
      rw [logPrefix]
      exact
        entryAt?_take_of_some
          (state.log leader)
          (highestCommittableIndex state leader)
          (highestCommittableIndex state leader)
          _
          choiceIndexEntry
          (Nat.le_refl _)
    have voterChoiceEntry :
        entryAt?
            (voterState.log voter)
            (highestCommittableIndex state leader) =
          some
            ({ term := state.currentTerm leader,
                content := .signature } :
              Entry) := by
      rcases voterChoiceSupport with ⟨suffix, voterLogEq⟩
      rw [← voterLogEq]
      exact
        entryAt?_append_of_some
          (logPrefix
            (state.log leader)
            (highestCommittableIndex state leader))
          suffix
          (highestCommittableIndex state leader)
          _
          choicePrefixEntry
    have choiceIndexLeVoterMax :
        highestCommittableIndex state leader <=
          maxCommittableIndex (voterState.log voter) :=
      index_le_maxCommittableIndex_of_signature
        (voterState.log voter)
        (highestCommittableIndex state leader)
        (by simp [voterChoiceEntry])
    have indexLeVoterMax :
        index <= maxCommittableIndex (voterState.log voter) :=
      indexWithin.trans choiceIndexLeVoterMax
    have voterMaxPositive :
        0 < maxCommittableIndex (voterState.log voter) := by
      exact highestPositive.trans_le choiceIndexLeVoterMax
    rcases
        maxCommittableIndex_signature_or_zero
          (voterState.log voter) with
      voterMaxZero |
        ⟨voterMaxEntry, voterMaxAt, voterMaxSignature⟩
    · omega
    have voterMaxTermEq :
        maxCommittableTerm (voterState.log voter) =
          voterMaxEntry.term := by
      simp [maxCommittableTerm, voterMaxAt]
    have voterLogNonempty : voterState.log voter != [] := by
      cases empty : voterState.log voter with
      | nil =>
          rw [empty] at voterChosenEntry
          simp [entryAt?] at voterChosenEntry
      | cons head tail =>
          rfl
    have choiceLeVoterMaxTerm :
        state.currentTerm leader <=
          maxCommittableTerm (voterState.log voter) := by
      rw [voterMaxTermEq]
      have voterMono :=
        (core.electionLogs.counted.logs.monoLogs
          voterState voterAtFull voter voterLogNonempty).2
      have bound :=
        monoLogEntries_entryAt_term_le
          (voterState.log voter)
          (highestCommittableIndex state leader)
          (maxCommittableIndex (voterState.log voter))
          ({ term := state.currentTerm leader,
              content := .signature } :
            Entry)
          voterMaxEntry
          voterMono
          voterChoiceEntry
          voterMaxAt
          (index_le_maxCommittableIndex_of_signature
            (voterState.log voter)
            (highestCommittableIndex state leader)
            (by simp [voterChoiceEntry]))
      simpa using bound
    have choiceLeVoterMaxEntry :
        state.currentTerm leader <= voterMaxEntry.term := by
      simpa [← voterMaxTermEq] using choiceLeVoterMaxTerm
    have choiceAfterStart :
        startTerm <= state.currentTerm leader := by
      have minimum :=
        protocolHistory_implies_MinimumTermInv history
      exact minimum.activeRoles leader (by simp [choiceLeaderState])
    have logOKFacts := logOK
    simp [requestVoteLogOK] at logOKFacts
    rw [voterMaxTermEq] at logOKFacts
    have choiceLeLastTerm :
        state.currentTerm leader <= lastTerm := by
      rcases logOKFacts with termGreater | ⟨termEqual, _indexBound⟩
      · exact
          Nat.le_of_lt
            (lt_of_le_of_lt choiceLeVoterMaxEntry termGreater)
      · exact choiceLeVoterMaxEntry.trans_eq termEqual
    have signaturesAtSend :
        SignatureInv send.sendState :=
      reachable_SignatureInv
        start
        (stateAt_reachable sendAt)
    rcases
        lastCommittableIndex_signature_or_zero
          send.sendState candidate signaturesAtSend with
      candidateIndexZero |
        ⟨candidateEntry, candidateAt, candidateSignature⟩
    · have lastIndexZero : lastIndex = 0 := by
        exact requestFacts.2.trans candidateIndexZero
      have lastTermZero : lastTerm = 0 := by
        rw [requestFacts.1, lastCommittableTerm,
          candidateIndexZero]
        simp [entryAt?]
      rw [lastTermZero] at choiceLeLastTerm
      simp [startTerm] at choiceAfterStart
      omega
    have candidateIndexEq :
        lastIndex =
          lastCommittableIndex send.sendState candidate :=
      requestFacts.2
    have candidateAtLast :
        entryAt? (send.sendState.log candidate) lastIndex =
          some candidateEntry := by
      rw [candidateIndexEq]
      exact candidateAt
    have candidateEntryTerm :
        candidateEntry.term = lastTerm := by
      have termEq := requestFacts.1
      rw [lastCommittableTerm, ← candidateIndexEq,
        candidateAtLast] at termEq
      exact termEq.symm
    have candidateEntryEq :
        candidateEntry =
          ({ term := lastTerm, content := .signature } : Entry) := by
      cases candidateEntry
      simp_all
    have candidateSignatureAt :
        entryAt? (send.sendState.log candidate) lastIndex =
          some ({ term := lastTerm, content := .signature } : Entry) := by
      simpa [candidateEntryEq] using candidateAtLast
    have lastIndexPositive : 0 < lastIndex := by
      unfold entryAt? at candidateSignatureAt
      split at candidateSignatureAt
      · contradiction
      · omega
    have signatureOrigins :=
      protocolHistory_implies_HistoricalSignatureLeaderAtIndexInv
        history
        core.electionLogs.counted.logs.logMatching
    rcases
        signatureOrigins
          send.sendState
          sendAt
          candidate
          lastIndex
          lastTerm
          candidateSignatureAt
          (choiceAfterStart.trans choiceLeLastTerm) with
      ⟨leaderState, originLeader, leaderAt, originLeaderRole,
        originLeaderTerm, originLeaderEntry⟩
    have leaderLogNonempty :
        leaderState.log originLeader != [] := by
      cases empty : leaderState.log originLeader with
      | nil =>
          rw [empty] at originLeaderEntry
          simp [entryAt?] at originLeaderEntry
      | cons head tail =>
          rfl
    have originLeaderMono :=
      (core.electionLogs.counted.logs.monoLogs
        leaderState leaderAt originLeader leaderLogNonempty).2
    have chosenPrefixAtLeader :
        forall prefixProof :
            isLogPrefix
              (logPrefix (state.log leader) index)
              (leaderState.log originLeader),
          entryAt? (leaderState.log originLeader) index =
            some
              ({ term := boundaryEntry.term,
                  content := .signature } :
                Entry) := by
      intro prefixProof
      rcases prefixProof with ⟨suffix, leaderLogEq⟩
      rw [← leaderLogEq]
      exact
        entryAt?_append_of_some
          (logPrefix (state.log leader) index)
          suffix
          index
          _
          chosenEntry
    have leaderUniqueness :=
      completeSafetyCore_implies_leaderUniqueness history core
    have chosenInOriginLeader :
        isLogPrefix
          (logPrefix (state.log leader) index)
          (leaderState.log originLeader) := by
      rcases Nat.lt_or_eq_of_le choiceLeLastTerm with
        choiceEarlier | sameChoiceTerm
      · exact
          lowerTermLeaders
            leaderState
            leaderAt
            originLeader
            originLeaderRole
            (by simpa [originLeaderTerm] using choiceEarlier)
            (by simpa [originLeaderTerm] using lastTermBeforeCandidate)
      · have sameLeader : leader = originLeader :=
          leaderUniqueness
            state
            leaderState
            (protocolHistory_final_stateAt history)
            leaderAt
            leader
            originLeader
            choiceLeaderState
            originLeaderRole
            (by
              rw [originLeaderTerm, sameChoiceTerm])
        subst originLeader
        have indexLeLast : index <= lastIndex := by
          rcases logOKFacts with
            termGreater | ⟨termEqual, indexBound⟩
          · have voterTermLtLast :
                maxCommittableTerm (voterState.log voter) <
                  lastTerm := by
              simpa [voterMaxTermEq] using termGreater
            omega
          · exact
              indexLeVoterMax.trans
                (by simpa [requestFacts.2] using indexBound)
        have leaderLength :
            lastIndex <= (leaderState.log leader).length := by
          unfold entryAt? at originLeaderEntry
          split at originLeaderEntry
          · contradiction
          · have bound :=
              (List.getElem?_eq_some_iff.mp originLeaderEntry).choose
            omega
        have logsComparable :=
          historical_sameTerm_leader_logs_comparable
            (protocolHistory_final_stateAt history)
            leaderAt
            leader
            choiceLeaderState
            originLeaderRole
            (by
              rw [originLeaderTerm, sameChoiceTerm])
        rcases logsComparable with
          choiceToOrigin | originToChoice
        · exact
            (logPrefix_isLogPrefix (state.log leader) index).trans
              choiceToOrigin
        · rcases
              List.prefix_or_prefix_of_prefix
                (logPrefix_isLogPrefix (state.log leader) index)
                originToChoice with
            chosenToOrigin | originToChosen
          · exact chosenToOrigin
          · have sameLogs :
                leaderState.log leader =
                  logPrefix (state.log leader) index :=
              originToChosen.eq_of_length_le
                (by rw [chosenLength]; omega)
            rw [sameLogs]
            exact List.prefix_rfl
    have boundaryTermLeChoice :
        boundaryEntry.term <= state.currentTerm leader := by
      exact
        logEntryTerm_le_currentTerm
          state
          (core.electionLogs.counted.logs.monoLogs
            state
            (protocolHistory_final_stateAt history))
          leader
          index
          boundaryEntry
          boundaryEntryAt
    have indexLeLast : index <= lastIndex := by
      by_contra notLe
      have lastLeIndex : lastIndex <= index := by omega
      have termBound :=
        monoLogEntries_entryAt_term_le
          (leaderState.log originLeader)
          lastIndex
          index
          ({ term := lastTerm, content := .signature } : Entry)
          ({ term := boundaryEntry.term, content := .signature } :
            Entry)
          originLeaderMono
          originLeaderEntry
          (chosenPrefixAtLeader chosenInOriginLeader)
          lastLeIndex
      have choiceStrict :
          state.currentTerm leader < lastTerm := by
        rcases Nat.lt_or_eq_of_le choiceLeLastTerm with
          strict | equal
        · exact strict
        · have indexBound : index <= lastIndex := by
            rcases logOKFacts with
              termGreater | ⟨termEqual, bound⟩
            · have voterTermLtLast :
                  maxCommittableTerm (voterState.log voter) <
                    lastTerm := by
                simpa [voterMaxTermEq] using termGreater
              omega
            · exact
                indexLeVoterMax.trans
                  (by simpa [requestFacts.2] using bound)
          contradiction
      simp at termBound
      omega
    have leaderWithin :
        lastIndex <= (leaderState.log originLeader).length := by
      unfold entryAt? at originLeaderEntry
      split at originLeaderEntry
      · contradiction
      · have bound :=
          (List.getElem?_eq_some_iff.mp originLeaderEntry).choose
        omega
    have candidateWithin :
        lastIndex <= (send.sendState.log candidate).length := by
      unfold entryAt? at candidateSignatureAt
      split at candidateSignatureAt
      · contradiction
      · have bound :=
          (List.getElem?_eq_some_iff.mp candidateSignatureAt).choose
        omega
    have prefixesAtLast :
        logPrefix (leaderState.log originLeader) lastIndex =
          logPrefix (send.sendState.log candidate) lastIndex :=
      core.electionLogs.counted.logs.logMatching
        leaderState
        send.sendState
        leaderAt
        sendAt
        originLeader
        candidate
        lastIndex
        (by omega)
        (Nat.le_min.mpr ⟨leaderWithin, candidateWithin⟩)
        (by simp [originLeaderEntry, candidateSignatureAt])
    have chosenToLeaderPrefix :
        isLogPrefix
          (logPrefix (state.log leader) index)
          (logPrefix (leaderState.log originLeader) lastIndex) := by
      rw [prefix_eq_logPrefix_of_length
        (logPrefix (state.log leader) index)
        (leaderState.log originLeader)
        index
        chosenInOriginLeader
        chosenLength]
      exact
        logPrefix_mono_isLogPrefix
          (leaderState.log originLeader)
          index
          lastIndex
          indexLeLast
    rw [prefixesAtLast] at chosenToLeaderPrefix
    have carries :=
      chosenToLeaderPrefix.trans
        (logPrefix_isLogPrefix
          (send.sendState.log candidate) lastIndex)
    have lastTermLeCurrent :
        lastTerm <= send.sendState.currentTerm candidate := by
      rw [← candidateEntryTerm]
      exact
        logEntryTerm_le_currentTerm
          send.sendState
          (core.electionLogs.counted.logs.monoLogs
            send.sendState sendAt)
          candidate
          lastIndex
          candidateEntry
          candidateAtLast
    exact
      ⟨carries,
        choiceLeLastTerm.trans lastTermLeCurrent⟩

theorem advanceCommitIndex_countedVote_carries_boundary
    {start : InitialConfiguration}
    {actions : List Action}
    {state candidateState : State}
    {leader candidate voter : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (higherTermLeaders :
      forall leaderState,
        StateAt start actions state leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <
                    candidateState.currentTerm candidate ->
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (leaderState.log historicalLeader))
    (candidateAt :
      StateAtWitness start actions state candidateState)
    (candidateRole :
      candidateState.leadershipState candidate = .candidate)
    (candidateQuorum :
      allConfigurationsHaveQuorum
          (candidateState.votesGranted candidate)
          (candidateState.configurations candidate) =
        true)
    (vote :
      CountedVoteLogWitness
        start candidateAt.pastActions candidateState candidate voter)
    (grantCarries :
      isLogPrefix
        (logPrefix
          (state.log leader)
          (highestCommittableIndex state leader))
        (vote.counted.responseOrigin.responseState.log voter)) :
    isLogPrefix
      (logPrefix (state.log leader) index)
      (candidateState.log candidate) := by
  have requestBody :
      vote.counted.responseOrigin.request.body =
        .requestVoteRequest
          vote.counted.responseOrigin.lastTerm
          vote.counted.responseOrigin.lastIndex
          false := by
    have sentBody := congrArg Message.body vote.send.message_eq
    have sentFacts := sentBody.symm
    simp [requestVoteMessage,
      vote.counted.responseOrigin.request_body] at sentFacts
    simpa [sentFacts.2.2] using
      vote.counted.responseOrigin.request_body
  rcases vote.send.occurrence with ⟨sendOccurrence⟩
  have sendEnabled := sendOccurrence.enabled
  have sendCandidate :
      vote.send.sendState.leadershipState candidate = .candidate := by
    have sendFacts := sendEnabled
    simp [Enabled, actionEnabled] at sendFacts
    exact sendFacts.1.2
  have sentTerm :=
    congrArg Message.term vote.send.message_eq
  have requestTerm :
      vote.counted.responseOrigin.request.term =
        vote.send.sendState.currentTerm candidate := by
    simpa [requestVoteMessage] using sentTerm
  have responseAtOrigin := vote.counted.response_body
  rw [vote.counted.responseOrigin.response_eq] at responseAtOrigin
  have grantTrue :
      requestVoteGranted
          vote.counted.responseOrigin.responseState
          voter
          candidate
          vote.counted.responseOrigin.request.term
          vote.counted.responseOrigin.lastTerm
          vote.counted.responseOrigin.lastIndex =
        true :=
    (MessageBody.requestVoteResponse.inj responseAtOrigin).1
  have grantFacts := grantTrue
  simp [requestVoteGranted] at grantFacts
  have responseTerm :
      vote.counted.response.term =
        vote.counted.responseOrigin.responseState.currentTerm voter := by
    simpa using
      congrArg Message.term
        vote.counted.responseOrigin.response_eq
  have sendCandidateTerm :
      vote.send.sendState.currentTerm candidate =
        candidateState.currentTerm candidate := by
    rw [← requestTerm]
    exact
      grantFacts.1.1.trans
        (responseTerm.symm.trans
          vote.counted.candidate_term_eq.symm)
  have localOverlap :
      TemporalQuorumCandidateConfigurationOverlapInv
        start candidateAt.pastActions candidateState := by
    intro first second firstAt secondAt
    exact
      core.electionLogs.counted.candidateOverlap
        first
        second
        (stateAt_extend_stateAtWitness candidateAt firstAt)
        (stateAt_extend_stateAtWitness candidateAt secondAt)
  have fresh :=
    historicalElectionCores_imply_HistoricalCandidateQuorumFreshInv
      candidateAt.stateHistory
      (protocolHistory_implies_HistoricalElectionVoteCore
        candidateAt.stateHistory)
      localOverlap
      (protocolHistory_implies_HistoricalEntryTermLeaderOriginInv
        candidateAt.stateHistory)
      (protocolHistory_implies_HistoricalLeaderToCurrentCandidateTermInv
        candidateAt.stateHistory)
  have lastTermBeforeCandidate :
      vote.counted.responseOrigin.lastTerm <
        candidateState.currentTerm candidate := by
    have requestFacts :
        vote.counted.responseOrigin.lastTerm =
            lastCommittableTerm vote.send.sendState candidate ∧
          vote.counted.responseOrigin.lastIndex =
            lastCommittableIndex vote.send.sendState candidate := by
      simpa [requestVoteMessage, requestBody] using
        congrArg Message.body vote.send.message_eq
    have signaturesAtSend :=
      reachable_SignatureInv
        start
        (stateAt_reachable
          (occurs_before_stateAt vote.send.occurrence))
    rcases
        lastCommittableIndex_signature_or_zero
          vote.send.sendState candidate signaturesAtSend with
      lastZero | ⟨entry, entryAt, entrySignature⟩
    · have lastIndexZero :
          vote.counted.responseOrigin.lastIndex = 0 := by
        exact requestFacts.2.trans lastZero
      have lastTermZero :
          vote.counted.responseOrigin.lastTerm = 0 := by
        rw [requestFacts.1, lastCommittableTerm, lastZero]
        simp [entryAt?]
      rw [lastTermZero]
      exact
        Nat.zero_lt_of_lt
          (reachable_CandidateTermStrictAfterStart
            start
            (stateAt_reachable ⟨candidateAt⟩)
            candidate
            candidateRole)
    · have lastIndexEq :
          vote.counted.responseOrigin.lastIndex =
            lastCommittableIndex vote.send.sendState candidate := by
        exact requestFacts.2
      have entryAtLast :
          entryAt?
              (vote.send.sendState.log candidate)
              vote.counted.responseOrigin.lastIndex =
            some entry := by
        rw [lastIndexEq]
        exact entryAt
      have entryTerm :
          entry.term = vote.counted.responseOrigin.lastTerm := by
        rw [requestFacts.1, lastCommittableTerm,
          ← lastIndexEq, entryAtLast]
      have entryMember :=
        entryAt?_mem
          (vote.send.sendState.log candidate)
          vote.counted.responseOrigin.lastIndex
          entry
          entryAtLast
      have notEqual :=
        fresh
          candidate
          candidateRole
          candidateQuorum
          vote.send.sendState
          (occurs_before_stateAt vote.send.occurrence)
          candidate
          entry
          entryMember
      have termLe :=
        logEntryTerm_le_currentTerm
          vote.send.sendState
          (core.electionLogs.counted.logs.monoLogs
            vote.send.sendState
            (stateAt_extend_stateAtWitness
              candidateAt
              (occurs_before_stateAt vote.send.occurrence)))
          candidate
          vote.counted.responseOrigin.lastIndex
          entry
          entryAtLast
      rw [entryTerm] at termLe notEqual
      rw [sendCandidateTerm] at termLe
      have termNe :
          vote.counted.responseOrigin.lastTerm ≠
            candidateState.currentTerm candidate :=
        bne_iff_ne.mp notEqual
      omega
  have carriesAtSend :=
    advanceCommitIndex_requestVoteLogOK_carries_boundary_with_term
      history
      core
      enabled
      boundary
      indexWithin
      candidateAt
      higherTermLeaders
      candidateAt
      (occurs_before_stateAt
        vote.counted.responseOrigin.occurrence)
      vote.send
      requestBody
      lastTermBeforeCandidate
      vote.log_ok
      grantCarries
  have sendToCandidate :
      Replays
        vote.send.sendState
        (.requestVote candidate voter ::
          sendOccurrence.futureActions)
        candidateState :=
    ⟨sendOccurrence.enabled, sendOccurrence.after_history⟩
  have sendLogEq :=
    replays_candidate_sameTerm_log_eq
      sendToCandidate
      candidate
      sendCandidate
      candidateRole
      sendCandidateTerm.symm
  simpa [sendLogEq] using carriesAtSend.1

private theorem countedVote_candidateTerm_le_voterTerm
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {candidate voter : Node}
    (vote :
      CountedVoteLogWitness start actions state candidate voter) :
    state.currentTerm candidate <= state.currentTerm voter := by
  rcases
      occurs_after_stateAt vote.counted.responseOrigin.occurrence with
    ⟨responseAfter⟩
  have responseTerm :
      vote.counted.response.term =
        vote.counted.responseOrigin.responseState.currentTerm voter := by
    simpa using
      congrArg Message.term
        vote.counted.responseOrigin.response_eq
  have afterTerm :
      (next
        vote.counted.responseOrigin.responseState
        (.receive
          voter
          candidate
          .handleRequestVoteRequest)).currentTerm voter =
        vote.counted.response.term := by
    simpa [next, rawNext, nextReceive,
      vote.counted.responseOrigin.request_head,
      vote.counted.responseOrigin.request_body] using responseTerm.symm
  rw [vote.counted.candidate_term_eq, ← afterTerm]
  exact
    replays_currentTerm_mono responseAfter.remainingHistory voter

private theorem advanceCommitIndex_countedSupport_transfers
    {start : InitialConfiguration}
    {actions : List Action}
    {state candidateState : State}
    {leader candidate voter : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (candidateEndpoint :
      StateAtWitness start actions state candidateState)
    (lowerTermLeaders :
      forall leaderState,
        StateAt start actions state leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <
                    candidateState.currentTerm candidate ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (leaderState.log historicalLeader))
    (higherTermLeaders :
      forall leaderState,
        StateAt
            start
            candidateEndpoint.pastActions
            candidateState
            leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <=
                    candidateState.currentTerm candidate ->
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (leaderState.log historicalLeader))
    (choicePrefixHigherTermLeaders :
      forall leaderState,
        StateAt
            start
            candidateEndpoint.pastActions
            candidateState
            leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <=
                    candidateState.currentTerm candidate ->
                isLogPrefix
                  (logPrefix
                    (state.log leader)
                    (highestCommittableIndex state leader))
                  (leaderState.log historicalLeader))
    (candidateRole :
      candidateState.leadershipState candidate = .candidate)
    (candidateQuorum :
      allConfigurationsHaveQuorum
          (candidateState.votesGranted candidate)
          (candidateState.configurations candidate) =
        true)
    (higherTerm :
      state.currentTerm leader <
        candidateState.currentTerm candidate)
    (voteMember : voter ∈ candidateState.votesGranted candidate)
    (support :
      AdvanceCommitPendingChoiceSupport
        start actions state leader voter) :
    isLogPrefix
      (logPrefix (state.log leader) index)
      (candidateState.log candidate) := by
  by_cases voterIsCandidate : voter = candidate
  · subst voter
    exact
      advanceCommitIndex_choiceSupport_retained_at_higherTerm_state
        history
        core
        enabled
        boundary
        indexWithin
        support
        candidateEndpoint
        higherTerm
        (by
          intro leaderState leaderAt historicalLeader leaderRole term upper
          exact
            higherTermLeaders
              leaderState
              leaderAt
              historicalLeader
              leaderRole
              term
              upper)
  · rcases
        protocolHistory_implies_CountedVoteLogHistoryConsistent
          candidateEndpoint.stateHistory
          candidate
          voter
          (Or.inl candidateRole)
          voteMember
          voterIsCandidate with
      ⟨vote⟩
    rcases
        occurs_before_stateAt
          vote.counted.responseOrigin.occurrence with
      ⟨grantLocalEndpoint⟩
    let grantEndpoint :
        StateAtWitness
          start actions state
          vote.counted.responseOrigin.responseState :=
      {
        pastActions := grantLocalEndpoint.pastActions
        futureActions :=
          grantLocalEndpoint.futureActions ++
            candidateEndpoint.futureActions
        actions_eq := by
          calc
            actions =
                candidateEndpoint.pastActions ++
                  candidateEndpoint.futureActions :=
              candidateEndpoint.actions_eq
            _ =
                (grantLocalEndpoint.pastActions ++
                    grantLocalEndpoint.futureActions) ++
                  candidateEndpoint.futureActions := by
              exact
                congrArg
                  (fun xs => xs ++ candidateEndpoint.futureActions)
                  grantLocalEndpoint.actions_eq
            _ =
                grantLocalEndpoint.pastActions ++
                  (grantLocalEndpoint.futureActions ++
                    candidateEndpoint.futureActions) := by
              simp only [List.append_assoc]
        stateHistory := grantLocalEndpoint.stateHistory
        remainingHistory :=
          replays_append
            grantLocalEndpoint.remainingHistory
            candidateEndpoint.remainingHistory
      }
    have responseTerm :
        vote.counted.response.term =
          vote.counted.responseOrigin.responseState.currentTerm voter := by
      simpa using
        congrArg Message.term
          vote.counted.responseOrigin.response_eq
    have grantHigher :
        state.currentTerm leader <
          vote.counted.responseOrigin.responseState.currentTerm voter := by
      rw [← responseTerm, ← vote.counted.candidate_term_eq]
      exact higherTerm
    have grantCarries :=
      advanceCommitIndex_choiceSupport_retained_at_higherTerm_state
        history
        core
        enabled
        (advanceCommitIndex_highest_boundary enabled)
        (Nat.le_refl _)
        support
        grantEndpoint
        grantHigher
        (by
          intro leaderState leaderAt historicalLeader leaderRole term upper
          have upperAtCandidate :
              leaderState.currentTerm historicalLeader <=
                candidateState.currentTerm candidate := by
            exact
              upper.trans_eq
                (responseTerm.symm.trans
                  vote.counted.candidate_term_eq.symm)
          exact
            choicePrefixHigherTermLeaders
              leaderState
              (stateAt_extend_stateAtWitness
                grantLocalEndpoint leaderAt)
              historicalLeader
              leaderRole
              term
              upperAtCandidate)
    exact
      advanceCommitIndex_countedVote_carries_boundary
        history
        core
        enabled
        boundary
        indexWithin
        lowerTermLeaders
        candidateEndpoint
        candidateRole
        candidateQuorum
        vote
        grantCarries

theorem advanceCommitIndex_potentialVote_carries_boundary
    {start : InitialConfiguration}
    {actions : List Action}
    {state candidateState : State}
    {leader candidate voter : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (higherTermLeaders :
      forall leaderState,
        StateAt start actions state leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <
                    candidateState.currentTerm candidate ->
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (leaderState.log historicalLeader))
    (candidateAt :
      StateAtWitness start actions state candidateState)
    (candidateRole :
      candidateState.leadershipState candidate = .candidate)
    (vote :
      VotedForLogWitness
        start candidateAt.pastActions candidateState voter candidate)
    (potentialVote :
      voter ∈ votersForCandidateTerm candidateState candidate)
    (sendCandidateTerm :
      vote.send.sendState.currentTerm candidate =
        candidateState.currentTerm candidate)
    (lastTermBeforeCandidate :
      vote.responseOrigin.lastTerm <
        candidateState.currentTerm candidate)
    (grantCarries :
      isLogPrefix
        (logPrefix
          (state.log leader)
          (highestCommittableIndex state leader))
        (vote.responseOrigin.responseState.log voter)) :
    isLogPrefix
      (logPrefix (state.log leader) index)
      (candidateState.log candidate) := by
  have requestBody :
      vote.request.body =
        .requestVoteRequest
          vote.responseOrigin.lastTerm
          vote.responseOrigin.lastIndex
          false := by
    have sentBody := congrArg Message.body vote.send.message_eq
    have sentFacts := sentBody.symm
    simp [requestVoteMessage, vote.request_eq,
      vote.responseOrigin.request_body] at sentFacts
    rw [vote.request_eq]
    simpa [sentFacts.2.2] using
      vote.responseOrigin.request_body
  have carriesAtSend :=
    advanceCommitIndex_requestVoteLogOK_carries_boundary_with_term
      history
      core
      enabled
      boundary
      indexWithin
      candidateAt
      higherTermLeaders
      candidateAt
      (occurs_before_stateAt vote.responseOrigin.occurrence)
      vote.send
      requestBody
      lastTermBeforeCandidate
      vote.log_ok
      grantCarries
  rcases vote.send.occurrence with ⟨sendOccurrence⟩
