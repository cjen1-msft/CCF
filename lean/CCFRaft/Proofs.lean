private theorem temporalLogMatching_receive_of_unchanged_logs
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (dest source : Node)
    (kind : ReceiveKind)
    (enabled : Enabled state (.receive dest source kind))
    (logs :
      forall node : Node,
        (next state (.receive dest source kind)).log node =
          state.log node) :
    TemporalLogMatchingInv
      start
      (actions ++ [.receive dest source kind])
      (next state (.receive dest source kind)) := by
  apply temporalLogMatching_append_of_current_prefixes
    history matching (.receive dest source kind) enabled
  intro node
  exact
    ⟨(state.log node).length,
      by simpa using logs node⟩

private theorem receive_logs_unchanged_of_not_log_action
    (state : State)
    (dest source : Node)
    (kind : ReceiveKind)
    (notNoConflict :
      kind ≠ .appendEntriesNoConflict)
    (notConflictAlreadyDone :
      kind ≠ .appendEntriesConflictThenAlreadyDone)
    (notConflictNoConflict :
      kind ≠ .appendEntriesConflictThenNoConflict) :
    forall node : Node,
      (next state (.receive dest source kind)).log node =
        state.log node := by
  intro node
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [next, rawNext, nextReceive, hmessage]
  | some message =>
      cases kind <;> try contradiction
      all_goals
        cases hbody : message.body <;>
          simp [next, rawNext, nextReceive, hmessage, hbody,
            nextAppendEntriesAlreadyDone]
      all_goals
        split <;> simp_all

private theorem temporalLogMatching_receive_conflictThenAlreadyDone
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
