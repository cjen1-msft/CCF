  intro prefixActions prefixState isPrefix history
  rcases isPrefix with ⟨suffix, actionsEq⟩
  have prefixEmpty : prefixActions = [] := by
    have both : prefixActions = [] ∧ suffix = [] := by
      simpa using congrArg List.length actionsEq
    exact both.1
  subst prefixActions
  have stateEq :
      prefixState = initialState start :=
    replays_deterministic history rfl
  subst prefixState
  exact initial_HistoricalChosenCommitCore start

