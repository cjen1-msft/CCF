theorem initial_LeaderLogBoundaryInv (start : InitialConfiguration) :
    LeaderLogBoundaryInv (initialState start) := by
  intro node leaderState lastEntry lastEntryAt
  have member : node ∈ start.nodes := by
    by_contra notMem
    simp [initialState, notMem] at leaderState
  have nodeEq : node = start.leader := by
    simpa [initialState, member] using leaderState
  subst node
  simp [initialState, startLog, start.leader_mem] at lastEntryAt
  subst lastEntry
  left
  simp [initialState, start.leader_mem]

