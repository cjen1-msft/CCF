theorem currentMatchIndexPrefixHistory_implies_MatchIndexPrefixInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (currentHistory :
      CurrentMatchIndexPrefixHistoryConsistent start actions state)
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state) :
    MatchIndexPrefixInv state := by
  exact
    currentMatchIndexPrefixHistory_implies_MatchIndexPrefixInv_of_strongAcks
      history
      currentHistory
      sameLeaderPrefixes
      matching
      leaderUniqueness
      (by
        intro pastActions historicalState pastHistory historicalMatching
        exact
          queueHistory_implies_SuccessfulAckSendPrefixConsistent
            historicalMatching
            (protocolHistory_implies_QueueHistoryConsistent pastHistory))

theorem historicalMatchIndex_implies_MatchIndexPrefixInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (_matchHistory :
      MatchIndexHistoryConsistent start actions state)
    (acknowledged :
      AcknowledgedPrefixRetainedInv start actions state)
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (matching : TemporalLogMatchingInv start actions state) :
    MatchIndexPrefixInv state := by
  intro leader follower leaderState sameTerm
  dsimp
  by_cases indexZero :
      state.matchIndex leader follower = 0
  · simp [indexZero, logPrefix]
  · have indexPositive :
        0 < state.matchIndex leader follower := by
      omega
    have currentTermHistory :=
      protocolHistory_implies_CurrentTermMatchIndexHistoryConsistent
        history
    rcases
        currentTermHistory
          leader follower leaderState indexPositive with
      ⟨current⟩
    rcases occurs_before_stateAt current.witness.handle_occurrence with
      ⟨handledStateAt⟩
    have matchingAtHandled :
        TemporalLogMatchingInv
          start
          handledStateAt.pastActions
          current.witness.handledState := by
      intro first second firstAt secondAt
      exact matching
        first
        second
        (stateAt_extend_stateAtWitness handledStateAt firstAt)
        (stateAt_extend_stateAtWitness handledStateAt secondAt)
    have queuesAtHandled :=
      protocolHistory_implies_QueueHistoryConsistent
        handledStateAt.stateHistory
    have responseQueued :
        current.witness.response ∈
          current.witness.handledState.messages leader follower :=
      headMessage?_mem
        current.witness.handledState
        leader
        follower
        current.witness.response
        current.witness.response_head
    have strongAcks :=
      queueHistory_implies_SuccessfulAckSendPrefixConsistent
        matchingAtHandled
        queuesAtHandled
    rcases
        strongAcks
          leader
          follower
          current.witness.response
          current.witness.lastLogIndex
          responseQueued
          current.witness.ack.response_body with
      ⟨origin⟩
    let extendedOrigin :
        AEResponseWitness
          start actions state leader follower
          current.witness.response :=
      {
        origin.ack.origin with
        occurrence :=
          occurs_extend_stateAtWitness
            handledStateAt origin.ack.origin.occurrence
      }
    let extendedAck :
        AckWitness
          start actions state leader follower
          current.witness.response
          current.witness.lastLogIndex :=
      {
        origin := extendedOrigin
        response_body := origin.ack.response_body
        response_term := origin.ack.response_term
        index_bounded := origin.ack.index_bounded
      }
    let accurateMatch :
        MatchIndexWitness
          start actions state leader follower :=
      {
        current.witness with
        ack := extendedAck
      }
    have followerRetained :
        isLogPrefix
          (logPrefix
            ((next origin.ack.origin.responseState
              (.receive
                follower
                leader
                origin.ack.origin.kind.receiveKind)).log follower)
            current.witness.lastLogIndex)
          (state.log follower) := by
      simpa [accurateMatch, extendedAck, extendedOrigin] using
        acknowledged
          leader follower leaderState sameTerm accurateMatch
          current.response_term
    have senderRetained :=
      sameLeaderPrefixes
        origin.sendState
        (occurs_before_stateAt
          (occurs_extend_stateAtWitness
            handledStateAt origin.send_occurrence))
        leader
        origin.send_leader
        leaderState
        (origin.send_term.trans current.response_term)
    have senderBound :
        current.witness.lastLogIndex <=
          (origin.sendState.log leader).length := by
      have lengthEq := congrArg List.length origin.prefix_eq
      simp [logPrefix, List.length_take,
        Nat.min_eq_left origin.ack.index_bounded] at lengthEq
      omega
    have leaderBound :
        current.witness.lastLogIndex <=
          (state.log leader).length :=
      Nat.le_trans senderBound senderRetained.length_le
    have acknowledgedPrefixLength :
        (logPrefix
          ((next origin.ack.origin.responseState
            (.receive
              follower
              leader
              origin.ack.origin.kind.receiveKind)).log follower)
          current.witness.lastLogIndex).length =
            current.witness.lastLogIndex := by
      simp [logPrefix, Nat.min_eq_left origin.ack.index_bounded]
    have followerBound :
        current.witness.lastLogIndex <=
          (state.log follower).length := by
      rw [← acknowledgedPrefixLength]
      exact followerRetained.length_le
    rcases senderRetained with ⟨leaderSuffix, leaderLogEq⟩
    have leaderPrefixEq :
        logPrefix
            (state.log leader)
            current.witness.lastLogIndex =
          logPrefix
            (origin.sendState.log leader)
            current.witness.lastLogIndex := by
      rw [← leaderLogEq]
      exact
        logPrefix_append_eq_of_index_le_length
          (origin.sendState.log leader)
          leaderSuffix
          current.witness.lastLogIndex
          senderBound
    rcases followerRetained with ⟨followerSuffix, followerLogEq⟩
    have followerPrefixEq :
        logPrefix
            (state.log follower)
            current.witness.lastLogIndex =
          logPrefix
            ((next origin.ack.origin.responseState
              (.receive
                follower
                leader
                origin.ack.origin.kind.receiveKind)).log follower)
            current.witness.lastLogIndex := by
      rw [← followerLogEq]
      simpa [logPrefix, List.take_take] using
        logPrefix_append_eq_of_index_le_length
          (logPrefix
            ((next origin.ack.origin.responseState
              (.receive
                follower
                leader
                origin.ack.origin.kind.receiveKind)).log follower)
            current.witness.lastLogIndex)
          followerSuffix
          current.witness.lastLogIndex
          (by rw [acknowledgedPrefixLength])
    rw [current.witness.index_eq]
    exact
      ⟨leaderBound,
        followerBound,
        leaderPrefixEq.trans
          (origin.prefix_eq.symm.trans followerPrefixEq.symm)⟩

theorem acknowledgedPrefixRetained_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    (history : ProtocolHistory start actions state)
    (acknowledged :
      AcknowledgedPrefixRetainedInv start actions state)
    (matchHistory :
      MatchIndexHistoryConsistent start actions state)
    (_successfulAcks :
      SuccessfulAckHistoryConsistent start actions state)
    (electionLogs :
      HistoricalElectionLogCore start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (nextLeaderUniqueness :
      TemporalLeaderUniquenessInv
        start (actions ++ [action]) (next state action))
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (ackHandling :
      SuccessfulAckHandlingPrefixRetention start actions state)
    (enabled : Enabled state action) :
    AcknowledgedPrefixRetainedInv
      start
      (actions ++ [action])
      (next state action) := by
  have oldPrefixes :=
    historicalMatchIndex_implies_MatchIndexPrefixInv
      history
      matchHistory
      acknowledged
      sameLeaderPrefixes
      electionLogs.logs.logMatching
  intro leader follower newLeader newSameTerm witness responseTerm
  by_cases indexZero : witness.lastLogIndex = 0
  · simp [indexZero, logPrefix, isLogPrefix]
  have positive : 0 < witness.lastLogIndex := by
    omega
  have retain
      (oldLeader : state.leadershipState leader = .leader)
      (matchUnchanged :
        (next state action).matchIndex leader follower =
          state.matchIndex leader follower)
      (followerLogRetained :
        isLogPrefix
          (state.log follower)
          ((next state action).log follower))
      (notCurrentHandle :
        action ≠
          .receive
            leader follower .handleAppendEntriesResponseSuccess) :
      isLogPrefix
        (logPrefix
          ((next
            witness.ack.origin.responseState
            (.receive
              follower
              leader
              witness.ack.origin.kind.receiveKind)).log follower)
          witness.lastLogIndex)
        ((next state action).log follower) :=
    acknowledgedPrefixRetained_of_unchanged_match
      history
      acknowledged
      enabled
      newLeader
      newSameTerm
      witness
      responseTerm
      positive
      oldLeader
      matchUnchanged
      followerLogRetained
      notCurrentHandle
  cases action with
  | timeout candidate =>
      exact retain
        (leader_before_of_leader_after
          state
          (.timeout candidate)
          leader
          newLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextTimeout])
        (by simp [isLogPrefix, next, rawNext, nextTimeout])
        (by intro equality; cases equality)
  | requestVote source dest =>
      exact retain
        (leader_before_of_leader_after
          state
          (.requestVote source dest)
          leader
          newLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextRequestVote])
        (by simp [isLogPrefix, next, rawNext, nextRequestVote])
        (by intro equality; cases equality)
  | appendEntries source dest =>
      exact retain
        (leader_before_of_leader_after
          state
          (.appendEntries source dest)
          leader
          newLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextAppendEntries])
        (by simp [isLogPrefix, next, rawNext, nextAppendEntries])
        (by intro equality; cases equality)
  | becomeLeader elected =>
      by_cases leaderIsElected : leader = elected
      · subst leader
        have indexEq := witness.index_eq
        simp [next, rawNext, nextBecomeLeader, updateNode] at indexEq
        omega
      · have oldLeader :
            state.leadershipState leader = .leader := by
          simpa [next, rawNext, nextBecomeLeader, updateNode,
            leaderIsElected] using newLeader
        by_cases followerIsElected : follower = elected
        · subst follower
          have electedLeader :
              (next state (.becomeLeader elected)).leadershipState elected =
                .leader := by
            simp [next, rawNext, nextBecomeLeader, updateNode]
          have leaderEq :
              leader = elected :=
            nextLeaderUniqueness
              (next state (.becomeLeader elected))
              (next state (.becomeLeader elected))
              (protocolHistory_final_stateAt
                (replays_append_singleton history enabled))
              (protocolHistory_final_stateAt
                (replays_append_singleton history enabled))
              leader
              elected
              newLeader
              electedLeader
              newSameTerm
          contradiction
        · exact retain
            oldLeader
            (by
              simp [next, rawNext, nextBecomeLeader, updateNode,
                leaderIsElected])
            (by
              simp [isLogPrefix, next, rawNext, nextBecomeLeader,
                followerIsElected])
            (by intro equality; cases equality)
  | clientRequest node =>
      exact retain
        (leader_before_of_leader_after
          state
          (.clientRequest node)
          leader
          newLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextClientRequest])
        (by
          by_cases followerIsNode : follower = node
          · subst follower
            simp [isLogPrefix, next, rawNext, nextClientRequest]
          · simp [isLogPrefix, next, rawNext, nextClientRequest,
              followerIsNode])
        (by intro equality; cases equality)
  | signCommittableMessages node =>
      exact retain
        (leader_before_of_leader_after
          state
          (.signCommittableMessages node)
          leader
          newLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextSignCommittableMessages])
        (by
          by_cases followerIsNode : follower = node
          · subst follower
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages]
          · simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages, followerIsNode])
        (by intro equality; cases equality)
  | changeConfiguration node configuration =>
      exact retain
        (leader_before_of_leader_after
          state
          (.changeConfiguration node configuration)
          leader
          newLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextChangeConfiguration])
        (by
          by_cases followerIsNode : follower = node
          · subst follower
            simp [isLogPrefix, next, rawNext,
              nextChangeConfiguration]
          · simp [isLogPrefix, next, rawNext,
              nextChangeConfiguration, followerIsNode])
        (by intro equality; cases equality)
  | advanceCommitIndex node =>
      exact retain
        (leader_before_of_leader_after
          state
          (.advanceCommitIndex node)
          leader
          newLeader
          (by intro elected equality; cases equality))
        (by simp [next, rawNext, nextAdvanceCommitIndex])
        (by simp [isLogPrefix, next, rawNext, nextAdvanceCommitIndex])
        (by intro equality; cases equality)
  | receive receiveDest receiveSource kind =>
      have oldLeader :
          state.leadershipState leader = .leader :=
        leader_before_of_leader_after
          state
          (.receive receiveDest receiveSource kind)
          leader
          newLeader
          (by intro elected equality; cases equality)
      cases hmessage :
          headMessage? state receiveDest receiveSource with
      | none =>
          exact retain
            oldLeader
            (by simp [next, rawNext, nextReceive, hmessage])
            (by simp [isLogPrefix, next, rawNext, nextReceive, hmessage])
            (by
              intro equality
              cases equality
              simp [Enabled, actionEnabled, hmessage] at enabled)
      | some message =>
          cases kind with
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  cases responseEq :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      exact retain
                        oldLeader
                        (by
                          simp [next, rawNext, nextReceive, hmessage, hbody,
                            responseEq])
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            hmessage, hbody, responseEq])
                        (by intro equality; cases equality)
                  | some response =>
                      exact retain
                        oldLeader
                        (by
                          simp [next, rawNext, nextReceive, hmessage, hbody,
                            responseEq])
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            hmessage, hbody, responseEq])
                        (by intro equality; cases equality)
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have enabledFacts := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabledFacts
                  have messageDest : message.dest = receiveDest :=
                    enabledFacts.2.1.1
                  have noConflict := enabledFacts.2.2.2
                  exact retain
                    oldLeader
                    (by
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict])
                    (by
                      by_cases followerIsDest :
                          follower = receiveDest
                      · subst follower
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          messageDest] using
                          appendEntriesNoConflict_retains_old_log
                            state message previousIndex entries
                            leaderCommitIndex noConflict
                      · simp [isLogPrefix, next, rawNext, nextReceive,
                          hmessage, hbody, nextAppendEntriesNoConflict,
                          messageDest, followerIsDest])
                    (by intro equality; cases equality)
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage] at branchEnabled
                  have requestDestEq := branchEnabled.2.1.1
                  have branchEnabled := branchEnabled.2.2
                  simp [receiveBranchEnabled, hbody,
                    appendEntriesAcceptBase, appendEntriesLogOK,
                    appendEntriesAlreadyDoneGuard,
                    appendEntriesConflictGuard, conflictRollback,
                    updateNode, requestDestEq] at branchEnabled
                  rcases branchEnabled with
                    ⟨⟨_, conflict⟩, alreadyDone⟩
                  have entriesNonempty : entries ≠ [] :=
                    conflict.1.1
                  rcases alreadyDone with entriesEmpty | bounded
                  · exact False.elim (entriesNonempty entriesEmpty)
                  · exact False.elim (entriesNonempty bounded.2)
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have matchUnchanged :
                      (next state
                        (.receive receiveDest receiveSource
                          .appendEntriesConflictThenNoConflict)).matchIndex
                          leader follower =
                        state.matchIndex leader follower := by
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback]
                  have oldSameTerm :
                      state.currentTerm leader =
                        state.currentTerm follower := by
                    exact
                      persistent_positive_match_old_same_term
                        history enabled oldLeader newLeader newSameTerm
                        matchUnchanged
                        (by
                          rw [witness.index_eq]
                          exact positive)
                  have matchedPrefixRetained :=
                    conflictThenNoConflict_retains_matchPrefix
                      history
                      oldPrefixes
                      sameLeaderPrefixes
                      leaderUniqueness
                      requests
                      oldLeader
                      oldSameTerm
                      hmessage
                      hbody
                      enabled
                  have oldIndex :
                      state.matchIndex leader follower =
                        witness.lastLogIndex :=
                    matchUnchanged.symm.trans witness.index_eq
                  have followerPrefixRetained :
                      isLogPrefix
                        (logPrefix
                          (state.log follower)
                          witness.lastLogIndex)
                        ((next state
                          (.receive receiveDest receiveSource
                            .appendEntriesConflictThenNoConflict)).log
                            follower) := by
                    simpa [oldIndex] using matchedPrefixRetained
                  rcases
                      occurs_append_singleton_cases
                        history enabled witness.ack.origin.occurrence with
                    oldAck | currentAck
                  · rcases
                        occurs_append_singleton_cases
                          history enabled witness.handle_occurrence with
                      oldHandle | currentHandle
                    · have oldRetained :=
                        acknowledged
                          leader
                          follower
                          oldLeader
                          oldSameTerm
                          (matchIndexWitness_restrict
                            witness
                            (ackWitness_restrict witness.ack oldAck)
                            oldHandle
                            oldIndex)
                          (by
                            simpa [persistentLeader_currentTerm_step
                              state
                              (.receive receiveDest receiveSource
                                .appendEntriesConflictThenNoConflict)
                              leader
                              newLeader] using responseTerm)
                      have oldPrefixEq :
                          logPrefix
                              ((next
                                witness.ack.origin.responseState
                                (.receive
                                  follower
                                  leader
                                  witness.ack.origin.kind.receiveKind)).log
                                follower)
                              witness.lastLogIndex =
                            logPrefix
                              (state.log follower)
                              witness.lastLogIndex := by
                        exact
                          prefix_eq_logPrefix_of_length
                            _
                            _
                            witness.lastLogIndex
                            oldRetained
                            (by
                              simp [logPrefix, List.length_take,
                                Nat.min_eq_left
                                  witness.ack.index_bounded])
                      rw [oldPrefixEq]
                      exact followerPrefixRetained
                    · rcases currentHandle with ⟨_, actionEq⟩
                      cases actionEq
                  · rcases currentAck with ⟨responseStateEq, actionEq⟩
                    simpa [responseStateEq, ← actionEq] using
                      logPrefix_isLogPrefix
                        ((next
                          state
                          (.receive
                            follower
                            leader
                            witness.ack.origin.kind.receiveKind)).log
                          follower)
                        witness.lastLogIndex
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body with
              | appendEntriesResponse success receivedIndex =>
                  cases success with
                  | false =>
                      simp [Enabled, actionEnabled, hmessage,
                        receiveBranchEnabled, hbody] at enabled
                  | true =>
                      have enabledFacts := enabled
                      simp [Enabled, actionEnabled, hmessage,
                        receiveBranchEnabled, hbody] at enabledFacts
                      have messageDest :
                          message.dest = receiveDest :=
                        enabledFacts.2.1.1
                      by_cases leaderIsDest : leader = receiveDest
                      · subst receiveDest
                        by_cases followerIsSource :
                            follower = receiveSource
                        · subst receiveSource
                          rcases
                              occurs_append_singleton_cases
                                history enabled
                                  witness.ack.origin.occurrence with
                            oldAck | finalAck
                          · have oldSame :
                                state.currentTerm leader =
                                  state.currentTerm follower := by
                              simpa [next, rawNext, nextReceive, hmessage,
                                hbody] using newSameTerm
                            have retained :=
                              ackHandling
                                leader
                                follower
                                message
                                receivedIndex
                                (by simpa [leaderIsDest] using
                                  enabledFacts.2.2.2)
                                oldSame
                                (by simpa [leaderIsDest] using hmessage)
                                hbody
                                (by simpa [leaderIsDest] using
                                  enabledFacts.2.2.1)
                                witness.response
                                witness.lastLogIndex
                                (by
                                  simpa [next, rawNext, nextReceive,
                                    hmessage, hbody, update₂, leaderIsDest] using
                                      witness.index_eq.symm)
                                (ackWitness_restrict witness.ack oldAck)
                                (by
                                  simpa [next, rawNext, nextReceive,
                                    hmessage, hbody] using responseTerm)
                            simpa [next, rawNext, nextReceive, hmessage,
                              hbody] using retained
                          · rcases finalAck with ⟨_, actionEq⟩
                            have kindEq :
                                witness.ack.origin.kind.receiveKind =
                                  .handleAppendEntriesResponseSuccess := by
                              injection actionEq
                            exact False.elim
                              (aeResponse_receiveKind_ne_handleSuccess
                                witness.ack.origin.kind kindEq)
                        · exact retain
                            oldLeader
                            (by
                              simp [next, rawNext, nextReceive, hmessage,
                                hbody, update₂, leaderIsDest,
                                followerIsSource])
                            (by
                              simp [isLogPrefix, next, rawNext,
                                nextReceive, hmessage, hbody])
                            (by
                              intro equality
                              cases equality
                              exact followerIsSource rfl)
                      · exact retain
                          oldLeader
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody, update₂, leaderIsDest])
                          (by
                            simp [isLogPrefix, next, rawNext,
                              nextReceive, hmessage, hbody])
                          (by
                            intro equality
                            cases equality
                            exact leaderIsDest rfl)
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | _ =>
              cases hbody : message.body <;>
                exact retain
                  oldLeader
                  (by
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone])
                  (by
                    simp [isLogPrefix, next, rawNext, nextReceive,
                      hmessage, hbody, nextAppendEntriesAlreadyDone])
                  (by intro equality; cases equality)

theorem currentMatchIndexPrefixHistory_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    (history : ProtocolHistory start actions state)
    (currentHistory :
      CurrentMatchIndexPrefixHistoryConsistent start actions state)
    (electionLogs :
      HistoricalElectionLogCore start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (nextLeaderUniqueness :
      TemporalLeaderUniquenessInv
        start (actions ++ [action]) (next state action))
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (enabled : Enabled state action) :
    CurrentMatchIndexPrefixHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  have oldPrefixes :=
    currentMatchIndexPrefixHistory_implies_MatchIndexPrefixInv
      history
      currentHistory
      sameLeaderPrefixes
      electionLogs.logs.logMatching
      leaderUniqueness
  have requests :=
    queueHistory_implies_AppendEntriesRequestHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent history)
  intro leader follower newLeader newSameTerm positive
  by_cases matchUnchanged :
      (next state action).matchIndex leader follower =
        state.matchIndex leader follower
  · have oldLeader :
        state.leadershipState leader = .leader :=
      positiveMatchIndex_leader_before
        state action leader follower newLeader positive
    have oldSameTerm :
        state.currentTerm leader =
          state.currentTerm follower :=
      persistent_positive_match_old_same_term
        history
        enabled
        oldLeader
        newLeader
        newSameTerm
        matchUnchanged
        positive
    have oldPositive :
        0 < state.matchIndex leader follower := by
      rw [← matchUnchanged]
      exact positive
    rcases
        currentHistory
          leader follower oldLeader oldSameTerm oldPositive with
      ⟨current⟩
    have retain
        (matchPrefixRetained :
          isLogPrefix
            (logPrefix
              (state.log follower)
              (state.matchIndex leader follower))
            ((next state action).log follower)) :
        Nonempty
          (CurrentMatchIndexPrefixWitness
            start
            (actions ++ [action])
            (next state action)
            leader
            follower) :=
      ⟨currentMatchIndexPrefixWitness_extend
        current
        enabled
        newLeader
        matchUnchanged
        matchPrefixRetained⟩
    have retainLog
        (logRetained :
          isLogPrefix
            (state.log follower)
            ((next state action).log follower)) :
        Nonempty
          (CurrentMatchIndexPrefixWitness
            start
            (actions ++ [action])
            (next state action)
            leader
            follower) :=
      retain ((logPrefix_isLogPrefix _ _).trans logRetained)
    cases action with
    | timeout node =>
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextTimeout])
    | requestVote source dest =>
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextRequestVote])
    | appendEntries source dest =>
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextAppendEntries])
    | becomeLeader elected =>
        by_cases followerIsElected : follower = elected
        · subst elected
          have electedLeader :
              (next state (.becomeLeader follower)).leadershipState follower =
                .leader := by
            simp [next, rawNext, nextBecomeLeader, updateNode]
          have followerEqLeader :=
            nextLeaderUniqueness
              (next state (.becomeLeader follower))
              (next state (.becomeLeader follower))
              (protocolHistory_final_stateAt
                (replays_append_singleton history enabled))
              (protocolHistory_final_stateAt
                (replays_append_singleton history enabled))
              follower
              leader
              electedLeader
              newLeader
              newSameTerm.symm
          subst follower
          simp [next, rawNext, nextBecomeLeader, updateNode] at positive
        · exact retainLog
            (by
              simp [isLogPrefix, next, rawNext, nextBecomeLeader,
                followerIsElected])
    | clientRequest node =>
        by_cases followerIsNode : follower = node
        · subst node
          exact retainLog
            (by simp [isLogPrefix, next, rawNext, nextClientRequest])
        · exact retainLog
            (by simp [isLogPrefix, next, rawNext, nextClientRequest,
              followerIsNode])
    | signCommittableMessages node =>
        by_cases followerIsNode : follower = node
        · subst node
          exact retainLog
            (by
              simp [isLogPrefix, next, rawNext,
                nextSignCommittableMessages])
        · exact retainLog
            (by
              simp [isLogPrefix, next, rawNext,
                nextSignCommittableMessages, followerIsNode])
    | changeConfiguration node configuration =>
        by_cases followerIsNode : follower = node
        · subst node
          exact retainLog
            (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration])
        · exact retainLog
            (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration,
              followerIsNode])
    | advanceCommitIndex node =>
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextAdvanceCommitIndex])
    | receive receiveDest receiveSource kind =>
        cases head :
            headMessage? state receiveDest receiveSource with
        | none =>
            exact retainLog
              (by simp [isLogPrefix, next, rawNext, nextReceive, head])
        | some message =>
            cases kind with
            | rejectAppendEntriesRequest =>
                cases body : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    leaderCommitIndex =>
                    cases responseCase :
                        appendEntriesRejectResponse?
                          state message previousIndex previousTerm with
                    | none =>
                        exact retainLog
                          (by
                            simp [isLogPrefix, next, rawNext, nextReceive,
                              head, body, responseCase])
                    | some producedResponse =>
                        exact retainLog
                          (by
                            simp [isLogPrefix, next, rawNext, nextReceive,
                              head, body, responseCase])
                | _ =>
                    simp [Enabled, actionEnabled, head,
                      receiveBranchEnabled, body] at enabled
            | appendEntriesNoConflict =>
                cases body : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    leaderCommitIndex =>
                    have enabledFacts := enabled
                    simp [Enabled, actionEnabled, head,
                      receiveBranchEnabled, body] at enabledFacts
                    have messageDest : message.dest = receiveDest :=
                      enabledFacts.2.1.1
                    have noConflict := enabledFacts.2.2.2
                    exact retainLog
                      (by
                        by_cases followerIsDest :
                            follower = receiveDest
                        · subst follower
                          simpa [next, rawNext, nextReceive, head, body,
                            messageDest] using
                            appendEntriesNoConflict_retains_old_log
                              state message previousIndex entries
                              leaderCommitIndex noConflict
                        · simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, nextAppendEntriesNoConflict,
                            messageDest, followerIsDest])
                | _ =>
                    simp [Enabled, actionEnabled, head,
                      receiveBranchEnabled, body] at enabled
            | appendEntriesConflictThenAlreadyDone =>
                cases body : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    leaderCommitIndex =>
                    have branchEnabled := enabled
                    simp [Enabled, actionEnabled, head] at branchEnabled
                    have requestDestEq := branchEnabled.2.1.1
                    have branchEnabled := branchEnabled.2.2
                    simp [receiveBranchEnabled, body,
                      appendEntriesAcceptBase, appendEntriesLogOK,
                      appendEntriesAlreadyDoneGuard,
                      appendEntriesConflictGuard, conflictRollback,
                      updateNode, requestDestEq] at branchEnabled
                    rcases branchEnabled with
                      ⟨⟨_, conflict⟩, alreadyDone⟩
                    have entriesNonempty : entries ≠ [] :=
                      conflict.1.1
                    rcases alreadyDone with entriesEmpty | bounded
                    · exact False.elim (entriesNonempty entriesEmpty)
                    · exact False.elim (entriesNonempty bounded.2)
                | _ =>
                    simp [Enabled, actionEnabled, head,
                      receiveBranchEnabled, body] at enabled
            | appendEntriesConflictThenNoConflict =>
                cases body : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    leaderCommitIndex =>
                    exact retain
                      (conflictThenNoConflict_retains_matchPrefix
                        history
                        oldPrefixes
                        sameLeaderPrefixes
                        leaderUniqueness
                        requests
                        oldLeader
                        oldSameTerm
                        head
                        body
                        enabled)
                | _ =>
                    simp [Enabled, actionEnabled, head,
                      receiveBranchEnabled, body] at enabled
            | _ =>
                cases body : message.body <;>
                  exact retainLog
                    (by
                      simp [isLogPrefix, next, rawNext, nextReceive,
                        head, body, nextAppendEntriesAlreadyDone])
  · cases action with
    | timeout node =>
        simp [next, rawNext, nextTimeout] at matchUnchanged
    | requestVote source dest =>
        simp [next, rawNext, nextRequestVote] at matchUnchanged
    | appendEntries source dest =>
        simp [next, rawNext, nextAppendEntries] at matchUnchanged
    | becomeLeader elected =>
        by_cases leaderIsElected : leader = elected
        · subst elected
          simp [next, rawNext, nextBecomeLeader, updateNode] at positive
        · simp [next, rawNext, nextBecomeLeader, updateNode,
            leaderIsElected] at matchUnchanged
    | clientRequest node =>
        simp [next, rawNext, nextClientRequest] at matchUnchanged
    | signCommittableMessages node =>
        simp [next, rawNext, nextSignCommittableMessages] at matchUnchanged
    | changeConfiguration node configuration =>
        simp [next, rawNext, nextChangeConfiguration] at matchUnchanged
    | advanceCommitIndex node =>
        simp [next, rawNext, nextAdvanceCommitIndex] at matchUnchanged
    | receive receiveDest receiveSource kind =>
        cases head :
            headMessage? state receiveDest receiveSource with
        | none =>
            simp [next, rawNext, nextReceive, head] at matchUnchanged
        | some message =>
            cases kind with
            | handleAppendEntriesResponseSuccess =>
                cases body : message.body with
                | appendEntriesResponse success receivedIndex =>
                    cases success with
                    | false =>
                        simp [Enabled, actionEnabled, head,
                          receiveBranchEnabled, body] at enabled
                    | true =>
                        have leaderIsDest :
                            leader = receiveDest := by
                          by_contra notDest
                          simp [next, rawNext, nextReceive, head,
                            body, update₂, notDest] at matchUnchanged
                        subst leader
                        have followerIsSource :
                            follower = receiveSource := by
                          by_contra notSource
                          simp [next, rawNext, nextReceive, head,
                            body, update₂, notSource] at matchUnchanged
                        subst follower
                        have oldIndexBefore :
                            state.matchIndex receiveDest receiveSource <
                              receivedIndex := by
                          by_contra notBefore
                          have receivedBefore :
                              receivedIndex <=
                                state.matchIndex receiveDest receiveSource :=
                            Nat.le_of_not_gt notBefore
                          simp [next, rawNext, nextReceive, head,
                            body, update₂,
                            Nat.max_eq_left receivedBefore] at matchUnchanged
                        have oldLeader :
                            state.leadershipState receiveDest = .leader := by
                          have enabledFacts := enabled
                          simp [Enabled, actionEnabled, head,
                            receiveBranchEnabled, body] at enabledFacts
                          simpa [enabledFacts.2.1.1] using
                            enabledFacts.2.2.2
                        have oldSameTerm :
                            state.currentTerm receiveDest =
                              state.currentTerm receiveSource := by
                          simpa [next, rawNext, nextReceive, head, body] using
                            newSameTerm
                        have responseTerm :
                            message.term =
                              state.currentTerm receiveDest := by
                          have enabledFacts := enabled
                          simp [Enabled, actionEnabled, head,
                            receiveBranchEnabled, body] at enabledFacts
                          simpa [enabledFacts.2.1.1] using
                            enabledFacts.2.2.1
                        have queued :
                            message ∈
                              state.messages receiveDest receiveSource :=
                          headMessage?_mem
                            state receiveDest receiveSource message head
                        have strongAcks :=
                          queueHistory_implies_SuccessfulAckSendPrefixConsistent
                            electionLogs.logs.logMatching
                            (protocolHistory_implies_QueueHistoryConsistent
                              history)
                        rcases
                            strongAcks
                              receiveDest
                              receiveSource
                              message
                              receivedIndex
                              queued
                              body with
                          ⟨origin⟩
                        have retained :=
                          successfulAckSendPrefix_retained
                            history
                            sameLeaderPrefixes
                            leaderUniqueness
                            origin
                            oldLeader
                            oldSameTerm
                            responseTerm
                        let matchWitness :
                            MatchIndexWitness
                              start
                              (actions ++
                                [.receive
                                  receiveDest
                                  receiveSource
                                  .handleAppendEntriesResponseSuccess])
                              (next state
                                (.receive
                                  receiveDest
                                  receiveSource
                                  .handleAppendEntriesResponseSuccess))
                              receiveDest
                              receiveSource :=
                          {
                            handledState := state
                            response := message
                            lastLogIndex := receivedIndex
                            ack := ackWitness_extend origin.ack enabled
                            handle_occurrence :=
                              protocolHistory_append_occurs history enabled
                            response_head := head
                            index_eq := by
                              simp [next, rawNext, nextReceive, head,
                                body, update₂,
                                Nat.max_eq_right
                                  (Nat.le_of_lt oldIndexBefore)]
                          }
                        exact ⟨{
                          matchWitness
                          response_term := by
                            simpa [matchWitness, next, rawNext, nextReceive,
                              head, body] using responseTerm
                          retained_prefix := by
                            simpa [matchWitness, ackWitness_extend,
                              next, rawNext, nextReceive, head, body] using
                                retained
                        }⟩
                | _ =>
                    simp [Enabled, actionEnabled, head,
                      receiveBranchEnabled, body] at enabled
            | _ =>
                cases body : message.body <;>
                  simp [next, rawNext, nextReceive, head, body,
                    nextAppendEntriesAlreadyDone,
                    nextAppendEntriesNoConflict, conflictRollback] at matchUnchanged
                all_goals
                  split at matchUnchanged <;> simp at matchUnchanged

theorem protocolHistory_implies_HistoricalFullElectionLogCore
    (countedFormationObligation :
      QuorumCandidateFormationOverlapObligation)
    (countedToPotentialFormationObligation :
      CountedCandidateFormationToPotentialOverlapObligation)
    (potentialFormationObligation :
      CountedToPotentialCandidateFormationOverlapObligation)
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    HistoricalFullElectionLogCore start actions state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun actions state =>
        HistoricalFullElectionLogCore start actions state)
      (initial_HistoricalFullElectionLogCore start)
      (by
        intro past current pastHistory core action enabled
        exact
          historicalFullElectionLogCore_append_step
            countedFormationObligation
            countedToPotentialFormationObligation
            potentialFormationObligation
            pastHistory
            core
            action
            enabled)
      history

private theorem historicalFullElectionLogCore_implies_leaderUniqueness
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalFullElectionLogCore start actions state) :
    TemporalLeaderUniquenessInv start actions state := by
  let electionVotes :=
    protocolHistory_implies_HistoricalElectionVoteCore history
  have voteCore : HistoricalVoteCore start actions state :=
    ⟨electionVotes.owner,
      electionVotes.ownerConsistent,
      electionVotes.electionVotes⟩
  exact
    historicalElectionCores_imply_TemporalLeaderUniquenessInv
      history
      voteCore
      (protocolHistory_implies_LeaderHistoryConsistent history)
      (quorumCandidateOverlap_implies_ElectionConfigurationsOverlapInv
        core.counted.candidateOverlap)

theorem protocolHistory_implies_CurrentMatchIndexPrefixHistoryConsistent_of_formationOverlaps
    (countedFormationObligation :
      QuorumCandidateFormationOverlapObligation)
    (countedToPotentialFormationObligation :
      CountedCandidateFormationToPotentialOverlapObligation)
    (potentialFormationObligation :
      CountedToPotentialCandidateFormationOverlapObligation)
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    CurrentMatchIndexPrefixHistoryConsistent start actions state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun actions state =>
        CurrentMatchIndexPrefixHistoryConsistent start actions state)
      (initial_CurrentMatchIndexPrefixHistoryConsistent start)
      (by
        intro past current pastHistory canonical action enabled
        have core :=
          protocolHistory_implies_HistoricalFullElectionLogCore
            countedFormationObligation
            countedToPotentialFormationObligation
            potentialFormationObligation
            pastHistory
        have nextHistory :=
          replays_append_singleton pastHistory enabled
        have nextCore :=
          historicalFullElectionLogCore_append_step
            countedFormationObligation
            countedToPotentialFormationObligation
            potentialFormationObligation
            pastHistory
            core
            action
            enabled
        exact
          currentMatchIndexPrefixHistory_append_step
            pastHistory
            canonical
            core.counted
            (historicalFullElectionLogCore_implies_leaderUniqueness
              pastHistory core)
            (historicalFullElectionLogCore_implies_leaderUniqueness
              nextHistory nextCore)
            (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
              pastHistory)
            enabled)
      history

theorem reachable_hasCurrentMatchIndexPrefixHistory
    (start : InitialConfiguration)
    (countedFormationObligation :
      QuorumCandidateFormationOverlapObligation)
    (countedToPotentialFormationObligation :
      CountedCandidateFormationToPotentialOverlapObligation)
