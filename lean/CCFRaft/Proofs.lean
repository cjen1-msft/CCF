private theorem temporalLogMatching_receive_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (dest source : Node)
    (kind : ReceiveKind)
    (enabled : Enabled state (.receive dest source kind)) :
    TemporalLogMatchingInv
      start
      (actions ++ [.receive dest source kind])
      (next state (.receive dest source kind)) := by
  by_cases noConflict : kind = .appendEntriesNoConflict
  · subst kind
    exact temporalLogMatching_receive_noConflict
      history matching requests dest source enabled
  by_cases conflictAlreadyDone :
      kind = .appendEntriesConflictThenAlreadyDone
  · subst kind
    exact temporalLogMatching_receive_conflictThenAlreadyDone
      history matching dest source enabled
  by_cases conflictNoConflict :
      kind = .appendEntriesConflictThenNoConflict
  · subst kind
    exact temporalLogMatching_receive_conflictThenNoConflict
      history matching requests dest source enabled
  apply temporalLogMatching_receive_of_unchanged_logs
    history matching dest source kind enabled
  exact receive_logs_unchanged_of_not_log_action
    state dest source kind
    noConflict conflictAlreadyDone conflictNoConflict

theorem temporalLogMatching_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (action : Action)
    (fresh :
      ActionAppendTermFreshInHistory
        start actions state action)
    (enabled : Enabled state action) :
    TemporalLogMatchingInv
      start
      (actions ++ [action])
      (next state action) := by
  have queues :=
    protocolHistory_implies_QueueHistoryConsistent history
  have requests :=
    queueHistory_implies_AppendEntriesRequestHistoryConsistent queues
  cases action with
  | timeout candidate =>
      apply temporalLogMatching_append_of_current_prefixes
        history matching (.timeout candidate) enabled
      intro node
      exact
        ⟨(state.log node).length,
          by simp [next, rawNext, nextTimeout]⟩
  | requestVote source dest =>
      apply temporalLogMatching_append_of_current_prefixes
        history matching (.requestVote source dest) enabled
      intro node
      exact
        ⟨(state.log node).length,
          by simp [next, rawNext, nextRequestVote]⟩
  | appendEntries source dest =>
      apply temporalLogMatching_append_of_current_prefixes
        history matching (.appendEntries source dest) enabled
      intro node
      exact
        ⟨(state.log node).length,
          by simp [next, rawNext, nextAppendEntries]⟩
  | becomeLeader leader =>
      apply temporalLogMatching_append_of_current_prefixes
        history matching (.becomeLeader leader) enabled
      intro node
      by_cases nodeIsLeader : node = leader
      · subst node
        exact
          ⟨maxCommittableIndex (state.log leader),
            by
              simp [next, rawNext, nextBecomeLeader,
                committable, logPrefix]⟩
      · exact
          ⟨(state.log node).length,
            by
              simp [next, rawNext, nextBecomeLeader,
                nodeIsLeader]⟩
  | clientRequest leader =>
      have leaderFresh :
          LeaderAppendTermFreshInHistory
            start actions state leader := by
        simpa [ActionAppendTermFreshInHistory] using fresh
      apply temporalLogMatching_append_local_entry
        history matching leaderFresh enabled
        (entry := {
          term := state.currentTerm leader
          content := .entry
        })
      · rfl
      · simp [next, rawNext, nextClientRequest]
      · intro node nodeIsLeader
        simp [next, rawNext, nextClientRequest, nodeIsLeader]
  | signCommittableMessages leader =>
      have leaderFresh :
          LeaderAppendTermFreshInHistory
            start actions state leader := by
        simpa [ActionAppendTermFreshInHistory] using fresh
      apply temporalLogMatching_append_local_entry
        history matching leaderFresh enabled
        (entry := {
          term := state.currentTerm leader
          content := .signature
        })
      · rfl
      · simp [next, rawNext, nextSignCommittableMessages]
      · intro node nodeIsLeader
        simp [next, rawNext, nextSignCommittableMessages,
          nodeIsLeader]
  | changeConfiguration leader configuration =>
      have leaderFresh :
          LeaderAppendTermFreshInHistory
            start actions state leader := by
        simpa [ActionAppendTermFreshInHistory] using fresh
      apply temporalLogMatching_append_local_entry
        history matching leaderFresh enabled
        (entry := {
          term := state.currentTerm leader
          content := .reconfiguration configuration
        })
      · rfl
      · simp [next, rawNext, nextChangeConfiguration]
      · intro node nodeIsLeader
        simp [next, rawNext, nextChangeConfiguration,
          nodeIsLeader]
  | advanceCommitIndex leader =>
      apply temporalLogMatching_append_of_current_prefixes
        history matching (.advanceCommitIndex leader) enabled
      intro node
      exact
        ⟨(state.log node).length,
          by simp [next, rawNext, nextAdvanceCommitIndex]⟩
  | receive dest source kind =>
      exact temporalLogMatching_receive_step
        history matching requests dest source kind enabled

private theorem leaderTermFrontier_extended_leader_of_prefix_origins
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (origins :
      forall node : Node,
        HistoricalLogPrefixOrigin
          start actions state ((next state action).log node))
    (leader : Node)
    (oldLeader :
      state.leadershipState leader = .leader)
    (termEq :
      (next state action).currentTerm leader =
        state.currentTerm leader)
    (lengthLe :
      (state.log leader).length <=
        ((next state action).log leader).length)
    (historicalState : State)
    (stateAt :
      StateAt
        start
        (actions ++ [action])
        (next state action)
        historicalState)
    (node : Node)
    (index : Nat)
    (beyond :
      ((next state action).log leader).length < index) :
    (entryAt? (historicalState.log node) index).map (·.term) ≠
      some ((next state action).currentTerm leader) := by
  have oldBeyond : (state.log leader).length < index :=
    Nat.lt_of_le_of_lt lengthLe beyond
  rw [termEq]
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · exact frontier
      leader oldLeader historicalState oldState node index oldBeyond
  · subst historicalState
    by_cases within :
        index <= ((next state action).log node).length
    · have positive : 1 <= index := by omega
      rcases historicalLogPrefixOrigin_index
          (origins node) index positive within with
        ⟨originState, originNode, originAt, entryEq, _prefixEq,
          _originBound⟩
      rw [entryEq]
      exact frontier
        leader oldLeader originState originAt originNode index oldBeyond
    · rw [entryAt?_eq_none_of_length_lt
        ((next state action).log node)
        index
        (by omega)]
      simp

private theorem leaderTermFrontier_append_of_unchanged_logs
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (oldLeaders :
      forall leader : Node,
        (next state action).leadershipState leader = .leader ->
          state.leadershipState leader = .leader)
    (terms :
      forall leader : Node,
        (next state action).leadershipState leader = .leader ->
          (next state action).currentTerm leader =
            state.currentTerm leader)
    (logs :
      forall node : Node,
        (next state action).log node = state.log node) :
    LeaderTermFrontierInv
      start
      (actions ++ [action])
      (next state action) := by
  intro leader afterLeader
  apply leaderTermFrontier_extended_leader_of_prefix_origins
    history frontier action enabled
    (fun node =>
      historicalLogPrefixOrigin_of_unchanged
        history node (logs node))
    leader
    (oldLeaders leader afterLeader)
    (terms leader afterLeader)
  rw [logs leader]

private theorem leaderTermFrontier_append_local_entry
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (appendingLeader : Node)
    (appendingLeaderState :
      state.leadershipState appendingLeader = .leader)
    (entry : Entry)
    (entryTerm :
      entry.term = state.currentTerm appendingLeader)
    (leadershipStates :
      forall node : Node,
        (next state action).leadershipState node =
          state.leadershipState node)
    (terms :
      forall node : Node,
        (next state action).currentTerm node =
          state.currentTerm node)
    (appendingLog :
      (next state action).log appendingLeader =
        state.log appendingLeader ++ [entry])
    (otherLogs :
      forall node : Node,
        node ≠ appendingLeader ->
          (next state action).log node = state.log node) :
    LeaderTermFrontierInv
      start
      (actions ++ [action])
      (next state action) := by
  intro leader afterLeader historicalState stateAt node index beyond
  have oldLeader :
      state.leadershipState leader = .leader := by
    rw [leadershipStates leader] at afterLeader
    exact afterLeader
  have oldBeyond : (state.log leader).length < index := by
    by_cases leaderIsAppending : leader = appendingLeader
    · subst leader
      rw [appendingLog] at beyond
      simp at beyond
      omega
    · rw [otherLogs leader leaderIsAppending] at beyond
      exact beyond
  rw [terms leader]
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · exact frontier
      leader oldLeader historicalState oldState node index oldBeyond
  · subst historicalState
    by_cases nodeIsAppending : node = appendingLeader
    · subst node
      rw [appendingLog]
      by_cases withinOld : index <= (state.log appendingLeader).length
      · rw [entryAt?_append_eq_of_index_le_length
          (state.log appendingLeader) [entry] index
          (by omega) withinOld]
        exact frontier
          leader oldLeader state
          (protocolHistory_final_stateAt history)
          appendingLeader index oldBeyond
      · by_cases atAppendedIndex :
          index = (state.log appendingLeader).length + 1
        · subst index
          rw [entryAt?_append_singleton_last]
          simp only [Option.map_some, ne_eq]
          have differentLeaders : appendingLeader ≠ leader := by
            intro sameLeader
            subst leader
            rw [appendingLog] at beyond
            simp at beyond
          intro sameTerm
          apply differentLeaders
          exact leaderUniqueness
            state state
            (protocolHistory_final_stateAt history)
            (protocolHistory_final_stateAt history)
            appendingLeader leader
            appendingLeaderState oldLeader
            (entryTerm.symm.trans (Option.some.inj sameTerm))
        · rw [entryAt?_eq_none_of_length_lt
            (state.log appendingLeader ++ [entry])
            index
            (by simp; omega)]
          simp
    · rw [otherLogs node nodeIsAppending]
      exact frontier
        leader oldLeader state
        (protocolHistory_final_stateAt history)
        node index oldBeyond

private theorem historicalCandidateQuorumFresh_entryAt
    {start : InitialConfiguration}
    {actions : List Action}
    {state historicalState : State}
    (fresh :
      HistoricalCandidateQuorumFreshInv start actions state)
    (candidate : Node)
    (candidateState :
      state.leadershipState candidate = .candidate)
    (quorum :
      allConfigurationsHaveQuorum
          (state.votesGranted candidate)
          (state.configurations candidate) =
        true)
    (stateAt :
      StateAt start actions state historicalState)
    (node : Node)
    (index : Nat) :
    (entryAt? (historicalState.log node) index).map (·.term) ≠
      some (state.currentTerm candidate) := by
  cases atIndex : entryAt? (historicalState.log node) index with
  | none =>
      simp
  | some entry =>
      have termFresh :=
        fresh candidate candidateState quorum
          historicalState stateAt node entry
          (entryAt?_mem
            (historicalState.log node) index entry atIndex)
      simp only [Option.map_some, ne_eq]
      intro sameTerm
      rw [Option.some.inj sameTerm] at termFresh
      simp at termFresh

private theorem historicalCandidateQuorumFresh_extended
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (fresh :
      HistoricalCandidateQuorumFreshInv start actions state)
    (candidate : Node)
    (candidateState :
      state.leadershipState candidate = .candidate)
    (quorum :
      allConfigurationsHaveQuorum
          (state.votesGranted candidate)
          (state.configurations candidate) =
        true)
    (action : Action)
    (enabled : Enabled state action)
    (origins :
      forall node : Node,
        HistoricalLogPrefixOrigin
          start actions state ((next state action).log node))
    (termEq :
      (next state action).currentTerm candidate =
        state.currentTerm candidate)
    (historicalState : State)
    (stateAt :
      StateAt
        start
        (actions ++ [action])
        (next state action)
        historicalState)
    (node : Node)
    (index : Nat) :
    (entryAt? (historicalState.log node) index).map (·.term) ≠
      some ((next state action).currentTerm candidate) := by
  rw [termEq]
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · exact historicalCandidateQuorumFresh_entryAt
      fresh candidate candidateState quorum oldState node index
  · subst historicalState
    by_cases indexZero : index = 0
    · subst index
      simp [entryAt?]
    · have positive : 1 <= index := by omega
      by_cases within :
          index <= ((next state action).log node).length
      · rcases historicalLogPrefixOrigin_index
            (origins node) index positive within with
          ⟨originState, originNode, originAt, entryEq, _prefixEq,
            _originBound⟩
        rw [entryEq]
        exact historicalCandidateQuorumFresh_entryAt
          fresh candidate candidateState quorum
          originAt originNode index
      · rw [entryAt?_eq_none_of_length_lt
          ((next state action).log node)
          index
          (by omega)]
        simp

private theorem aeSend_log_respects_leader_frontier
    {start : InitialConfiguration}
    {actions : List Action}
    {state sendState : State}
    {source dest leader : Node}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (occurrence :
      Occurs
        start actions state sendState
        (.appendEntries source dest))
    (oldLeader :
      state.leadershipState leader = .leader)
    (index : Nat)
    (beyond : (state.log leader).length < index) :
    (entryAt? (sendState.log source) index).map (·.term) ≠
      some (state.currentTerm leader) := by
  have sendStateAt := occurs_before_stateAt occurrence
  rcases occurrence with ⟨sendOccurrence⟩
  have sendEnabled := sendOccurrence.enabled
  simp [Enabled, actionEnabled] at sendEnabled
  have sendLeader :
      sendState.leadershipState source = .leader :=
    sendEnabled.1.1.2
  by_cases sameTerm :
      sendState.currentTerm source = state.currentTerm leader
  · have sameLeader := leaderUniqueness
      sendState state
      sendStateAt
      (protocolHistory_final_stateAt history)
      source leader
      sendLeader oldLeader sameTerm
    rw [sameLeader]
    exact frontier
      leader oldLeader sendState sendStateAt leader index beyond
  · exact frontier
      leader oldLeader sendState sendStateAt source index beyond

private theorem leaderTermFrontier_append_follower_replication
    {start : InitialConfiguration}
    {actions : List Action}
    {state sendState : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (dest source : Node)
    (occurrence :
      Occurs
        start actions state sendState
        (.appendEntries source dest))
    (replicationCount : Nat)
    (replicatedLog :
      (next state action).log dest =
        (sendState.log source).take replicationCount)
    (oldLeaders :
      forall leader : Node,
        (next state action).leadershipState leader = .leader ->
          state.leadershipState leader = .leader)
    (leaderNotDest :
      forall leader : Node,
        (next state action).leadershipState leader = .leader ->
          leader ≠ dest)
    (terms :
      forall leader : Node,
        (next state action).leadershipState leader = .leader ->
          (next state action).currentTerm leader =
            state.currentTerm leader)
    (otherLogs :
      forall node : Node,
        node ≠ dest ->
          (next state action).log node = state.log node) :
    LeaderTermFrontierInv
      start
      (actions ++ [action])
      (next state action) := by
  intro leader afterLeader historicalState stateAt node index beyond
  have oldLeader := oldLeaders leader afterLeader
  have leaderIsNotDest := leaderNotDest leader afterLeader
  have oldBeyond : (state.log leader).length < index := by
    rw [otherLogs leader leaderIsNotDest] at beyond
    exact beyond
  rw [terms leader afterLeader]
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · exact frontier
      leader oldLeader historicalState oldState node index oldBeyond
  · subst historicalState
    by_cases nodeIsDest : node = dest
    · subst node
      by_cases within :
          index <= ((next state action).log dest).length
      · have positive : 1 <= index := by omega
        have withinTake :
            index <=
              ((sendState.log source).take replicationCount).length := by
          rw [← replicatedLog]
          exact within
        have entryEq :
            entryAt? ((next state action).log dest) index =
              entryAt? (sendState.log source) index :=
          (congrArg (fun entries => entryAt? entries index)
              replicatedLog).trans
            (entryAt?_take_eq_of_index_le_length
              (sendState.log source)
              replicationCount index positive withinTake)
        rw [entryEq]
        exact aeSend_log_respects_leader_frontier
          history frontier leaderUniqueness occurrence
          oldLeader index oldBeyond
      · rw [entryAt?_eq_none_of_length_lt
          ((next state action).log dest)
          index
          (by omega)]
        simp
    · rw [otherLogs node nodeIsDest]
      exact frontier
        leader oldLeader state
        (protocolHistory_final_stateAt history)
        node index oldBeyond

private theorem leaderTermFrontier_receive_unchanged_logs
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (dest source : Node)
    (kind : ReceiveKind)
    (enabled : Enabled state (.receive dest source kind))
    (logs :
      forall node : Node,
        (next state (.receive dest source kind)).log node =
          state.log node) :
    LeaderTermFrontierInv
      start
      (actions ++ [.receive dest source kind])
      (next state (.receive dest source kind)) := by
  apply leaderTermFrontier_append_of_unchanged_logs
    history frontier (.receive dest source kind) enabled
  · intro leader afterLeader
    exact leader_before_of_leader_after
      state (.receive dest source kind) leader afterLeader
      (by intro elected; simp)
  · intro leader afterLeader
    cases hmessage : headMessage? state dest source with
    | none =>
        simp [next, rawNext, nextReceive, hmessage]
    | some message =>
        cases kind with
        | updateTerm =>
            by_cases leaderIsDest : leader = dest
            · subst leader
              cases roleEq : state.leadershipState dest <;>
                simp [next, rawNext, nextReceive, hmessage, updateNode,
                  roleEq] at afterLeader
            · simp [next, rawNext, nextReceive, hmessage, updateNode,
                leaderIsDest]
        | _ =>
            cases hbody : message.body <;>
              simp [next, rawNext, nextReceive, hmessage, hbody,
                nextAppendEntriesAlreadyDone,
                nextAppendEntriesNoConflict, conflictRollback]
            all_goals
              split <;> rfl
  · exact logs

private theorem leaderTermFrontier_receive_noConflict
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (dest source : Node)
    (enabled :
      Enabled state
        (.receive dest source .appendEntriesNoConflict)) :
    LeaderTermFrontierInv
      start
      (actions ++
        [.receive dest source .appendEntriesNoConflict])
      (next state
        (.receive dest source .appendEntriesNoConflict)) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [Enabled, actionEnabled, hmessage] at enabled
  | some message =>
      cases hbody : message.body with
      | appendEntriesRequest previousIndex previousTerm entries
          leaderCommitIndex =>
          have queued :=
            headMessage?_mem state dest source message hmessage
          have provenance :
              MessageHasAESendWitness
                start actions state dest source message := by
            simpa [hbody] using requests dest source message queued
          rcases provenance with ⟨witness⟩
          rcases witness with ⟨sendState, occurrence, messageEq⟩
          subst message
          have branchEnabled := enabled
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at branchEnabled
          simp [appendEntriesMessage] at hbody
          rcases hbody with
            ⟨previousIndexEq, previousTermEq,
              entriesEq, leaderCommitIndexEq⟩
          subst previousIndex
          subst previousTerm
          subst entries
          subst leaderCommitIndex
          have acceptFacts := branchEnabled.2.2.1
          simp [appendEntriesAcceptBase] at acceptFacts
          have noConflictFacts := branchEnabled.2.2.2
          simp [appendEntriesNoConflictGuard] at noConflictFacts
          have sendFacts :=
            appendEntriesMessage_prefix_eq
              history occurrence matching
              branchEnabled.2.2.1
              noConflictFacts.1.1.1
          apply leaderTermFrontier_append_follower_replication
            history frontier leaderUniqueness
            (.receive dest source .appendEntriesNoConflict)
            enabled dest source occurrence
            (sendState.sentIndex source dest + 1)
          · simpa [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage] using
              appendEntriesMessage_result_log_eq
                sendState state source dest sendFacts.2
          · intro leader afterLeader
            exact leader_before_of_leader_after
              state
              (.receive dest source .appendEntriesNoConflict)
              leader afterLeader
              (by intro elected; simp)
          · intro leader afterLeader
            have oldLeader := leader_before_of_leader_after
              state
              (.receive dest source .appendEntriesNoConflict)
              leader afterLeader
              (by intro elected; simp)
            intro leaderIsDest
            subst leader
            rcases acceptFacts.1.1.2 with follower | none
            · have destFollower :
                  state.leadershipState dest = .follower := by
                simpa [appendEntriesMessage] using follower
              rw [destFollower] at oldLeader
              contradiction
            · have destNone :
                  state.leadershipState dest = .none := by
                simpa [appendEntriesMessage] using none
              rw [destNone] at oldLeader
              contradiction
          · intro leader _afterLeader
            simp [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage, nextAppendEntriesNoConflict]
          · intro node nodeIsDest
            simp [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage, nextAppendEntriesNoConflict,
              nodeIsDest]
      | _ =>
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at enabled

private theorem leaderTermFrontier_receive_conflictThenNoConflict
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (dest source : Node)
    (enabled :
      Enabled state
        (.receive dest source
          .appendEntriesConflictThenNoConflict)) :
    LeaderTermFrontierInv
      start
      (actions ++
        [.receive dest source
          .appendEntriesConflictThenNoConflict])
      (next state
        (.receive dest source
          .appendEntriesConflictThenNoConflict)) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [Enabled, actionEnabled, hmessage] at enabled
  | some message =>
      cases hbody : message.body with
      | appendEntriesRequest previousIndex previousTerm entries
          leaderCommitIndex =>
          have queued :=
            headMessage?_mem state dest source message hmessage
          have provenance :
              MessageHasAESendWitness
                start actions state dest source message := by
            simpa [hbody] using requests dest source message queued
          rcases provenance with ⟨witness⟩
          rcases witness with ⟨sendState, occurrence, messageEq⟩
          subst message
          have branchEnabled := enabled
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at branchEnabled
          simp [appendEntriesMessage] at hbody
          rcases hbody with
            ⟨previousIndexEq, previousTermEq,
              entriesEq, leaderCommitIndexEq⟩
          subst previousIndex
          subst previousTerm
          subst entries
          subst leaderCommitIndex
          have acceptFacts := branchEnabled.2.2.1.1
          simp [appendEntriesAcceptBase] at acceptFacts
          have noConflictFacts := branchEnabled.2.2.2
          simp [appendEntriesNoConflictGuard] at noConflictFacts
          have sendFacts :=
            appendEntriesMessage_prefix_eq
              history occurrence matching
              branchEnabled.2.2.1.1
              noConflictFacts.1.1.1
          have rolledPrefixEq :
              logPrefix
                  ((conflictRollback
                    state dest
                    (sendState.sentIndex source dest)).log dest)
                  (sendState.sentIndex source dest) =
                logPrefix
                  (sendState.log source)
                  (sendState.sentIndex source dest) := by
            simpa [conflictRollback, logPrefix,
              List.take_take] using sendFacts.2
          apply leaderTermFrontier_append_follower_replication
            history frontier leaderUniqueness
            (.receive dest source
              .appendEntriesConflictThenNoConflict)
            enabled dest source occurrence
            (sendState.sentIndex source dest + 1)
          · simpa [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage] using
              appendEntriesMessage_result_log_eq
                sendState
                (conflictRollback
                  state dest
                  (sendState.sentIndex source dest))
                source dest rolledPrefixEq
          · intro leader afterLeader
            exact leader_before_of_leader_after
              state
              (.receive dest source
                .appendEntriesConflictThenNoConflict)
              leader afterLeader
              (by intro elected; simp)
          · intro leader afterLeader
            have oldLeader := leader_before_of_leader_after
              state
              (.receive dest source
                .appendEntriesConflictThenNoConflict)
              leader afterLeader
              (by intro elected; simp)
            intro leaderIsDest
            subst leader
            rcases acceptFacts.1.1.2 with follower | none
            · have destFollower :
                  state.leadershipState dest = .follower := by
                simpa [appendEntriesMessage] using follower
              rw [destFollower] at oldLeader
              contradiction
            · have destNone :
                  state.leadershipState dest = .none := by
                simpa [appendEntriesMessage] using none
              rw [destNone] at oldLeader
              contradiction
          · intro leader _afterLeader
            simp [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage, nextAppendEntriesNoConflict,
              conflictRollback]
          · intro node nodeIsDest
            simp [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage, nextAppendEntriesNoConflict,
              conflictRollback, nodeIsDest]
      | _ =>
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at enabled

private theorem leaderTermFrontier_receive_conflictThenAlreadyDone
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (dest source : Node)
    (enabled :
      Enabled state
        (.receive dest source
          .appendEntriesConflictThenAlreadyDone)) :
    LeaderTermFrontierInv
      start
      (actions ++
        [.receive dest source
          .appendEntriesConflictThenAlreadyDone])
      (next state
        (.receive dest source
          .appendEntriesConflictThenAlreadyDone)) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [Enabled, actionEnabled, hmessage] at enabled
  | some message =>
      cases hbody : message.body with
      | appendEntriesRequest previousIndex previousTerm entries
          leaderCommitIndex =>
          have branchEnabled := enabled
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at branchEnabled
          have messageDest : message.dest = dest :=
            branchEnabled.2.1.1
          have acceptFacts := branchEnabled.2.2.1.1
          simp [appendEntriesAcceptBase] at acceptFacts
          have origins :
              forall node : Node,
                HistoricalLogPrefixOrigin
                  start actions state
                  ((next state
                    (.receive dest source
                      .appendEntriesConflictThenAlreadyDone)).log node) := by
            intro node
            by_cases nodeIsDest : node = dest
            · subst node
              apply historicalLogPrefixOrigin_of_prefix
                (protocolHistory_final_stateAt history)
                dest previousIndex
              simp [next, rawNext, nextReceive, hmessage, hbody,
                nextAppendEntriesAlreadyDone, conflictRollback]
            · apply historicalLogPrefixOrigin_of_unchanged
                history node
              simp [next, rawNext, nextReceive, hmessage, hbody,
                nextAppendEntriesAlreadyDone, conflictRollback,
                nodeIsDest]
          intro leader afterLeader
          have oldLeader := leader_before_of_leader_after
            state
            (.receive dest source
              .appendEntriesConflictThenAlreadyDone)
            leader afterLeader
            (by intro elected; simp)
          have leaderIsNotDest : leader ≠ dest := by
            intro leaderIsDest
            subst leader
            rcases acceptFacts.1.1.2 with follower | none
            · have destFollower :
                  state.leadershipState dest = .follower := by
                simpa [messageDest] using follower
              rw [destFollower] at oldLeader
              contradiction
            · have destNone :
                  state.leadershipState dest = .none := by
                simpa [messageDest] using none
              rw [destNone] at oldLeader
              contradiction
          apply leaderTermFrontier_extended_leader_of_prefix_origins
            history frontier
            (.receive dest source
              .appendEntriesConflictThenAlreadyDone)
            enabled origins leader oldLeader
          · simp [next, rawNext, nextReceive, hmessage, hbody,
              nextAppendEntriesAlreadyDone, conflictRollback]
          · simp [next, rawNext, nextReceive, hmessage, hbody,
              nextAppendEntriesAlreadyDone, conflictRollback,
              leaderIsNotDest]
      | _ =>
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at enabled

theorem leaderTermFrontier_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (frontier : LeaderTermFrontierInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (candidateFresh :
      HistoricalCandidateQuorumFreshInv start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    LeaderTermFrontierInv
      start
      (actions ++ [action])
      (next state action) := by
  cases action with
  | timeout candidate =>
      apply leaderTermFrontier_append_of_unchanged_logs
        history frontier (.timeout candidate) enabled
      · intro leader afterLeader
        exact leader_before_of_leader_after
          state (.timeout candidate) leader afterLeader
          (by intro elected; simp)
      · intro leader afterLeader
        by_cases leaderIsCandidate : leader = candidate
        · subst leader
          simp [next, rawNext, nextTimeout, updateNode] at afterLeader
        · simp [next, rawNext, nextTimeout, updateNode,
            leaderIsCandidate]
      · intro node
        simp [next, rawNext, nextTimeout]
  | requestVote source dest =>
      apply leaderTermFrontier_append_of_unchanged_logs
        history frontier (.requestVote source dest) enabled
      · intro leader afterLeader
        simpa [next, rawNext, nextRequestVote] using afterLeader
      · intro leader _afterLeader
        simp [next, rawNext, nextRequestVote]
      · intro node
        simp [next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      apply leaderTermFrontier_append_of_unchanged_logs
        history frontier (.appendEntries source dest) enabled
      · intro leader afterLeader
        simpa [next, rawNext, nextAppendEntries] using afterLeader
      · intro leader _afterLeader
        simp [next, rawNext, nextAppendEntries]
      · intro node
        simp [next, rawNext, nextAppendEntries]
  | becomeLeader elected =>
      have becomeEnabled := enabled
      simp [Enabled, actionEnabled] at becomeEnabled
      have origins :
          forall node : Node,
            HistoricalLogPrefixOrigin
              start actions state
              ((next state (.becomeLeader elected)).log node) := by
        intro node
        by_cases nodeIsElected : node = elected
        · subst node
          apply historicalLogPrefixOrigin_of_prefix
            (protocolHistory_final_stateAt history)
            elected
            (maxCommittableIndex (state.log elected))
          simp [next, rawNext, nextBecomeLeader,
            committable, logPrefix]
        · apply historicalLogPrefixOrigin_of_unchanged
            history node
          simp [next, rawNext, nextBecomeLeader, nodeIsElected]
      intro leader afterLeader historicalState stateAt node index beyond
      by_cases leaderIsElected : leader = elected
      · subst leader
        exact historicalCandidateQuorumFresh_extended
          history candidateFresh elected
          becomeEnabled.1.2 becomeEnabled.2
          (.becomeLeader elected) enabled origins
          (by simp [next, rawNext, nextBecomeLeader])
          historicalState stateAt node index
      · have oldLeader :
            state.leadershipState leader = .leader := by
          simpa [next, rawNext, nextBecomeLeader, updateNode,
            leaderIsElected] using afterLeader
        apply leaderTermFrontier_extended_leader_of_prefix_origins
          history frontier (.becomeLeader elected) enabled origins
          leader oldLeader
          (by simp [next, rawNext, nextBecomeLeader])
          (by
            simp [next, rawNext, nextBecomeLeader, updateNode,
              leaderIsElected])
          historicalState stateAt node index beyond
  | clientRequest leader =>
      have clientEnabled := enabled
      simp [Enabled, actionEnabled] at clientEnabled
      apply leaderTermFrontier_append_local_entry
        history frontier leaderUniqueness
        (.clientRequest leader) enabled leader clientEnabled.1.2
        {
          term := state.currentTerm leader
          content := .entry
        }
      · rfl
      · intro node
        simp [next, rawNext, nextClientRequest]
      · intro node
        simp [next, rawNext, nextClientRequest]
      · simp [next, rawNext, nextClientRequest]
      · intro node nodeIsLeader
        simp [next, rawNext, nextClientRequest, nodeIsLeader]
  | signCommittableMessages leader =>
      have signEnabled := enabled
      simp [Enabled, actionEnabled] at signEnabled
      apply leaderTermFrontier_append_local_entry
        history frontier leaderUniqueness
        (.signCommittableMessages leader) enabled
        leader signEnabled.1.1.2
        {
          term := state.currentTerm leader
          content := .signature
        }
      · rfl
      · intro node
        simp [next, rawNext, nextSignCommittableMessages]
      · intro node
        simp [next, rawNext, nextSignCommittableMessages]
      · simp [next, rawNext, nextSignCommittableMessages]
      · intro node nodeIsLeader
        simp [next, rawNext, nextSignCommittableMessages,
          nodeIsLeader]
  | changeConfiguration leader configuration =>
      have changeEnabled := enabled
      simp [Enabled, actionEnabled] at changeEnabled
      apply leaderTermFrontier_append_local_entry
        history frontier leaderUniqueness
        (.changeConfiguration leader configuration)
        enabled leader changeEnabled.1.1.1.2
        {
          term := state.currentTerm leader
          content := .reconfiguration configuration
        }
      · rfl
      · intro node
        simp [next, rawNext, nextChangeConfiguration]
      · intro node
        simp [next, rawNext, nextChangeConfiguration]
      · simp [next, rawNext, nextChangeConfiguration]
      · intro node nodeIsLeader
        simp [next, rawNext, nextChangeConfiguration,
          nodeIsLeader]
  | advanceCommitIndex leader =>
      apply leaderTermFrontier_append_of_unchanged_logs
        history frontier (.advanceCommitIndex leader) enabled
      · intro currentLeader afterLeader
        exact leader_before_of_leader_after
          state (.advanceCommitIndex leader)
          currentLeader afterLeader
          (by intro elected; simp)
      · intro currentLeader _afterLeader
        simp [next, rawNext, nextAdvanceCommitIndex]
      · intro node
        simp [next, rawNext, nextAdvanceCommitIndex]
  | receive dest source kind =>
      by_cases noConflict : kind = .appendEntriesNoConflict
      · subst kind
        exact leaderTermFrontier_receive_noConflict
          history frontier leaderUniqueness matching requests
          dest source enabled
      by_cases conflictAlreadyDone :
          kind = .appendEntriesConflictThenAlreadyDone
      · subst kind
        exact leaderTermFrontier_receive_conflictThenAlreadyDone
          history frontier dest source enabled
      by_cases conflictNoConflict :
          kind = .appendEntriesConflictThenNoConflict
      · subst kind
        exact leaderTermFrontier_receive_conflictThenNoConflict
          history frontier leaderUniqueness matching requests
          dest source enabled
      apply leaderTermFrontier_receive_unchanged_logs
        history frontier dest source kind enabled
      exact receive_logs_unchanged_of_not_log_action
        state dest source kind
        noConflict conflictAlreadyDone conflictNoConflict

theorem neverCommitEntryPrevTerms_step
    (state : State)
    (action : Action)
    (enabled : Enabled state action) :
    NeverCommitEntryPrevTermsProp state (next state action) := by
  intro leader leaderState commitAdvanced
  cases action with
  | timeout candidate =>
      simp [next, rawNext, nextTimeout] at commitAdvanced
  | requestVote source dest =>
      simp [next, rawNext, nextRequestVote] at commitAdvanced
  | appendEntries source dest =>
      simp [next, rawNext, nextAppendEntries] at commitAdvanced
  | becomeLeader elected =>
      simp [next, rawNext, nextBecomeLeader] at commitAdvanced
  | clientRequest primary =>
      simp [next, rawNext, nextClientRequest] at commitAdvanced
  | signCommittableMessages primary =>
      simp [next, rawNext, nextSignCommittableMessages] at commitAdvanced
  | changeConfiguration primary configuration =>
      simp [next, rawNext, nextChangeConfiguration] at commitAdvanced
  | advanceCommitIndex primary =>
      by_cases sameLeader : leader = primary
      · subst leader
        have commitAdvancedToHighest := commitAdvanced
        simp [next, rawNext, nextAdvanceCommitIndex] at commitAdvancedToHighest
        have highestPositive :
            0 < highestCommittableIndex state primary := by
          exact Nat.lt_of_le_of_lt
            (Nat.zero_le (state.commitIndex primary))
            commitAdvancedToHighest
        rcases
          highestCommittableIndex_signature_or_zero state primary with
          highestZero | ⟨entry, atHighest, currentTerm, signature⟩
        · omega
        · simpa [next, rawNext, nextAdvanceCommitIndex] using
            ⟨entry, atHighest, currentTerm⟩
      · simp [next, rawNext, nextAdvanceCommitIndex, sameLeader] at commitAdvanced
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [next, rawNext, nextReceive, hmessage] at commitAdvanced
      | some message =>
          cases kind <;>
            cases hbody : message.body <;>
              simp_all [next, rawNext, nextReceive, Enabled,
                actionEnabled, receiveBranchEnabled,
                appendEntriesAcceptBase, nextAppendEntriesAlreadyDone,
                nextAppendEntriesNoConflict, conflictRollback]
          all_goals
            split <;> simp_all
          all_goals
            rw [enabled.2.1.1] at *
            simp_all

theorem signature_step
    (state : State)
    (action : Action)
    (signatures : SignatureInv state)
    (enabled : Enabled state action) :
    SignatureInv (next state action) := by
  cases action with
  | timeout candidate =>
      simpa [SignatureInv, next, rawNext, nextTimeout] using signatures
  | requestVote source dest =>
      simpa [SignatureInv, next, rawNext, nextRequestVote] using signatures
  | appendEntries source dest =>
      simpa [SignatureInv, next, rawNext, nextAppendEntries] using signatures
  | becomeLeader leader =>
      intro node positive
      by_cases nodeIsLeader : node = leader
      · subst node
        have oldSignature := signatures leader positive
        have commitWithin :
            state.commitIndex leader <=
              maxCommittableIndex (state.log leader) :=
          index_le_maxCommittableIndex_of_signature
            (state.log leader)
            (state.commitIndex leader)
            oldSignature
        simpa [next, rawNext, nextBecomeLeader] using
          signature_preserved_by_take
            (state.log leader)
            (maxCommittableIndex (state.log leader))
            (state.commitIndex leader)
            oldSignature
            commitWithin
      · simpa [next, rawNext, nextBecomeLeader, nodeIsLeader] using
          signatures node positive
  | clientRequest leader =>
      intro node positive
      by_cases nodeIsLeader : node = leader
      · subst node
        simpa [next, rawNext, nextClientRequest] using
          signature_preserved_by_append
            (state.log leader)
            [{ term := state.currentTerm leader, content := .entry }]
            (state.commitIndex leader)
            (signatures leader positive)
      · simpa [next, rawNext, nextClientRequest, nodeIsLeader] using
          signatures node positive
  | signCommittableMessages leader =>
      intro node positive
      by_cases nodeIsLeader : node = leader
      · subst node
        simpa [next, rawNext, nextSignCommittableMessages] using
          signature_preserved_by_append
            (state.log leader)
            [{ term := state.currentTerm leader, content := .signature }]
            (state.commitIndex leader)
            (signatures leader positive)
      · simpa [next, rawNext, nextSignCommittableMessages,
          nodeIsLeader] using signatures node positive
  | changeConfiguration leader configuration =>
      intro node positive
      by_cases nodeIsLeader : node = leader
      · subst node
        simpa [next, rawNext, nextChangeConfiguration] using
          signature_preserved_by_append
            (state.log leader)
            [{
              term := state.currentTerm leader
              content := .reconfiguration configuration
            }]
            (state.commitIndex leader)
            (signatures leader positive)
      · simpa [next, rawNext, nextChangeConfiguration, nodeIsLeader] using
          signatures node positive
  | advanceCommitIndex leader =>
      intro node positive
      by_cases nodeIsLeader : node = leader
      · subst node
        rcases highestCommittableIndex_signature_or_zero state leader with
          highestZero | ⟨entry, atHighest, currentTerm, signature⟩
        · simp [next, rawNext, nextAdvanceCommitIndex, highestZero] at positive
        · simp [next, rawNext, nextAdvanceCommitIndex, atHighest, signature]
      · have oldPositive : state.commitIndex node > 0 := by
          simpa [next, rawNext, nextAdvanceCommitIndex, nodeIsLeader] using
            positive
        simpa [next, rawNext, nextAdvanceCommitIndex, nodeIsLeader] using
          signatures node oldPositive
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [SignatureInv, next, rawNext, nextReceive, hmessage] using
            signatures
      | some message =>
          cases kind with
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  intro node positive
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    have nextPositive :
                        max
                            (maxCommittableIndexAt
                              (state.log message.dest)
                              (min commitIndex
                                (previousIndex + entries.length)))
                            (state.commitIndex message.dest) >
                          0 := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone] using positive
                    have nextSignature :=
                      signature_after_maxCommittableIndexAt
                        (state.log message.dest)
                        (state.commitIndex message.dest)
                        (min commitIndex (previousIndex + entries.length))
                        (signatures message.dest)
                        nextPositive
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone] using nextSignature
                  · have oldPositive : state.commitIndex node > 0 := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone, nodeIsDest] using
                        positive
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, nodeIsDest] using
                      signatures node oldPositive
              | _ =>
                  simpa [SignatureInv, next, rawNext, nextReceive,
                    hmessage, hbody] using signatures
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  let nextLog :=
                    (state.log message.dest).take previousIndex ++ entries
                  have oldSignature :
                      state.commitIndex message.dest > 0 ->
                        (entryAt? nextLog
                          (state.commitIndex message.dest)).map
                            (·.content) =
                          some .signature := by
                    intro oldPositive
                    apply signature_preserved_by_append
                    apply signature_preserved_by_take
                    · exact signatures message.dest oldPositive
                    · exact branchEnabled.2.2.1.2
                  intro node positive
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    have nextPositive :
                        max
                            (maxCommittableIndexAt nextLog
                              (min commitIndex
                                (previousIndex + entries.length)))
                            (state.commitIndex message.dest) >
                          0 := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, nextLog] using positive
                    have nextSignature :=
                      signature_after_maxCommittableIndexAt
                        nextLog
                        (state.commitIndex message.dest)
                        (min commitIndex
                          (previousIndex + entries.length))
                        oldSignature
                        nextPositive
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, nextLog] using nextSignature
                  · have oldPositive : state.commitIndex node > 0 := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, nodeIsDest] using positive
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, nodeIsDest] using
                      signatures node oldPositive
              | _ =>
                  simpa [SignatureInv, next, rawNext, nextReceive,
                    hmessage, hbody] using signatures
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  let rolledLog := (state.log message.dest).take previousIndex
                  have oldSignature :
                      state.commitIndex message.dest > 0 ->
                        (entryAt? rolledLog
                          (state.commitIndex message.dest)).map
                            (·.content) =
                          some .signature := by
                    intro oldPositive
                    apply signature_preserved_by_take
                    · exact signatures message.dest oldPositive
                    · exact branchEnabled.2.2.1.1.2
                  intro node positive
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    have nextPositive :
                        max
                            (maxCommittableIndexAt rolledLog
                              (min commitIndex
                                (previousIndex + entries.length)))
                            (state.commitIndex message.dest) >
                          0 := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone, conflictRollback,
                        rolledLog] using positive
                    have nextSignature :=
                      signature_after_maxCommittableIndexAt
                        rolledLog
                        (state.commitIndex message.dest)
                        (min commitIndex
                          (previousIndex + entries.length))
                        oldSignature
                        nextPositive
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback,
                      rolledLog] using nextSignature
                  · have oldPositive : state.commitIndex node > 0 := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone, conflictRollback,
                        nodeIsDest] using positive
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback,
                      nodeIsDest] using signatures node oldPositive
              | _ =>
                  simpa [SignatureInv, next, rawNext, nextReceive,
                    hmessage, hbody] using signatures
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  let nextLog :=
                    (state.log message.dest).take previousIndex ++ entries
                  have oldSignature :
                      state.commitIndex message.dest > 0 ->
                        (entryAt? nextLog
                          (state.commitIndex message.dest)).map
                            (·.content) =
                          some .signature := by
                    intro oldPositive
                    apply signature_preserved_by_append
                    apply signature_preserved_by_take
                    · exact signatures message.dest oldPositive
                    · exact branchEnabled.2.2.1.1.2
                  intro node positive
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    have nextPositive :
                        max
                            (maxCommittableIndexAt nextLog
                              (min commitIndex
                                (previousIndex + entries.length)))
                            (state.commitIndex message.dest) >
                          0 := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        nextLog, List.take_take] using positive
                    have nextSignature :=
                      signature_after_maxCommittableIndexAt
                        nextLog
                        (state.commitIndex message.dest)
                        (min commitIndex
                          (previousIndex + entries.length))
                        oldSignature
                        nextPositive
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      nextLog, List.take_take] using nextSignature
                  · have oldPositive : state.commitIndex node > 0 := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        nodeIsDest] using positive
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      nodeIsDest] using signatures node oldPositive
              | _ =>
                  simpa [SignatureInv, next, rawNext, nextReceive,
                    hmessage, hbody] using signatures
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      simpa [SignatureInv, next, rawNext, nextReceive,
                        hmessage, hbody, responseCase] using signatures
                  | some response =>
                      simpa [SignatureInv, next, rawNext, nextReceive,
                        hmessage, hbody, responseCase] using signatures
              | _ =>
                  simpa [SignatureInv, next, rawNext, nextReceive,
                    hmessage, hbody] using signatures
          | _ =>
              cases hbody : message.body <;>
                simpa [SignatureInv, next, rawNext, nextReceive, hmessage,
                  hbody] using signatures

theorem monoLog_step
    (state : State)
    (action : Action)
    (monoLog : MonoLogInv state)
    (leaderBoundary : LeaderLogBoundaryInv state)
    (appendSafety : AppendEntriesLogSafetyInv state)
    (enabled : Enabled state action) :
    MonoLogInv (next state action) := by
  cases action with
  | timeout candidate =>
      apply monoLog_of_unchanged_logs state _ monoLog
      · intro node
        rfl
      · intro node
        by_cases nodeIsCandidate : node = candidate
        · subst node
          simp [next, rawNext, nextTimeout]
        · simp [next, rawNext, nextTimeout, nodeIsCandidate]
  | requestVote source dest =>
      apply monoLog_of_unchanged_logs state _ monoLog
      · intro node
        rfl
      · intro node
        simp [next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      apply monoLog_of_unchanged_logs state _ monoLog
      · intro node
        rfl
      · intro node
        simp [next, rawNext, nextAppendEntries]
  | becomeLeader leader =>
      intro node nonempty
      by_cases nodeIsLeader : node = leader
      · subst node
        have oldNonempty : (state.log leader != []) = true := by
          cases logShape : state.log leader with
          | nil =>
              simp [next, rawNext, nextBecomeLeader, committable, logPrefix,
                logShape] at nonempty
              change false = true at nonempty
              exact False.elim (Bool.noConfusion nonempty)
          | cons first rest =>
              rfl
        have oldMono := monoLog leader oldNonempty
        simpa [next, rawNext, nextBecomeLeader, committable, logPrefix] using
          monoLog_take_list
            (state.log leader)
            (state.currentTerm leader)
            (maxCommittableIndex (state.log leader))
            oldMono.1
            oldMono.2
            (by simpa [next, rawNext, nextBecomeLeader] using nonempty)
      · simpa [next, rawNext, nextBecomeLeader, nodeIsLeader] using
          monoLog node (by
            simpa [next, rawNext, nextBecomeLeader, nodeIsLeader] using
              nonempty)
  | clientRequest leader =>
      intro node nonempty
      by_cases nodeIsLeader : node = leader
      · subst node
        simpa [next, rawNext, nextClientRequest] using
          monoLog_append_currentTerm_list
            (state.log leader)
            (state.currentTerm leader)
            .entry
            (monoLog leader)
            (leaderBoundary leader (by
              have clientEnabled := enabled
              simp [Enabled, actionEnabled] at clientEnabled
              exact clientEnabled.1.2))
      · simpa [next, rawNext, nextClientRequest, nodeIsLeader] using
          monoLog node (by
            simpa [next, rawNext, nextClientRequest, nodeIsLeader] using
              nonempty)
  | signCommittableMessages leader =>
      intro node nonempty
      by_cases nodeIsLeader : node = leader
      · subst node
        simpa [next, rawNext, nextSignCommittableMessages] using
          monoLog_append_currentTerm_list
            (state.log leader)
            (state.currentTerm leader)
            .signature
            (monoLog leader)
            (leaderBoundary leader (by
              have signEnabled := enabled
              simp [Enabled, actionEnabled] at signEnabled
              exact signEnabled.1.1.2))
      · simpa [next, rawNext, nextSignCommittableMessages,
          nodeIsLeader] using
          monoLog node (by
            simpa [next, rawNext, nextSignCommittableMessages,
              nodeIsLeader] using nonempty)
  | changeConfiguration leader configuration =>
      intro node nonempty
      by_cases nodeIsLeader : node = leader
      · subst node
        simpa [next, rawNext, nextChangeConfiguration] using
          monoLog_append_currentTerm_list
            (state.log leader)
            (state.currentTerm leader)
            (.reconfiguration configuration)
            (monoLog leader)
            (leaderBoundary leader (by
              have changeEnabled := enabled
              simp [Enabled, actionEnabled] at changeEnabled
              exact changeEnabled.1.1.1.2))
      · simpa [next, rawNext, nextChangeConfiguration, nodeIsLeader] using
          monoLog node (by
            simpa [next, rawNext, nextChangeConfiguration,
              nodeIsLeader] using nonempty)
  | advanceCommitIndex leader =>
      apply monoLog_of_unchanged_logs state _ monoLog
      · intro node
        rfl
      · intro node
        simp [next, rawNext, nextAdvanceCommitIndex]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [MonoLogInv, next, rawNext, nextReceive, hmessage] using
            monoLog
      | some message =>
          have messageQueued :=
            headMessage?_mem state dest source message hmessage
          cases kind with
          | updateTerm =>
              apply monoLog_of_unchanged_logs state _ monoLog
              · intro node
                simp [next, rawNext, nextReceive, hmessage]
              · intro node
                have updateEnabled := enabled
                simp [Enabled, actionEnabled, hmessage,
                  receiveBranchEnabled, updateTermEnabled] at updateEnabled
                by_cases nodeIsDest : node = dest
                · subst node
                  simpa [next, rawNext, nextReceive, hmessage,
                    updateEnabled.2.1.1] using Nat.le_of_lt updateEnabled.2.2
                · simp [next, rawNext, nextReceive, hmessage, nodeIsDest]
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have safety :=
                    appendSafety dest source message messageQueued
                  simp [hbody] at safety
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  intro node nonempty
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    have targetNonempty :
                        State.log
                              (nextAppendEntriesNoConflict
                                state message previousIndex entries commitIndex)
                              message.dest != [] := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody] using
                        nonempty
                    simpa [next, rawNext, nextReceive, hmessage, hbody] using
                      safety.1
                        branchEnabled.2.2.1
                        branchEnabled.2.2.2
                        targetNonempty
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, nodeIsDest] using
                      monoLog node (by
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, nodeIsDest] using
                          nonempty)
              | _ =>
                  simpa [MonoLogInv, next, rawNext, nextReceive, hmessage,
                    hbody] using monoLog
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  intro node nonempty
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    have oldNonempty :
                        (state.log message.dest != []) = true := by
                      cases logShape : state.log message.dest with
                      | nil =>
                          simp [next, rawNext, nextReceive, hmessage, hbody,
                            nextAppendEntriesAlreadyDone, conflictRollback,
                            logShape] at nonempty
                          change false = true at nonempty
                          exact False.elim (Bool.noConfusion nonempty)
                      | cons first rest =>
                          rfl
                    have oldMono := monoLog message.dest oldNonempty
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback] using
                      monoLog_take_list
                        (state.log message.dest)
                        (state.currentTerm message.dest)
                        previousIndex
                        oldMono.1
                        oldMono.2
                        (by
                          simpa [next, rawNext, nextReceive, hmessage, hbody,
                            nextAppendEntriesAlreadyDone,
                            conflictRollback] using nonempty)
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback,
                      nodeIsDest] using
                      monoLog node (by
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone, conflictRollback,
                          nodeIsDest] using nonempty)
              | _ =>
                  simpa [MonoLogInv, next, rawNext, nextReceive, hmessage,
                    hbody] using monoLog
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have safety :=
                    appendSafety dest source message messageQueued
                  simp [hbody] at safety
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  intro node nonempty
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    have targetNonempty :
                        State.log
                              (nextAppendEntriesNoConflict
                                (conflictRollback
                                  state message.dest previousIndex)
                                message previousIndex entries commitIndex)
                              message.dest != [] := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody] using
                        nonempty
                    simpa [next, rawNext, nextReceive, hmessage, hbody] using
                      safety.2
                        branchEnabled.2.2.1.1
                        branchEnabled.2.2.1.2
                        branchEnabled.2.2.2
                        targetNonempty
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      nodeIsDest] using
                      monoLog node (by
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, conflictRollback,
                          nodeIsDest] using nonempty)
              | _ =>
                  simpa [MonoLogInv, next, rawNext, nextReceive, hmessage,
                    hbody] using monoLog
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      simpa [MonoLogInv, next, rawNext, nextReceive,
                        hmessage, hbody, responseCase] using monoLog
                  | some response =>
                      simpa [MonoLogInv, next, rawNext, nextReceive,
                        hmessage, hbody, responseCase] using monoLog
              | _ =>
                  simpa [MonoLogInv, next, rawNext, nextReceive, hmessage,
                    hbody] using monoLog
          | _ =>
              cases hbody : message.body <;>
                simpa [MonoLogInv, next, rawNext, nextReceive, hmessage,
                  hbody] using monoLog

theorem historicalMonoLog_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (historicalMono :
      HistoricalMonoLogInv start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (leaderBoundary : LeaderLogBoundaryInv state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalMonoLogInv
      start
      (actions ++ [action])
      (next state action) := by
  have queues :=
    protocolHistory_implies_QueueHistoryConsistent history
  have requests :=
    queueHistory_implies_AppendEntriesRequestHistoryConsistent queues
  have appendSafety :=
    protocolHistory_implies_AppendEntriesLogSafetyInv
      history requests historicalMono matching
  have currentMono :=
    historicalMonoLog_current history historicalMono
  have nextMono :=
    monoLog_step
      state action currentMono leaderBoundary appendSafety enabled
  intro historicalState stateAt
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · exact historicalMono historicalState oldState
  · rw [finalState]
    exact nextMono

theorem historicalLogCore_append_step
    (obligation : HistoricalAppendTermFreshObligation)
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalLogCore start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalLogCore
      start
      (actions ++ [action])
      (next state action) :=
  {
    monoLogs :=
      historicalMonoLog_append_step
        history
        core.monoLogs
        core.logMatching
        core.leaderBoundary
        action
        enabled
    logMatching :=
      temporalLogMatching_append_step
        history
        core.logMatching
        action
        (obligation start actions state action history enabled)
        enabled
    leaderBoundary :=
      leaderLogBoundary_step
        state action core.leaderBoundary enabled
  }

theorem reachable_hasHistoricalLogCore
    (start : InitialConfiguration)
    (obligation : HistoricalAppendTermFreshObligation)
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (HistoricalLogCore start actions state) := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := fun current =>
        Exists fun actions =>
          And
            (ProtocolHistory start actions current)
            (HistoricalLogCore start actions current))
  · exact
      ⟨[],
        rfl,
        initial_HistoricalLogCore start⟩
  · intro current action historical enabled
    rcases historical with ⟨actions, history, core⟩
    exact
      ⟨actions ++ ([action] : List Action),
        replays_append_singleton history enabled,
        historicalLogCore_append_step
          obligation history core action enabled⟩
  · exact reachable

theorem reachable_MonoLogInv
    (start : InitialConfiguration)
    (obligation : HistoricalAppendTermFreshObligation)
    {state : State}
    (reachable : Reachable start state) :
    MonoLogInv state := by
  rcases reachable_hasHistoricalLogCore
      start obligation reachable with
    ⟨actions, history, core⟩
  exact historicalMonoLog_current history core.monoLogs

theorem reachable_LogMatchingInv
    (start : InitialConfiguration)
    (obligation : HistoricalAppendTermFreshObligation)
    {state : State}
    (reachable : Reachable start state) :
    LogMatchingInv state := by
  rcases reachable_hasHistoricalLogCore
      start obligation reachable with
    ⟨actions, history, core⟩
  exact temporalLogMatching_current history core.logMatching

theorem commitIndex_le_log_length
    (state : State)
    (signatures : SignatureInv state)
    (node : Node) :
    state.commitIndex node <= (state.log node).length := by
  by_cases zeroCommit : state.commitIndex node = 0
  · omega
  · have positive : state.commitIndex node > 0 := by omega
    have signature := signatures node positive
    cases atCommit : entryAt? (state.log node) (state.commitIndex node) with
    | none =>
        simp [atCommit] at signature
    | some entry =>
        unfold entryAt? at atCommit
        split at atCommit
        · contradiction
        · have beforeLength :
              state.commitIndex node - 1 < (state.log node).length :=
            (List.getElem?_eq_some_iff.mp atCommit).choose
          omega

private theorem configurationsToIndex_getLast?_eq_of_greatest
    (configurations : List ConfigurationAt)
    (index : Nat)
    (selected : ConfigurationAt)
    (increasing : increasingConfigurationIndices configurations)
    (selectedMember : selected ∈ configurations)
    (selectedWithin : selected.index <= index)
    (greatest :
      forall configuration,
        configuration ∈ configurations ->
        configuration.index <= index ->
          configuration.index <= selected.index) :
    (configurationsToIndex configurations index).getLast? =
      some selected := by
  induction configurations with
  | nil =>
      simp at selectedMember
  | cons head tail inductionHypothesis =>
      rw [increasingConfigurationIndices, List.pairwise_cons] at increasing
      simp only [List.mem_cons] at selectedMember
      rcases selectedMember with selectedIsHead | selectedInTail
      · subst head
        have filteredTailEmpty :
            configurationsToIndex tail index = [] := by
          apply List.filter_eq_nil_iff.2
          intro configuration member
          have afterSelected := increasing.1 configuration member
          simp only [decide_eq_true_eq]
          intro within
          have beforeSelected :=
            greatest configuration (by simp [member]) within
          omega
        change
          List.filter
              (fun configuration => decide (configuration.index <= index))
              tail =
            [] at filteredTailEmpty
        simp [configurationsToIndex, selectedWithin, filteredTailEmpty]
      · have tailLast :
            (configurationsToIndex tail index).getLast? =
              some selected := by
          apply inductionHypothesis increasing.2 selectedInTail
          intro configuration member within
          exact greatest configuration (by simp [member]) within
        change
          (List.filter
            (fun configuration => decide (configuration.index <= index))
            tail).getLast? =
            some selected at tailLast
        rcases List.getLast?_eq_some_iff.mp tailLast with
          ⟨preceding, tailShape⟩
        by_cases headWithin : head.index <= index
        · apply List.getLast?_eq_some_iff.mpr
          refine ⟨head :: preceding, ?_⟩
          simp [configurationsToIndex, headWithin, tailShape]
        · apply List.getLast?_eq_some_iff.mpr
          refine ⟨preceding, ?_⟩
          simp [configurationsToIndex, headWithin, tailShape]

private theorem fold_reconfigurations_eq_some
    (entries : List Entry)
    (selected : ConfigurationAt)
    (count : Nat)
    (initial : Option Configuration)
    (selectedPositive : 0 < selected.index)
    (selectedWithin : selected.index <= count)
    (selectedAt :
      logReconfigurationAt? entries selected.index =
        some selected.nodes)
    (noneAfter :
      forall index,
        selected.index < index ->
        index <= count ->
          logReconfigurationAt? entries index = none) :
    ((List.range count).map Nat.succ).foldl
        (fun result index =>
          match logReconfigurationAt? entries index with
          | some configuration => some configuration
          | none => result)
        initial =
      some selected.nodes := by
  induction count generalizing initial with
  | zero =>
      omega
  | succ count inductionHypothesis =>
      rw [List.range_succ, List.map_append, List.foldl_append]
      simp only [List.map_singleton, List.foldl_cons, List.foldl_nil]
      by_cases selectedIsLast : selected.index = count + 1
      · have selectedIsSucc : selected.index = count.succ := by
          omega
        rw [← selectedIsSucc, selectedAt]
      · have selectedWithinPrefix : selected.index <= count := by
          omega
        rw [inductionHypothesis
          initial
          selectedWithinPrefix
          (fun index afterSelected within =>
            noneAfter index afterSelected (by omega))]
        have lastIsAfter : selected.index < count + 1 := by
          omega
        rw [noneAfter (count + 1) lastIsAfter (Nat.le_refl _)]

private theorem fold_reconfigurations_eq_none
    (entries : List Entry)
    (count : Nat)
    (initial : Option Configuration)
    (noneWithin :
      forall index,
        0 < index ->
        index <= count ->
          logReconfigurationAt? entries index = none) :
    ((List.range count).map Nat.succ).foldl
        (fun result index =>
          match logReconfigurationAt? entries index with
          | some configuration => some configuration
          | none => result)
        initial =
      initial := by
  induction count generalizing initial with
  | zero =>
      simp
  | succ count inductionHypothesis =>
      rw [List.range_succ, List.map_append, List.foldl_append]
      simp only [List.map_singleton, List.foldl_cons, List.foldl_nil]
      rw [inductionHypothesis
        initial
        (fun index positive within =>
          noneWithin index positive (by omega))]
      rw [noneWithin (count + 1) (by omega) (Nat.le_refl _)]

private theorem configurationAt?_configurationsInEntriesAux_before_projection
    (firstIndex : Nat)
    (entries : List Entry)
    (offset : Nat) :
    configurationAt?
        (configurationsInEntriesAux firstIndex entries)
        (firstIndex + offset) =
      match entries[offset]? with
      | some entry =>
          match entry.content with
          | .reconfiguration configuration => some configuration
          | _ => none
      | none => none := by
  induction entries generalizing firstIndex offset with
  | nil =>
      simp [configurationsInEntriesAux, configurationAt?]
  | cons entry rest inductionHypothesis =>
      cases offset with
      | zero =>
          cases content : entry.content with
          | entry =>
              simp [configurationsInEntriesAux, configurationAt?, content]
              intro configuration member sameIndex
              have bounds :=
                mem_configurationsInEntriesAux
                  (firstIndex + 1) rest configuration member
              omega
          | signature =>
              simp [configurationsInEntriesAux, configurationAt?, content]
              intro configuration member sameIndex
              have bounds :=
                mem_configurationsInEntriesAux
                  (firstIndex + 1) rest configuration member
              omega
          | reconfiguration configuration =>
              simp [configurationsInEntriesAux, configurationAt?, content]
      | succ offset =>
          cases content : entry.content <;>
            simp [configurationsInEntriesAux, configurationAt?, content]
          all_goals
            simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
              inductionHypothesis (firstIndex + 1) offset

private theorem logConfigurations_lookup_eq_logReconfigurationAt?
    (entries : List Entry)
    (index : Nat) :
    configurationAt? (logConfigurations entries) index =
      logReconfigurationAt? entries index := by
  cases index with
  | zero =>
      simp [logConfigurations, configurationsInEntries,
        configurationAt?, logReconfigurationAt?, entryAt?]
      intro configuration member sameIndex
      have bounds :=
        mem_configurationsInEntriesAux 1 entries configuration member
      omega
  | succ offset =>
      rw [Nat.add_comm offset 1]
      change
        configurationAt?
            (configurationsInEntriesAux 1 entries)
            (1 + offset) =
          logReconfigurationAt? entries (1 + offset)
      rw [configurationAt?_configurationsInEntriesAux_before_projection]
      cases atOffset : entries[offset]? with
      | none =>
          simp [logReconfigurationAt?, entryAt?, atOffset]
      | some entry =>
          cases entry with
          | mk term content =>
              cases content <;>
                simp [logReconfigurationAt?, entryAt?, atOffset]

private theorem configurationAt?_some_witness_before_projection
    (configurations : List ConfigurationAt)
    (index : Nat)
    (nodes : Configuration)
    (lookup :
      configurationAt? configurations index = some nodes) :
    Exists fun configuration =>
      And
        (configuration ∈ configurations)
        (And
          (configuration.index = index)
          (configuration.nodes = nodes)) := by
  unfold configurationAt? at lookup
  cases found :
      configurations.find? fun configuration =>
        configuration.index = index with
  | none =>
      simp [found] at lookup
  | some configuration =>
      have member : configuration ∈ configurations :=
        List.mem_of_find?_eq_some found
      have sameIndex : configuration.index = index := by
        have satisfies := List.find?_some found
        simpa using satisfies
      have sameNodes : configuration.nodes = nodes := by
        simpa [found] using lookup
      exact
        ⟨configuration, member, sameIndex, sameNodes⟩

private theorem configurationAt?_eq_some_of_mem_before_projection
    (configurations : List ConfigurationAt)
    (configuration : ConfigurationAt)
    (increasing : increasingConfigurationIndices configurations)
    (member : configuration ∈ configurations) :
    configurationAt? configurations configuration.index =
      some configuration.nodes := by
  induction configurations with
  | nil =>
      simp at member
  | cons head rest inductionHypothesis =>
      rw [increasingConfigurationIndices, List.pairwise_cons] at increasing
      simp only [List.mem_cons] at member
      rcases member with isHead | inRest
      · subst head
        simp [configurationAt?]
      · have differentIndex : head.index ≠ configuration.index := by
          have afterHead := increasing.1 configuration inRest
          omega
        unfold configurationAt?
        rw [List.find?_cons]
        simp only [differentIndex, decide_false]
        change
          configurationAt? rest configuration.index =
            some configuration.nodes
        exact inductionHypothesis increasing.2 inRest

theorem lastCommittedConfiguration?_eq_committedConfigurationAt?
    (state : State)
    (node : Node)
    (commitWithin :
      state.commitIndex node <= (state.log node).length) :
    lastCommittedConfiguration? state node =
      (committedConfigurationAt?
        (state.log node)
        (state.commitIndex node)).map (·.nodes) := by
  let configurations := logConfigurations (state.log node)
  cases selectedAt :
      committedConfigurationAt?
        (state.log node)
        (state.commitIndex node) with
  | none =>
      have filteredEmpty :
          configurationsToIndex
            configurations
            (state.commitIndex node) =
            [] := by
        simpa [committedConfigurationAt?, configurations] using selectedAt
      have noneWithin :
          forall index,
            0 < index ->
            index <= state.commitIndex node ->
              logReconfigurationAt? (state.log node) index = none := by
        intro index positive within
        cases reconfiguration :
            logReconfigurationAt? (state.log node) index with
        | none =>
            rfl
        | some nodes =>
            have lookup :
              configurationAt? configurations index = some nodes := by
              simpa [configurations] using
                (logConfigurations_lookup_eq_logReconfigurationAt?
                  (state.log node)
                  index).trans reconfiguration
            rcases configurationAt?_some_witness_before_projection
                configurations index nodes lookup with
              ⟨configuration, member, configurationIndex, _⟩
            have filteredMember :
              configuration ∈
                configurationsToIndex
                  configurations
                  (state.commitIndex node) := by
              simp [configurationsToIndex, member, configurationIndex, within]
            rw [filteredEmpty] at filteredMember
            contradiction
      simpa [lastCommittedConfiguration?, committed, logPrefix, indices,
        List.length_take, Nat.min_eq_left commitWithin, selectedAt] using
          (fold_reconfigurations_eq_none
            (state.log node)
            (state.commitIndex node)
            none
            noneWithin)
  | some selected =>
      have selectedLast :
          (configurationsToIndex
            configurations
            (state.commitIndex node)).getLast? =
            some selected := by
        simpa [committedConfigurationAt?, configurations] using selectedAt
      rcases List.getLast?_eq_some_iff.mp selectedLast with
        ⟨preceding, filteredShape⟩
      have selectedFilteredMember :
          selected ∈
            configurationsToIndex
              configurations
              (state.commitIndex node) := by
        rw [filteredShape]
        simp
      have selectedFacts :
        selected ∈ configurations ∧
          selected.index <= state.commitIndex node := by
        simpa [configurationsToIndex] using selectedFilteredMember
      have selectedMember : selected ∈ configurations :=
        selectedFacts.1
      have selectedWithin :
        selected.index <= state.commitIndex node :=
        selectedFacts.2
      have selectedPositive : 0 < selected.index := by
        have bounds :=
          mem_configurationsInEntriesAux
            1
            (state.log node)
            selected
            (by simpa [configurations, logConfigurations,
              configurationsInEntries] using selectedMember)
        omega
      have filteredIncreasing :
          increasingConfigurationIndices
            (configurationsToIndex
              configurations
              (state.commitIndex node)) :=
        increasing_configurationsToIndex
          configurations
          (state.commitIndex node)
          (by
            simpa [configurations] using
              increasing_configurationsInEntries 1 (state.log node))
      have greatest :
          forall configuration,
            configuration ∈ configurations ->
            configuration.index <= state.commitIndex node ->
              configuration.index <= selected.index := by
        intro configuration member within
        have filteredMember :
            configuration ∈
              configurationsToIndex
                configurations
                (state.commitIndex node) := by
          simp [configurationsToIndex, member, within]
        rw [filteredShape] at filteredIncreasing filteredMember
        rw [increasingConfigurationIndices, List.pairwise_append]
          at filteredIncreasing
        simp only [List.mem_append, List.mem_singleton] at filteredMember
        rcases filteredMember with inPrefix | isSelected
        · exact Nat.le_of_lt
            (filteredIncreasing.2.2
              configuration inPrefix selected (by simp))
        · subst configuration
          exact Nat.le_refl _
      have selectedLookup :
        logReconfigurationAt? (state.log node) selected.index =
          some selected.nodes := by
        rw [← logConfigurations_lookup_eq_logReconfigurationAt?]
        exact
          configurationAt?_eq_some_of_mem_before_projection
            configurations
            selected
            (by
              simpa [configurations] using
                increasing_configurationsInEntries 1 (state.log node))
            selectedMember
      have noneAfter :
          forall index,
            selected.index < index ->
            index <= state.commitIndex node ->
              logReconfigurationAt? (state.log node) index = none := by
        intro index afterSelected within
        cases reconfiguration :
            logReconfigurationAt? (state.log node) index with
        | none =>
            rfl
        | some nodes =>
            have lookup :
              configurationAt? configurations index = some nodes := by
              simpa [configurations] using
                (logConfigurations_lookup_eq_logReconfigurationAt?
                  (state.log node)
                  index).trans reconfiguration
            rcases configurationAt?_some_witness_before_projection
                configurations index nodes lookup with
              ⟨configuration, member, configurationIndex, _⟩
            have beforeSelected :=
              greatest configuration member (by simpa [configurationIndex])
            omega
      simpa [lastCommittedConfiguration?, committed, logPrefix, indices,
        List.length_take, Nat.min_eq_left commitWithin, selectedAt] using
          (fold_reconfigurations_eq_some
            (state.log node)
            selected
            (state.commitIndex node)
            none
            selectedPositive
            selectedWithin
            selectedLookup
            noneAfter)

theorem configurationsExact_committedConfigurationAt?_mem_of_commit_le
    (state : State)
    (node : Node)
    (index : Nat)
    (exact : ConfigurationsExactInv state)
    (commitLe : state.commitIndex node <= index)
    (configuration : ConfigurationAt)
    (selected :
      committedConfigurationAt?
        (state.log node)
        index =
        some configuration) :
    configuration ∈ state.configurations node := by
  let configurations := logConfigurations (state.log node)
  have selectedLast :
      (configurationsToIndex
          configurations
          index).getLast? =
        some configuration := by
    simpa [committedConfigurationAt?, configurations] using selected
  rcases List.getLast?_eq_some_iff.mp selectedLast with
    ⟨preceding, filteredShape⟩
  have selectedFilteredMember :
      configuration ∈
        configurationsToIndex
          configurations
          index := by
    rw [filteredShape]
    simp
  have selectedFacts :
      configuration ∈ configurations ∧
        configuration.index <= index := by
    simpa [configurationsToIndex] using selectedFilteredMember
  have selectedMember : configuration ∈ configurations :=
    selectedFacts.1
  have selectedGreatest :
      forall other,
        other ∈ configurations ->
          other.index <= index ->
            other.index <= configuration.index := by
    intro other otherMember otherWithin
    have otherFilteredMember :
        other ∈ configurationsToIndex configurations index := by
      simp [configurationsToIndex, otherMember, otherWithin]
    have filteredIncreasing :
        increasingConfigurationIndices
          (configurationsToIndex configurations index) :=
      increasing_configurationsToIndex
        configurations
        index
        (by
          simpa [configurations] using
            increasing_configurationsInEntries 1 (state.log node))
    rw [filteredShape] at filteredIncreasing otherFilteredMember
    rw [increasingConfigurationIndices, List.pairwise_append]
      at filteredIncreasing
    simp only [List.mem_append, List.mem_singleton] at otherFilteredMember
    rcases otherFilteredMember with inPreceding | isSelected
    · exact Nat.le_of_lt
        (filteredIncreasing.2.2
          other inPreceding configuration (by simp))
    · subst other
      exact Nat.le_refl _
  have activeThresholdLe :
        lastConfigurationToIndex
          configurations
          (state.commitIndex node) <=
        configuration.index := by
    rcases
        lastConfigurationToIndex_eq_zero_or_mem
          configurations
          (state.commitIndex node) with
      noConfiguration | ⟨last, lastMember, lastIndex⟩
    · rw [noConfiguration]
      exact Nat.zero_le _
    · rw [← lastIndex]
      apply selectedGreatest last lastMember
      exact Nat.le_trans
        (by
          rw [lastIndex]
          exact lastConfigurationToIndex_le _ _)
        commitLe
  rw [exact node]
  simp [activeLogConfigurations, configurationsFromIndex,
    configurations, selectedMember, activeThresholdLe]

theorem configurationsExact_committedConfigurationAt?_mem
    (state : State)
    (node : Node)
    (exact : ConfigurationsExactInv state)
    (configuration : ConfigurationAt)
    (selected :
      committedConfigurationAt?
          (state.log node)
          (state.commitIndex node) =
        some configuration) :
    configuration ∈ state.configurations node :=
  configurationsExact_committedConfigurationAt?_mem_of_commit_le
    state
    node
    (state.commitIndex node)
    exact
    (Nat.le_refl _)
    configuration
    selected

theorem committedConfigurationAt?_some_properties
    (entries : List Entry)
    (index : Nat)
    (configuration : ConfigurationAt)
    (selected :
      committedConfigurationAt? entries index = some configuration) :
    And
      (configuration ∈ logConfigurations entries)
      (configuration.index <= index) := by
  have selectedLast :
      (configurationsToIndex
          (logConfigurations entries)
          index).getLast? =
        some configuration := by
    simpa [committedConfigurationAt?] using selected
  rcases List.getLast?_eq_some_iff.mp selectedLast with
    ⟨preceding, filteredShape⟩
  have selectedFilteredMember :
      configuration ∈
        configurationsToIndex
          (logConfigurations entries)
          index := by
    rw [filteredShape]
    simp
  simpa [configurationsToIndex] using selectedFilteredMember

theorem committedConfigurationAt?_index_eq_lastConfigurationToIndex
    (entries : List Entry)
    (index : Nat)
    (configuration : ConfigurationAt)
    (selected :
      committedConfigurationAt? entries index = some configuration) :
    configuration.index =
      lastConfigurationToIndex (logConfigurations entries) index := by
  let configurations := logConfigurations entries
  have selectedLast :
      (configurationsToIndex configurations index).getLast? =
        some configuration := by
    simpa [committedConfigurationAt?, configurations] using selected
  rcases List.getLast?_eq_some_iff.mp selectedLast with
    ⟨preceding, filteredShape⟩
  have selectedFilteredMember :
      configuration ∈ configurationsToIndex configurations index := by
    rw [filteredShape]
    simp
  have selectedFacts :
      configuration ∈ configurations ∧ configuration.index <= index := by
    simpa [configurationsToIndex] using selectedFilteredMember
  have selectedGreatest :
      forall other,
        other ∈ configurations ->
          other.index <= index ->
            other.index <= configuration.index := by
    intro other otherMember otherWithin
    have otherFilteredMember :
        other ∈ configurationsToIndex configurations index := by
      simp [configurationsToIndex, otherMember, otherWithin]
    have filteredIncreasing :
        increasingConfigurationIndices
          (configurationsToIndex configurations index) :=
      increasing_configurationsToIndex
        configurations
        index
        (by
          simpa [configurations] using
            increasing_configurationsInEntries 1 entries)
    rw [filteredShape] at filteredIncreasing otherFilteredMember
    rw [increasingConfigurationIndices, List.pairwise_append]
      at filteredIncreasing
    simp only [List.mem_append, List.mem_singleton] at otherFilteredMember
    rcases otherFilteredMember with inPreceding | isSelected
    · exact Nat.le_of_lt
        (filteredIncreasing.2.2
          other inPreceding configuration (by simp))
    · subst other
      exact Nat.le_refl _
  apply Nat.le_antisymm
  · exact configuration_index_le_lastConfigurationToIndex
      configurations
      configuration
      index
      selectedFacts.1
      selectedFacts.2
  · rcases
        lastConfigurationToIndex_eq_zero_or_mem
          configurations index with
      noConfiguration | ⟨last, lastMember, lastIndex⟩
    · rw [noConfiguration]
      exact Nat.zero_le _
    · rw [← lastIndex]
      exact selectedGreatest
        last
        lastMember
        (by
          rw [lastIndex]
          exact lastConfigurationToIndex_le _ _)

private theorem configurationsFromIndex_head?_eq_of_member_at_lower
    (configurations : List ConfigurationAt)
    (lower : Nat)
    (selected : ConfigurationAt)
    (increasing : increasingConfigurationIndices configurations)
    (member : selected ∈ configurations)
    (selectedIndex : selected.index = lower) :
    (configurationsFromIndex configurations lower).head? =
      some selected := by
  induction configurations with
  | nil =>
      simp at member
  | cons head tail inductionHypothesis =>
      rw [increasingConfigurationIndices, List.pairwise_cons] at increasing
      simp only [List.mem_cons] at member
      rcases member with isHead | inTail
      · subst head
        simp [configurationsFromIndex, selectedIndex]
      · have headBefore : head.index < selected.index :=
          increasing.1 selected inTail
        have headBeforeLower : ¬ lower <= head.index := by
          omega
        simpa [configurationsFromIndex, headBeforeLower] using
          inductionHypothesis increasing.2 inTail

theorem configurationsExact_committedConfigurationAt?_currentConfiguration
    (state : State)
    (node : Node)
    (exact : ConfigurationsExactInv state)
    (configuration : ConfigurationAt)
    (selected :
      committedConfigurationAt?
          (state.log node)
          (state.commitIndex node) =
        some configuration) :
    currentConfiguration (state.configurations node) =
      configuration.nodes := by
  let configurations := logConfigurations (state.log node)
  have selectedFacts :=
    committedConfigurationAt?_some_properties
      (state.log node)
      (state.commitIndex node)
      configuration
      selected
  have selectedIndex :=
    committedConfigurationAt?_index_eq_lastConfigurationToIndex
      (state.log node)
      (state.commitIndex node)
      configuration
      selected
  have selectedHead :=
    configurationsFromIndex_head?_eq_of_member_at_lower
      configurations
      (lastConfigurationToIndex
        configurations
        (state.commitIndex node))
      configuration
      (by
        simpa [configurations] using
          increasing_configurationsInEntries 1 (state.log node))
      (by simpa [configurations] using selectedFacts.1)
      (by simpa [configurations] using selectedIndex)
  rw [exact node]
  simp [activeLogConfigurations, currentConfiguration,
    configurations, selectedHead]

theorem historicalChosenCommitCore_implies_QuorumLogInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (chosen : HistoricalChosenCommitCore start actions state)
    (signatures : SignatureInv state)
    (configurationsExact : ConfigurationsExactInv state) :
    QuorumLogInv state := by
  intro node _configurationsNonempty quorum quorumOk
  by_cases commitZero : state.commitIndex node = 0
  · rcases isQuorum_nonempty
        quorum
        (currentConfiguration (state.configurations node))
        quorumOk with
      ⟨member, memberInQuorum⟩
    refine ⟨member, memberInQuorum, ?_⟩
    simp [committed, commitZero, logPrefix, isLogPrefix]
  · have commitPositive : 0 < state.commitIndex node := by
      omega
    have boundary :
        SignatureCommitBoundary
          state node (state.commitIndex node) :=
      ⟨commitPositive, Nat.le_refl _,
        signatures node commitPositive⟩
    rcases
        chosen
          state
          (protocolHistory_final_stateAt history)
          node
          (state.commitIndex node)
          boundary with
      ⟨certificate⟩
    have currentConfigurationEq :=
      configurationsExact_committedConfigurationAt?_currentConfiguration
        state
        node
        configurationsExact
        certificate.configuration
        certificate.configuration_at
    have callerQuorum :
        isQuorum quorum certificate.configuration.nodes = true := by
      simpa [currentConfigurationEq] using quorumOk
    rcases
        isQuorum_intersects
          certificate.quorum
          quorum
          certificate.configuration.nodes
          certificate.quorum_ok
          callerQuorum with
      ⟨member, certificateMember, callerMember⟩
    refine ⟨member, callerMember, ?_⟩
    have retained :=
      certificate.support_retained member certificateMember
    simpa [committed, certificate.prefix_eq] using retained

theorem historicalChosenCommitCore_implies_ReplicationInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (chosen : HistoricalChosenCommitCore start actions state)
    (signatures : SignatureInv state)
    (somePositiveCommit :
      Exists fun node => 0 < state.commitIndex node) :
    ReplicationInv state := by
  rcases exists_node_with_max_commitIndex
      state
      (protocolHistory_nodes_nonempty history)
      (protocolHistory_commitIndex_zero_outside_nodes history) with
    ⟨owner, ownerMaximal⟩
  rcases somePositiveCommit with
    ⟨positiveNode, positiveCommit⟩
  have ownerCommitPositive : 0 < state.commitIndex owner :=
    Nat.lt_of_lt_of_le positiveCommit (ownerMaximal positiveNode)
  have boundary :
      SignatureCommitBoundary
        state owner (state.commitIndex owner) :=
    ⟨ownerCommitPositive, Nat.le_refl _,
      signatures owner ownerCommitPositive⟩
  rcases
      chosen
        state
        (protocolHistory_final_stateAt history)
        owner
        (state.commitIndex owner)
        boundary with
    ⟨certificate⟩
  have commitWithin :=
    commitIndex_le_log_length state signatures owner
  have lastConfigurationEq :
      lastCommittedConfiguration? state owner =
        some certificate.configuration.nodes := by
    rw [lastCommittedConfiguration?_eq_committedConfigurationAt?
      state owner commitWithin]
    rw [certificate.configuration_at]
    rfl
  refine
    ⟨owner, ownerMaximal,
      certificate.configuration.nodes,
      lastConfigurationEq,
      certificate.quorum,
      certificate.quorum_ok,
      ?_⟩
  intro member memberInQuorum
  have retained :=
    certificate.support_retained member memberInQuorum
  simpa [committed, certificate.prefix_eq] using retained

theorem committedConfigurationAt?_exists_of_configuration
    (entries : List Entry)
    (index : Nat)
    (configuration : ConfigurationAt)
    (member : configuration ∈ logConfigurations entries)
    (within : configuration.index <= index) :
    Exists fun selected =>
      committedConfigurationAt? entries index = some selected := by
  have filteredMember :
      configuration ∈
        configurationsToIndex (logConfigurations entries) index := by
    simp [configurationsToIndex, member, within]
  cases selected :
      committedConfigurationAt? entries index with
  | none =>
      have filteredEmpty :
          configurationsToIndex (logConfigurations entries) index = [] := by
        simpa [committedConfigurationAt?] using selected
      rw [filteredEmpty] at filteredMember
      contradiction
  | some selectedConfiguration =>
      exact ⟨selectedConfiguration, rfl⟩

theorem highestCommittableIndex_le_log_length
    (state : State)
    (leader : Node) :
    highestCommittableIndex state leader <= (state.log leader).length := by
  rcases highestCommittableIndex_signature_or_zero state leader with
    highestZero | ⟨entry, atHighest, _, _⟩
  · simp [highestZero]
  · unfold entryAt? at atHighest
    split at atHighest
    · contradiction
    · have beforeLength :
          highestCommittableIndex state leader - 1 <
            (state.log leader).length :=
        (List.getElem?_eq_some_iff.mp atHighest).choose
      omega

theorem advanceCommitIndex_committedPrefix_replicated
    (state : State)
    (leader : Node)
    (matchPrefixes : MatchIndexPrefixInv state)
    (configurationsExact : ConfigurationsExactInv state)
    (signatures : SignatureInv state)
    (hasLastConfiguration :
      Exists fun configuration =>
        lastCommittedConfiguration? state leader = some configuration)
    (agreeingTerms :
      forall configuration,
        configuration ∈ state.configurations leader ->
          configuration.index <= highestCommittableIndex state leader ->
            forall member,
              member ∈ configuration.nodes ->
                highestCommittableIndex state leader <=
                    state.matchIndex leader member ->
                  state.currentTerm leader = state.currentTerm member)
    (enabled : Enabled state (.advanceCommitIndex leader)) :
    Exists fun configuration =>
      And
        (lastCommittedConfiguration?
            (next state (.advanceCommitIndex leader))
            leader =
          some configuration)
        (Exists fun quorum =>
          And
            (isQuorum quorum configuration = true)
            (forall member,
              member ∈ quorum ->
                isLogPrefix
                  (committed
                    (next state (.advanceCommitIndex leader))
                    leader)
                  ((next state (.advanceCommitIndex leader)).log member))) := by
  let highest := highestCommittableIndex state leader
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have leaderState : state.leadershipState leader = .leader :=
    enabledFacts.1.2
  have commitBefore : state.commitIndex leader < highest := by
    simpa [highest] using enabledFacts.2
  have highestPositive : 0 < highest := by
    omega
  have highestWithin :
      highest <= (state.log leader).length := by
    simpa [highest] using
      highestCommittableIndex_le_log_length state leader
  have consensus :
      hasConsensusWatermark state leader highest = true := by
    simpa [highest] using
      highestCommittableIndex_hasConsensusWatermark_of_pos
        state leader (by simpa [highest] using highestPositive)
  have oldCommitWithin :=
    commitIndex_le_log_length state signatures leader
  rcases hasLastConfiguration with ⟨oldConfiguration, oldLast⟩
  have oldProjection :=
    lastCommittedConfiguration?_eq_committedConfigurationAt?
      state leader oldCommitWithin
  have oldSelectedExists :
      Exists fun configuration =>
        committedConfigurationAt?
            (state.log leader)
            (state.commitIndex leader) =
          some configuration := by
    cases oldSelected :
        committedConfigurationAt?
          (state.log leader)
          (state.commitIndex leader) with
    | none =>
        simp [oldSelected] at oldProjection
        rw [oldLast] at oldProjection
        contradiction
    | some configuration =>
        exact ⟨configuration, rfl⟩
  rcases oldSelectedExists with ⟨oldSelected, oldSelectedAt⟩
  have oldSelectedFacts :=
    committedConfigurationAt?_some_properties
      (state.log leader)
      (state.commitIndex leader)
      oldSelected
      oldSelectedAt
  have selectedExists :
      Exists fun configuration =>
        committedConfigurationAt? (state.log leader) highest =
          some configuration :=
    committedConfigurationAt?_exists_of_configuration
      (state.log leader)
      highest
      oldSelected
      oldSelectedFacts.1
      (Nat.le_trans oldSelectedFacts.2 (Nat.le_of_lt commitBefore))
  rcases selectedExists with ⟨selected, selectedAt⟩
  have selectedMember :
      selected ∈ state.configurations leader :=
    configurationsExact_committedConfigurationAt?_mem_of_commit_le
      state
      leader
      highest
      configurationsExact
      (Nat.le_of_lt commitBefore)
      selected
      selectedAt
  have selectedFacts :=
    committedConfigurationAt?_some_properties
      (state.log leader)
      highest
      selected
      selectedAt
  have selectedConsensus := consensus
  simp [hasConsensusWatermark] at selectedConsensus
  have selectedQuorum :=
    selectedConsensus selected selectedMember
  have selectedQuorumFact :
      isQuorum
          (if leader ∈ selected.nodes then
            insert leader
              (selected.nodes.filter fun member =>
                highest <= state.matchIndex leader member)
          else
            selected.nodes.filter fun member =>
              highest <= state.matchIndex leader member)
          selected.nodes =
        true := by
    rcases selectedQuorum with selectedAfter | quorum
    · omega
    · exact quorum
  have afterCommitWithin :
      (next state (.advanceCommitIndex leader)).commitIndex leader <=
        ((next state (.advanceCommitIndex leader)).log leader).length := by
    simpa [next, rawNext, nextAdvanceCommitIndex, updateNode, highest] using
      highestWithin
  have afterProjection :=
    lastCommittedConfiguration?_eq_committedConfigurationAt?
      (next state (.advanceCommitIndex leader))
      leader
      afterCommitWithin
  have afterSelectedAt :
      committedConfigurationAt?
          ((next state (.advanceCommitIndex leader)).log leader)
          ((next state (.advanceCommitIndex leader)).commitIndex leader) =
        some selected := by
    simpa [next, rawNext, nextAdvanceCommitIndex, updateNode, highest] using
      selectedAt
  have afterLast :
      lastCommittedConfiguration?
          (next state (.advanceCommitIndex leader))
          leader =
        some selected.nodes := by
    rw [afterProjection, afterSelectedAt]
    rfl
  let agreeing :=
    selected.nodes.filter fun member =>
      highest <= state.matchIndex leader member
  let quorum :=
    if leader ∈ selected.nodes then
      insert leader agreeing
    else
      agreeing
  refine ⟨selected.nodes, afterLast, quorum, ?_, ?_⟩
  · simpa [quorum, agreeing] using selectedQuorumFact
  · intro member memberInQuorum
    have leaderOrAgreeing :
        Or (member = leader) (member ∈ agreeing) := by
      dsimp [quorum] at memberInQuorum
      by_cases leaderMember : leader ∈ selected.nodes
      · simp [leaderMember] at memberInQuorum
        exact memberInQuorum
      · exact Or.inr (by simpa [leaderMember] using memberInQuorum)
    rcases leaderOrAgreeing with memberIsLeader | memberAgreeing
    · subst member
      simpa [committed, next, rawNext, nextAdvanceCommitIndex, updateNode,
        highest, isLogPrefix, logPrefix] using
          (List.take_prefix highest (state.log leader))
    · have agreeingFacts :
          member ∈ selected.nodes ∧
            highest <= state.matchIndex leader member := by
        simpa [agreeing] using memberAgreeing
      have sameTerm :=
        agreeingTerms
          selected
          selectedMember
          (by simpa [highest] using selectedFacts.2)
          member
          agreeingFacts.1
          (by simpa [highest] using agreeingFacts.2)
      have prefixFacts :=
        matchPrefixes leader member leaderState sameTerm
      have prefixEq :
          logPrefix (state.log leader) highest =
            logPrefix (state.log member) highest := by
        have atMatch :=
          congrArg
            (fun entries => logPrefix entries highest)
            prefixFacts.2.2
        simpa [logPrefix, List.take_take,
          Nat.min_eq_left agreeingFacts.2] using atMatch
      have followerPrefix :
          isLogPrefix
            (logPrefix (state.log leader) highest)
            (state.log member) := by
        rw [prefixEq]
        exact List.take_prefix highest (state.log member)
      simpa [committed, next, rawNext, nextAdvanceCommitIndex, updateNode,
        highest] using followerPrefix

theorem increasing_activeLogConfigurations
    (entries : List Entry)
    (commitIndex : Nat) :
    increasingConfigurationIndices
      (activeLogConfigurations entries commitIndex) := by
  apply increasing_configurationsFromIndex
  exact increasing_configurationsInEntries 1 entries

theorem configurationAt?_configurationsInEntriesAux
    (firstIndex : Nat)
    (entries : List Entry)
    (offset : Nat) :
    configurationAt?
        (configurationsInEntriesAux firstIndex entries)
        (firstIndex + offset) =
      match entries[offset]? with
      | some entry =>
          match entry.content with
          | .reconfiguration configuration => some configuration
          | _ => none
      | none => none := by
  induction entries generalizing firstIndex offset with
  | nil =>
      simp [configurationsInEntriesAux, configurationAt?]
  | cons entry rest inductionHypothesis =>
      cases offset with
      | zero =>
          cases content : entry.content with
          | entry =>
              simp [configurationsInEntriesAux, configurationAt?, content]
              intro configuration member sameIndex
              have bounds :=
                mem_configurationsInEntriesAux
                  (firstIndex + 1) rest configuration member
              omega
          | signature =>
              simp [configurationsInEntriesAux, configurationAt?, content]
              intro configuration member sameIndex
              have bounds :=
                mem_configurationsInEntriesAux
                  (firstIndex + 1) rest configuration member
              omega
          | reconfiguration configuration =>
              simp [configurationsInEntriesAux, configurationAt?, content]
      | succ offset =>
          cases content : entry.content <;>
            simp [configurationsInEntriesAux, configurationAt?, content]
          all_goals
            simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
              inductionHypothesis (firstIndex + 1) offset

theorem configurationAt?_logConfigurations_eq_logReconfigurationAt?
    (entries : List Entry)
    (index : Nat) :
    configurationAt? (logConfigurations entries) index =
      logReconfigurationAt? entries index := by
  cases index with
  | zero =>
      simp [logConfigurations, configurationsInEntries,
        configurationAt?, logReconfigurationAt?, entryAt?]
      intro configuration member sameIndex
      have bounds :=
        mem_configurationsInEntriesAux 1 entries configuration member
      omega
  | succ offset =>
      rw [Nat.add_comm offset 1]
      change
        configurationAt?
            (configurationsInEntriesAux 1 entries)
            (1 + offset) =
          logReconfigurationAt? entries (1 + offset)
      rw [configurationAt?_configurationsInEntriesAux]
      cases atOffset : entries[offset]? with
      | none =>
          simp [logReconfigurationAt?, entryAt?, atOffset]
      | some entry =>
          cases entry with
          | mk term content =>
              cases content <;>
                simp [logReconfigurationAt?, entryAt?, atOffset]

theorem configurationAt?_eq_some_of_mem
    (configurations : List ConfigurationAt)
    (configuration : ConfigurationAt)
    (increasing : increasingConfigurationIndices configurations)
    (member : configuration ∈ configurations) :
    configurationAt? configurations configuration.index =
      some configuration.nodes := by
  induction configurations with
  | nil =>
      simp at member
  | cons head rest inductionHypothesis =>
      rw [increasingConfigurationIndices, List.pairwise_cons] at increasing
      simp only [List.mem_cons] at member
      rcases member with isHead | inRest
      · subst head
        simp [configurationAt?]
      · have differentIndex : head.index ≠ configuration.index := by
          have afterHead := increasing.1 configuration inRest
          omega
        unfold configurationAt?
        rw [List.find?_cons]
        simp only [differentIndex, decide_false]
        change
          configurationAt? rest configuration.index =
            some configuration.nodes
        exact inductionHypothesis increasing.2 inRest

theorem configurationAt?_some_witness
    (configurations : List ConfigurationAt)
    (index : Nat)
    (nodes : Configuration)
    (lookup :
      configurationAt? configurations index = some nodes) :
    Exists fun configuration =>
      And
        (configuration ∈ configurations)
        (And
          (configuration.index = index)
          (configuration.nodes = nodes)) := by
  unfold configurationAt? at lookup
  cases found :
      configurations.find? fun configuration =>
        configuration.index = index with
  | none =>
      simp [found] at lookup
  | some configuration =>
      have member : configuration ∈ configurations :=
        List.mem_of_find?_eq_some found
      have sameIndex : configuration.index = index := by
        have satisfies := List.find?_some found
        simpa using satisfies
      have sameNodes : configuration.nodes = nodes := by
        simpa [found] using lookup
      exact
        ⟨configuration, member, sameIndex, sameNodes⟩

theorem configurationAt?_configurationsFromIndex
    (configurations : List ConfigurationAt)
    (lowerBound index : Nat)
    (afterLower : lowerBound <= index) :
    configurationAt?
        (configurationsFromIndex configurations lowerBound)
        index =
      configurationAt? configurations index := by
  induction configurations with
  | nil =>
      simp [configurationsFromIndex, configurationAt?]
  | cons head rest inductionHypothesis =>
      change
        configurationAt?
            (match decide (lowerBound <= head.index) with
            | true => head :: configurationsFromIndex rest lowerBound
            | false => configurationsFromIndex rest lowerBound)
            index =
          configurationAt? (head :: rest) index
      by_cases headAfterLower : lowerBound <= head.index
      · rw [show decide (lowerBound <= head.index) = true by
            simp [headAfterLower]]
        by_cases sameIndex : head.index = index
        · subst index
          simp [configurationAt?]
        · unfold configurationAt?
          rw [List.find?_cons, List.find?_cons]
          simp only [sameIndex, decide_false]
          change
            configurationAt?
                (configurationsFromIndex rest lowerBound)
                index =
              configurationAt? rest index
          exact inductionHypothesis
      · rw [show decide (lowerBound <= head.index) = false by
            simp [headAfterLower]]
        have differentIndex : head.index ≠ index := by
          omega
        unfold configurationAt?
        rw [List.find?_cons]
        simp only [differentIndex, decide_false]
        change
          configurationAt?
              (configurationsFromIndex rest lowerBound)
              index =
            configurationAt? rest index
        exact inductionHypothesis

theorem activeLogConfigurations_match_log
    (entries : List Entry)
    (commitIndex : Nat) :
    forall configuration,
      configuration ∈ activeLogConfigurations entries commitIndex ->
        logReconfigurationAt? entries configuration.index =
          some configuration.nodes := by
  intro configuration member
  have inLogConfigurations :
      configuration ∈ logConfigurations entries := by
    have filtered :
        configuration ∈
          configurationsFromIndex
            (logConfigurations entries)
            (lastConfigurationToIndex
              (logConfigurations entries)
              commitIndex) := by
      simpa [activeLogConfigurations] using member
    have details :
        configuration ∈ logConfigurations entries ∧
          lastConfigurationToIndex
              (logConfigurations entries)
              commitIndex <=
            configuration.index := by
      simpa [configurationsFromIndex] using filtered
    exact details.1
  have lookup :=
    configurationAt?_eq_some_of_mem
      (logConfigurations entries)
      configuration
      (increasing_configurationsInEntries 1 entries)
      inLogConfigurations
  rw [configurationAt?_logConfigurations_eq_logReconfigurationAt?]
    at lookup
  exact lookup

theorem lastConfigurationToIndex_le_activeLogCurrent
    (entries : List Entry)
    (commitIndex : Nat) :
    lastConfigurationToIndex
        (logConfigurations entries)
        commitIndex <=
      ((activeLogConfigurations entries commitIndex).head?.map
        (·.index)).getD 0 := by
  rcases
      lastConfigurationToIndex_eq_zero_or_mem
        (logConfigurations entries)
        commitIndex with
    thresholdZero | ⟨configuration, member, sameIndex⟩
  · simp [thresholdZero]
  · have activeMember :
        configuration ∈ activeLogConfigurations entries commitIndex := by
      simp [activeLogConfigurations, configurationsFromIndex,
        member, sameIndex]
    cases activeShape :
        activeLogConfigurations entries commitIndex with
    | nil =>
        simp [activeShape] at activeMember
    | cons head rest =>
        have headMember :
            head ∈ activeLogConfigurations entries commitIndex := by
          rw [activeShape]
          simp
        have headAfterThreshold :
            lastConfigurationToIndex
                (logConfigurations entries)
                commitIndex <=
              head.index := by
          have filtered :
              head ∈
                configurationsFromIndex
                  (logConfigurations entries)
                  (lastConfigurationToIndex
                    (logConfigurations entries)
                    commitIndex) := by
            simpa [activeLogConfigurations] using headMember
          have details :
              head ∈ logConfigurations entries ∧
                lastConfigurationToIndex
                    (logConfigurations entries)
                    commitIndex <=
                  head.index := by
            simpa [configurationsFromIndex] using filtered
          exact details.2
        simpa [activeShape] using headAfterThreshold

theorem activeLogConfigurations_next_after_commit
    (entries : List Entry)
    (commitIndex : Nat)
    (multiple :
      (activeLogConfigurations entries commitIndex).length > 1) :
    commitIndex <
      (nextConfigurationIndex?
        (activeLogConfigurations entries commitIndex)).getD 0 := by
  cases activeShape :
      activeLogConfigurations entries commitIndex with
  | nil =>
      simp [activeShape] at multiple
  | cons first rest =>
      cases rest with
      | nil =>
          simp [activeShape] at multiple
      | cons second tail =>
          have firstMember :
              first ∈ activeLogConfigurations entries commitIndex := by
            rw [activeShape]
            simp
          have secondMember :
              second ∈ activeLogConfigurations entries commitIndex := by
            rw [activeShape]
            simp
          have firstAfterThreshold :
              lastConfigurationToIndex
                  (logConfigurations entries)
                  commitIndex <=
                first.index := by
            have filtered :
                first ∈
                  configurationsFromIndex
                    (logConfigurations entries)
                    (lastConfigurationToIndex
                      (logConfigurations entries)
                      commitIndex) := by
              simpa [activeLogConfigurations] using firstMember
            have details :
                first ∈ logConfigurations entries ∧
                  lastConfigurationToIndex
                      (logConfigurations entries)
                      commitIndex <=
                    first.index := by
              simpa [configurationsFromIndex] using filtered
            exact details.2
          have secondInLog :
              second ∈ logConfigurations entries := by
            have filtered :
                second ∈
                  configurationsFromIndex
                    (logConfigurations entries)
                    (lastConfigurationToIndex
                      (logConfigurations entries)
                      commitIndex) := by
              simpa [activeLogConfigurations] using secondMember
            have details :
                second ∈ logConfigurations entries ∧
                  lastConfigurationToIndex
                      (logConfigurations entries)
                      commitIndex <=
                    second.index := by
              simpa [configurationsFromIndex] using filtered
            exact details.1
          have firstBeforeSecond : first.index < second.index := by
            have increasing :=
              increasing_activeLogConfigurations entries commitIndex
            rw [activeShape, increasingConfigurationIndices,
              List.pairwise_cons] at increasing
            exact increasing.1 second (by simp)
          have afterCommit : commitIndex < second.index := by
            by_contra notAfterCommit
            have secondBeforeThreshold :=
              configuration_index_le_lastConfigurationToIndex
                (logConfigurations entries)
                second
                commitIndex
                secondInLog
                (by omega)
            omega
          simpa [activeShape, nextConfigurationIndex?] using afterCommit

theorem activeLogConfigurations_no_committed_after_current
    (entries : List Entry)
    (commitIndex : Nat) :
    let currentIndex :=
      (activeLogConfigurations entries commitIndex).head?.map
        (·.index) |>.getD 0
    forall index : Nat,
      currentIndex < index ->
        index <= commitIndex ->
          logReconfigurationAt? entries index = none := by
  dsimp
  intro index afterCurrent withinCommit
  have thresholdBeforeIndex :
      lastConfigurationToIndex
          (logConfigurations entries)
          commitIndex <
        index := by
    exact Nat.lt_of_le_of_lt
      (lastConfigurationToIndex_le_activeLogCurrent entries commitIndex)
      afterCurrent
  have noLookup :
      configurationAt? (logConfigurations entries) index = none := by
    cases lookup :
        configurationAt? (logConfigurations entries) index with
    | none =>
        rfl
    | some nodes =>
        rcases
            configurationAt?_some_witness
              (logConfigurations entries)
              index
              nodes
              lookup with
          ⟨configuration, member, sameIndex, _sameNodes⟩
        have beforeThreshold :=
          configuration_index_le_lastConfigurationToIndex
            (logConfigurations entries)
            configuration
            commitIndex
            member
            (by omega)
        omega
  rw [configurationAt?_logConfigurations_eq_logReconfigurationAt?]
    at noLookup
  exact noLookup

theorem activeLogConfigurations_contains_uncommitted
    (entries : List Entry)
    (commitIndex index : Nat)
    (afterCommit : commitIndex < index)
    (_withinLog : index <= entries.length)
    (configuration : Configuration)
    (reconfiguration :
      logReconfigurationAt? entries index = some configuration) :
    configurationAt?
        (activeLogConfigurations entries commitIndex)
        index =
      some configuration := by
  have afterThreshold :
      lastConfigurationToIndex
          (logConfigurations entries)
          commitIndex <=
        index := by
    exact Nat.le_trans
      (lastConfigurationToIndex_le
        (logConfigurations entries)
        commitIndex)
      (Nat.le_of_lt afterCommit)
  change
    configurationAt?
        (configurationsFromIndex
          (logConfigurations entries)
          (lastConfigurationToIndex
            (logConfigurations entries)
            commitIndex))
        index =
      some configuration
  rw [configurationAt?_configurationsFromIndex _ _ _ afterThreshold]
  rw [configurationAt?_logConfigurations_eq_logReconfigurationAt?]
  exact reconfiguration

theorem configurationsExact_implies_LogConfigurationConsistentInv
    (state : State)
    (exact : ConfigurationsExactInv state) :
    LogConfigurationConsistentInv state := by
  intro node
  have nodeExact := exact node
  refine Or.inr (Or.inr ?_)
  constructor
  · simpa [configurationsMatchLog, nodeExact] using
      activeLogConfigurations_match_log
        (state.log node)
        (state.commitIndex node)
  constructor
  · simpa [nodeExact] using
      activeLogConfigurations_next_after_commit
        (state.log node)
        (state.commitIndex node)
  constructor
  · simpa [noCommittedReconfigurationAfterCurrent, nodeExact] using
      activeLogConfigurations_no_committed_after_current
        (state.log node)
        (state.commitIndex node)
  · simpa [uncommittedReconfigurationsAreActive, nodeExact] using
      activeLogConfigurations_contains_uncommitted
        (state.log node)
        (state.commitIndex node)

theorem commitIndex_le_committable_length
    (state : State)
    (signatures : SignatureInv state)
    (node : Node) :
    state.commitIndex node <= (committable state node).length := by
  have withinLog := commitIndex_le_log_length state signatures node
  by_cases zeroCommit : state.commitIndex node = 0
  · omega
  · have positive : state.commitIndex node > 0 := by
      omega
    have signature := signatures node positive
    have withinCommittable :
        state.commitIndex node <=
        maxCommittableIndex (state.log node) :=
      index_le_maxCommittableIndex_of_signature
        (state.log node)
        (state.commitIndex node)
        signature
    simp [committable, logPrefix, List.length_take]
    omega

theorem timeout_preserves_ConfigurationsExactInv
    (state : State)
    (candidate : Node)
    (exact : ConfigurationsExactInv state) :
    ConfigurationsExactInv (next state (.timeout candidate)) := by
  simpa [ConfigurationsExactInv, next, rawNext, nextTimeout] using exact

theorem requestVote_preserves_ConfigurationsExactInv
    (state : State)
    (source dest : Node)
    (exact : ConfigurationsExactInv state) :
    ConfigurationsExactInv
      (next state (.requestVote source dest)) := by
  simpa [ConfigurationsExactInv, next, rawNext, nextRequestVote] using exact

theorem appendEntries_preserves_ConfigurationsExactInv
    (state : State)
    (source dest : Node)
    (exact : ConfigurationsExactInv state) :
    ConfigurationsExactInv
      (next state (.appendEntries source dest)) := by
  simpa [ConfigurationsExactInv, next, rawNext, nextAppendEntries] using exact

theorem clientRequest_preserves_ConfigurationsExactInv
    (state : State)
    (leader : Node)
    (exact : ConfigurationsExactInv state) :
    ConfigurationsExactInv
      (next state (.clientRequest leader)) := by
  intro node
  by_cases nodeIsLeader : node = leader
  · subst node
    simpa [next, rawNext, nextClientRequest, updateNode] using
      (exact leader).trans
        (activeLogConfigurations_append_entry
        (state.log leader)
        (state.commitIndex leader)
        (state.currentTerm leader)).symm
  · simpa [next, rawNext, nextClientRequest, updateNode,
      nodeIsLeader] using exact node

theorem sign_preserves_ConfigurationsExactInv
    (state : State)
    (leader : Node)
    (exact : ConfigurationsExactInv state) :
    ConfigurationsExactInv
      (next state (.signCommittableMessages leader)) := by
  intro node
  by_cases nodeIsLeader : node = leader
  · subst node
    simpa [next, rawNext, nextSignCommittableMessages, updateNode] using
      (exact leader).trans
        (activeLogConfigurations_append_signature
        (state.log leader)
        (state.commitIndex leader)
        (state.currentTerm leader)).symm
  · simpa [next, rawNext, nextSignCommittableMessages, updateNode,
      nodeIsLeader] using exact node

theorem changeConfiguration_preserves_ConfigurationsExactInv
    (state : State)
    (leader : Node)
    (configuration : Configuration)
    (exact : ConfigurationsExactInv state)
    (signatures : SignatureInv state) :
    ConfigurationsExactInv
      (next state (.changeConfiguration leader configuration)) := by
  intro node
  by_cases nodeIsLeader : node = leader
  · subst node
    have commitWithin :=
      commitIndex_le_log_length state signatures leader
    have appended :=
      activeLogConfigurations_append_reconfiguration
        (state.log leader)
        (state.commitIndex leader)
        (state.currentTerm leader)
        configuration
        commitWithin
    simpa [next, rawNext, nextChangeConfiguration, updateNode] using
      (congrArg
        (fun configurations =>
        configurations ++
          [{
            index := (state.log leader).length + 1
            nodes := configuration
          }])
        (exact leader)).trans appended.symm
  · simpa [next, rawNext, nextChangeConfiguration, updateNode,
      nodeIsLeader] using exact node

theorem becomeLeader_preserves_ConfigurationsExactInv
    (state : State)
    (leader : Node)
    (exact : ConfigurationsExactInv state)
    (signatures : SignatureInv state) :
    ConfigurationsExactInv
      (next state (.becomeLeader leader)) := by
  intro node
  by_cases nodeIsLeader : node = leader
  · subst node
    let nextLog := committable state leader
    have commitWithin :
        state.commitIndex leader <= nextLog.length :=
      commitIndex_le_committable_length state signatures leader
    have maxWithin :
        maxCommittableIndex (state.log leader) <=
          (state.log leader).length := by
      rcases maxCommittableIndex_signature_or_zero
          (state.log leader) with noSignature | ⟨entry, atIndex, _⟩
      · simp [noSignature]
      · unfold entryAt? at atIndex
        split at atIndex
        · contradiction
        · have beforeLength :
              maxCommittableIndex (state.log leader) - 1 <
                (state.log leader).length :=
            (List.getElem?_eq_some_iff.mp atIndex).choose
          have positive :
              0 < maxCommittableIndex (state.log leader) := by
            omega
          omega
    have commitWithinIndex :
        state.commitIndex leader <=
          maxCommittableIndex (state.log leader) := by
      simpa [nextLog, committable, logPrefix, List.length_take,
        Nat.min_eq_left maxWithin] using commitWithin
    have truncated :=
      activeLogConfigurations_take
        (state.log leader)
        (state.commitIndex leader)
        (maxCommittableIndex (state.log leader))
        commitWithinIndex
    have projected :=
      congrArg
        (fun configurations =>
          configurationsToIndex
            configurations
            (maxCommittableIndex (state.log leader)))
        (exact leader)
    simpa [next, rawNext, nextBecomeLeader, updateNode, nextLog,
      committable, logPrefix, List.length_take,
      Nat.min_eq_left maxWithin] using
        projected.trans truncated.symm
  · simpa [next, rawNext, nextBecomeLeader, updateNode,
      nodeIsLeader] using exact node

theorem advanceCommitIndex_preserves_ConfigurationsExactInv
    (state : State)
    (leader : Node)
    (exact : ConfigurationsExactInv state)
    (enabled : Enabled state (.advanceCommitIndex leader)) :
    ConfigurationsExactInv
      (next state (.advanceCommitIndex leader)) := by
  have commitMonotonic :
      state.commitIndex leader <= highestCommittableIndex state leader := by
    simp [Enabled, actionEnabled] at enabled
    omega
  intro node
  by_cases nodeIsLeader : node = leader
  · subst node
    let nextCommitIndex := highestCommittableIndex state leader
    let nextConfigurations :=
      match nextConfigurationIndex? (state.configurations leader) with
      | some nextIndex =>
        if nextIndex <= nextCommitIndex then
          configurationsFromIndex
            (state.configurations leader)
            (lastConfigurationToIndex
              (state.configurations leader)
              nextCommitIndex)
        else
          state.configurations leader
      | none => state.configurations leader
    have increasing :
        increasingConfigurationIndices
        (state.configurations leader) := by
      rw [exact leader]
      exact increasing_activeLogConfigurations
        (state.log leader)
        (state.commitIndex leader)
    have normalized :
        nextConfigurations =
        configurationsFromIndex
          (state.configurations leader)
          (lastConfigurationToIndex
            (state.configurations leader)
            nextCommitIndex) := by
      exact advanceConfigurations_eq_fromIndex
        (state.configurations leader)
        nextCommitIndex
        increasing
    have advanced :=
      activeLogConfigurations_advanceCommit
        (state.log leader)
        (state.commitIndex leader)
        nextCommitIndex
        commitMonotonic
    rw [← exact leader] at advanced
    simpa [next, rawNext, nextAdvanceCommitIndex, updateNode,
      nextCommitIndex, nextConfigurations] using
        normalized.trans advanced
  · simpa [next, rawNext, nextAdvanceCommitIndex, updateNode,
      nodeIsLeader] using exact node

theorem conflictRollback_preserves_ConfigurationsExactInv
    (state : State)
    (dest : Node)
    (previousIndex : Nat)
    (exact : ConfigurationsExactInv state)
    (commitWithin : state.commitIndex dest <= previousIndex)
    (previousWithin : previousIndex <= (state.log dest).length) :
    ConfigurationsExactInv
      (conflictRollback state dest previousIndex) := by
  intro node
  by_cases nodeIsDest : node = dest
  · subst node
    have truncated :=
      activeLogConfigurations_take
        (state.log dest)
        (state.commitIndex dest)
        previousIndex
        commitWithin
    have projected :=
      congrArg
        (fun configurations =>
        configurationsToIndex configurations previousIndex)
        (exact dest)
    simpa [conflictRollback, updateNode, List.length_take,
      Nat.min_eq_left previousWithin] using projected.trans truncated.symm
  · simpa [conflictRollback, updateNode, nodeIsDest] using exact node

theorem appendEntriesAlreadyDone_preserves_ConfigurationsExactInv
    (state : State)
    (message : Message)
    (previousIndex : Nat)
    (entries : List Entry)
    (leaderCommitIndex : Nat)
    (exact : ConfigurationsExactInv state) :
    ConfigurationsExactInv
      (nextAppendEntriesAlreadyDone
        state message previousIndex entries leaderCommitIndex) := by
  intro node
  by_cases nodeIsDest : node = message.dest
  · subst node
    let requestEndIndex := previousIndex + entries.length
    let nextCommitIndex :=
      max
        (maxCommittableIndexAt
        (state.log message.dest)
        (min leaderCommitIndex requestEndIndex))
        (state.commitIndex message.dest)
    have commitMonotonic :
        state.commitIndex message.dest <= nextCommitIndex := by
      dsimp [nextCommitIndex]
      exact Nat.le_max_right _ _
    have advanced :=
      activeLogConfigurations_advanceCommit
        (state.log message.dest)
        (state.commitIndex message.dest)
        nextCommitIndex
        commitMonotonic
    rw [← exact message.dest] at advanced
    simpa [nextAppendEntriesAlreadyDone, updateNode, requestEndIndex,
      nextCommitIndex] using advanced
  · simpa [nextAppendEntriesAlreadyDone, updateNode, nodeIsDest] using
      exact node

private theorem appendEntriesNoConflict_log_eq_append
    (oldLog entries : List Entry)
    (previousIndex : Nat)
    (noConflict :
      appendEntriesNoConflictGuard
        {
          nodes := ∅
          currentTerm := NodeMap.const 0
          leadershipState := NodeMap.const .none
          log := NodeMap.const oldLog
          commitIndex := NodeMap.const 0
          votedFor := NodeMap.const none
          votesGranted := NodeMap.const ∅
          configurations := NodeMap.const []
          membershipState := NodeMap.const .active
          isNewFollower := NodeMap.const false
          hasJoined := NodeMap.const false
          retirementCompleted := NodeMap.const ∅
          messages := NodeMap.const (NodeMap.const [])
          sentIndex := NodeMap.const (NodeMap.const 0)
          matchIndex := NodeMap.const (NodeMap.const 0)
        }
        0
        previousIndex
        entries = true) :
    oldLog.take previousIndex ++ entries =
      oldLog ++ entries.drop (oldLog.length - previousIndex) := by
  simp [appendEntriesNoConflictGuard] at noConflict
  let overlap := oldLog.length - previousIndex
  have dropLength : (oldLog.drop previousIndex).length = overlap := by
    simp [overlap]
  have overlapEqual :
      oldLog.drop previousIndex = entries.take overlap := by
    have equal := noConflict.2
    change
      (oldLog.drop previousIndex).take overlap =
        entries.take overlap at equal
    calc
      oldLog.drop previousIndex =
          (oldLog.drop previousIndex).take overlap := by
        rw [← dropLength, List.take_length]
      _ = entries.take overlap := equal
  calc
    oldLog.take previousIndex ++ entries =
        oldLog.take previousIndex ++
          (entries.take overlap ++ entries.drop overlap) := by
      rw [List.take_append_drop]
    _ =
        (oldLog.take previousIndex ++ entries.take overlap) ++
          entries.drop overlap := by
      simp [List.append_assoc]
    _ =
        (oldLog.take previousIndex ++ oldLog.drop previousIndex) ++
          entries.drop overlap := by
      rw [overlapEqual]
    _ = oldLog ++ entries.drop overlap := by
      rw [List.take_append_drop]

theorem appendEntriesNoConflict_preserves_ConfigurationsExactInv
    (state : State)
    (message : Message)
    (previousIndex : Nat)
    (entries : List Entry)
    (leaderCommitIndex : Nat)
    (exact : ConfigurationsExactInv state)
    (commitWithin :
      state.commitIndex message.dest <= previousIndex)
    (noConflict :
      appendEntriesNoConflictGuard
        state message.dest previousIndex entries = true) :
    ConfigurationsExactInv
      (nextAppendEntriesNoConflict
        state message previousIndex entries leaderCommitIndex) := by
  simp [appendEntriesNoConflictGuard] at noConflict
  let oldLog := state.log message.dest
  let overlap := oldLog.length - previousIndex
  let newSuffix := entries.drop overlap
  let nextLog := oldLog.take previousIndex ++ entries
  let oldConfigurations :=
    activeLogConfigurations oldLog (state.commitIndex message.dest)
  let oldUpdates :=
    configurationsInEntries
      (previousIndex + 1)
      (oldLog.drop previousIndex)
  let newUpdates :=
    configurationsInEntries (1 + oldLog.length) newSuffix
  have previousWithin : previousIndex <= oldLog.length := by
    exact noConflict.1.1.2
  have overlapWithinEntries : overlap <= entries.length := by
    dsimp [overlap, oldLog]
    omega
  have dropLength : (oldLog.drop previousIndex).length = overlap := by
    simp [overlap]
  have overlapEqual :
      oldLog.drop previousIndex = entries.take overlap := by
    have equal := noConflict.2
    change
      (oldLog.drop previousIndex).take overlap =
        entries.take overlap at equal
    calc
      oldLog.drop previousIndex =
          (oldLog.drop previousIndex).take overlap := by
        rw [← dropLength, List.take_length]
      _ = entries.take overlap := equal
  have nextLogEqual :
      nextLog = oldLog ++ newSuffix := by
    dsimp [nextLog, newSuffix]
    calc
      oldLog.take previousIndex ++ entries =
          oldLog.take previousIndex ++
            (entries.take overlap ++ entries.drop overlap) := by
        rw [List.take_append_drop]
      _ =
          (oldLog.take previousIndex ++ entries.take overlap) ++
            entries.drop overlap := by
        simp [List.append_assoc]
      _ =
          (oldLog.take previousIndex ++ oldLog.drop previousIndex) ++
            entries.drop overlap := by
        rw [overlapEqual]
      _ = oldLog ++ entries.drop overlap := by
        rw [List.take_append_drop]
  have updatesSplit :
      configurationsInEntries (previousIndex + 1) entries =
        oldUpdates ++ newUpdates := by
    calc
      configurationsInEntries (previousIndex + 1) entries =
          configurationsInEntries
              (previousIndex + 1)
              (entries.take overlap) ++
            configurationsInEntries
              (previousIndex + 1 + (entries.take overlap).length)
              (entries.drop overlap) := by
        simpa [configurationsInEntries, List.take_append_drop] using
          configurationsInEntriesAux_append
            (previousIndex + 1)
            (entries.take overlap)
            (entries.drop overlap)
      _ = oldUpdates ++ newUpdates := by
        rw [← overlapEqual]
        have startEqual :
            previousIndex + 1 + (oldLog.length - previousIndex) =
              1 + oldLog.length := by
          omega
        simp [oldUpdates, newUpdates, newSuffix, startEqual]
  have oldUpdatesPresent :
      forall update,
        update ∈ oldUpdates ->
          update ∈ oldConfigurations := by
    intro update member
    have updateInDrop :
        update ∈
          configurationsInEntries
            (previousIndex + 1)
            (oldLog.drop previousIndex) := by
      simpa [oldUpdates] using member
    rw [logConfigurations_drop oldLog previousIndex] at updateInDrop
    have memberData :
        And
          (update ∈ logConfigurations oldLog)
          (previousIndex < update.index) := by
      simpa using updateInDrop
    have thresholdBefore :
        lastConfigurationToIndex
            (logConfigurations oldLog)
            (state.commitIndex message.dest) <=
          update.index := by
      exact Nat.le_trans
        (lastConfigurationToIndex_le
          (logConfigurations oldLog)
          (state.commitIndex message.dest))
        (Nat.le_trans commitWithin (Nat.le_of_lt memberData.2))
    simp [oldConfigurations, activeLogConfigurations,
      configurationsFromIndex, memberData.1, thresholdBefore]
  have oldIncreasing :
      increasingConfigurationIndices oldConfigurations :=
    increasing_activeLogConfigurations
      oldLog
      (state.commitIndex message.dest)
  have oldOverride :
      overrideConfigurations oldConfigurations oldUpdates =
        oldConfigurations :=
    overrideConfigurations_eq_self_of_mem
      oldConfigurations oldUpdates oldIncreasing oldUpdatesPresent
  have newIncreasing :
      increasingConfigurationIndices newUpdates :=
    increasing_configurationsInEntries
      (1 + oldLog.length)
      newSuffix
  have newAfterOld :
      forall existing update,
        existing ∈ oldConfigurations ->
          update ∈ newUpdates ->
            existing.index < update.index := by
    intro existing update existingMember updateMember
    have existingInLog :
        existing ∈ logConfigurations oldLog := by
      have memberData :
          And
            (existing ∈ logConfigurations oldLog)
            (lastConfigurationToIndex
                (logConfigurations oldLog)
                (state.commitIndex message.dest) <=
              existing.index) := by
        simpa [oldConfigurations, activeLogConfigurations,
          configurationsFromIndex] using existingMember
      exact memberData.1
    have existingBound :=
      mem_configurationsInEntriesAux
        1 oldLog existing existingInLog
    have updateBound :=
      mem_configurationsInEntriesAux
        (1 + oldLog.length) newSuffix update updateMember
    omega
  have newOverride :
      overrideConfigurations oldConfigurations newUpdates =
        oldConfigurations ++ newUpdates :=
    overrideConfigurations_eq_append_of_after
      oldConfigurations newUpdates newIncreasing newAfterOld
  have extendedExact :
      overrideConfigurations
          (state.configurations message.dest)
          (configurationsInEntries (previousIndex + 1) entries) =
        activeLogConfigurations
          nextLog
          (state.commitIndex message.dest) := by
    rw [exact message.dest]
    change
      overrideConfigurations
          oldConfigurations
          (configurationsInEntries (previousIndex + 1) entries) =
        activeLogConfigurations
          nextLog
          (state.commitIndex message.dest)
    rw [updatesSplit]
    change
      (oldUpdates ++ newUpdates).foldl
          upsertConfiguration
          oldConfigurations =
        activeLogConfigurations
          nextLog
          (state.commitIndex message.dest)
    rw [List.foldl_append]
    change
      overrideConfigurations
          (overrideConfigurations oldConfigurations oldUpdates)
          newUpdates =
        activeLogConfigurations
          nextLog
          (state.commitIndex message.dest)
    rw [oldOverride, newOverride, nextLogEqual]
    exact
      (activeLogConfigurations_append
        oldLog
        newSuffix
        (state.commitIndex message.dest)
        (Nat.le_trans commitWithin previousWithin)).symm
  intro node
  by_cases nodeIsDest : node = message.dest
  · subst node
    let requestEndIndex := previousIndex + entries.length
    let nextCommitIndex :=
      max
        (maxCommittableIndexAt
          nextLog
          (min leaderCommitIndex requestEndIndex))
        (state.commitIndex message.dest)
    have commitMonotonic :
        state.commitIndex message.dest <= nextCommitIndex := by
      dsimp [nextCommitIndex]
      exact Nat.le_max_right _ _
    have advanced :=
      activeLogConfigurations_advanceCommit
        nextLog
        (state.commitIndex message.dest)
        nextCommitIndex
        commitMonotonic
    rw [← extendedExact] at advanced
    simpa [nextAppendEntriesNoConflict, updateNode, oldLog, nextLog,
      requestEndIndex, nextCommitIndex] using advanced
  · simpa [nextAppendEntriesNoConflict, updateNode, nodeIsDest] using
      exact node

theorem previousIndex_lt_of_appendEntriesConflictGuard
    (state : State)
    (dest : Node)
    (previousIndex : Nat)
    (entries : List Entry)
    (conflict :
      appendEntriesConflictGuard
        state dest previousIndex entries = true) :
    previousIndex < (state.log dest).length := by
  simp [appendEntriesConflictGuard] at conflict
  by_contra notBeforeEnd
  have lengthWithin : (state.log dest).length <= previousIndex := by
    omega
  have dropped : (state.log dest).drop previousIndex = [] :=
    List.drop_eq_nil_of_le lengthWithin
  simp [dropped] at conflict

theorem receive_preserves_ConfigurationsExactInv
    (state : State)
    (dest source : Node)
    (kind : ReceiveKind)
    (exact : ConfigurationsExactInv state)
    (enabled : Enabled state (.receive dest source kind)) :
    ConfigurationsExactInv
      (next state (.receive dest source kind)) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simpa [next, rawNext, nextReceive, hmessage] using exact
  | some message =>
      cases kind with
      | appendEntriesAlreadyDone =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              simpa [next, rawNext, nextReceive, hmessage, hbody] using
                appendEntriesAlreadyDone_preserves_ConfigurationsExactInv
                  state
                  message
                  previousIndex
                  entries
                  commitIndex
                  exact
          | _ =>
              simpa [next, rawNext, nextReceive, hmessage, hbody] using
                exact
      | appendEntriesNoConflict =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              have branchEnabled := enabled
              simp [Enabled, actionEnabled, hmessage, receiveBranchEnabled,
                hbody, appendEntriesAcceptBase] at branchEnabled
              simpa [next, rawNext, nextReceive, hmessage, hbody] using
                appendEntriesNoConflict_preserves_ConfigurationsExactInv
                  state
                  message
                  previousIndex
                  entries
                  commitIndex
                  exact
                  branchEnabled.2.2.1.2
                  branchEnabled.2.2.2
          | _ =>
              simpa [next, rawNext, nextReceive, hmessage, hbody] using
                exact
      | appendEntriesConflictThenAlreadyDone =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              have branchEnabled := enabled
              simp [Enabled, actionEnabled, hmessage, receiveBranchEnabled,
                hbody, appendEntriesAcceptBase] at branchEnabled
              have destMatches : message.dest = dest :=
                branchEnabled.2.1.1
              subst dest
              have previousWithin :
                  previousIndex <= (state.log message.dest).length :=
                Nat.le_of_lt
                  (previousIndex_lt_of_appendEntriesConflictGuard
                    state
                    message.dest
                    previousIndex
                    entries
                    branchEnabled.2.2.1.2)
              have rolledExact :=
                conflictRollback_preserves_ConfigurationsExactInv
                  state
                  message.dest
                  previousIndex
                  exact
                  branchEnabled.2.2.1.1.2
                  previousWithin
              simpa [next, rawNext, nextReceive, hmessage, hbody] using
                appendEntriesAlreadyDone_preserves_ConfigurationsExactInv
                  (conflictRollback
                    state message.dest previousIndex)
                  message
                  previousIndex
                  entries
                  commitIndex
                  rolledExact
          | _ =>
              simpa [next, rawNext, nextReceive, hmessage, hbody] using
                exact
      | appendEntriesConflictThenNoConflict =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              commitIndex =>
              have branchEnabled := enabled
              simp [Enabled, actionEnabled, hmessage, receiveBranchEnabled,
                hbody, appendEntriesAcceptBase] at branchEnabled
              have destMatches : message.dest = dest :=
                branchEnabled.2.1.1
              subst dest
              have previousWithin :
                  previousIndex <= (state.log message.dest).length :=
                Nat.le_of_lt
                  (previousIndex_lt_of_appendEntriesConflictGuard
                    state
                    message.dest
                    previousIndex
                    entries
                    branchEnabled.2.2.1.2)
              have rolledExact :=
                conflictRollback_preserves_ConfigurationsExactInv
                  state
                  message.dest
                  previousIndex
                  exact
                  branchEnabled.2.2.1.1.2
                  previousWithin
              have rolledCommitWithin :
                  (conflictRollback
                      state message.dest previousIndex).commitIndex
                      message.dest <=
                    previousIndex := by
                simpa [conflictRollback, updateNode] using
                  branchEnabled.2.2.1.1.2
              simpa [next, rawNext, nextReceive, hmessage, hbody] using
                appendEntriesNoConflict_preserves_ConfigurationsExactInv
                  (conflictRollback
                    state message.dest previousIndex)
                  message
                  previousIndex
                  entries
                  commitIndex
                  rolledExact
                  rolledCommitWithin
                  branchEnabled.2.2.2
          | _ =>
              simpa [next, rawNext, nextReceive, hmessage, hbody] using
                exact
      | _ =>
          cases hbody : message.body <;>
            simp_all [ConfigurationsExactInv, activeLogConfigurations,
              next, rawNext, nextReceive]
          all_goals
            split <;> simp_all

theorem configurationsExact_step
    (state : State)
    (action : Action)
    (exact : ConfigurationsExactInv state)
    (signatures : SignatureInv state)
    (enabled : Enabled state action) :
    ConfigurationsExactInv (next state action) := by
  cases action with
  | timeout candidate =>
      exact timeout_preserves_ConfigurationsExactInv
        state candidate exact
  | requestVote source dest =>
      exact requestVote_preserves_ConfigurationsExactInv
        state source dest exact
  | appendEntries source dest =>
      exact appendEntries_preserves_ConfigurationsExactInv
        state source dest exact
  | becomeLeader leader =>
      exact becomeLeader_preserves_ConfigurationsExactInv
        state leader exact signatures
  | clientRequest leader =>
      exact clientRequest_preserves_ConfigurationsExactInv
        state leader exact
  | signCommittableMessages leader =>
      exact sign_preserves_ConfigurationsExactInv
        state leader exact
  | changeConfiguration leader configuration =>
      exact changeConfiguration_preserves_ConfigurationsExactInv
        state leader configuration exact signatures
  | advanceCommitIndex leader =>
      exact advanceCommitIndex_preserves_ConfigurationsExactInv
        state leader exact enabled
  | receive dest source kind =>
      exact receive_preserves_ConfigurationsExactInv
        state dest source kind exact enabled

theorem committed_prefix_of_preserved_prefix
    (oldLog newLog : List Entry)
    (oldCommit newCommit : Nat)
    (commitMonotonic : oldCommit <= newCommit)
    (prefixPreserved :
      oldLog.take oldCommit = newLog.take oldCommit) :
    oldLog.take oldCommit <+: newLog.take newCommit := by
  rw [prefixPreserved]
  exact List.take_isPrefix_take.mpr (Or.inl commitMonotonic)

theorem committedLogAppendOnly_of_monotonic
    (state : State)
    (action : Action)
    (signatures : SignatureInv state)
    (enabled : Enabled state action) :
    MonotonicCommitIndexProp state (next state action) ->
    CommittedLogAppendOnlyProp state (next state action) := by
  intro commitsMonotonic node
  apply committed_prefix_of_preserved_prefix
  · exact commitsMonotonic node
  · cases action with
    | timeout candidate =>
        simp [next, rawNext, nextTimeout]
    | requestVote source dest =>
        simp [next, rawNext, nextRequestVote]
    | appendEntries source dest =>
        simp [next, rawNext, nextAppendEntries]
    | becomeLeader leader =>
        by_cases nodeIsLeader : node = leader
        · subst node
          have commitWithin :
              state.commitIndex leader <=
                maxCommittableIndex (state.log leader) := by
            by_cases zeroCommit : state.commitIndex leader = 0
            · omega
            · exact index_le_maxCommittableIndex_of_signature
                (state.log leader)
                (state.commitIndex leader)
                (signatures leader (by omega))
          simp [next, rawNext, nextBecomeLeader, committable, logPrefix,
            List.take_take, Nat.min_eq_left commitWithin]
        · simp [next, rawNext, nextBecomeLeader, nodeIsLeader]
    | clientRequest leader =>
        by_cases nodeIsLeader : node = leader
        · subst node
          simp [next, rawNext, nextClientRequest,
            List.take_append_of_le_length
              (commitIndex_le_log_length state signatures leader)]
        · simp [next, rawNext, nextClientRequest, nodeIsLeader]
    | signCommittableMessages leader =>
        by_cases nodeIsLeader : node = leader
        · subst node
          simp [next, rawNext, nextSignCommittableMessages,
            List.take_append_of_le_length
              (commitIndex_le_log_length state signatures leader)]
        · simp [next, rawNext, nextSignCommittableMessages, nodeIsLeader]
    | changeConfiguration leader configuration =>
        by_cases nodeIsLeader : node = leader
        · subst node
          simp [next, rawNext, nextChangeConfiguration,
            List.take_append_of_le_length
              (commitIndex_le_log_length state signatures leader)]
        · simp [next, rawNext, nextChangeConfiguration, nodeIsLeader]
    | advanceCommitIndex leader =>
        simp [next, rawNext, nextAdvanceCommitIndex]
    | receive dest source kind =>
        cases hmessage : headMessage? state dest source with
        | none =>
            simp [next, rawNext, nextReceive, hmessage]
        | some message =>
            cases kind with
            | appendEntriesAlreadyDone =>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone]
            | rejectAppendEntriesRequest =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    commitIndex =>
                    cases responseCase :
                        appendEntriesRejectResponse?
                          state message previousIndex previousTerm with
                    | none =>
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
                    | some response =>
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
                | _ =>
                    simp [next, rawNext, nextReceive, hmessage, hbody]
            | appendEntriesNoConflict =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    commitIndex =>
                    have branchEnabled := enabled
                    simp [Enabled, actionEnabled, hmessage,
                      receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                    by_cases nodeIsDest : node = message.dest
                    · subst node
                      have commitWithin :
                          state.commitIndex message.dest <= previousIndex :=
                        branchEnabled.2.2.1.2
                      have logAfter :
                          (next state
                            (.receive dest source
                              .appendEntriesNoConflict)).log message.dest =
                            (state.log message.dest).take previousIndex ++
                              entries := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict]
                      rw [logAfter]
                      rw [List.take_append_of_le_length
                        (by
                          rw [List.length_take]
                          exact Nat.le_min.mpr
                            ⟨commitWithin,
                              commitIndex_le_log_length
                                state signatures message.dest⟩)]
                      rw [List.take_take, Nat.min_eq_left commitWithin]
                    · simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, nodeIsDest]
                | _ =>
                    simp [next, rawNext, nextReceive, hmessage, hbody]
            | appendEntriesConflictThenAlreadyDone =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    commitIndex =>
                    have branchEnabled := enabled
                    simp [Enabled, actionEnabled, hmessage,
                      receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                    have destMatches : message.dest = dest :=
                      branchEnabled.2.1.1
                    subst dest
                    by_cases nodeIsDest : node = message.dest
                    · subst node
                      have commitWithin :
                          state.commitIndex message.dest <= previousIndex :=
                        branchEnabled.2.2.1.1.2
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone, conflictRollback,
                        List.take_take, Nat.min_eq_left commitWithin]
                    · simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone, conflictRollback,
                        nodeIsDest]
                | _ =>
                    simp [next, rawNext, nextReceive, hmessage, hbody]
            | appendEntriesConflictThenNoConflict =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    commitIndex =>
                    have branchEnabled := enabled
                    simp [Enabled, actionEnabled, hmessage,
                      receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                    have destMatches : message.dest = dest :=
                      branchEnabled.2.1.1
                    subst dest
                    by_cases nodeIsDest : node = message.dest
                    · subst node
                      have commitWithin :
                          state.commitIndex message.dest <= previousIndex :=
                        branchEnabled.2.2.1.1.2
                      have logAfter :
                          (next state
                            (.receive message.dest source
                              .appendEntriesConflictThenNoConflict)).log
                                message.dest =
                            (state.log message.dest).take previousIndex ++
                              entries := by
                        simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, conflictRollback,
                          List.take_take]
                      rw [logAfter]
                      rw [List.take_append_of_le_length
                        (by
                          rw [List.length_take]
                          exact Nat.le_min.mpr
                            ⟨commitWithin,
                              commitIndex_le_log_length
                                state signatures message.dest⟩)]
                      rw [List.take_take, Nat.min_eq_left commitWithin]
                    · simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        nodeIsDest]
                | _ =>
                    simp [next, rawNext, nextReceive, hmessage, hbody]
            | _ =>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody]

theorem messagesWellFormed_step
    (state : State)
    (action : Action)
    (wellFormed : MessagesWellFormedInv state) :
    MessagesWellFormedInv (next state action) := by
  cases action with
  | timeout candidate =>
      simpa [MessagesWellFormedInv, next, rawNext, nextTimeout] using
        wellFormed
  | requestVote source dest =>
      simpa [MessagesWellFormedInv, next, rawNext, nextRequestVote] using
        enqueue_preserves_MessageChannelsWellFormed
          state.messages
          (requestVoteMessage state source dest)
          wellFormed
  | appendEntries source dest =>
      simpa [MessagesWellFormedInv, next, rawNext, nextAppendEntries] using
        enqueue_preserves_MessageChannelsWellFormed
          state.messages
          (appendEntriesMessage state source dest)
          wellFormed
  | becomeLeader leader =>
      simpa [MessagesWellFormedInv, next, rawNext, nextBecomeLeader] using
        wellFormed
  | clientRequest leader =>
      simpa [MessagesWellFormedInv, next, rawNext, nextClientRequest] using
        wellFormed
  | signCommittableMessages leader =>
      simpa [MessagesWellFormedInv, next, rawNext,
        nextSignCommittableMessages] using wellFormed
  | changeConfiguration leader configuration =>
      simpa [MessagesWellFormedInv, next, rawNext,
        nextChangeConfiguration] using wellFormed
  | advanceCommitIndex leader =>
      simpa [MessagesWellFormedInv, next, rawNext,
        nextAdvanceCommitIndex] using wellFormed
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [MessagesWellFormedInv, next, rawNext, nextReceive,
            hmessage] using wellFormed
      | some message =>
          cases kind <;>
            cases hbody : message.body <;>
              simp_all [MessagesWellFormedInv, next, rawNext, nextReceive,
                nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
                conflictRollback]
          all_goals
            split <;> simp_all

theorem termDelta
    (state : State)
    (action : Action)
    (_enabled : Enabled state action) :
    TermDelta state (next state action) := by
  constructor
  intro node
  cases action with
  | timeout candidate =>
      by_cases h : node = candidate
      · subst node
        simp [next, rawNext, nextTimeout]
      · simp [next, rawNext, nextTimeout, h]
  | requestVote source dest =>
      simp [next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      simp [next, rawNext, nextAppendEntries]
  | becomeLeader leader =>
      simp [next, rawNext, nextBecomeLeader]
  | clientRequest leader =>
      simp [next, rawNext, nextClientRequest]
  | signCommittableMessages leader =>
      simp [next, rawNext, nextSignCommittableMessages]
  | changeConfiguration leader configuration =>
      simp [next, rawNext, nextChangeConfiguration]
  | advanceCommitIndex leader =>
      simp [next, rawNext, nextAdvanceCommitIndex]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [next, rawNext, nextReceive, hmessage]
      | some message =>
          cases kind <;>
            cases hbody : message.body <;>
              simp_all [next, rawNext, nextReceive, Enabled,
                actionEnabled, receiveBranchEnabled, updateTermEnabled,
                nextAppendEntriesAlreadyDone, nextAppendEntriesNoConflict,
                conflictRollback]
          all_goals
            split <;> simp_all
          all_goals
            rw [← _enabled.2.1.1]
            exact Nat.le_of_lt _enabled.2.2

theorem monotonicTerm_step
    (state : State)
    (action : Action)
    (enabled : Enabled state action) :
    MonotonicTermProp state (next state action) :=
  (termDelta state action enabled).monotonic

private theorem replays_currentTerm_mono
    {before after : State}
    {actions : List Action}
    (replay : Replays before actions after) :
    forall node : Node,
      before.currentTerm node <= after.currentTerm node := by
  induction actions generalizing before with
  | nil =>
      simp [Replays] at replay
      subst after
      intro node
      exact Nat.le_refl _
  | cons action tail inductionHypothesis =>
      rcases replay with ⟨enabled, tailReplay⟩
      intro node
      exact Nat.le_trans
        (monotonicTerm_step before action enabled node)
        (inductionHypothesis tailReplay node)

theorem historicalLeaderToCurrentCandidateTerm_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (leaderTerms :
      HistoricalLeaderToCurrentCandidateTermInv
        start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalLeaderToCurrentCandidateTermInv
      start
      (actions ++ [action])
      (next state action) := by
  intro historicalState stateAt node historicalLeader currentCandidate
  rcases stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · by_cases isTimeout :
        Exists fun timedOut : Node =>
          action = .timeout timedOut
    · rcases isTimeout with ⟨timedOut, rfl⟩
      by_cases nodeIsTimedOut : node = timedOut
      · subst node
        rcases oldState with ⟨trace⟩
        have historicalLeCurrent :=
          replays_currentTerm_mono trace.remainingHistory timedOut
        simpa [next, rawNext, nextTimeout] using
          Nat.lt_succ_of_le historicalLeCurrent
      · have beforeCandidate :
            state.leadershipState node = .candidate := by
          simpa [next, rawNext, nextTimeout, updateNode,
            nodeIsTimedOut] using currentCandidate
        exact Nat.lt_of_lt_of_le
          (leaderTerms
            historicalState oldState node historicalLeader beforeCandidate)
          (monotonicTerm_step
            state (.timeout timedOut) enabled node)
    · have beforeCandidate :
          state.leadershipState node = .candidate :=
        candidate_before_of_candidate_after
          state action node currentCandidate
          (by
            intro timedOut actionEq
            exact isTimeout ⟨timedOut, actionEq⟩)
      exact Nat.lt_of_lt_of_le
        (leaderTerms
          historicalState oldState node historicalLeader beforeCandidate)
        (monotonicTerm_step state action enabled node)
  · subst historicalState
    rw [historicalLeader] at currentCandidate
    contradiction

theorem protocolHistory_implies_HistoricalLeaderToCurrentCandidateTermInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    HistoricalLeaderToCurrentCandidateTermInv
      start actions state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun actions state =>
        HistoricalLeaderToCurrentCandidateTermInv
          start actions state)
      (initial_HistoricalLeaderToCurrentCandidateTermInv start)
      (by
        intro past current pastHistory leaderTerms action enabled
        exact historicalLeaderToCurrentCandidateTerm_append_step
          pastHistory leaderTerms action enabled)
      history

private theorem persistentLeader_logPrefix_step
    (state : State)
    (action : Action)
    (leader : Node)
    (enabled : Enabled state action)
    (oldLeader : state.leadershipState leader = .leader)
    (newLeader :
      (next state action).leadershipState leader = .leader) :
    isLogPrefix
      (state.log leader)
      ((next state action).log leader) := by
  cases action with
  | timeout timedOut =>
      by_cases leaderIsTimedOut : leader = timedOut
      · subst leader
        simp [Enabled, actionEnabled, oldLeader] at enabled
      · simp [isLogPrefix, next, rawNext, nextTimeout]
  | requestVote source dest =>
      simp [isLogPrefix, next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      simp [isLogPrefix, next, rawNext, nextAppendEntries]
  | becomeLeader elected =>
      by_cases leaderIsElected : leader = elected
      · subst leader
        simp [Enabled, actionEnabled, oldLeader] at enabled
      · simp [isLogPrefix, next, rawNext, nextBecomeLeader,
          leaderIsElected]
  | clientRequest node =>
      by_cases leaderIsNode : leader = node
      · subst leader
        simp [isLogPrefix, next, rawNext, nextClientRequest]
      · simp [isLogPrefix, next, rawNext, nextClientRequest,
          leaderIsNode]
  | signCommittableMessages node =>
      by_cases leaderIsNode : leader = node
      · subst leader
        simp [isLogPrefix, next, rawNext,
          nextSignCommittableMessages]
      · simp [isLogPrefix, next, rawNext,
          nextSignCommittableMessages, leaderIsNode]
  | changeConfiguration node configuration =>
      by_cases leaderIsNode : leader = node
      · subst leader
        simp [isLogPrefix, next, rawNext, nextChangeConfiguration]
      · simp [isLogPrefix, next, rawNext, nextChangeConfiguration,
          leaderIsNode]
  | advanceCommitIndex node =>
      simp [isLogPrefix, next, rawNext, nextAdvanceCommitIndex]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [isLogPrefix, next, rawNext, nextReceive, hmessage]
      | some message =>
          cases kind with
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at branchEnabled
                  have messageDest : message.dest = dest :=
                    branchEnabled.2.1.1
                  have acceptFacts := branchEnabled.2.2.1
                  simp [appendEntriesAcceptBase] at acceptFacts
                  have leaderIsNotDest : leader ≠ dest := by
                    intro leaderIsDest
                    subst leader
                    rcases acceptFacts.1.1.2 with follower | none
                    · have destFollower :
                          state.leadershipState dest = .follower := by
                        simpa [messageDest] using follower
                      rw [destFollower] at oldLeader
                      contradiction
                    · have destNone :
                          state.leadershipState dest = .none := by
                        simpa [messageDest] using none
                      rw [destNone] at oldLeader
                      contradiction
                  simp [isLogPrefix, next, rawNext, nextReceive,
                    hmessage, hbody, nextAppendEntriesNoConflict,
                    messageDest, leaderIsNotDest]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at branchEnabled
                  have messageDest : message.dest = dest :=
                    branchEnabled.2.1.1
                  have acceptFacts := branchEnabled.2.2.1.1
                  simp [appendEntriesAcceptBase] at acceptFacts
                  have leaderIsNotDest : leader ≠ dest := by
                    intro leaderIsDest
                    subst leader
                    rcases acceptFacts.1.1.2 with follower | none
                    · have destFollower :
                          state.leadershipState dest = .follower := by
                        simpa [messageDest] using follower
                      rw [destFollower] at oldLeader
                      contradiction
                    · have destNone :
                          state.leadershipState dest = .none := by
                        simpa [messageDest] using none
                      rw [destNone] at oldLeader
                      contradiction
                  simp [isLogPrefix, next, rawNext, nextReceive,
                    hmessage, hbody, nextAppendEntriesAlreadyDone,
                    conflictRollback, messageDest, leaderIsNotDest]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at branchEnabled
                  have messageDest : message.dest = dest :=
                    branchEnabled.2.1.1
                  have acceptFacts := branchEnabled.2.2.1.1
                  simp [appendEntriesAcceptBase] at acceptFacts
                  have leaderIsNotDest : leader ≠ dest := by
                    intro leaderIsDest
                    subst leader
                    rcases acceptFacts.1.1.2 with follower | none
                    · have destFollower :
                          state.leadershipState dest = .follower := by
                        simpa [messageDest] using follower
                      rw [destFollower] at oldLeader
                      contradiction
                    · have destNone :
                          state.leadershipState dest = .none := by
                        simpa [messageDest] using none
                      rw [destNone] at oldLeader
                      contradiction
                  simp [isLogPrefix, next, rawNext, nextReceive,
                    hmessage, hbody, nextAppendEntriesNoConflict,
                    conflictRollback, messageDest, leaderIsNotDest]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | _ =>
              cases hbody : message.body <;>
                simp [isLogPrefix, next, rawNext, nextReceive,
                  hmessage, hbody, nextAppendEntriesAlreadyDone]
              all_goals
                split <;> simp

private theorem persistentLeader_currentTerm_step
    (state : State)
    (action : Action)
    (leader : Node)
    (newLeader :
      (next state action).leadershipState leader = .leader) :
    (next state action).currentTerm leader =
      state.currentTerm leader := by
  cases action with
  | timeout timedOut =>
      by_cases leaderIsTimedOut : leader = timedOut
      · subst leader
        simp [next, rawNext, nextTimeout, updateNode] at newLeader
      · simp [next, rawNext, nextTimeout, updateNode,
          leaderIsTimedOut]
  | requestVote source dest =>
      simp [next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      simp [next, rawNext, nextAppendEntries]
  | becomeLeader elected =>
      simp [next, rawNext, nextBecomeLeader]
  | clientRequest node =>
      simp [next, rawNext, nextClientRequest]
  | signCommittableMessages node =>
      simp [next, rawNext, nextSignCommittableMessages]
  | changeConfiguration node configuration =>
      simp [next, rawNext, nextChangeConfiguration]
  | advanceCommitIndex node =>
      simp [next, rawNext, nextAdvanceCommitIndex]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [next, rawNext, nextReceive, hmessage]
      | some message =>
          cases kind with
          | updateTerm =>
              by_cases leaderIsDest : leader = dest
              · subst leader
                cases hrole : state.leadershipState dest <;>
                  simp [next, rawNext, nextReceive, hmessage,
                    updateNode, hrole] at newLeader
              · simp [next, rawNext, nextReceive, hmessage,
                  updateNode, leaderIsDest]
          | _ =>
              cases hbody : message.body <;>
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone,
                  nextAppendEntriesNoConflict, conflictRollback]
              all_goals
                split <;> simp

theorem historicalSameLeaderLogPrefix_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (prefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalSameLeaderLogPrefixInv
      start
      (actions ++ [action])
      (next state action) := by
  have leaderTerms :=
    protocolHistory_implies_HistoricalLeaderToCurrentCandidateTermInv
      history
  intro historicalState stateAt leader historicalLeader currentLeader
    sameTerm
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · by_cases isElection :
        Exists fun elected : Node =>
          action = .becomeLeader elected
    · rcases isElection with ⟨elected, rfl⟩
      by_cases leaderIsElected : leader = elected
      · subst leader
        have currentCandidate :
            state.leadershipState elected = .candidate := by
          have enabledFacts := enabled
          simp [Enabled, actionEnabled] at enabledFacts
          exact enabledFacts.1.2
        have strictGrowth :=
          leaderTerms
            historicalState oldState elected historicalLeader
            currentCandidate
        have unchangedTerm :
            (next state (.becomeLeader elected)).currentTerm elected =
              state.currentTerm elected := by
          simp [next, rawNext, nextBecomeLeader]
        exact False.elim
          ((Nat.ne_of_lt strictGrowth)
            (sameTerm.trans unchangedTerm))
      · have oldLeader :
            state.leadershipState leader = .leader := by
          simpa [next, rawNext, nextBecomeLeader, updateNode,
            leaderIsElected] using currentLeader
        have oldSameTerm :
            historicalState.currentTerm leader =
              state.currentTerm leader := by
          simpa [next, rawNext, nextBecomeLeader] using sameTerm
        have oldPrefix :=
          prefixes
            historicalState oldState leader historicalLeader
            oldLeader oldSameTerm
        simpa [isLogPrefix, next, rawNext, nextBecomeLeader,
          leaderIsElected] using oldPrefix
    · have oldLeader :=
        leader_before_of_leader_after
          state action leader currentLeader
          (by
            intro elected actionEq
            exact isElection ⟨elected, actionEq⟩)
      have stepTerm :=
        persistentLeader_currentTerm_step
          state action leader currentLeader
      have oldPrefix :=
        prefixes
          historicalState oldState leader historicalLeader oldLeader
          (sameTerm.trans stepTerm)
      exact
        oldPrefix.trans
          (persistentLeader_logPrefix_step
            state action leader enabled oldLeader currentLeader)
  · subst historicalState
    exact List.prefix_rfl

theorem protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    HistoricalSameLeaderLogPrefixInv start actions state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun actions state =>
        HistoricalSameLeaderLogPrefixInv start actions state)
      (initial_HistoricalSameLeaderLogPrefixInv start)
      (by
        intro past current pastHistory prefixes action enabled
        exact
          historicalSameLeaderLogPrefix_append_step
            pastHistory prefixes action enabled)
      history

theorem reachable_hasHistoricalSameLeaderLogPrefix
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (HistoricalSameLeaderLogPrefixInv start actions state) := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := fun current =>
        Exists fun actions =>
          And
            (ProtocolHistory start actions current)
            (HistoricalSameLeaderLogPrefixInv start actions current))
  · exact
      ⟨[],
        rfl,
        initial_HistoricalSameLeaderLogPrefixInv start⟩
  · intro current action historical enabled
    rcases historical with ⟨actions, history, prefixes⟩
    exact
      ⟨actions ++ ([action] : List Action),
        replays_append_singleton history enabled,
        historicalSameLeaderLogPrefix_append_step
          history prefixes action enabled⟩
  · exact reachable

theorem monoLogEntries_of_isLogPrefix
    (prefixEntries entries : List Entry)
    (mono : monoLogEntries entries)
    (isPrefix : isLogPrefix prefixEntries entries) :
    monoLogEntries prefixEntries := by
  rcases isPrefix with ⟨suffix, rfl⟩
  simpa using
    monoLogEntries_take
      (prefixEntries ++ suffix)
      prefixEntries.length
      mono

theorem isLogPrefix_lastTerm_le_of_monoLogEntries
    (first second : List Entry)
    (firstTerm secondTerm : Nat)
    (isPrefix : isLogPrefix first second)
    (mono : monoLogEntries second)
    (firstLast :
      first.getLast?.map (·.term) = some firstTerm)
    (secondLast :
      second.getLast?.map (·.term) = some secondTerm) :
    firstTerm <= secondTerm := by
  cases firstLastEntry : first.getLast? with
  | none =>
      simp [firstLastEntry] at firstLast
  | some firstEntry =>
      have firstEntryTerm : firstEntry.term = firstTerm := by
        simpa [firstLastEntry] using firstLast
      have firstMember : firstEntry ∈ first := by
        rcases List.getLast?_eq_some_iff.mp firstLastEntry with
          ⟨prefixEntries, rfl⟩
        simp
      have bound :=
        monoLogEntries_member_le_lastTerm
          second
          firstEntry
          mono
          (isPrefix.mem firstMember)
      cases secondLastEntry : second.getLast? with
      | none =>
          simp [secondLastEntry] at secondLast
      | some secondEntry =>
          have secondEntryTerm :
              secondEntry.term = secondTerm := by
            simpa [secondLastEntry] using secondLast
          simpa
            [firstEntryTerm, secondEntryTerm, secondLastEntry]
            using bound

theorem chosenCommitCertificate_chosenPrefix_lastTerm
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index) :
    certificate.chosenPrefix.getLast?.map (·.term) =
      some certificate.boundaryTerm := by
  have indexNonzero : index ≠ 0 := by
    intro indexZero
    subst index
    have boundaryTerm := certificate.boundary_term
    simp [entryAt?] at boundaryTerm
  cases atIndex :
      entryAt? (boundaryState.log owner) index with
  | none =>
      have boundaryTerm := certificate.boundary_term
      simp [atIndex] at boundaryTerm
  | some entry =>
      have entryTerm :
          entry.term = certificate.boundaryTerm := by
        simpa [atIndex] using certificate.boundary_term
      have getElemAt :
          (boundaryState.log owner)[index - 1]? =
            some entry := by
        simpa [entryAt?, indexNonzero] using atIndex
      rw [certificate.prefix_eq]
      simp [logPrefix, List.getLast?_take, indexNonzero,
        getElemAt, entryTerm]

theorem chosenCommitCertificate_chosenPrefix_length
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index) :
    certificate.chosenPrefix.length = index := by
  cases atIndex :
      entryAt? (boundaryState.log owner) index with
  | none =>
      have boundaryTerm := certificate.boundary_term
      simp [atIndex] at boundaryTerm
  | some entry =>
      have within :
          index <= (boundaryState.log owner).length := by
        unfold entryAt? at atIndex
        split at atIndex
        · contradiction
        · have bound :=
            (List.getElem?_eq_some_iff.mp atIndex).choose
          omega
      rw [certificate.prefix_eq]
      simp [logPrefix, List.length_take, Nat.min_eq_left within]

theorem chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index) :
    isLogPrefix
      certificate.chosenPrefix
      (certificate.choiceState.log certificate.choiceLeader) := by
  rw [certificate.choice_prefix_eq]
  exact List.take_prefix index _

theorem commitChoiceOrigin_commitIndex_le_choiceIndex
    {start : InitialConfiguration}
    {actions : List Action}
    {endState choiceState : State}
    {leader : Node}
    {index : Nat}
    (origin :
      CommitChoiceOrigin
        start actions endState choiceState leader index) :
    choiceState.commitIndex leader <= index := by
  cases origin with
  | initial stateEq leaderEq indexEq =>
      subst choiceState
      subst leader
      subst index
      simp [initialState, startLog, start.leader_mem]
  | advance occurrence indexEq =>
      rcases occurrence with ⟨witness⟩
      have enabled := witness.enabled
      simp [Enabled, actionEnabled] at enabled
      rw [indexEq]
      omega

theorem chosenCommitCertificate_configuration_in_choiceLog
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index) :
    And
      (certificate.configuration ∈
        logConfigurations
          (certificate.choiceState.log certificate.choiceLeader))
      (certificate.configuration.index <= index) := by
  have selectedFacts :=
    committedConfigurationAt?_some_properties
      (boundaryState.log owner)
      index
      certificate.configuration
      certificate.configuration_at
  have inBoundaryPrefix :
      certificate.configuration ∈
        logConfigurations ((boundaryState.log owner).take index) := by
    rw [logConfigurations_take]
    simpa [configurationsToIndex] using selectedFacts
  have prefixesEq :
      (boundaryState.log owner).take index =
        (certificate.choiceState.log certificate.choiceLeader).take
          index :=
    certificate.prefix_eq.symm.trans certificate.choice_prefix_eq
  have inChoicePrefix :
      certificate.configuration ∈
        logConfigurations
          ((certificate.choiceState.log certificate.choiceLeader).take
            index) := by
    rw [← prefixesEq]
    exact inBoundaryPrefix
  rw [logConfigurations_take] at inChoicePrefix
  simpa [configurationsToIndex] using inChoicePrefix

theorem chosenCommitCertificate_configuration_mem_choiceConfigurations
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (configurationsExact :
      ConfigurationsExactInv certificate.choiceState) :
    certificate.configuration ∈
      certificate.choiceState.configurations
        certificate.choiceLeader := by
  have configurationFacts :=
    chosenCommitCertificate_configuration_in_choiceLog certificate
  have selectedIndex :=
    committedConfigurationAt?_index_eq_lastConfigurationToIndex
      (boundaryState.log owner)
      index
      certificate.configuration
      certificate.configuration_at
  have prefixesEq :
      (boundaryState.log owner).take index =
        (certificate.choiceState.log certificate.choiceLeader).take
          index :=
    certificate.prefix_eq.symm.trans certificate.choice_prefix_eq
  have filteredEq := congrArg logConfigurations prefixesEq
  rw [logConfigurations_take, logConfigurations_take] at filteredEq
  have lastEq :=
    congrArg
      (fun configurations =>
        lastConfigurationToIndex configurations index)
      filteredEq
  change
    lastConfigurationToIndex
          (configurationsToIndex
            (logConfigurations (boundaryState.log owner))
            index)
          index =
      lastConfigurationToIndex
        (configurationsToIndex
          (logConfigurations
            (certificate.choiceState.log certificate.choiceLeader))
          index)
        index at lastEq
  rw [lastConfigurationToIndex_configurationsToIndex
        _ index index (Nat.le_refl _),
      lastConfigurationToIndex_configurationsToIndex
        _ index index (Nat.le_refl _)] at lastEq
  have configurationIndexAtChoice :
      certificate.configuration.index =
        lastConfigurationToIndex
          (logConfigurations
            (certificate.choiceState.log certificate.choiceLeader))
          index :=
    selectedIndex.trans lastEq
  have thresholdLe :
      lastConfigurationToIndex
          (logConfigurations
            (certificate.choiceState.log certificate.choiceLeader))
          (certificate.choiceState.commitIndex
            certificate.choiceLeader) <=
        certificate.configuration.index := by
    rw [configurationIndexAtChoice]
    exact
      lastConfigurationToIndex_mono
        _
        _
        _
        certificate.choice_commit_le_boundary
  rw [configurationsExact certificate.choiceLeader]
  simp [activeLogConfigurations, configurationsFromIndex,
    configurationFacts.1, thresholdLe]

