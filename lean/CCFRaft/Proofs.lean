    {action : Action}
    {term : Nat}
    (witness :
      EntryTermLeaderWitness start actions state term)
    (enabled : Enabled state action) :
    EntryTermLeaderWitness
      start
      (actions ++ [action])
      (next state action)
      term :=
  {
    appendState := witness.appendState
    leader := witness.leader
