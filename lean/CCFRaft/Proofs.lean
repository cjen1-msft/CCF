    (formation :
      QuorumCandidateFormationAction
        state action formedCandidate)
    (enabled : Enabled state action)
    (formedState :
      (next state action).leadershipState formedCandidate =
        .candidate)
    (formedQuorum :
      allConfigurationsHaveQuorum
          ((next state action).votesGranted formedCandidate)
          ((next state action).configurations formedCandidate) =
        true)
    (otherAt :
      StateAt start actions state otherState)
    (otherCandidateState :
      otherState.leadershipState otherCandidate = .candidate)
    (otherQuorum :
      allConfigurationsHaveQuorum
          (otherState.votesGranted otherCandidate)
          (otherState.configurations otherCandidate) =
        true)
    (sameTerm :
      (next state action).currentTerm formedCandidate =
        otherState.currentTerm otherCandidate) :
    Exists fun formedConfiguration : ConfigurationAt =>
      Exists fun otherConfiguration : ConfigurationAt =>
        And
          (formedConfiguration ∈
            state.configurations formedCandidate)
          (And
            (otherConfiguration ∈
              otherState.configurations otherCandidate)
            (formedConfiguration.nodes =
              otherConfiguration.nodes)) := by
  rcases
      quorumFormation_candidateWitness_before
        history core formation enabled formedState with
    ⟨formedWitness⟩
  rcases otherAt with ⟨endpoint⟩
  rcases
      currentCandidateChosenConfigurationWitness_at_stateAtWitness
        prefixCores endpoint otherCandidate otherCandidateState with
    ⟨otherWitness⟩
  rcases
      chosenCommitCertificate_stateAtWitness_coherent
        endpoint
        prefixCores
        otherWitness.basis.certificate
        otherWitness.basis.boundary with
    ⟨target, extension⟩
  have targetEarlier :
      target.choiceTerm <
        (next state action).currentTerm formedCandidate := by
    rw [extension.choiceTerm_eq, sameTerm]
    exact otherWitness.choice_term_lt_candidate
  have formedCarriesOther :
      isLogPrefix
        otherWitness.basis.certificate.chosenPrefix
        (state.log formedCandidate) := by
    have carries :=
      quorumFormation_candidate_carries_chosenPrefix
        history core formedWitness.basis target
        otherWitness.basis.boundary
        targetEarlier formation formedQuorum enabled
    rw [extension.chosenPrefix_eq] at carries
    exact carries
  have formedEarlier :=
    quorumFormation_candidateWitness_choiceTerm_lt
      history core formedWitness formation enabled formedState
  rw [sameTerm] at formedEarlier
  have otherCarriesFormed :
      isLogPrefix
        formedWitness.basis.certificate.chosenPrefix
        (otherState.log otherCandidate) :=
    formedWitness.basis.certificate.counted_candidate_barrier
      otherState
      ⟨endpoint⟩
      otherCandidate
      otherCandidateState
      formedEarlier
      otherQuorum
  exact
    candidateChosenConfigurations_overlap_of_mutual_carry
      formedWitness.basis
      otherWitness.basis
      (reachable_ConfigurationsExactInv
        start (protocolHistory_reachable history))
      (reachable_ConfigurationsExactInv
        start (stateAt_reachable ⟨endpoint⟩))
      formedCarriesOther
      otherCarriesFormed

