    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    MatchIndexHistoryConsistent start actions state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun actions state =>
        MatchIndexHistoryConsistent start actions state)
      (initial_MatchIndexHistoryConsistent start)
      (by
        intro past current pastHistory matchHistory action enabled
        have acks :=
          queueHistory_implies_SuccessfulAckHistoryConsistent
            (protocolHistory_implies_QueueHistoryConsistent
              pastHistory)
        exact
          matchIndexHistory_append_step
            pastHistory matchHistory acks action enabled)
      history

theorem reachable_hasMatchIndexHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (MatchIndexHistoryConsistent start actions state) := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := fun current =>
        Exists fun actions =>
          And
            (ProtocolHistory start actions current)
            (MatchIndexHistoryConsistent start actions current))
  · exact
      ⟨[],
        rfl,
        initial_MatchIndexHistoryConsistent start⟩
  · intro current action historical enabled
    change Action at action
    rcases historical with ⟨actions, protocol, matchHistory⟩
    have queues :=
      protocolHistory_implies_QueueHistoryConsistent protocol
    have acks :=
      queueHistory_implies_SuccessfulAckHistoryConsistent queues
    exact
      ⟨actions ++ [action],
        replays_append_singleton protocol enabled,
        matchIndexHistory_append_step
          protocol matchHistory acks action enabled⟩
  · exact reachable

private structure CurrentTermMatchIndexWitness
    (start : InitialConfiguration)
    (actions : List Action)
    (state : State)
    (leader follower : Node) where
  witness :
    MatchIndexWitness start actions state leader follower
  response_term :
    witness.response.term = state.currentTerm leader

private def CurrentTermMatchIndexHistoryConsistent
    (start : InitialConfiguration)
    (actions : List Action)
    (state : State) : Prop :=
  forall leader follower,
    state.leadershipState leader = .leader ->
      0 < state.matchIndex leader follower ->
        Nonempty
          (CurrentTermMatchIndexWitness
            start actions state leader follower)

private theorem positiveMatchIndex_leader_before
    (state : State)
    (action : Action)
    (leader follower : Node)
    (afterLeader :
      (next state action).leadershipState leader = .leader)
    (afterPositive :
      0 < (next state action).matchIndex leader follower) :
    state.leadershipState leader = .leader := by
  by_cases isElection :
      Exists fun elected : Node =>
        action = .becomeLeader elected
  · rcases isElection with ⟨elected, rfl⟩
    by_cases leaderIsElected : leader = elected
    · subst leader
      simp [next, rawNext, nextBecomeLeader, updateNode] at afterPositive
    · simpa [next, rawNext, nextBecomeLeader, updateNode,
        leaderIsElected] using afterLeader
  · exact
      leader_before_of_leader_after
        state
        action
        leader
        afterLeader
        (by
          intro elected equality
          exact isElection ⟨elected, equality⟩)

private theorem currentTermMatchIndexHistory_retain
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history :
      CurrentTermMatchIndexHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (leader follower : Node)
    (afterLeader :
      (next state action).leadershipState leader = .leader)
    (indexEq :
      (next state action).matchIndex leader follower =
        state.matchIndex leader follower)
    (afterPositive :
      0 < (next state action).matchIndex leader follower) :
    Nonempty
      (CurrentTermMatchIndexWitness
        start
        (actions ++ [action])
        (next state action)
        leader
        follower) := by
  have oldLeader :
      state.leadershipState leader = .leader :=
    positiveMatchIndex_leader_before
      state action leader follower afterLeader afterPositive
  have oldPositive :
      0 < state.matchIndex leader follower := by
    rw [← indexEq]
    exact afterPositive
  rcases history leader follower oldLeader oldPositive with
    ⟨historical⟩
  exact ⟨{
    witness :=
      matchIndexWitness_extend historical.witness enabled indexEq
    response_term :=
      historical.response_term.trans
        (persistentLeader_currentTerm_step
          state action leader afterLeader).symm
  }⟩

private theorem initial_CurrentTermMatchIndexHistoryConsistent
    (start : InitialConfiguration) :
    CurrentTermMatchIndexHistoryConsistent
      start [] (initialState start) := by
  intro leader follower _ positive
  simp [initialState] at positive

private theorem currentTermMatchIndexHistory_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (protocol : ProtocolHistory start actions state)
    (history :
      CurrentTermMatchIndexHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    CurrentTermMatchIndexHistoryConsistent
      start
      (actions ++ [action])
      (next state action) := by
  intro leader follower afterLeader afterPositive
  by_cases indexEq :
      (next state action).matchIndex leader follower =
        state.matchIndex leader follower
  · exact
      currentTermMatchIndexHistory_retain
        history action enabled leader follower
        afterLeader indexEq afterPositive
  · cases action with
    | timeout candidate =>
        simp [next, rawNext, nextTimeout] at indexEq
    | requestVote source dest =>
        simp [next, rawNext, nextRequestVote] at indexEq
    | appendEntries source dest =>
        simp [next, rawNext, nextAppendEntries] at indexEq
    | becomeLeader elected =>
        by_cases leaderIsElected : leader = elected
        · subst leader
          simp [next, rawNext, nextBecomeLeader, updateNode] at afterPositive
        · simp [next, rawNext, nextBecomeLeader, updateNode,
            leaderIsElected] at indexEq
    | clientRequest node =>
        simp [next, rawNext, nextClientRequest] at indexEq
    | signCommittableMessages node =>
        simp [next, rawNext, nextSignCommittableMessages] at indexEq
    | changeConfiguration node configuration =>
        simp [next, rawNext, nextChangeConfiguration] at indexEq
    | advanceCommitIndex node =>
        simp [next, rawNext, nextAdvanceCommitIndex] at indexEq
    | receive receiveDest receiveSource kind =>
        cases hmessage :
            headMessage? state receiveDest receiveSource with
        | none =>
            simp [next, rawNext, nextReceive, hmessage] at indexEq
        | some message =>
            cases kind with
            | handleAppendEntriesResponseSuccess =>
                cases hbody : message.body with
                | appendEntriesResponse success lastLogIndex =>
                    cases success with
                    | false =>
                        simp [Enabled, actionEnabled, hmessage,
                          receiveBranchEnabled, hbody] at enabled
                    | true =>
                        have leaderIsDest :
                            leader = receiveDest := by
                          by_contra notDest
                          simp [next, rawNext, nextReceive, hmessage,
                            hbody, update₂, notDest] at indexEq
                        subst leader
                        have followerIsSource :
                            follower = receiveSource := by
                          by_contra notSource
                          simp [next, rawNext, nextReceive, hmessage,
                            hbody, update₂, notSource] at indexEq
                        subst follower
                        have oldIndexBound :
                            state.matchIndex
                                receiveDest receiveSource <=
                              lastLogIndex := by
                          by_contra notBounded
                          have lastIndexWithin :
                              lastLogIndex <=
                                state.matchIndex
                                  receiveDest receiveSource :=
                            Nat.le_of_lt
                              (Nat.lt_of_not_ge notBounded)
                          simp [next, rawNext, nextReceive, hmessage,
                            hbody, update₂, Nat.max_eq_left
                              lastIndexWithin] at indexEq
                        have queued :
                            message ∈
                              state.messages
                                receiveDest receiveSource :=
                          headMessage_mem
                            state
                            receiveDest
                            receiveSource
                            message
                            hmessage
                        have acks :=
                          queueHistory_implies_SuccessfulAckHistoryConsistent
                            (protocolHistory_implies_QueueHistoryConsistent
                              protocol)
                        rcases
                            acks
                              receiveDest
                              receiveSource
                              message
                              lastLogIndex
                              queued
                              hbody with
                          ⟨ack⟩
                        let witness :
                            MatchIndexWitness
                              start
                              (actions ++
                                [.receive
                                  receiveDest
                                  receiveSource
                                  .handleAppendEntriesResponseSuccess])
                              (next state
                                (.receive
                                  receiveDest
                                  receiveSource
                                  .handleAppendEntriesResponseSuccess))
                              receiveDest
                              receiveSource :=
                          {
                            handledState := state
                            response := message
                            lastLogIndex
                            ack := ackWitness_extend ack enabled
                            handle_occurrence :=
                              protocolHistory_append_occurs
                                protocol enabled
                            response_head := hmessage
                            index_eq := by
                              simp [next, rawNext, nextReceive,
                                hmessage, hbody, update₂,
                                Nat.max_eq_right oldIndexBound]
                          }
                        exact ⟨{
                          witness
                          response_term := by
                            have enabledFacts := enabled
                            simp [Enabled, actionEnabled, hmessage,
                              receiveBranchEnabled, hbody] at enabledFacts
                            have messageDest :
                                message.dest = receiveDest :=
                              enabledFacts.2.1.1
                            simpa [witness, next, rawNext, nextReceive,
                              hmessage, hbody, messageDest] using
                              enabledFacts.2.2.1
                        }⟩
                | _ =>
                    simp [Enabled, actionEnabled, hmessage,
                      receiveBranchEnabled, hbody] at enabled
            | _ =>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone,
                    nextAppendEntriesNoConflict, conflictRollback] at indexEq
                all_goals
                  split at indexEq <;> simp at indexEq

private theorem protocolHistory_implies_CurrentTermMatchIndexHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    CurrentTermMatchIndexHistoryConsistent start actions state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun actions state =>
        CurrentTermMatchIndexHistoryConsistent start actions state)
      (initial_CurrentTermMatchIndexHistoryConsistent start)
      (by
        intro past current pastHistory matchHistory action enabled
        exact
          currentTermMatchIndexHistory_append_step
            pastHistory matchHistory action enabled)
      history

private theorem positiveMatchIndex_leaderTerm_le_followerTerm
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (leader follower : Node)
    (leaderState :
      state.leadershipState leader = .leader)
    (positive :
      0 < state.matchIndex leader follower) :
    state.currentTerm leader <= state.currentTerm follower := by
  have matchHistory :=
    protocolHistory_implies_CurrentTermMatchIndexHistoryConsistent
      history
  rcases matchHistory leader follower leaderState positive with
    ⟨witness⟩
  rcases occurs_after_stateAt witness.witness.ack.origin.occurrence with
    ⟨responseAfterAt⟩
  have followerTermMonotonic :=
    replays_currentTerm_mono
      responseAfterAt.remainingHistory
      follower
  have responseTermEq :
      (next
        witness.witness.ack.origin.responseState
        (.receive
          follower
          leader
          witness.witness.ack.origin.kind.receiveKind)).currentTerm
            follower =
        state.currentTerm leader :=
    witness.witness.ack.response_term.symm.trans
      witness.response_term
  rw [responseTermEq] at followerTermMonotonic
  exact followerTermMonotonic

private theorem stateAt_extend_stateAtWitness
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state historicalState : State}
    (stateAt :
      StateAtWitness start actions endState state)
    (historical :
      StateAt
        start stateAt.pastActions state historicalState) :
    StateAt start actions endState historicalState := by
  rcases historical with ⟨historicalWitness⟩
  exact ⟨{
    pastActions := historicalWitness.pastActions
    futureActions :=
      historicalWitness.futureActions ++ stateAt.futureActions
    actions_eq := by
      calc
        actions =
            stateAt.pastActions ++ stateAt.futureActions :=
          stateAt.actions_eq
        _ =
            (historicalWitness.pastActions ++
                historicalWitness.futureActions) ++
              stateAt.futureActions := by
          exact congrArg
            (fun xs => xs ++ stateAt.futureActions)
            historicalWitness.actions_eq
        _ =
            historicalWitness.pastActions ++
              (historicalWitness.futureActions ++
                stateAt.futureActions) := by
          simp only [List.append_assoc]
    stateHistory := historicalWitness.stateHistory
    remainingHistory :=
      replays_append
        historicalWitness.remainingHistory
        stateAt.remainingHistory
  }⟩

private theorem appendEntriesMessage_accepted_prefix_eq
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state sendState : State}
    {source dest : Node}
    (stateAt : StateAt start actions endState state)
    (occurrence :
      Occurs
        start actions endState sendState
        (.appendEntries source dest))
    (matching : TemporalLogMatchingInv start actions endState)
    (minimumTerms : MinimumTermInv state)
    (accept :
      appendEntriesAcceptBase
          state
          dest
          (sendState.currentTerm source)
          (sendState.sentIndex source dest)
          (((entryAt?
                (sendState.log source)
                (sendState.sentIndex source dest)).map
              (·.term)).getD 0) =
        true) :
    And
      (sendState.currentTerm source = state.currentTerm dest)
      (logPrefix
          (state.log dest)
          (sendState.sentIndex source dest) =
        logPrefix
          (sendState.log source)
          (sendState.sentIndex source dest)) := by
  have acceptFacts := accept
  simp [appendEntriesAcceptBase] at acceptFacts
  constructor
  · exact acceptFacts.1.1.1
  · let previousIndex := sendState.sentIndex source dest
    by_cases zeroPrevious : previousIndex = 0
    · have actualZero :
          sendState.sentIndex source dest = 0 := by
        simpa [previousIndex] using zeroPrevious
      simp [actualZero, logPrefix]
    · have positivePrevious : 1 <= previousIndex := by
        omega
      have logOK :
          appendEntriesLogOK
              state
              dest
              previousIndex
              (((entryAt?
                    (sendState.log source)
                    previousIndex).map
                  (·.term)).getD 0) =
            true := by
        simpa [previousIndex] using acceptFacts.1.2
      have logOKFacts := logOK
      simp [appendEntriesLogOK, zeroPrevious] at logOKFacts
      cases receiverEntryAt :
          entryAt? (state.log dest) previousIndex with
      | none =>
          simp [receiverEntryAt] at logOKFacts
      | some receiverEntry =>
          have senderWithin :
              previousIndex <= (sendState.log source).length := by
            by_contra notWithin
            have senderBeyond :
                (sendState.log source).length < previousIndex :=
              Nat.lt_of_not_ge notWithin
            have senderEntryAt :
                entryAt? (sendState.log source) previousIndex =
                  none :=
              entryAt?_eq_none_of_length_lt
                (sendState.log source)
                previousIndex
                senderBeyond
            have receiverTermZero :
                receiverEntry.term = 0 := by
              simpa [receiverEntryAt, senderEntryAt] using
                logOKFacts.2
            have receiverTermAtLeastStart :
                startTerm <= receiverEntry.term :=
              minimumTerms.logs
                dest
                receiverEntry
                (entryAt?_mem
                  (state.log dest)
                  previousIndex
                  receiverEntry
                  receiverEntryAt)
            simp [startTerm, receiverTermZero] at receiverTermAtLeastStart
          have sameTerm :
              (entryAt?
                    (state.log dest)
                    previousIndex).map
                  (·.term) =
                (entryAt?
                    (sendState.log source)
                    previousIndex).map
                  (·.term) := by
            rcases entryAt?_exists_of_positive_within
                (sendState.log source)
                previousIndex
                positivePrevious
                senderWithin with
              ⟨senderEntry, senderEntryAt⟩
            simpa [receiverEntryAt, senderEntryAt] using logOKFacts.2
          exact matching
            state
            sendState
            stateAt
            (occurs_before_stateAt occurrence)
            dest
            source
            previousIndex
            positivePrevious
            (Nat.le_min.mpr ⟨logOKFacts.1, senderWithin⟩)
            sameTerm

private theorem protocolHistory_implies_MinimumTermInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state) :
    MinimumTermInv state :=
  protocolHistory_induction
    (start := start)
    (property := fun _ current => MinimumTermInv current)
    (initial_MinimumTermInv start)
    (by
      intro _ current _ minimum action enabled
      exact minimumTerm_step current action minimum enabled)
    history

private theorem slice_last_term_eq
    (log payload : List Entry)
    (previousIndex : Nat)
    (payloadNonempty : payload ≠ [])
    (bounded :
      previousIndex + payload.length <= log.length)
    (termsEq :
      (((log.drop previousIndex).take payload.length).map
          (fun entry => entry.term)) =
        payload.map fun entry => entry.term) :
    (entryAt?
          log
          (previousIndex + payload.length)).map (·.term) =
        payload.getLast?.map (·.term) := by
  have payloadPositive : 0 < payload.length := by
    cases payloadEqCase : payload with
    | nil =>
        exact False.elim (payloadNonempty payloadEqCase)
    | cons first rest =>
        simp
  have lastWithin :
      previousIndex + (payload.length - 1) < log.length := by
    omega
  have indexEq :
      previousIndex + payload.length - 1 =
        previousIndex + (payload.length - 1) := by
    omega
  have termsAtLast := congrArg List.getLast? termsEq
  rw [List.getLast?_map, List.getLast?_map,
    List.getLast?_take] at termsAtLast
  simpa [entryAt?, payloadNonempty, payloadPositive, lastWithin,
    indexEq] using termsAtLast

private theorem appendEntriesMessage_alreadyDone_result_prefix_eq
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state sendState : State}
    {source dest : Node}
    (stateAt : StateAt start actions endState state)
    (occurrence :
      Occurs
        start actions endState sendState
        (.appendEntries source dest))
    (matching : TemporalLogMatchingInv start actions endState)
    (minimumTerms : MinimumTermInv state)
    (head :
      headMessage? state dest source =
        some (appendEntriesMessage sendState source dest))
    (enabled :
      Enabled state
        (.receive dest source .appendEntriesAlreadyDone)) :
    logPrefix
        ((next state
          (.receive dest source
            .appendEntriesAlreadyDone)).log dest)
        (sendState.sentIndex source dest +
          (subsequence
            (sendState.log source)
            (sendState.sentIndex source dest + 1)
            (min
              (sendState.log source).length
              (sendState.sentIndex source dest + 1))).length) =
      logPrefix
        (sendState.log source)
        (sendState.sentIndex source dest +
          (subsequence
            (sendState.log source)
            (sendState.sentIndex source dest + 1)
            (min
              (sendState.log source).length
              (sendState.sentIndex source dest + 1))).length) := by
  let previousIndex := sendState.sentIndex source dest
  let payload :=
    subsequence
      (sendState.log source)
      (previousIndex + 1)
      (min (sendState.log source).length (previousIndex + 1))
  have enabledFacts := enabled
  simp [Enabled, actionEnabled, head, receiveBranchEnabled,
    appendEntriesMessage] at enabledFacts
  have accept :
      appendEntriesAcceptBase
          state
          dest
          (sendState.currentTerm source)
          previousIndex
          (((entryAt?
                (sendState.log source)
                previousIndex).map
              (·.term)).getD 0) =
        true := by
    simpa [previousIndex] using enabledFacts.2.1
  have prefixFacts :=
    appendEntriesMessage_accepted_prefix_eq
      stateAt
      occurrence matching minimumTerms accept
  by_cases payloadEmpty : payload = []
  · simpa [previousIndex, payload, payloadEmpty, next, rawNext,
      nextReceive, head, appendEntriesMessage,
      nextAppendEntriesAlreadyDone] using prefixFacts.2
  · have alreadyDoneFacts :
        And
          (previousIndex + payload.length <=
            (state.log dest).length)
          ((((state.log dest).drop previousIndex).take
                payload.length).map (fun entry => entry.term) =
            payload.map fun entry => entry.term) := by
      have guard := enabledFacts.2.2
      simp [appendEntriesAlreadyDoneGuard, payloadEmpty,
        previousIndex, payload] at guard
      simpa only [List.map_take, List.map_drop] using guard
    have payloadPositive : 0 < payload.length := by
      cases payloadEqCase : payload with
      | nil =>
          exact False.elim (payloadEmpty payloadEqCase)
      | cons first rest =>
          simp
    have receiverPreviousWithin :
        previousIndex <= (state.log dest).length := by
      omega
    have senderPreviousWithin :
        previousIndex <= (sendState.log source).length := by
      have lengthEq := congrArg List.length prefixFacts.2
      simp [logPrefix, List.length_take] at lengthEq
      omega
    have senderEndWithin :
        previousIndex + payload.length <=
          (sendState.log source).length :=
      appendEntries_sentIndex_le_log_length
        (sendState.log source)
        previousIndex
        senderPreviousWithin
    have beforeEnd :
        previousIndex < (sendState.log source).length :=
      previousIndex_lt_of_next_subsequence_nonempty
        (sendState.log source)
        previousIndex
        (by simpa [previousIndex, payload] using payloadEmpty)
    have nextWithin :
        previousIndex + 1 <= (sendState.log source).length := by
      omega
    have payloadEq :
        payload =
          ((sendState.log source).drop previousIndex).take 1 := by
      simp [payload, subsequence, Nat.min_eq_right nextWithin]
    have senderTermsEq :
        ((((sendState.log source).drop previousIndex).take
              payload.length).map (fun entry => entry.term) =
          payload.map fun entry => entry.term) := by
      simp [payloadEq]
    have receiverLastTerm :=
      slice_last_term_eq
        (state.log dest)
        payload
        previousIndex
        payloadEmpty
        alreadyDoneFacts.1
        alreadyDoneFacts.2
    have senderLastTerm :=
      slice_last_term_eq
        (sendState.log source)
        payload
        previousIndex
        payloadEmpty
        senderEndWithin
        senderTermsEq
    have sameTerm :
        (entryAt?
              (state.log dest)
              (previousIndex + payload.length)).map
            (·.term) =
          (entryAt?
              (sendState.log source)
              (previousIndex + payload.length)).map
            (·.term) :=
      receiverLastTerm.trans senderLastTerm.symm
    have result := matching
      state
      sendState
      stateAt
      (occurs_before_stateAt occurrence)
      dest
      source
      (previousIndex + payload.length)
      (by omega)
      (Nat.le_min.mpr
        ⟨alreadyDoneFacts.1, senderEndWithin⟩)
      sameTerm
    simpa [previousIndex, payload, next, rawNext, nextReceive,
      head, appendEntriesMessage, nextAppendEntriesAlreadyDone] using
      result

theorem maxCommittableIndex_le_length
    (entries : List Entry) :
    maxCommittableIndex entries <= entries.length := by
  rcases maxCommittableIndex_signature_or_zero entries with
    indexZero | ⟨entry, atIndex, _⟩
  · simp [indexZero]
  · unfold entryAt? at atIndex
    split at atIndex
    · contradiction
    · have beforeLength :
          maxCommittableIndex entries - 1 < entries.length :=
        (List.getElem?_eq_some_iff.mp atIndex).choose
      omega

theorem maxCommittableIndexAt_le_bound
    (entries : List Entry)
    (bound : Nat) :
    maxCommittableIndexAt entries bound <= bound := by
  unfold maxCommittableIndexAt
  have withinPrefix :=
    maxCommittableIndex_le_length
      (logPrefix entries (min bound entries.length))
  exact Nat.le_trans withinPrefix
    (by
      simp only [logPrefix, List.length_take]
      exact Nat.le_trans
        (Nat.min_le_left _ _)
        (Nat.min_le_left _ _))

private theorem maxCommittableIndexAt_le_log_length
    (entries : List Entry)
    (bound : Nat) :
    maxCommittableIndexAt entries bound <= entries.length := by
  unfold maxCommittableIndexAt
  have withinPrefix :=
    maxCommittableIndex_le_length
      (logPrefix entries (min bound entries.length))
  exact Nat.le_trans withinPrefix
    (by
      simp only [logPrefix, List.length_take]
      exact Nat.min_le_right _ _)

private theorem prefix_eq_at_smaller_index
    (first second : List Entry)
    (large small : Nat)
    (smallWithin : small <= large)
    (prefixEq :
      logPrefix first large = logPrefix second large) :
    logPrefix first small = logPrefix second small := by
  have lowered :=
    congrArg (fun entries => logPrefix entries small) prefixEq
  simpa [logPrefix, List.take_take, Nat.min_eq_left smallWithin] using
    lowered

theorem appendEntriesAlreadyDone_commit_transport
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (dest source : Node)
    (enabled :
      Enabled state
        (.receive dest source .appendEntriesAlreadyDone))
    (increased :
      (next state
          (.receive dest source .appendEntriesAlreadyDone)).commitIndex dest >
        state.commitIndex dest) :
    Exists fun message =>
      And
        (headMessage? state dest source = some message)
        (Exists fun send :
            AESendWitness start actions state dest source message =>
          And
            ((next state
                (.receive
                  dest source .appendEntriesAlreadyDone)).commitIndex dest <=
              send.sendState.commitIndex source)
            (committed
                (next state
                  (.receive
                    dest source .appendEntriesAlreadyDone))
                dest =
              logPrefix
                (send.sendState.log source)
                ((next state
                    (.receive
                      dest source
                      .appendEntriesAlreadyDone)).commitIndex dest))) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [Enabled, actionEnabled, hmessage] at enabled
  | some message =>
      cases hbody : message.body with
      | appendEntriesRequest previousIndex previousTerm entries
          leaderCommitIndex =>
          have queued :=
            headMessage?_mem state dest source message hmessage
          have provenance :
              MessageHasAESendWitness
