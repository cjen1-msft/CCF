theorem initial_NoLeaderBeforeInitialTermInv (start : InitialConfiguration) :
    NoLeaderBeforeInitialTermInv (initialState start) := by
  intro node lowerTerm
  by_cases nodeIsInitial : node ∈ start.nodes
  · simp [initialState, startTerm, nodeIsInitial] at lowerTerm
  · simp [initialState, nodeIsInitial]

theorem initial_LogTermsAtLeastStartInv (start : InitialConfiguration) :
    LogTermsAtLeastStartInv (initialState start) := by
  intro node entry member
  by_cases nodeIsInitial : node ∈ start.nodes
  · simp [initialState, startLog, nodeIsInitial] at member
    rcases member with isFirst | isSecond
    · subst entry
      exact Nat.le_refl _
    · subst entry
      exact Nat.le_refl _
  · simp [initialState, nodeIsInitial] at member

theorem initial_ActiveRoleTermInv (start : InitialConfiguration) :
    ActiveRoleTermInv (initialState start) := by
  intro node activeRole
  by_cases nodeIsInitial : node ∈ start.nodes
