  exact oldPrefix.trans followerLogRetained

private theorem appendEntriesNoConflict_retains_old_log
    (state : State)
    (message : Message)
    (previousIndex : Nat)
    (entries : List Entry)
    (leaderCommitIndex : Nat)
    (noConflict :
      appendEntriesNoConflictGuard
        state message.dest previousIndex entries = true) :
    isLogPrefix
      (state.log message.dest)
      ((nextAppendEntriesNoConflict
        state message previousIndex entries leaderCommitIndex).log
          message.dest) := by
  have normalizedGuard :
      appendEntriesNoConflictGuard
        {
          nodes := ∅
          currentTerm := NodeMap.const 0
          leadershipState := NodeMap.const .none
          log := NodeMap.const (state.log message.dest)
          commitIndex := NodeMap.const 0
          votedFor := NodeMap.const none
          votesGranted := NodeMap.const ∅
          configurations := NodeMap.const []
          membershipState := NodeMap.const .active
          isNewFollower := NodeMap.const false
          hasJoined := NodeMap.const false
