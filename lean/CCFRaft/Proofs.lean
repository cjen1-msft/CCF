theorem quorumReadyCandidate_carries_chosenPrefix_by_choice_progress_at_term
    {start : InitialConfiguration}
    {actions : List Action}
    {state targetBoundaryState : State}
    {candidate targetOwner : Node}
    {targetIndex : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (candidateWitness :
      CandidateChosenConfigurationWitness
        start actions state candidate)
    (target :
      ChosenCommitCertificate
        start actions state
        targetBoundaryState targetOwner targetIndex)
    (targetBoundary :
      SignatureCommitBoundary
        targetBoundaryState targetOwner targetIndex)
    (candidateTerm : Nat)
    (targetEarlier :
      target.choiceTerm < candidateTerm)
    (transferAtCommonConfiguration :
      forall boundaryState owner index,
        forall certificate :
            ChosenCommitCertificate
              start actions state boundaryState owner index,
          SignatureCommitBoundary boundaryState owner index ->
            certificate.choiceTerm < candidateTerm ->
              forall activeConfiguration : ConfigurationAt,
                activeConfiguration ∈
                    state.configurations candidate ->
                  activeConfiguration ∈
                      certificate.choiceState.configurations
                        certificate.choiceLeader ->
                    activeConfiguration.index <=
                        certificate.choiceIndex ->
                      isLogPrefix
                        certificate.chosenPrefix
                        (state.log candidate)) :
    isLogPrefix
      target.chosenPrefix
      (state.log candidate) := by
  have stateExact :
      ConfigurationsExactInv state :=
    reachable_ConfigurationsExactInv
      start
      (protocolHistory_reachable history)
  have candidateThresholdLe :
      lastConfigurationToIndex
          (logConfigurations (state.log candidate))
          (state.commitIndex candidate) <=
        candidateWitness.certificate.configuration.index := by
    have member := candidateWitness.configuration_mem
    rw [stateExact candidate] at member
    have details :
        candidateWitness.certificate.configuration ∈
            logConfigurations (state.log candidate) ∧
          lastConfigurationToIndex
              (logConfigurations (state.log candidate))
              (state.commitIndex candidate) <=
            candidateWitness.certificate.configuration.index := by
      simpa [activeLogConfigurations, configurationsFromIndex] using
        member
    exact details.2
  have candidateConfigurationPositive :=
    chosenCommitCertificate_configuration_index_positive
      candidateWitness.certificate
  have leaderUniqueness :=
    completeSafetyCore_implies_leaderUniqueness history core
  have currentChosen :
      HistoricalChosenCommitCore start actions state :=
    core.chosenCommits List.prefix_rfl history
  have carry :
      forall index : Nat,
        forall boundaryState owner,
          forall certificate :
              ChosenCommitCertificate
                start actions state boundaryState owner index,
            SignatureCommitBoundary boundaryState owner index ->
              certificate.choiceTerm < candidateTerm ->
                isLogPrefix
                  certificate.chosenPrefix
                  (state.log candidate) := by
    intro index
    induction index using Nat.strong_induction_on with
    | h index inductionHypothesis =>
        intro boundaryState owner certificate boundary earlier
        rcases
            chosenCommitCertificates_prefix_comparable
              leaderUniqueness
              candidateWitness.certificate
              certificate with
          candidateToCertificate | certificateToCandidate
        · let choiceThreshold :=
            lastConfigurationToIndex
              (logConfigurations
                (certificate.choiceState.log certificate.choiceLeader))
              (certificate.choiceState.commitIndex
                certificate.choiceLeader)
          by_cases thresholdWithinCandidate :
              choiceThreshold <=
                candidateWitness.certificate.configuration.index
          · have choiceExact :
                ConfigurationsExactInv certificate.choiceState :=
              reachable_ConfigurationsExactInv
                start
                (stateAt_reachable certificate.choice_at)
            have candidateConfigurationAtChoice :=
              chosenCommitCertificate_configuration_active_at_later_choice_of_threshold
                candidateWitness.certificate
                certificate
                choiceExact
                candidateToCertificate
                thresholdWithinCandidate
            exact
              transferAtCommonConfiguration
                boundaryState
                owner
                index
                certificate
                boundary
                earlier
                candidateWitness.certificate.configuration
                candidateWitness.configuration_mem
                candidateConfigurationAtChoice.1
                candidateConfigurationAtChoice.2
          · have candidateBeforeThreshold :
                candidateWitness.certificate.configuration.index <
                  choiceThreshold := by
              omega
            have progress :
                certificate.choiceState.commitIndex
                    certificate.choiceLeader <
                  index := by
              rcases certificate.choice_progress with
                initialOrigin | strictProgress
              · rcases
                    commitChoiceOrigin_isInitial_details
                      certificate.choice_origin initialOrigin with
                  ⟨choiceStateEq, choiceLeaderEq, _choiceIndexEq⟩
                have thresholdEq : choiceThreshold = 1 := by
                  simp [choiceThreshold, choiceStateEq, choiceLeaderEq,
                    initialState, startLog, logConfigurations,
                    configurationsInEntries, configurationsInEntriesAux,
                    lastConfigurationToIndex, start.leader_mem]
                rw [thresholdEq] at candidateBeforeThreshold
                omega
              · exact strictProgress
            let previousIndex :=
              certificate.choiceState.commitIndex
                certificate.choiceLeader
            have previousPositive : 0 < previousIndex := by
              have thresholdWithinCommit :
                  choiceThreshold <= previousIndex :=
                lastConfigurationToIndex_le _ _
              omega
            have signaturesAtChoice :
                SignatureInv certificate.choiceState :=
              reachable_SignatureInv
                start
                (stateAt_reachable certificate.choice_at)
            have previousBoundary :
                SignatureCommitBoundary
                  certificate.choiceState
                  certificate.choiceLeader
                  previousIndex :=
              ⟨previousPositive,
                Nat.le_refl _,
                signaturesAtChoice
                  certificate.choiceLeader previousPositive⟩
            rcases
                currentChosen
                  certificate.choiceState
                  certificate.choice_at
                  certificate.choiceLeader
                  previousIndex
                  previousBoundary with
              ⟨previousCertificate⟩
            have previousToCertificate :
                isLogPrefix
                  previousCertificate.chosenPrefix
                  certificate.chosenPrefix := by
              rw [previousCertificate.prefix_eq,
                certificate.choice_prefix_eq]
              exact
                logPrefix_mono_isLogPrefix
                  (certificate.choiceState.log certificate.choiceLeader)
                  previousIndex
                  index
                  (Nat.le_of_lt progress)
            have previousTermLe :
                previousCertificate.choiceTerm <=
                  certificate.choiceTerm :=
              previousCertificate.choice_term_le_boundary_owner.trans_eq
                certificate.choice_term
            have previousEarlier :
                previousCertificate.choiceTerm <
                  candidateTerm :=
              lt_of_le_of_lt previousTermLe earlier
            have carriesPrevious :=
              inductionHypothesis
                previousIndex
                progress
                certificate.choiceState
                certificate.choiceLeader
                previousCertificate
                previousBoundary
                previousEarlier
            have previousConfigurationFacts :=
              committedConfigurationAt?_some_properties
                (certificate.choiceState.log certificate.choiceLeader)
                previousIndex
                previousCertificate.configuration
                previousCertificate.configuration_at
            have previousConfigurationIndex :
                previousCertificate.configuration.index =
                  choiceThreshold := by
              exact
                committedConfigurationAt?_index_eq_lastConfigurationToIndex
                  (certificate.choiceState.log certificate.choiceLeader)
                  previousIndex
                  previousCertificate.configuration
                  previousCertificate.configuration_at
            have previousConfigurationInCandidateLog :
                previousCertificate.configuration ∈
                  logConfigurations (state.log candidate) :=
              configuration_mem_logConfigurations_of_prefix
                previousCertificate.configuration
                previousCertificate.chosenPrefix
                (state.log candidate)
                (chosenCommitCertificate_configuration_mem_chosenPrefix
                  previousCertificate)
                carriesPrevious
            have previousConfigurationAfterCandidate :
                candidateWitness.certificate.configuration.index <
                  previousCertificate.configuration.index := by
              rw [previousConfigurationIndex]
              exact candidateBeforeThreshold
            have previousConfigurationActiveAtCandidate :
                previousCertificate.configuration ∈
                  state.configurations candidate := by
              rw [stateExact candidate]
              simp [activeLogConfigurations, configurationsFromIndex,
                previousConfigurationInCandidateLog]
              exact candidateThresholdLe.trans
                (Nat.le_of_lt previousConfigurationAfterCandidate)
            have choiceExact :
                ConfigurationsExactInv certificate.choiceState :=
              reachable_ConfigurationsExactInv
                start
                (stateAt_reachable certificate.choice_at)
            have previousConfigurationActiveAtChoice :
                previousCertificate.configuration ∈
                  certificate.choiceState.configurations
                    certificate.choiceLeader :=
              configurationsExact_committedConfigurationAt?_mem
                certificate.choiceState
                certificate.choiceLeader
                choiceExact
                previousCertificate.configuration
                previousCertificate.configuration_at
            have previousConfigurationWithinChoice :
                previousCertificate.configuration.index <=
                  certificate.choiceIndex := by
              exact
                previousConfigurationFacts.2.trans
                  ((Nat.le_of_lt progress).trans
                    certificate.boundary_le_choice)
            exact
              transferAtCommonConfiguration
                boundaryState
                owner
                index
                certificate
                boundary
                earlier
                previousCertificate.configuration
                previousConfigurationActiveAtCandidate
                previousConfigurationActiveAtChoice
                previousConfigurationWithinChoice
        · exact
            certificateToCandidate.trans
              candidateWitness.candidate_carries
  exact
    carry
      targetIndex
      targetBoundaryState
      targetOwner
      target
      targetBoundary
      targetEarlier

