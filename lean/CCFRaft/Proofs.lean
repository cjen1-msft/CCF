    (progress :
      Or
        origin.IsInitial
        (choiceState.commitIndex choiceLeader < boundaryIndex))
    (enabled : Enabled state action) :
    Or
      (commitChoiceOrigin_append_step origin enabled).IsInitial
      (choiceState.commitIndex choiceLeader < boundaryIndex) := by
  cases origin <;>
    simpa [commitChoiceOrigin_append_step,
