private theorem advanceCommitIndex_pendingPrefix_comparable_with_certificate
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState : State}
    {leader owner : Node}
    {index certificateIndex : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner certificateIndex) :
    (state.currentTerm leader < certificate.choiceTerm ->
      isLogPrefix
        (logPrefix (state.log leader) index)
        (certificate.choiceState.log certificate.choiceLeader)) ->
    Or
      (isLogPrefix
        certificate.chosenPrefix
        (logPrefix (state.log leader) index))
      (isLogPrefix
        (logPrefix (state.log leader) index)
        certificate.chosenPrefix) := by
  intro pendingEarlierCarries
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have leaderState : state.leadershipState leader = .leader :=
    enabledFacts.1.2
  have pendingInChoiceLog :=
    logPrefix_isLogPrefix (state.log leader) index
  rcases
      Nat.lt_trichotomy
        certificate.choiceTerm
        (state.currentTerm leader) with
    certificateEarlier | sameTerm | pendingEarlier
  · exact
      List.prefix_or_prefix_of_prefix
        (certificate.higher_term_leaders
          state
          (protocolHistory_final_stateAt history)
          leader
          leaderState
          certificateEarlier)
        pendingInChoiceLog
  · have leaderUniqueness :=
      completeSafetyCore_implies_leaderUniqueness history core
    have sameLeader : certificate.choiceLeader = leader :=
      leaderUniqueness
        certificate.choiceState
        state
        certificate.choice_at
        (protocolHistory_final_stateAt history)
        certificate.choiceLeader
        leader
        certificate.choice_leader
        leaderState
        (certificate.choice_term.trans sameTerm)
    have stateLeaderAtCertificate :
        certificate.choiceState.leadershipState leader = .leader := by
      simpa [sameLeader] using certificate.choice_leader
    have choiceTermEq :
        certificate.choiceState.currentTerm leader =
          state.currentTerm leader := by
      simpa [sameLeader] using certificate.choice_term.trans sameTerm
    rcases
        historical_sameTerm_leader_logs_comparable
          certificate.choice_at
          (protocolHistory_final_stateAt history)
          leader
          stateLeaderAtCertificate
          leaderState
          choiceTermEq with
      choiceToState | stateToChoice
    · exact
        List.prefix_or_prefix_of_prefix
          ((chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
            certificate).trans (by simpa [sameLeader] using choiceToState))
          pendingInChoiceLog
    · exact
        List.prefix_or_prefix_of_prefix
          (chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
            certificate)
          (pendingInChoiceLog.trans
            (by simpa [sameLeader] using stateToChoice))
  · exact
      List.prefix_or_prefix_of_prefix
        (chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
          certificate)
        (pendingEarlierCarries pendingEarlier)

private theorem candidateConfiguration_common_with_pendingChoice
    {start : InitialConfiguration}
