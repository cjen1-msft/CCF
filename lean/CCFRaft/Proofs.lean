private noncomputable def choiceSupportWitness_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state choiceState : State}
    {choiceLeader member : Node}
    {choiceIndex choiceTerm : Nat}
    {action : Action}
    (support :
      ChoiceSupportWitness
        start actions state choiceState choiceLeader member
        choiceIndex choiceTerm)
    (enabled : Enabled state action) :
    ChoiceSupportWitness
      start
      (actions ++ [action])
      (next state action)
      choiceState
      choiceLeader
      member
      choiceIndex
      choiceTerm := by
  let futureActions :=
    support.choice_actions_prefix.choose
  have actionsEq :=
    support.choice_actions_prefix.choose_spec
  exact
    {
      choiceActions := support.choiceActions
      choice_history := support.choice_history
      choice_actions_prefix :=
        ⟨futureActions ++ [action],
          by
            rw [← List.append_assoc, actionsEq]⟩
      matchWitness := support.matchWitness
      index_le_ack := support.index_le_ack
      response_term := support.response_term
    }

private theorem choiceSupportWitness_choiceTerm_le_endState
    {start : InitialConfiguration}
    {actions : List Action}
    {state choiceState : State}
    {choiceLeader member : Node}
    {choiceIndex choiceTerm : Nat}
    (history : ProtocolHistory start actions state)
    (support :
      ChoiceSupportWitness
        start actions state choiceState choiceLeader member
        choiceIndex choiceTerm) :
    choiceTerm <= state.currentTerm member := by
  let choiceAt :=
    choiceSupport_choiceState_stateAt history support
  have responseAt :
      StateAt
        start actions state
        (next
          support.matchWitness.ack.origin.responseState
          (.receive
            member
            choiceLeader
            support.matchWitness.ack.origin.kind.receiveKind)) :=
    stateAt_extend_stateAtWitness
      choiceAt
      (occurs_after_stateAt
        support.matchWitness.ack.origin.occurrence)
  rcases responseAt with ⟨endpoint⟩
  have responseTerm :
      support.matchWitness.response.term =
        (next
          support.matchWitness.ack.origin.responseState
          (.receive
            member
            choiceLeader
            support.matchWitness.ack.origin.kind.receiveKind)).currentTerm
          member :=
    support.matchWitness.ack.response_term
  exact
    Nat.le_trans
      (Nat.le_of_eq
        (support.response_term.symm.trans responseTerm))
      (replays_currentTerm_mono endpoint.remainingHistory member)

