  simpa [nextAppendEntriesNoConflict, updateNode] using resultEq.symm

private theorem appendEntriesPayload_length_le_one
    (entries : List Entry)
    (previousIndex : Nat) :
    (subsequence
      entries
      (previousIndex + 1)
      (min entries.length (previousIndex + 1))).length <= 1 := by
  unfold subsequence
  by_cases tooShort :
      min entries.length (previousIndex + 1) <
        previousIndex + 1
  · simp [tooShort]
  · rw [if_neg (by simp [tooShort])]
    have upper :
        min entries.length (previousIndex + 1) <=
          previousIndex + 1 :=
      Nat.min_le_right _ _
    have equal :
        min entries.length (previousIndex + 1) =
          previousIndex + 1 := by
      omega
    simp [equal]

private theorem next_subsequence_eq_singleton
    (entries : List Entry)
    (previousIndex : Nat)
    (beforeEnd : previousIndex < entries.length) :
    subsequence
        entries
        (previousIndex + 1)
        (min entries.length (previousIndex + 1)) =
      [entries[previousIndex]] := by
  have combined :=
    logPrefix_append_next_subsequence entries previousIndex
  apply List.append_cancel_left
  simpa only [logPrefix,
    List.take_succ_eq_append_getElem beforeEnd] using combined

private theorem appendEntriesConflictGuard_false_of_prefix_eq
    (state : State)
    (dest : Node)
    (senderLog : List Entry)
    (previousIndex : Nat)
    (commonIndex : Nat)
    (previousBeforeCommon : previousIndex < commonIndex)
    (commonWithinFollower :
      commonIndex <= (state.log dest).length)
    (commonWithinSender :
      commonIndex <= senderLog.length)
    (commonPrefix :
      logPrefix (state.log dest) commonIndex =
        logPrefix senderLog commonIndex) :
    appendEntriesConflictGuard
        state
        dest
        previousIndex
        (subsequence
          senderLog
          (previousIndex + 1)
          (min senderLog.length (previousIndex + 1))) =
      false := by
  have previousBeforeSender :
      previousIndex < senderLog.length := by
    omega
  have payloadEq :=
    next_subsequence_eq_singleton
      senderLog previousIndex previousBeforeSender
  have nextWithinFollower :
      previousIndex + 1 <= (state.log dest).length := by
    omega
  have nextWithinSender :
      previousIndex + 1 <= senderLog.length := by
    omega
  have atPrefixEq :=
    congrArg
      (fun entries => entryAt? entries (previousIndex + 1))
      commonPrefix
  unfold logPrefix at atPrefixEq
  change
    entryAt?
        ((state.log dest).take commonIndex)
        (previousIndex + 1) =
      entryAt?
        (senderLog.take commonIndex)
        (previousIndex + 1) at atPrefixEq
  have atEq :
      entryAt? (state.log dest) (previousIndex + 1) =
        entryAt? senderLog (previousIndex + 1) := by
    rw [entryAt?_take_eq_of_index_le_length
      (state.log dest)
      commonIndex
      (previousIndex + 1)
      (by omega)
      (by
        simp [List.length_take,
          Nat.min_eq_left commonWithinFollower]
        omega)] at atPrefixEq
    rw [entryAt?_take_eq_of_index_le_length
      senderLog
      commonIndex
      (previousIndex + 1)
      (by omega)
      (by
        simp [List.length_take,
          Nat.min_eq_left commonWithinSender]
        omega)] at atPrefixEq
    exact atPrefixEq
  have senderAt :
      entryAt? senderLog (previousIndex + 1) =
        some senderLog[previousIndex] := by
    simp [entryAt?, List.getElem?_eq_getElem previousBeforeSender]
  cases dropped :
      (state.log dest).drop previousIndex with
  | nil =>
      have followerAtNone :
          entryAt? (state.log dest) (previousIndex + 1) = none := by
        have headEq := congrArg List.head? dropped
        simpa [entryAt?] using headEq
      rw [followerAtNone, senderAt] at atEq
      contradiction
  | cons first rest =>
      have followerAt :
          entryAt? (state.log dest) (previousIndex + 1) =
            some first := by
        have headEq := congrArg List.head? dropped
        simpa [entryAt?] using headEq
      have firstEq : first = senderLog[previousIndex] := by
        rw [followerAt, senderAt] at atEq
        exact Option.some.inj atEq
      subst first
      simp [appendEntriesConflictGuard, payloadEq, dropped]

private theorem entryAt?_eq_of_common_prefix
    (common first second : List Entry)
    (index : Nat)
    (firstPrefix : isLogPrefix common first)
    (secondPrefix : isLogPrefix common second)
    (within : index <= common.length) :
    entryAt? first index = entryAt? second index := by
  by_cases zero : index = 0
  · subst index
    simp [entryAt?]
  rcases firstPrefix with ⟨firstSuffix, firstEq⟩
  rcases secondPrefix with ⟨secondSuffix, secondEq⟩
  rw [← firstEq, ← secondEq]
  rw [entryAt?_append_eq_of_index_le_length
    common firstSuffix index (Nat.one_le_iff_ne_zero.mpr zero) within]
  rw [entryAt?_append_eq_of_index_le_length
    common secondSuffix index (Nat.one_le_iff_ne_zero.mpr zero) within]

private theorem logPrefix_eq_of_prefixes
    (first second common : List Entry)
    (index : Nat)
    (firstPrefix : isLogPrefix first common)
    (secondPrefix : isLogPrefix second common)
    (firstBound : index <= first.length)
    (secondBound : index <= second.length) :
    logPrefix first index = logPrefix second index := by
  have firstAtCommon :
      logPrefix first index = logPrefix common index :=
    prefix_eq_logPrefix_of_length
      (logPrefix first index)
      common
      index
      ((logPrefix_isLogPrefix first index).trans firstPrefix)
      (by simp [logPrefix, Nat.min_eq_left firstBound])
  have secondAtCommon :
      logPrefix second index = logPrefix common index :=
    prefix_eq_logPrefix_of_length
      (logPrefix second index)
      common
      index
      ((logPrefix_isLogPrefix second index).trans secondPrefix)
      (by simp [logPrefix, Nat.min_eq_left secondBound])
  exact firstAtCommon.trans secondAtCommon.symm

private theorem appendEntriesConflict_previousIndex_ge_referencePrefix
    (state : State)
    (follower : Node)
    (sourceLog referencePrefix acknowledgedPrefix : List Entry)
    (previousIndex index : Nat)
    (acknowledgedPrefixEq :
      acknowledgedPrefix = logPrefix referencePrefix index)
    (acknowledgedPrefixLength :
      acknowledgedPrefix.length = index)
    (retained :
      isLogPrefix acknowledgedPrefix (state.log follower))
    (sourceComparable :
      Or
        (isLogPrefix referencePrefix sourceLog)
        (isLogPrefix sourceLog referencePrefix))
    (conflict :
      appendEntriesConflictGuard
          state
          follower
          previousIndex
          (subsequence
            sourceLog
            (previousIndex + 1)
            (min sourceLog.length (previousIndex + 1))) =
        true) :
    index <= previousIndex := by
  by_contra notWithin
  have previousBeforeIndex : previousIndex < index := by
    omega
  have conflictFacts := conflict
  simp [appendEntriesConflictGuard] at conflictFacts
  have entriesNonempty :
      subsequence
          sourceLog
          (previousIndex + 1)
          (min sourceLog.length (previousIndex + 1)) ≠
        [] :=
    conflictFacts.1.1
  have sourceBeforeEnd : previousIndex < sourceLog.length :=
    previousIndex_lt_of_next_subsequence_nonempty
      sourceLog previousIndex entriesNonempty
  have followerBound : index <= (state.log follower).length := by
    rw [← acknowledgedPrefixLength]
    exact retained.length_le
  have referenceBound : index <= referencePrefix.length := by
    have lengths := congrArg List.length acknowledgedPrefixEq
    simp [acknowledgedPrefixLength, logPrefix, List.length_take] at lengths
    omega
  have followerReferenceAtIndex :
      logPrefix (state.log follower) index =
        logPrefix referencePrefix index := by
    exact
      (prefix_eq_logPrefix_of_length
        acknowledgedPrefix
        (state.log follower)
        index
        retained
        acknowledgedPrefixLength).symm.trans acknowledgedPrefixEq
  have followerReference :
      logPrefix
          (state.log follower)
          (previousIndex + 1) =
        logPrefix referencePrefix (previousIndex + 1) := by
    have shortened :=
      congrArg (List.take (previousIndex + 1))
        followerReferenceAtIndex
    simpa [logPrefix, List.take_take,
      Nat.min_eq_left (by omega : previousIndex + 1 <= index)] using
        shortened
  have referenceSource :
      logPrefix referencePrefix (previousIndex + 1) =
        logPrefix sourceLog (previousIndex + 1) := by
    rcases sourceComparable with referenceToSource | sourceToReference
    · exact
        logPrefix_eq_of_prefixes
          referencePrefix
          sourceLog
          sourceLog
          (previousIndex + 1)
          referenceToSource
          List.prefix_rfl
          (by omega)
          (by omega)
    · exact
        logPrefix_eq_of_prefixes
          referencePrefix
          sourceLog
          referencePrefix
          (previousIndex + 1)
          List.prefix_rfl
          sourceToReference
          (by omega)
          (by omega)
  have conflictFalse :=
    appendEntriesConflictGuard_false_of_prefix_eq
      state
      follower
      sourceLog
      previousIndex
      (previousIndex + 1)
      (by omega)
      (by omega)
      (by omega)
      (followerReference.trans referenceSource)
  rw [conflict] at conflictFalse
  contradiction

private theorem appendEntriesConflict_previousIndex_ge_matchIndex
    {start : InitialConfiguration}
    {actions : List Action}
    {state sendState : State}
    {leader follower source : Node}
    (history : ProtocolHistory start actions state)
    (prefixes : MatchIndexPrefixInv state)
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
