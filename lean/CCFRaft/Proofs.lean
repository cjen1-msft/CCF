    (certificate :
      ChosenCommitCertificate
        start localActions localState boundaryState owner certificateIndex)
    (candidateConfiguration :
      certificate.configuration ∈ localState.configurations candidate)
    (prefixOrder :
      isLogPrefix
        certificate.chosenPrefix
        (logPrefix (state.log leader) index))
    (choiceThresholdWithin :
      lastConfigurationToIndex
          (logConfigurations (state.log leader))
          (state.commitIndex leader) <=
        certificate.configuration.index)
    (stateExact : ConfigurationsExactInv state)
    (indexWithin :
      index <= highestCommittableIndex state leader) :
    And
      (certificate.configuration ∈ localState.configurations candidate)
      (And
        (certificate.configuration ∈ state.configurations leader)
        (certificate.configuration.index <=
          highestCommittableIndex state leader)) := by
  have configurationInPending :
      certificate.configuration ∈
        logConfigurations (logPrefix (state.log leader) index) :=
    configuration_mem_logConfigurations_of_prefix
      certificate.configuration
      certificate.chosenPrefix
      (logPrefix (state.log leader) index)
      (chosenCommitCertificate_configuration_mem_chosenPrefix certificate)
      prefixOrder
  have configurationInChoiceLog :
      certificate.configuration ∈
        logConfigurations (state.log leader) := by
    exact
      configuration_mem_logConfigurations_of_prefix
        certificate.configuration
        (logPrefix (state.log leader) index)
        (state.log leader)
        configurationInPending
        (logPrefix_isLogPrefix _ _)
  have configurationWithinBoundary :
      certificate.configuration.index <= index := by
    have bounds :=
      mem_configurationsInEntriesAux
        1
        (logPrefix (state.log leader) index)
        certificate.configuration
        (by
          simpa [logConfigurations, configurationsInEntries] using
            configurationInPending)
    simp [logPrefix] at bounds
    omega
  exact
    ⟨candidateConfiguration,
      by
        rw [stateExact leader]
        simp [activeLogConfigurations, configurationsFromIndex,
          configurationInChoiceLog, choiceThresholdWithin],
      configurationWithinBoundary.trans indexWithin⟩

private theorem previousCommittedConfiguration_common_with_candidate
    {start : InitialConfiguration}
    {actions localActions : List Action}
    {state candidateState boundaryState : State}
    {leader candidate owner : Node}
    {index certificateIndex : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (certificate :
      ChosenCommitCertificate
        start localActions candidateState boundaryState owner certificateIndex)
    (candidateConfiguration :
      certificate.configuration ∈ candidateState.configurations candidate)
    (candidateExact : ConfigurationsExactInv candidateState)
    (stateExact : ConfigurationsExactInv state)
    (candidateAt : StateAt start actions state candidateState)
    (higherTerm :
      state.currentTerm leader < candidateState.currentTerm candidate)
    (commitBefore : state.commitIndex leader < index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (thresholdAfterCandidate :
      certificate.configuration.index <
        lastConfigurationToIndex
          (logConfigurations (state.log leader))
          (state.commitIndex leader))
    (previousCarries :
      forall previous :
          ChosenCommitCertificate
            start actions state state leader (state.commitIndex leader),
        SignatureCommitBoundary state leader (state.commitIndex leader) ->
          previous.choiceTerm <
              candidateState.currentTerm candidate ->
            isLogPrefix
              previous.chosenPrefix
              (candidateState.log candidate)) :
    Exists fun configuration : ConfigurationAt =>
      And
        (configuration ∈ candidateState.configurations candidate)
        (And
          (configuration ∈ state.configurations leader)
          (configuration.index <=
            highestCommittableIndex state leader)) := by
  have previousPositive : 0 < state.commitIndex leader := by
    have thresholdLe :=
      lastConfigurationToIndex_le
        (logConfigurations (state.log leader))
        (state.commitIndex leader)
    omega
  have signatures :=
    reachable_SignatureInv start (protocolHistory_reachable history)
  have previousBoundary :
      SignatureCommitBoundary state leader (state.commitIndex leader) :=
    ⟨previousPositive, Nat.le_refl _,
      signatures leader previousPositive⟩
  rcases
      historicalCompleteSafetyCore_currentChosenCommitCore history core
        state
        (protocolHistory_final_stateAt history)
        leader
        (state.commitIndex leader)
        previousBoundary with
    ⟨previous⟩
  have previousEarlier :
      previous.choiceTerm < candidateState.currentTerm candidate :=
    lt_of_le_of_lt
      previous.choice_term_le_boundary_owner
      higherTerm
  have previousInCandidate :=
    previousCarries previous previousBoundary previousEarlier
  have previousFacts :=
    committedConfigurationAt?_some_properties
      (state.log leader)
      (state.commitIndex leader)
      previous.configuration
      previous.configuration_at
  have previousIndexEq :
      previous.configuration.index =
        lastConfigurationToIndex
          (logConfigurations (state.log leader))
          (state.commitIndex leader) :=
    committedConfigurationAt?_index_eq_lastConfigurationToIndex
      (state.log leader)
      (state.commitIndex leader)
      previous.configuration
      previous.configuration_at
  have previousInCandidateLog :
      previous.configuration ∈
        logConfigurations (candidateState.log candidate) :=
    configuration_mem_logConfigurations_of_prefix
      previous.configuration
      previous.chosenPrefix
      (candidateState.log candidate)
      (chosenCommitCertificate_configuration_mem_chosenPrefix previous)
      previousInCandidate
  have candidateThresholdLe :
      lastConfigurationToIndex
          (logConfigurations (candidateState.log candidate))
          (candidateState.commitIndex candidate) <=
        certificate.configuration.index := by
    have member := candidateConfiguration
    rw [candidateExact candidate] at member
    have details :
        certificate.configuration ∈
            logConfigurations (candidateState.log candidate) ∧
          lastConfigurationToIndex
              (logConfigurations (candidateState.log candidate))
              (candidateState.commitIndex candidate) <=
            certificate.configuration.index := by
      simpa [activeLogConfigurations, configurationsFromIndex] using member
    exact details.2
  have previousInCandidateConfigurations :
      previous.configuration ∈
        candidateState.configurations candidate := by
    rw [candidateExact candidate]
    simp [activeLogConfigurations, configurationsFromIndex,
      previousInCandidateLog]
    exact
      candidateThresholdLe.trans
        (by rw [previousIndexEq]; omega)
  have previousInChoiceConfigurations :
      previous.configuration ∈ state.configurations leader :=
    configurationsExact_committedConfigurationAt?_mem
      state
      leader
      stateExact
      previous.configuration
      previous.configuration_at
  exact
    ⟨previous.configuration,
      previousInCandidateConfigurations,
      previousInChoiceConfigurations,
      previousFacts.2.trans
        ((Nat.le_of_lt commitBefore).trans indexWithin)⟩

private theorem advanceCommitIndex_candidate_commonConfiguration_or_carries
    {start : InitialConfiguration}
    {actions : List Action}
    {state candidateState : State}
    {leader candidate : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (commitBefore : state.commitIndex leader < index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (candidateEndpoint :
      StateAtWitness start actions state candidateState)
    (lowerTermLeaders :
      forall leaderState,
        StateAt start actions state leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <
                    candidateState.currentTerm candidate ->
                isLogPrefix
                  (logPrefix (state.log leader) index)
                  (leaderState.log historicalLeader))
    (higherTerm :
      state.currentTerm leader <
        candidateState.currentTerm candidate)
    (candidateWitness :
      CurrentCandidateChosenConfigurationWitness
        start
        candidateEndpoint.pastActions
        candidateState
        candidate)
    (previousCarries :
      forall previous :
          ChosenCommitCertificate
            start actions state state leader (state.commitIndex leader),
        SignatureCommitBoundary state leader (state.commitIndex leader) ->
          previous.choiceTerm <
              candidateState.currentTerm candidate ->
            isLogPrefix
              previous.chosenPrefix
              (candidateState.log candidate)) :
    Or
      (isLogPrefix
        (logPrefix (state.log leader) index)
        (candidateState.log candidate))
      (Exists fun configuration : ConfigurationAt =>
        And
          (configuration ∈ candidateState.configurations candidate)
          (And
            (configuration ∈ state.configurations leader)
            (configuration.index <=
              highestCommittableIndex state leader))) := by
  rcases
      chosenCommitCertificate_stateAtWitness_coherent
        candidateEndpoint
        (historicalCompleteSafetyCore_prefixes history core)
        candidateWitness.basis.certificate
        candidateWitness.basis.boundary with
    ⟨extended, extension⟩
  have pendingAtExtendedChoice :
      state.currentTerm leader < extended.choiceTerm ->
        isLogPrefix
          (logPrefix (state.log leader) index)
          (extended.choiceState.log extended.choiceLeader) := by
    intro pendingEarlier
    have extendedEarlier :
        extended.choiceTerm <
          candidateState.currentTerm candidate := by
      rw [extension.choiceTerm_eq]
      exact candidateWitness.choice_term_lt_candidate
    exact
      lowerTermLeaders
        extended.choiceState
        extended.choice_at
        extended.choiceLeader
        extended.choice_leader
        (by simpa [extended.choice_term] using pendingEarlier)
        (by simpa [extended.choice_term] using extendedEarlier)
  rcases
      advanceCommitIndex_pendingPrefix_comparable_with_certificate
        history core enabled extended pendingAtExtendedChoice with
    extendedToPending | pendingToExtended
  · have localToPending :
        isLogPrefix
          candidateWitness.basis.certificate.chosenPrefix
          (logPrefix (state.log leader) index) := by
      simpa [extension.chosenPrefix_eq] using extendedToPending
    let threshold :=
      lastConfigurationToIndex
        (logConfigurations (state.log leader))
        (state.commitIndex leader)
    by_cases thresholdWithin :
        threshold <=
          candidateWitness.basis.certificate.configuration.index
    · exact
        Or.inr
          ⟨candidateWitness.basis.certificate.configuration,
            candidateConfiguration_common_with_pendingChoice
              candidateWitness.basis.certificate
              candidateWitness.basis.configuration_mem
              localToPending
              thresholdWithin
              (reachable_ConfigurationsExactInv
                start (protocolHistory_reachable history))
              indexWithin⟩
    · exact
        Or.inr
          (previousCommittedConfiguration_common_with_candidate
            history
            core
            candidateWitness.basis.certificate
            candidateWitness.basis.configuration_mem
            (reachable_ConfigurationsExactInv
              start (stateAt_reachable ⟨candidateEndpoint⟩))
            (reachable_ConfigurationsExactInv
              start (protocolHistory_reachable history))
            ⟨candidateEndpoint⟩
            higherTerm
            commitBefore
            indexWithin
            (by simpa [threshold] using Nat.lt_of_not_ge thresholdWithin)
            previousCarries)
  · have pendingToLocal :
        isLogPrefix
          (logPrefix (state.log leader) index)
          candidateWitness.basis.certificate.chosenPrefix := by
      simpa [extension.chosenPrefix_eq] using pendingToExtended
    exact
      Or.inl
        (pendingToLocal.trans candidateWitness.basis.candidate_carries)

private theorem advanceCommitIndex_choiceSupport_acknowledges_choiceIndexPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader member : Node}
    (leaderState : state.leadershipState leader = .leader)
    (support :
      ChoiceSupportWitness
        start
        (actions ++ [.advanceCommitIndex leader])
        (next state (.advanceCommitIndex leader))
        state
        leader
        member
        (highestCommittableIndex state leader)
        (state.currentTerm leader))
    (matching :
      TemporalLogMatchingInv
        start support.choiceActions state) :
    Exists fun strongAck :
        SuccessfulAckSendPrefixWitness
          start
          support.choiceActions
          state
          leader
          member
          support.matchWitness.response
          support.matchWitness.lastLogIndex =>
      isLogPrefix
        (logPrefix
          (state.log leader)
          (highestCommittableIndex state leader))
        (logPrefix
          ((next
            strongAck.ack.origin.responseState
            (.receive
              member
              leader
              strongAck.ack.origin.kind.receiveKind)).log member)
          support.matchWitness.lastLogIndex) := by
  rcases
      occurs_before_stateAt support.matchWitness.handle_occurrence with
    ⟨handledStateAtChoice⟩
  have matchingAtHandled :
      TemporalLogMatchingInv
        start
        handledStateAtChoice.pastActions
        support.matchWitness.handledState := by
    intro first second firstAt secondAt
    exact
      matching
        first
        second
        (stateAt_extend_stateAtWitness handledStateAtChoice firstAt)
        (stateAt_extend_stateAtWitness handledStateAtChoice secondAt)
  have responseQueued :
      support.matchWitness.response ∈
        support.matchWitness.handledState.messages leader member :=
    headMessage?_mem
      support.matchWitness.handledState
      leader
      member
      support.matchWitness.response
      support.matchWitness.response_head
  rcases
      queueHistory_implies_SuccessfulAckSendPrefixConsistent
          matchingAtHandled
          (protocolHistory_implies_QueueHistoryConsistent
            handledStateAtChoice.stateHistory)
          leader
          member
          support.matchWitness.response
          support.matchWitness.lastLogIndex
          responseQueued
          support.matchWitness.ack.response_body with
    ⟨strongAck⟩
  let extendedOrigin :
      AEResponseWitness
        start support.choiceActions state leader member
        support.matchWitness.response :=
    {
      strongAck.ack.origin with
      occurrence :=
        occurs_extend_stateAtWitness
          handledStateAtChoice strongAck.ack.origin.occurrence
    }
  let extendedAck :
      AckWitness
        start support.choiceActions state leader member
        support.matchWitness.response
        support.matchWitness.lastLogIndex :=
    {
      strongAck.ack with
      origin := extendedOrigin
    }
  let strongAckAtChoice :
      SuccessfulAckSendPrefixWitness
        start support.choiceActions state leader member
        support.matchWitness.response
        support.matchWitness.lastLogIndex :=
    {
      strongAck with
      ack := extendedAck
      send_occurrence :=
        occurs_extend_stateAtWitness
          handledStateAtChoice strongAck.send_occurrence
    }
  have sendToChoice :
      isLogPrefix
        (strongAckAtChoice.sendState.log leader)
        (state.log leader) :=
    (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
      support.choice_history)
      strongAckAtChoice.sendState
      (occurs_before_stateAt strongAckAtChoice.send_occurrence)
      leader
      strongAckAtChoice.send_leader
      leaderState
      (strongAckAtChoice.send_term.trans
        support.response_term)
  have sendBound :
      support.matchWitness.lastLogIndex <=
        (strongAckAtChoice.sendState.log leader).length := by
    have lengthEq := congrArg List.length strongAckAtChoice.prefix_eq
    simp [logPrefix, List.length_take,
      Nat.min_eq_left strongAckAtChoice.ack.index_bounded] at lengthEq
    omega
  have choiceBound :
      support.matchWitness.lastLogIndex <=
        (state.log leader).length :=
    sendBound.trans sendToChoice.length_le
  have sendPrefixEq :
      logPrefix
          (strongAckAtChoice.sendState.log leader)
          support.matchWitness.lastLogIndex =
        logPrefix
          (state.log leader)
          support.matchWitness.lastLogIndex :=
    logPrefix_eq_of_prefixes
      (strongAckAtChoice.sendState.log leader)
      (state.log leader)
      (state.log leader)
      support.matchWitness.lastLogIndex
      sendToChoice
      List.prefix_rfl
      sendBound
      choiceBound
  exact
    ⟨strongAckAtChoice, by
      rw [strongAckAtChoice.prefix_eq, sendPrefixEq]
      exact
        logPrefix_mono_isLogPrefix
          (state.log leader)
          (highestCommittableIndex state leader)
          support.matchWitness.lastLogIndex
          support.index_le_ack⟩

private theorem signatureLogPrefix_committable
    {reference : List Entry}
    {state : State}
    {node : Node}
    {index : Nat}
    (signature :
      (entryAt? reference index).map (·.content) =
        some .signature)
    (retained :
      isLogPrefix
        (logPrefix reference index)
        (state.log node)) :
    isLogPrefix
      (logPrefix reference index)
      (committable state node) := by
  cases entryAt :
      entryAt? reference index with
  | none =>
      simp [entryAt] at signature
  | some entry =>
    have entrySignature : entry.content = .signature := by
      simpa [entryAt] using signature
    have indexWithin : index <= reference.length := by
      unfold entryAt? at entryAt
      split at entryAt
      · contradiction
      · have beforeLength :=
          (List.getElem?_eq_some_iff.mp entryAt).choose
        omega
    have prefixLength :
        (logPrefix reference index).length = index := by
      simp [logPrefix, List.length_take,
        Nat.min_eq_left indexWithin]
    have atPrefix :
        entryAt? (logPrefix reference index) index =
          some entry := by
      exact
        entryAt?_take_of_some
          reference index index entry entryAt (Nat.le_refl _)
    rcases retained with ⟨suffix, stateLogEq⟩
    have atState :
        entryAt? (state.log node) index = some entry := by
      rw [← stateLogEq]
      exact
        entryAt?_append_of_some
          (logPrefix reference index)
          suffix
          index
          entry
          atPrefix
    have withinCommittable :
        index <= maxCommittableIndex (state.log node) :=
      index_le_maxCommittableIndex_of_signature
        (state.log node)
        index
        (by simp [atState, entrySignature])
    have prefixAtState :
        logPrefix reference index =
          logPrefix (state.log node) index :=
      prefix_eq_logPrefix_of_length
        (logPrefix reference index)
        (state.log node)
        index
        ⟨suffix, stateLogEq⟩
        prefixLength
    rw [committable, prefixAtState]
    exact
      logPrefix_mono_isLogPrefix
        (state.log node)
        index
        (maxCommittableIndex (state.log node))
        withinCommittable

private theorem signatureLogPrefix_length
    {entries : List Entry}
    {index : Nat}
    (signature :
      (entryAt? entries index).map (·.content) =
        some .signature) :
    (logPrefix entries index).length = index := by
  cases entryAt : entryAt? entries index with
  | none =>
      simp [entryAt] at signature
  | some entry =>
    have indexWithin : index <= entries.length := by
      unfold entryAt? at entryAt
      split at entryAt
      · contradiction
      · have beforeLength :=
          (List.getElem?_eq_some_iff.mp entryAt).choose
        omega
    simp [logPrefix, List.length_take,
      Nat.min_eq_left indexWithin]

private theorem higherTermConflictThenNoConflict_retains_signaturePrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state : State}
    {choiceLeader follower receiveDest receiveSource : Node}
    {message : Message}
    {previousIndex previousTerm leaderCommitIndex index choiceTerm : Nat}
    {entries : List Entry}
    (stateAt : StateAt start actions endState state)
    (higherTermLeaders :
      forall leaderState,
        StateAt start actions endState leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              choiceTerm <
                  leaderState.currentTerm historicalLeader ->
                isLogPrefix
                  (logPrefix (endState.log choiceLeader) index)
                  (leaderState.log historicalLeader))
    (signature :
      (entryAt? (endState.log choiceLeader) index).map (·.content) =
        some .signature)
    (higherTerm : choiceTerm < state.currentTerm follower)
    (retained :
      isLogPrefix
        (logPrefix (endState.log choiceLeader) index)
        (state.log follower))
    (head :
      headMessage? state receiveDest receiveSource = some message)
    (body :
      message.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (enabled :
      Enabled state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)) :
    isLogPrefix
      (logPrefix (endState.log choiceLeader) index)
      ((next state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)).log follower) := by
  by_cases followerIsDest : follower = receiveDest
  · subst receiveDest
    have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    rcases stateAt with ⟨stateAtWitness⟩
    have requests :=
      queueHistory_implies_AppendEntriesRequestHistoryConsistent
        (protocolHistory_implies_QueueHistoryConsistent
          stateAtWitness.stateHistory)
    have requestQueued :
        message ∈ state.messages follower receiveSource :=
      headMessage?_mem state follower receiveSource message head
    rcases
        (by
          simpa [body] using
            requests follower receiveSource message requestQueued) with
      ⟨send⟩
    have fields := body
    rw [send.message_eq] at fields
    simp [appendEntriesMessage] at fields
    rcases fields with
      ⟨previousIndexEq, previousTermEq, entriesEq,
        leaderCommitIndexEq⟩
    subst previousIndex
    subst previousTerm
    subst entries
    subst leaderCommitIndex
    have requestSend :
        Occurs
          start actions endState send.sendState
          (.appendEntries receiveSource follower) :=
      occurs_extend_stateAtWitness stateAtWitness send.occurrence
    have requestLeader :
        send.sendState.leadershipState receiveSource = .leader := by
      rcases send.occurrence with ⟨sendOccurrence⟩
      have sendEnabled := sendOccurrence.enabled
      simp [Enabled, actionEnabled] at sendEnabled
      exact sendEnabled.1.1.2
    have accept :
        appendEntriesAcceptBase
            state
            follower
            (send.sendState.currentTerm receiveSource)
            (send.sendState.sentIndex receiveSource follower)
            (((entryAt?
                  (send.sendState.log receiveSource)
                  (send.sendState.sentIndex receiveSource follower)).map
                (·.term)).getD 0) =
          true := by
      simpa [send.message_eq, appendEntriesMessage] using
        branchEnabled.2.2.1.1
    have acceptFacts := accept
    simp [appendEntriesAcceptBase] at acceptFacts
    have sourceHigher :
        choiceTerm <
          send.sendState.currentTerm receiveSource :=
      higherTerm.trans_eq acceptFacts.1.1.1.symm
    have sourceCarries :=
      higherTermLeaders
        send.sendState
        (occurs_before_stateAt requestSend)
        receiveSource
        requestLeader
        sourceHigher
    have prefixLength :=
      signatureLogPrefix_length signature
    have selfPrefixEq :
        logPrefix (endState.log choiceLeader) index =
          logPrefix
            (logPrefix (endState.log choiceLeader) index)
            index := by
      have takeLength :
          (logPrefix (endState.log choiceLeader) index).take
              (logPrefix (endState.log choiceLeader) index).length =
            logPrefix (endState.log choiceLeader) index :=
        List.take_length
      exact
        takeLength.symm.trans
          (by
            simpa [logPrefix] using
              congrArg
                (fun n =>
                  (logPrefix
                    (endState.log choiceLeader) index).take n)
                prefixLength)
    have previousAtLeastIndex :
        index <= send.sendState.sentIndex receiveSource follower :=
      appendEntriesConflict_previousIndex_ge_referencePrefix
        state
        follower
        (send.sendState.log receiveSource)
        (logPrefix (endState.log choiceLeader) index)
        (logPrefix (endState.log choiceLeader) index)
        (send.sendState.sentIndex receiveSource follower)
        index
        selfPrefixEq
        prefixLength
        retained
        (Or.inl sourceCarries)
        (by
          simpa [send.message_eq, appendEntriesMessage] using
            branchEnabled.2.2.1.2)
    have oldBound : index <= (state.log follower).length := by
      rw [← prefixLength]
      exact retained.length_le
    have prefixAtOld :
        logPrefix (endState.log choiceLeader) index =
          logPrefix (state.log follower) index :=
      prefix_eq_logPrefix_of_length
        _
        _
        index
        retained
        prefixLength
    have resultPrefixEq :
        logPrefix
            ((next state
              (.receive
                follower receiveSource
                .appendEntriesConflictThenNoConflict)).log follower)
            index =
          logPrefix (state.log follower) index := by
      simp [next, rawNext, nextReceive, head,
        send.message_eq, appendEntriesMessage,
        nextAppendEntriesNoConflict, conflictRollback,
        logPrefix]
      rw [List.take_append_of_le_length
        (by
          simpa [List.length_take] using
            Nat.le_min.mpr
              ⟨previousAtLeastIndex, oldBound⟩)]
      simp [List.take_take,
        Nat.min_eq_left previousAtLeastIndex]
    rw [prefixAtOld, ← resultPrefixEq]
    exact logPrefix_isLogPrefix _ _
  · have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    simpa [next, rawNext, nextReceive, head, body,
      nextAppendEntriesNoConflict, conflictRollback,
      branchEnabled.2.1.1, followerIsDest] using retained

private theorem higherTermSignaturePrefix_step
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state : State}
    {choiceLeader member : Node}
    {index choiceTerm : Nat}
    {action : Action}
    (stateAt : StateAt start actions endState state)
    (higherTermLeaders :
      forall leaderState,
        StateAt start actions endState leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              choiceTerm <
                  leaderState.currentTerm historicalLeader ->
                isLogPrefix
                  (logPrefix (endState.log choiceLeader) index)
                  (leaderState.log historicalLeader))
    (signature :
      (entryAt? (endState.log choiceLeader) index).map (·.content) =
        some .signature)
    (higherTerm : choiceTerm < state.currentTerm member)
    (retained :
      isLogPrefix
        (logPrefix (endState.log choiceLeader) index)
        (state.log member))
    (enabled : Enabled state action) :
    isLogPrefix
      (logPrefix (endState.log choiceLeader) index)
      ((next state action).log member) := by
  have retainLog
      (logRetained :
        isLogPrefix
          (state.log member)
          ((next state action).log member)) :
      isLogPrefix
        (logPrefix (endState.log choiceLeader) index)
        ((next state action).log member) :=
    retained.trans logRetained
  cases action with
  | timeout node =>
      exact retainLog (by simp [isLogPrefix, next, rawNext, nextTimeout])
  | requestVote source dest =>
      exact retainLog
        (by simp [isLogPrefix, next, rawNext, nextRequestVote])
  | appendEntries source dest =>
      exact retainLog
        (by simp [isLogPrefix, next, rawNext, nextAppendEntries])
  | becomeLeader elected =>
      by_cases memberIsElected : member = elected
      · subst elected
        simpa [next, rawNext, nextBecomeLeader] using
          signatureLogPrefix_committable signature retained
      · exact retainLog
          (by
            simp [isLogPrefix, next, rawNext, nextBecomeLeader,
              memberIsElected])
  | clientRequest node =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextClientRequest])
      · exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextClientRequest,
            memberIsNode])
  | signCommittableMessages node =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages])
      · exact retainLog
          (by
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages, memberIsNode])
  | changeConfiguration node configuration =>
      by_cases memberIsNode : member = node
      · subst node
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration])
      · exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration,
            memberIsNode])
  | advanceCommitIndex node =>
      exact retainLog
        (by simp [isLogPrefix, next, rawNext, nextAdvanceCommitIndex])
  | receive receiveDest receiveSource kind =>
      cases head :
          headMessage? state receiveDest receiveSource with
      | none =>
          exact retainLog
            (by simp [isLogPrefix, next, rawNext, nextReceive, head])
      | some message =>
          cases kind with
          | rejectAppendEntriesRequest =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      exact retainLog
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, responseCase])
                  | some producedResponse =>
                      exact retainLog
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, responseCase])
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesNoConflict =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have enabledFacts := enabled
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabledFacts
                  have messageDest : message.dest = receiveDest :=
                    enabledFacts.2.1.1
                  have noConflict := enabledFacts.2.2.2
                  exact retainLog
                    (by
                      by_cases memberIsDest : member = receiveDest
                      · subst member
                        simpa [next, rawNext, nextReceive, head, body,
                          messageDest] using
                          appendEntriesNoConflict_retains_old_log
                            state message previousIndex entries
                            leaderCommitIndex noConflict
                      · simp [isLogPrefix, next, rawNext, nextReceive,
                          head, body, nextAppendEntriesNoConflict,
                          messageDest, memberIsDest])
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesConflictThenAlreadyDone =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, head] at branchEnabled
                  have requestDestEq := branchEnabled.2.1.1
                  have branchEnabled := branchEnabled.2.2
                  simp [receiveBranchEnabled, body,
                    appendEntriesAcceptBase, appendEntriesLogOK,
                    appendEntriesAlreadyDoneGuard,
                    appendEntriesConflictGuard, conflictRollback,
                    updateNode, requestDestEq] at branchEnabled
                  rcases branchEnabled with
                    ⟨⟨_, conflict⟩, alreadyDone⟩
                  have entriesNonempty : entries ≠ [] :=
                    conflict.1.1
                  rcases alreadyDone with entriesEmpty | bounded
                  · exact False.elim (entriesNonempty entriesEmpty)
                  · exact False.elim (entriesNonempty bounded.2)
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesConflictThenNoConflict =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  exact
                    higherTermConflictThenNoConflict_retains_signaturePrefix
                      stateAt
                      higherTermLeaders
                      signature
                      higherTerm
                      retained
                      head
                      body
                      enabled
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | _ =>
              cases body : message.body <;>
                exact retainLog
                  (by
                    simp [isLogPrefix, next, rawNext, nextReceive,
                      head, body, nextAppendEntriesAlreadyDone])

private theorem currentTermIncrease_log_unchanged
    (state : State)
    (action : Action)
    (member : Node)
    (increased :
      state.currentTerm member <
        (next state action).currentTerm member) :
    (next state action).log member = state.log member := by
  cases action with
  | timeout candidate =>
      simp [next, rawNext, nextTimeout]
  | requestVote source dest =>
      simp [next, rawNext, nextRequestVote] at increased
  | appendEntries source dest =>
      simp [next, rawNext, nextAppendEntries] at increased
  | becomeLeader elected =>
      simp [next, rawNext, nextBecomeLeader] at increased
  | clientRequest node =>
      simp [next, rawNext, nextClientRequest] at increased
  | signCommittableMessages node =>
      simp [next, rawNext, nextSignCommittableMessages] at increased
  | changeConfiguration node configuration =>
      simp [next, rawNext, nextChangeConfiguration] at increased
  | advanceCommitIndex node =>
      simp [next, rawNext, nextAdvanceCommitIndex] at increased
  | receive dest source kind =>
      cases head : headMessage? state dest source with
      | none =>
          simp [next, rawNext, nextReceive, head] at increased
      | some message =>
          cases kind with
          | updateTerm =>
              simp [next, rawNext, nextReceive, head]
          | _ =>
              cases body : message.body <;>
                simp [next, rawNext, nextReceive, head, body,
                  nextAppendEntriesAlreadyDone,
                  nextAppendEntriesNoConflict, conflictRollback]
                  at increased
              all_goals split at increased <;> simp at increased

private theorem candidate_sameTerm_step_backwards
    (state : State)
