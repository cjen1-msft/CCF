        true := by
    simpa [next, rawNext, nextTimeout, updateNode] using afterQuorum
  have leaderUniqueness :=
    completeSafetyCore_implies_leaderUniqueness history core
  apply
    quorumReadyCandidate_carries_chosenPrefix_by_choice_progress_at_term
      history
      core
      candidateWitness
      target
      boundary
      ((next state (.timeout candidate)).currentTerm candidate)
      targetEarlier
  intro targetState targetOwner targetIndex certificate
    certificateBoundary earlier activeConfiguration
    candidateConfigurationActive configurationActiveAtChoice
    configurationWithinChoice
  have candidateQuorum :
      isQuorum
          ({candidate} ∩ activeConfiguration.nodes)
          activeConfiguration.nodes =
        true := by
    have allQuorums := singletonQuorum
    simp [allConfigurationsHaveQuorum] at allQuorums
    exact
      allQuorums activeConfiguration candidateConfigurationActive
  rcases
      certificate.watermark_causal_support
        activeConfiguration
        configurationActiveAtChoice
        configurationWithinChoice with
    ⟨supportQuorum, supportQuorumOk, support⟩
  rcases
      isQuorum_intersects
