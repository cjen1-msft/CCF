            (sendState.log source).length
            (sendState.sentIndex source follower + 1)) ≠
        [] :=
    conflictFacts.1.1
  have senderBeforeEnd :
      sendState.sentIndex source follower <
        (sendState.log source).length :=
    previousIndex_lt_of_next_subsequence_nonempty
      (sendState.log source)
      (sendState.sentIndex source follower)
      payloadNonempty
  have sendLeader :
      sendState.leadershipState source = .leader := by
    rcases send with ⟨occurrence⟩
