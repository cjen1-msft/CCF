theorem advanceCommitIndex_watermark_causal_support
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader : Node}
    (history : ProtocolHistory start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (activeConfiguration : ConfigurationAt)
    (configurationActive :
      activeConfiguration ∈ state.configurations leader)
    (configurationWithin :
      activeConfiguration.index <=
        highestCommittableIndex state leader) :
    Exists fun activeQuorum : Configuration =>
      And
        (isQuorum activeQuorum activeConfiguration.nodes = true)
        (forall member : Node,
          member ∈ activeQuorum ->
            Or
              (member = leader)
              (Nonempty
                (ChoiceSupportWitness
                  start
                  (actions ++ [.advanceCommitIndex leader])
                  (next state (.advanceCommitIndex leader))
                  state
                  leader
                  member
                  (highestCommittableIndex state leader)
                  (state.currentTerm leader)))) := by
  have enabledFacts := enabled
  simp [Enabled, actionEnabled] at enabledFacts
  have leaderState : state.leadershipState leader = .leader :=
    enabledFacts.1.2
  have highestPositive :
      0 < highestCommittableIndex state leader := by
    omega
  have consensus :=
    highestCommittableIndex_hasConsensusWatermark_of_pos
      state leader highestPositive
  simp [hasConsensusWatermark] at consensus
  have activeConsensus :=
    consensus activeConfiguration configurationActive
  let agreeing :=
    activeConfiguration.nodes.filter fun member =>
      highestCommittableIndex state leader <=
        state.matchIndex leader member
  let activeQuorum :=
    if leader ∈ activeConfiguration.nodes then
      insert leader agreeing
    else
      agreeing
  have activeQuorumOk :
      isQuorum activeQuorum activeConfiguration.nodes = true := by
    rcases activeConsensus with configurationAfter | quorumOk
    · omega
    · simpa [activeQuorum, agreeing] using quorumOk
  refine ⟨activeQuorum, activeQuorumOk, ?_⟩
  intro member memberInQuorum
  have leaderOrAgreeing :
      Or (member = leader) (member ∈ agreeing) := by
    dsimp [activeQuorum] at memberInQuorum
    by_cases leaderMember : leader ∈ activeConfiguration.nodes
    · simpa [leaderMember] using memberInQuorum
    · exact Or.inr (by simpa [leaderMember] using memberInQuorum)
  rcases leaderOrAgreeing with memberIsLeader | memberAgreeing
  · exact Or.inl memberIsLeader
  · exact Or.inr
      (advanceCommitIndex_choiceSupportWitness
        history
        leaderState
        highestPositive
        (by
          have agreeingFacts :
              member ∈ activeConfiguration.nodes ∧
                highestCommittableIndex state leader <=
                  state.matchIndex leader member := by
            simpa [agreeing] using memberAgreeing
          exact agreeingFacts.2))

