theorem candidateChosenConfigurations_overlap_by_choice_progress
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {firstCandidate secondCandidate : Node}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (first :
      CandidateChosenConfigurationWitness
        start actions state firstCandidate)
    (second :
      CandidateChosenConfigurationWitness
        start actions state secondCandidate)
    (secondEarlierForFirst :
      second.certificate.choiceTerm <
        state.currentTerm firstCandidate)
    (firstEarlierForSecond :
      first.certificate.choiceTerm <
        state.currentTerm secondCandidate)
    (firstTransferAtCommonConfiguration :
      forall boundaryState owner index,
        forall certificate :
            ChosenCommitCertificate
              start actions state boundaryState owner index,
          SignatureCommitBoundary boundaryState owner index ->
            certificate.choiceTerm <
                state.currentTerm firstCandidate ->
              forall activeConfiguration : ConfigurationAt,
                activeConfiguration ∈
                    state.configurations firstCandidate ->
                  activeConfiguration ∈
                      certificate.choiceState.configurations
                        certificate.choiceLeader ->
                    activeConfiguration.index <=
                        certificate.choiceIndex ->
                      isLogPrefix
                        certificate.chosenPrefix
                        (state.log firstCandidate))
    (secondTransferAtCommonConfiguration :
      forall boundaryState owner index,
        forall certificate :
            ChosenCommitCertificate
              start actions state boundaryState owner index,
          SignatureCommitBoundary boundaryState owner index ->
            certificate.choiceTerm <
                state.currentTerm secondCandidate ->
              forall activeConfiguration : ConfigurationAt,
                activeConfiguration ∈
                    state.configurations secondCandidate ->
                  activeConfiguration ∈
                      certificate.choiceState.configurations
                        certificate.choiceLeader ->
                    activeConfiguration.index <=
                        certificate.choiceIndex ->
                      isLogPrefix
                        certificate.chosenPrefix
                        (state.log secondCandidate)) :
    Exists fun firstConfiguration : ConfigurationAt =>
      Exists fun secondConfiguration : ConfigurationAt =>
        And
          (firstConfiguration ∈
            state.configurations firstCandidate)
          (And
            (secondConfiguration ∈
              state.configurations secondCandidate)
            (firstConfiguration.nodes =
              secondConfiguration.nodes)) := by
  have firstCarriesSecond :=
    quorumReadyCandidate_carries_chosenPrefix_by_choice_progress
      history
      core
      first
      second.certificate
      second.boundary
      secondEarlierForFirst
      firstTransferAtCommonConfiguration
  have secondCarriesFirst :=
    quorumReadyCandidate_carries_chosenPrefix_by_choice_progress
      history
      core
      second
      first.certificate
      first.boundary
      firstEarlierForSecond
      secondTransferAtCommonConfiguration
  have exact :
      ConfigurationsExactInv state :=
    reachable_ConfigurationsExactInv
      start
      (protocolHistory_reachable history)
  exact
    candidateChosenConfigurations_overlap_of_mutual_carry
      first
      second
      exact
      exact
      firstCarriesSecond
      secondCarriesFirst

private theorem occurrence_complete_prefix_replays_before
    {start : InitialConfiguration}
    {actions : List Action}
    {state firstBefore secondBefore : State}
    {firstAction secondAction : Action}
    (first :
      OccurrenceWitness
        start actions state firstBefore firstAction)
    (second :
      OccurrenceWitness
        start actions state secondBefore secondAction)
    (isPrefix :
      first.pastActions ++ [firstAction] <+:
        second.pastActions) :
    Exists fun betweenActions =>
      Replays
        (next firstBefore firstAction)
        betweenActions
        secondBefore := by
  rcases isPrefix with ⟨betweenActions, pastActionsEq⟩
  have secondHistory := second.before_history
  rw [← pastActionsEq] at secondHistory
  rcases replays_append_split secondHistory with
    ⟨middleState, firstReplay, betweenReplay⟩
  have expectedFirstReplay :
      Replays
        (initialState start)
        (first.pastActions ++ [firstAction])
        (next firstBefore firstAction) :=
    replays_append_singleton first.before_history first.enabled
  have stateEq :
      middleState = next firstBefore firstAction :=
    replays_deterministic firstReplay expectedFirstReplay
  exact
    ⟨betweenActions,
      by simpa only [stateEq] using betweenReplay⟩

private theorem higherTerm_vote_ackActions_prefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state ackState grantState : State}
    {choiceLeader member candidate : Node}
    {kind : AEResponseKind}
    {choiceTerm candidateTerm : Nat}
    (ack :
      OccurrenceWitness
        start actions state ackState
        (.receive member choiceLeader kind.receiveKind))
    (grant :
      OccurrenceWitness
        start actions state grantState
        (.receive member candidate .handleRequestVoteRequest))
    (ackAfterTerm :
      (next ackState
        (.receive member choiceLeader kind.receiveKind)).currentTerm member =
        choiceTerm)
    (grantTerm :
      grantState.currentTerm member = candidateTerm)
    (higherTerm : choiceTerm < candidateTerm) :
    ack.pastActions ++
        [.receive member choiceLeader kind.receiveKind] <+:
      grant.pastActions := by
  let ackAction : Action :=
    .receive member choiceLeader kind.receiveKind
  let grantAction : Action :=
    .receive member candidate .handleRequestVoteRequest
  let ackActions := ack.pastActions ++ [ackAction]
  let grantActions := grant.pastActions ++ [grantAction]
  have ackPrefix : ackActions <+: actions :=
    ⟨ack.futureActions,
      by
        simpa only [ackActions, ackAction, List.append_assoc] using
          ack.actions_eq.symm⟩
  have grantPrefix : grantActions <+: actions :=
    ⟨grant.futureActions,
      by
        simpa only [grantActions, grantAction, List.append_assoc] using
          grant.actions_eq.symm⟩
  rcases
      List.prefix_or_prefix_of_prefix ackPrefix grantPrefix with
    ackBeforeGrant | grantBeforeAck
  · rcases
        prefix_append_singleton_cases
          (by simpa [ackActions, grantActions, grantAction] using
            ackBeforeGrant) with
      beforeGrant | sameOccurrence
    · simpa [ackAction] using beforeGrant
    · have lastActions :=
        congrArg List.getLast? sameOccurrence
      have actionFacts :
          choiceLeader = candidate ∧
            kind.receiveKind = .handleRequestVoteRequest := by
        simpa [ackActions, grantActions, ackAction, grantAction] using
          lastActions
      have differentKinds :
          kind.receiveKind ≠ .handleRequestVoteRequest := by
        cases kind <;> decide
      exact False.elim (differentKinds actionFacts.2)
  · rcases
        prefix_append_singleton_cases
          (by simpa [ackActions, grantActions, ackAction] using
            grantBeforeAck) with
      beforeAck | sameOccurrence
    · rcases
          occurrence_complete_prefix_replays_before
            grant
            ack
            (by simpa [grantAction] using beforeAck) with
        ⟨betweenActions, grantAfterToAckBefore⟩
      have grantAfterToAckAfter :
          Replays
            (next grantState
              (.receive member candidate .handleRequestVoteRequest))
            (betweenActions ++ [ackAction])
            (next ackState
              (.receive member choiceLeader kind.receiveKind)) :=
        replays_append_singleton
          grantAfterToAckBefore ack.enabled
      have grantStep :=
        monotonicTerm_step
          grantState
          (.receive member candidate .handleRequestVoteRequest)
          grant.enabled
          member
      have afterGrantToAck :=
        replays_currentTerm_mono grantAfterToAckAfter member
      have impossible : candidateTerm <= choiceTerm := by
        rw [← grantTerm, ← ackAfterTerm]
        exact Nat.le_trans grantStep afterGrantToAck
      omega
    · have lastActions :=
        congrArg List.getLast? sameOccurrence
      have actionFacts :
          candidate = choiceLeader ∧
            .handleRequestVoteRequest = kind.receiveKind := by
        simpa [ackActions, grantActions, ackAction, grantAction] using
          lastActions
      have differentKinds :
          kind.receiveKind ≠ .handleRequestVoteRequest := by
        cases kind <;> decide
      exact False.elim (differentKinds actionFacts.2.symm)

private theorem choice_ack_precedes_higher_term_vote_occurrence
    {start : InitialConfiguration}
    {actions : List Action}
    {state choiceState grantState : State}
    {choiceLeader member candidate : Node}
    {choiceIndex choiceTerm candidateTerm : Nat}
    (history : ProtocolHistory start actions state)
    (support :
      ChoiceSupportWitness
        start actions state choiceState
        choiceLeader member choiceIndex choiceTerm)
    (grant :
      Occurs
        start actions state grantState
        (.receive member candidate .handleRequestVoteRequest))
    (grantTerm :
      grantState.currentTerm member = candidateTerm)
    (higherTerm : choiceTerm < candidateTerm) :
    Exists fun betweenActions =>
      Replays
        (next
          support.matchWitness.ack.origin.responseState
          (.receive
            member
            choiceLeader
            support.matchWitness.ack.origin.kind.receiveKind))
        betweenActions
        grantState := by
  rcases support.choice_actions_prefix with
    ⟨choiceFutureActions, choiceActionsEq⟩
  have fullHistory := history
  rw [← choiceActionsEq] at fullHistory
  rcases replays_append_split fullHistory with
    ⟨middleState, choiceReplay, remainingReplay⟩
  have choiceStateEq :
      choiceState = middleState :=
    replays_deterministic support.choice_history choiceReplay
  let choiceAt : StateAtWitness start actions state choiceState :=
    {
      pastActions := support.choiceActions
      futureActions := choiceFutureActions
      actions_eq := choiceActionsEq.symm
      stateHistory := support.choice_history
      remainingHistory := by
        simpa only [choiceStateEq] using remainingReplay
    }
  have ackOccurrence :
      Occurs
        start actions state
        support.matchWitness.ack.origin.responseState
        (.receive
          member
          choiceLeader
          support.matchWitness.ack.origin.kind.receiveKind) :=
    occurs_extend_stateAtWitness
      choiceAt support.matchWitness.ack.origin.occurrence
  rcases ackOccurrence with ⟨ack⟩
  rcases grant with ⟨grantWitness⟩
  let ackAction : Action :=
    .receive
      member
      choiceLeader
      support.matchWitness.ack.origin.kind.receiveKind
  let grantAction : Action :=
    .receive member candidate .handleRequestVoteRequest
  let ackActions := ack.pastActions ++ [ackAction]
  let grantActions := grantWitness.pastActions ++ [grantAction]
  have ackPrefix : ackActions <+: actions :=
    ⟨ack.futureActions,
      by
        simpa only [ackActions, ackAction, List.append_assoc] using
          ack.actions_eq.symm⟩
  have grantPrefix : grantActions <+: actions :=
    ⟨grantWitness.futureActions,
      by
        simpa only [grantActions, grantAction, List.append_assoc] using
          grantWitness.actions_eq.symm⟩
  have ackAfterTerm :
      (next
        support.matchWitness.ack.origin.responseState
        (.receive
          member
          choiceLeader
          support.matchWitness.ack.origin.kind.receiveKind)).currentTerm
          member =
        choiceTerm :=
    support.matchWitness.ack.response_term.symm.trans
      support.response_term
  rcases
      List.prefix_or_prefix_of_prefix ackPrefix grantPrefix with
    ackBeforeGrant | grantBeforeAck
  · rcases
        prefix_append_singleton_cases
          (by simpa [ackActions, grantActions, grantAction] using
            ackBeforeGrant) with
      beforeGrant | sameOccurrence
    · exact
        occurrence_complete_prefix_replays_before
          ack
          grantWitness
          (by simpa [ackAction] using beforeGrant)
    · have lastActions :=
        congrArg List.getLast? sameOccurrence
      have actionFacts :
          choiceLeader = candidate ∧
            support.matchWitness.ack.origin.kind.receiveKind =
              .handleRequestVoteRequest := by
        simpa [ackActions, grantActions, ackAction, grantAction] using
          lastActions
      have differentKinds :
          support.matchWitness.ack.origin.kind.receiveKind ≠
            .handleRequestVoteRequest := by
        cases support.matchWitness.ack.origin.kind <;> decide
      exact False.elim (differentKinds actionFacts.2)
  · rcases
        prefix_append_singleton_cases
          (by simpa [ackActions, grantActions, ackAction] using
            grantBeforeAck) with
      beforeAck | sameOccurrence
    · rcases
          occurrence_complete_prefix_replays_before
            grantWitness
            ack
            (by simpa [grantAction] using beforeAck) with
        ⟨betweenActions, grantAfterToAckBefore⟩
      have grantAfterToAckAfter :
          Replays
            (next grantState
              (.receive member candidate .handleRequestVoteRequest))
            (betweenActions ++ [ackAction])
            (next
              support.matchWitness.ack.origin.responseState
              (.receive
                member
                choiceLeader
                support.matchWitness.ack.origin.kind.receiveKind)) := by
        exact
          replays_append_singleton
            grantAfterToAckBefore ack.enabled
      have grantStep :=
        monotonicTerm_step
          grantState
          (.receive member candidate .handleRequestVoteRequest)
          grantWitness.enabled
          member
      have afterGrantToAck :=
        replays_currentTerm_mono
          grantAfterToAckAfter member
      have impossible :
          candidateTerm <= choiceTerm := by
        rw [← grantTerm, ← ackAfterTerm]
        exact Nat.le_trans grantStep afterGrantToAck
      omega
    · have lastActions :=
        congrArg List.getLast? sameOccurrence
      have actionFacts :
          candidate = choiceLeader ∧
            .handleRequestVoteRequest =
              support.matchWitness.ack.origin.kind.receiveKind := by
        simpa [ackActions, grantActions, ackAction, grantAction] using
          lastActions
      have differentKinds :
          support.matchWitness.ack.origin.kind.receiveKind ≠
            .handleRequestVoteRequest := by
        cases support.matchWitness.ack.origin.kind <;> decide
      exact False.elim (differentKinds actionFacts.2.symm)

theorem choice_ack_precedes_higher_term_counted_vote
    {start : InitialConfiguration}
    {actions : List Action}
    {state choiceState : State}
    {choiceLeader member candidate : Node}
    {choiceIndex choiceTerm : Nat}
    (history : ProtocolHistory start actions state)
    (support :
      ChoiceSupportWitness
        start actions state choiceState
        choiceLeader member choiceIndex choiceTerm)
    (vote :
      CountedVoteLogWitness
        start actions state candidate member)
    (higherTerm :
      choiceTerm < state.currentTerm candidate) :
    Exists fun betweenActions =>
      Replays
        (next
          support.matchWitness.ack.origin.responseState
          (.receive
            member
            choiceLeader
            support.matchWitness.ack.origin.kind.receiveKind))
        betweenActions
        vote.counted.responseOrigin.responseState := by
  have responseTerm :
      vote.counted.response.term =
        vote.counted.responseOrigin.responseState.currentTerm member := by
    simpa using
      congrArg Message.term
        vote.counted.responseOrigin.response_eq
  have grantTerm :
      vote.counted.responseOrigin.responseState.currentTerm member =
        state.currentTerm candidate :=
    responseTerm.symm.trans
      vote.counted.candidate_term_eq.symm
  exact
    choice_ack_precedes_higher_term_vote_occurrence
      history
      support
      vote.counted.responseOrigin.occurrence
      grantTerm
