private theorem nonTimeout_candidate_term_log_unchanged
    (state : State)
    (action : Action)
    (candidate : Node)
    (enabled : Enabled state action)
    (notTimeout :
      forall timedOut : Node, action ≠ .timeout timedOut)
    (afterCandidate :
      (next state action).leadershipState candidate = .candidate) :
    And
      (state.leadershipState candidate = .candidate)
      (And
        ((next state action).currentTerm candidate =
          state.currentTerm candidate)
        ((next state action).log candidate =
          state.log candidate)) := by
  have oldCandidate :=
    candidate_before_of_candidate_after
      state action candidate afterCandidate notTimeout
  refine ⟨oldCandidate, ?_, ?_⟩
  · cases action with
    | timeout timedOut =>
        exact False.elim (notTimeout timedOut rfl)
    | requestVote source dest =>
        simp [next, rawNext, nextRequestVote]
    | appendEntries source dest =>
        simp [next, rawNext, nextAppendEntries]
    | becomeLeader elected =>
        simp [next, rawNext, nextBecomeLeader]
    | clientRequest node =>
        simp [next, rawNext, nextClientRequest]
    | signCommittableMessages node =>
        simp [next, rawNext, nextSignCommittableMessages]
    | changeConfiguration node configuration =>
        simp [next, rawNext, nextChangeConfiguration]
    | advanceCommitIndex node =>
        simp [next, rawNext, nextAdvanceCommitIndex]
    | receive dest source kind =>
        cases hmessage : headMessage? state dest source with
        | none =>
            simp [next, rawNext, nextReceive, hmessage]
        | some message =>
            cases kind with
            | updateTerm =>
                by_cases candidateIsDest : candidate = dest
                · subst candidate
                  cases oldRole : state.leadershipState dest <;>
                    simp [next, rawNext, nextReceive, hmessage,
                      updateNode, oldRole] at afterCandidate
                · simp [next, rawNext, nextReceive, hmessage,
                    updateNode, candidateIsDest]
            | _ =>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone,
                    nextAppendEntriesNoConflict, conflictRollback]
                all_goals split <;> simp
  · cases action with
    | timeout timedOut =>
        exact False.elim (notTimeout timedOut rfl)
    | requestVote source dest =>
        simp [next, rawNext, nextRequestVote]
    | appendEntries source dest =>
        simp [next, rawNext, nextAppendEntries]
    | becomeLeader elected =>
        by_cases candidateIsElected : candidate = elected
        · subst candidate
          simp [next, rawNext, nextBecomeLeader, updateNode] at afterCandidate
        · simp [next, rawNext, nextBecomeLeader, updateNode,
            candidateIsElected]
    | clientRequest node =>
        by_cases candidateIsNode : candidate = node
        · subst candidate
          simp [Enabled, actionEnabled, oldCandidate] at enabled
        · simp [next, rawNext, nextClientRequest, candidateIsNode]
    | signCommittableMessages node =>
        by_cases candidateIsNode : candidate = node
        · subst candidate
          simp [Enabled, actionEnabled, oldCandidate] at enabled
        · simp [next, rawNext, nextSignCommittableMessages,
            candidateIsNode]
    | changeConfiguration node configuration =>
        by_cases candidateIsNode : candidate = node
        · subst candidate
          simp [Enabled, actionEnabled, oldCandidate] at enabled
        · simp [next, rawNext, nextChangeConfiguration,
            candidateIsNode]
    | advanceCommitIndex node =>
        simp [next, rawNext, nextAdvanceCommitIndex]
    | receive dest source kind =>
        cases hmessage : headMessage? state dest source with
        | none =>
            simp [next, rawNext, nextReceive, hmessage]
        | some message =>
            cases kind with
            | appendEntriesNoConflict |
              appendEntriesConflictThenAlreadyDone |
              appendEntriesConflictThenNoConflict =>
                cases hbody : message.body with
                | appendEntriesRequest previousIndex previousTerm entries
                    commitIndex =>
                    have branchEnabled := enabled
                    simp [Enabled, actionEnabled, hmessage,
                      receiveBranchEnabled, hbody,
                      appendEntriesAcceptBase] at branchEnabled
                    have destMatches : message.dest = dest :=
                      branchEnabled.2.1.1
                    by_cases candidateIsDest : candidate = dest
                    · subst candidate
                      simp [destMatches, oldCandidate] at branchEnabled
                    · have candidateIsMessageDest :
                          candidate ≠ message.dest := by
                        intro same
                        exact candidateIsDest (same.trans destMatches)
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesAlreadyDone,
                        nextAppendEntriesNoConflict, conflictRollback,
                        candidateIsDest, candidateIsMessageDest]
                | _ =>
                    simp [Enabled, actionEnabled, hmessage,
                      receiveBranchEnabled, hbody] at enabled
            | _ =>
                cases hbody : message.body <;>
                  simp [next, rawNext, nextReceive, hmessage, hbody,
                    nextAppendEntriesAlreadyDone,
                    nextAppendEntriesNoConflict, conflictRollback]
                all_goals split <;> simp

private theorem nonTimeout_candidate_commit_configurations_unchanged
    (state : State)
    (action : Action)
    (candidate : Node)
    (enabled : Enabled state action)
    (notTimeout :
      forall timedOut : Node, action ≠ .timeout timedOut)
    (afterCandidate :
      (next state action).leadershipState candidate = .candidate) :
    And
      ((next state action).commitIndex candidate =
        state.commitIndex candidate)
      ((next state action).configurations candidate =
        state.configurations candidate) := by
  have oldCandidate :=
    candidate_before_of_candidate_after
      state action candidate afterCandidate notTimeout
  cases action with
  | timeout timedOut =>
      exact False.elim (notTimeout timedOut rfl)
  | requestVote source dest =>
      simp [next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      simp [next, rawNext, nextAppendEntries]
  | becomeLeader elected =>
      by_cases candidateIsElected : candidate = elected
      · subst candidate
        simp [next, rawNext, nextBecomeLeader, updateNode] at afterCandidate
      · simp [next, rawNext, nextBecomeLeader, updateNode,
          candidateIsElected]
  | clientRequest node =>
      simp [next, rawNext, nextClientRequest]
  | signCommittableMessages node =>
      simp [next, rawNext, nextSignCommittableMessages]
  | changeConfiguration node configuration =>
      by_cases candidateIsNode : candidate = node
      · subst candidate
        have nodeLeader :
            state.leadershipState node = .leader := by
          have enabledFacts := enabled
          simp [Enabled, actionEnabled] at enabledFacts
          exact enabledFacts.1.1.1.2
        rw [nodeLeader] at oldCandidate
        contradiction
      · simp [next, rawNext, nextChangeConfiguration,
          candidateIsNode]
  | advanceCommitIndex node =>
      by_cases candidateIsNode : candidate = node
      · subst candidate
        have nodeLeader :
            state.leadershipState node = .leader := by
          have enabledFacts := enabled
          simp [Enabled, actionEnabled] at enabledFacts
          exact enabledFacts.1.2
        rw [nodeLeader] at oldCandidate
        contradiction
      · simp [next, rawNext, nextAdvanceCommitIndex,
          candidateIsNode]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simp [next, rawNext, nextReceive, hmessage]
      | some message =>
          cases kind with
          | appendEntriesAlreadyDone |
            appendEntriesNoConflict |
            appendEntriesConflictThenAlreadyDone |
            appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody,
                    appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  by_cases candidateIsDest : candidate = dest
                  · subst candidate
                    simp [destMatches, oldCandidate] at branchEnabled
                  · have candidateIsMessageDest :
                        candidate ≠ message.dest := by
                      intro same
                      exact candidateIsDest (same.trans destMatches)
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone,
                      nextAppendEntriesNoConflict, conflictRollback,
                      candidateIsDest, candidateIsMessageDest]
              | _ =>
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at enabled
          | _ =>
              cases hbody : message.body <;>
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone,
                  nextAppendEntriesNoConflict, conflictRollback]
              all_goals split <;> simp

theorem protocolHistory_currentCandidateTimeoutOrigin
    {start : InitialConfiguration}
