    ActionAppendTermFreshInHistory
      start actions state action := by
  cases action with
  | clientRequest leader =>
      have clientEnabled := enabled
      simp [Enabled, actionEnabled] at clientEnabled
      intro historicalState stateAt node
      exact frontier
        leader clientEnabled.1.2 historicalState stateAt node
        ((state.log leader).length + 1) (by omega)
  | signCommittableMessages leader =>
      have signEnabled := enabled
      simp [Enabled, actionEnabled] at signEnabled
      intro historicalState stateAt node
      exact frontier
        leader signEnabled.1.1.2 historicalState stateAt node
        ((state.log leader).length + 1) (by omega)
  | changeConfiguration leader configuration =>
      have changeEnabled := enabled
      simp [Enabled, actionEnabled] at changeEnabled
      intro historicalState stateAt node
      exact frontier
        leader changeEnabled.1.1.1.2 historicalState stateAt node
        ((state.log leader).length + 1) (by omega)
  | _ =>
      trivial

