private theorem potentialFormation_configurations_eq
    {state : State}
    {action : Action}
    {candidate : Node}
    (formation :
      PotentialCandidateFormationAction state action candidate) :
    (next state action).configurations candidate =
      state.configurations candidate := by
  rcases formation with
    ⟨timedOut, actionEq, candidateEq⟩ |
      ⟨voter, request, lastTerm, lastIndex,
        actionEq, requestHead, requestBody, granted⟩
  · subst action
