private theorem appendEntriesConflict_previousIndex_ge_acknowledged
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state originSendState requestSendState : State}
    {leader follower source : Node}
    {acknowledgedPrefix : List Entry}
    {index : Nat}
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions endState)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (originSend :
      Occurs
