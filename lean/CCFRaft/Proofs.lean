theorem choice_ack_precedes_higher_term_potential_vote
    {start : InitialConfiguration}
    {actions : List Action}
    {state choiceState : State}
    {choiceLeader member candidate : Node}
    {choiceIndex choiceTerm : Nat}
    (history : ProtocolHistory start actions state)
    (support :
      ChoiceSupportWitness
        start actions state choiceState
        choiceLeader member choiceIndex choiceTerm)
    (vote :
      VotedForLogWitness
        start actions state member candidate)
    (potentialVote :
      member ∈ votersForCandidateTerm state candidate)
    (higherTerm :
      choiceTerm < state.currentTerm candidate) :
    Exists fun betweenActions =>
      Replays
        (next
          support.matchWitness.ack.origin.responseState
          (.receive
            member
            choiceLeader
            support.matchWitness.ack.origin.kind.receiveKind))
        betweenActions
        vote.responseOrigin.responseState := by
  have voterFacts :
      state.currentTerm member = state.currentTerm candidate ∧
        state.votedFor member = some candidate := by
    have facts := potentialVote
    simp [votersForCandidateTerm] at facts
    exact facts.2
  have responseTerm :
      vote.response.term =
        vote.responseOrigin.responseState.currentTerm member := by
    simpa using
      congrArg Message.term vote.responseOrigin.response_eq
  have grantTerm :
      vote.responseOrigin.responseState.currentTerm member =
        state.currentTerm candidate :=
    responseTerm.symm.trans
      (vote.voter_term_eq.symm.trans voterFacts.1)
  exact
    choice_ack_precedes_higher_term_vote_occurrence
      history
      support
      vote.responseOrigin.occurrence
      grantTerm
