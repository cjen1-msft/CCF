theorem historicalCompleteSafetyCore_prefixes
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state) :
    forall {prefixActions prefixState},
      prefixActions <+: actions ->
        ProtocolHistory start prefixActions prefixState ->
          HistoricalCompleteSafetyCore
            start prefixActions prefixState := by
  have hereditary :
      forall
        (pastActions : List Action)
        (pastState : State),
        ProtocolHistory start pastActions pastState ->
          (pastActions <+: actions ->
            forall {prefixActions prefixState},
              prefixActions <+: pastActions ->
                ProtocolHistory start prefixActions prefixState ->
                  HistoricalCompleteSafetyCore
                    start prefixActions prefixState) := by
    intro pastActions pastState pastHistory
    apply
      protocolHistory_induction
        (start := start)
        (property := fun currentActions currentState =>
          currentActions <+: actions ->
            forall {prefixActions prefixState},
              prefixActions <+: currentActions ->
                ProtocolHistory start prefixActions prefixState ->
                  HistoricalCompleteSafetyCore
                    start prefixActions prefixState)
    · intro _currentLe prefixActions prefixState prefixLe prefixHistory
      have prefixNil : prefixActions = [] := by
        simpa using prefixLe
      subst prefixActions
      have prefixStateEq : prefixState = initialState start :=
        replays_deterministic prefixHistory rfl
      subst prefixState
      exact initial_HistoricalCompleteSafetyCore start
    · intro currentActions currentState currentHistory established
        action enabled nextLe prefixActions prefixState prefixLe prefixHistory
      have currentLe : currentActions <+: actions :=
        (show currentActions <+: currentActions ++ [action] from
          List.prefix_append _ _).trans nextLe
      rcases prefix_append_singleton_cases prefixLe with
        prefixOld | prefixFinal
      · exact established currentLe prefixOld prefixHistory
      · subst prefixActions
        have nextHistory :=
          replays_append_singleton currentHistory enabled
        have prefixStateEq :
            prefixState = next currentState action :=
          replays_deterministic prefixHistory nextHistory
        subst prefixState
        have currentCore :=
          established
            currentLe
            List.prefix_rfl
            currentHistory
        exact
          {
            electionLogs :=
              historicalFullElectionLogCore_append_step_local
                currentHistory
                currentCore
                (by
                  intro earlierActions earlierState earlierLe earlierHistory
                  exact
                    established currentLe earlierLe earlierHistory)
                action
                enabled
            chosenCommits := by
              intro earlierActions earlierState earlierLe earlierHistory
              exact
                core.chosenCommits
                  (earlierLe.trans nextLe)
                  earlierHistory
          }
    · exact pastHistory
  intro prefixActions prefixState prefixLe prefixHistory
  exact
    hereditary actions state history List.prefix_rfl
      prefixLe prefixHistory

private theorem entryAt?_eq_of_logPrefix_eq
    {first second : List Entry}
    {index : Nat}
    {entry : Entry}
    (firstAt : entryAt? first index = some entry)
    (prefixEq :
      logPrefix first index = logPrefix second index) :
    entryAt? second index = some entry := by
  have firstPrefixAt :
      entryAt? (logPrefix first index) index = some entry := by
    simpa [logPrefix] using
      entryAt?_take_of_some
        first index index entry firstAt (Nat.le_refl _)
  have secondPrefixAt :
      entryAt? (logPrefix second index) index = some entry := by
    rw [← prefixEq]
    exact firstPrefixAt
  exact
    entryAt?_take_lift
      second index index entry
      (by simpa [logPrefix] using secondPrefixAt)

private theorem committedConfigurationAt?_eq_of_logPrefix_eq
    (first second : List Entry)
    (index : Nat)
    (prefixEq :
      logPrefix first index = logPrefix second index) :
    committedConfigurationAt? first index =
      committedConfigurationAt? second index := by
  unfold committedConfigurationAt?
  rw [← logConfigurations_take, ← logConfigurations_take]
  exact
    congrArg List.getLast?
      (congrArg logConfigurations
        (by simpa [logPrefix] using prefixEq))

private structure ChosenCommitCertificateChoiceIdentity
    {start : InitialConfiguration}
