    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (targetEarlier :
      target.choiceTerm <
        (next state
          (.receive candidate source
            .handleRequestVoteResponse)).currentTerm candidate)
    (responseHead :
      headMessage? state candidate source = some response)
    (responseBody :
      response.body = .requestVoteResponse true false)
    (afterQuorum :
      allConfigurationsHaveQuorum
          ((next state
            (.receive candidate source
              .handleRequestVoteResponse)).votesGranted candidate)
          ((next state
            (.receive candidate source
              .handleRequestVoteResponse)).configurations candidate) =
        true)
    (enabled :
      Enabled state
        (.receive candidate source .handleRequestVoteResponse)) :
    isLogPrefix target.chosenPrefix (state.log candidate) := by
  have oldCandidate :
      state.leadershipState candidate = .candidate := by
    simpa [next, rawNext, nextReceive, responseHead, responseBody] using
      (show
        (next state
          (.receive candidate source
            .handleRequestVoteResponse)).leadershipState candidate =
            .candidate by
        have enabledFacts := enabled
        simp [Enabled, actionEnabled, responseHead,
          receiveBranchEnabled, responseBody] at enabledFacts
        have responseDest : response.dest = candidate :=
          enabledFacts.2.1.1
        simpa [next, rawNext, nextReceive, responseHead, responseBody,
          responseDest] using enabledFacts.2.2.2)
  have leaderUniqueness :=
    completeSafetyCore_implies_leaderUniqueness history core
  have requestVotes :=
    queueHistory_implies_RequestVoteMessageHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent history)
  apply
    quorumReadyCandidate_carries_chosenPrefix_by_choice_progress_at_term
      history
      core
      candidateWitness
      target
      boundary
      ((next state
        (.receive candidate source
          .handleRequestVoteResponse)).currentTerm candidate)
      targetEarlier
  intro targetState targetOwner targetIndex certificate
    certificateBoundary earlier activeConfiguration
    candidateConfigurationActive configurationActiveAtChoice
    configurationWithinChoice
  have candidateConfigurationAfter :
      activeConfiguration ∈
        (next state
          (.receive candidate source
            .handleRequestVoteResponse)).configurations candidate := by
    simpa [next, rawNext, nextReceive, responseHead, responseBody] using
