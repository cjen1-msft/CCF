private theorem chosenCommitCertificate_higher_term_leaders_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState leaderState : State}
    {owner leader : Node}
    {index : Nat}
    {action : Action}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (enabled : Enabled state action)
    (leaderAt :
      StateAt
        start
        (actions ++ [action])
        (next state action)
        leaderState)
    (leaderRole :
      leaderState.leadershipState leader = .leader)
    (higherTerm :
      certificate.choiceTerm <
        leaderState.currentTerm leader) :
    isLogPrefix
      certificate.chosenPrefix
      (leaderState.log leader) := by
  rcases
      stateAt_append_singleton_cases history enabled leaderAt with
    leaderOld | leaderFinal
  · exact
      certificate.higher_term_leaders
        leaderState leaderOld leader leaderRole higherTerm
  · subst leaderState
    have retainPersistent
        (oldLeader :
          state.leadershipState leader = .leader)
        (termEq :
          (next state action).currentTerm leader =
            state.currentTerm leader) :
        isLogPrefix
          certificate.chosenPrefix
          ((next state action).log leader) := by
      have oldRetained :=
        certificate.higher_term_leaders
          state
          (protocolHistory_final_stateAt history)
          leader
          oldLeader
          (by
            rw [← termEq]
            exact higherTerm)
      exact
        chosenCommitCertificate_retained_append_step
          history core certificate boundary oldRetained
          (Nat.le_of_lt
            (by
              rw [← termEq]
              exact higherTerm))
          enabled
    cases action with
    | becomeLeader elected =>
        by_cases leaderIsElected : leader = elected
        · subst elected
          have enabledFacts := enabled
          simp [Enabled, actionEnabled] at enabledFacts
          have oldRetained :=
            certificate.counted_candidate_barrier
              state
              (protocolHistory_final_stateAt history)
              leader
              enabledFacts.1.2
              (by
                simpa [next, rawNext, nextBecomeLeader] using higherTerm)
              enabledFacts.2
          exact
            chosenCommitCertificate_retained_append_step
              history core certificate boundary oldRetained
              (Nat.le_of_lt
                (by
                  simpa [next, rawNext, nextBecomeLeader] using
                    higherTerm))
              enabled
        · apply retainPersistent
          · simpa [next, rawNext, nextBecomeLeader, updateNode,
              leaderIsElected] using leaderRole
          · simp [next, rawNext, nextBecomeLeader]
    | timeout node =>
        apply retainPersistent
        · exact
            leader_before_of_leader_after
              state (.timeout node) leader leaderRole
              (by intro elected; simp)
        · exact persistentLeader_currentTerm_step
            state (.timeout node) leader leaderRole
    | requestVote source dest =>
        apply retainPersistent
        · exact
            leader_before_of_leader_after
              state (.requestVote source dest) leader leaderRole
              (by intro elected; simp)
        · exact persistentLeader_currentTerm_step
            state (.requestVote source dest) leader leaderRole
    | appendEntries source dest =>
        apply retainPersistent
        · exact
            leader_before_of_leader_after
              state (.appendEntries source dest) leader leaderRole
              (by intro elected; simp)
        · exact persistentLeader_currentTerm_step
            state (.appendEntries source dest) leader leaderRole
    | clientRequest node =>
        apply retainPersistent
        · exact
            leader_before_of_leader_after
              state (.clientRequest node) leader leaderRole
              (by intro elected; simp)
        · exact persistentLeader_currentTerm_step
            state (.clientRequest node) leader leaderRole
    | signCommittableMessages node =>
        apply retainPersistent
        · exact
            leader_before_of_leader_after
              state (.signCommittableMessages node) leader leaderRole
              (by intro elected; simp)
        · exact persistentLeader_currentTerm_step
            state (.signCommittableMessages node) leader leaderRole
    | changeConfiguration node configuration =>
        apply retainPersistent
        · exact
            leader_before_of_leader_after
              state (.changeConfiguration node configuration)
              leader leaderRole
              (by intro elected; simp)
        · exact persistentLeader_currentTerm_step
            state (.changeConfiguration node configuration)
            leader leaderRole
    | advanceCommitIndex node =>
        apply retainPersistent
        · exact
            leader_before_of_leader_after
              state (.advanceCommitIndex node) leader leaderRole
              (by intro elected; simp)
        · exact persistentLeader_currentTerm_step
            state (.advanceCommitIndex node) leader leaderRole
    | receive dest source kind =>
        apply retainPersistent
        · exact
            leader_before_of_leader_after
              state (.receive dest source kind) leader leaderRole
              (by intro elected; simp)
        · exact persistentLeader_currentTerm_step
            state (.receive dest source kind) leader leaderRole

theorem chosenCommitCertificate_append_step_coherent
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState : State}
    {owner : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (boundary :
      SignatureCommitBoundary boundaryState owner index)
    (action : Action)
    (enabled : Enabled state action) :
    Exists fun extended :
      ChosenCommitCertificate
        start
        (actions ++ [action])
        (next state action)
        boundaryState
        owner
        index =>
      ChosenCommitCertificateExtension certificate extended := by
  have choiceExact :
      ConfigurationsExactInv certificate.choiceState :=
    reachable_ConfigurationsExactInv
      start
      (stateAt_reachable certificate.choice_at)
  have configurationAtChoice :=
    chosenCommitCertificate_configuration_mem_choiceConfigurations
      certificate choiceExact
  rcases
      certificate.watermark_causal_support
        certificate.configuration
        configurationAtChoice
        certificate.configuration_le_choice with
    ⟨certificateQuorum, certificateQuorumOk,
      certificateCausalSupport⟩
  let extended :
      ChosenCommitCertificate
        start
        (actions ++ [action])
        (next state action)
        boundaryState
        owner
        index :=
    {
      boundary_at :=
        stateAt_extend_action certificate.boundary_at enabled
      boundaryTerm := certificate.boundaryTerm
      choiceTerm := certificate.choiceTerm
      boundary_term := certificate.boundary_term
      choiceState := certificate.choiceState
      choiceLeader := certificate.choiceLeader
      choice_at :=
        stateAt_extend_action certificate.choice_at enabled
      choice_leader := certificate.choice_leader
      choice_term := certificate.choice_term
      choice_term_le_boundary_owner :=
        certificate.choice_term_le_boundary_owner
      choiceIndex := certificate.choiceIndex
      choice_origin :=
        commitChoiceOrigin_append_step
          certificate.choice_origin enabled
      choice_commit_le_boundary :=
        certificate.choice_commit_le_boundary
      choice_progress :=
        commitChoiceOrigin_append_step_progress
          certificate.choice_origin
          certificate.choice_progress
          enabled
      boundary_le_choice := certificate.boundary_le_choice
      boundary_term_le_choice :=
        certificate.boundary_term_le_choice
      chosenPrefix := certificate.chosenPrefix
      prefix_eq := certificate.prefix_eq
      choice_prefix_eq := certificate.choice_prefix_eq
      choiceIndexPrefix := certificate.choiceIndexPrefix
      choice_index_prefix_eq :=
        certificate.choice_index_prefix_eq
      choice_index_entry := certificate.choice_index_entry
      boundary_prefix_le_choice_prefix :=
        certificate.boundary_prefix_le_choice_prefix
      configuration := certificate.configuration
      configuration_at := certificate.configuration_at
      configuration_le_choice :=
        certificate.configuration_le_choice
      quorum := certificateQuorum
      quorum_ok := certificateQuorumOk
      support_retained := by
        intro member memberInQuorum
        rcases
            certificateCausalSupport member memberInQuorum with
          memberIsLeader | support
        · subst member
          have retained :=
            choiceLeader_endpoint_carries_chosenPrefix
              (completeSafetyCore_implies_leaderUniqueness
                history core)
              certificate
              boundary
          have termLower :
              certificate.choiceTerm <=
                state.currentTerm certificate.choiceLeader := by
            rcases certificate.choice_at with ⟨endpoint⟩
            exact
              Nat.le_trans
                (Nat.le_of_eq certificate.choice_term.symm)
                (replays_currentTerm_mono
                  endpoint.remainingHistory certificate.choiceLeader)
          exact
            chosenCommitCertificate_retained_append_step
              history core certificate boundary retained termLower enabled
        · rcases support with initialSupport | support
          · exact
              certificate.boundary_prefix_le_choice_prefix.trans
                (initial_choice_member_history_carries_choiceIndexPrefix
                  certificate
                  initialSupport.1
                  member
                  initialSupport.2
                  (replays_append_singleton history enabled))
          · rcases support with ⟨supportWitness⟩
            exact
              chosenCommitCertificate_retained_append_step
                history
                core
                certificate
                boundary
                (choiceSupport_endpoint_carries_chosenPrefix
                  history
                  core.electionLogs.counted.logs.logMatching
                  (completeSafetyCore_implies_leaderUniqueness
                    history core)
                  certificate
                  boundary
                  supportWitness)
                (choiceSupportWitness_choiceTerm_le_endState
                  history supportWitness)
                enabled
      watermark_support := by
        intro activeConfiguration activeMember indexBound
        rcases
            certificate.watermark_causal_support
              activeConfiguration activeMember indexBound with
          ⟨activeQuorum, activeQuorumOk, causalSupport⟩
        refine ⟨activeQuorum, activeQuorumOk, ?_⟩
        intro member memberInQuorum
        rcases causalSupport member memberInQuorum with
          memberIsLeader | support
        · subst member
          have retained :=
            choiceLeader_endpoint_carries_chosenPrefix
              (completeSafetyCore_implies_leaderUniqueness
                history core)
              certificate
              boundary
          have termLower :
              certificate.choiceTerm <=
                state.currentTerm certificate.choiceLeader := by
            rcases certificate.choice_at with ⟨endpoint⟩
            exact
              Nat.le_trans
                (Nat.le_of_eq certificate.choice_term.symm)
                (replays_currentTerm_mono
                  endpoint.remainingHistory certificate.choiceLeader)
          exact
            chosenCommitCertificate_retained_append_step
              history core certificate boundary retained termLower enabled
        · rcases support with initialSupport | support
          · exact
              certificate.boundary_prefix_le_choice_prefix.trans
                (initial_choice_member_history_carries_choiceIndexPrefix
                  certificate
                  initialSupport.1
                  member
                  initialSupport.2
                  (replays_append_singleton history enabled))
          · rcases support with ⟨supportWitness⟩
            exact
              chosenCommitCertificate_retained_append_step
                history
                core
                certificate
                boundary
                (choiceSupport_endpoint_carries_chosenPrefix
                  history
                  core.electionLogs.counted.logs.logMatching
                  (completeSafetyCore_implies_leaderUniqueness
                    history core)
                  certificate
                  boundary
                  supportWitness)
                (choiceSupportWitness_choiceTerm_le_endState
                  history supportWitness)
                enabled
      watermark_causal_support := by
        intro activeConfiguration activeMember indexBound
        rcases
            certificate.watermark_causal_support
              activeConfiguration activeMember indexBound with
          ⟨activeQuorum, activeQuorumOk, causalSupport⟩
        refine ⟨activeQuorum, activeQuorumOk, ?_⟩
        intro member memberInQuorum
        rcases causalSupport member memberInQuorum with
          memberIsLeader | support
        · exact Or.inl memberIsLeader
        · rcases support with initialSupport | support
          · exact
              Or.inr
                (Or.inl
                  ⟨commitChoiceOrigin_append_step_initial
                      certificate.choice_origin enabled initialSupport.1,
                    initialSupport.2⟩)
          · rcases support with ⟨supportWitness⟩
            exact
              Or.inr
                (Or.inr
                  ⟨choiceSupportWitness_append_step
                    supportWitness enabled⟩)
      counted_candidate_barrier := by
        intro candidateState candidateAt candidate candidateRole
          higherTerm candidateQuorum
        exact
          chosenCommitCertificate_counted_barrier_append_step
            history
            core
            certificate
            boundary
            enabled
            candidateAt
            candidateRole
            higherTerm
            candidateQuorum
      potential_candidate_barrier := by
        intro candidateState candidateAt candidate candidateRole
          higherTerm candidateQuorum
        exact
          chosenCommitCertificate_potential_barrier_append_step
            history
