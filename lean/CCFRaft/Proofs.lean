private theorem chosenCommitCertificate_boundaryTerm_le_currentTerm_of_carries
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState state : State}
    {owner node : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (monoLog : MonoLogInv state)
    (retained :
      isLogPrefix certificate.chosenPrefix (state.log node)) :
    certificate.boundaryTerm <= state.currentTerm node := by
  have chosenLast :=
    chosenCommitCertificate_chosenPrefix_lastTerm certificate
  cases lastCase : certificate.chosenPrefix.getLast? with
  | none =>
      simp [lastCase] at chosenLast
  | some entry =>
      have entryTerm : entry.term = certificate.boundaryTerm := by
        simpa [lastCase] using chosenLast
      have chosenMember : entry ∈ certificate.chosenPrefix := by
        rcases List.getLast?_eq_some_iff.mp lastCase with
          ⟨initialEntries, chosenEq⟩
        rw [chosenEq]
        simp
      have stateMember : entry ∈ state.log node :=
        retained.mem chosenMember
      have stateNonempty : state.log node != [] := by
        cases empty : state.log node with
        | nil =>
            rw [empty] at stateMember
            simp at stateMember
        | cons first rest =>
            rfl
      have nodeMono := monoLog node stateNonempty
      exact
        entryTerm ▸
          Nat.le_trans
            (monoLogEntries_member_le_lastTerm
              (state.log node)
              entry
              nodeMono.2
              stateMember)
            nodeMono.1

private theorem stateAtWitness_history_order
    {start : InitialConfiguration}
    {actions : List Action}
    {endState firstState secondState : State}
    (firstWitness :
      StateAtWitness start actions endState firstState)
    (secondWitness :
      StateAtWitness start actions endState secondState) :
    Or
      (StateAt
        start secondWitness.pastActions secondState firstState)
      (StateAt
        start firstWitness.pastActions firstState secondState) := by
  have firstPrefix :
      firstWitness.pastActions <+: actions :=
    ⟨firstWitness.futureActions, firstWitness.actions_eq.symm⟩
  have secondPrefix :
      secondWitness.pastActions <+: actions :=
    ⟨secondWitness.futureActions, secondWitness.actions_eq.symm⟩
  rcases
      List.prefix_or_prefix_of_prefix firstPrefix secondPrefix with
    firstBeforeSecond | secondBeforeFirst
  · rcases firstBeforeSecond with
      ⟨middleActions, pastActionsEq⟩
    have secondHistory := secondWitness.stateHistory
    rw [← pastActionsEq] at secondHistory
    rcases replays_append_split secondHistory with
      ⟨middleState, firstReplay, remainingReplay⟩
    have stateEq : firstState = middleState :=
      replays_deterministic firstWitness.stateHistory firstReplay
    left
    exact
      ⟨{
        pastActions := firstWitness.pastActions
        futureActions := middleActions
        actions_eq := pastActionsEq.symm
        stateHistory := firstWitness.stateHistory
        remainingHistory := by
          simpa only [stateEq] using remainingReplay
      }⟩
  · rcases secondBeforeFirst with
      ⟨middleActions, pastActionsEq⟩
    have firstHistory := firstWitness.stateHistory
    rw [← pastActionsEq] at firstHistory
    rcases replays_append_split firstHistory with
      ⟨middleState, secondReplay, remainingReplay⟩
    have stateEq : secondState = middleState :=
      replays_deterministic secondWitness.stateHistory secondReplay
    right
    exact
      ⟨{
        pastActions := secondWitness.pastActions
        futureActions := middleActions
        actions_eq := pastActionsEq.symm
        stateHistory := secondWitness.stateHistory
        remainingHistory := by
          simpa only [stateEq] using remainingReplay
      }⟩

private theorem choiceLeader_voteGrant_carries_choiceIndexPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState grantState : State}
    {owner candidate : Node}
    {index candidateTerm : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (grant :
      Occurs
        start actions state grantState
        (.receive
          certificate.choiceLeader candidate
          .handleRequestVoteRequest))
    (grantTerm :
      grantState.currentTerm certificate.choiceLeader = candidateTerm)
    (higherTerm : certificate.choiceTerm < candidateTerm) :
    isLogPrefix
      certificate.choiceIndexPrefix
      (grantState.log certificate.choiceLeader) := by
  rcases occurs_before_stateAt grant with ⟨grantEndpoint⟩
  have grantActionsPrefix : grantEndpoint.pastActions <+: actions :=
    ⟨grantEndpoint.futureActions, grantEndpoint.actions_eq.symm⟩
  have grantChosen :
      HistoricalChosenCommitCore
        start grantEndpoint.pastActions grantState :=
    core.chosenCommits grantActionsPrefix grantEndpoint.stateHistory
  have grantLeaderUniqueness :
      TemporalLeaderUniquenessInv
        start grantEndpoint.pastActions grantState := by
    intro firstState secondState firstAt secondAt
      firstLeader secondLeader firstRole secondRole sameTerm
    exact
      leaderUniqueness
        firstState
        secondState
        (stateAt_extend_stateAtWitness grantEndpoint firstAt)
        (stateAt_extend_stateAtWitness grantEndpoint secondAt)
        firstLeader
        secondLeader
        firstRole
        secondRole
        sameTerm
  have retain :
      forall choiceBoundary : State,
        StateAt
            start grantEndpoint.pastActions grantState choiceBoundary ->
          SignatureCommitBoundary
              choiceBoundary certificate.choiceLeader
                certificate.choiceIndex ->
            logPrefix
                (choiceBoundary.log certificate.choiceLeader)
                certificate.choiceIndex =
              certificate.choiceIndexPrefix ->
              isLogPrefix
                certificate.choiceIndexPrefix
                (grantState.log certificate.choiceLeader) := by
    intro choiceBoundary choiceBoundaryAt boundary prefixEq
    rcases
        grantChosen
          choiceBoundary
          choiceBoundaryAt
          certificate.choiceLeader
          certificate.choiceIndex
          boundary with
      ⟨choiceCertificate⟩
    have retained :=
      chosenCommitCertificate_prefix_retained_to_endpoint
        grantLeaderUniqueness
        choiceCertificate
        boundary
        choiceBoundaryAt
        choiceCertificate.choice_term_le_boundary_owner
        (by
          rw [choiceCertificate.prefix_eq]
          exact
            logPrefix_isLogPrefix
              (choiceBoundary.log certificate.choiceLeader)
              certificate.choiceIndex)
    rw [choiceCertificate.prefix_eq, prefixEq] at retained
    exact retained
  cases origin : certificate.choice_origin with
  | initial choiceStateEq choiceLeaderEq choiceIndexEq =>
      have boundary :
          SignatureCommitBoundary
            (initialState start) certificate.choiceLeader
              certificate.choiceIndex := by
        have initialBoundary :
            SignatureCommitBoundary
              (initialState start) start 2 := by
          refine
            ⟨by simp [initialState, start.leader_mem],
              by simp [initialState, startLog, start.leader_mem], ?_⟩
          simp [initialState, startLog, entryAt?, start.leader_mem]
        simpa [choiceLeaderEq, choiceIndexEq] using initialBoundary
      apply retain
        (initialState start)
        (protocolHistory_initial_stateAt grantEndpoint.stateHistory)
        boundary
      rw [certificate.choice_index_prefix_eq,
        choiceStateEq, choiceLeaderEq, choiceIndexEq]
  | advance occurrence choiceIndexEq =>
      let choiceAfter :=
        next certificate.choiceState
          (.advanceCommitIndex certificate.choiceLeader)
      rcases occurs_after_stateAt occurrence with ⟨choiceAfterEndpoint⟩
      have choiceAfterAtGrant :
          StateAt
            start grantEndpoint.pastActions grantState choiceAfter := by
        rcases
            stateAtWitness_history_order
              choiceAfterEndpoint grantEndpoint with
          choiceBeforeGrant | grantBeforeChoice
        · exact choiceBeforeGrant
        · rcases grantBeforeChoice with ⟨endpoint⟩
          have termMono :=
            replays_currentTerm_mono
              endpoint.remainingHistory certificate.choiceLeader
          have choiceAfterTerm :
              choiceAfter.currentTerm certificate.choiceLeader =
                certificate.choiceTerm := by
            simp [choiceAfter, next, rawNext, nextAdvanceCommitIndex,
              certificate.choice_term]
          rw [grantTerm, choiceAfterTerm] at termMono
          omega
      have choiceIndexPositive : 0 < certificate.choiceIndex := by
        have choiceEntry := certificate.choice_index_entry
        unfold entryAt? at choiceEntry
        split at choiceEntry
        · contradiction
        · omega
      have boundary :
          SignatureCommitBoundary
            choiceAfter certificate.choiceLeader
              certificate.choiceIndex := by
        refine ⟨choiceIndexPositive, ?_, ?_⟩
        · simpa [choiceAfter, next, rawNext, nextAdvanceCommitIndex,
            choiceIndexEq]
        · simpa [choiceAfter, next, rawNext, nextAdvanceCommitIndex] using
            congrArg (Option.map (·.content))
              certificate.choice_index_entry
      apply retain choiceAfter choiceAfterAtGrant boundary
      rw [certificate.choice_index_prefix_eq]
      simp [choiceAfter, next, rawNext, nextAdvanceCommitIndex]

private theorem protocolHistory_initial_member_committed_prefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (member : Node)
    (memberInitial : member ∈ start.nodes) :
    isLogPrefix (startLog start) (committed state member) := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun _ current =>
        isLogPrefix (startLog start) (committed current member))
      (by
        simp [committed, initialState, memberInitial, isLogPrefix,
          logPrefix, startLog])
      (by
        intro _ current currentHistory retained action enabled
        exact
          retained.trans
            (committedLogAppendOnly_step
              current
              action
              (reachable_SignatureInv
                start
                (protocolHistory_reachable currentHistory))
              enabled
              member))
      history

private theorem initial_choice_member_history_carries_choiceIndexPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState : State}
    {owner : Node}
    {index : Nat}
    {endpointActions : List Action}
    {endpointState : State}
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (initial : certificate.choice_origin.IsInitial)
    (member : Node)
    (memberInitial : member ∈ start.nodes)
    (endpointHistory :
      ProtocolHistory start endpointActions endpointState) :
    isLogPrefix
      certificate.choiceIndexPrefix
      (endpointState.log member) := by
  rcases
      commitChoiceOrigin_isInitial_details
        certificate.choice_origin initial with
    ⟨choiceStateEq, choiceLeaderEq, choiceIndexEq⟩
  have choiceIndexPrefixEq :
      certificate.choiceIndexPrefix = startLog start := by
    rw [certificate.choice_index_prefix_eq, choiceStateEq,
      choiceLeaderEq, choiceIndexEq]
    simp [initialState, start.leader_mem, startLog, logPrefix]
  rw [choiceIndexPrefixEq]
  exact
    (protocolHistory_initial_member_committed_prefix
      endpointHistory member memberInitial).trans
      (by
        simpa [committed] using
          logPrefix_isLogPrefix
            (endpointState.log member)
            (endpointState.commitIndex member))

private theorem initial_choice_member_stateAt_carries_choiceIndexPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState endpointState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (initial : certificate.choice_origin.IsInitial)
    (member : Node)
    (memberInitial : member ∈ start.nodes)
    (endpointAt : StateAt start actions state endpointState) :
    isLogPrefix
      certificate.choiceIndexPrefix
      (endpointState.log member) := by
  rcases endpointAt with ⟨endpoint⟩
  exact
    initial_choice_member_history_carries_choiceIndexPrefix
      certificate initial member memberInitial endpoint.stateHistory

private theorem initial_choice_member_stateAt_carries_chosenPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState endpointState : State}
    {owner : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (initial : certificate.choice_origin.IsInitial)
    (member : Node)
    (memberInitial : member ∈ start.nodes)
    (endpointAt : StateAt start actions state endpointState) :
