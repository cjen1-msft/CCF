private theorem timeout_counted_candidate_carries_chosenPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState : State}
    {candidate owner : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
