theorem historicalElectionLogCore_append_step
    (formationObligation :
      QuorumCandidateFormationOverlapObligation)
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalElectionLogCore start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalElectionLogCore
      start
      (actions ++ [action])
      (next state action) := by
  let votes :=
    protocolHistory_implies_HistoricalElectionVoteCore history
  have countedVotes :=
    protocolHistory_implies_CountedVoteLogHistoryConsistent history
  have requests :=
    queueHistory_implies_AppendEntriesRequestHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent history)
  have entryOrigins :=
    protocolHistory_implies_HistoricalEntryTermLeaderOriginInv history
  have leaderTerms :=
    protocolHistory_implies_HistoricalLeaderToCurrentCandidateTermInv
      history
  have configurationsExact :=
    reachable_ConfigurationsExactInv
      start
      (protocolHistory_reachable history)
  have candidateFresh :=
    historicalElectionCores_imply_HistoricalCandidateQuorumFreshInv
      history votes core.candidateOverlap entryOrigins leaderTerms
  have oldVoteCore : HistoricalVoteCore start actions state :=
    ⟨votes.owner, votes.ownerConsistent, votes.electionVotes⟩
  have leaderUniqueness :=
    historicalElectionCores_imply_TemporalLeaderUniquenessInv
      history
      oldVoteCore
      (protocolHistory_implies_LeaderHistoryConsistent history)
      (quorumCandidateOverlap_implies_ElectionConfigurationsOverlapInv
        core.candidateOverlap)
  have appendFresh :=
    leaderTermFrontier_implies_ActionAppendTermFreshInHistory
      core.frontier action enabled
  have nextLogs :
      HistoricalLogCore
        start
        (actions ++ [action])
        (next state action) :=
    {
      monoLogs :=
        historicalMonoLog_append_step
          history
          core.logs.monoLogs
          core.logs.logMatching
          core.logs.leaderBoundary
          action
          enabled
      logMatching :=
        temporalLogMatching_append_step
          history
          core.logs.logMatching
          action
          appendFresh
          enabled
      leaderBoundary :=
        leaderLogBoundary_step
          state action core.logs.leaderBoundary enabled
    }
  exact
    {
      logs := nextLogs
      frontier :=
        leaderTermFrontier_append_step
          history
          core.frontier
          leaderUniqueness
          candidateFresh
          core.logs.logMatching
          requests
          action
          enabled
      candidateOverlap :=
        temporalQuorumCandidateConfigurationOverlap_append_step_of_formation
          history
          core
          votes
          countedVotes
          entryOrigins
          leaderTerms
          configurationsExact
          action
          enabled
          (by
            intro _logs _candidateFresh _leaderUniqueness
              _countedVotes _configurationsExact _enabled
            exact
              formationObligation
                start actions state action history enabled)
    }

