    conflictFacts.1.1
  have requestBeforeEnd :
      requestSendState.sentIndex source follower <
        (requestSendState.log source).length :=
    previousIndex_lt_of_next_subsequence_nonempty
      (requestSendState.log source)
      (requestSendState.sentIndex source follower)
      payloadNonempty
  have acceptFacts := accept
  simp [appendEntriesAcceptBase] at acceptFacts
  have sameSendTerm :
      originSendState.currentTerm leader =
        requestSendState.currentTerm source := by
    calc
      originSendState.currentTerm leader =
          endState.currentTerm leader := originTerm
      _ = state.currentTerm follower := followerTerm.symm
      _ = requestSendState.currentTerm source :=
