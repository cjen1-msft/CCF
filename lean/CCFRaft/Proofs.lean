theorem protocolHistory_implies_currentCandidateChosenConfigurationWitness
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (prefixCores :
      forall {prefixActions prefixState},
        prefixActions <+: actions ->
          ProtocolHistory start prefixActions prefixState ->
            HistoricalCompleteSafetyCore
              start prefixActions prefixState)
    (candidate : Node)
    (candidateState :
      state.leadershipState candidate = .candidate) :
    HasCurrentCandidateChosenConfigurationWitness
      start actions state candidate := by
  rcases
      protocolHistory_currentCandidateTimeoutOrigin
        history candidate candidateState with
    ⟨origin⟩
  rcases origin.occurrence with ⟨occurrence⟩
  have timeoutPrefix :
      occurrence.pastActions <+: actions :=
    ⟨(.timeout candidate) :: occurrence.futureActions,
      by
        simpa [List.append_assoc] using
          occurrence.actions_eq.symm⟩
  have timeoutCore :=
    prefixCores timeoutPrefix occurrence.before_history
  have enabledFacts := occurrence.enabled
  simp [Enabled, actionEnabled, candidateEligible] at enabledFacts
  have electionBasis :
      CandidateElectionBasis origin.timeoutState candidate := by
    rcases enabledFacts.1.2.2 with
      normalConfiguration | retirementCompleted
    · exact Or.inr normalConfiguration
    · exact
        Or.inl
          ((protocolHistory_implies_RetirementCompletedCommitPositiveInv
              occurrence.before_history)
            candidate candidate retirementCompleted)
  rcases
      candidateChosenConfigurationWitness_of_candidateElectionBasis
        occurrence.before_history
        timeoutCore
        candidate
        electionBasis with
    ⟨timeoutBasis⟩
  let endpoint :
      StateAtWitness
        start actions state origin.timeoutState :=
    {
      pastActions := occurrence.pastActions
      futureActions :=
        (.timeout candidate) :: occurrence.futureActions
      actions_eq := by
        simpa [List.append_assoc] using occurrence.actions_eq
      stateHistory := occurrence.before_history
      remainingHistory :=
        ⟨occurrence.enabled, occurrence.after_history⟩
    }
  rcases
      chosenCommitCertificate_stateAtWitness_coherent
        endpoint
        prefixCores
        timeoutBasis.certificate
        timeoutBasis.boundary with
    ⟨certificate, extension⟩
  have strict :
      certificate.choiceTerm <
        state.currentTerm candidate := by
    rw [extension.choiceTerm_eq, origin.term_eq]
    exact
      Nat.lt_succ_of_le
        timeoutBasis.choice_term_le_candidate
  exact
    ⟨{
      basis := {
        boundaryState := timeoutBasis.boundaryState
        owner := timeoutBasis.owner
        index := timeoutBasis.index
        boundary := timeoutBasis.boundary
        certificate
        configuration_mem := by
          rw [extension.configuration_eq,
            origin.configurations_eq]
          exact timeoutBasis.configuration_mem
        candidate_carries := by
          rw [extension.chosenPrefix_eq, origin.log_eq]
          exact timeoutBasis.candidate_carries
        choice_term_le_candidate := Nat.le_of_lt strict
      }
      choice_term_lt_candidate := strict
    }⟩

