  ack :
    AckWitness
      start actions state leader follower response lastLogIndex
  sendState : State
  send_occurrence :
    Occurs
      start actions state sendState
      (.appendEntries leader follower)
  send_leader :
    sendState.leadershipState leader = .leader
  send_term :
    sendState.currentTerm leader = response.term
  prefix_eq :
    logPrefix
        ((next ack.origin.responseState
          (.receive
            follower
            leader
            ack.origin.kind.receiveKind)).log follower)
        lastLogIndex =
      logPrefix (sendState.log leader) lastLogIndex

private theorem firstInserted_successfulAck_send_prefix
    {start : InitialConfiguration}
    {actions : List Action}
    {endState : State}
    {dest source : Node}
    {response : Message}
    {lastLogIndex : Nat}
    (witness :
      MessageEnqueueWitness
        start actions endState dest source response)
    (responseStateAt :
      StateAtWitness start actions endState witness.before)
    (receiveDest receiveSource : Node)
    (kind : AEResponseKind)
    (kindSuccessful : kind ≠ .reject)
    (request producedResponse : Message)
    (previousIndex previousTerm : Nat)
    (entries : List Entry)
    (leaderCommitIndex producedLastLogIndex : Nat)
    (actionEq :
      witness.action =
        .receive receiveDest receiveSource kind.receiveKind)
    (requestHead :
      headMessage? witness.before receiveDest receiveSource =
        some request)
    (requestBody :
      request.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (enabled :
      Enabled witness.before
        (.receive receiveDest receiveSource kind.receiveKind))
    (messagesAfter :
      (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).messages =
        reply witness.before.messages producedResponse request)
    (producedSource :
      producedResponse.source = receiveDest)
    (producedDest :
      producedResponse.dest = receiveSource)
    (responseBody :
      response.body =
        .appendEntriesResponse true lastLogIndex)
    (producedBody :
      producedResponse.body =
        .appendEntriesResponse true producedLastLogIndex)
    (producedTerm :
      producedResponse.term =
        (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).currentTerm
            receiveDest)
    (producedIndexBound :
      producedLastLogIndex <=
        ((next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).log
            receiveDest).length)
    (prefixForSend :
      forall send :
          AESendWitness
            start
            responseStateAt.pastActions
            witness.before
            receiveDest
            receiveSource
            request,
          logPrefix
              ((next witness.before
                (.receive receiveDest receiveSource
                  kind.receiveKind)).log receiveDest)
              producedLastLogIndex =
            logPrefix
              (send.sendState.log receiveSource)
              producedLastLogIndex) :
    Nonempty
      (SuccessfulAckSendPrefixWitness
        start actions endState dest source response lastLogIndex) := by
  have presentAfter :
      response ∈
        (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).messages
          dest source := by
    simpa [actionEq] using witness.presentAfter
  have presentReply :
      response ∈
        (reply witness.before.messages producedResponse request)
          dest source := by
    rw [← messagesAfter]
    exact presentAfter
  rcases firstInsertion_reply_eq
      witness.before.messages
      producedResponse
      request
      response
      dest
      source
      witness.absentBefore
      presentReply with
    ⟨destMatches, sourceMatches, responseEq⟩
  have destIsReceiveSource : dest = receiveSource :=
    destMatches.trans producedDest
  have sourceIsReceiveDest : source = receiveDest :=
    sourceMatches.trans producedSource
  have producedLastLogIndexEq :
      producedLastLogIndex = lastLogIndex := by
    rw [responseEq, producedBody] at responseBody
    simpa using responseBody
  have responseTermAtReceive :
      response.term =
        (next witness.before
          (.receive receiveDest receiveSource kind.receiveKind)).currentTerm
            receiveDest :=
    (congrArg Message.term responseEq).trans producedTerm
  have requestQueued :
      request ∈
        witness.before.messages receiveDest receiveSource :=
    headMessage?_mem
      witness.before receiveDest receiveSource request requestHead
  have requestHistory :=
    queueHistory_implies_AppendEntriesRequestHistoryConsistent
      (protocolHistory_implies_QueueHistoryConsistent
        responseStateAt.stateHistory)
  have requestProvenance :
      MessageHasAESendWitness
        start
        responseStateAt.pastActions
        witness.before
        receiveDest
        receiveSource
        request := by
    simpa [requestBody] using
      requestHistory
        receiveDest receiveSource request requestQueued
  rcases requestProvenance with ⟨send⟩
  have requestFields := requestBody
  rw [send.message_eq] at requestFields
  simp [appendEntriesMessage] at requestFields
  rcases requestFields with
    ⟨previousIndexEq, previousTermEq, entriesEq,
      leaderCommitIndexEq⟩
  subst previousIndex
  subst previousTerm
  subst entries
  subst leaderCommitIndex
  have sendTermAtReceiver :
      send.sendState.currentTerm receiveSource =
        witness.before.currentTerm receiveDest := by
    cases kind with
    | reject =>
        exact False.elim (kindSuccessful rfl)
    | alreadyDone =>
        have enabledFacts := enabled
        simp [Enabled, actionEnabled, requestHead,
          receiveBranchEnabled, AEResponseKind.receiveKind,
          send.message_eq, appendEntriesMessage] at enabledFacts
        have accept := enabledFacts.2.1
        simp [appendEntriesAcceptBase] at accept
        exact accept.1.1.1
    | noConflict =>
        have enabledFacts := enabled
        simp [Enabled, actionEnabled, requestHead,
          receiveBranchEnabled, AEResponseKind.receiveKind,
          send.message_eq, appendEntriesMessage] at enabledFacts
        have accept := enabledFacts.2.1
        simp [appendEntriesAcceptBase] at accept
        exact accept.1.1.1
    | conflictThenAlreadyDone =>
        have enabledFacts := enabled
        simp [Enabled, actionEnabled, requestHead,
          receiveBranchEnabled, AEResponseKind.receiveKind,
          send.message_eq, appendEntriesMessage] at enabledFacts
        have accept := enabledFacts.2.1.1
        simp [appendEntriesAcceptBase] at accept
        exact accept.1.1.1
    | conflictThenNoConflict =>
        have enabledFacts := enabled
        simp [Enabled, actionEnabled, requestHead,
          receiveBranchEnabled, AEResponseKind.receiveKind,
          send.message_eq, appendEntriesMessage] at enabledFacts
        have accept := enabledFacts.2.1.1
        simp [appendEntriesAcceptBase] at accept
        exact accept.1.1.1
  let origin :
      AEResponseWitness
        start actions endState dest source response :=
    {
      responseState := witness.before
      request := appendEntriesMessage
        send.sendState receiveSource receiveDest
      previousIndex :=
        send.sendState.sentIndex receiveSource receiveDest
      previousTerm :=
        (((entryAt?
              (send.sendState.log receiveSource)
              (send.sendState.sentIndex
                receiveSource receiveDest)).map
            (·.term)).getD 0)
      entries :=
        subsequence
          (send.sendState.log receiveSource)
          (send.sendState.sentIndex receiveSource receiveDest + 1)
          (min
            (send.sendState.log receiveSource).length
            (send.sendState.sentIndex receiveSource receiveDest + 1))
      leaderCommitIndex := send.sendState.commitIndex receiveSource
      kind
      occurrence := by
        simpa [actionEq, sourceIsReceiveDest,
          destIsReceiveSource] using witness.occurrence
      request_head := by
        simpa [send.message_eq, sourceIsReceiveDest,
          destIsReceiveSource] using requestHead
      request_body := by simp [appendEntriesMessage]
      response_present := by
        simpa [sourceIsReceiveDest, destIsReceiveSource] using
          presentAfter
    }
  let ack :
      AckWitness
        start actions endState dest source
        response lastLogIndex :=
    {
      origin
      response_body := responseBody
      response_term := by
        simpa [origin, sourceIsReceiveDest,
          destIsReceiveSource] using responseTermAtReceive
      index_bounded := by
        rw [← producedLastLogIndexEq]
        simpa [origin, sourceIsReceiveDest,
          destIsReceiveSource] using producedIndexBound
    }
  have sendOccurrence :
      Occurs
        start actions endState send.sendState
        (.appendEntries dest source) := by
    simpa [sourceIsReceiveDest, destIsReceiveSource] using
      occurs_extend_stateAtWitness responseStateAt send.occurrence
  have sendLeader :
      send.sendState.leadershipState dest = .leader := by
    rcases send.occurrence with ⟨sendOccurs⟩
    have sendEnabled := sendOccurs.enabled
    simp [Enabled, actionEnabled] at sendEnabled
    simpa [destIsReceiveSource] using sendEnabled.1.1.2
  have sendTerm :
      send.sendState.currentTerm dest = response.term := by
    calc
      send.sendState.currentTerm dest =
          send.sendState.currentTerm receiveSource := by
        simp [destIsReceiveSource]
      _ =
          witness.before.currentTerm receiveDest :=
        sendTermAtReceiver
      _ =
          (next witness.before
            (.receive receiveDest receiveSource
              kind.receiveKind)).currentTerm receiveDest := by
        cases kind with
        | reject =>
            exact False.elim (kindSuccessful rfl)
        | _ =>
            simp [AEResponseKind.receiveKind, next, rawNext,
              nextReceive, requestHead, send.message_eq,
              appendEntriesMessage, nextAppendEntriesAlreadyDone,
              nextAppendEntriesNoConflict, conflictRollback]
      _ = response.term := responseTermAtReceive.symm
  have prefixEq :
      logPrefix
          ((next witness.before
            (.receive receiveDest receiveSource
              kind.receiveKind)).log receiveDest)
          lastLogIndex =
        logPrefix
          (send.sendState.log receiveSource)
          lastLogIndex := by
    rw [← producedLastLogIndexEq]
    exact prefixForSend send
  exact ⟨{
    ack
    sendState := send.sendState
    send_occurrence := sendOccurrence
    send_leader := sendLeader
    send_term := sendTerm
    prefix_eq := by
      simpa [ack, origin, sourceIsReceiveDest,
        destIsReceiveSource] using prefixEq
  }⟩

private def SuccessfulAckSendPrefixConsistent
    (start : InitialConfiguration)
    (actions : List Action)
    (state : State) : Prop :=
  forall dest source message lastLogIndex,
    message ∈ state.messages dest source ->
      message.body = .appendEntriesResponse true lastLogIndex ->
        Nonempty
          (SuccessfulAckSendPrefixWitness
            start actions state dest source message lastLogIndex)

theorem initial_AcknowledgedPrefixRetainedInv
    (start : InitialConfiguration) :
    AcknowledgedPrefixRetainedInv start [] (initialState start) := by
  intro leader follower _leader _sameTerm witness
  rcases witness.handle_occurrence with ⟨occurrence⟩
  have actionsEq := occurrence.actions_eq
  simp at actionsEq

theorem initial_CurrentMatchIndexPrefixHistoryConsistent
    (start : InitialConfiguration) :
    CurrentMatchIndexPrefixHistoryConsistent
      start [] (initialState start) := by
  intro leader follower _leader _sameTerm positive
  simp [initialState] at positive

private def ackWitness_restrict
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {dest source : Node}
    {response : Message}
    {lastLogIndex : Nat}
    (ack :
      AckWitness
        start
        (actions ++ [action])
        (next state action)
        dest source response lastLogIndex)
    (occurrence :
      Occurs
        start actions state
        ack.origin.responseState
        (.receive source dest ack.origin.kind.receiveKind)) :
    AckWitness
      start actions state dest source response lastLogIndex := by
  let origin :
      AEResponseWitness
        start actions state dest source response :=
    {
      ack.origin with
      occurrence
    }
  exact {
    origin
    response_body := ack.response_body
    response_term := by
      simpa [origin] using ack.response_term
    index_bounded := by
      simpa [origin] using ack.index_bounded
  }

private def matchIndexWitness_restrict
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader follower : Node}
    (witness :
      MatchIndexWitness
        start
        (actions ++ [action])
        (next state action)
        leader follower)
    (ack :
      AckWitness
        start actions state leader follower
        witness.response witness.lastLogIndex)
    (occurrence :
      Occurs
        start actions state witness.handledState
        (.receive
          leader follower
          .handleAppendEntriesResponseSuccess))
    (indexEq :
      state.matchIndex leader follower =
        witness.lastLogIndex) :
    MatchIndexWitness
      start actions state leader follower :=
  {
    handledState := witness.handledState
    response := witness.response
    lastLogIndex := witness.lastLogIndex
    ack
    handle_occurrence := occurrence
    response_head := witness.response_head
    index_eq := indexEq
  }

private theorem logPrefix_isLogPrefix
    (entries : List Entry)
    (index : Nat) :
    isLogPrefix (logPrefix entries index) entries := by
  exact List.take_prefix index entries

private theorem prefix_eq_logPrefix_of_length
    (common entries : List Entry)
    (index : Nat)
    (prefixProof : isLogPrefix common entries)
    (lengthEq : common.length = index) :
    common = logPrefix entries index := by
  rcases prefixProof with ⟨suffix, entriesEq⟩
  calc
    common = logPrefix common index := by
      simp [logPrefix, lengthEq]
    _ = logPrefix (common ++ suffix) index :=
      (logPrefix_append_eq_of_index_le_length
        common suffix index (by omega)).symm
    _ = logPrefix entries index := by rw [entriesEq]

private theorem logPrefix_mono_isLogPrefix
    (entries : List Entry)
    (small large : Nat)
    (ordered : small <= large) :
    isLogPrefix
      (logPrefix entries small)
      (logPrefix entries large) := by
  simpa [isLogPrefix, logPrefix, List.take_take,
    Nat.min_eq_left ordered] using
      (List.take_prefix small (entries.take large))

theorem chosenCommitCertificate_prefix_of_signature
    {start : InitialConfiguration}
    {actions : List Action}
    {endState boundaryState targetState : State}
    {owner target : Node}
    {index signatureIndex signatureTerm : Nat}
    (history : ProtocolHistory start actions endState)
    (matching : TemporalLogMatchingInv start actions endState)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (certificate :
      ChosenCommitCertificate
        start actions endState boundaryState owner index)
    (targetAt :
      StateAt start actions endState targetState)
    (signatureAt :
      entryAt? (targetState.log target) signatureIndex =
        some
          ({ term := signatureTerm, content := .signature } :
            Entry))
    (indexLe : index <= signatureIndex)
    (termLe : certificate.choiceTerm <= signatureTerm) :
    isLogPrefix
      certificate.chosenPrefix
      (targetState.log target) := by
  have chosenLength :=
    chosenCommitCertificate_chosenPrefix_length certificate
  have indexPositive : 0 < index := by
    by_contra notPositive
    have indexZero : index = 0 := by omega
    have boundaryTerm := certificate.boundary_term
    simp [indexZero, entryAt?] at boundaryTerm
  have choiceAfterStart :
      startTerm <= certificate.choiceTerm := by
    rcases certificate.choice_at with ⟨choiceAtWitness⟩
    have minimum :=
      protocolHistory_implies_MinimumTermInv
        choiceAtWitness.stateHistory
    rw [← certificate.choice_term]
    exact minimum.activeRoles certificate.choiceLeader
      (by simp [certificate.choice_leader])
  have signatureOrigins :=
    protocolHistory_implies_HistoricalSignatureLeaderAtIndexInv
      history matching
  rcases
      signatureOrigins
        targetState targetAt target signatureIndex signatureTerm
        signatureAt
        (Nat.le_trans choiceAfterStart termLe) with
    ⟨leaderState, originLeader, leaderAt, originLeaderRole,
      originLeaderTerm, originLeaderEntry⟩
  have chosenInOriginLeader :
      isLogPrefix
        certificate.chosenPrefix
        (leaderState.log originLeader) := by
    rcases Nat.lt_or_eq_of_le termLe with
      choiceEarlier | sameChoiceTerm
    · exact certificate.higher_term_leaders
        leaderState leaderAt originLeader originLeaderRole
        (by simpa [originLeaderTerm] using choiceEarlier)
    · have sameLeader :
          certificate.choiceLeader = originLeader :=
        leaderUniqueness
          certificate.choiceState leaderState
          certificate.choice_at leaderAt
          certificate.choiceLeader originLeader
          certificate.choice_leader originLeaderRole
          (by
            rw [certificate.choice_term, originLeaderTerm,
              sameChoiceTerm])
      subst originLeader
      have originLength :
          signatureIndex <=
            (leaderState.log certificate.choiceLeader).length := by
        unfold entryAt? at originLeaderEntry
        split at originLeaderEntry
        · contradiction
        · have bound :=
            (List.getElem?_eq_some_iff.mp originLeaderEntry).choose
          omega
      have logsComparable :=
        historical_sameTerm_leader_logs_comparable
          certificate.choice_at leaderAt
          certificate.choiceLeader
          certificate.choice_leader originLeaderRole
          (by
            rw [certificate.choice_term, originLeaderTerm,
              sameChoiceTerm])
      rcases logsComparable with choiceToOrigin | originToChoice
      · exact
          (chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
            certificate).trans choiceToOrigin
      · rcases
            List.prefix_or_prefix_of_prefix
              (chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
                certificate)
              originToChoice with
          chosenToOrigin | originToChosen
        · exact chosenToOrigin
        · have sameLogs :
              leaderState.log certificate.choiceLeader =
                certificate.chosenPrefix :=
            originToChosen.eq_of_length_le
              (by rw [chosenLength]; omega)
          rw [sameLogs]
          exact List.prefix_rfl
  have originWithin :
      signatureIndex <= (leaderState.log originLeader).length := by
    unfold entryAt? at originLeaderEntry
    split at originLeaderEntry
    · contradiction
    · have bound :=
        (List.getElem?_eq_some_iff.mp originLeaderEntry).choose
      omega
  have targetWithin :
      signatureIndex <= (targetState.log target).length := by
    unfold entryAt? at signatureAt
    split at signatureAt
    · contradiction
    · have bound :=
        (List.getElem?_eq_some_iff.mp signatureAt).choose
      omega
  have prefixesAtSignature :
      logPrefix (leaderState.log originLeader) signatureIndex =
        logPrefix (targetState.log target) signatureIndex :=
    matching
      leaderState targetState leaderAt targetAt
      originLeader target signatureIndex
      (by omega)
      (Nat.le_min.mpr ⟨originWithin, targetWithin⟩)
      (by simp [originLeaderEntry, signatureAt])
  have chosenToOriginPrefix :
      isLogPrefix
        certificate.chosenPrefix
        (logPrefix
          (leaderState.log originLeader)
          signatureIndex) := by
    rw [prefix_eq_logPrefix_of_length
      certificate.chosenPrefix
      (leaderState.log originLeader)
      index chosenInOriginLeader chosenLength]
    exact logPrefix_mono_isLogPrefix
      (leaderState.log originLeader)
      index signatureIndex indexLe
  rw [prefixesAtSignature] at chosenToOriginPrefix
  exact chosenToOriginPrefix.trans
    (logPrefix_isLogPrefix
      (targetState.log target)
      signatureIndex)

theorem chosenCommitCertificate_configuration_mem_of_zero_commit
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState : State}
    {owner candidate : Node}
    {index : Nat}
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (configurationsExact : ConfigurationsExactInv state)
    (commitZero : state.commitIndex candidate = 0)
    (carries :
      isLogPrefix
        certificate.chosenPrefix
        (state.log candidate)) :
    certificate.configuration ∈
      state.configurations candidate := by
  have selectedFacts :=
    committedConfigurationAt?_some_properties
      (boundaryState.log owner)
      index
      certificate.configuration
      certificate.configuration_at
  have inBoundaryPrefix :
      certificate.configuration ∈
        logConfigurations ((boundaryState.log owner).take index) := by
    rw [logConfigurations_take]
    simpa [configurationsToIndex] using selectedFacts
  have inChosenPrefix :
      certificate.configuration ∈
        logConfigurations certificate.chosenPrefix := by
    rw [certificate.prefix_eq]
    exact inBoundaryPrefix
  rcases carries with ⟨suffix, targetLogEq⟩
  have inTargetLog :
      certificate.configuration ∈
        logConfigurations (state.log candidate) := by
    rw [← targetLogEq]
    rw [logConfigurations, configurationsInEntries,
      configurationsInEntriesAux_append]
    apply List.mem_append.mpr
    exact Or.inl
      (by
        simpa [logConfigurations, configurationsInEntries] using
          inChosenPrefix)
  have thresholdZero :
      lastConfigurationToIndex
          (logConfigurations (state.log candidate))
          0 =
        0 := by
    have thresholdLe :=
      lastConfigurationToIndex_le
        (logConfigurations (state.log candidate))
        0
    omega
  rw [configurationsExact candidate, commitZero]
  simp [activeLogConfigurations, thresholdZero,
    configurationsFromIndex, inTargetLog]

theorem candidateChosenConfigurationWitness_of_positive_commit
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (chosen :
      HereditaryHistoricalChosenCommitCore
        start actions state)
    (candidate : Node)
    (positive : 0 < state.commitIndex candidate) :
    HasCandidateChosenConfigurationWitness
      start actions state candidate := by
  have reachable := protocolHistory_reachable history
  have signatures := reachable_SignatureInv start reachable
  have configurationsExact :=
    reachable_ConfigurationsExactInv start reachable
  have currentChosen :
      HistoricalChosenCommitCore start actions state :=
    chosen List.prefix_rfl history
  have boundary :
      SignatureCommitBoundary
        state candidate (state.commitIndex candidate) :=
    ⟨positive, Nat.le_refl _,
      signatures candidate positive⟩
  rcases
      currentChosen
        state
        (protocolHistory_final_stateAt history)
        candidate
        (state.commitIndex candidate)
        boundary with
    ⟨certificate⟩
  exact ⟨{
    boundaryState := state
    owner := candidate
    index := state.commitIndex candidate
    boundary
    certificate
    configuration_mem :=
      configurationsExact_committedConfigurationAt?_mem
        state
        candidate
        configurationsExact
        certificate.configuration
        certificate.configuration_at
    candidate_carries := by
      rw [certificate.prefix_eq]
      exact List.take_prefix
        (state.commitIndex candidate)
        (state.log candidate)
    choice_term_le_candidate :=
      certificate.choice_term_le_boundary_owner
  }⟩

theorem candidateChosenConfigurationWitness_of_zero_commit_evidence_with_choice_term
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (chosen :
      HereditaryHistoricalChosenCommitCore
        start actions state)
    (historicalMono :
      HistoricalMonoLogInv start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (candidateOverlap :
      TemporalQuorumCandidateConfigurationOverlapInv
        start actions state)
    (candidate : Node)
    (commitZero : state.commitIndex candidate = 0)
    (basis : CandidateElectionBasis state candidate) :
    Exists fun witness :
      CandidateChosenConfigurationWitness
        start actions state candidate =>
      And
        (witness.certificate.choiceTerm = startTerm)
        (And
          (witness.certificate.configuration.index = 1)
          (witness.certificate.configuration.index <=
            maxCommittableIndex (state.log candidate))) := by
  rcases basis with commitPositive |
    ⟨configuration, configurationMember, _candidateMember,
      configurationBound⟩
  · omega
  have reachable := protocolHistory_reachable history
  have configurationsExact :=
    reachable_ConfigurationsExactInv start reachable
  have activeMember :
      configuration ∈
        activeLogConfigurations
          (state.log candidate)
          (state.commitIndex candidate) := by
    rw [← configurationsExact candidate]
    exact configurationMember
  have configurationInLog :
      configuration ∈ logConfigurations (state.log candidate) := by
    have filtered := activeMember
    simp [activeLogConfigurations, configurationsFromIndex] at filtered
    exact filtered.1
  have configurationPositive : 0 < configuration.index := by
    have bounds :=
      mem_configurationsInEntriesAux
        1
        (state.log candidate)
        configuration
        (by
          simpa [logConfigurations, configurationsInEntries] using
            configurationInLog)
    omega
  have maxPositive :
      0 < maxCommittableIndex (state.log candidate) := by
    exact Nat.lt_of_lt_of_le configurationPositive configurationBound
  rcases
      maxCommittableIndex_signature_or_zero
        (state.log candidate) with
    maxZero | ⟨signatureEntry, signatureAtMax, signatureContent⟩
  · omega
  let signatureTerm := signatureEntry.term
  have signatureAt :
      entryAt?
          (state.log candidate)
          (maxCommittableIndex (state.log candidate)) =
        some
          ({ term := signatureTerm, content := .signature } :
            Entry) := by
    cases signatureEntry with
    | mk term content =>
        simp [signatureTerm] at signatureContent ⊢
        subst content
        exact signatureAtMax
  have reconfigurationAt :
      logReconfigurationAt?
          (state.log candidate)
          configuration.index =
        some configuration.nodes :=
    activeLogConfigurations_match_log
      (state.log candidate)
      (state.commitIndex candidate)
      configuration
      activeMember
  have configurationBeforeMax :
      configuration.index <
        maxCommittableIndex (state.log candidate) := by
    have different :
        configuration.index ≠
          maxCommittableIndex (state.log candidate) := by
      intro sameIndex
      rw [sameIndex] at reconfigurationAt
      unfold logReconfigurationAt? at reconfigurationAt
      rw [signatureAt] at reconfigurationAt
      simp at reconfigurationAt
    omega
  have initialBoundary :
      SignatureCommitBoundary
        (initialState start) start 2 := by
    refine
      ⟨by simp [initialState, start.leader_mem],
        by simp [initialState, startLog, start.leader_mem], ?_⟩
    simp [initialState, startLog, entryAt?, start.leader_mem]
  have currentChosen :
      HistoricalChosenCommitCore start actions state :=
    chosen List.prefix_rfl history
  rcases
      currentChosen
        (initialState start)
        (protocolHistory_initial_stateAt history)
        start
        2
        initialBoundary with
    ⟨certificate⟩
  have certificateChoiceTerm :
      certificate.choiceTerm = startTerm := by
    have choiceLeStart :
        certificate.choiceTerm <= startTerm := by
        simpa [initialState, start.leader_mem] using
        certificate.choice_term_le_boundary_owner
    have startLeChoice :
        startTerm <= certificate.choiceTerm := by
      rcases certificate.choice_at with ⟨choiceAt⟩
      have minimum :=
        protocolHistory_implies_MinimumTermInv
          choiceAt.stateHistory
      rw [← certificate.choice_term]
      exact
        minimum.activeRoles
          certificate.choiceLeader
          (by simp [certificate.choice_leader])
    omega
  have minimum := protocolHistory_implies_MinimumTermInv history
  have signatureAfterStart :
      startTerm <= signatureTerm := by
    exact minimum.logs
      candidate
      ({ term := signatureTerm, content := .signature } : Entry)
      (entryAt?_mem
        (state.log candidate)
        (maxCommittableIndex (state.log candidate))
        ({ term := signatureTerm, content := .signature } : Entry)
        signatureAt)
  let electionVotes :=
    protocolHistory_implies_HistoricalElectionVoteCore history
  have voteCore : HistoricalVoteCore start actions state :=
    ⟨electionVotes.owner,
      electionVotes.ownerConsistent,
      electionVotes.electionVotes⟩
  have leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state :=
    historicalElectionCores_imply_TemporalLeaderUniquenessInv
      history
      voteCore
      (protocolHistory_implies_LeaderHistoryConsistent history)
      (quorumCandidateOverlap_implies_ElectionConfigurationsOverlapInv
        candidateOverlap)
  have carries :=
    chosenCommitCertificate_prefix_of_signature
      history
      matching
      leaderUniqueness
      certificate
      (protocolHistory_final_stateAt history)
      signatureAt
      (by omega)
      (by
        rw [certificateChoiceTerm]
        exact signatureAfterStart)
  let witness :
      CandidateChosenConfigurationWitness
        start actions state candidate :=
    {
      boundaryState := initialState start
      owner := start
      index := 2
      boundary := initialBoundary
      certificate
      configuration_mem :=
        chosenCommitCertificate_configuration_mem_of_zero_commit
          certificate
          configurationsExact
          commitZero
          carries
      candidate_carries := carries
      choice_term_le_candidate := by
        rw [certificateChoiceTerm]
        exact
          Nat.le_trans
            signatureAfterStart
            (logEntryTerm_le_currentTerm
              state
              (historicalMono
                state
                (protocolHistory_final_stateAt history))
              candidate
              (maxCommittableIndex (state.log candidate))
              ({ term := signatureTerm, content := .signature } :
                Entry)
              signatureAt)
    }
  have initialConfigurationAt :
      committedConfigurationAt?
          ((initialState start).log start)
          2 =
        some { index := 1, nodes := start.nodes } := by
    simpa [initialState, start.leader_mem] using
      committedConfigurationAt?_startLog start
  have certificateConfiguration :
      certificate.configuration =
        { index := 1, nodes := start.nodes } := by
    rw [certificate.configuration_at] at initialConfigurationAt
    exact Option.some.inj initialConfigurationAt
  exact
    ⟨witness,
      certificateChoiceTerm,
      by simpa [witness, certificateConfiguration],
      by
        rw [show witness.certificate.configuration.index = 1 by
          simpa [witness, certificateConfiguration]]
        exact maxPositive⟩

