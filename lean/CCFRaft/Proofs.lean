private theorem successfulAckPrefix_step
    {start : InitialConfiguration}
    {actions : List Action}
    {endState state : State}
    {leader follower : Node}
    {response : Message}
    {index : Nat}
    {action : Action}
    (history : ProtocolHistory start actions endState)
    (stateAt :
      StateAt start actions endState state)
    (nextStateAt :
      StateAt start actions endState (next state action))
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions endState)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (origin :
      SuccessfulAckSendPrefixWitness
        start actions endState leader follower response index)
    (finalLeader :
      endState.leadershipState leader = .leader)
    (responseTerm :
      response.term = endState.currentTerm leader)
    (leaderNeFollower : leader ≠ follower)
    (followerTerm :
      state.currentTerm follower =
        endState.currentTerm leader)
    (nextFollowerTerm :
      (next state action).currentTerm follower =
        endState.currentTerm leader)
    (retained :
      isLogPrefix
        (logPrefix
          ((next origin.ack.origin.responseState
            (.receive
              follower
              leader
              origin.ack.origin.kind.receiveKind)).log follower)
          index)
        (state.log follower))
    (enabled : Enabled state action) :
    isLogPrefix
      (logPrefix
        ((next origin.ack.origin.responseState
          (.receive
            follower
            leader
            origin.ack.origin.kind.receiveKind)).log follower)
        index)
      ((next state action).log follower) := by
  have retainLog
      (logRetained :
        isLogPrefix
          (state.log follower)
          ((next state action).log follower)) :
      isLogPrefix
        (logPrefix
          ((next origin.ack.origin.responseState
            (.receive
              follower
              leader
              origin.ack.origin.kind.receiveKind)).log follower)
          index)
        ((next state action).log follower) :=
    retained.trans logRetained
  cases action with
  | timeout node =>
      exact retainLog (by simp [isLogPrefix, next, rawNext, nextTimeout])
  | requestVote source dest =>
      exact retainLog (by simp [isLogPrefix, next, rawNext, nextRequestVote])
  | appendEntries source dest =>
      exact retainLog (by simp [isLogPrefix, next, rawNext, nextAppendEntries])
  | becomeLeader elected =>
      by_cases followerIsElected : follower = elected
      · subst elected
        have electedLeader :
            (next state (.becomeLeader follower)).leadershipState follower =
              .leader := by
          simp [next, rawNext, nextBecomeLeader, updateNode]
        have followerEqLeader :=
          leaderUniqueness
            (next state (.becomeLeader follower))
            endState
            nextStateAt
            (protocolHistory_final_stateAt history)
            follower
            leader
            electedLeader
            finalLeader
            nextFollowerTerm
        exact False.elim (leaderNeFollower followerEqLeader.symm)
      · exact retainLog
          (by
            simp [isLogPrefix, next, rawNext, nextBecomeLeader,
              followerIsElected])
  | clientRequest node =>
      by_cases followerIsNode : follower = node
      · subst node
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextClientRequest])
      · exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextClientRequest,
            followerIsNode])
  | signCommittableMessages node =>
      by_cases followerIsNode : follower = node
      · subst node
        exact retainLog
          (by
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages])
      · exact retainLog
          (by
            simp [isLogPrefix, next, rawNext,
              nextSignCommittableMessages, followerIsNode])
  | changeConfiguration node configuration =>
      by_cases followerIsNode : follower = node
      · subst node
        exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration])
      · exact retainLog
          (by simp [isLogPrefix, next, rawNext, nextChangeConfiguration,
            followerIsNode])
  | advanceCommitIndex node =>
      exact retainLog
        (by simp [isLogPrefix, next, rawNext, nextAdvanceCommitIndex])
  | receive receiveDest receiveSource kind =>
      cases head :
          headMessage? state receiveDest receiveSource with
      | none =>
          exact retainLog
            (by simp [isLogPrefix, next, rawNext, nextReceive, head])
      | some message =>
          cases kind with
          | rejectAppendEntriesRequest =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      exact retainLog
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, responseCase])
                  | some producedResponse =>
                      exact retainLog
                        (by
                          simp [isLogPrefix, next, rawNext, nextReceive,
                            head, body, responseCase])
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesNoConflict =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have enabledFacts := enabled
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabledFacts
                  have messageDest : message.dest = receiveDest :=
                    enabledFacts.2.1.1
                  have noConflict := enabledFacts.2.2.2
                  exact retainLog
                    (by
                      by_cases followerIsDest :
                          follower = receiveDest
                      · subst follower
                        simpa [next, rawNext, nextReceive, head, body,
                          messageDest] using
                          appendEntriesNoConflict_retains_old_log
                            state message previousIndex entries
                            leaderCommitIndex noConflict
                      · simp [isLogPrefix, next, rawNext, nextReceive,
                          head, body, nextAppendEntriesNoConflict,
                          messageDest, followerIsDest])
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesConflictThenAlreadyDone =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, head] at branchEnabled
                  have requestDestEq := branchEnabled.2.1.1
                  have branchEnabled := branchEnabled.2.2
                  simp [receiveBranchEnabled, body,
                    appendEntriesAcceptBase, appendEntriesLogOK,
                    appendEntriesAlreadyDoneGuard,
                    appendEntriesConflictGuard, conflictRollback,
                    updateNode, requestDestEq] at branchEnabled
                  rcases branchEnabled with
                    ⟨⟨_, conflict⟩, alreadyDone⟩
                  have entriesNonempty : entries ≠ [] :=
                    conflict.1.1
                  rcases alreadyDone with entriesEmpty | bounded
                  · exact False.elim (entriesNonempty entriesEmpty)
                  · exact False.elim (entriesNonempty bounded.2)
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | appendEntriesConflictThenNoConflict =>
              cases body : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  leaderCommitIndex =>
                  exact
                    conflictThenNoConflict_retains_acknowledgedPrefix
                      stateAt
                      sameLeaderPrefixes
                      leaderUniqueness
                      origin
                      finalLeader
                      responseTerm
                      followerTerm
                      retained
                      head
                      body
                      enabled
              | _ =>
                  simp [Enabled, actionEnabled, head,
                    receiveBranchEnabled, body] at enabled
          | _ =>
              cases body : message.body <;>
                exact retainLog
                  (by
                    simp [isLogPrefix, next, rawNext, nextReceive,
                      head, body, nextAppendEntriesAlreadyDone])

private theorem successfulAckSendPrefix_retained
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader follower : Node}
    {response : Message}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (origin :
      SuccessfulAckSendPrefixWitness
        start actions state leader follower response index)
    (finalLeader :
      state.leadershipState leader = .leader)
    (finalSameTerm :
      state.currentTerm leader = state.currentTerm follower)
    (responseTerm :
      response.term = state.currentTerm leader) :
    isLogPrefix
      (logPrefix
        ((next origin.ack.origin.responseState
          (.receive
            follower
            leader
            origin.ack.origin.kind.receiveKind)).log follower)
        index)
      (state.log follower) := by
  have leaderNeFollower : leader ≠ follower := by
    rcases origin.send_occurrence with ⟨sendOccurrence⟩
    have sendEnabled := sendOccurrence.enabled
    simp [Enabled, actionEnabled] at sendEnabled
    exact sendEnabled.1.1.1.2
  have finalFollowerTerm :
      state.currentTerm follower = response.term :=
    finalSameTerm.symm.trans responseTerm.symm
  rcases occurs_after_stateAt origin.ack.origin.occurrence with
    ⟨responseAfterAt⟩
  let acknowledgedPrefix :=
    logPrefix
      ((next origin.ack.origin.responseState
        (.receive
          follower
          leader
          origin.ack.origin.kind.receiveKind)).log follower)
      index
  have extend :
      forall
        (past suffix : List Action)
        (before : State),
        actions = past ++ suffix ->
          ProtocolHistory start past before ->
            Replays before suffix state ->
              before.currentTerm follower = response.term ->
                isLogPrefix acknowledgedPrefix (before.log follower) ->
                  isLogPrefix acknowledgedPrefix (state.log follower) := by
    intro past suffix
    induction suffix generalizing past with
    | nil =>
        intro before actionsEq pastHistory replay beforeTerm retained
        simp [Replays] at replay
        subst before
        exact retained
    | cons nextAction tail inductionHypothesis =>
        intro before actionsEq pastHistory replay beforeTerm retained
        rcases replay with ⟨enabled, tailReplay⟩
        have nextHistory :=
          replays_append_singleton pastHistory enabled
        have nextTermLeFinal :=
          replays_currentTerm_mono tailReplay follower
        have termStep :=
          monotonicTerm_step before nextAction enabled follower
        have nextTerm :
            (next before nextAction).currentTerm follower =
              response.term := by
          omega
        have beforeAt :
            StateAt start actions state before :=
          ⟨{
            pastActions := past
            futureActions := nextAction :: tail
            actions_eq := actionsEq
            stateHistory := pastHistory
            remainingHistory := ⟨enabled, tailReplay⟩
          }⟩
        have nextAt :
            StateAt start actions state (next before nextAction) :=
          ⟨{
            pastActions := past ++ [nextAction]
            futureActions := tail
            actions_eq := by
              simpa only [List.append_assoc, List.singleton_append] using
                actionsEq
            stateHistory := nextHistory
            remainingHistory := tailReplay
          }⟩
        have nextRetained :=
          successfulAckPrefix_step
            history
            beforeAt
            nextAt
            sameLeaderPrefixes
            leaderUniqueness
            origin
            finalLeader
            responseTerm
            leaderNeFollower
            (beforeTerm.trans responseTerm)
            (nextTerm.trans responseTerm)
            (by simpa [acknowledgedPrefix] using retained)
            enabled
        have result :=
          inductionHypothesis
            (past ++ [nextAction])
            (next before nextAction)
            (by
              simpa only [List.append_assoc, List.singleton_append] using
                actionsEq)
            nextHistory
            tailReplay
            nextTerm
            (by simpa [acknowledgedPrefix] using nextRetained)
        exact result
  have initialRetained :
      isLogPrefix
        acknowledgedPrefix
        ((next origin.ack.origin.responseState
          (.receive
            follower
            leader
            origin.ack.origin.kind.receiveKind)).log follower) := by
    exact logPrefix_isLogPrefix _ _
  exact
    extend
      responseAfterAt.pastActions
      responseAfterAt.futureActions
      (next origin.ack.origin.responseState
        (.receive
          follower
          leader
          origin.ack.origin.kind.receiveKind))
      responseAfterAt.actions_eq
      responseAfterAt.stateHistory
      responseAfterAt.remainingHistory
      origin.ack.response_term.symm
      initialRetained

theorem currentMatchIndexPrefixHistory_implies_MatchIndexPrefixInv_of_strongAcks
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (currentHistory :
      CurrentMatchIndexPrefixHistoryConsistent start actions state)
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (strongAcksFromHistory :
      forall {pastActions historicalState},
        ProtocolHistory start pastActions historicalState ->
          TemporalLogMatchingInv
              start pastActions historicalState ->
            SuccessfulAckSendPrefixConsistent
              start pastActions historicalState) :
    MatchIndexPrefixInv state := by
  intro leader follower leaderState sameTerm
  dsimp
  by_cases indexZero :
      state.matchIndex leader follower = 0
  · simp [indexZero, logPrefix]
  · have indexPositive :
        0 < state.matchIndex leader follower := by
      omega
    rcases
        currentHistory
          leader follower leaderState sameTerm indexPositive with
      ⟨current⟩
    rcases
        occurs_before_stateAt current.matchWitness.handle_occurrence with
      ⟨handledStateAt⟩
    have matchingAtHandled :
        TemporalLogMatchingInv
          start
          handledStateAt.pastActions
          current.matchWitness.handledState := by
      intro first second firstAt secondAt
      exact matching
        first
        second
        (stateAt_extend_stateAtWitness handledStateAt firstAt)
        (stateAt_extend_stateAtWitness handledStateAt secondAt)
    have responseQueued :
        current.matchWitness.response ∈
          current.matchWitness.handledState.messages leader follower :=
      headMessage?_mem
        current.matchWitness.handledState
        leader
        follower
        current.matchWitness.response
        current.matchWitness.response_head
    have strongAcks :=
      strongAcksFromHistory
        handledStateAt.stateHistory
        matchingAtHandled
    rcases
        strongAcks
          leader
          follower
          current.matchWitness.response
          current.matchWitness.lastLogIndex
          responseQueued
          current.matchWitness.ack.response_body with
      ⟨origin⟩
    let extendedOrigin :
        AEResponseWitness
          start actions state leader follower
          current.matchWitness.response :=
      {
        origin.ack.origin with
        occurrence :=
          occurs_extend_stateAtWitness
            handledStateAt origin.ack.origin.occurrence
      }
    let extendedAck :
        AckWitness
          start actions state leader follower
          current.matchWitness.response
          current.matchWitness.lastLogIndex :=
      {
        origin := extendedOrigin
        response_body := origin.ack.response_body
        response_term := origin.ack.response_term
        index_bounded := origin.ack.index_bounded
      }
    let extendedStrong :
        SuccessfulAckSendPrefixWitness
          start actions state leader follower
          current.matchWitness.response
          current.matchWitness.lastLogIndex :=
      {
        ack := extendedAck
        sendState := origin.sendState
        send_occurrence :=
          occurs_extend_stateAtWitness
            handledStateAt origin.send_occurrence
        send_leader := origin.send_leader
        send_term := origin.send_term
        prefix_eq := by
          simpa [extendedAck, extendedOrigin] using origin.prefix_eq
      }
    have followerRetained :=
      successfulAckSendPrefix_retained
        history
        sameLeaderPrefixes
        leaderUniqueness
        extendedStrong
        leaderState
        sameTerm
        current.response_term
    have senderRetained :=
      sameLeaderPrefixes
        origin.sendState
        (occurs_before_stateAt
          (occurs_extend_stateAtWitness
            handledStateAt origin.send_occurrence))
        leader
        origin.send_leader
        leaderState
        (origin.send_term.trans current.response_term)
    have senderBound :
        current.matchWitness.lastLogIndex <=
          (origin.sendState.log leader).length := by
      have lengthEq := congrArg List.length origin.prefix_eq
      simp [logPrefix, List.length_take,
        Nat.min_eq_left origin.ack.index_bounded] at lengthEq
      omega
    have leaderBound :
        current.matchWitness.lastLogIndex <=
          (state.log leader).length :=
      Nat.le_trans senderBound senderRetained.length_le
    have acknowledgedPrefixLength :
        (logPrefix
          ((next origin.ack.origin.responseState
            (.receive
              follower
              leader
              origin.ack.origin.kind.receiveKind)).log follower)
          current.matchWitness.lastLogIndex).length =
            current.matchWitness.lastLogIndex := by
      simp [logPrefix, Nat.min_eq_left origin.ack.index_bounded]
    have followerBound :
        current.matchWitness.lastLogIndex <=
          (state.log follower).length := by
      rw [← acknowledgedPrefixLength]
      simpa [extendedStrong, extendedAck, extendedOrigin] using
        followerRetained.length_le
    rcases senderRetained with ⟨leaderSuffix, leaderLogEq⟩
    have leaderPrefixEq :
        logPrefix
            (state.log leader)
            current.matchWitness.lastLogIndex =
          logPrefix
            (origin.sendState.log leader)
            current.matchWitness.lastLogIndex := by
      rw [← leaderLogEq]
      exact
        logPrefix_append_eq_of_index_le_length
          (origin.sendState.log leader)
          leaderSuffix
          current.matchWitness.lastLogIndex
          senderBound
    have followerPrefixEq :
        logPrefix
            (state.log follower)
            current.matchWitness.lastLogIndex =
          logPrefix
            (origin.sendState.log leader)
            current.matchWitness.lastLogIndex := by
      have retainedAtOrigin :
          isLogPrefix
            (logPrefix
              ((next origin.ack.origin.responseState
                (.receive
                  follower
                  leader
                  origin.ack.origin.kind.receiveKind)).log follower)
              current.matchWitness.lastLogIndex)
            (state.log follower) := by
        simpa [extendedStrong, extendedAck, extendedOrigin] using
          followerRetained
      exact
        (prefix_eq_logPrefix_of_length
          _
          (state.log follower)
          current.matchWitness.lastLogIndex
          retainedAtOrigin
          acknowledgedPrefixLength).symm.trans origin.prefix_eq
    rw [current.matchWitness.index_eq]
    exact
      ⟨leaderBound,
        followerBound,
        leaderPrefixEq.trans followerPrefixEq.symm⟩

private theorem persistent_positive_match_old_same_term
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader follower : Node}
    (history : ProtocolHistory start actions state)
    (enabled : Enabled state action)
    (oldLeader : state.leadershipState leader = .leader)
    (newLeader :
      (next state action).leadershipState leader = .leader)
    (newSameTerm :
      (next state action).currentTerm leader =
        (next state action).currentTerm follower)
    (matchUnchanged :
      (next state action).matchIndex leader follower =
        state.matchIndex leader follower)
    (positive :
      0 < (next state action).matchIndex leader follower) :
    state.currentTerm leader = state.currentTerm follower := by
  have oldPositive :
      0 < state.matchIndex leader follower := by
    omega
  have leaderTermLeFollowerTerm :=
    positiveMatchIndex_leaderTerm_le_followerTerm
      history leader follower oldLeader oldPositive
  have leaderTermEq :=
    persistentLeader_currentTerm_step
      state action leader newLeader
  have followerTermMonotonic :=
    monotonicTerm_step state action enabled follower
  omega

private theorem conflictThenNoConflict_retains_matchPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {leader follower receiveDest receiveSource : Node}
    {message : Message}
    {previousIndex previousTerm leaderCommitIndex : Nat}
    {entries : List Entry}
    (history : ProtocolHistory start actions state)
    (prefixes : MatchIndexPrefixInv state)
    (sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (leaderState : state.leadershipState leader = .leader)
    (sameTerm :
      state.currentTerm leader = state.currentTerm follower)
    (head :
      headMessage? state receiveDest receiveSource = some message)
    (body :
      message.body =
        .appendEntriesRequest
          previousIndex previousTerm entries leaderCommitIndex)
    (enabled :
      Enabled state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)) :
    isLogPrefix
      (logPrefix
        (state.log follower)
        (state.matchIndex leader follower))
      ((next state
        (.receive
          receiveDest receiveSource
          .appendEntriesConflictThenNoConflict)).log follower) := by
  by_cases followerIsDest : follower = receiveDest
  · subst receiveDest
    have branchEnabled := enabled
    simp [Enabled, actionEnabled, head,
      receiveBranchEnabled, body] at branchEnabled
    have requestQueued :
        message ∈ state.messages follower receiveSource :=
      headMessage?_mem state follower receiveSource message head
    rcases
        (by
          simpa [body] using
            requests follower receiveSource message requestQueued) with
      ⟨send⟩
    have fields := body
    rw [send.message_eq] at fields
    simp [appendEntriesMessage] at fields
    rcases fields with
      ⟨previousIndexEq, previousTermEq, entriesEq,
        leaderCommitIndexEq⟩
    subst previousIndex
    subst previousTerm
    subst entries
    subst leaderCommitIndex
    have previousAtLeastMatch :=
      appendEntriesConflict_previousIndex_ge_matchIndex
        history
        prefixes
        sameLeaderPrefixes
        leaderUniqueness
        leaderState
        sameTerm
        send.occurrence
        (by
          simpa [send.message_eq, appendEntriesMessage] using
            branchEnabled.2.2.1.1)
        (by
          simpa [send.message_eq, appendEntriesMessage] using
            branchEnabled.2.2.1.2)
    have oldPrefixFacts :=
      prefixes leader follower leaderState sameTerm
    have resultPrefixEq :
        logPrefix
            ((next state
              (.receive
                follower receiveSource
                .appendEntriesConflictThenNoConflict)).log follower)
            (state.matchIndex leader follower) =
          logPrefix
            (state.log follower)
            (state.matchIndex leader follower) := by
      simp [next, rawNext, nextReceive, head,
        send.message_eq, appendEntriesMessage,
        nextAppendEntriesNoConflict, conflictRollback,
        logPrefix]
      rw [List.take_append_of_le_length
        (by
          simpa [List.length_take] using
            Nat.le_min.mpr
              ⟨previousAtLeastMatch, oldPrefixFacts.2.1⟩)]
      simp [List.take_take,
        Nat.min_eq_left previousAtLeastMatch]
    rw [← resultPrefixEq]
    exact logPrefix_isLogPrefix _ _
  · simpa [next, rawNext, nextReceive, head, body,
      nextAppendEntriesNoConflict, conflictRollback, followerIsDest,
      isLogPrefix,
      (by
        have branchEnabled := enabled
        simp [Enabled, actionEnabled, head,
          receiveBranchEnabled, body] at branchEnabled
        exact branchEnabled.2.1.1 : message.dest = receiveDest)] using
      logPrefix_isLogPrefix
        (state.log follower)
        (state.matchIndex leader follower)

private theorem acknowledgedPrefixRetained_of_unchanged_match
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader follower : Node}
    (history : ProtocolHistory start actions state)
    (acknowledged :
      AcknowledgedPrefixRetainedInv start actions state)
    (enabled : Enabled state action)
    (newLeader :
      (next state action).leadershipState leader = .leader)
    (newSameTerm :
      (next state action).currentTerm leader =
        (next state action).currentTerm follower)
    (witness :
      MatchIndexWitness
        start
        (actions ++ [action])
        (next state action)
        leader follower)
    (responseTerm :
      witness.response.term =
        (next state action).currentTerm leader)
    (positive : 0 < witness.lastLogIndex)
    (oldLeader : state.leadershipState leader = .leader)
    (matchUnchanged :
      (next state action).matchIndex leader follower =
        state.matchIndex leader follower)
    (followerLogRetained :
      isLogPrefix
        (state.log follower)
        ((next state action).log follower))
    (notCurrentHandle :
      action ≠
        .receive
          leader follower .handleAppendEntriesResponseSuccess) :
    isLogPrefix
      (logPrefix
        ((next
          witness.ack.origin.responseState
          (.receive
            follower
            leader
            witness.ack.origin.kind.receiveKind)).log follower)
        witness.lastLogIndex)
      ((next state action).log follower) := by
  rcases
      occurs_append_singleton_cases
        history enabled witness.ack.origin.occurrence with
    oldAck | currentAck
  · rcases
        occurs_append_singleton_cases
          history enabled witness.handle_occurrence with
      oldHandle | currentHandle
    · have oldSameTerm :=
        persistent_positive_match_old_same_term
          history
          enabled
          oldLeader
          newLeader
          newSameTerm
          matchUnchanged
          (by
            rw [witness.index_eq]
            exact positive)
      exact
        acknowledgedPrefixRetained_extend_old
          acknowledged
          witness
          oldAck
          oldHandle
          oldLeader
          oldSameTerm
          (matchUnchanged.symm.trans witness.index_eq)
          (responseTerm.trans
            (persistentLeader_currentTerm_step
              state action leader newLeader))
          followerLogRetained
    · exact False.elim
        (notCurrentHandle currentHandle.2.symm)
  · rcases currentAck with ⟨responseStateEq, actionEq⟩
    simpa [responseStateEq, ← actionEq] using
      logPrefix_isLogPrefix
        ((next
          state
          (.receive
            follower
            leader
            witness.ack.origin.kind.receiveKind)).log follower)
        witness.lastLogIndex

private theorem queueHistory_implies_SuccessfulAckSendPrefixConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (matching : TemporalLogMatchingInv start actions state)
    (queues : QueueHistoryConsistent start actions state) :
    SuccessfulAckSendPrefixConsistent start actions state := by
  intro dest source message lastLogIndex queued responseBody
  rcases queues dest source message queued with ⟨witness⟩
  cases actionEq : witness.action with
  | timeout candidate =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextTimeout] using
        witness.presentAfter
  | requestVote sendSource sendDest =>
      have inserted :=
        firstInsertion_enqueue_eq
          witness.before.messages
          (requestVoteMessage witness.before sendSource sendDest)
          message
          dest
          source
          witness.absentBefore
          (by
            simpa [actionEq, next, rawNext, nextRequestVote] using
              witness.presentAfter)
      rw [inserted.2.2] at responseBody
      simp [requestVoteMessage] at responseBody
  | appendEntries sendSource sendDest =>
      have inserted :=
        firstInsertion_enqueue_eq
          witness.before.messages
          (appendEntriesMessage witness.before sendSource sendDest)
          message
          dest
          source
          witness.absentBefore
          (by
            simpa [actionEq, next, rawNext, nextAppendEntries] using
              witness.presentAfter)
      rw [inserted.2.2] at responseBody
      simp [appendEntriesMessage] at responseBody
  | becomeLeader leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextBecomeLeader] using
        witness.presentAfter
  | clientRequest leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextClientRequest] using
        witness.presentAfter
  | signCommittableMessages leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext,
        nextSignCommittableMessages] using witness.presentAfter
  | changeConfiguration leader configuration =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextChangeConfiguration] using
        witness.presentAfter
  | advanceCommitIndex leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextAdvanceCommitIndex] using
        witness.presentAfter
  | receive receiveDest receiveSource kind =>
      have insertionEnabled :
          Enabled witness.before
            (.receive receiveDest receiveSource kind) := by
        rcases witness.occurrence with ⟨occurrence⟩
        simpa [actionEq] using occurrence.enabled
      rcases occurs_before_stateAt witness.occurrence with
        ⟨responseStateAt⟩
      have presentAfter :
          message ∈
            (next witness.before
              (.receive receiveDest receiveSource kind)).messages
              dest source := by
        simpa [actionEq] using witness.presentAfter
      have impossibleUnchanged
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              witness.before.messages) :
          False := by
        apply witness.absentBefore
        rw [← messagesAfter]
        exact presentAfter
      have impossibleDiscard
          (discarded : Message)
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              Model.discard witness.before.messages discarded) :
          False := by
        apply witness.absentBefore
        exact mem_before_of_mem_discard
          witness.before.messages
          discarded
          message
          dest
          source
          (by
            rw [← messagesAfter]
            exact presentAfter)
      have impossibleNonSuccessfulReply
          (response request : Message)
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              reply witness.before.messages response request)
          (responseIsNotSuccessful :
            match response.body with
            | .appendEntriesResponse true _ => False
            | _ => True) :
          False := by
        have presentReply :
            message ∈
              (reply witness.before.messages response request)
                dest source := by
          rw [← messagesAfter]
          exact presentAfter
        rcases firstInsertion_reply_eq
            witness.before.messages
            response
            request
            message
            dest
            source
            witness.absentBefore
            presentReply with
          ⟨_, _, messageEq⟩
        rw [messageEq] at responseBody
        rw [responseBody] at responseIsNotSuccessful
        exact responseIsNotSuccessful
      cases hmessage :
          headMessage? witness.before receiveDest receiveSource with
      | none =>
          exact False.elim
            (impossibleUnchanged
              (by simp [next, rawNext, nextReceive, hmessage]))
      | some request =>
          have enabledFacts := insertionEnabled
          simp [Enabled, actionEnabled, hmessage] at enabledFacts
          have requestDest : request.dest = receiveDest :=
            enabledFacts.2.1.1
          have requestSource : request.source = receiveSource :=
            enabledFacts.2.1.2
          cases kind with
          | dropIgnored =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | updateTerm =>
              exact False.elim
                (impossibleUnchanged
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | handleRequestVoteRequest =>
              cases hbody : request.body with
              | requestVoteRequest requestLastTerm requestLastIndex
                  requestIsPreVote =>
                  let grant :=
                    requestVoteGranted
                      witness.before
                      receiveDest
                      receiveSource
                      request.term
                      requestLastTerm
                      requestLastIndex
                  let response : Message :=
                    {
                      term := witness.before.currentTerm receiveDest
                      source := receiveDest
                      dest := receiveSource
                      body :=
                        .requestVoteResponse grant requestIsPreVote
                    }
                  exact False.elim
                    (impossibleNonSuccessfulReply
                      response
                      request
                      (by
                        simp [next, rawNext, nextReceive, hmessage,
                          hbody, grant, response])
                      (by simp [response]))
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | handleRequestVoteResponse =>
              cases hbody : request.body with
              | requestVoteResponse voteGranted isPreVote =>
                  exact False.elim
                    (impossibleDiscard request
                      (by
                        cases voteGranted <;>
                          simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | dropRequestVoteResponseOutOfState =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | dropRequestVoteResponseStale =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | rejectAppendEntriesRequest =>
              cases hbody : request.body with
              | appendEntriesRequest requestPreviousIndex
                  requestPreviousTerm requestEntries requestCommitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        witness.before
                        request
                        requestPreviousIndex
                        requestPreviousTerm with
                  | none =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody, responseCase]))
                  | some response =>
                      apply False.elim
                      apply impossibleNonSuccessfulReply response request
                      · simp [next, rawNext, nextReceive, hmessage,
                          hbody, responseCase]
                      · rcases appendEntriesRejectResponse_body_eq
                            witness.before
                            request
                            response
                            requestPreviousIndex
                            requestPreviousTerm
                            responseCase with
                          ⟨responseLastIndex, responseBodyEq⟩
                        simp [responseBodyEq]
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | returnToFollower =>
              cases hbody : request.body <;>
                exact False.elim
                  (impossibleUnchanged
                    (by simp [next, rawNext, nextReceive, hmessage,
                      hbody]))
          | appendEntriesAlreadyDone =>
              cases hbody : request.body with
              | appendEntriesRequest requestPreviousIndex
                  requestPreviousTerm requestEntries requestCommitIndex =>
                  let producedLastLogIndex :=
                    requestPreviousIndex + requestEntries.length
                  let response : Message :=
                    {
                      term := witness.before.currentTerm request.dest
                      source := request.dest
                      dest := request.source
                      body :=
                        .appendEntriesResponse true producedLastLogIndex
                    }
                  exact
                    firstInserted_successfulAck_send_prefix
                      witness
                      responseStateAt
                      receiveDest
                      receiveSource
                      .alreadyDone
                      (by decide)
                      request
                      response
                      requestPreviousIndex
                      requestPreviousTerm
                      requestEntries
                      requestCommitIndex
                      producedLastLogIndex
                      (by
                        simpa [AEResponseKind.receiveKind] using actionEq)
                      hmessage
                      hbody
                      insertionEnabled
                      (by
                        simp [AEResponseKind.receiveKind, next, rawNext,
                          nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone,
                          producedLastLogIndex, response])
                      (by simpa [response] using requestDest)
                      (by simpa [response] using requestSource)
                      responseBody
                      (by simp [response])
                      (by
                        simp [AEResponseKind.receiveKind, next, rawNext,
                          nextReceive, hmessage, hbody,
                          nextAppendEntriesAlreadyDone, response,
                          requestDest])
                      (appendEntriesAlreadyDone_response_index_bounded
                        witness.before
                        receiveDest
                        receiveSource
                        request
                        requestPreviousIndex
                        requestPreviousTerm
                        requestEntries
                        requestCommitIndex
                        hmessage
                        hbody
                        insertionEnabled)
                      (by
                        intro send
                        have minimumTerms :=
                          protocolHistory_implies_MinimumTermInv
                            responseStateAt.stateHistory
                        have sendOccurrence :=
                          occurs_extend_stateAtWitness
                            responseStateAt send.occurrence
                        have fields := hbody
                        rw [send.message_eq] at fields
                        simp [appendEntriesMessage] at fields
                        rcases fields with
                          ⟨previousIndexEq, previousTermEq, entriesEq,
                            commitIndexEq⟩
                        subst requestPreviousIndex
                        subst requestPreviousTerm
                        subst requestEntries
                        subst requestCommitIndex
                        simpa [producedLastLogIndex] using
                          appendEntriesMessage_alreadyDone_result_prefix_eq
                            (stateAt := ⟨responseStateAt⟩)
                            sendOccurrence
                            matching
                            minimumTerms
                            (by simpa [send.message_eq] using hmessage)
                            insertionEnabled)
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | appendEntriesNoConflict =>
              cases hbody : request.body with
              | appendEntriesRequest requestPreviousIndex
                  requestPreviousTerm requestEntries requestCommitIndex =>
                  let nextLog :=
                    (witness.before.log request.dest).take
                        requestPreviousIndex ++
                      requestEntries
                  let producedLastLogIndex := nextLog.length
                  let response : Message :=
                    {
                      term := witness.before.currentTerm request.dest
                      source := request.dest
                      dest := request.source
                      body :=
                        .appendEntriesResponse true producedLastLogIndex
                    }
                  exact
                    firstInserted_successfulAck_send_prefix
                      witness
                      responseStateAt
                      receiveDest
                      receiveSource
                      .noConflict
                      (by decide)
                      request
                      response
                      requestPreviousIndex
                      requestPreviousTerm
                      requestEntries
                      requestCommitIndex
                      producedLastLogIndex
                      (by
                        simpa [AEResponseKind.receiveKind] using actionEq)
                      hmessage
                      hbody
                      insertionEnabled
                      (by
                        simp [AEResponseKind.receiveKind, next, rawNext,
                          nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, nextLog,
                          producedLastLogIndex, response])
                      (by simpa [response] using requestDest)
                      (by simpa [response] using requestSource)
                      responseBody
                      (by simp [response])
                      (by
                        simp [AEResponseKind.receiveKind, next, rawNext,
                          nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, response,
                          requestDest])
                      (by
                        simp [AEResponseKind.receiveKind, next, rawNext,
                          nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, nextLog,
                          producedLastLogIndex, requestDest, updateNode])
                      (by
                        intro send
                        have minimumTerms :=
                          protocolHistory_implies_MinimumTermInv
                            responseStateAt.stateHistory
                        have sendOccurrence :=
                          occurs_extend_stateAtWitness
                            responseStateAt send.occurrence
                        have fields := hbody
                        rw [send.message_eq] at fields
                        simp [appendEntriesMessage] at fields
                        rcases fields with
                          ⟨previousIndexEq, previousTermEq, entriesEq,
                            commitIndexEq⟩
                        subst requestPreviousIndex
                        subst requestPreviousTerm
                        subst requestEntries
                        subst requestCommitIndex
                        have enabledBranch := insertionEnabled
                        simp [Enabled, actionEnabled, hmessage,
                          receiveBranchEnabled, send.message_eq,
                          appendEntriesMessage] at enabledBranch
                        have accepted :=
                          appendEntriesMessage_accepted_prefix_eq
                            (stateAt := ⟨responseStateAt⟩)
                            sendOccurrence
                            matching
                            minimumTerms
                            enabledBranch.2.1
                        have resultLogEq :=
                          appendEntriesMessage_result_log_eq
                            send.sendState
                            witness.before
                            receiveSource
                            receiveDest
                            accepted.2
                        have producedIndexEq :
                            producedLastLogIndex =
                              ((next witness.before
                                (.receive
                                  receiveDest
                                  receiveSource
                                  .appendEntriesNoConflict)).log
                                receiveDest).length := by
                          simp [producedLastLogIndex, nextLog,
                            next, rawNext, nextReceive, hmessage,
                            send.message_eq, appendEntriesMessage,
                            nextAppendEntriesNoConflict]
                        have afterLogEq :
                            (next witness.before
                                (.receive
                                  receiveDest
                                  receiveSource
                                  .appendEntriesNoConflict)).log
                                receiveDest =
                              (send.sendState.log receiveSource).take
                                (send.sendState.sentIndex
                                  receiveSource receiveDest + 1) := by
                          simpa [next, rawNext, nextReceive, hmessage,
                            send.message_eq, appendEntriesMessage,
                            nextAppendEntriesNoConflict] using resultLogEq
                        simp only [AEResponseKind.receiveKind]
                        rw [producedIndexEq, afterLogEq]
                        simp [logPrefix, List.take_take])
              | _ =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage,
                        hbody]))
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : request.body with
              | appendEntriesRequest requestPreviousIndex
                requestPreviousTerm requestEntries requestCommitIndex =>
                have branchEnabled := insertionEnabled
                simp [Enabled, actionEnabled, hmessage] at branchEnabled
                have requestDestEq := branchEnabled.2.1.1
                have branchEnabled := branchEnabled.2.2
                simp [receiveBranchEnabled, hbody,
                  appendEntriesAcceptBase, appendEntriesLogOK,
                  appendEntriesAlreadyDoneGuard,
                  appendEntriesConflictGuard, conflictRollback,
                  updateNode, requestDestEq] at branchEnabled
                rcases branchEnabled with
                  ⟨⟨_, conflict⟩, alreadyDone⟩
                have entriesNonempty : requestEntries ≠ [] :=
                  conflict.1.1
                rcases alreadyDone with entriesEmpty | bounded
                · exact False.elim (entriesNonempty entriesEmpty)
                · exact False.elim (entriesNonempty bounded.2)
              | _ =>
                exact False.elim
                  (impossibleUnchanged
                    (by simp [next, rawNext, nextReceive, hmessage,
                      hbody]))
          | appendEntriesConflictThenNoConflict =>
              cases hbody : request.body with
              | appendEntriesRequest requestPreviousIndex
                requestPreviousTerm requestEntries requestCommitIndex =>
                let rolled :=
                  conflictRollback
                    witness.before receiveDest requestPreviousIndex
                let nextLog :=
                  (rolled.log request.dest).take requestPreviousIndex ++
                    requestEntries
                let producedLastLogIndex := nextLog.length
                let response : Message :=
                  {
                    term := witness.before.currentTerm request.dest
                    source := request.dest
                    dest := request.source
                    body :=
                      .appendEntriesResponse true producedLastLogIndex
                  }
                exact
                  firstInserted_successfulAck_send_prefix
                    witness
                    responseStateAt
                    receiveDest
                    receiveSource
                    .conflictThenNoConflict
                    (by decide)
                    request
                    response
                    requestPreviousIndex
                    requestPreviousTerm
                    requestEntries
                    requestCommitIndex
                    producedLastLogIndex
                    (by
                      simpa [AEResponseKind.receiveKind] using actionEq)
                    hmessage
                    hbody
                    insertionEnabled
                    (by
                      simp [AEResponseKind.receiveKind, next, rawNext,
                        nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        rolled, nextLog, producedLastLogIndex, response])
                    (by simpa [response] using requestDest)
                    (by simpa [response] using requestSource)
                    responseBody
                    (by simp [response])
                    (by
                      simp [AEResponseKind.receiveKind, next, rawNext,
                        nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        response, requestDest])
                    (by
                      simp [AEResponseKind.receiveKind, next, rawNext,
                        nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        rolled, nextLog, producedLastLogIndex,
                        requestDest, updateNode])
                    (by
                      intro send
                      have minimumTerms :=
                        protocolHistory_implies_MinimumTermInv
                          responseStateAt.stateHistory
                      have sendOccurrence :=
                        occurs_extend_stateAtWitness
                          responseStateAt send.occurrence
                      have fields := hbody
                      rw [send.message_eq] at fields
                      simp [appendEntriesMessage] at fields
                      rcases fields with
                        ⟨previousIndexEq, previousTermEq, entriesEq,
                          commitIndexEq⟩
                      subst requestPreviousIndex
                      subst requestPreviousTerm
                      subst requestEntries
                      subst requestCommitIndex
                      have enabledBranch := insertionEnabled
                      simp [Enabled, actionEnabled, hmessage,
                        receiveBranchEnabled, send.message_eq,
                        appendEntriesMessage] at enabledBranch
                      have accepted :=
                        appendEntriesMessage_accepted_prefix_eq
                          (stateAt := ⟨responseStateAt⟩)
                          sendOccurrence
                          matching
                          minimumTerms
                          enabledBranch.2.1.1
                      have rolledPrefixEq :
                          logPrefix
                              ((conflictRollback
                                witness.before
                                receiveDest
                                (send.sendState.sentIndex
                                  receiveSource receiveDest)).log
                                receiveDest)
                              (send.sendState.sentIndex
                                receiveSource receiveDest) =
                            logPrefix
                              (send.sendState.log receiveSource)
                              (send.sendState.sentIndex
                                receiveSource receiveDest) := by
                        simpa [conflictRollback, logPrefix,
                          List.take_take] using accepted.2
                      have resultLogEq :=
                        appendEntriesMessage_result_log_eq
                          send.sendState
                          (conflictRollback
                            witness.before
                            receiveDest
                            (send.sendState.sentIndex
                              receiveSource receiveDest))
                          receiveSource
                          receiveDest
                          rolledPrefixEq
                      have producedIndexEq :
                          producedLastLogIndex =
                            ((next witness.before
                              (.receive
                                receiveDest
                                receiveSource
                                .appendEntriesConflictThenNoConflict)).log
                              receiveDest).length := by
                        simp [producedLastLogIndex, rolled, nextLog,
                          next, rawNext, nextReceive, hmessage,
                          send.message_eq, appendEntriesMessage,
                          nextAppendEntriesNoConflict, conflictRollback]
                      have afterLogEq :
                          (next witness.before
                              (.receive
                                receiveDest
                                receiveSource
                                .appendEntriesConflictThenNoConflict)).log
                              receiveDest =
                            (send.sendState.log receiveSource).take
                              (send.sendState.sentIndex
                                receiveSource receiveDest + 1) := by
                        simpa [next, rawNext, nextReceive, hmessage,
                          send.message_eq, appendEntriesMessage,
                          nextAppendEntriesNoConflict,
                          conflictRollback] using resultLogEq
                      simp only [AEResponseKind.receiveKind]
                      rw [producedIndexEq, afterLogEq]
                      simp [logPrefix, List.take_take])
              | _ =>
                exact False.elim
                  (impossibleUnchanged
                    (by simp [next, rawNext, nextReceive, hmessage,
                      hbody]))
          | handleAppendEntriesResponseSuccess =>
              cases hbody : request.body with
              | appendEntriesResponse requestSuccess requestLastLogIndex =>
                exact False.elim
                  (impossibleDiscard request
                    (by simp [next, rawNext, nextReceive, hmessage,
                      hbody]))
              | _ =>
                exact False.elim
                  (impossibleUnchanged
                    (by simp [next, rawNext, nextReceive, hmessage,
                      hbody]))
          | handleAppendEntriesResponseFailure =>
              cases hbody : request.body with
              | appendEntriesResponse requestSuccess requestLastLogIndex =>
                exact False.elim
                  (impossibleDiscard request
                    (by simp [next, rawNext, nextReceive, hmessage,
                      hbody]))
              | _ =>
                exact False.elim
                  (impossibleUnchanged
                    (by simp [next, rawNext, nextReceive, hmessage,
                      hbody]))
          | dropAppendEntriesResponseOutOfState =>
              exact False.elim
                (impossibleDiscard request
                (by simp [next, rawNext, nextReceive, hmessage]))
          | dropAppendEntriesResponseStale =>
              exact False.elim
                (impossibleDiscard request
                (by simp [next, rawNext, nextReceive, hmessage]))

private theorem choiceSupport_acknowledges_choiceIndexPrefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState choiceState : State}
    {owner choiceLeader member : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (support :
      ChoiceSupportWitness
        start actions state choiceState
        choiceLeader member certificate.choiceIndex
        certificate.choiceTerm)
    (choiceStateEq : choiceState = certificate.choiceState)
    (choiceLeaderEq : choiceLeader = certificate.choiceLeader) :
    Exists fun strongAck :
        SuccessfulAckSendPrefixWitness
          start
          support.choiceActions
          certificate.choiceState
          certificate.choiceLeader
          member
          support.matchWitness.response
          support.matchWitness.lastLogIndex =>
      isLogPrefix
        certificate.choiceIndexPrefix
        ((next
          strongAck.ack.origin.responseState
          (.receive
            member
            certificate.choiceLeader
            strongAck.ack.origin.kind.receiveKind)).log member) := by
  subst choiceState
  subst choiceLeader
  rcases support.choice_actions_prefix with
    ⟨choiceFutureActions, choiceActionsEq⟩
  have fullHistory := history
  rw [← choiceActionsEq] at fullHistory
  rcases replays_append_split fullHistory with
    ⟨middleState, choiceReplay, remainingReplay⟩
  have choiceStateEq :
      certificate.choiceState = middleState :=
    replays_deterministic support.choice_history choiceReplay
  let choiceAt :
      StateAtWitness
        start actions state certificate.choiceState :=
    {
      pastActions := support.choiceActions
      futureActions := choiceFutureActions
      actions_eq := choiceActionsEq.symm
      stateHistory := support.choice_history
      remainingHistory := by
        simpa only [choiceStateEq] using remainingReplay
    }
  rcases
      occurs_before_stateAt support.matchWitness.handle_occurrence with
    ⟨handledStateAtChoice⟩
  have matchingAtHandled :
      TemporalLogMatchingInv
        start handledStateAtChoice.pastActions
        support.matchWitness.handledState := by
    intro first second firstAt secondAt
    exact
      matching
        first
        second
        (stateAt_extend_stateAtWitness choiceAt
          (stateAt_extend_stateAtWitness handledStateAtChoice firstAt))
        (stateAt_extend_stateAtWitness choiceAt
          (stateAt_extend_stateAtWitness handledStateAtChoice secondAt))
  have responseQueued :
      support.matchWitness.response ∈
        support.matchWitness.handledState.messages
          certificate.choiceLeader member :=
    headMessage?_mem
      support.matchWitness.handledState
      certificate.choiceLeader
      member
      support.matchWitness.response
      support.matchWitness.response_head
  rcases
      queueHistory_implies_SuccessfulAckSendPrefixConsistent
          matchingAtHandled
          (protocolHistory_implies_QueueHistoryConsistent
            handledStateAtChoice.stateHistory)
          certificate.choiceLeader
          member
          support.matchWitness.response
          support.matchWitness.lastLogIndex
          responseQueued
          support.matchWitness.ack.response_body with
    ⟨strongAck⟩
  let extendedOrigin :
      AEResponseWitness
        start support.choiceActions certificate.choiceState
        certificate.choiceLeader member support.matchWitness.response :=
    {
      strongAck.ack.origin with
      occurrence :=
        occurs_extend_stateAtWitness
          handledStateAtChoice strongAck.ack.origin.occurrence
    }
  let extendedAck :
      AckWitness
        start support.choiceActions certificate.choiceState
        certificate.choiceLeader member support.matchWitness.response
        support.matchWitness.lastLogIndex :=
    {
      strongAck.ack with
      origin := extendedOrigin
    }
  let strongAckAtChoice :
      SuccessfulAckSendPrefixWitness
        start support.choiceActions certificate.choiceState
        certificate.choiceLeader member support.matchWitness.response
        support.matchWitness.lastLogIndex :=
    {
      strongAck with
      ack := extendedAck
      send_occurrence :=
        occurs_extend_stateAtWitness
          handledStateAtChoice strongAck.send_occurrence
    }
  have sendToChoice :
      isLogPrefix
        (strongAckAtChoice.sendState.log certificate.choiceLeader)
        (certificate.choiceState.log certificate.choiceLeader) :=
    (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
      support.choice_history)
      strongAckAtChoice.sendState
      (by
        exact occurs_before_stateAt strongAckAtChoice.send_occurrence)
      certificate.choiceLeader
      strongAckAtChoice.send_leader
      certificate.choice_leader
      (strongAckAtChoice.send_term.trans
        (support.response_term.trans certificate.choice_term.symm))
  have sendBound :
      support.matchWitness.lastLogIndex <=
        (strongAckAtChoice.sendState.log certificate.choiceLeader).length := by
    have lengthEq := congrArg List.length strongAckAtChoice.prefix_eq
    simp [logPrefix, List.length_take,
      Nat.min_eq_left strongAckAtChoice.ack.index_bounded] at lengthEq
    omega
  have choiceBound :
      support.matchWitness.lastLogIndex <=
        (certificate.choiceState.log certificate.choiceLeader).length :=
    Nat.le_trans sendBound sendToChoice.length_le
  have sendPrefixEq :
      logPrefix
          (strongAckAtChoice.sendState.log certificate.choiceLeader)
          support.matchWitness.lastLogIndex =
        logPrefix
          (certificate.choiceState.log certificate.choiceLeader)
          support.matchWitness.lastLogIndex :=
    logPrefix_eq_of_prefixes
      (strongAckAtChoice.sendState.log certificate.choiceLeader)
      (certificate.choiceState.log certificate.choiceLeader)
      (certificate.choiceState.log certificate.choiceLeader)
      support.matchWitness.lastLogIndex
      sendToChoice
      List.prefix_rfl
      sendBound
      choiceBound
  exact
    ⟨strongAckAtChoice, by
      have choiceIndexToAckPrefix :
          isLogPrefix
            certificate.choiceIndexPrefix
            (logPrefix
              ((next
                strongAckAtChoice.ack.origin.responseState
                (.receive
                  member
                  certificate.choiceLeader
                  strongAckAtChoice.ack.origin.kind.receiveKind)).log member)
              support.matchWitness.lastLogIndex) := by
        rw [certificate.choice_index_prefix_eq,
          strongAckAtChoice.prefix_eq,
          sendPrefixEq]
        exact
          logPrefix_mono_isLogPrefix
            (certificate.choiceState.log certificate.choiceLeader)
            certificate.choiceIndex
            support.matchWitness.lastLogIndex
            support.index_le_ack
      exact
        choiceIndexToAckPrefix.trans
          (logPrefix_isLogPrefix
            ((next
              strongAckAtChoice.ack.origin.responseState
              (.receive
                member
                certificate.choiceLeader
                strongAckAtChoice.ack.origin.kind.receiveKind)).log member)
            support.matchWitness.lastLogIndex)⟩

private noncomputable def choiceSupport_choiceState_stateAt
    {start : InitialConfiguration}
    {actions : List Action}
    {state choiceState : State}
    {choiceLeader member : Node}
    {choiceIndex choiceTerm : Nat}
    (history : ProtocolHistory start actions state)
    (support :
      ChoiceSupportWitness
        start actions state choiceState
        choiceLeader member choiceIndex choiceTerm) :
    StateAtWitness start actions state choiceState := by
  classical
  let choiceFutureActions :=
    support.choice_actions_prefix.choose
  have choiceActionsEq :=
    support.choice_actions_prefix.choose_spec
  have fullHistory := history
  rw [← choiceActionsEq] at fullHistory
  have split := replays_append_split fullHistory
  let middleState := split.choose
  have splitFacts := split.choose_spec
  have choiceReplay := splitFacts.1
  have remainingReplay := splitFacts.2
  have choiceStateEq : choiceState = middleState :=
    replays_deterministic support.choice_history choiceReplay
  exact {
    pastActions := support.choiceActions
    futureActions := choiceFutureActions
    actions_eq := choiceActionsEq.symm
    stateHistory := support.choice_history
    remainingHistory := by
      simpa only [choiceStateEq] using remainingReplay
  }

private theorem choiceSupport_voteGrant_carries_choiceIndexPrefix_at_term
    {start : InitialConfiguration}
    {actions : List Action}
    {state boundaryState grantState : State}
    {owner member candidate : Node}
    {index candidateTerm : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (certificate :
      ChosenCommitCertificate
        start actions state boundaryState owner index)
    (support :
      ChoiceSupportWitness
        start actions state certificate.choiceState
        certificate.choiceLeader member certificate.choiceIndex
        certificate.choiceTerm)
    (grant :
      Occurs
        start actions state grantState
        (.receive member candidate .handleRequestVoteRequest))
    (grantTerm :
      grantState.currentTerm member = candidateTerm)
    (higherTerm :
      certificate.choiceTerm < candidateTerm) :
    isLogPrefix
      certificate.choiceIndexPrefix
      (grantState.log member) := by
  rcases
      choiceSupport_acknowledges_choiceIndexPrefix
        history matching certificate support rfl rfl with
    ⟨strongAck, acknowledged⟩
  rcases
      chosenCommitCertificate_choiceIndex_certificate
        history core certificate with
    ⟨choiceCertificate⟩
  let choiceAt :=
    choiceSupport_choiceState_stateAt history support
  rcases
      occurs_extend_stateAtWitness
        choiceAt strongAck.ack.origin.occurrence with
    ⟨ack⟩
  rcases grant with ⟨grantOccurrence⟩
  have retained :
      isLogPrefix
        choiceCertificate.certificate.chosenPrefix
        (grantState.log member) :=
    chosenCommitCertificate_prefix_retained_to_higher_term_vote
      leaderUniqueness
      choiceCertificate.certificate
      choiceCertificate.boundary
      ack
      grantOccurrence
      (strongAck.ack.response_term.symm.trans support.response_term)
      choiceCertificate.choice_term_le
      grantTerm
      higherTerm
      (by
        rw [choiceCertificate.prefix_eq]
        exact acknowledged)
  rw [choiceCertificate.prefix_eq] at retained
  exact retained

