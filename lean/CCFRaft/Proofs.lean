private theorem quorumFormation_candidateWitness_before
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {candidate : Node}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (formation :
      QuorumCandidateFormationAction state action candidate)
    (enabled : Enabled state action)
    (afterCandidate :
      (next state action).leadershipState candidate = .candidate) :
    Nonempty
      (CandidateFormationChosenConfigurationWitness
        start actions state action candidate) := by
  rcases formation with
    ⟨timedOut, actionEq, candidateEq⟩ |
      ⟨source, response, actionEq, responseHead, responseBody⟩
  · subst action
    subst candidate
    have enabledFacts := enabled
    simp [Enabled, actionEnabled, candidateEligible] at enabledFacts
    have basis : CandidateElectionBasis state timedOut := by
      rcases enabledFacts.1.2.2 with
        normalConfiguration | retirementCompleted
      · right
        exact normalConfiguration
      · left
        exact
          (protocolHistory_implies_RetirementCompletedCommitPositiveInv
            history)
            timedOut timedOut retirementCompleted
    rcases
        candidateChosenConfigurationWitness_of_candidateElectionBasis
          history core timedOut basis with
      ⟨basisWitness⟩
    exact
      ⟨{
        basis := basisWitness
        choice_term_lt_candidate := by
          simpa [next, rawNext, nextTimeout] using
            Nat.lt_succ_of_le
              basisWitness.choice_term_le_candidate
      }⟩
  · subst action
    have oldCandidate :
        state.leadershipState candidate = .candidate :=
      candidate_before_of_candidate_after
        state
        (.receive candidate source .handleRequestVoteResponse)
        candidate
        afterCandidate
        (by intro timedOut; simp)
    rcases
        protocolHistory_implies_currentCandidateChosenConfigurationWitness_preappend
          history core oldCandidate with
      ⟨currentWitness⟩
    exact
      ⟨{
        basis := currentWitness.basis
        choice_term_lt_candidate := by
          simpa [next, rawNext, nextReceive, responseHead,
            responseBody] using
              currentWitness.choice_term_lt_candidate
      }⟩

