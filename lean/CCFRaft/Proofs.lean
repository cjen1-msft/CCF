        activeConfiguration
        candidateConfigurationActive
  apply
    quorumReadyCandidate_carries_chosenPrefix
      candidateWitness
      target
      targetEarlier
      activeConfiguration
      candidateConfigurationActive
      (votersForCandidateTerm state candidate)
      quorumAtConfiguration
      configurationActiveAtChoice
      configurationWithinChoice
  intro voter voterMember voterIsNotCandidate voterSupport
  have voterFacts :
      state.currentTerm voter = state.currentTerm candidate ∧
        state.votedFor voter = some candidate := by
    have facts := voterMember
    simp [votersForCandidateTerm] at facts
    exact facts.2
  have votedForLogs :=
    protocolHistory_implies_VotedForLogHistoryConsistent history
  rcases
      votedForLogs
        voter candidate voterFacts.2 voterIsNotCandidate with
    ⟨vote⟩
  have requestBody :
      vote.request.body =
        .requestVoteRequest
          vote.responseOrigin.lastTerm
          vote.responseOrigin.lastIndex
          false := by
    have sentBody := congrArg Message.body vote.send.message_eq
    have sentFacts := sentBody.symm
    simp [requestVoteMessage, vote.request_eq,
      vote.responseOrigin.request_body] at sentFacts
    rw [vote.request_eq]
    simpa [sentFacts.2.2] using
      vote.responseOrigin.request_body
  have carriesAtSend :=
    requestVoteLogOK_carries_chosenPrefix_with_term
      history
      core.electionLogs.counted.logs.monoLogs
      core.electionLogs.counted.logs.logMatching
      (completeSafetyCore_implies_leaderUniqueness history core)
      target
      targetBoundary
      (occurs_before_stateAt vote.responseOrigin.occurrence)
      vote.send
      requestBody
      vote.log_ok
      (supportReflectedToGrant
        voter voterMember voterIsNotCandidate vote voterSupport)
  exact carriesAtSend.1.trans
    (candidateLogRetained
      voter voterMember voterIsNotCandidate vote)

