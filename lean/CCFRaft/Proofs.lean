    (candidateLogRetained :
      forall voter : Node,
        voter ∈ votersForCandidateTerm state candidate ->
          voter ≠ candidate ->
            forall vote :
                VotedForLogWitness
                  start actions state voter candidate,
              isLogPrefix
                (vote.send.sendState.log candidate)
                (state.log candidate)) :
    isLogPrefix
      target.chosenPrefix
      (state.log candidate) := by
  have quorumAtConfiguration :
      isQuorum
          (votersForCandidateTerm state candidate ∩
            activeConfiguration.nodes)
