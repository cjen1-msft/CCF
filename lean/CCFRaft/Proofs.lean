  simp [Enabled, actionEnabled] at sendFacts
  have sendCandidate :
      vote.send.sendState.leadershipState candidate = .candidate :=
    sendFacts.1.2
  have sendToCandidate :
      Replays
        vote.send.sendState
        (.requestVote candidate voter ::
          sendOccurrence.futureActions)
        candidateState :=
    ⟨sendOccurrence.enabled, sendOccurrence.after_history⟩
  have sendLogEq :=
    replays_candidate_sameTerm_log_eq
      sendToCandidate
      candidate
      sendCandidate
      candidateRole
      sendCandidateTerm.symm
  simpa [sendLogEq] using carriesAtSend.1

private theorem historicalCompleteSafetyCore_potentialCandidateFresh
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    {candidate : Node}
    (candidateState :
      state.leadershipState candidate = .candidate)
    (candidateQuorum :
      PotentialCandidateQuorum state candidate) :
    forall historicalState,
      StateAt start actions state historicalState ->
        forall node : Node,
          forall entry,
            entry ∈ historicalState.log node ->
              entry.term != state.currentTerm candidate := by
  intro historicalState stateAt node entry member
  by_cases sameTerm : entry.term = state.currentTerm candidate
  · have candidateAfterStart :=
      reachable_CandidateTermStrictAfterStart
        start
        (protocolHistory_reachable history)
        candidate
        candidateState
    have entryAfterStart : startTerm < entry.term := by
      simpa [sameTerm] using candidateAfterStart
    rcases
        protocolHistory_implies_HistoricalEntryTermLeaderOriginInv
          history historicalState stateAt node entry member
          entryAfterStart with
      ⟨entryOrigin⟩
    rcases occurs_before_stateAt entryOrigin.occurrence with
      ⟨appendTrace⟩
    rcases
        protocolHistory_implies_LeaderHistoryConsistent
          appendTrace.stateHistory
          entryOrigin.leader
          entryOrigin.leader_state with
      ⟨leaderOrigin⟩
    cases leaderOrigin with
    | initial _leaderEq initialTerm =>
        have entryIsStart : entry.term = startTerm :=
          entryOrigin.term_eq.symm.trans initialTerm
        exact False.elim
          ((Nat.ne_of_lt candidateAfterStart)
            (entryIsStart.symm.trans sameTerm))
    | elected election =>
        have extendedElection :=
          occurs_extend_stateAtWitness
            appendTrace election.occurrence
        have electionEnabled :
            Enabled
              election.electionState
              (.becomeLeader entryOrigin.leader) := by
          rcases election.occurrence with ⟨occurrence⟩
          exact occurrence.enabled
        have electionEnabledFacts := electionEnabled
        simp [Enabled, actionEnabled] at electionEnabledFacts
        have electionTermEq :
            election.electionState.currentTerm entryOrigin.leader =
              state.currentTerm candidate :=
          election.term_eq.symm.trans
            (entryOrigin.term_eq.trans sameTerm)
        rcases
            core.electionLogs.potentialOverlap
              election.electionState
              state
              (occurs_before_stateAt extendedElection)
              (protocolHistory_final_stateAt history)
              entryOrigin.leader
              candidate
              electionEnabledFacts.1.2
              electionEnabledFacts.2
              candidateState
              candidateQuorum
              electionTermEq with
          ⟨electionConfiguration, potentialConfiguration,
            electionConfigurationMember,
            potentialConfigurationMember,
            sameConfigurationNodes⟩
        have electionQuorum :=
          becomeLeader_enabled_configuration_quorum
            election.electionState
            entryOrigin.leader
            electionConfiguration
            electionEnabled
            electionConfigurationMember
        have potentialQuorumForConfiguration :
            isQuorum
                (votersForCandidateTerm state candidate ∩
                  potentialConfiguration.nodes)
                potentialConfiguration.nodes =
              true := by
          have allQuorums := candidateQuorum
          simp [PotentialCandidateQuorum, allConfigurationsHaveQuorum]
            at allQuorums
          exact
            allQuorums
              potentialConfiguration potentialConfigurationMember
        have potentialQuorumOnElectionConfiguration :
            isQuorum
                (votersForCandidateTerm state candidate ∩
                  electionConfiguration.nodes)
                electionConfiguration.nodes =
              true := by
          rw [sameConfigurationNodes]
          exact potentialQuorumForConfiguration
        rcases
            isQuorum_intersects
              (election.electionState.votesGranted
                entryOrigin.leader ∩ electionConfiguration.nodes)
              (votersForCandidateTerm state candidate ∩
                electionConfiguration.nodes)
              electionConfiguration.nodes
              electionQuorum
              potentialQuorumOnElectionConfiguration with
          ⟨voter, electionMembership, potentialMembership⟩
        simp only [Finset.mem_inter] at electionMembership potentialMembership
        have votes :=
          protocolHistory_implies_HistoricalElectionVoteCore history
        have electionOwner :=
          votes.electionVotes
            election.electionState
            entryOrigin.leader
            extendedElection
            voter
            electionMembership.1
        have potentialVote := potentialMembership.1
        simp [votersForCandidateTerm] at potentialVote
        have potentialOwner :
            votes.owner voter (state.currentTerm candidate) =
              some candidate := by
          calc
            votes.owner voter (state.currentTerm candidate) =
                votes.owner voter (state.currentTerm voter) := by
              rw [potentialVote.2.1]
            _ = state.votedFor voter :=
              votes.ownerConsistent.currentChoice voter
            _ = some candidate := potentialVote.2.2
        rw [electionTermEq] at electionOwner
        have leaderEq : entryOrigin.leader = candidate :=
          Option.some.inj
            (electionOwner.symm.trans potentialOwner)
        subst candidate
        have strictGrowth :=
          protocolHistory_implies_HistoricalLeaderToCurrentCandidateTermInv
            history
            entryOrigin.appendState
            (occurs_before_stateAt entryOrigin.occurrence)
            entryOrigin.leader
            entryOrigin.leader_state
            candidateState
        exact False.elim
          ((Nat.ne_of_lt strictGrowth)
            (entryOrigin.term_eq.trans sameTerm))
  · simpa using bne_iff_ne.mpr sameTerm

private theorem successfulPotentialVote_term_facts
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {candidate voter : Node}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (candidateRole :
      state.leadershipState candidate = .candidate)
    (candidateQuorum :
      PotentialCandidateQuorum state candidate)
    (potentialVote :
      voter ∈ votersForCandidateTerm state candidate)
    (successfulVote :
      SuccessfulVotedForLogWitness
        start actions state voter candidate) :
    And
      (successfulVote.vote.send.sendState.currentTerm candidate =
        state.currentTerm candidate)
      (successfulVote.vote.responseOrigin.lastTerm <
        state.currentTerm candidate) := by
  let vote := successfulVote.vote
  have voterFacts :
      state.currentTerm voter = state.currentTerm candidate ∧
        state.votedFor voter = some candidate := by
    have facts := potentialVote
    simp [votersForCandidateTerm] at facts
    exact facts.2
  have responseTerm :
      vote.response.term =
        vote.responseOrigin.responseState.currentTerm voter := by
    simpa using
      congrArg Message.term vote.responseOrigin.response_eq
  have sentTerm := congrArg Message.term vote.send.message_eq
  have requestTerm :
      vote.responseOrigin.request.term =
        vote.send.sendState.currentTerm candidate := by
    simpa [requestVoteMessage, vote.request_eq] using sentTerm
  have grantFacts := successfulVote.granted
  simp [requestVoteGranted] at grantFacts
  have sendCandidateTerm :
      vote.send.sendState.currentTerm candidate =
        state.currentTerm candidate := by
    rw [← requestTerm]
    exact
      grantFacts.1.1.trans
        (responseTerm.symm.trans
          (vote.voter_term_eq.symm.trans voterFacts.1))
  have requestBody :
      vote.request.body =
        .requestVoteRequest
          vote.responseOrigin.lastTerm
          vote.responseOrigin.lastIndex
          false := by
    have sentBody := congrArg Message.body vote.send.message_eq
    have sentFacts := sentBody.symm
    simp [requestVoteMessage, vote.request_eq,
      vote.responseOrigin.request_body] at sentFacts
    rw [vote.request_eq]
    simpa [sentFacts.2.2] using vote.responseOrigin.request_body
  have requestFacts :
      vote.responseOrigin.lastTerm =
          lastCommittableTerm vote.send.sendState candidate ∧
        vote.responseOrigin.lastIndex =
          lastCommittableIndex vote.send.sendState candidate := by
    simpa [requestVoteMessage, requestBody] using
      congrArg Message.body vote.send.message_eq
  have signaturesAtSend :=
    reachable_SignatureInv
      start
      (stateAt_reachable
        (occurs_before_stateAt vote.send.occurrence))
  refine ⟨sendCandidateTerm, ?_⟩
  rcases
      lastCommittableIndex_signature_or_zero
        vote.send.sendState candidate signaturesAtSend with
    lastZero | ⟨entry, entryAt, entrySignature⟩
  · have lastTermZero :
        vote.responseOrigin.lastTerm = 0 := by
      rw [requestFacts.1, lastCommittableTerm, lastZero]
      simp [entryAt?]
    rw [lastTermZero]
    exact
      Nat.zero_lt_of_lt
        (reachable_CandidateTermStrictAfterStart
          start
          (protocolHistory_reachable history)
          candidate
          candidateRole)
  · have lastIndexEq :
        vote.responseOrigin.lastIndex =
          lastCommittableIndex vote.send.sendState candidate :=
      requestFacts.2
    have entryAtLast :
        entryAt?
            (vote.send.sendState.log candidate)
            vote.responseOrigin.lastIndex =
          some entry := by
      rw [lastIndexEq]
      exact entryAt
    have entryTerm :
        entry.term = vote.responseOrigin.lastTerm := by
      rw [requestFacts.1, lastCommittableTerm,
        ← lastIndexEq, entryAtLast]
    have entryMember :=
      entryAt?_mem
        (vote.send.sendState.log candidate)
        vote.responseOrigin.lastIndex
        entry
        entryAtLast
    have notEqual :=
      historicalCompleteSafetyCore_potentialCandidateFresh
        history
        core
        candidateRole
        candidateQuorum
        vote.send.sendState
        (occurs_before_stateAt vote.send.occurrence)
        candidate
        entry
        entryMember
    have termLe :=
      logEntryTerm_le_currentTerm
        vote.send.sendState
        (core.electionLogs.counted.logs.monoLogs
          vote.send.sendState
          (occurs_before_stateAt vote.send.occurrence))
        candidate
        vote.responseOrigin.lastIndex
        entry
        entryAtLast
    have lastTermLe :
        vote.responseOrigin.lastTerm <= state.currentTerm candidate := by
      calc
        vote.responseOrigin.lastTerm = entry.term := entryTerm.symm
        _ <= vote.send.sendState.currentTerm candidate := termLe
        _ = state.currentTerm candidate := sendCandidateTerm
    have termNe :
        vote.responseOrigin.lastTerm ≠ state.currentTerm candidate :=
      fun termEq =>
        (bne_iff_ne.mp notEqual)
          (entryTerm.trans termEq)
    exact lt_of_le_of_ne lastTermLe termNe

private theorem advanceCommitIndex_successfulPotentialSupport_transfers
    {start : InitialConfiguration}
    {actions : List Action}
    {state candidateState : State}
    {leader candidate voter : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (higherTermLeaders :
      forall leaderState,
        StateAt start actions state leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <
                    candidateState.currentTerm candidate ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (leaderState.log historicalLeader))
    (candidateEndpoint :
      StateAtWitness start actions state candidateState)
    (choicePrefixEarlierTermLeaders :
      forall leaderState,
        StateAt
            start
            candidateEndpoint.pastActions
            candidateState
            leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <=
                    candidateState.currentTerm candidate ->
                  isLogPrefix
                    (logPrefix
                      (state.log leader)
                      (highestCommittableIndex state leader))
                    (leaderState.log historicalLeader))
    (candidateRole :
      candidateState.leadershipState candidate = .candidate)
    (higherTerm :
      state.currentTerm leader <
        candidateState.currentTerm candidate)
    (candidateQuorum :
      PotentialCandidateQuorum candidateState candidate)
    (potentialVote :
      voter ∈ votersForCandidateTerm candidateState candidate)
    (choiceSupport :
      AdvanceCommitPendingChoiceSupport
        start actions state leader voter)
    (successfulVote :
      SuccessfulVotedForLogWitness
        start
        candidateEndpoint.pastActions
        candidateState
        voter
        candidate) :
    isLogPrefix
      (logPrefix (state.log leader) index)
      (candidateState.log candidate) := by
  let vote := successfulVote.vote
  rcases
      occurs_before_stateAt vote.responseOrigin.occurrence with
    ⟨grantLocalEndpoint⟩
  let grantEndpoint :
      StateAtWitness
        start actions state
        vote.responseOrigin.responseState :=
    {
      pastActions := grantLocalEndpoint.pastActions
      futureActions :=
        grantLocalEndpoint.futureActions ++
          candidateEndpoint.futureActions
      actions_eq := by
        calc
          actions =
              candidateEndpoint.pastActions ++
                candidateEndpoint.futureActions :=
            candidateEndpoint.actions_eq
          _ =
              (grantLocalEndpoint.pastActions ++
                  grantLocalEndpoint.futureActions) ++
                candidateEndpoint.futureActions := by
            exact
              congrArg
                (fun xs => xs ++ candidateEndpoint.futureActions)
                grantLocalEndpoint.actions_eq
          _ =
              grantLocalEndpoint.pastActions ++
                (grantLocalEndpoint.futureActions ++
                  candidateEndpoint.futureActions) := by
            simp only [List.append_assoc]
      stateHistory := grantLocalEndpoint.stateHistory
      remainingHistory :=
        replays_append
          grantLocalEndpoint.remainingHistory
          candidateEndpoint.remainingHistory
    }
  have voterFacts :
      candidateState.currentTerm voter =
          candidateState.currentTerm candidate ∧
        candidateState.votedFor voter = some candidate := by
    have facts := potentialVote
    simp [votersForCandidateTerm] at facts
    exact facts.2
  have responseTerm :
      vote.response.term =
        vote.responseOrigin.responseState.currentTerm voter := by
    simpa using
      congrArg Message.term vote.responseOrigin.response_eq
  have grantHigher :
      state.currentTerm leader <
        vote.responseOrigin.responseState.currentTerm voter := by
    rw [← responseTerm, ← vote.voter_term_eq, voterFacts.1]
    exact higherTerm
  have grantCarries :=
    advanceCommitIndex_choiceSupport_retained_at_higherTerm_state
      history
      core
      enabled
      (advanceCommitIndex_highest_boundary enabled)
      (Nat.le_refl _)
      choiceSupport
      grantEndpoint
      grantHigher
      (by
        intro leaderState leaderAt historicalLeader
          leaderRole term upper
        have upperAtCandidate :
            leaderState.currentTerm historicalLeader <=
              candidateState.currentTerm candidate :=
          upper.trans_eq
            (responseTerm.symm.trans
              (vote.voter_term_eq.symm.trans voterFacts.1))
        exact
          choicePrefixEarlierTermLeaders
            leaderState
            (stateAt_extend_stateAtWitness
              grantLocalEndpoint leaderAt)
            historicalLeader
            leaderRole
            term
            upperAtCandidate)
  have localCore :=
    historicalCompleteSafetyCore_prefixes
      history
      core
      ⟨candidateEndpoint.futureActions,
        candidateEndpoint.actions_eq.symm⟩
      candidateEndpoint.stateHistory
  rcases
      successfulPotentialVote_term_facts
        candidateEndpoint.stateHistory
        localCore
        candidateRole
        candidateQuorum
        potentialVote
        successfulVote with
    ⟨sendCandidateTerm, lastTermBeforeCandidate⟩
  exact
    advanceCommitIndex_potentialVote_carries_boundary
      history
      core
      enabled
      boundary
      indexWithin
      higherTermLeaders
      candidateEndpoint
      candidateRole
      vote
      potentialVote
      sendCandidateTerm
      lastTermBeforeCandidate
      grantCarries

theorem advanceCommitIndex_potentialCandidate_carries_boundary
    {start : InitialConfiguration}
    {actions : List Action}
    {state candidateState : State}
    {leader candidate : Node}
    {index : Nat}
    (history : ProtocolHistory start actions state)
    (core : HistoricalCompleteSafetyCore start actions state)
    (enabled : Enabled state (.advanceCommitIndex leader))
    (boundary :
      SignatureCommitBoundary
        (next state (.advanceCommitIndex leader))
        leader
        index)
    (commitBefore : state.commitIndex leader < index)
    (indexWithin :
      index <= highestCommittableIndex state leader)
    (candidateEndpoint :
      StateAtWitness start actions state candidateState)
    (higherTermLeaders :
      forall leaderState,
        StateAt start actions state leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <
                    candidateState.currentTerm candidate ->
                  isLogPrefix
                    (logPrefix (state.log leader) index)
                    (leaderState.log historicalLeader))
    (choicePrefixEarlierTermLeaders :
      forall leaderState,
        StateAt
            start
            candidateEndpoint.pastActions
            candidateState
            leaderState ->
          forall historicalLeader : Node,
            leaderState.leadershipState historicalLeader = .leader ->
              state.currentTerm leader <
                  leaderState.currentTerm historicalLeader ->
                leaderState.currentTerm historicalLeader <=
                    candidateState.currentTerm candidate ->
                  isLogPrefix
                    (logPrefix
                      (state.log leader)
                      (highestCommittableIndex state leader))
                    (leaderState.log historicalLeader))
    (candidateRole :
      candidateState.leadershipState candidate = .candidate)
    (higherTerm :
      state.currentTerm leader <
        candidateState.currentTerm candidate)
    (candidateQuorum :
      PotentialCandidateQuorum candidateState candidate) :
    isLogPrefix
      (logPrefix (state.log leader) index)
      (candidateState.log candidate) := by
  rcases
      historicalCompleteSafetyCore_candidateWitness
        history core candidateEndpoint candidate candidateRole with
    ⟨candidateWitness⟩
  have previousCarries :
      forall previous :
          ChosenCommitCertificate
            start actions state state leader (state.commitIndex leader),
        SignatureCommitBoundary state leader (state.commitIndex leader) ->
          previous.choiceTerm <
              candidateState.currentTerm candidate ->
            isLogPrefix
              previous.chosenPrefix
              (candidateState.log candidate) := by
    intro previous _previousBoundary previousEarlier
    exact
      previous.potential_candidate_barrier
        candidateState
        ⟨candidateEndpoint⟩
        candidate
        candidateRole
        previousEarlier
        candidateQuorum
  rcases
      advanceCommitIndex_candidate_commonConfiguration_or_carries
        history
        core
        enabled
        commitBefore
        indexWithin
        candidateEndpoint
        higherTermLeaders
        higherTerm
        candidateWitness
        previousCarries with
    carries | ⟨configuration, candidateConfiguration,
      choiceConfiguration, configurationWithin⟩
  · exact carries
  · have candidateQuorumAtConfiguration :
        isQuorum
            (votersForCandidateTerm candidateState candidate ∩
              configuration.nodes)
            configuration.nodes =
          true := by
      have allQuorums := candidateQuorum
      simp [PotentialCandidateQuorum, allConfigurationsHaveQuorum]
        at allQuorums
      exact allQuorums configuration candidateConfiguration
    rcases
        advanceCommitIndex_pending_watermark_causal_support
          history
          enabled
          configuration
          choiceConfiguration
          configurationWithin with
      ⟨supportQuorum, supportQuorumOk, support⟩
    rcases
        isQuorum_intersects
          supportQuorum
          (votersForCandidateTerm candidateState candidate ∩
            configuration.nodes)
          configuration.nodes
          supportQuorumOk
          candidateQuorumAtConfiguration with
      ⟨voter, voterSupport, voterCandidate⟩
    have potentialVote :
        voter ∈ votersForCandidateTerm candidateState candidate :=
      (Finset.mem_inter.mp voterCandidate).1
    have voterFacts :
        candidateState.currentTerm voter =
            candidateState.currentTerm candidate ∧
          candidateState.votedFor voter = some candidate := by
      have facts := potentialVote
      simp [votersForCandidateTerm] at facts
      exact facts.2
    rcases support voter voterSupport with
      voterIsLeader | choiceSupport
    · subst voter
      have leaderTermMonotonic :=
        replays_currentTerm_mono
          candidateEndpoint.remainingHistory
          leader
      omega
    · rcases choiceSupport with ⟨choiceSupport⟩
      by_cases voterIsCandidate : voter = candidate
      · subst voter
        exact
          advanceCommitIndex_choiceSupport_retained_at_higherTerm_state
            history
            core
            enabled
            boundary
            indexWithin
            choiceSupport
            candidateEndpoint
            higherTerm
            (by
              intro leaderState leaderAt historicalLeader
                leaderRole term upper
              exact
                (logPrefix_mono_isLogPrefix
                  (state.log leader)
                  index
                  (highestCommittableIndex state leader)
                  indexWithin).trans
                  (choicePrefixEarlierTermLeaders
                    leaderState leaderAt historicalLeader
                    leaderRole term upper))
      · rcases
            protocolHistory_implies_successfulVotedForLogHistory
              candidateEndpoint.stateHistory
              voter
              candidate
              voterFacts.2
              voterIsCandidate with
          ⟨successfulVote⟩
        exact
          advanceCommitIndex_successfulPotentialSupport_transfers
            history core enabled boundary indexWithin
            higherTermLeaders candidateEndpoint
            choicePrefixEarlierTermLeaders
            candidateRole higherTerm candidateQuorum potentialVote
            choiceSupport successfulVote

