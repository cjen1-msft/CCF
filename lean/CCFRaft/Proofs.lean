    have shortened :=
      congrArg
        (List.take (sendState.sentIndex leader follower + 1))
        oldPrefixFacts.2.2
    simpa [logPrefix, List.take_take,
      Nat.min_eq_left nextWithinMatch] using shortened.symm
  rcases sendPrefix with ⟨sendSuffix, sendLogEq⟩
  have leaderSenderPrefix :
      logPrefix
          (state.log leader)
          (sendState.sentIndex leader follower + 1) =
        logPrefix
          (sendState.log leader)
          (sendState.sentIndex leader follower + 1) := by
    rw [← sendLogEq]
    exact
      logPrefix_append_eq_of_index_le_length
        (sendState.log leader)
        sendSuffix
        (sendState.sentIndex leader follower + 1)
        (by omega)
  have conflictFalse :=
    appendEntriesConflictGuard_false_of_prefix_eq
      state
      follower
      (sendState.log leader)
      (sendState.sentIndex leader follower)
      (sendState.sentIndex leader follower + 1)
      (by omega)
      (by omega)
      (by omega)
      (followerLeaderPrefix.trans leaderSenderPrefix)
