    simp [increasingConfigurationIndices, configurationsBoundedBy,
      initialState, startLog, h]
  · simp [increasingConfigurationIndices, configurationsBoundedBy,
      initialState, startLog, h]

theorem initial_ConfigurationsExactInv (start : InitialConfiguration) :
