theorem stateAt_history_order
    {start : InitialConfiguration}
    {actions : List Action}
    {endState firstState secondState : State}
    (firstAt : StateAt start actions endState firstState)
    (secondAt : StateAt start actions endState secondState) :
    Or
      (Exists fun priorActions =>
        And
          (ProtocolHistory start priorActions secondState)
          (StateAt start priorActions secondState firstState))
      (Exists fun priorActions =>
        And
          (ProtocolHistory start priorActions firstState)
          (StateAt start priorActions firstState secondState)) := by
  rcases firstAt with ⟨firstWitness⟩
  rcases secondAt with ⟨secondWitness⟩
  have firstPrefix :
      firstWitness.pastActions <+: actions :=
    ⟨firstWitness.futureActions, firstWitness.actions_eq.symm⟩
  have secondPrefix :
      secondWitness.pastActions <+: actions :=
    ⟨secondWitness.futureActions, secondWitness.actions_eq.symm⟩
  rcases
      List.prefix_or_prefix_of_prefix firstPrefix secondPrefix with
    firstBeforeSecond | secondBeforeFirst
  · rcases firstBeforeSecond with
      ⟨middleActions, pastActionsEq⟩
    have secondHistory := secondWitness.stateHistory
    rw [← pastActionsEq] at secondHistory
    rcases replays_append_split secondHistory with
      ⟨middleState, firstReplay, remainingReplay⟩
    have stateEq : firstState = middleState :=
      replays_deterministic
        firstWitness.stateHistory
        firstReplay
    left
    refine
      ⟨secondWitness.pastActions,
        secondWitness.stateHistory,
        ?_⟩
    exact ⟨{
      pastActions := firstWitness.pastActions
      futureActions := middleActions
      actions_eq := pastActionsEq.symm
      stateHistory := firstWitness.stateHistory
      remainingHistory := by
        simpa only [stateEq] using remainingReplay
    }⟩
  · rcases secondBeforeFirst with
      ⟨middleActions, pastActionsEq⟩
    have firstHistory := firstWitness.stateHistory
    rw [← pastActionsEq] at firstHistory
    rcases replays_append_split firstHistory with
      ⟨middleState, secondReplay, remainingReplay⟩
    have stateEq : secondState = middleState :=
      replays_deterministic
        secondWitness.stateHistory
        secondReplay
    right
    refine
      ⟨firstWitness.pastActions,
        firstWitness.stateHistory,
        ?_⟩
    exact ⟨{
      pastActions := secondWitness.pastActions
      futureActions := middleActions
      actions_eq := pastActionsEq.symm
      stateHistory := secondWitness.stateHistory
      remainingHistory := by
        simpa only [stateEq] using remainingReplay
    }⟩

theorem historical_sameTerm_leader_logs_comparable
    {start : InitialConfiguration}
    {actions : List Action}
    {endState firstState secondState : State}
    (firstAt : StateAt start actions endState firstState)
    (secondAt : StateAt start actions endState secondState)
    (leader : Node)
    (firstLeader :
      firstState.leadershipState leader = .leader)
    (secondLeader :
      secondState.leadershipState leader = .leader)
    (sameTerm :
      firstState.currentTerm leader =
        secondState.currentTerm leader) :
    Or
      (isLogPrefix
        (firstState.log leader)
        (secondState.log leader))
      (isLogPrefix
        (secondState.log leader)
        (firstState.log leader)) := by
  rcases stateAt_history_order firstAt secondAt with
    ⟨priorActions, secondHistory, firstToSecond⟩ |
      ⟨priorActions, firstHistory, secondToFirst⟩
  · left
    exact
      (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
        secondHistory)
        firstState
        firstToSecond
        leader
        firstLeader
        secondLeader
        sameTerm
  · right
    exact
      (protocolHistory_implies_HistoricalSameLeaderLogPrefixInv
        firstHistory)
        secondState
        secondToFirst
        leader
        secondLeader
        firstLeader
        sameTerm.symm

theorem chosenCommitCertificates_prefix_comparable_of_choiceTerm_lt
    {start : InitialConfiguration}
    {actions : List Action}
    {endState lowerBoundary higherBoundary : State}
    {lowerOwner higherOwner : Node}
    {lowerIndex higherIndex : Nat}
    (lower :
      ChosenCommitCertificate
        start actions endState lowerBoundary lowerOwner lowerIndex)
    (higher :
      ChosenCommitCertificate
        start actions endState higherBoundary higherOwner higherIndex)
    (termLt : lower.choiceTerm < higher.choiceTerm) :
    Or
      (isLogPrefix lower.chosenPrefix higher.chosenPrefix)
      (isLogPrefix higher.chosenPrefix lower.chosenPrefix) := by
  have lowerToHigherLog :
      isLogPrefix
        lower.chosenPrefix
        (higher.choiceState.log higher.choiceLeader) := by
    apply
      lower.higher_term_leaders
        higher.choiceState
        higher.choice_at
        higher.choiceLeader
        higher.choice_leader
    rw [higher.choice_term]
    exact termLt
  have higherToHigherLog :=
    chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
      higher
  exact
    List.prefix_or_prefix_of_prefix
      lowerToHigherLog
      higherToHigherLog

theorem chosenCommitCertificates_prefix_comparable
    {start : InitialConfiguration}
    {actions : List Action}
    {endState firstBoundary secondBoundary : State}
    {firstOwner secondOwner : Node}
    {firstIndex secondIndex : Nat}
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions endState)
    (first :
      ChosenCommitCertificate
        start actions endState firstBoundary firstOwner firstIndex)
    (second :
      ChosenCommitCertificate
        start actions endState secondBoundary secondOwner secondIndex) :
    Or
      (isLogPrefix first.chosenPrefix second.chosenPrefix)
      (isLogPrefix second.chosenPrefix first.chosenPrefix) := by
  rcases
      Nat.lt_trichotomy first.choiceTerm second.choiceTerm with
    firstLower | sameChoiceTerm | secondLower
  · exact
      chosenCommitCertificates_prefix_comparable_of_choiceTerm_lt
        first second firstLower
  · have choiceStateTerms :
        first.choiceState.currentTerm first.choiceLeader =
          second.choiceState.currentTerm second.choiceLeader :=
      first.choice_term.trans
        (sameChoiceTerm.trans second.choice_term.symm)
    have sameLeader :
        first.choiceLeader = second.choiceLeader :=
      leaderUniqueness
        first.choiceState
        second.choiceState
        first.choice_at
        second.choice_at
        first.choiceLeader
        second.choiceLeader
        first.choice_leader
        second.choice_leader
        choiceStateTerms
    have secondLeader :
        second.choiceState.leadershipState first.choiceLeader =
          .leader := by
      simpa [sameLeader] using second.choice_leader
    have sameTerm :
        first.choiceState.currentTerm first.choiceLeader =
          second.choiceState.currentTerm first.choiceLeader := by
      simpa [sameLeader] using choiceStateTerms
    have firstToLog :=
      chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
        first
    have secondToLog :
        isLogPrefix
          second.chosenPrefix
          (second.choiceState.log first.choiceLeader) := by
      simpa [sameLeader] using
        chosenCommitCertificate_chosenPrefix_isLogPrefix_choiceLog
          second
    rcases
        historical_sameTerm_leader_logs_comparable
          first.choice_at
          second.choice_at
          first.choiceLeader
          first.choice_leader
          secondLeader
          sameTerm with
      firstBeforeSecond | secondBeforeFirst
    · exact
        List.prefix_or_prefix_of_prefix
          (firstToLog.trans firstBeforeSecond)
          secondToLog
    · exact
        List.prefix_or_prefix_of_prefix
          firstToLog
          (secondToLog.trans secondBeforeFirst)
  · rcases
        chosenCommitCertificates_prefix_comparable_of_choiceTerm_lt
          second first secondLower with
      secondFirst | firstSecond
    · exact Or.inr secondFirst
    · exact Or.inl firstSecond

theorem historicalChosenCommitCore_implies_LogInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (chosen : HistoricalChosenCommitCore start actions state)
    (signatures : SignatureInv state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state)
    (_sameLeaderPrefixes :
      HistoricalSameLeaderLogPrefixInv start actions state) :
    LogInv state := by
  intro firstNode secondNode
  by_cases firstCommitZero :
      state.commitIndex firstNode = 0
  · left
    simp [committed, firstCommitZero, logPrefix, isLogPrefix]
  by_cases secondCommitZero :
      state.commitIndex secondNode = 0
  · right
    simp [committed, secondCommitZero, logPrefix, isLogPrefix]
  have firstCommitPositive :
      0 < state.commitIndex firstNode := by
    omega
  have secondCommitPositive :
      0 < state.commitIndex secondNode := by
    omega
  have firstBoundary :
      SignatureCommitBoundary
        state firstNode (state.commitIndex firstNode) :=
    ⟨firstCommitPositive,
      Nat.le_refl _,
      signatures firstNode firstCommitPositive⟩
  have secondBoundary :
      SignatureCommitBoundary
        state secondNode (state.commitIndex secondNode) :=
    ⟨secondCommitPositive,
      Nat.le_refl _,
      signatures secondNode secondCommitPositive⟩
  rcases
      chosen
        state
        (protocolHistory_final_stateAt history)
        firstNode
        (state.commitIndex firstNode)
        firstBoundary with
    ⟨firstCertificate⟩
  rcases
      chosen
        state
        (protocolHistory_final_stateAt history)
        secondNode
        (state.commitIndex secondNode)
        secondBoundary with
    ⟨secondCertificate⟩
  have comparable :=
    chosenCommitCertificates_prefix_comparable
      leaderUniqueness
      firstCertificate
      secondCertificate
  simpa [committed, ← firstCertificate.prefix_eq,
    ← secondCertificate.prefix_eq] using comparable

theorem historicalLeaderLogs_imply_ElectionSafetyInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (entryOrigins :
      HistoricalEntryTermLeaderOriginInv start actions state)
    (prefixes :
      HistoricalSameLeaderLogPrefixInv start actions state)
    (leaderUniqueness :
      TemporalLeaderUniquenessInv start actions state) :
    ElectionSafetyInv state := by
  have finalStateAt := protocolHistory_final_stateAt history
  have minimumTerms : MinimumTermInv state :=
    protocolHistory_induction
      (start := start)
      (property := fun _ current => MinimumTermInv current)
      (initial_MinimumTermInv start)
      (by
        intro _ current _ minimum action enabled
        exact minimumTerm_step current action minimum enabled)
      history
  intro leader leaderState node _different
  by_cases leaderTermIsStart :
      state.currentTerm leader = startTerm
  · have initialStateAt := protocolHistory_initial_stateAt history
    have leaderIsStart :
        start = leader :=
      leaderUniqueness
        (initialState start)
        state
        initialStateAt
        finalStateAt
        start
        leader
        (by simp [initialState, start.leader_mem])
        leaderState
        (by simpa [initialState, start.leader_mem] using
          leaderTermIsStart.symm)
    subst leader
    have initialPrefix :=
      prefixes
        (initialState start)
        initialStateAt
        start
        (by simp [initialState, start.leader_mem])
        leaderState
        (by simpa [initialState, start.leader_mem] using
          leaderTermIsStart.symm)
    let initialEntry : Entry :=
      {
        term := startTerm
        content := .signature
      }
    have initialMember :
        initialEntry ∈ (initialState start).log start := by
      simp [initialEntry, initialState, startLog, start.leader_mem]
    rcases initialPrefix with ⟨suffix, currentLogEq⟩
    have currentMember :
        initialEntry ∈ state.log start := by
      rw [← currentLogEq]
      simp [initialMember]
    have leaderFold :=
      electionTermFold_eq_term_of_mem
        (state.currentTerm start)
        (state.log start)
        initialEntry
        currentMember
        (by simp [initialEntry, leaderTermIsStart])
    rw [leaderFold]
    exact electionTermFold_le_term
      (state.currentTerm start) (state.log node)
  · have leaderActive :
        state.leadershipState leader != .none := by
      simp [leaderState]
    have leaderTermAfterStart :
        startTerm < state.currentTerm leader :=
      lt_of_le_of_ne
        (minimumTerms.activeRoles leader leaderActive)
        (Ne.symm leaderTermIsStart)
    rcases
        electionTermFold_eq_zero_or_has_term_entry
          (state.currentTerm leader)
          (state.log node) with
      zero | ⟨entry, member, entrySameTerm⟩
    · rw [zero]
      exact Nat.zero_le _
    · rcases
          entryOrigins
            state finalStateAt node entry member
            (by simpa [entrySameTerm] using leaderTermAfterStart) with
        ⟨origin⟩
      have originLeaderEq :
          origin.leader = leader :=
        leaderUniqueness
          origin.appendState
          state
          (occurs_before_stateAt origin.occurrence)
          finalStateAt
          origin.leader
          leader
          origin.leader_state
          leaderState
          (origin.term_eq.trans entrySameTerm)
      subst leader
      have appendedStateAt :=
        occurs_after_stateAt origin.occurrence
      have appendedLeader :
          (next
              origin.appendState
              (origin.kind.action origin.leader)).leadershipState
                origin.leader =
            .leader := by
        cases origin.kind <;>
          simpa [LeaderAppendKind.action, next, rawNext,
            nextClientRequest, nextSignCommittableMessages,
            nextChangeConfiguration] using origin.leader_state
      have appendedTerm :
          (next
              origin.appendState
              (origin.kind.action origin.leader)).currentTerm
                origin.leader =
            state.currentTerm origin.leader := by
        calc
          (next
              origin.appendState
              (origin.kind.action origin.leader)).currentTerm
                origin.leader =
              origin.appendState.currentTerm origin.leader := by
            cases origin.kind <;>
              simp [LeaderAppendKind.action, next, rawNext,
                nextClientRequest, nextSignCommittableMessages,
                nextChangeConfiguration]
          _ = entry.term := origin.term_eq
          _ = state.currentTerm origin.leader := entrySameTerm
      have appendedPrefix :=
        prefixes
          (next
            origin.appendState
            (origin.kind.action origin.leader))
          appendedStateAt
          origin.leader
          appendedLeader
          leaderState
          appendedTerm
      rcases
          entryTermLeaderWitness_has_appended_term origin with
        ⟨appendedEntry, appendedMember, appendedEntryTerm⟩
      rcases appendedPrefix with ⟨suffix, currentLogEq⟩
      have currentMember :
          appendedEntry ∈ state.log origin.leader := by
        rw [← currentLogEq]
        simp [appendedMember]
      have leaderFold :=
        electionTermFold_eq_term_of_mem
          (state.currentTerm origin.leader)
          (state.log origin.leader)
          appendedEntry
          currentMember
          (appendedEntryTerm.trans entrySameTerm)
      rw [leaderFold]
      exact electionTermFold_le_term
        (state.currentTerm origin.leader) (state.log node)

theorem candidateTermStrictAfterStart_step
    (state : State)
    (action : Action)
    (candidateTerms :
      forall node,
        state.leadershipState node = .candidate ->
          startTerm < state.currentTerm node)
    (activeRoles : ActiveRoleTermInv state)
    (enabled : Enabled state action) :
    forall node,
      (next state action).leadershipState node = .candidate ->
        startTerm < (next state action).currentTerm node := by
  intro node afterCandidate
  by_cases isTimeout :
      Exists fun timedOut : Node =>
        action = .timeout timedOut
  · rcases isTimeout with ⟨timedOut, rfl⟩
    by_cases nodeIsTimedOut : node = timedOut
    · subst node
      have timeoutEnabled := enabled
      simp [Enabled, actionEnabled] at timeoutEnabled
      have active :
          state.leadershipState timedOut != .none := by
        rcases timeoutEnabled.2 with follower | candidate
        · rw [follower]
          decide
        · rw [candidate]
          decide
      have lowerBound := activeRoles timedOut active
      simpa [next, rawNext, nextTimeout] using
        Nat.lt_succ_of_le lowerBound
    · have oldCandidate :
          state.leadershipState node = .candidate := by
        simpa [next, rawNext, nextTimeout, nodeIsTimedOut] using
          afterCandidate
      simpa [next, rawNext, nextTimeout, nodeIsTimedOut] using
        candidateTerms node oldCandidate
  · have oldCandidate :
        state.leadershipState node = .candidate :=
      candidate_before_of_candidate_after
        state action node afterCandidate
        (by
          intro timedOut actionEq
          exact isTimeout ⟨timedOut, actionEq⟩)
    exact Nat.lt_of_lt_of_le
      (candidateTerms node oldCandidate)
      (monotonicTerm_step state action enabled node)

theorem reachable_CandidateTermStrictAfterStart
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    forall node,
      state.leadershipState node = .candidate ->
        startTerm < state.currentTerm node := by
  have invariant :
      And
        (MinimumTermInv state)
        (forall node,
          state.leadershipState node = .candidate ->
            startTerm < state.currentTerm node) := by
    apply
      ExecutableTransitionSystem.reachableInvariant
        (system start)
        (Invariant := fun current =>
          And
            (MinimumTermInv current)
            (forall node,
              current.leadershipState node = .candidate ->
                startTerm < current.currentTerm node))
    · exact
        ⟨initial_MinimumTermInv start,
          initial_CandidateTermStrictAfterStart start⟩
    · intro current nextAction oldInvariant nextEnabled
      exact
        ⟨minimumTerm_step
            current nextAction oldInvariant.1 nextEnabled,
          candidateTermStrictAfterStart_step
            current nextAction oldInvariant.2
            oldInvariant.1.activeRoles nextEnabled⟩
    · exact reachable
  exact invariant.2

theorem protocolHistory_implies_HistoricalElectedTermsNotStartInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (_history : ProtocolHistory start actions state) :
    HistoricalElectedTermsNotStartInv start actions state := by
  intro electionState leader occurrence
  have electionReachable := occurs_before_reachable occurrence
  have candidateTerms :=
    reachable_CandidateTermStrictAfterStart start electionReachable
  rcases occurrence with ⟨witness⟩
  have becomeEnabled := witness.enabled
  simp [Enabled, actionEnabled] at becomeEnabled
  exact Nat.ne_of_gt
    (candidateTerms leader becomeEnabled.1.2)

theorem historicalElectionCores_imply_TemporalLeaderUniquenessInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (votes : HistoricalVoteCore start actions state)
    (leaders : LeaderHistoryConsistent start actions state)
    (overlap :
      ElectionConfigurationsOverlapInv start actions state) :
    TemporalLeaderUniquenessInv start actions state :=
  historicalElectionCores_imply_TemporalLeaderUniquenessInv_of_electedTermsNotStart
    history
    votes
