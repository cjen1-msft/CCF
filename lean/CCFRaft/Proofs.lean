  · simp [activeLogConfigurations,
      logConfigurations, initialState, startLog, nodeIsInitial,
      configurationsInEntries, configurationsInEntriesAux,
      configurationsFromIndex, lastConfigurationToIndex]

theorem initial_MessagesWellFormedInv (start : InitialConfiguration) :
