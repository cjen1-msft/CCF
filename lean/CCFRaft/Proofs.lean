theorem hereditaryChosenCommitCore_boundary_watermark_support
    {start : InitialConfiguration}
    {actions : List Action}
    {endState endpointState boundaryState : State}
    {owner : Node}
    {index : Nat}
    (core :
      HereditaryHistoricalChosenCommitCore
        start actions endState)
    (endpoint :
      StateAtWitness
        start actions endState endpointState)
    (boundaryAt :
      StateAt
        start endpoint.pastActions endpointState boundaryState)
    (boundary :
      SignatureCommitBoundary boundaryState owner index) :
    Exists fun certificate :
        ChosenCommitCertificate
          start endpoint.pastActions endpointState
          boundaryState owner index =>
      Exists fun activeQuorum : Configuration =>
        And
          (isQuorum
              activeQuorum certificate.configuration.nodes =
            true)
          (forall member : Node,
            member ∈ activeQuorum ->
              isLogPrefix
                certificate.chosenPrefix
                (endpointState.log member)) := by
  have localCore :
      HistoricalChosenCommitCore
        start endpoint.pastActions endpointState :=
    core
      ⟨endpoint.futureActions, endpoint.actions_eq.symm⟩
      endpoint.stateHistory
  rcases
      localCore boundaryState boundaryAt owner index boundary with
    ⟨certificate⟩
  have configurationsExact :
      ConfigurationsExactInv certificate.choiceState :=
    reachable_ConfigurationsExactInv
      start
      (stateAt_reachable certificate.choice_at)
  rcases
      chosenCommitCertificate_configuration_watermark_support
        certificate configurationsExact with
    ⟨activeQuorum, quorumOk, support⟩
  exact
    ⟨certificate, activeQuorum, quorumOk, support⟩

private theorem stateAt_extend_action
    {start : InitialConfiguration}
    {actions : List Action}
    {state historicalState : State}
    {action : Action}
    (stateAt :
      StateAt start actions state historicalState)
    (enabled : Enabled state action) :
    StateAt
      start
      (actions ++ [action])
      (next state action)
      historicalState := by
  rcases stateAt with ⟨witness⟩
  exact ⟨{
    pastActions := witness.pastActions
    futureActions := witness.futureActions ++ [action]
    actions_eq := by
      calc
        actions ++ [action] =
            (witness.pastActions ++ witness.futureActions) ++
              [action] := congrArg (· ++ [action]) witness.actions_eq
        _ = witness.pastActions ++
              (witness.futureActions ++ [action]) :=
            List.append_assoc _ _ _
    stateHistory := witness.stateHistory
    remainingHistory :=
      replays_append_singleton witness.remainingHistory enabled
  }⟩

theorem initial_HistoricalSignatureLeaderAtIndexInv
    (start : InitialConfiguration) :
    HistoricalSignatureLeaderAtIndexInv
      start [] (initialState start) := by
  intro historicalState stateAt node index term atIndex afterStart
  rw [stateAt_initial_eq stateAt] at atIndex
  by_cases nodeIsInitial : node ∈ start.nodes
  ·
    have atStart :
        entryAt? (startLog start) index =
          some { term, content := .signature } := by
      simpa [initialState, nodeIsInitial] using atIndex
    have member :=
      entryAt?_mem
        (startLog start)
        index
        { term, content := .signature }
        atStart
    simp [startLog] at member
    subst term
    exact
      ⟨initialState start, start.leader,
        protocolHistory_final_stateAt
          (show ProtocolHistory start [] (initialState start) from rfl),
        by simp [initialState, start.leader_mem],
        by simp [initialState, start.leader_mem],
        by simpa [initialState, start.leader_mem] using atStart⟩
  · simp [initialState, nodeIsInitial, entryAt?] at atIndex

private theorem historicalSignatureLeaderAtIndex_of_prefix_origins
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (invariant :
      HistoricalSignatureLeaderAtIndexInv start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (origins :
      forall node : Node,
        HistoricalLogPrefixOrigin
          start actions state ((next state action).log node)) :
    HistoricalSignatureLeaderAtIndexInv
      start (actions ++ [action]) (next state action) := by
  intro historicalState stateAt node index term atIndex afterStart
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · rcases invariant historicalState oldState node index term
        atIndex afterStart with
      ⟨leaderState, leader, leaderAt, leaderRole,
        leaderTerm, leaderEntry⟩
    exact
      ⟨leaderState, leader,
        stateAt_extend_action leaderAt enabled,
        leaderRole, leaderTerm, leaderEntry⟩
  · subst historicalState
    have positive : 1 <= index := by
      by_contra notPositive
      have indexZero : index = 0 := by omega
      subst index
      simp [entryAt?] at atIndex
    have within : index <= ((next state action).log node).length := by
      unfold entryAt? at atIndex
      split at atIndex
      · contradiction
      · have bound :=
          (List.getElem?_eq_some_iff.mp atIndex).choose
        omega
    rcases
        historicalLogPrefixOrigin_index
          (origins node) index positive within with
      ⟨originState, originNode, originAt, entryEq,
        _prefixEq, _originWithin⟩
    have originEntry :
        entryAt? (originState.log originNode) index =
          some { term, content := .signature } := by
      rw [← entryEq]
      exact atIndex
    rcases invariant originState originAt originNode index term
        originEntry afterStart with
      ⟨leaderState, leader, leaderAt, leaderRole,
        leaderTerm, leaderEntry⟩
    exact
      ⟨leaderState, leader,
        stateAt_extend_action leaderAt enabled,
        leaderRole, leaderTerm, leaderEntry⟩

private theorem historicalSignatureLeaderAtIndex_append_local
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (invariant :
      HistoricalSignatureLeaderAtIndexInv start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (appendingLeader : Node)
    (entry : Entry)
    (appendingLog :
      (next state action).log appendingLeader =
        state.log appendingLeader ++ [entry])
    (otherLogs :
      forall node : Node,
        node ≠ appendingLeader ->
          (next state action).log node = state.log node)
    (afterLeader :
      (next state action).leadershipState appendingLeader =
        .leader)
    (afterTerm :
      (next state action).currentTerm appendingLeader =
        entry.term) :
    HistoricalSignatureLeaderAtIndexInv
      start (actions ++ [action]) (next state action) := by
  intro historicalState stateAt node index term atIndex afterStart
  rcases
      stateAt_append_singleton_cases history enabled stateAt with
    oldState | finalState
  · rcases invariant historicalState oldState node index term
        atIndex afterStart with
      ⟨leaderState, leader, leaderAt, leaderRole,
        leaderTerm, leaderEntry⟩
    exact
      ⟨leaderState, leader,
        stateAt_extend_action leaderAt enabled,
        leaderRole, leaderTerm, leaderEntry⟩
  · subst historicalState
    by_cases nodeIsLeader : node = appendingLeader
    · subst node
      rw [appendingLog] at atIndex
      have positive : 1 <= index := by
        by_contra notPositive
        have indexZero : index = 0 := by omega
        subst index
        simp [entryAt?] at atIndex
      by_cases withinOld :
          index <= (state.log appendingLeader).length
      · have oldEntry :
            entryAt? (state.log appendingLeader) index =
              some { term, content := .signature } := by
          rw [entryAt?_append_eq_of_index_le_length
            (state.log appendingLeader) [entry] index
            positive withinOld] at atIndex
          exact atIndex
        rcases invariant
            state
            (protocolHistory_final_stateAt history)
            appendingLeader index term oldEntry afterStart with
          ⟨leaderState, leader, leaderAt, leaderRole,
            leaderTerm, leaderEntry⟩
        exact
          ⟨leaderState, leader,
            stateAt_extend_action leaderAt enabled,
            leaderRole, leaderTerm, leaderEntry⟩
      · have withinAfter :
            index <=
              (state.log appendingLeader ++ [entry]).length := by
          unfold entryAt? at atIndex
          split at atIndex
          · contradiction
          · have bound :=
              (List.getElem?_eq_some_iff.mp atIndex).choose
            omega
        have indexEq :
            index = (state.log appendingLeader).length + 1 := by
          simp at withinAfter
          omega
        subst index
        rw [entryAt?_append_singleton_last] at atIndex
        have entryEq :
            entry = { term, content := .signature } :=
          Option.some.inj atIndex
        have afterTermEq :
            (next state action).currentTerm appendingLeader = term := by
          rw [afterTerm, entryEq]
        exact
          ⟨next state action, appendingLeader,
            protocolHistory_final_stateAt
              (replays_append_singleton history enabled),
            afterLeader, afterTermEq,
            by
              rw [appendingLog, entryEq,
                entryAt?_append_singleton_last]⟩
    · have oldEntry :
          entryAt? (state.log node) index =
            some { term, content := .signature } := by
        rw [otherLogs node nodeIsLeader] at atIndex
        exact atIndex
      rcases invariant
          state
          (protocolHistory_final_stateAt history)
          node index term oldEntry afterStart with
        ⟨leaderState, leader, leaderAt, leaderRole,
          leaderTerm, leaderEntry⟩
      exact
        ⟨leaderState, leader,
          stateAt_extend_action leaderAt enabled,
          leaderRole, leaderTerm, leaderEntry⟩

private theorem historicalSignatureLeaderAtIndex_receive_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (invariant :
      HistoricalSignatureLeaderAtIndexInv start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (dest source : Node)
    (kind : ReceiveKind)
    (enabled : Enabled state (.receive dest source kind)) :
    HistoricalSignatureLeaderAtIndexInv
      start
      (actions ++ [.receive dest source kind])
      (next state (.receive dest source kind)) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      apply historicalSignatureLeaderAtIndex_of_prefix_origins
        history invariant (.receive dest source kind) enabled
      intro node
      apply historicalLogPrefixOrigin_of_unchanged history node
      simp [next, rawNext, nextReceive, hmessage]
  | some message =>
      cases kind with
      | appendEntriesNoConflict =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              leaderCommitIndex =>
              have queued :=
                headMessage?_mem state dest source message hmessage
              have provenance :
                  MessageHasAESendWitness
                    start actions state dest source message := by
                simpa [hbody] using
                  requests dest source message queued
              rcases provenance with ⟨send⟩
              have branchEnabled := enabled
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at branchEnabled
              have messageBody := congrArg Message.body send.message_eq
              simp [requestVoteMessage, appendEntriesMessage, hbody]
                at messageBody
              rcases messageBody with
                ⟨previousIndexEq, previousTermEq,
                  entriesEq, leaderCommitIndexEq⟩
              subst previousIndex
              subst previousTerm
              subst entries
              subst leaderCommitIndex
              have noConflictFacts := branchEnabled.2.2.2
              simp [appendEntriesNoConflictGuard] at noConflictFacts
              have sendFacts :=
                appendEntriesMessage_prefix_eq
                  history send.occurrence matching
                  (by simpa [send.message_eq] using branchEnabled.2.2.1)
                  noConflictFacts.1.1.1
              have resultLog :
                  (next state
                    (.receive dest source
                      .appendEntriesNoConflict)).log dest =
                    (send.sendState.log source).take
                      (send.sendState.sentIndex source dest + 1) := by
                simpa [next, rawNext, nextReceive, hmessage,
                  send.message_eq, appendEntriesMessage] using
                  appendEntriesMessage_result_log_eq
                    send.sendState state source dest sendFacts.2
              apply historicalSignatureLeaderAtIndex_of_prefix_origins
                history invariant
                (.receive dest source .appendEntriesNoConflict)
                enabled
              intro node
              by_cases nodeIsDest : node = dest
              · subst node
                exact historicalLogPrefixOrigin_of_prefix
                  (occurs_before_stateAt send.occurrence)
                  source
                  (send.sendState.sentIndex source dest + 1)
                  resultLog
              · apply historicalLogPrefixOrigin_of_unchanged
                  history node
                simp [next, rawNext, nextReceive, hmessage,
                  send.message_eq, appendEntriesMessage,
                  nextAppendEntriesNoConflict, nodeIsDest]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | appendEntriesConflictThenNoConflict =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              leaderCommitIndex =>
              have queued :=
                headMessage?_mem state dest source message hmessage
              have provenance :
                  MessageHasAESendWitness
                    start actions state dest source message := by
                simpa [hbody] using
                  requests dest source message queued
              rcases provenance with ⟨send⟩
              have branchEnabled := enabled
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at branchEnabled
              have messageBody := congrArg Message.body send.message_eq
              simp [requestVoteMessage, appendEntriesMessage, hbody]
                at messageBody
              rcases messageBody with
                ⟨previousIndexEq, previousTermEq,
                  entriesEq, leaderCommitIndexEq⟩
              subst previousIndex
              subst previousTerm
              subst entries
              subst leaderCommitIndex
              have noConflictFacts := branchEnabled.2.2.2
              simp [appendEntriesNoConflictGuard] at noConflictFacts
              have sendFacts :=
                appendEntriesMessage_prefix_eq
                  history send.occurrence matching
                  (by simpa [send.message_eq] using branchEnabled.2.2.1.1)
                  noConflictFacts.1.1.1
              have rolledPrefixEq :
                  logPrefix
                      ((conflictRollback
                        state dest
                        (send.sendState.sentIndex source dest)).log dest)
                      (send.sendState.sentIndex source dest) =
                    logPrefix
                      (send.sendState.log source)
                      (send.sendState.sentIndex source dest) := by
                simpa [conflictRollback, logPrefix,
                  List.take_take] using sendFacts.2
              have resultLog :
                  (next state
                    (.receive dest source
                      .appendEntriesConflictThenNoConflict)).log dest =
                    (send.sendState.log source).take
                      (send.sendState.sentIndex source dest + 1) := by
                simpa [next, rawNext, nextReceive, hmessage,
                  send.message_eq, appendEntriesMessage] using
                  appendEntriesMessage_result_log_eq
                    send.sendState
                    (conflictRollback state dest
                      (send.sendState.sentIndex source dest))
                    source dest rolledPrefixEq
              apply historicalSignatureLeaderAtIndex_of_prefix_origins
                history invariant
                (.receive dest source
                  .appendEntriesConflictThenNoConflict)
                enabled
              intro node
              by_cases nodeIsDest : node = dest
              · subst node
                exact historicalLogPrefixOrigin_of_prefix
                  (occurs_before_stateAt send.occurrence)
                  source
                  (send.sendState.sentIndex source dest + 1)
                  resultLog
              · apply historicalLogPrefixOrigin_of_unchanged
                  history node
                simp [next, rawNext, nextReceive, hmessage,
                  send.message_eq, appendEntriesMessage,
                  nextAppendEntriesNoConflict, conflictRollback,
                  nodeIsDest]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | appendEntriesConflictThenAlreadyDone =>
          cases hbody : message.body with
          | appendEntriesRequest previousIndex previousTerm entries
              leaderCommitIndex =>
              apply historicalSignatureLeaderAtIndex_of_prefix_origins
                history invariant
                (.receive dest source
                  .appendEntriesConflictThenAlreadyDone)
                enabled
              intro node
              by_cases nodeIsDest : node = dest
              · subst node
                apply historicalLogPrefixOrigin_of_prefix
                  (protocolHistory_final_stateAt history)
                  dest previousIndex
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone, conflictRollback]
              · apply historicalLogPrefixOrigin_of_unchanged
                  history node
                simp [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone, conflictRollback,
                  nodeIsDest]
          | _ =>
              simp [Enabled, actionEnabled, hmessage,
                receiveBranchEnabled, hbody] at enabled
      | dropIgnored | updateTerm | handleRequestVoteRequest |
          handleRequestVoteResponse |
          dropRequestVoteResponseOutOfState |
          dropRequestVoteResponseStale |
          rejectAppendEntriesRequest | returnToFollower |
          appendEntriesAlreadyDone |
          handleAppendEntriesResponseSuccess |
          handleAppendEntriesResponseFailure |
          dropAppendEntriesResponseOutOfState |
          dropAppendEntriesResponseStale =>
          apply historicalSignatureLeaderAtIndex_of_prefix_origins
            history invariant _ enabled
          intro node
          apply historicalLogPrefixOrigin_of_unchanged history node
          cases hbody : message.body <;>
            simp [next, rawNext, nextReceive, hmessage, hbody,
              nextAppendEntriesAlreadyDone,
              nextAppendEntriesNoConflict, conflictRollback]
          all_goals split <;> rfl

theorem historicalSignatureLeaderAtIndex_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (invariant :
      HistoricalSignatureLeaderAtIndexInv start actions state)
    (matching : TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalSignatureLeaderAtIndexInv
      start (actions ++ [action]) (next state action) := by
  cases action with
  | timeout candidate =>
      apply historicalSignatureLeaderAtIndex_of_prefix_origins
        history invariant (.timeout candidate) enabled
      intro node
      apply historicalLogPrefixOrigin_of_unchanged history node
      simp [next, rawNext, nextTimeout]
  | requestVote source dest =>
      apply historicalSignatureLeaderAtIndex_of_prefix_origins
        history invariant (.requestVote source dest) enabled
      intro node
      apply historicalLogPrefixOrigin_of_unchanged history node
      simp [next, rawNext, nextRequestVote]
  | appendEntries source dest =>
      apply historicalSignatureLeaderAtIndex_of_prefix_origins
        history invariant (.appendEntries source dest) enabled
      intro node
      apply historicalLogPrefixOrigin_of_unchanged history node
      simp [next, rawNext, nextAppendEntries]
  | becomeLeader leader =>
      apply historicalSignatureLeaderAtIndex_of_prefix_origins
        history invariant (.becomeLeader leader) enabled
      intro node
      by_cases nodeIsLeader : node = leader
      · subst node
        apply historicalLogPrefixOrigin_of_prefix
          (protocolHistory_final_stateAt history)
          leader
          (maxCommittableIndex (state.log leader))
        simp [next, rawNext, nextBecomeLeader, committable,
          logPrefix]
      · apply historicalLogPrefixOrigin_of_unchanged history node
        simp [next, rawNext, nextBecomeLeader, nodeIsLeader]
  | clientRequest leader =>
      have enabledFacts := enabled
      simp [Enabled, actionEnabled] at enabledFacts
      apply historicalSignatureLeaderAtIndex_append_local
        history invariant (.clientRequest leader) enabled
        leader
        { term := state.currentTerm leader, content := .entry }
      · simp [next, rawNext, nextClientRequest]
      · intro node nodeIsLeader
        simp [next, rawNext, nextClientRequest, nodeIsLeader]
      · simpa [next, rawNext, nextClientRequest] using enabledFacts.1.2
      · simp [next, rawNext, nextClientRequest]
  | signCommittableMessages leader =>
      have enabledFacts := enabled
      simp [Enabled, actionEnabled] at enabledFacts
      apply historicalSignatureLeaderAtIndex_append_local
        history invariant (.signCommittableMessages leader) enabled
        leader
        { term := state.currentTerm leader, content := .signature }
      · simp [next, rawNext, nextSignCommittableMessages]
      · intro node nodeIsLeader
        simp [next, rawNext, nextSignCommittableMessages, nodeIsLeader]
      · simpa [next, rawNext, nextSignCommittableMessages] using
          enabledFacts.1.1.2
      · simp [next, rawNext, nextSignCommittableMessages]
  | changeConfiguration leader configuration =>
      have enabledFacts := enabled
      simp [Enabled, actionEnabled] at enabledFacts
      apply historicalSignatureLeaderAtIndex_append_local
        history invariant (.changeConfiguration leader configuration)
        enabled leader
        { term := state.currentTerm leader,
          content := .reconfiguration configuration }
      · simp [next, rawNext, nextChangeConfiguration]
      · intro node nodeIsLeader
        simp [next, rawNext, nextChangeConfiguration, nodeIsLeader]
      · simpa [next, rawNext, nextChangeConfiguration] using
          enabledFacts.1.1.1.2
      · simp [next, rawNext, nextChangeConfiguration]
  | advanceCommitIndex leader =>
      apply historicalSignatureLeaderAtIndex_of_prefix_origins
        history invariant (.advanceCommitIndex leader) enabled
      intro node
      apply historicalLogPrefixOrigin_of_unchanged history node
      simp [next, rawNext, nextAdvanceCommitIndex]
  | receive dest source kind =>
      exact historicalSignatureLeaderAtIndex_receive_step
        history invariant matching requests dest source kind enabled

private theorem temporalLogMatching_before_action
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    (enabled : Enabled state action)
    (matching :
      TemporalLogMatchingInv
        start (actions ++ [action]) (next state action)) :
    TemporalLogMatchingInv start actions state := by
  intro firstState secondState firstAt secondAt
    firstNode secondNode index positive bounded sameTerm
  exact matching
    firstState secondState
    (stateAt_extend_action firstAt enabled)
    (stateAt_extend_action secondAt enabled)
    firstNode secondNode index positive bounded sameTerm

theorem protocolHistory_implies_HistoricalSignatureLeaderAtIndexInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching : TemporalLogMatchingInv start actions state) :
    HistoricalSignatureLeaderAtIndexInv start actions state := by
  exact
    protocolHistory_induction
      (start := start)
      (property := fun past current =>
        TemporalLogMatchingInv start past current ->
          HistoricalSignatureLeaderAtIndexInv start past current)
      (fun _ => initial_HistoricalSignatureLeaderAtIndexInv start)
      (by
        intro past current pastHistory inductionHypothesis action enabled
          matchingAfter
        have matchingBefore :=
          temporalLogMatching_before_action enabled matchingAfter
        have requests :=
          queueHistory_implies_AppendEntriesRequestHistoryConsistent
            (protocolHistory_implies_QueueHistoryConsistent pastHistory)
        exact historicalSignatureLeaderAtIndex_append_step
          pastHistory
          (inductionHypothesis matchingBefore)
          matchingBefore requests action enabled)
      history
      matching

theorem reachable_LogConfigurationConsistentInv
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    LogConfigurationConsistentInv state :=
  configurationsExact_implies_LogConfigurationConsistentInv
    state
    (reachable_ConfigurationsExactInv start reachable)

theorem reachable_CommittedLogAppendOnlyProp
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state)
    {action : Action}
    (enabled : Enabled state action) :
    CommittedLogAppendOnlyProp state (next state action) :=
  committedLogAppendOnly_step
    state
    action
    (reachable_SignatureInv start reachable)
    enabled

theorem reachable_MessagesWellFormedInv
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    MessagesWellFormedInv state := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := MessagesWellFormedInv)
  · exact initial_MessagesWellFormedInv start
  · intro current action invariant _
    exact messagesWellFormed_step current action invariant
  · exact reachable

theorem queueHistory_implies_AppendEntriesResponseHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (queues : QueueHistoryConsistent start actions state) :
    AppendEntriesResponseHistoryConsistent start actions state := by
  intro dest source message queued
  cases bodyEq : message.body with
  | requestVoteRequest lastTerm lastIndex isPreVote =>
      trivial
  | requestVoteResponse voteGranted isPreVote =>
      trivial
  | appendEntriesRequest previousIndex previousTerm entries commitIndex =>
      trivial
  | appendEntriesResponse success lastLogIndex =>
      rcases queues dest source message queued with ⟨witness⟩
      cases actionEq : witness.action with
      | timeout candidate =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextTimeout] using
            witness.presentAfter
      | requestVote sendSource sendDest =>
          have inserted :=
            firstInsertion_enqueue_eq
              witness.before.messages
              (requestVoteMessage witness.before sendSource sendDest)
              message
              dest
              source
              witness.absentBefore
              (by
                simpa [actionEq, next, rawNext, nextRequestVote] using
                  witness.presentAfter)
          rw [inserted.2.2] at bodyEq
          simp [requestVoteMessage] at bodyEq
      | appendEntries sendSource sendDest =>
          have inserted :=
            firstInsertion_enqueue_eq
              witness.before.messages
              (appendEntriesMessage witness.before sendSource sendDest)
              message
              dest
              source
              witness.absentBefore
              (by
                simpa [actionEq, next, rawNext, nextAppendEntries] using
                  witness.presentAfter)
          rw [inserted.2.2] at bodyEq
          simp [appendEntriesMessage] at bodyEq
      | becomeLeader leader =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextBecomeLeader] using
            witness.presentAfter
      | clientRequest leader =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextClientRequest] using
            witness.presentAfter
      | signCommittableMessages leader =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext,
            nextSignCommittableMessages] using witness.presentAfter
      | changeConfiguration leader configuration =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextChangeConfiguration] using
            witness.presentAfter
      | advanceCommitIndex leader =>
          exfalso
          apply witness.absentBefore
          simpa [actionEq, next, rawNext, nextAdvanceCommitIndex] using
            witness.presentAfter
      | receive receiveDest receiveSource kind =>
          have presentAfter :
              message ∈
                (next witness.before
                  (.receive receiveDest receiveSource kind)).messages
                  dest source := by
            simpa [actionEq] using witness.presentAfter
          have impossibleUnchanged
              (messagesAfter :
                (next witness.before
                    (.receive receiveDest receiveSource kind)).messages =
                  witness.before.messages) :
              False := by
            apply witness.absentBefore
            rw [← messagesAfter]
            exact presentAfter
          have impossibleDiscard
              (discarded : Message)
              (messagesAfter :
                (next witness.before
                    (.receive receiveDest receiveSource kind)).messages =
                  Model.discard witness.before.messages discarded) :
              False := by
            apply witness.absentBefore
            exact mem_before_of_mem_discard
              witness.before.messages
              discarded
              message
              dest
              source
              (by
                rw [← messagesAfter]
                exact presentAfter)
          have impossibleNonAppendEntriesReply
              (response request : Message)
              (messagesAfter :
                (next witness.before
                    (.receive receiveDest receiveSource kind)).messages =
                  reply witness.before.messages response request)
              (responseIsNotAppendEntries :
                match response.body with
                | .appendEntriesResponse _ _ => False
                | _ => True) :
              False := by
            have presentReply :
                message ∈
                  (reply witness.before.messages response request)
                    dest source := by
              rw [← messagesAfter]
              exact presentAfter
            rcases firstInsertion_reply_eq
                witness.before.messages
                response
                request
                message
                dest
                source
                witness.absentBefore
                presentReply with
              ⟨_, _, messageEq⟩
            rw [messageEq] at bodyEq
            rw [bodyEq] at responseIsNotAppendEntries
            exact responseIsNotAppendEntries
          cases hmessage :
              headMessage? witness.before receiveDest receiveSource with
          | none =>
              exact False.elim
                (impossibleUnchanged
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | some request =>
              have requestCoordinates :
                  And
                    (request.dest = receiveDest)
                    (request.source = receiveSource) :=
                (reachable_MessagesWellFormedInv
                    start
                    (occurs_before_reachable witness.occurrence))
                  receiveDest
                  receiveSource
                  request
                  (headMessage?_mem
                    witness.before
                    receiveDest
                    receiveSource
                    request
                    hmessage)
              cases kind with
              | dropIgnored =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | updateTerm =>
                  exact False.elim
                    (impossibleUnchanged
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | handleRequestVoteRequest =>
                  cases hbody : request.body with
                  | requestVoteRequest requestLastTerm requestLastIndex
                      requestIsPreVote =>
                      let grant :=
                        requestVoteGranted
                          witness.before
                          receiveDest
                          receiveSource
                          request.term
                          requestLastTerm
                          requestLastIndex
                      let response : Message :=
                        {
                          term := witness.before.currentTerm receiveDest
                          source := receiveDest
                          dest := receiveSource
                          body :=
                            .requestVoteResponse grant requestIsPreVote
                        }
                      exact False.elim
                        (impossibleNonAppendEntriesReply
                          response
                          request
                          (by
                            simp [next, rawNext, nextReceive, hmessage,
                              hbody, grant, response])
                          (by simp [response]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | handleRequestVoteResponse =>
                  cases hbody : request.body with
                  | requestVoteResponse voteGranted isPreVote =>
                      exact False.elim
                        (impossibleDiscard request
                          (by
                            cases voteGranted <;>
                              simp [next, rawNext, nextReceive, hmessage,
                                hbody]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | dropRequestVoteResponseOutOfState =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | dropRequestVoteResponseStale =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | rejectAppendEntriesRequest =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      cases responseCase :
                          appendEntriesRejectResponse?
                            witness.before
                            request
                            requestPreviousIndex
                            requestPreviousTerm with
                      | none =>
                          exact False.elim
                            (impossibleUnchanged
                              (by simp [next, rawNext, nextReceive, hmessage,
                                hbody, responseCase]))
                      | some response =>
                          have responseEndpoints :=
                            appendEntriesRejectResponse_endpoints_eq
                              witness.before
                              request
                              response
                              requestPreviousIndex
                              requestPreviousTerm
                              responseCase
                          exact
                            firstInserted_appendEntriesResponse_of_reply
                              witness
                              receiveDest
                              receiveSource
                              .reject
                              request
                              response
                              requestPreviousIndex
                              requestPreviousTerm
                              requestEntries
                              requestCommitIndex
                              (by
                                simpa [AEResponseKind.receiveKind] using
                                  actionEq)
                              hmessage
                              hbody
                              (by
                                simp [AEResponseKind.receiveKind, next,
                                  rawNext, nextReceive, hmessage, hbody,
                                  responseCase])
                              (responseEndpoints.1.trans
                                requestCoordinates.1)
                              (responseEndpoints.2.trans
                                requestCoordinates.2)
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | returnToFollower =>
                  cases hbody : request.body <;>
                    exact False.elim
                      (impossibleUnchanged
                        (by simp [next, rawNext, nextReceive, hmessage,
                          hbody]))
              | appendEntriesAlreadyDone =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      let response : Message :=
                        {
                          term :=
                            witness.before.currentTerm request.dest
                          source := request.dest
                          dest := request.source
                          body :=
                            .appendEntriesResponse true
                              (requestPreviousIndex + requestEntries.length)
                        }
                      exact
                        firstInserted_appendEntriesResponse_of_reply
                          witness
                          receiveDest
                          receiveSource
                          .alreadyDone
                          request
                          response
                          requestPreviousIndex
                          requestPreviousTerm
                          requestEntries
                          requestCommitIndex
                          (by
                            simpa [AEResponseKind.receiveKind] using
                              actionEq)
                          hmessage
                          hbody
                          (by
                            simp [AEResponseKind.receiveKind, next, rawNext,
                              nextReceive, hmessage, hbody,
                              nextAppendEntriesAlreadyDone, response])
                          (by
                            simpa [response] using requestCoordinates.1)
                          (by
                            simpa [response] using requestCoordinates.2)
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | appendEntriesNoConflict =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      let nextLog :=
                        (witness.before.log request.dest).take
                            requestPreviousIndex ++
                          requestEntries
                      let response : Message :=
                        {
                          term :=
                            witness.before.currentTerm request.dest
                          source := request.dest
                          dest := request.source
                          body :=
                            .appendEntriesResponse true nextLog.length
                        }
                      exact
                        firstInserted_appendEntriesResponse_of_reply
                          witness
                          receiveDest
                          receiveSource
                          .noConflict
                          request
                          response
                          requestPreviousIndex
                          requestPreviousTerm
                          requestEntries
                          requestCommitIndex
                          (by
                            simpa [AEResponseKind.receiveKind] using
                              actionEq)
                          hmessage
                          hbody
                          (by
                            simp [AEResponseKind.receiveKind, next, rawNext,
                              nextReceive, hmessage, hbody,
                              nextAppendEntriesNoConflict, nextLog,
                              response])
                          (by
                            simpa [response] using requestCoordinates.1)
                          (by
                            simpa [response] using requestCoordinates.2)
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | appendEntriesConflictThenAlreadyDone =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      let response : Message :=
                        {
                          term :=
                            witness.before.currentTerm request.dest
                          source := request.dest
                          dest := request.source
                          body :=
                            .appendEntriesResponse true
                              (requestPreviousIndex + requestEntries.length)
                        }
                      exact
                        firstInserted_appendEntriesResponse_of_reply
                          witness
                          receiveDest
                          receiveSource
                          .conflictThenAlreadyDone
                          request
                          response
                          requestPreviousIndex
                          requestPreviousTerm
                          requestEntries
                          requestCommitIndex
                          (by
                            simpa [AEResponseKind.receiveKind] using
                              actionEq)
                          hmessage
                          hbody
                          (by
                            simp [AEResponseKind.receiveKind, next, rawNext,
                              nextReceive, hmessage, hbody,
                              nextAppendEntriesAlreadyDone,
                              conflictRollback, response])
                          (by
                            simpa [response] using requestCoordinates.1)
                          (by
                            simpa [response] using requestCoordinates.2)
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | appendEntriesConflictThenNoConflict =>
                  cases hbody : request.body with
                  | appendEntriesRequest requestPreviousIndex
                      requestPreviousTerm requestEntries requestCommitIndex =>
                      let rolled :=
                        conflictRollback
                          witness.before
                          receiveDest
                          requestPreviousIndex
                      let nextLog :=
                        (rolled.log request.dest).take requestPreviousIndex ++
                          requestEntries
                      let response : Message :=
                        {
                          term :=
                            witness.before.currentTerm request.dest
                          source := request.dest
                          dest := request.source
                          body :=
                            .appendEntriesResponse true nextLog.length
                        }
                      exact
                        firstInserted_appendEntriesResponse_of_reply
                          witness
                          receiveDest
                          receiveSource
                          .conflictThenNoConflict
                          request
                          response
                          requestPreviousIndex
                          requestPreviousTerm
                          requestEntries
                          requestCommitIndex
                          (by
                            simpa [AEResponseKind.receiveKind] using
                              actionEq)
                          hmessage
                          hbody
                          (by
                            simp [AEResponseKind.receiveKind, next, rawNext,
                              nextReceive, hmessage, hbody,
                              nextAppendEntriesNoConflict, conflictRollback,
                              rolled, nextLog, response])
                          (by
                            simpa [response] using requestCoordinates.1)
                          (by
                            simpa [response] using requestCoordinates.2)
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | handleAppendEntriesResponseSuccess =>
                  cases hbody : request.body with
                  | appendEntriesResponse requestSuccess
                      requestLastLogIndex =>
                      exact False.elim
                        (impossibleDiscard request
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | handleAppendEntriesResponseFailure =>
                  cases hbody : request.body with
                  | appendEntriesResponse requestSuccess
                      requestLastLogIndex =>
                      exact False.elim
                        (impossibleDiscard request
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
                  | _ =>
                      exact False.elim
                        (impossibleUnchanged
                          (by simp [next, rawNext, nextReceive, hmessage,
                            hbody]))
              | dropAppendEntriesResponseOutOfState =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))
              | dropAppendEntriesResponseStale =>
                  exact False.elim
                    (impossibleDiscard request
                      (by simp [next, rawNext, nextReceive, hmessage]))

theorem reachable_hasAppendEntriesResponseHistory
    {start : InitialConfiguration}
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (AppendEntriesResponseHistoryConsistent
          start actions state) := by
  rcases reachable_hasCausalHistory reachable with
    ⟨actions, history, queues⟩
  exact
    ⟨actions,
      history,
      queueHistory_implies_AppendEntriesResponseHistoryConsistent queues⟩

private theorem queueHistory_implies_SuccessfulAckHistoryConsistent
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (queues : QueueHistoryConsistent start actions state) :
    SuccessfulAckHistoryConsistent start actions state := by
  intro dest source message lastLogIndex queued responseBody
  rcases queues dest source message queued with ⟨witness⟩
  cases actionEq : witness.action with
  | timeout candidate =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextTimeout] using
        witness.presentAfter
  | requestVote sendSource sendDest =>
      have inserted :=
        firstInsertion_enqueue_eq
          witness.before.messages
          (requestVoteMessage witness.before sendSource sendDest)
          message
          dest
          source
          witness.absentBefore
          (by
            simpa [actionEq, next, rawNext, nextRequestVote] using
              witness.presentAfter)
      rw [inserted.2.2] at responseBody
      simp [requestVoteMessage] at responseBody
  | appendEntries sendSource sendDest =>
      have inserted :=
        firstInsertion_enqueue_eq
          witness.before.messages
          (appendEntriesMessage witness.before sendSource sendDest)
          message
          dest
          source
          witness.absentBefore
          (by
            simpa [actionEq, next, rawNext, nextAppendEntries] using
              witness.presentAfter)
      rw [inserted.2.2] at responseBody
      simp [appendEntriesMessage] at responseBody
  | becomeLeader leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextBecomeLeader] using
        witness.presentAfter
  | clientRequest leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextClientRequest] using
        witness.presentAfter
  | signCommittableMessages leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext,
        nextSignCommittableMessages] using witness.presentAfter
  | changeConfiguration leader configuration =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextChangeConfiguration] using
        witness.presentAfter
  | advanceCommitIndex leader =>
      exfalso
      apply witness.absentBefore
      simpa [actionEq, next, rawNext, nextAdvanceCommitIndex] using
        witness.presentAfter
  | receive receiveDest receiveSource kind =>
      have insertionEnabled :
          Enabled witness.before
            (.receive receiveDest receiveSource kind) := by
        rcases witness.occurrence with ⟨occurrence⟩
        simpa [actionEq] using occurrence.enabled
      have presentAfter :
          message ∈
            (next witness.before
              (.receive receiveDest receiveSource kind)).messages
              dest source := by
        simpa [actionEq] using witness.presentAfter
      have impossibleUnchanged
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              witness.before.messages) :
          False := by
        apply witness.absentBefore
        rw [← messagesAfter]
        exact presentAfter
      have impossibleDiscard
          (discarded : Message)
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              Model.discard witness.before.messages discarded) :
          False := by
        apply witness.absentBefore
        exact mem_before_of_mem_discard
          witness.before.messages
          discarded
          message
          dest
          source
          (by
            rw [← messagesAfter]
            exact presentAfter)
      have impossibleNonSuccessfulReply
          (response request : Message)
          (messagesAfter :
            (next witness.before
                (.receive receiveDest receiveSource kind)).messages =
              reply witness.before.messages response request)
          (responseIsNotSuccessful :
            match response.body with
            | .appendEntriesResponse true _ => False
            | _ => True) :
          False := by
        have presentReply :
            message ∈
              (reply witness.before.messages response request)
                dest source := by
          rw [← messagesAfter]
          exact presentAfter
        rcases firstInsertion_reply_eq
            witness.before.messages
            response
            request
            message
            dest
            source
            witness.absentBefore
            presentReply with
          ⟨_, _, messageEq⟩
        rw [messageEq] at responseBody
        rw [responseBody] at responseIsNotSuccessful
        exact responseIsNotSuccessful
      cases hmessage :
          headMessage? witness.before receiveDest receiveSource with
      | none =>
          exact False.elim
            (impossibleUnchanged
              (by simp [next, rawNext, nextReceive, hmessage]))
      | some request =>
          have enabledFacts := insertionEnabled
          simp [Enabled, actionEnabled, hmessage] at enabledFacts
          have requestDest : request.dest = receiveDest :=
            enabledFacts.2.1.1
          have requestSource : request.source = receiveSource :=
            enabledFacts.2.1.2
          cases kind with
          | dropIgnored =>
              exact False.elim
                (impossibleDiscard request
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | updateTerm =>
              exact False.elim
                (impossibleUnchanged
                  (by simp [next, rawNext, nextReceive, hmessage]))
          | handleRequestVoteRequest =>
              cases hbody : request.body with
              | requestVoteRequest requestLastTerm requestLastIndex
                  requestIsPreVote =>
                  let grant :=
                    requestVoteGranted
                      witness.before
                      receiveDest
                      receiveSource
                      request.term
                      requestLastTerm
                      requestLastIndex
                  let response : Message :=
                    {
                      term := witness.before.currentTerm receiveDest
                      source := receiveDest
                      dest := receiveSource
                      body :=
                        .requestVoteResponse grant requestIsPreVote
                    }
                  exact False.elim
                    (impossibleNonSuccessfulReply
                      response
                      request
                      (by
