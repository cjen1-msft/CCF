theorem hasVoteHistory_step
    (state : State)
    (action : Action)
    (voteHistory : HasVoteHistory state)
    (enabled : Enabled state action) :
    HasVoteHistory (next state action) := by
  rcases voteHistory with ⟨owner, history⟩
  let update :=
    voteHistoryUpdate_step state action owner history enabled
  exact ⟨update.nextOwner, update.consistent⟩

theorem historicalVoteCore_append_step
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (core : HistoricalVoteCore start actions state)
    (action : Action)
    (enabled : Enabled state action) :
    HistoricalVoteCore
      start
      (actions ++ [action])
      (next state action) := by
  rcases core with ⟨owner, consistent, recorded⟩
  let update :=
    voteHistoryUpdate_step
      state action owner consistent enabled
  refine
    ⟨update.nextOwner,
      update.consistent,
      ?_⟩
  intro electionState leader occurrence voter counted
  rcases
      occurs_append_singleton_cases
        history enabled occurrence with
    oldOccurrence | currentOccurrence
  · exact update.preserves
      voter
      (electionState.currentTerm leader)
      leader
      (recorded
        electionState leader oldOccurrence voter counted)
  · rcases currentOccurrence with ⟨electionStateEq, actionEq⟩
    subst electionState
    subst action
    have enabledDetails := enabled
    simp [Enabled, actionEnabled] at enabledDetails
    exact update.preserves
      voter
      (state.currentTerm leader)
      leader
      (consistent.countedChoices
        leader voter
        (Or.inl enabledDetails.1.2)
        counted)

theorem reachable_hasHistoricalVoteCore
    (start : InitialConfiguration)
    {state : State}
    (reachable : Reachable start state) :
    Exists fun actions =>
      And
        (ProtocolHistory start actions state)
        (HistoricalVoteCore start actions state) := by
  apply
    ExecutableTransitionSystem.reachableInvariant
      (system start)
      (Invariant := fun current =>
        Exists fun actions =>
          And
            (ProtocolHistory start actions current)
            (HistoricalVoteCore start actions current))
  · exact
      ⟨[],
        rfl,
        initial_HistoricalVoteCore start⟩
  · intro current action historical enabled
    rcases historical with ⟨actions, history, core⟩
    exact
      ⟨actions ++ ([action] : List Action),
        replays_append_singleton history enabled,
        historicalVoteCore_append_step
          history core action enabled⟩
  · exact reachable

private theorem historicalElectionCores_imply_TemporalLeaderUniquenessInv_of_electedTermsNotStart
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (_history : ProtocolHistory start actions state)
    (votes : HistoricalVoteCore start actions state)
    (_leaders : LeaderHistoryConsistent start actions state)
    (overlap :
      ElectionConfigurationsOverlapInv start actions state)
    (electedTerms :
      HistoricalElectedTermsNotStartInv start actions state) :
    TemporalLeaderUniquenessInv start actions state := by
  rcases votes with ⟨owner, _currentVotes, recorded⟩
  intro firstState secondState firstAt secondAt
    firstLeader secondLeader firstIsLeader secondIsLeader sameTerm
  rcases firstAt with ⟨firstTrace⟩
  rcases secondAt with ⟨secondTrace⟩
  have firstLeaders :=
    protocolHistory_implies_LeaderHistoryConsistent
      firstTrace.stateHistory
  have secondLeaders :=
    protocolHistory_implies_LeaderHistoryConsistent
      secondTrace.stateHistory
  rcases firstLeaders firstLeader firstIsLeader with
    ⟨firstOrigin⟩
  rcases secondLeaders secondLeader secondIsLeader with
    ⟨secondOrigin⟩
  cases firstOrigin with
  | initial firstLeaderEq firstTermEq =>
      cases secondOrigin with
      | initial secondLeaderEq secondTermEq =>
          exact firstLeaderEq.trans secondLeaderEq.symm
      | elected secondElection =>
          have secondOccurrence :=
            occurs_extend_stateAtWitness
              secondTrace secondElection.occurrence
          have electionTermEq :
              secondElection.electionState.currentTerm secondLeader =
                startTerm :=
            secondElection.term_eq.symm.trans
              (sameTerm.symm.trans firstTermEq)
          exact False.elim
            (electedTerms
              secondElection.electionState
              secondLeader
              secondOccurrence
              electionTermEq)
  | elected firstElection =>
      cases secondOrigin with
      | initial secondLeaderEq secondTermEq =>
          have firstOccurrence :=
            occurs_extend_stateAtWitness
              firstTrace firstElection.occurrence
          have electionTermEq :
              firstElection.electionState.currentTerm firstLeader =
                startTerm :=
            firstElection.term_eq.symm.trans
              (sameTerm.trans secondTermEq)
          exact False.elim
            (electedTerms
              firstElection.electionState
              firstLeader
              firstOccurrence
              electionTermEq)
      | elected secondElection =>
          have firstOccurrence :=
            occurs_extend_stateAtWitness
              firstTrace firstElection.occurrence
          have secondOccurrence :=
            occurs_extend_stateAtWitness
              secondTrace secondElection.occurrence
          have electionTermsEq :
              firstElection.electionState.currentTerm firstLeader =
                secondElection.electionState.currentTerm secondLeader :=
            firstElection.term_eq.symm.trans
              (sameTerm.trans secondElection.term_eq)
          rcases overlap
              firstElection.electionState
              secondElection.electionState
              firstLeader
              secondLeader
              firstOccurrence
              secondOccurrence
              electionTermsEq with
            ⟨firstConfiguration, secondConfiguration,
              firstConfigurationMember,
              secondConfigurationMember,
              sameConfigurationNodes⟩
          have firstEnabled : Enabled
              firstElection.electionState
              (.becomeLeader firstLeader) := by
            rcases firstElection.occurrence with
              ⟨firstOccurrenceWitness⟩
            exact firstOccurrenceWitness.enabled
          have secondEnabled : Enabled
              secondElection.electionState
              (.becomeLeader secondLeader) := by
            rcases secondElection.occurrence with
              ⟨secondOccurrenceWitness⟩
            exact secondOccurrenceWitness.enabled
          have firstQuorum :=
            becomeLeader_enabled_configuration_quorum
              firstElection.electionState
              firstLeader
              firstConfiguration
              firstEnabled
              firstConfigurationMember
          have secondQuorum :=
            becomeLeader_enabled_configuration_quorum
              secondElection.electionState
              secondLeader
              secondConfiguration
              secondEnabled
              secondConfigurationMember
          have secondQuorumOnFirstConfiguration :
              isQuorum
                  (secondElection.electionState.votesGranted
                      secondLeader ∩ firstConfiguration.nodes)
                  firstConfiguration.nodes =
                true := by
            rw [sameConfigurationNodes]
            exact secondQuorum
          rcases isQuorum_intersects
              (firstElection.electionState.votesGranted
                firstLeader ∩ firstConfiguration.nodes)
              (secondElection.electionState.votesGranted
                secondLeader ∩ firstConfiguration.nodes)
              firstConfiguration.nodes
              firstQuorum
              secondQuorumOnFirstConfiguration with
            ⟨voter, firstMembership, secondMembership⟩
          simp only [Finset.mem_inter] at firstMembership secondMembership
          have firstOwner :=
            recorded
              firstElection.electionState
              firstLeader
              firstOccurrence
              voter
              firstMembership.1
          have secondOwner :=
            recorded
              secondElection.electionState
              secondLeader
              secondOccurrence
              voter
              secondMembership.1
          rw [electionTermsEq] at firstOwner
          exact Option.some.inj (firstOwner.symm.trans secondOwner)

private theorem appendEntriesMessage_prefix_eq
    {start : InitialConfiguration}
    {actions : List Action}
    {state sendState : State}
    {source dest : Node}
    (history : ProtocolHistory start actions state)
    (occurrence :
      Occurs
        start actions state sendState
        (.appendEntries source dest))
    (matching : TemporalLogMatchingInv start actions state)
    (accept :
      appendEntriesAcceptBase
          state
          dest
          (sendState.currentTerm source)
          (sendState.sentIndex source dest)
          (((entryAt?
                (sendState.log source)
                (sendState.sentIndex source dest)).map
              (·.term)).getD 0) =
        true)
    (payloadNonempty :
      subsequence
            (sendState.log source)
            (sendState.sentIndex source dest + 1)
            (min
              (sendState.log source).length
              (sendState.sentIndex source dest + 1)) ≠
          []) :
    And
      (sendState.currentTerm source = state.currentTerm dest)
      (logPrefix
          (state.log dest)
          (sendState.sentIndex source dest) =
        logPrefix
          (sendState.log source)
          (sendState.sentIndex source dest)) := by
  have acceptFacts := accept
  simp [appendEntriesAcceptBase] at acceptFacts
  constructor
  · exact acceptFacts.1.1.1
  · let previousIndex := sendState.sentIndex source dest
    by_cases zeroPrevious : previousIndex = 0
    · have actualZero : sendState.sentIndex source dest = 0 := by
        simpa [previousIndex] using zeroPrevious
      simp [actualZero, logPrefix]
    · have positivePrevious : 1 <= previousIndex := by
        omega
      have senderBeforeEnd :
          previousIndex < (sendState.log source).length := by
        exact previousIndex_lt_of_next_subsequence_nonempty
          (sendState.log source)
          previousIndex
          (by simpa [previousIndex] using payloadNonempty)
      have logOK :
          appendEntriesLogOK
              state
              dest
              previousIndex
              (((entryAt?
                    (sendState.log source)
                    previousIndex).map
                  (·.term)).getD 0) =
            true := by
        simpa [previousIndex] using acceptFacts.1.2
      have logOKFacts := logOK
      simp [appendEntriesLogOK, zeroPrevious] at logOKFacts
      rcases entryAt?_exists_of_positive_within
          (sendState.log source)
          previousIndex
          positivePrevious
          (Nat.le_of_lt senderBeforeEnd) with
        ⟨senderEntry, senderEntryAt⟩
      cases receiverEntryAt :
          entryAt? (state.log dest) previousIndex with
      | none =>
          simp [receiverEntryAt] at logOKFacts
      | some receiverEntry =>
          have sameTerm :
              (entryAt?
                    (state.log dest)
                    previousIndex).map
                  (·.term) =
                (entryAt?
                    (sendState.log source)
                    previousIndex).map
                  (·.term) := by
            simpa [receiverEntryAt, senderEntryAt] using logOKFacts.2
          exact matching
            state
            sendState
            (protocolHistory_final_stateAt history)
            (occurs_before_stateAt occurrence)
            dest
            source
            previousIndex
            positivePrevious
            (Nat.le_min.mpr
              ⟨logOKFacts.1,
                Nat.le_of_lt senderBeforeEnd⟩)
            sameTerm

private theorem appendEntriesMessage_result_log_eq
    (sendState receiverState : State)
    (source dest : Node)
    (prefixEq :
      logPrefix
          (receiverState.log dest)
          (sendState.sentIndex source dest) =
        logPrefix
          (sendState.log source)
          (sendState.sentIndex source dest)) :
    (nextAppendEntriesNoConflict
        receiverState
        (appendEntriesMessage sendState source dest)
        (sendState.sentIndex source dest)
        (subsequence
          (sendState.log source)
          (sendState.sentIndex source dest + 1)
          (min
            (sendState.log source).length
            (sendState.sentIndex source dest + 1)))
        (sendState.commitIndex source)).log dest =
      (sendState.log source).take
        (sendState.sentIndex source dest + 1) := by
  let previousIndex := sendState.sentIndex source dest
  let payload :=
    subsequence
      (sendState.log source)
      (previousIndex + 1)
      (min (sendState.log source).length (previousIndex + 1))
  have resultLogEq :
      (receiverState.log dest).take previousIndex ++ payload =
        (sendState.log source).take (previousIndex + 1) := by
    calc
      (receiverState.log dest).take previousIndex ++ payload =
          (sendState.log source).take previousIndex ++ payload := by
        simpa [logPrefix, previousIndex, payload] using
          congrArg (· ++ payload) prefixEq
      _ = (sendState.log source).take (previousIndex + 1) := by
        exact logPrefix_append_next_subsequence
          (sendState.log source)
          previousIndex
  simpa [nextAppendEntriesNoConflict, appendEntriesMessage,
    previousIndex, payload] using resultLogEq

private theorem appendEntriesMessage_result_monoLog
    (sendState receiverState : State)
    (source dest : Node)
    (senderMono : MonoLogInv sendState)
    (termEq :
      sendState.currentTerm source =
        receiverState.currentTerm dest)
    (prefixEq :
      logPrefix
          (receiverState.log dest)
          (sendState.sentIndex source dest) =
        logPrefix
          (sendState.log source)
          (sendState.sentIndex source dest)) :
    NodeMonoLogInv
      (nextAppendEntriesNoConflict
        receiverState
        (appendEntriesMessage sendState source dest)
        (sendState.sentIndex source dest)
        (subsequence
          (sendState.log source)
          (sendState.sentIndex source dest + 1)
          (min
            (sendState.log source).length
            (sendState.sentIndex source dest + 1)))
        (sendState.commitIndex source))
      dest := by
  let previousIndex := sendState.sentIndex source dest
  let payload :=
    subsequence
      (sendState.log source)
      (previousIndex + 1)
      (min (sendState.log source).length (previousIndex + 1))
  have resultLogEq :
      (receiverState.log dest).take previousIndex ++ payload =
        (sendState.log source).take (previousIndex + 1) := by
    calc
      (receiverState.log dest).take previousIndex ++ payload =
          (sendState.log source).take previousIndex ++ payload := by
        simpa [logPrefix, previousIndex, payload] using
          congrArg (· ++ payload) prefixEq
      _ = (sendState.log source).take (previousIndex + 1) := by
        exact logPrefix_append_next_subsequence
          (sendState.log source)
          previousIndex
  have prefixMono :
      ((sendState.log source).take (previousIndex + 1) != []) ->
        And
          ((((sendState.log source).take
                (previousIndex + 1)).getLast?.map
              (·.term)).getD 0 <=
            receiverState.currentTerm dest)
          (monoLogEntries
            ((sendState.log source).take (previousIndex + 1))) := by
    intro prefixNonempty
    have senderNonempty : sendState.log source != [] := by
      cases senderLogEq : sendState.log source with
      | nil =>
          simp [senderLogEq] at prefixNonempty
          exact Bool.noConfusion prefixNonempty
      | cons first rest =>
          rfl
    have nodeMono := senderMono source senderNonempty
    exact
      (monoLog_take_list
        (sendState.log source)
        (receiverState.currentTerm dest)
        (previousIndex + 1)
        (by simpa [termEq] using nodeMono.1)
        nodeMono.2)
        prefixNonempty
  simpa [NodeMonoLogInv, nextAppendEntriesNoConflict, updateNode,
    appendEntriesMessage, previousIndex, payload, resultLogEq] using
      prefixMono

theorem protocolHistory_implies_AppendEntriesLogSafetyInv
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (historicalMono :
      HistoricalMonoLogInv start actions state)
    (matching :
      TemporalLogMatchingInv start actions state) :
    AppendEntriesLogSafetyInv state := by
  intro dest source message queued
  cases bodyEq : message.body with
  | requestVoteRequest lastTerm lastIndex isPreVote =>
      trivial
  | requestVoteResponse voteGranted isPreVote =>
      trivial
  | appendEntriesResponse success lastLogIndex =>
      trivial
  | appendEntriesRequest previousIndex previousTerm entries
      leaderCommitIndex =>
      have provenance :
          MessageHasAESendWitness
            start actions state dest source message := by
        simpa [bodyEq] using requests dest source message queued
      rcases provenance with ⟨witness⟩
      rcases witness with ⟨sendState, occurrence, messageEq⟩
      subst message
      simp [appendEntriesMessage] at bodyEq
      rcases bodyEq with
        ⟨previousIndexEq, previousTermEq, entriesEq, leaderCommitIndexEq⟩
      subst previousIndex
      subst previousTerm
      subst entries
      subst leaderCommitIndex
      constructor
      · intro accept noConflict
        have noConflictFacts := noConflict
        simp [appendEntriesNoConflictGuard] at noConflictFacts
        have sendFacts :=
          appendEntriesMessage_prefix_eq
            history
            occurrence
            matching
            accept
            noConflictFacts.1.1.1
        exact appendEntriesMessage_result_monoLog
          sendState
          state
          source
          dest
          (historicalMono
            sendState
            (occurs_before_stateAt occurrence))
          sendFacts.1
          sendFacts.2
      · intro accept _conflict noConflict
        have noConflictFacts := noConflict
        simp [appendEntriesNoConflictGuard] at noConflictFacts
        have sendFacts :=
          appendEntriesMessage_prefix_eq
            history
            occurrence
            matching
            accept
            noConflictFacts.1.1.1
        have rolledTermEq :
            sendState.currentTerm source =
              (conflictRollback
                state dest
                (sendState.sentIndex source dest)).currentTerm dest := by
          simpa [conflictRollback] using sendFacts.1
        have rolledPrefixEq :
            logPrefix
                ((conflictRollback
                    state dest
                    (sendState.sentIndex source dest)).log dest)
                (sendState.sentIndex source dest) =
              logPrefix
                (sendState.log source)
                (sendState.sentIndex source dest) := by
          simpa [conflictRollback, updateNode, logPrefix,
            List.take_take] using
            sendFacts.2
        exact appendEntriesMessage_result_monoLog
          sendState
          (conflictRollback
            state dest
            (sendState.sentIndex source dest))
          source
          dest
          (historicalMono
            sendState
            (occurs_before_stateAt occurrence))
          rolledTermEq
          rolledPrefixEq

theorem monoTerm_step
    (state : State)
    (action : Action)
    (monoTerm : MonoTermInv state)
    (monoLog : MonoLogInv state)
    (logTerms : LogTermsAtLeastStartInv state)
    (enabled : Enabled state action) :
    MonoTermInv (next state action) := by
  cases action with
  | timeout candidate =>
      apply monoTerm_of_currentTerm_mono state _ monoTerm
      · rfl
      · intro node
        by_cases nodeIsCandidate : node = candidate
        · subst node
          simp [next, rawNext, nextTimeout]
        · simp [next, rawNext, nextTimeout, nodeIsCandidate]
  | requestVote source dest =>
      intro queuedDest queuedSource queued queuedMem
      simpa [next, rawNext, nextRequestVote] using
        enqueue_preserves_MonoTermInv
          state
          (requestVoteMessage state source dest)
          monoTerm
          (by simp [requestVoteMessage])
          queuedDest queuedSource queued queuedMem
  | appendEntries source dest =>
      intro queuedDest queuedSource queued queuedMem
      simpa [next, rawNext, nextAppendEntries] using
        enqueue_preserves_MonoTermInv
          state
          (appendEntriesMessage state source dest)
          monoTerm
          (by simp [appendEntriesMessage])
          queuedDest queuedSource queued queuedMem
  | becomeLeader leader =>
      apply monoTerm_of_currentTerm_mono state _ monoTerm
      · rfl
      · intro node
        simp [next, rawNext, nextBecomeLeader]
  | clientRequest leader =>
      apply monoTerm_of_currentTerm_mono state _ monoTerm
      · rfl
      · intro node
        simp [next, rawNext, nextClientRequest]
  | signCommittableMessages leader =>
      apply monoTerm_of_currentTerm_mono state _ monoTerm
      · rfl
      · intro node
        simp [next, rawNext, nextSignCommittableMessages]
  | changeConfiguration leader configuration =>
      apply monoTerm_of_currentTerm_mono state _ monoTerm
      · rfl
      · intro node
        simp [next, rawNext, nextChangeConfiguration]
  | advanceCommitIndex leader =>
      apply monoTerm_of_currentTerm_mono state _ monoTerm
      · rfl
      · intro node
        simp [next, rawNext, nextAdvanceCommitIndex]
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [next, rawNext, nextReceive, hmessage] using monoTerm
      | some message =>
          have enabledDetails := enabled
          simp [Enabled, actionEnabled, hmessage] at enabledDetails
          have destMatches : message.dest = dest := enabledDetails.2.1.1
          have sourceMatches : message.source = source :=
            enabledDetails.2.1.2
          cases kind with
          | updateTerm =>
              apply monoTerm_of_currentTerm_mono state _ monoTerm
              · simp [next, rawNext, nextReceive, hmessage]
              · intro node
                have newerTerm :
                    state.currentTerm message.dest < message.term := by
                  simpa [receiveBranchEnabled, updateTermEnabled] using
                    enabledDetails.2.2
                by_cases nodeIsDest : node = dest
                · subst node
                  simpa [next, rawNext, nextReceive, hmessage,
                    destMatches] using Nat.le_of_lt newerTerm
                · simp [next, rawNext, nextReceive, hmessage,
                    nodeIsDest]
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  let grant :=
                    requestVoteGranted
                      state dest source message.term lastTerm lastIndex
                  let response : Message :=
                    {
                      term := state.currentTerm dest
                      source := dest
                      dest := source
                      body := .requestVoteResponse grant isPreVote
                    }
                  apply monoTerm_of_reply
                    state _ response message monoTerm (by simp [response])
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      grant, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    destMatches, sourceMatches] using
                    monoTerm
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        destMatches, sourceMatches, responseCase] using monoTerm
                  | some response =>
                      apply monoTerm_of_reply
                        state _ response message monoTerm
                        (appendEntriesRejectResponse_term_le_current
                          state
                          message
                          response
                          previousIndex
                          previousTerm
                          monoLog
                          logTerms
                          responseCase)
                      · simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
                      · simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    destMatches, sourceMatches] using
                    monoTerm
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let response : Message :=
                    {
                      term := state.currentTerm dest
                      source := dest
                      dest := source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply monoTerm_of_reply
                    state _ response message monoTerm (by simp [response])
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      destMatches, sourceMatches,
                      nextAppendEntriesAlreadyDone, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    destMatches, sourceMatches] using
                    monoTerm
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let nextLog :=
                    (state.log dest).take previousIndex ++ entries
                  let response : Message :=
                    {
                      term := state.currentTerm dest
                      source := dest
                      dest := source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply monoTerm_of_reply
                    state _ response message monoTerm (by simp [response])
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      destMatches, sourceMatches,
                      nextAppendEntriesNoConflict, nextLog, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    destMatches, sourceMatches] using
                    monoTerm
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let response : Message :=
                    {
                      term := state.currentTerm dest
                      source := dest
                      dest := source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply monoTerm_of_reply
                    state _ response message monoTerm (by simp [response])
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      destMatches, sourceMatches,
                      nextAppendEntriesAlreadyDone, conflictRollback,
                      response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    destMatches, sourceMatches] using
                    monoTerm
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let rolled := conflictRollback state dest previousIndex
                  let nextLog := (rolled.log dest).take previousIndex ++ entries
                  let response : Message :=
                    {
                      term := state.currentTerm dest
                      source := dest
                      dest := source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply monoTerm_of_reply
                    state _ response message monoTerm (by simp [response])
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      destMatches, sourceMatches,
                      nextAppendEntriesNoConflict, conflictRollback, rolled,
                      nextLog, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    destMatches, sourceMatches] using
                    monoTerm
          | returnToFollower =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  destMatches, sourceMatches, MonoTermInv] using monoTerm
          | dropIgnored =>
              apply monoTerm_of_discard state _ message monoTerm
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]
          | handleRequestVoteResponse =>
              cases hbody : message.body with
              | requestVoteResponse voteGranted isPreVote =>
                  apply monoTerm_of_discard state _ message monoTerm
                  · cases voteGranted <;>
                      simp [next, rawNext, nextReceive, hmessage, hbody]
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    MonoTermInv] using monoTerm
          | dropRequestVoteResponseOutOfState =>
              apply monoTerm_of_discard state _ message monoTerm
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]
          | dropRequestVoteResponseStale =>
              apply monoTerm_of_discard state _ message monoTerm
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply monoTerm_of_discard state _ message monoTerm
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    MonoTermInv] using monoTerm
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply monoTerm_of_discard state _ message monoTerm
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
                  · simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody,
                    MonoTermInv] using monoTerm
          | dropAppendEntriesResponseOutOfState =>
              apply monoTerm_of_discard state _ message monoTerm
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]
          | dropAppendEntriesResponseStale =>
              apply monoTerm_of_discard state _ message monoTerm
              · simp [next, rawNext, nextReceive, hmessage]
              · simp [next, rawNext, nextReceive, hmessage]

theorem messageEntriesAtLeastStart_step
    (state : State)
    (action : Action)
    (messageEntries : MessageEntriesAtLeastStartInv state)
    (logTerms : LogTermsAtLeastStartInv state) :
    MessageEntriesAtLeastStartInv (next state action) := by
  cases action with
  | timeout candidate =>
      simpa [MessageEntriesAtLeastStartInv, next, rawNext, nextTimeout] using
        messageEntries
  | requestVote source dest =>
      intro queuedDest queuedSource queued queuedMem
      simpa [next, rawNext, nextRequestVote] using
        enqueue_preserves_message_property
          state.messages
          (requestVoteMessage state source dest)
          messageEntries
          (by simp [MessageEntriesAtLeastStart, requestVoteMessage])
          queuedDest queuedSource queued queuedMem
  | appendEntries source dest =>
      intro queuedDest queuedSource queued queuedMem
      simpa [next, rawNext, nextAppendEntries] using
        enqueue_preserves_message_property
          state.messages
          (appendEntriesMessage state source dest)
          messageEntries
          (appendEntriesMessage_entries_at_least_start
            state source dest logTerms)
          queuedDest queuedSource queued queuedMem
  | becomeLeader leader =>
      simpa [MessageEntriesAtLeastStartInv, next, rawNext,
        nextBecomeLeader] using messageEntries
  | clientRequest leader =>
      simpa [MessageEntriesAtLeastStartInv, next, rawNext,
        nextClientRequest] using messageEntries
  | signCommittableMessages leader =>
      simpa [MessageEntriesAtLeastStartInv, next, rawNext,
        nextSignCommittableMessages] using messageEntries
  | changeConfiguration leader configuration =>
      simpa [MessageEntriesAtLeastStartInv, next, rawNext,
        nextChangeConfiguration] using messageEntries
  | advanceCommitIndex leader =>
      simpa [MessageEntriesAtLeastStartInv, next, rawNext,
        nextAdvanceCommitIndex] using messageEntries
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [MessageEntriesAtLeastStartInv, next, rawNext, nextReceive,
            hmessage] using messageEntries
      | some message =>
          cases kind with
          | updateTerm =>
              simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                nextReceive, hmessage] using messageEntries
          | returnToFollower =>
              cases hbody : message.body <;>
                simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                  nextReceive, hmessage, hbody] using messageEntries
          | dropIgnored =>
              apply messageEntries_of_discard state _ message messageEntries
              simp [next, rawNext, nextReceive, hmessage]
          | handleRequestVoteResponse =>
              cases hbody : message.body with
              | requestVoteResponse voteGranted isPreVote =>
                  apply messageEntries_of_discard
                    state _ message messageEntries
                  cases voteGranted <;>
                    simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries
          | dropRequestVoteResponseOutOfState =>
              apply messageEntries_of_discard state _ message messageEntries
              simp [next, rawNext, nextReceive, hmessage]
          | dropRequestVoteResponseStale =>
              apply messageEntries_of_discard state _ message messageEntries
              simp [next, rawNext, nextReceive, hmessage]
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply messageEntries_of_discard
                    state _ message messageEntries
                  simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply messageEntries_of_discard
                    state _ message messageEntries
                  simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries
          | dropAppendEntriesResponseOutOfState =>
              apply messageEntries_of_discard state _ message messageEntries
              simp [next, rawNext, nextReceive, hmessage]
          | dropAppendEntriesResponseStale =>
              apply messageEntries_of_discard state _ message messageEntries
              simp [next, rawNext, nextReceive, hmessage]
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  let grant :=
                    requestVoteGranted
                      state dest source message.term lastTerm lastIndex
                  let response : Message :=
                    {
                      term := state.currentTerm dest
                      source := dest
                      dest := source
                      body := .requestVoteResponse grant isPreVote
                    }
                  apply messageEntries_of_reply
                    state _ response message messageEntries
                  · simp [MessageEntriesAtLeastStart, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      grant, response]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                        nextReceive, hmessage, hbody, responseCase] using
                        messageEntries
                  | some response =>
                      apply messageEntries_of_reply
                        state _ response message messageEntries
                      · exact
                          appendEntriesRejectResponse_entries_at_least_start
                            state
                            message
                            response
                            previousIndex
                            previousTerm
                            responseCase
                      · simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply messageEntries_of_reply
                    state _ response message messageEntries
                  · simp [MessageEntriesAtLeastStart, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, response]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let nextLog :=
                    (state.log message.dest).take previousIndex ++ entries
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply messageEntries_of_reply
                    state _ response message messageEntries
                  · simp [MessageEntriesAtLeastStart, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, nextLog, response]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply messageEntries_of_reply
                    state _ response message messageEntries
                  · simp [MessageEntriesAtLeastStart, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback, response]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let rolled := conflictRollback state dest previousIndex
                  let nextLog := (rolled.log message.dest).take previousIndex ++
                    entries
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply messageEntries_of_reply
                    state _ response message messageEntries
                  · simp [MessageEntriesAtLeastStart, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback, rolled,
                      nextLog, response]
              | _ =>
                  simpa [MessageEntriesAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageEntries

theorem appendEntriesPayloadTerm_step
    (state : State)
    (action : Action)
    (monoLog : MonoLogInv state)
    (payloadTerms : AppendEntriesPayloadTermInv state) :
    AppendEntriesPayloadTermInv (next state action) := by
  have payloadOfDiscard :
      forall after message,
        after.messages = Model.discard state.messages message ->
          AppendEntriesPayloadTermInv after := by
    intro after message messagesAfter dest source queued queuedMem
    rw [messagesAfter] at queuedMem
    exact discard_preserves_message_property
      state.messages message payloadTerms
      dest source queued queuedMem
  have payloadOfReply :
      forall after response request,
        MessageEntriesAtMostMessageTerm response ->
          after.messages = reply state.messages response request ->
            AppendEntriesPayloadTermInv after := by
    intro after response request responsePayload messagesAfter
      dest source queued queuedMem
    rw [messagesAfter] at queuedMem
    exact reply_preserves_message_property
      state.messages response request payloadTerms responsePayload
      dest source queued queuedMem
  cases action with
  | timeout candidate =>
      simpa [AppendEntriesPayloadTermInv, next, rawNext, nextTimeout] using
        payloadTerms
  | requestVote source dest =>
      intro queuedDest queuedSource queued queuedMem
      simpa [next, rawNext, nextRequestVote] using
        enqueue_preserves_message_property
          state.messages
          (requestVoteMessage state source dest)
          payloadTerms
          (by
            simp [MessageEntriesAtMostMessageTerm, requestVoteMessage])
          queuedDest queuedSource queued queuedMem
  | appendEntries source dest =>
      intro queuedDest queuedSource queued queuedMem
      simpa [next, rawNext, nextAppendEntries] using
        enqueue_preserves_message_property
          state.messages
          (appendEntriesMessage state source dest)
          payloadTerms
          (appendEntriesMessage_entries_at_most_message_term
            state source dest monoLog)
          queuedDest queuedSource queued queuedMem
  | becomeLeader leader =>
      simpa [AppendEntriesPayloadTermInv, next, rawNext,
        nextBecomeLeader] using payloadTerms
  | clientRequest leader =>
      simpa [AppendEntriesPayloadTermInv, next, rawNext,
        nextClientRequest] using payloadTerms
  | signCommittableMessages leader =>
      simpa [AppendEntriesPayloadTermInv, next, rawNext,
        nextSignCommittableMessages] using payloadTerms
  | changeConfiguration leader configuration =>
      simpa [AppendEntriesPayloadTermInv, next, rawNext,
        nextChangeConfiguration] using payloadTerms
  | advanceCommitIndex leader =>
      simpa [AppendEntriesPayloadTermInv, next, rawNext,
        nextAdvanceCommitIndex] using payloadTerms
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [AppendEntriesPayloadTermInv, next, rawNext, nextReceive,
            hmessage] using payloadTerms
      | some message =>
          cases kind with
          | updateTerm =>
              simpa [AppendEntriesPayloadTermInv, next, rawNext,
                nextReceive, hmessage] using payloadTerms
          | returnToFollower =>
              cases hbody : message.body <;>
                simpa [AppendEntriesPayloadTermInv, next, rawNext,
                  nextReceive, hmessage, hbody] using payloadTerms
          | dropIgnored =>
              apply payloadOfDiscard _ message
              simp [next, rawNext, nextReceive, hmessage]
          | handleRequestVoteResponse =>
              cases hbody : message.body with
              | requestVoteResponse voteGranted isPreVote =>
                  apply payloadOfDiscard _ message
                  cases voteGranted <;>
                    simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms
          | dropRequestVoteResponseOutOfState =>
              apply payloadOfDiscard _ message
              simp [next, rawNext, nextReceive, hmessage]
          | dropRequestVoteResponseStale =>
              apply payloadOfDiscard _ message
              simp [next, rawNext, nextReceive, hmessage]
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply payloadOfDiscard _ message
                  simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply payloadOfDiscard _ message
                  simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms
          | dropAppendEntriesResponseOutOfState =>
              apply payloadOfDiscard _ message
              simp [next, rawNext, nextReceive, hmessage]
          | dropAppendEntriesResponseStale =>
              apply payloadOfDiscard _ message
              simp [next, rawNext, nextReceive, hmessage]
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  let grant :=
                    requestVoteGranted
                      state dest source message.term lastTerm lastIndex
                  let response : Message :=
                    {
                      term := state.currentTerm dest
                      source := dest
                      dest := source
                      body := .requestVoteResponse grant isPreVote
                    }
                  apply payloadOfReply _ response message
                  · simp [MessageEntriesAtMostMessageTerm, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      grant, response]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      simpa [AppendEntriesPayloadTermInv, next, rawNext,
                        nextReceive, hmessage, hbody, responseCase] using
                        payloadTerms
                  | some response =>
                      apply payloadOfReply _ response message
                      · exact
                          appendEntriesRejectResponse_entries_at_most_message_term
                            state
                            message
                            response
                            previousIndex
                            previousTerm
                            responseCase
                      · simp [next, rawNext, nextReceive, hmessage, hbody,
                          responseCase]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply payloadOfReply _ response message
                  · simp [MessageEntriesAtMostMessageTerm, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, response]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let nextLog :=
                    (state.log message.dest).take previousIndex ++ entries
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply payloadOfReply _ response message
                  · simp [MessageEntriesAtMostMessageTerm, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, nextLog, response]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply payloadOfReply _ response message
                  · simp [MessageEntriesAtMostMessageTerm, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback, response]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  let rolled := conflictRollback state dest previousIndex
                  let nextLog := (rolled.log message.dest).take previousIndex ++
                    entries
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply payloadOfReply _ response message
                  · simp [MessageEntriesAtMostMessageTerm, response]
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback, rolled,
                      nextLog, response]
              | _ =>
                  simpa [AppendEntriesPayloadTermInv, next, rawNext,
                    nextReceive, hmessage, hbody] using payloadTerms

theorem messageTermAtLeastStart_step
    (state : State)
    (action : Action)
    (activeRoles : ActiveRoleTermInv state)
    (messageTerms : MessageTermAtLeastStartInv state)
    (logTerms : LogTermsAtLeastStartInv state)
    (enabled : Enabled state action) :
    MessageTermAtLeastStartInv (next state action) := by
  cases action with
  | timeout candidate =>
      simpa [MessageTermAtLeastStartInv, next, rawNext, nextTimeout] using
        messageTerms
  | requestVote source dest =>
      have requestEnabled := enabled
      simp [Enabled, actionEnabled] at requestEnabled
      have sourceActive :
          state.leadershipState source != .none := by
        have role := requestEnabled.1.2
        rw [role]
        decide
      intro queuedDest queuedSource queued queuedMem
      simpa [next, rawNext, nextRequestVote] using
        enqueue_preserves_message_property
          state.messages
          (requestVoteMessage state source dest)
          messageTerms
          (by
            simp [requestVoteMessage]
            exact activeRoles source sourceActive)
          queuedDest queuedSource queued queuedMem
  | appendEntries source dest =>
      have appendEnabled := enabled
      simp [Enabled, actionEnabled] at appendEnabled
      have sourceActive :
          state.leadershipState source != .none := by
        have role := appendEnabled.1.1.2
        rw [role]
        decide
      intro queuedDest queuedSource queued queuedMem
      simpa [next, rawNext, nextAppendEntries] using
        enqueue_preserves_message_property
          state.messages
          (appendEntriesMessage state source dest)
          messageTerms
          (by
            simp [appendEntriesMessage]
            exact activeRoles source sourceActive)
          queuedDest queuedSource queued queuedMem
  | becomeLeader leader =>
      simpa [MessageTermAtLeastStartInv, next, rawNext,
        nextBecomeLeader] using messageTerms
  | clientRequest leader =>
      simpa [MessageTermAtLeastStartInv, next, rawNext,
        nextClientRequest] using messageTerms
  | signCommittableMessages leader =>
      simpa [MessageTermAtLeastStartInv, next, rawNext,
        nextSignCommittableMessages] using messageTerms
  | changeConfiguration leader configuration =>
      simpa [MessageTermAtLeastStartInv, next, rawNext,
        nextChangeConfiguration] using messageTerms
  | advanceCommitIndex leader =>
      simpa [MessageTermAtLeastStartInv, next, rawNext,
        nextAdvanceCommitIndex] using messageTerms
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [MessageTermAtLeastStartInv, next, rawNext, nextReceive,
            hmessage] using messageTerms
      | some message =>
          have messageQueued :=
            headMessage?_mem state dest source message hmessage
          have incomingTerm :=
            messageTerms dest source message messageQueued
          cases kind with
          | updateTerm =>
              simpa [MessageTermAtLeastStartInv, next, rawNext, nextReceive,
                hmessage] using messageTerms
          | returnToFollower =>
              cases hbody : message.body <;>
                simpa [MessageTermAtLeastStartInv, next, rawNext,
                  nextReceive, hmessage, hbody] using messageTerms
          | dropIgnored =>
              apply messageTerm_of_discard state _ message messageTerms
              simp [next, rawNext, nextReceive, hmessage]
          | handleRequestVoteResponse =>
              cases hbody : message.body with
              | requestVoteResponse voteGranted isPreVote =>
                  apply messageTerm_of_discard state _ message messageTerms
                  cases voteGranted <;>
                    simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms
          | dropRequestVoteResponseOutOfState =>
              apply messageTerm_of_discard state _ message messageTerms
              simp [next, rawNext, nextReceive, hmessage]
          | dropRequestVoteResponseStale =>
              apply messageTerm_of_discard state _ message messageTerms
              simp [next, rawNext, nextReceive, hmessage]
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply messageTerm_of_discard state _ message messageTerms
                  simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body with
              | appendEntriesResponse success lastLogIndex =>
                  apply messageTerm_of_discard state _ message messageTerms
                  simp [next, rawNext, nextReceive, hmessage, hbody]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms
          | dropAppendEntriesResponseOutOfState =>
              apply messageTerm_of_discard state _ message messageTerms
              simp [next, rawNext, nextReceive, hmessage]
          | dropAppendEntriesResponseStale =>
              apply messageTerm_of_discard state _ message messageTerms
              simp [next, rawNext, nextReceive, hmessage]
          | handleRequestVoteRequest =>
              cases hbody : message.body with
              | requestVoteRequest lastTerm lastIndex isPreVote =>
                  have handlerEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at handlerEnabled
                  let grant :=
                    requestVoteGranted
                      state dest source message.term lastTerm lastIndex
                  let response : Message :=
                    {
                      term := state.currentTerm dest
                      source := dest
                      dest := source
                      body := .requestVoteResponse grant isPreVote
                    }
                  have currentStart :
                      startTerm <= state.currentTerm dest := by
                    have termLeCurrent :=
                      Nat.le_trans incomingTerm handlerEnabled.2.2
                    rw [handlerEnabled.2.1.1] at termLeCurrent
                    exact termLeCurrent
                  apply messageTerm_of_reply
                    state _ response message messageTerms
                  · simpa [response] using currentStart
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      grant, response]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      simpa [MessageTermAtLeastStartInv, next, rawNext,
                        nextReceive, hmessage, hbody, responseCase] using
                        messageTerms
                  | some response =>
                      apply messageTerm_of_reply
                        state _ response message messageTerms
                        (appendEntriesRejectResponse_term_ge_start
                          state
                          message
                          response
                          previousIndex
                          previousTerm
                          logTerms
                          incomingTerm
                          responseCase)
                      simp [next, rawNext, nextReceive, hmessage, hbody,
                        responseCase]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms
          | appendEntriesAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply messageTerm_of_reply
                    state _ response message messageTerms
                  · simp [response]
                    omega
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, response]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  let nextLog :=
                    (state.log message.dest).take previousIndex ++ entries
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply messageTerm_of_reply
                    state _ response message messageTerms
                  · simp [response]
                    omega
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, nextLog, response]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body :=
                        .appendEntriesResponse true
                          (previousIndex + entries.length)
                    }
                  apply messageTerm_of_reply
                    state _ response message messageTerms
                  · simp [response]
                    omega
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback, response]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  let rolled := conflictRollback state dest previousIndex
                  let nextLog := (rolled.log message.dest).take previousIndex ++
                    entries
                  let response : Message :=
                    {
                      term := state.currentTerm message.dest
                      source := message.dest
                      dest := message.source
                      body := .appendEntriesResponse true nextLog.length
                    }
                  apply messageTerm_of_reply
                    state _ response message messageTerms
                  · simp [response]
                    omega
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback, rolled,
                      nextLog, response]
              | _ =>
                  simpa [MessageTermAtLeastStartInv, next, rawNext,
                    nextReceive, hmessage, hbody] using messageTerms

theorem activeRoleTerm_step
    (state : State)
    (action : Action)
    (activeRoles : ActiveRoleTermInv state)
    (messageTerms : MessageTermAtLeastStartInv state)
    (enabled : Enabled state action) :
    ActiveRoleTermInv (next state action) := by
  cases action with
  | timeout candidate =>
      have timeoutEnabled := enabled
      simp [Enabled, actionEnabled] at timeoutEnabled
      have candidateWasActive :
          state.leadershipState candidate != .none := by
        rcases timeoutEnabled.2 with follower | candidateState
        · rw [follower]
          decide
        · rw [candidateState]
          decide
      intro node activeAfter
      by_cases nodeIsCandidate : node = candidate
      · subst node
        simp [next, rawNext, nextTimeout]
        exact Nat.le_trans
          (activeRoles candidate candidateWasActive)
          (Nat.le_succ _)
      · have beforeActive :
            state.leadershipState node != .none := by
          simpa [next, rawNext, nextTimeout, nodeIsCandidate] using
            activeAfter
        simpa [next, rawNext, nextTimeout, nodeIsCandidate] using
          activeRoles node beforeActive
  | requestVote source dest =>
      simpa [ActiveRoleTermInv, next, rawNext, nextRequestVote] using
        activeRoles
  | appendEntries source dest =>
      simpa [ActiveRoleTermInv, next, rawNext, nextAppendEntries] using
        activeRoles
  | becomeLeader leader =>
      have leaderEnabled := enabled
      simp [Enabled, actionEnabled] at leaderEnabled
      intro node activeAfter
      by_cases nodeIsLeader : node = leader
      · subst node
        have candidateActive :
            state.leadershipState leader != .none := by
          rw [leaderEnabled.1.2]
          decide
        simpa [next, rawNext, nextBecomeLeader] using
          activeRoles leader candidateActive
      · have beforeActive :
            state.leadershipState node != .none := by
          simpa [next, rawNext, nextBecomeLeader, nodeIsLeader] using
            activeAfter
        simpa [next, rawNext, nextBecomeLeader, nodeIsLeader] using
          activeRoles node beforeActive
  | clientRequest leader =>
      simpa [ActiveRoleTermInv, next, rawNext, nextClientRequest] using
        activeRoles
  | signCommittableMessages leader =>
      simpa [ActiveRoleTermInv, next, rawNext,
        nextSignCommittableMessages] using activeRoles
  | changeConfiguration leader configuration =>
      simpa [ActiveRoleTermInv, next, rawNext,
        nextChangeConfiguration] using activeRoles
  | advanceCommitIndex leader =>
      have advanceEnabled := enabled
      simp [Enabled, actionEnabled] at advanceEnabled
      intro node activeAfter
      by_cases nodeIsLeader : node = leader
      · subst node
        have leaderActive :
            state.leadershipState leader != .none := by
          rw [advanceEnabled.1.2]
          decide
        simpa [next, rawNext, nextAdvanceCommitIndex] using
          activeRoles leader leaderActive
      · have beforeActive :
            state.leadershipState node != .none := by
          simpa [next, rawNext, nextAdvanceCommitIndex, nodeIsLeader] using
            activeAfter
        simpa [next, rawNext, nextAdvanceCommitIndex, nodeIsLeader] using
          activeRoles node beforeActive
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [ActiveRoleTermInv, next, rawNext, nextReceive, hmessage]
            using activeRoles
      | some message =>
          have messageQueued :=
            headMessage?_mem state dest source message hmessage
          have incomingTerm :=
            messageTerms dest source message messageQueued
          cases kind with
          | updateTerm =>
              have updateEnabled := enabled
              simp [Enabled, actionEnabled, hmessage, receiveBranchEnabled,
                updateTermEnabled] at updateEnabled
              intro node activeAfter
              by_cases nodeIsDest : node = dest
              · subst node
                simpa [next, rawNext, nextReceive, hmessage] using
                  incomingTerm
              · have beforeActive :
                    state.leadershipState node != .none := by
                  simpa [next, rawNext, nextReceive, hmessage, nodeIsDest] using
                    activeAfter
                simpa [next, rawNext, nextReceive, hmessage, nodeIsDest] using
                  activeRoles node beforeActive
          | returnToFollower =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have returnEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at returnEnabled
                  intro node activeAfter
                  by_cases nodeIsDest : node = dest
                  · subst node
                    have candidateActive :
                        state.leadershipState dest != .none := by
                      have role :
                          state.leadershipState dest = .candidate := by
                        rw [← returnEnabled.2.1.1]
                        exact returnEnabled.2.2.2
                      rw [role]
                      decide
                    simpa [next, rawNext, nextReceive, hmessage, hbody] using
                      activeRoles dest candidateActive
                  · have beforeActive :
                        state.leadershipState node != .none := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nodeIsDest] using activeAfter
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nodeIsDest] using activeRoles node beforeActive
              | _ =>
                  simpa [ActiveRoleTermInv, next, rawNext, nextReceive,
                    hmessage, hbody] using activeRoles
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  intro node activeAfter
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    let extendedConfigurations :=
                      overrideConfigurations
                        (state.configurations message.dest)
                        (configurationsInEntries
                          (previousIndex + 1) entries)
                    by_cases roleNone :
                        state.leadershipState message.dest = .none
                    · by_cases hasConfiguration :
                          Exists fun configuration =>
                            And
                              (configuration ∈ extendedConfigurations)
                              (message.dest ∈ configuration.nodes)
                      · have currentStart :
                            startTerm <= state.currentTerm message.dest := by
                          omega
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict,
                          extendedConfigurations, roleNone,
                          hasConfiguration] using currentStart
                      · simp [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict,
                          extendedConfigurations, roleNone,
                          hasConfiguration] at activeAfter
                    · have beforeActive :
                          state.leadershipState message.dest != .none := by
                        simp [roleNone]
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, extendedConfigurations,
                        roleNone] using
                        activeRoles message.dest beforeActive
                  · have beforeActive :
                        state.leadershipState node != .none := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, nodeIsDest] using
                        activeAfter
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, nodeIsDest] using
                      activeRoles node beforeActive
              | _ =>
                  simpa [ActiveRoleTermInv, next, rawNext, nextReceive,
                    hmessage, hbody] using activeRoles
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody, appendEntriesAcceptBase] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  intro node activeAfter
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    let rolled :=
                      conflictRollback state message.dest previousIndex
                    let extendedConfigurations :=
                      overrideConfigurations
                        (rolled.configurations message.dest)
                        (configurationsInEntries
                          (previousIndex + 1) entries)
                    by_cases roleNone :
                        rolled.leadershipState message.dest = .none
                    · by_cases hasConfiguration :
                          Exists fun configuration =>
                            And
                              (configuration ∈ extendedConfigurations)
                              (message.dest ∈ configuration.nodes)
                      · have currentStart :
                            startTerm <= state.currentTerm message.dest := by
                          omega
                        simpa [next, rawNext, nextReceive, hmessage, hbody,
                          nextAppendEntriesNoConflict, conflictRollback,
                          rolled, extendedConfigurations, roleNone,
                          hasConfiguration] using currentStart
                      · have stateRoleNone :
                            state.leadershipState message.dest = .none := by
                          simpa [conflictRollback, rolled] using roleNone
                        have noConfiguration :
                            Not
                              (Exists fun configuration =>
                                And
                                  (configuration ∈
                                    overrideConfigurations
                                      (configurationsToIndex
                                        (state.configurations message.dest)
                                        ((state.log message.dest).take
                                          previousIndex).length)
                                      (configurationsInEntries
                                        (previousIndex + 1) entries))
                                  (message.dest ∈ configuration.nodes)) := by
                          simpa [conflictRollback, rolled,
                            extendedConfigurations] using hasConfiguration
                        have noConfigurationForall :
                            forall configuration,
                              configuration ∈
                                  overrideConfigurations
                                    (configurationsToIndex
                                      (state.configurations message.dest)
                                      (min previousIndex
                                        (state.log message.dest).length))
                                    (configurationsInEntries
                                      (previousIndex + 1) entries) ->
                                message.dest ∉ configuration.nodes := by
                          intro configuration member contains
                          apply noConfiguration
                          refine ⟨configuration, ?_, contains⟩
                          simpa using member
                        have afterRoleNone :
                            State.leadershipState
                                (next state
                                  (.receive message.dest source
                                    .appendEntriesConflictThenNoConflict))
                                message.dest =
                              LeadershipState.none := by
                          simp [next, rawNext, nextReceive, hmessage, hbody,
                            nextAppendEntriesNoConflict, conflictRollback,
                            stateRoleNone]
                          exact noConfigurationForall
                        rw [afterRoleNone] at activeAfter
                        change false = true at activeAfter
                        exact False.elim (Bool.noConfusion activeAfter)
                    · have beforeActive :
                          state.leadershipState message.dest != .none := by
                        simpa [conflictRollback, rolled, roleNone]
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback, rolled,
                        extendedConfigurations, roleNone] using
                        activeRoles message.dest beforeActive
                  · have beforeActive :
                        state.leadershipState node != .none := by
                      simpa [next, rawNext, nextReceive, hmessage, hbody,
                        nextAppendEntriesNoConflict, conflictRollback,
                        nodeIsDest] using activeAfter
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      nodeIsDest] using activeRoles node beforeActive
              | _ =>
                  simpa [ActiveRoleTermInv, next, rawNext, nextReceive,
                    hmessage, hbody] using activeRoles
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      simpa [ActiveRoleTermInv, next, rawNext, nextReceive,
                        hmessage, hbody, responseCase] using activeRoles
                  | some response =>
                      simpa [ActiveRoleTermInv, next, rawNext, nextReceive,
                        hmessage, hbody, responseCase] using activeRoles
              | _ =>
                  simpa [ActiveRoleTermInv, next, rawNext, nextReceive,
                    hmessage, hbody] using activeRoles
          | _ =>
              cases hbody : message.body <;>
                intro node activeAfter
              all_goals
                have beforeActive :
                    state.leadershipState node != .none := by
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    activeAfter
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  activeRoles node beforeActive

theorem logTermsAtLeastStart_step
    (state : State)
    (action : Action)
    (activeRoles : ActiveRoleTermInv state)
    (messageEntries : MessageEntriesAtLeastStartInv state)
    (logTerms : LogTermsAtLeastStartInv state)
    (enabled : Enabled state action) :
    LogTermsAtLeastStartInv (next state action) := by
  cases action with
  | timeout candidate =>
      simpa [LogTermsAtLeastStartInv, next, rawNext, nextTimeout] using
        logTerms
  | requestVote source dest =>
      simpa [LogTermsAtLeastStartInv, next, rawNext, nextRequestVote] using
        logTerms
  | appendEntries source dest =>
      simpa [LogTermsAtLeastStartInv, next, rawNext, nextAppendEntries] using
        logTerms
  | becomeLeader leader =>
      intro node entry member
      by_cases nodeIsLeader : node = leader
      · subst node
        simp [next, rawNext, nextBecomeLeader] at member
        exact logTerms leader entry (List.mem_of_mem_take member)
      · simp [next, rawNext, nextBecomeLeader, nodeIsLeader] at member
        exact logTerms node entry member
  | clientRequest leader =>
      have clientEnabled := enabled
      simp [Enabled, actionEnabled] at clientEnabled
      have leaderActive :
          state.leadershipState leader != .none := by
        rw [clientEnabled.1.2]
        decide
      intro node entry member
      by_cases nodeIsLeader : node = leader
      · subst node
        simp [next, rawNext, nextClientRequest] at member
        rcases member with oldEntry | newEntry
        · exact logTerms leader entry oldEntry
        · subst entry
          exact activeRoles leader leaderActive
      · simp [next, rawNext, nextClientRequest, nodeIsLeader] at member
        exact logTerms node entry member
  | signCommittableMessages leader =>
      have signEnabled := enabled
      simp [Enabled, actionEnabled] at signEnabled
      have leaderActive :
          state.leadershipState leader != .none := by
        rw [signEnabled.1.1.2]
        decide
      intro node entry member
      by_cases nodeIsLeader : node = leader
      · subst node
        simp [next, rawNext, nextSignCommittableMessages] at member
        rcases member with oldEntry | newEntry
        · exact logTerms leader entry oldEntry
        · subst entry
          exact activeRoles leader leaderActive
      · simp [next, rawNext, nextSignCommittableMessages,
          nodeIsLeader] at member
        exact logTerms node entry member
  | changeConfiguration leader configuration =>
      have changeEnabled := enabled
      simp [Enabled, actionEnabled] at changeEnabled
      have leaderActive :
          state.leadershipState leader != .none := by
        rw [changeEnabled.1.1.1.2]
        decide
      intro node entry member
      by_cases nodeIsLeader : node = leader
      · subst node
        simp [next, rawNext, nextChangeConfiguration] at member
        rcases member with oldEntry | newEntry
        · exact logTerms leader entry oldEntry
        · subst entry
          exact activeRoles leader leaderActive
      · simp [next, rawNext, nextChangeConfiguration, nodeIsLeader] at member
        exact logTerms node entry member
  | advanceCommitIndex leader =>
      simpa [LogTermsAtLeastStartInv, next, rawNext,
        nextAdvanceCommitIndex] using logTerms
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [LogTermsAtLeastStartInv, next, rawNext, nextReceive,
            hmessage] using logTerms
      | some message =>
          have messageQueued :=
            headMessage?_mem state dest source message hmessage
          have payloadTerms :=
            messageEntries dest source message messageQueued
          cases kind with
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have receivedTerms :
                      forall entry,
                        entry ∈ entries ->
                          startTerm <= entry.term := by
                    simpa [MessageEntriesAtLeastStart, hbody] using
                      payloadTerms
                  intro node entry member
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict] at member
                    rcases member with oldEntry | newEntry
                    · exact logTerms message.dest entry
                        (List.mem_of_mem_take oldEntry)
                    · exact receivedTerms entry newEntry
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, nodeIsDest] at member
                    exact logTerms node entry member
              | _ =>
                  simpa [LogTermsAtLeastStartInv, next, rawNext, nextReceive,
                    hmessage, hbody] using logTerms
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  intro node entry member
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback] at member
                    exact logTerms message.dest entry
                      (List.mem_of_mem_take member)
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesAlreadyDone, conflictRollback,
                      nodeIsDest] at member
                    exact logTerms node entry member
              | _ =>
                  simpa [LogTermsAtLeastStartInv, next, rawNext, nextReceive,
                    hmessage, hbody] using logTerms
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  have branchEnabled := enabled
                  simp [Enabled, actionEnabled, hmessage,
                    receiveBranchEnabled, hbody] at branchEnabled
                  have destMatches : message.dest = dest :=
                    branchEnabled.2.1.1
                  subst dest
                  have receivedTerms :
                      forall entry,
                        entry ∈ entries ->
                          startTerm <= entry.term := by
                    simpa [MessageEntriesAtLeastStart, hbody] using
                      payloadTerms
                  intro node entry member
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback] at member
                    rcases member with oldEntry | newEntry
                    · exact logTerms message.dest entry
                        (List.mem_of_mem_take
                          (List.mem_of_mem_take oldEntry))
                    · exact receivedTerms entry newEntry
                  · simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      nodeIsDest] at member
                    exact logTerms node entry member
              | _ =>
                  simpa [LogTermsAtLeastStartInv, next, rawNext, nextReceive,
                    hmessage, hbody] using logTerms
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm with
                  | none =>
                      simpa [LogTermsAtLeastStartInv, next, rawNext,
                        nextReceive, hmessage, hbody, responseCase] using
                        logTerms
                  | some response =>
                      simpa [LogTermsAtLeastStartInv, next, rawNext,
                        nextReceive, hmessage, hbody, responseCase] using
                        logTerms
              | _ =>
                  simpa [LogTermsAtLeastStartInv, next, rawNext, nextReceive,
                    hmessage, hbody] using logTerms
          | _ =>
              cases hbody : message.body <;>
                simpa [LogTermsAtLeastStartInv, next, rawNext, nextReceive,
                  hmessage, hbody] using logTerms

theorem minimumTerm_step
    (state : State)
    (action : Action)
    (minimumTerms : MinimumTermInv state)
    (enabled : Enabled state action) :
    MinimumTermInv (next state action) :=
  {
    activeRoles := activeRoleTerm_step
      state action minimumTerms.activeRoles minimumTerms.messages enabled
    messages := messageTermAtLeastStart_step
      state action minimumTerms.activeRoles minimumTerms.messages
      minimumTerms.logs enabled
    messageEntries := messageEntriesAtLeastStart_step
      state action minimumTerms.messageEntries minimumTerms.logs
    logs := logTermsAtLeastStart_step
      state action minimumTerms.activeRoles minimumTerms.messageEntries
      minimumTerms.logs enabled
  }

theorem initial_CandidateTermStrictAfterStart
    (start : InitialConfiguration) :
    forall node,
      (initialState start).leadershipState node = .candidate ->
        startTerm < (initialState start).currentTerm node := by
  intro node candidate
  by_cases member : node ∈ start.nodes
  · by_cases same : node = start.leader <;>
      simp [initialState, member, same, start.leader_mem] at candidate
  · simp [initialState, member] at candidate

private theorem candidate_before_of_candidate_after
    (state : State)
    (action : Action)
    (node : Node)
    (afterCandidate :
      (next state action).leadershipState node = .candidate)
    (notTimeout :
      forall timedOut : Node,
        action ≠ .timeout timedOut) :
    state.leadershipState node = .candidate := by
  cases action with
  | timeout timedOut =>
      exact False.elim (notTimeout timedOut rfl)
  | requestVote source dest =>
      simpa [next, rawNext, nextRequestVote] using afterCandidate
  | appendEntries source dest =>
      simpa [next, rawNext, nextAppendEntries] using afterCandidate
  | becomeLeader elected =>
      by_cases nodeIsElected : node = elected
      · subst node
        simp [next, rawNext, nextBecomeLeader, updateNode] at afterCandidate
      · simpa [next, rawNext, nextBecomeLeader, updateNode,
          nodeIsElected] using afterCandidate
  | clientRequest leader =>
      simpa [next, rawNext, nextClientRequest] using afterCandidate
  | signCommittableMessages leader =>
      simpa [next, rawNext, nextSignCommittableMessages] using
        afterCandidate
  | changeConfiguration leader configuration =>
      simpa [next, rawNext, nextChangeConfiguration] using afterCandidate
  | advanceCommitIndex leader =>
      by_cases nodeIsLeader : node = leader
      · subst node
        simp [next, rawNext, nextAdvanceCommitIndex, updateNode] at afterCandidate ⊢
        split at afterCandidate <;> simp_all
      · simpa [next, rawNext, nextAdvanceCommitIndex, updateNode,
          nodeIsLeader] using afterCandidate
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [next, rawNext, nextReceive, hmessage] using afterCandidate
      | some message =>
          cases kind with
          | dropIgnored =>
              simpa [next, rawNext, nextReceive, hmessage] using
                afterCandidate
          | updateTerm =>
              by_cases nodeIsDest : node = dest
              · subst node
                cases hrole : state.leadershipState dest <;>
                  simp [next, rawNext, nextReceive, hmessage, updateNode,
                    hrole] at afterCandidate
              · simpa [next, rawNext, nextReceive, hmessage, updateNode,
                  nodeIsDest] using afterCandidate
          | handleRequestVoteRequest =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  afterCandidate
          | handleRequestVoteResponse =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  afterCandidate
          | dropRequestVoteResponseOutOfState =>
              simpa [next, rawNext, nextReceive, hmessage] using
                afterCandidate
          | dropRequestVoteResponseStale =>
              simpa [next, rawNext, nextReceive, hmessage] using
                afterCandidate
          | rejectAppendEntriesRequest =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  cases responseCase :
                      appendEntriesRejectResponse?
                        state message previousIndex previousTerm <;>
                    simpa [next, rawNext, nextReceive, hmessage, hbody,
                      responseCase] using afterCandidate
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    afterCandidate
          | returnToFollower =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  by_cases nodeIsDest : node = dest
                  · subst node
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      updateNode] at afterCandidate
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      updateNode, nodeIsDest] using afterCandidate
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    afterCandidate
          | appendEntriesAlreadyDone =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone] using afterCandidate
          | appendEntriesNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, updateNode] at afterCandidate ⊢
                    split at afterCandidate <;> simp_all
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, updateNode,
                      nodeIsDest] using afterCandidate
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    afterCandidate
          | appendEntriesConflictThenAlreadyDone =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody,
                  nextAppendEntriesAlreadyDone, conflictRollback] using
                    afterCandidate
          | appendEntriesConflictThenNoConflict =>
              cases hbody : message.body with
              | appendEntriesRequest previousIndex previousTerm entries
                  commitIndex =>
                  by_cases nodeIsDest : node = message.dest
                  · subst node
                    simp [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      updateNode] at afterCandidate ⊢
                    split at afterCandidate <;> simp_all
                  · simpa [next, rawNext, nextReceive, hmessage, hbody,
                      nextAppendEntriesNoConflict, conflictRollback,
                      updateNode, nodeIsDest] using afterCandidate
              | _ =>
                  simpa [next, rawNext, nextReceive, hmessage, hbody] using
                    afterCandidate
          | handleAppendEntriesResponseSuccess =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  afterCandidate
          | handleAppendEntriesResponseFailure =>
              cases hbody : message.body <;>
                simpa [next, rawNext, nextReceive, hmessage, hbody] using
                  afterCandidate
          | dropAppendEntriesResponseOutOfState =>
              simpa [next, rawNext, nextReceive, hmessage] using
                afterCandidate
          | dropAppendEntriesResponseStale =>
              simpa [next, rawNext, nextReceive, hmessage] using
                afterCandidate

theorem noLeaderBeforeInitialTerm_of_activeRole
    (state : State)
    (activeRoles : ActiveRoleTermInv state) :
    NoLeaderBeforeInitialTermInv state := by
  intro node lowerTerm
  cases role : state.leadershipState node with
  | leader =>
      have active :
          state.leadershipState node != .none := by
        rw [role]
        decide
      have termBound := activeRoles node active
      omega
  | follower => decide
  | candidate => decide
  | none => decide

private theorem highestCommittableIndex_selected_or_zero
    (state : State)
    (leader : Node) :
    Or
      (highestCommittableIndex state leader = 0)
      (Exists fun entry =>
        And
          (entryAt?
            (state.log leader)
            (highestCommittableIndex state leader) = some entry)
          (And
            (entry.term = state.currentTerm leader)
            (And
              (entry.content = .signature)
              (hasConsensusWatermark
                state leader (highestCommittableIndex state leader) =
                  true)))) := by
  let good := fun index =>
    Or
      (index = 0)
      (Exists fun entry =>
        And
          (entryAt? (state.log leader) index = some entry)
          (And
            (entry.term = state.currentTerm leader)
            (And
              (entry.content = .signature)
              (hasConsensusWatermark state leader index = true))))
  let step := fun result index =>
    match entryAt? (state.log leader) index with
    | some entry =>
        if state.commitIndex leader < index &&
            entry.term = state.currentTerm leader &&
            entry.content = EntryContent.signature &&
            hasConsensusWatermark state leader index then
          max result index
        else
          result
    | none => result
  have foldGood :
      forall (remaining : List Nat) (result : Nat),
        good result ->
          good (remaining.foldl step result) := by
    intro remaining
    induction remaining with
    | nil =>
        intro result resultGood
        exact resultGood
    | cons index rest inductionHypothesis =>
        intro result resultGood
        apply inductionHypothesis
        dsimp [step]
        cases atIndex : entryAt? (state.log leader) index with
        | none =>
            exact resultGood
        | some entry =>
            by_cases committable :
                state.commitIndex leader < index &&
                  entry.term = state.currentTerm leader &&
                  entry.content = .signature &&
                  hasConsensusWatermark state leader index
            · have indexGood : good index :=
                by
                  simp at committable
                  exact Or.inr
                    ⟨entry, atIndex, committable.1.1.2,
                      committable.1.2, committable.2⟩
              by_cases resultBefore : result <= index
              · simpa [committable, max_eq_right resultBefore] using
                  indexGood
              · have indexBefore : index <= result :=
                  Nat.le_of_not_ge resultBefore
                simpa [committable, max_eq_left indexBefore] using
                  resultGood
            · simpa [committable] using resultGood
  simpa [highestCommittableIndex, good, step] using
    foldGood (indices (state.log leader)) 0 (Or.inl rfl)

theorem highestCommittableIndex_signature_or_zero
    (state : State)
    (leader : Node) :
    Or
      (highestCommittableIndex state leader = 0)
      (Exists fun entry =>
        And
          (entryAt?
            (state.log leader)
            (highestCommittableIndex state leader) = some entry)
          (And
            (entry.term = state.currentTerm leader)
            (entry.content = .signature))) := by
  rcases highestCommittableIndex_selected_or_zero state leader with
    highestZero | ⟨entry, atHighest, currentTerm, signature, _⟩
  · exact Or.inl highestZero
  · exact Or.inr ⟨entry, atHighest, currentTerm, signature⟩

theorem highestCommittableIndex_hasConsensusWatermark_of_pos
    (state : State)
    (leader : Node)
    (positive : 0 < highestCommittableIndex state leader) :
    hasConsensusWatermark
        state leader (highestCommittableIndex state leader) =
      true := by
  rcases highestCommittableIndex_selected_or_zero state leader with
    highestZero | ⟨_, _, _, _, consensus⟩
  · omega
  · exact consensus

theorem lastIndexWhere_fold_ge_initial
    (predicate : Entry -> Bool)
    (entries : List Entry)
    (remaining : List Nat)
    (initial : Nat) :
    initial <=
      remaining.foldl
        (fun result index =>
          match entryAt? entries index with
          | some entry => if predicate entry then max result index else result
          | none => result)
        initial := by
  induction remaining generalizing initial with
  | nil =>
      exact Nat.le_refl _
  | cons index rest inductionHypothesis =>
      dsimp [List.foldl]
      cases atIndex : entryAt? entries index with
      | none =>
          simpa [atIndex] using inductionHypothesis initial
      | some entry =>
          by_cases selected : predicate entry
          · simpa [atIndex, selected] using
              Nat.le_trans
                (Nat.le_max_left initial index)
                (inductionHypothesis (max initial index))
          · simpa [atIndex, selected] using
              inductionHypothesis initial

theorem lastIndexWhere_fold_ge_selected
    (predicate : Entry -> Bool)
    (entries : List Entry)
    (remaining : List Nat)
    (initial selected : Nat)
    (selectedMember : selected ∈ remaining)
    (selectedEntry : Exists fun entry =>
      And
        (entryAt? entries selected = some entry)
        (predicate entry = true)) :
    selected <=
      remaining.foldl
        (fun result index =>
          match entryAt? entries index with
          | some entry => if predicate entry then max result index else result
          | none => result)
        initial := by
  induction remaining generalizing initial with
  | nil =>
      simp at selectedMember
  | cons index rest inductionHypothesis =>
      simp at selectedMember
      rcases selectedMember with selectedIsHead | selectedInRest
      · subst index
        rcases selectedEntry with ⟨entry, atSelected, predicateTrue⟩
        dsimp [List.foldl]
        simpa [atSelected, predicateTrue] using
          Nat.le_trans
            (Nat.le_max_right initial selected)
            (lastIndexWhere_fold_ge_initial
              predicate entries rest (max initial selected))
      · dsimp [List.foldl]
        cases atIndex : entryAt? entries index with
        | none =>
            simpa [atIndex] using
              inductionHypothesis initial selectedInRest
        | some entry =>
            by_cases selectedNow : predicate entry
            · simpa [atIndex, selectedNow] using
                inductionHypothesis
                  (max initial index)
                  selectedInRest
            · simpa [atIndex, selectedNow] using
                inductionHypothesis initial selectedInRest

theorem index_mem_indices_of_entryAt?
    (entries : List Entry)
    (index : Nat)
    (entry : Entry)
    (atIndex : entryAt? entries index = some entry) :
    index ∈ indices entries := by
  unfold entryAt? at atIndex
  split at atIndex
  · contradiction
  · have member := List.mem_of_getElem? atIndex
    have indexBound : index - 1 < entries.length := by
      exact (List.getElem?_eq_some_iff.mp atIndex).choose
    simp only [indices, List.mem_map, List.mem_range]
    exact ⟨index - 1, indexBound, by omega⟩

theorem index_le_lastIndexWhere
    (predicate : Entry -> Bool)
    (entries : List Entry)
    (index : Nat)
    (entry : Entry)
    (atIndex : entryAt? entries index = some entry)
    (selected : predicate entry = true) :
    index <= lastIndexWhere predicate entries := by
  unfold lastIndexWhere
  exact lastIndexWhere_fold_ge_selected
    predicate
    entries
    (indices entries)
    0
    index
    (index_mem_indices_of_entryAt? entries index entry atIndex)
    ⟨entry, atIndex, selected⟩

theorem lastIndexWhere_selected_or_zero
    (predicate : Entry -> Bool)
    (entries : List Entry) :
    Or
      (lastIndexWhere predicate entries = 0)
      (Exists fun entry =>
        And
          (entryAt? entries (lastIndexWhere predicate entries) =
            some entry)
          (predicate entry = true)) := by
  let good := fun index =>
    Or
      (index = 0)
      (Exists fun entry =>
        And
          (entryAt? entries index = some entry)
          (predicate entry = true))
  let step := fun result index =>
    match entryAt? entries index with
    | some entry => if predicate entry then max result index else result
    | none => result
  have foldGood :
      forall (remaining : List Nat) (result : Nat),
        good result ->
          good (remaining.foldl step result) := by
    intro remaining
    induction remaining with
    | nil =>
        intro result resultGood
        exact resultGood
    | cons index rest inductionHypothesis =>
        intro result resultGood
        apply inductionHypothesis
        dsimp [step]
        cases atIndex : entryAt? entries index with
        | none =>
            exact resultGood
        | some entry =>
            by_cases selected : predicate entry
            · have indexGood : good index :=
                Or.inr ⟨entry, atIndex, by simpa using selected⟩
              by_cases resultBefore : result <= index
              · simpa [atIndex, selected, max_eq_right resultBefore] using
                  indexGood
              · have indexBefore : index <= result :=
                  Nat.le_of_not_ge resultBefore
                simpa [atIndex, selected, max_eq_left indexBefore] using
                  resultGood
            · simpa [atIndex, selected] using resultGood
  simpa [lastIndexWhere, good, step] using
    foldGood (indices entries) 0 (Or.inl rfl)

theorem maxCommittableIndex_signature_or_zero
    (entries : List Entry) :
    Or
      (maxCommittableIndex entries = 0)
      (Exists fun entry =>
        And
          (entryAt? entries (maxCommittableIndex entries) = some entry)
          (entry.content = .signature)) := by
  rcases
    lastIndexWhere_selected_or_zero
      (fun entry => entry.content matches .signature)
      entries with
    noSignature | ⟨entry, atIndex, selected⟩
  · exact Or.inl noSignature
  · right
    refine ⟨entry, atIndex, ?_⟩
    cases content : entry.content <;> simp [content] at selected ⊢

theorem maxCommittablePrefix_last_signature_or_empty
    (entries : List Entry) :
    Or
      (entries.take (maxCommittableIndex entries) = [])
      (Exists fun entry =>
        And
          ((entries.take (maxCommittableIndex entries)).getLast? =
            some entry)
          (entry.content = .signature)) := by
  rcases maxCommittableIndex_signature_or_zero entries with
    noSignature | ⟨entry, atIndex, signature⟩
  · left
    simp [noSignature]
  · right
    refine ⟨entry, ?_, signature⟩
    have positive : 0 < maxCommittableIndex entries := by
      unfold entryAt? at atIndex
      split at atIndex
      · contradiction
      · omega
    unfold entryAt? at atIndex
    simp [positive.ne'] at atIndex
    rw [List.getLast?_take]
    simp [positive.ne', atIndex]

theorem leaderLogBoundary_step
    (state : State)
    (action : Action)
    (boundary : LeaderLogBoundaryInv state)
    (enabled : Enabled state action) :
    LeaderLogBoundaryInv (next state action) := by
  cases action with
  | timeout candidate =>
      intro node leaderState lastEntry lastAt
      by_cases nodeIsCandidate : node = candidate
      · subst node
        simp [next, rawNext, nextTimeout] at leaderState
      · have oldLeader :
            state.leadershipState node = .leader := by
          simpa [next, rawNext, nextTimeout, nodeIsCandidate] using
            leaderState
        have oldLast :
            (state.log node).getLast? = some lastEntry := by
          simpa [next, rawNext, nextTimeout, nodeIsCandidate] using lastAt
        simpa [next, rawNext, nextTimeout, nodeIsCandidate] using
          boundary node oldLeader lastEntry oldLast
  | requestVote source dest =>
      simpa [LeaderLogBoundaryInv, next, rawNext, nextRequestVote] using
        boundary
  | appendEntries source dest =>
      simpa [LeaderLogBoundaryInv, next, rawNext, nextAppendEntries] using
        boundary
  | becomeLeader leader =>
      intro node leaderState lastEntry lastAt
      by_cases nodeIsLeader : node = leader
      · subst node
        rcases
          maxCommittablePrefix_last_signature_or_empty
            (state.log leader) with
          emptyLog | ⟨entry, lastSignature, signature⟩
        · have afterLast :
              (committable state leader).getLast? = some lastEntry := by
            simpa [next, rawNext, nextBecomeLeader] using lastAt
          rw [committable, logPrefix, emptyLog] at afterLast
          simp at afterLast
        · have sameLast : lastEntry = entry := by
            have afterLast :
                (committable state leader).getLast? = some lastEntry := by
              simpa [next, rawNext, nextBecomeLeader] using lastAt
            rw [committable, logPrefix] at afterLast
            exact
              (Option.some.inj (lastSignature.symm.trans afterLast)).symm
          subst lastEntry
          exact Or.inr signature
      · have oldLeader :
            state.leadershipState node = .leader := by
          simpa [next, rawNext, nextBecomeLeader, nodeIsLeader] using
            leaderState
        have oldLast :
            (state.log node).getLast? = some lastEntry := by
          simpa [next, rawNext, nextBecomeLeader, nodeIsLeader] using lastAt
        simpa [next, rawNext, nextBecomeLeader, nodeIsLeader] using
          boundary node oldLeader lastEntry oldLast
  | clientRequest leader =>
      intro node leaderState lastEntry lastAt
      by_cases nodeIsLeader : node = leader
      · subst node
        simp [next, rawNext, nextClientRequest] at lastAt
        subst lastEntry
        exact Or.inl rfl
      · have oldLeader :
            state.leadershipState node = .leader := by
          simpa [next, rawNext, nextClientRequest, nodeIsLeader] using
            leaderState
        have oldLast :
            (state.log node).getLast? = some lastEntry := by
          simpa [next, rawNext, nextClientRequest, nodeIsLeader] using lastAt
        simpa [next, rawNext, nextClientRequest, nodeIsLeader] using
          boundary node oldLeader lastEntry oldLast
  | signCommittableMessages leader =>
      intro node leaderState lastEntry lastAt
      by_cases nodeIsLeader : node = leader
      · subst node
        simp [next, rawNext, nextSignCommittableMessages] at lastAt
        subst lastEntry
        exact Or.inl rfl
      · have oldLeader :
            state.leadershipState node = .leader := by
          simpa [next, rawNext, nextSignCommittableMessages,
            nodeIsLeader] using leaderState
        have oldLast :
            (state.log node).getLast? = some lastEntry := by
          simpa [next, rawNext, nextSignCommittableMessages,
            nodeIsLeader] using lastAt
        simpa [next, rawNext, nextSignCommittableMessages,
          nodeIsLeader] using boundary node oldLeader lastEntry oldLast
  | changeConfiguration leader configuration =>
      intro node leaderState lastEntry lastAt
      by_cases nodeIsLeader : node = leader
      · subst node
        simp [next, rawNext, nextChangeConfiguration] at lastAt
        subst lastEntry
        exact Or.inl rfl
      · have oldLeader :
            state.leadershipState node = .leader := by
          simpa [next, rawNext, nextChangeConfiguration, nodeIsLeader] using
            leaderState
        have oldLast :
            (state.log node).getLast? = some lastEntry := by
          simpa [next, rawNext, nextChangeConfiguration, nodeIsLeader] using
            lastAt
        simpa [next, rawNext, nextChangeConfiguration, nodeIsLeader] using
          boundary node oldLeader lastEntry oldLast
  | advanceCommitIndex leader =>
      intro node leaderState lastEntry lastAt
      have oldLeader :
          state.leadershipState node = .leader := by
        by_cases nodeIsLeader : node = leader
        · subst node
          simp [next, rawNext, nextAdvanceCommitIndex] at leaderState
          split at leaderState
          · contradiction
          · exact leaderState
        · simpa [next, rawNext, nextAdvanceCommitIndex, nodeIsLeader] using
            leaderState
      have oldLast :
          (state.log node).getLast? = some lastEntry := by
        simpa [next, rawNext, nextAdvanceCommitIndex] using lastAt
      simpa [next, rawNext, nextAdvanceCommitIndex] using
        boundary node oldLeader lastEntry oldLast
  | receive dest source kind =>
      cases hmessage : headMessage? state dest source with
      | none =>
          simpa [LeaderLogBoundaryInv, next, rawNext, nextReceive, hmessage]
            using boundary
      | some message =>
          cases kind <;>
            cases hbody : message.body <;>
              simp_all [LeaderLogBoundaryInv, next, rawNext, nextReceive,
                Enabled, actionEnabled, receiveBranchEnabled,
                appendEntriesAcceptBase, nextAppendEntriesAlreadyDone,
                nextAppendEntriesNoConflict, conflictRollback]
          all_goals
            first
            | split <;> simp_all
            | skip
          all_goals
            intro node leaderAfter lastEntry lastAfter
            by_cases nodeIsDest : node = dest
            · subst node
              rw [enabled.2.1.1] at *
              cases role : state.leadershipState dest <;>
                simp_all
              all_goals
                split at leaderAfter <;> contradiction
            · have oldLeader :
                  state.leadershipState node = .leader := by
                simpa [next, rawNext, nextReceive, nodeIsDest] using
                  leaderAfter
              have oldLast :
                  (state.log node).getLast? = some lastEntry := by
                simpa [next, rawNext, nextReceive,
                  nextAppendEntriesAlreadyDone,
                  nextAppendEntriesNoConflict, conflictRollback,
                  nodeIsDest] using lastAfter
              simpa [next, rawNext, nextReceive, nodeIsDest] using
                boundary node oldLeader lastEntry oldLast

theorem index_le_maxCommittableIndex_of_signature
    (entries : List Entry)
    (index : Nat)
    (atIndex :
      (entryAt? entries index).map (·.content) = some .signature) :
    index <= maxCommittableIndex entries := by
  cases entryCase : entryAt? entries index with
  | none =>
      simp [entryCase] at atIndex
  | some entry =>
      simp [entryCase] at atIndex
      have selected :
          (fun current => current.content matches .signature) entry = true := by
        cases content : entry.content <;>
          simp [content] at atIndex ⊢
      exact index_le_lastIndexWhere
        (fun current => current.content matches .signature)
        entries
        index
        entry
        entryCase
        selected

theorem entryAt?_append_of_some
    (entries suffix : List Entry)
    (index : Nat)
    (entry : Entry)
    (atIndex : entryAt? entries index = some entry) :
    entryAt? (entries ++ suffix) index = some entry := by
  unfold entryAt? at atIndex ⊢
  split at atIndex
  · contradiction
  · split
    · contradiction
    · have indexBound :
          index - 1 < entries.length := by
        exact (List.getElem?_eq_some_iff.mp atIndex).choose
      rw [List.getElem?_append_left indexBound]
      exact atIndex

theorem entryAt?_take_lift
    (entries : List Entry)
    (bound index : Nat)
    (entry : Entry)
    (atIndex :
      entryAt? (entries.take bound) index = some entry) :
    entryAt? entries index = some entry := by
  unfold entryAt? at atIndex ⊢
  split at atIndex
  · contradiction
  · split
    · contradiction
    · have inTake :
          index - 1 < (entries.take bound).length := by
        exact (List.getElem?_eq_some_iff.mp atIndex).choose
      have beforeBound : index - 1 < bound := by
        exact Nat.lt_of_lt_of_le inTake (List.length_take_le bound entries)
      rw [List.getElem?_take_of_lt beforeBound] at atIndex
      exact atIndex

theorem entryAt?_take_of_some
    (entries : List Entry)
    (bound index : Nat)
    (entry : Entry)
    (atIndex : entryAt? entries index = some entry)
    (indexWithin : index <= bound) :
    entryAt? (entries.take bound) index = some entry := by
  unfold entryAt? at atIndex ⊢
  split at atIndex
  · contradiction
  · split
    · contradiction
    · have positive : 0 < index := by omega
      have beforeBound : index - 1 < bound := by omega
      rw [List.getElem?_take_of_lt beforeBound]
      exact atIndex

theorem maxCommittableIndexAt_signature_or_zero
    (entries : List Entry)
    (bound : Nat) :
    Or
      (maxCommittableIndexAt entries bound = 0)
      (Exists fun entry =>
        And
          (entryAt? entries (maxCommittableIndexAt entries bound) =
            some entry)
          (entry.content = .signature)) := by
  let prefixEntries := logPrefix entries (min bound entries.length)
  rcases maxCommittableIndex_signature_or_zero prefixEntries with
    noSignature | ⟨entry, atPrefix, signature⟩
  · exact Or.inl noSignature
  · exact Or.inr
      ⟨entry,
        entryAt?_take_lift
          entries
          (min bound entries.length)
          (maxCommittableIndex prefixEntries)
          entry
          atPrefix,
        signature⟩

theorem signature_after_maxCommittableIndexAt
    (entries : List Entry)
    (oldCommit bound : Nat)
    (oldSignature :
      oldCommit > 0 ->
        (entryAt? entries oldCommit).map (·.content) =
          some .signature) :
    let nextCommit :=
      max (maxCommittableIndexAt entries bound) oldCommit
    nextCommit > 0 ->
      (entryAt? entries nextCommit).map (·.content) =
        some .signature := by
  intro nextCommit positive
  dsimp [nextCommit] at positive ⊢
  by_cases candidateBefore :
      maxCommittableIndexAt entries bound <= oldCommit
  · rw [max_eq_right candidateBefore]
    apply oldSignature
    omega
  · have candidatePositive :
        0 < maxCommittableIndexAt entries bound := by
      omega
    rw [max_eq_left (Nat.le_of_not_ge candidateBefore)]
    rcases maxCommittableIndexAt_signature_or_zero entries bound with
      candidateZero | ⟨entry, atCandidate, signature⟩
    · omega
    · simp [atCandidate, signature]

theorem signature_preserved_by_append
    (entries suffix : List Entry)
    (index : Nat)
    (signature :
      (entryAt? entries index).map (·.content) = some .signature) :
    (entryAt? (entries ++ suffix) index).map (·.content) =
      some .signature := by
  cases atIndex : entryAt? entries index with
  | none =>
      simp [atIndex] at signature
  | some entry =>
      simp [atIndex] at signature
      rw [entryAt?_append_of_some entries suffix index entry atIndex]
      simpa using signature

theorem signature_preserved_by_take
    (entries : List Entry)
    (bound index : Nat)
    (signature :
      (entryAt? entries index).map (·.content) = some .signature)
    (indexWithin : index <= bound) :
    (entryAt? (entries.take bound) index).map (·.content) =
      some .signature := by
  cases atIndex : entryAt? entries index with
  | none =>
      simp [atIndex] at signature
  | some entry =>
      simp [atIndex] at signature
      rw [entryAt?_take_of_some
        entries bound index entry atIndex indexWithin]
      simpa using signature

theorem entryAt?_take_eq_of_index_le_length
    (entries : List Entry)
    (bound index : Nat)
    (positive : 1 <= index)
    (within : index <= (entries.take bound).length) :
    entryAt? (entries.take bound) index =
      entryAt? entries index := by
  rcases
      entryAt?_exists_of_positive_within
        (entries.take bound) index positive within with
    ⟨entry, atIndex⟩
  rw [atIndex]
  rw [entryAt?_take_lift entries bound index entry atIndex]

theorem entryAt?_append_eq_of_index_le_length
    (entries suffix : List Entry)
    (index : Nat)
    (positive : 1 <= index)
    (within : index <= entries.length) :
    entryAt? (entries ++ suffix) index =
      entryAt? entries index := by
  rcases
      entryAt?_exists_of_positive_within entries index positive within with
    ⟨entry, atIndex⟩
  rw [atIndex]
  rw [entryAt?_append_of_some entries suffix index entry atIndex]

theorem entryAt?_append_singleton_last
    (entries : List Entry)
    (entry : Entry) :
    entryAt? (entries ++ [entry]) (entries.length + 1) =
      some entry := by
  unfold entryAt?
  simp

theorem logPrefix_take_eq_of_index_le_length
    (entries : List Entry)
    (bound index : Nat)
    (within : index <= (entries.take bound).length) :
    logPrefix (entries.take bound) index =
      logPrefix entries index := by
  have indexWithinBound : index <= bound := by
    exact Nat.le_trans within (List.length_take_le bound entries)
  simp [logPrefix, List.take_take, Nat.min_eq_left indexWithinBound]

theorem logPrefix_append_eq_of_index_le_length
    (entries suffix : List Entry)
    (index : Nat)
    (within : index <= entries.length) :
    logPrefix (entries ++ suffix) index =
      logPrefix entries index := by
  simp [logPrefix, List.take_append_of_le_length within]

theorem take_eq_take_length
    (entries : List Entry)
    (count : Nat) :
    entries.take count =
      entries.take (entries.take count).length := by
  rw [List.length_take]
  by_cases within : count <= entries.length
  · rw [Nat.min_eq_left within]
  · have lengthWithin : entries.length <= count := by omega
    rw [Nat.min_eq_right lengthWithin]
    have takeAll : entries.take count = entries :=
      (List.take_eq_self_iff entries).2 lengthWithin
    rw [takeAll]
    simp

theorem historicalLogPrefixOrigin_index
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {entries : List Entry}
    (origin :
      HistoricalLogPrefixOrigin start actions state entries)
    (index : Nat)
    (positive : 1 <= index)
    (within : index <= entries.length) :
    Exists fun historicalState =>
      Exists fun node : Node =>
        And
          (StateAt start actions state historicalState)
          (And
            (entryAt? entries index =
              entryAt? (historicalState.log node) index)
            (And
              (logPrefix entries index =
                logPrefix (historicalState.log node) index)
              (index <= (historicalState.log node).length))) := by
  rcases origin with ⟨historicalState, node, stateAt, logEq⟩
  have withinTake :
      index <=
        ((historicalState.log node).take entries.length).length := by
    rw [← logEq]
    exact within
  refine ⟨historicalState, node, stateAt, ?_, ?_, ?_⟩
  · exact
      (congrArg (fun log => entryAt? log index) logEq).trans
        (entryAt?_take_eq_of_index_le_length
          (historicalState.log node)
          entries.length
          index positive withinTake)
  · exact
      (congrArg (fun log => logPrefix log index) logEq).trans
        (logPrefix_take_eq_of_index_le_length
          (historicalState.log node)
          entries.length
          index withinTake)
  · exact Nat.le_trans withinTake
      (List.length_take_le' entries.length
        (historicalState.log node))

private theorem historicalLogPrefixOrigin_of_prefix
    {start : InitialConfiguration}
    {actions : List Action}
    {state historicalState : State}
    {entries : List Entry}
    (stateAt :
      StateAt start actions state historicalState)
    (node : Node)
    (count : Nat)
    (logEq :
      entries = (historicalState.log node).take count) :
    HistoricalLogPrefixOrigin
      start actions state entries := by
  have lengthEq :
      entries.length =
        ((historicalState.log node).take count).length :=
    congrArg List.length logEq
  exact
    ⟨historicalState, node, stateAt,
      by
        rw [lengthEq]
        exact logEq.trans
          (take_eq_take_length
            (historicalState.log node)
            count)⟩

private theorem historicalLogPrefixOrigin_of_unchanged
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {entries : List Entry}
    (history : ProtocolHistory start actions state)
    (node : Node)
    (logEq : entries = state.log node) :
    HistoricalLogPrefixOrigin
      start actions state entries := by
  apply historicalLogPrefixOrigin_of_prefix
    (protocolHistory_final_stateAt history)
    node
    (state.log node).length
  simpa using logEq

theorem temporalLogMatching_append_of_prefix_origins
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (origins :
      forall node : Node,
        HistoricalLogPrefixOrigin
          start actions state ((next state action).log node)) :
    TemporalLogMatchingInv
      start
      (actions ++ [action])
      (next state action) := by
  intro firstState secondState firstAt secondAt
    firstNode secondNode index positive bounded sameTerm
  have firstOrigin :=
    extendedStateAt_hasHistoricalLogPrefixOrigin
      history enabled origins firstAt firstNode
  have secondOrigin :=
    extendedStateAt_hasHistoricalLogPrefixOrigin
      history enabled origins secondAt secondNode
  rcases historicalLogPrefixOrigin_index
      firstOrigin index positive
      (Nat.le_trans bounded (Nat.min_le_left _ _)) with
    ⟨firstHistorical, firstHistoricalNode, firstHistoricalAt,
      firstEntryEq, firstPrefixEq, firstBound⟩
  rcases historicalLogPrefixOrigin_index
      secondOrigin index positive
      (Nat.le_trans bounded (Nat.min_le_right _ _)) with
    ⟨secondHistorical, secondHistoricalNode, secondHistoricalAt,
      secondEntryEq, secondPrefixEq, secondBound⟩
  have historicalTermEq :
      (entryAt?
          (firstHistorical.log firstHistoricalNode)
          index).map (·.term) =
        (entryAt?
          (secondHistorical.log secondHistoricalNode)
          index).map (·.term) := by
    simpa [firstEntryEq, secondEntryEq] using sameTerm
  have historicalPrefixEq :=
    matching
      firstHistorical secondHistorical
      firstHistoricalAt secondHistoricalAt
      firstHistoricalNode secondHistoricalNode
      index positive
      (Nat.le_min.mpr ⟨firstBound, secondBound⟩)
      historicalTermEq
  exact
    firstPrefixEq.trans
      (historicalPrefixEq.trans secondPrefixEq.symm)

theorem temporalLogMatching_append_of_current_prefixes
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (action : Action)
    (enabled : Enabled state action)
    (prefixes :
      forall node : Node,
        Exists fun count =>
          (next state action).log node =
            (state.log node).take count) :
    TemporalLogMatchingInv
      start
      (actions ++ [action])
      (next state action) := by
  apply temporalLogMatching_append_of_prefix_origins
    history matching action enabled
  intro node
  rcases prefixes node with ⟨count, logEq⟩
  exact historicalLogPrefixOrigin_of_prefix
    (protocolHistory_final_stateAt history)
    node count logEq

private theorem localAppend_endpoint_matches_historical
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader : Node}
    {entry : Entry}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (fresh :
      LeaderAppendTermFreshInHistory
        start actions state leader)
    (entryTerm : entry.term = state.currentTerm leader)
    (leaderLog :
      (next state action).log leader =
        state.log leader ++ [entry])
    (otherLogs :
      forall node : Node,
        node ≠ leader ->
          (next state action).log node = state.log node)
    (historicalState : State)
    (historicalAt :
      StateAt start actions state historicalState)
    (firstNode secondNode : Node)
    (index : Nat)
    (positive : 1 <= index)
    (bounded :
      index <=
        min
          ((next state action).log firstNode).length
          (historicalState.log secondNode).length)
    (sameTerm :
      (entryAt? ((next state action).log firstNode) index).map
          (·.term) =
        (entryAt? (historicalState.log secondNode) index).map
          (·.term)) :
    logPrefix ((next state action).log firstNode) index =
      logPrefix (historicalState.log secondNode) index := by
  by_cases firstIsLeader : firstNode = leader
  · subst firstNode
    have nextWithin :
        index <= ((next state action).log leader).length :=
      Nat.le_trans bounded (Nat.min_le_left _ _)
    by_cases withinOld : index <= (state.log leader).length
    · have historicalTermEq :
          (entryAt? (state.log leader) index).map (·.term) =
            (entryAt?
              (historicalState.log secondNode)
              index).map (·.term) := by
        rw [← entryAt?_append_eq_of_index_le_length
          (state.log leader) [entry] index positive withinOld]
        simpa [leaderLog] using sameTerm
      have oldPrefixEq :=
        matching
          state historicalState
          (protocolHistory_final_stateAt history)
          historicalAt
          leader secondNode
          index positive
          (Nat.le_min.mpr
            ⟨withinOld,
              Nat.le_trans bounded (Nat.min_le_right _ _)⟩)
          historicalTermEq
      have endpointPrefixEq :
          logPrefix ((next state action).log leader) index =
            logPrefix (state.log leader) index := by
        rw [leaderLog]
        exact logPrefix_append_eq_of_index_le_length
          (state.log leader) [entry] index withinOld
      exact endpointPrefixEq.trans oldPrefixEq
    · have indexEq : index = (state.log leader).length + 1 := by
        rw [leaderLog] at nextWithin
        simp at nextWithin
        omega
      have endpointTerm :
          (entryAt? ((next state action).log leader) index).map
              (·.term) =
            some (state.currentTerm leader) := by
        rw [leaderLog, indexEq,
          entryAt?_append_singleton_last]
        simp [entryTerm]
      have historicalTerm :
          (entryAt?
              (historicalState.log secondNode)
              ((state.log leader).length + 1)).map
              (·.term) =
            some (state.currentTerm leader) := by
        rw [← indexEq]
        exact endpointTerm ▸ sameTerm.symm
      exact False.elim
        (fresh historicalState historicalAt
          secondNode historicalTerm)
  · have firstLogEq := otherLogs firstNode firstIsLeader
    have currentTermEq :
        (entryAt? (state.log firstNode) index).map (·.term) =
          (entryAt? (historicalState.log secondNode) index).map
            (·.term) := by
      simpa [firstLogEq] using sameTerm
    have oldPrefixEq :=
      matching
        state historicalState
        (protocolHistory_final_stateAt history)
        historicalAt
        firstNode secondNode
        index positive
        (Nat.le_min.mpr
          ⟨by
              rw [← firstLogEq]
              exact Nat.le_trans bounded (Nat.min_le_left _ _),
            Nat.le_trans bounded (Nat.min_le_right _ _)⟩)
        currentTermEq
    simpa [firstLogEq] using oldPrefixEq

theorem temporalLogMatching_append_local_entry
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    {action : Action}
    {leader : Node}
    {entry : Entry}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (fresh :
      LeaderAppendTermFreshInHistory
        start actions state leader)
    (enabled : Enabled state action)
    (entryTerm : entry.term = state.currentTerm leader)
    (leaderLog :
      (next state action).log leader =
        state.log leader ++ [entry])
    (otherLogs :
      forall node : Node,
        node ≠ leader ->
          (next state action).log node = state.log node) :
    TemporalLogMatchingInv
      start
      (actions ++ [action])
      (next state action) := by
  intro firstState secondState firstAt secondAt
    firstNode secondNode index positive bounded sameTerm
  rcases
      stateAt_append_singleton_cases history enabled firstAt with
    firstOld | firstFinal
  · rcases
        stateAt_append_singleton_cases history enabled secondAt with
      secondOld | secondFinal
    · exact matching
        firstState secondState firstOld secondOld
        firstNode secondNode index positive bounded sameTerm
    · subst secondState
      exact
        (localAppend_endpoint_matches_historical
          history matching fresh entryTerm
          leaderLog otherLogs
          firstState firstOld
          secondNode firstNode
          index positive
          (by simpa [Nat.min_comm] using bounded)
          sameTerm.symm).symm
  · subst firstState
    rcases
        stateAt_append_singleton_cases history enabled secondAt with
      secondOld | secondFinal
    · exact
        localAppend_endpoint_matches_historical
          history matching fresh entryTerm
          leaderLog otherLogs
          secondState secondOld
          firstNode secondNode
          index positive bounded sameTerm
    · subst secondState
      by_cases sameNode : firstNode = secondNode
      · subst secondNode
        rfl
      · by_cases firstIsLeader : firstNode = leader
        · subst firstNode
          have secondNotLeader : secondNode ≠ leader := by
            intro secondIsLeader
            subst secondNode
            exact sameNode rfl
          have result :=
            localAppend_endpoint_matches_historical
              history matching fresh entryTerm
              leaderLog otherLogs
              state (protocolHistory_final_stateAt history)
              leader secondNode
              index positive
              (by simpa [otherLogs secondNode secondNotLeader] using bounded)
              (by simpa [otherLogs secondNode secondNotLeader] using sameTerm)
          simpa [otherLogs secondNode secondNotLeader] using result
        · by_cases secondIsLeader : secondNode = leader
          · subst secondNode
            have result :=
              localAppend_endpoint_matches_historical
                history matching fresh entryTerm
                leaderLog otherLogs
                state (protocolHistory_final_stateAt history)
                leader firstNode
                index positive
                (by simpa [otherLogs firstNode firstIsLeader,
                    Nat.min_comm] using bounded)
                (by simpa [otherLogs firstNode firstIsLeader] using
                    sameTerm.symm)
            simpa [otherLogs firstNode firstIsLeader] using result.symm
          · simpa [otherLogs firstNode firstIsLeader,
              otherLogs secondNode secondIsLeader] using
              matching
                state state
                (protocolHistory_final_stateAt history)
                (protocolHistory_final_stateAt history)
                firstNode secondNode
                index positive
                (by simpa [otherLogs firstNode firstIsLeader,
                    otherLogs secondNode secondIsLeader] using bounded)
                (by simpa [otherLogs firstNode firstIsLeader,
                    otherLogs secondNode secondIsLeader] using sameTerm)

private theorem temporalLogMatching_receive_noConflict
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (dest source : Node)
    (enabled :
      Enabled state
        (.receive dest source .appendEntriesNoConflict)) :
    TemporalLogMatchingInv
      start
      (actions ++
        [.receive dest source .appendEntriesNoConflict])
      (next state
        (.receive dest source .appendEntriesNoConflict)) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [Enabled, actionEnabled, hmessage] at enabled
  | some message =>
      cases hbody : message.body with
      | appendEntriesRequest previousIndex previousTerm entries
          leaderCommitIndex =>
          have queued :=
            headMessage?_mem state dest source message hmessage
          have provenance :
              MessageHasAESendWitness
                start actions state dest source message := by
            simpa [hbody] using requests dest source message queued
          rcases provenance with ⟨witness⟩
          rcases witness with ⟨sendState, occurrence, messageEq⟩
          subst message
          have branchEnabled := enabled
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at branchEnabled
          simp [appendEntriesMessage] at hbody
          rcases hbody with
            ⟨previousIndexEq, previousTermEq,
              entriesEq, leaderCommitIndexEq⟩
          subst previousIndex
          subst previousTerm
          subst entries
          subst leaderCommitIndex
          have noConflictFacts := branchEnabled.2.2.2
          simp [appendEntriesNoConflictGuard] at noConflictFacts
          have sendFacts :=
            appendEntriesMessage_prefix_eq
              history occurrence matching
              branchEnabled.2.2.1
              noConflictFacts.1.1.1
          apply temporalLogMatching_append_of_prefix_origins
            history matching
            (.receive
              (appendEntriesMessage sendState source dest).dest
              source
              .appendEntriesNoConflict)
            enabled
          intro node
          by_cases nodeIsDest : node = dest
          · subst node
            apply historicalLogPrefixOrigin_of_prefix
              (occurs_before_stateAt occurrence)
              source
              (sendState.sentIndex source dest + 1)
            simpa [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage] using
              appendEntriesMessage_result_log_eq
                sendState state source dest sendFacts.2
          · apply historicalLogPrefixOrigin_of_unchanged
              history node
            simp [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage, nextAppendEntriesNoConflict,
              nodeIsDest]
      | _ =>
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at enabled

private theorem temporalLogMatching_receive_conflictThenNoConflict
    {start : InitialConfiguration}
    {actions : List Action}
    {state : State}
    (history : ProtocolHistory start actions state)
    (matching :
      TemporalLogMatchingInv start actions state)
    (requests :
      AppendEntriesRequestHistoryConsistent start actions state)
    (dest source : Node)
    (enabled :
      Enabled state
        (.receive dest source
          .appendEntriesConflictThenNoConflict)) :
    TemporalLogMatchingInv
      start
      (actions ++
        [.receive dest source
          .appendEntriesConflictThenNoConflict])
      (next state
        (.receive dest source
          .appendEntriesConflictThenNoConflict)) := by
  cases hmessage : headMessage? state dest source with
  | none =>
      simp [Enabled, actionEnabled, hmessage] at enabled
  | some message =>
      cases hbody : message.body with
      | appendEntriesRequest previousIndex previousTerm entries
          leaderCommitIndex =>
          have queued :=
            headMessage?_mem state dest source message hmessage
          have provenance :
              MessageHasAESendWitness
                start actions state dest source message := by
            simpa [hbody] using requests dest source message queued
          rcases provenance with ⟨witness⟩
          rcases witness with ⟨sendState, occurrence, messageEq⟩
          subst message
          have branchEnabled := enabled
          simp [Enabled, actionEnabled, hmessage,
            receiveBranchEnabled, hbody] at branchEnabled
          simp [appendEntriesMessage] at hbody
          rcases hbody with
            ⟨previousIndexEq, previousTermEq,
              entriesEq, leaderCommitIndexEq⟩
          subst previousIndex
          subst previousTerm
          subst entries
          subst leaderCommitIndex
          have noConflictFacts := branchEnabled.2.2.2
          simp [appendEntriesNoConflictGuard] at noConflictFacts
          have sendFacts :=
            appendEntriesMessage_prefix_eq
              history occurrence matching
              branchEnabled.2.2.1.1
              noConflictFacts.1.1.1
          have rolledPrefixEq :
              logPrefix
                  ((conflictRollback
                    state dest
                    (sendState.sentIndex source dest)).log dest)
                  (sendState.sentIndex source dest) =
                logPrefix
                  (sendState.log source)
                  (sendState.sentIndex source dest) := by
            simpa [conflictRollback, logPrefix,
              List.take_take] using sendFacts.2
          apply temporalLogMatching_append_of_prefix_origins
            history matching
            (.receive dest source
              .appendEntriesConflictThenNoConflict)
            enabled
          intro node
          by_cases nodeIsDest : node = dest
          · subst node
            apply historicalLogPrefixOrigin_of_prefix
              (occurs_before_stateAt occurrence)
              source
              (sendState.sentIndex source dest + 1)
            simpa [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage] using
              appendEntriesMessage_result_log_eq
                sendState
                (conflictRollback
                  state dest
                  (sendState.sentIndex source dest))
                source dest rolledPrefixEq
          · apply historicalLogPrefixOrigin_of_unchanged
              history node
            simp [next, rawNext, nextReceive, hmessage,
              appendEntriesMessage, nextAppendEntriesNoConflict,
              conflictRollback, nodeIsDest]
      | _ =>
          simp [Enabled, actionEnabled, hmessage,
